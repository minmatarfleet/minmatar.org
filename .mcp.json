{
  "mcpServers": {
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "discord": {
      "type": "http",
      "url": "https://api.minmatar.org/api/agent/discord/mcp",
      "headers": {
        "Authorization": "Bearer ${MINMATAR_AGENT_KEY:-set-by-cloud-proxy}"
      }
    },
    "esi": {
      "type": "http",
      "url": "https://api.minmatar.org/api/agent/esi/mcp",
      "headers": {
        "Authorization": "Bearer ${MINMATAR_AGENT_KEY:-set-by-cloud-proxy}"
      }
    },
    "reddit": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "${CLAUDE_PROJECT_DIR:-.}/mcps/run-reddit-mcp.sh"
      ]
    }
  }
}
