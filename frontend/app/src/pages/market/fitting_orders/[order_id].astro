---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { User } from '@dtypes/jwt'
import * as jose from 'jose'
import { HTTP_400_Bad_Request } from '@helpers/http_responses'

const auth_token = Astro.cookies.has('auth_token')
    ? (Astro.cookies.get('auth_token')?.value as string)
    : false
const user: User | false = auth_token ? jose.decodeJwt(auth_token) as User : false
const is_logged_in = !!(user && auth_token)

const order_id = parseInt(Astro.params.order_id ?? '', 10)
if (isNaN(order_id) || order_id < 1)
    return HTTP_400_Bad_Request()

if (!is_logged_in)
    return Astro.redirect(translatePath('/market/fitting_orders/'))

import Viewport from '@layouts/Viewport.astro'
import PageWide from '@components/page/PageWide.astro'
import PageTitle from '@components/page/PageTitle.astro'
import PageActions from '@components/page/PageActions.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import Breadcrumb from '@components/blocks/Breadcrumb.astro'
import FittingBuyOrderSkeleton from '@components/blocks/FittingBuyOrderSkeleton.astro'
import FittingBuyOrderAssets from '@components/blocks/FittingBuyOrderAssets.astro'

const page_title = t('fitting_buy.order_id').replace('{id}', String(order_id))
const PARTIAL = translatePath(`/partials/fitting_buy_order_component?order_id=${order_id}`)
const breadcrumb_items = [
    { label: t('intel.page_title'), href: translatePath('/intel/') },
    { label: t('fitting_buy.page_title'), href: translatePath('/market/fitting_orders/') },
    { label: `#${order_id}` },
]
---

<Viewport title={page_title} meta_description={t('fitting_buy.meta_description')}>
    <PageWide
        cover={{
            image: '/images/market-cover.jpg',
            image_990: '/images/market-cover.jpg',
            animated: false,
            scrollable: true,
            overlay: true,
        }}
        sticky={true}
    >
        <FlexInline slot="header" justification="space-between" class="[ w-full ]">
            <Flexblock gap="var(--space-2xs)">
                <Breadcrumb items={breadcrumb_items} />
                <PageTitle>{page_title}</PageTitle>
                <div id="fitting-buy-order-meta" class="[ fitting-buy-order-meta-slot ]"></div>
            </Flexblock>
            <PageActions>
                <div id="fitting-buy-order-actions" class="[ fitting-buy-order-actions-slot ]"></div>
            </PageActions>
        </FlexInline>

        <Flexblock gap="var(--space-xl)" class="[ compensate-bottom-bar ]">
            <div
                id="fitting-buy-order-slot"
                hx-get={PARTIAL}
                hx-trigger="load once"
                hx-swap="innerHTML"
            >
                <FittingBuyOrderSkeleton />
            </div>
        </Flexblock>
        <FittingBuyOrderAssets />
    </PageWide>
</Viewport>

<script>
    function refreshFittingBuyOrderSlot() {
        const order = document.getElementById('fitting-buy-order')
        const slot = document.getElementById('fitting-buy-order-slot')
        const el = order || slot
        if (!el)
            return
        if (typeof htmx !== 'undefined')
            htmx.process(el)
        if (typeof Alpine !== 'undefined')
            Alpine.initTree(el)

        const meta = document.getElementById('fitting-buy-order-meta')
        if (meta) {
            if (typeof htmx !== 'undefined')
                htmx.process(meta)
            if (typeof Alpine !== 'undefined')
                Alpine.initTree(meta)
        }
        const actions = document.getElementById('fitting-buy-order-actions')
        if (actions) {
            if (typeof htmx !== 'undefined')
                htmx.process(actions)
            if (typeof Alpine !== 'undefined')
                Alpine.initTree(actions)
        }
    }

    function restoreFittingBuyAllocFocus() {
        const focus = (window as any).__fitting_buy_alloc_focus as {
            preferred_type_id?: number | string
            name?: string
            pos?: number | null
        } | undefined
        if (!focus?.name || focus.preferred_type_id == null)
            return
        const preferred = String(focus.preferred_type_id)
        const preferred_input = document.querySelector(
            `#fitting-buy-order form.fitting-buy-alloc-form input[name="preferred_type_id"][value="${preferred}"]`,
        ) as HTMLInputElement | null
        const form = preferred_input?.form
        const input = form?.querySelector(
            `input[name="${focus.name}"]`,
        ) as HTMLInputElement | null
        if (!input)
            return
        input.focus()
        if (
            typeof focus.pos === 'number'
            && focus.pos >= 0
            && typeof input.setSelectionRange === 'function'
        ) {
            try {
                input.setSelectionRange(focus.pos, focus.pos)
            } catch {
                // number inputs may reject selection range in some browsers
            }
        }
    }

    function isFittingBuyOrderRequest(event: any): boolean {
        const path = String(
            event.detail?.pathInfo?.requestPath
                || event.detail?.xhr?.responseURL
                || event.detail?.elt?.getAttribute?.('hx-get')
                || event.detail?.elt?.getAttribute?.('hx-post')
                || '',
        )
        return path.includes('fitting_buy_order_component')
    }

    function bindFittingBuyOrderDeferred() {
        const slot = document.getElementById('fitting-buy-order-slot')
        if (!slot || slot.dataset.bound === '1')
            return
        slot.dataset.bound = '1'

        document.body.addEventListener('htmx:afterSwap', (event: any) => {
            if (!isFittingBuyOrderRequest(event))
                return
            refreshFittingBuyOrderSlot()
            restoreFittingBuyAllocFocus()
        })
    }

    bindFittingBuyOrderDeferred()
    document.addEventListener('astro:page-load', bindFittingBuyOrderDeferred)
</script>
