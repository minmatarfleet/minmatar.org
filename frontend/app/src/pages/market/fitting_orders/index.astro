---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { get_request_user } from '@helpers/request_user'

const { auth_token, user } = get_request_user(Astro)
const is_logged_in = !!(user && auth_token)

import {
    list_fitting_buy_orders,
    type FittingBuyOrderListItem,
} from '@helpers/api.minmatar.org/fitting_buy_orders'

const mine = Astro.url.searchParams.get('mine') === '1'
const include_all = Astro.url.searchParams.get('all') === '1'
let orders: FittingBuyOrderListItem[] = []
let fetch_error: string | false = false

if (is_logged_in) {
    try {
        orders = await list_fitting_buy_orders(auth_token as string, {
            mine,
            include_completed: include_all,
        })
    } catch (error) {
        fetch_error = (error as Error).message
    }
}

const orders_count = orders.length
const orders_count_text = (
    orders_count !== 1
        ? t('fitting_buy.showing_plural')
        : t('fitting_buy.showing_singular')
).replace('{count}', String(orders_count))

import Viewport from '@layouts/Viewport.astro'
import PageWide from '@components/page/PageWide.astro'
import PageTitle from '@components/page/PageTitle.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import TextBox from '@components/layout/TextBox.astro'
import Button from '@components/blocks/Button.astro'
import Input from '@components/blocks/Input.astro'
import ChipGroup from '@components/blocks/ChipGroup.astro'
import FilterChip from '@components/blocks/FilterChip.astro'
import Table from '@components/blocks/Table.astro'
import FittingBuyOrderItem from '@components/blocks/FittingBuyOrderItem.astro'
import MagnifierIcon from '@components/icons/buttons/MagnifierIcon.astro'

const page_title = t('fitting_buy.page_title')
const leading_text = t('fitting_buy.leading_text')
const breadcrumbs = [
    { page_title: t('intel.page_title'), accumulated_path: '/intel/' },
    { page_title: page_title, accumulated_path: Astro.url.pathname },
]
---

<Viewport title={page_title} meta_description={t('fitting_buy.meta_description')}>
    <PageWide
        cover={{
            image: '/images/market-cover.jpg',
            image_990: '/images/market-cover.jpg',
            animated: false,
            scrollable: true,
            overlay: true,
        }}
        sticky={true}
        breadcrumbs={breadcrumbs}
        x-data={`{
            orders_count: ${orders_count},
            item_name_filter: '',
            orders_plural: '${t('fitting_buy.showing_plural')}',
            orders_singular: '${t('fitting_buy.showing_singular')}',
            countVisibleElements(selector, parent = document) {
                const elements = parent.querySelectorAll(selector)
                let visible_count = 0
                elements.forEach(element => {
                    if (element.offsetParent !== null)
                        visible_count++
                })
                return visible_count
            },
            show_item(el) {
                if (this.item_name_filter === '')
                    return true
                return el.textContent.toLowerCase().includes(this.item_name_filter.toLowerCase())
            },
        }`}
    >
        <FlexInline slot="header" justification="space-between" class="[ w-full ]">
            <Flexblock gap="var(--space-s)">
                <Flexblock gap="var(--space-3xs)">
                    <PageTitle>{page_title}</PageTitle>
                    <small x-text="(orders_count != 1 ? orders_plural : orders_singular).replace('{count}', String(orders_count))">
                        {orders_count_text}
                    </small>
                </Flexblock>
            </Flexblock>
            {is_logged_in && (
                <Button size="sm" href={translatePath('/market/fitting_orders/new/')}>
                    {t('fitting_buy.create_order')}
                </Button>
            )}
        </FlexInline>

        <Flexblock gap="var(--space-xl)" class="[ compensate-bottom-bar ]">
            <TextBox>
                <p class="[ excerpt ]">{leading_text}</p>
            </TextBox>

            {!is_logged_in ? (
                <p>{t('fitting_buy.login_required')}</p>
            ) : fetch_error ? (
                <p class="[ text-[var(--fleet-red)] ]">{fetch_error}</p>
            ) : (
                <Flexblock gap="var(--space-s)" class="[ fitting-buy-orders-browse ]">
                    <FlexInline
                        justification="space-between"
                        class="[ w-full fitting-buy-orders__toolbar ]"
                        gap="var(--space-s)"
                    >
                        <ChipGroup wrap={true}>
                            <FilterChip
                                href={translatePath('/market/fitting_orders/')}
                                active={!mine && !include_all}
                            >
                                {t('fitting_buy.all_orders')}
                            </FilterChip>
                            <FilterChip
                                href={translatePath('/market/fitting_orders/?mine=1')}
                                active={mine && !include_all}
                            >
                                {t('fitting_buy.mine_only')}
                            </FilterChip>
                            <FilterChip
                                href={translatePath('/market/fitting_orders/?all=1')}
                                active={include_all}
                            >
                                {t('fitting_buy.show_all')}
                            </FilterChip>
                        </ChipGroup>
                        {orders.length > 0 && (
                            <div class="[ fitting-buy-orders__search ]">
                                <Input
                                    type="text"
                                    placeholder={t('search')}
                                    x-model="item_name_filter"
                                    x-on:keyup="setTimeout(function () { orders_count = countVisibleElements('.fitting-buy-order-item') })"
                                    x-init="$el.focus()"
                                    width="250px"
                                >
                                    <MagnifierIcon slot="icon" />
                                </Input>
                            </div>
                        )}
                    </FlexInline>

                    {orders.length === 0 ? (
                        <Flexblock gap="var(--space-s)">
                            <p>{include_all ? t('fitting_buy.no_orders') : t('fitting_buy.no_open_orders')}</p>
                            <Button size="sm" href={translatePath('/market/fitting_orders/new/')}>
                                {t('fitting_buy.create_order')}
                            </Button>
                        </Flexblock>
                    ) : (
                        <Table width="100%" responsive={false}>
                            {orders.map((order) => (
                                <div class="[ fitting-buy-order-item ]" x-show="show_item($el)">
                                    <FittingBuyOrderItem order={order} />
                                </div>
                            ))}
                            <p class="[ no-result-text ]">{t('no_results')}</p>
                        </Table>
                    )}
                </Flexblock>
            )}
        </Flexblock>
    </PageWide>
</Viewport>

<style lang="scss">
    :not([style="display: none;"]) ~ .no-result-text {
        display: none;
    }

    .fitting-buy-orders-browse {
        min-width: 0;
        max-width: 100%;
    }

    .fitting-buy-orders__toolbar {
        align-items: center;
        min-width: 0;
    }

    .fitting-buy-orders__search {
        flex: 1 1 12rem;
        min-width: 0;
        max-width: 100%;

        :global(.input-group) {
            max-width: 100%;
            width: 100%;
            margin-inline-start: auto;
        }

        @media (min-width: 541px) {
            flex: 0 1 16rem;

            :global(.input-group) {
                max-width: 250px;
            }
        }
    }

</style>
