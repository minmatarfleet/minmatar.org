---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { get_buyback_settings } from '@helpers/api.minmatar.org/buybacks'
import type { BuybackSettings } from '@dtypes/api.minmatar.org'

let settings: BuybackSettings | null = null
let fetch_error: Error | false = false

try {
    settings = await get_buyback_settings()
} catch (error) {
    fetch_error = error as Error
}

import type { Alert } from '@dtypes/layout_components'

let alert: Alert | null = null
if (Astro.cookies.has('buyback_contract_error')) {
    alert = {
        title: t('buyback.page_title'),
        content: (Astro.cookies.get('buyback_contract_error')?.value as string),
    }
    Astro.cookies.delete('buyback_contract_error', { path: '/' })
}

import Viewport from '@layouts/Viewport.astro';
import PageWide from '@components/page/PageWide.astro';
import PageActions from '@components/page/PageActions.astro';
import PageTitle from '@components/page/PageTitle.astro';

import TextBox from '@components/layout/TextBox.astro';

import Flexblock from '@components/compositions/Flexblock.astro';
import FlexInline from '@components/compositions/FlexInline.astro';

import ComponentBlock from '@components/blocks/ComponentBlock.astro';
import BuybackInfo from '@components/blocks/BuybackInfo.astro';
import Button from '@components/blocks/Button.astro';
import Textarea from '@components/blocks/Textarea.astro';
import Grid from '@components/compositions/Grid.astro'
import Markdown from '@components/blocks/Markdown.astro'
import Steps from '@components/blocks/Steps.astro'

const page_title = t('buyback.page_title');
const leading_text = settings?.leading_text?.trim() || ''
---

<Viewport
    title={page_title}
    meta_description={t('buyback.meta_description')}
    components={{
        alert_dialog: true,
    }}
>
    <PageWide
        cover={{
            image: "/images/buyback-cover.jpg",
            image_990: "/images/buyback-cover.jpg",
            animated: false,
            scrollable: true,
            overlay: true
        }}
        x-data={`{
            init() {
                ${alert ? `show_alert_dialog(${JSON.stringify(alert)})` : ''}
            }
        }`}
    >
        <Flexblock slot="header" class="[ w-full ]">
            <FlexInline justification='space-between' class="[ w-full ]">
                <FlexInline>
                    <PageTitle>
                        {page_title}
                    </PageTitle>
                </FlexInline>
                <PageActions>
                    <Button href={translatePath('/market/buyback/stocks/')}>
                        {t('view_buyback_stocks')}
                    </Button>
                    <Button href={translatePath('/market/buyback/contracts/')}>
                        {t('view_buyback_contracts')}
                    </Button>
                </PageActions>
            </FlexInline>
        </Flexblock>

        <Flexblock gap='var(--space-xl)'>
            {settings?.active &&
                <TextBox>
                    <Markdown markdown={t('buyback.faq.1_text')} />
                </TextBox>

                <Grid
                    row_gap='var(--space-xs)'
                    column_gap='0'
                    min_item_width='310px'
                    class="grid-fill"
                >
                    <Steps
                        step={1}
                        title='Copy items from your inventory (CTRL+A, CTRL+C)'
                        subtitle='In-game'
                    />

                    <Steps
                        step={2}
                        title='Paste on the text box below'
                    />

                    <Steps
                        step={3}
                        title='Click on the **Appraise** button'
                    />

                    <Steps
                        step={4}
                        title='Wait for appraisal then click on **Create contract walkthrough**'
                    />
                    <Steps
                        step={5}
                        title='Follow the instructions and create the contract'
                        subtitle='In-game'
                    />
                </Grid>

                <Flexblock gap='var(--space-2xs)' class="[ grow max-w-(--max-text-width) min-w-[min(450px,100%)] ]">
                    <form
                        method="POST"
                        action={translatePath('/market/buyback/appraisal')}
                        x-data={`{
                            paste: '',
                            submitted: false,
                        }`}
                        x-on:submit="submitted = true"
                    >
                        <Flexblock>
                            <Flexblock gap='var(--space-2xs)'>
                                <Textarea
                                    id="paste"
                                    name="paste"
                                    required
                                    x-model="paste"
                                    placeholder={t('buyback.form.paste_placeholder')}
                                />
                            </Flexblock>

                            <Button x-bind:disabled="submitted" type="submit">{t('buyback.form.submit')}</Button>
                        </Flexblock>
                    </form>
                </Flexblock>
            }

            {fetch_error ?
                <ComponentBlock>
                    <p>{t('buyback.fetch_error')}</p>
                </ComponentBlock>
                :
                <>
                    <hr class="[ border-bottom ]" />

                    {settings && !settings.active &&
                        <ComponentBlock>
                            <p>{t('buyback.inactive')}</p>
                        </ComponentBlock>
                    }

                    {settings &&
                        <BuybackInfo settings={settings} />
                    }
                </>
            }
        </Flexblock>
    </PageWide>
</Viewport>

<style lang="scss">
    form {
        &:focus-within {
            #paste {
                min-height: 180px;
                max-height: none;
            }

        }
    }

    #paste {
        max-height: 90px;
        min-height: 90px;
        transition: var(--normal-transition);
    }
</style>