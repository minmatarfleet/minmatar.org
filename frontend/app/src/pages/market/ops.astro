---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import {
    ops_params_need_canonicalization,
    ops_redirect_path,
} from '@helpers/market_ops_redirect'

if (ops_params_need_canonicalization(Astro.url.searchParams)) {
    return Astro.redirect(ops_redirect_path(translatePath, 'monitor'), 301)
}

import Viewport from '@layouts/Viewport.astro';
import PageWide from '@components/page/PageWide.astro';
import PageActions from '@components/page/PageActions.astro';
import PageTitle from '@components/page/PageTitle.astro';
import TextBox from '@components/layout/TextBox.astro';
import Flexblock from '@components/compositions/Flexblock.astro';
import FlexInline from '@components/compositions/FlexInline.astro';
import Button from '@components/blocks/Button.astro';
import Markdown from '@components/blocks/Markdown.astro';
import MarketHealthSkeleton from '@components/blocks/MarketHealthSkeleton.astro';
import CogIcon from '@components/icons/buttons/CogIcon.astro';

const page_title = t('staging_supply.ops.page_title')

const active_location_id = parseInt(Astro.url.searchParams.get('location_id') ?? '0')
const MONITOR_PARTIAL = translatePath(`/partials/market_health_component${active_location_id > 0 ? `?location_id=${active_location_id}` : ''}`)

const api_base = import.meta.env.API_URL || ''
const admin_hub = `${api_base}/admin/market/locations/`
---

<Viewport
    title={page_title}
    meta_description={t('staging_supply.ops.meta_description')}
    components={{
        alert_dialog: true,
    }}
>
    <PageWide
        cover={{
            image: '/images/market-cover.jpg',
            image_990: '/images/market-cover.jpg',
            overlay: true,
            scrollable: true,
        }}
    >
        <FlexInline id="header-oob" slot="header" justification="space-between" class="[ w-full ]">
            <PageTitle>{page_title}</PageTitle>
            <PageActions>
                <Button
                    href={admin_hub}
                    external={true}
                >
                    <CogIcon slot="icon" />
                    {t('edit_targets')}
                </Button>
            </PageActions>
        </FlexInline>

        <Flexblock gap="var(--space-xl)">
            <TextBox>
                <Markdown class="[ excerpt ]" markdown={t('staging_supply.ops.leading_text')} />
            </TextBox>

            <div
                id="market-health-slot"
                data-market-health-deferred="1"
                hx-get={MONITOR_PARTIAL}
                hx-trigger="load"
                hx-swap="outerHTML"
                hx-indicator=".loader"
                aria-busy="true"
                aria-live="polite"
            >
                <MarketHealthSkeleton />
            </div>
    </PageWide>
</Viewport>