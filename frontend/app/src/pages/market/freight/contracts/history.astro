---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { query_string } from '@helpers/string';

const location_name = Astro.url.searchParams.get('location_name')
const FREIGHT_CONTRACTS_PARTIAL_URL = translatePath(`/partials/freight_contracts_component?${query_string({
    ...(location_name ? { location_name } : {}),
    is_history: true,
})}`)

import Viewport from '@layouts/Viewport.astro';

import PageWide from '@components/page/PageWide.astro';
import PageTitle from '@components/page/PageTitle.astro';

import Flexblock from '@components/compositions/Flexblock.astro';
import FlexInline from '@components/compositions/FlexInline.astro';

import Input from '@components/blocks/Input.astro'
import Breadcrumb from '@components/blocks/Breadcrumb.astro'
import Button from '@components/blocks/Button.astro'
import FreightContractsSkeleton from '@components/blocks/FreightContractsSkeleton.astro'

import MagnifierIcon from '@components/icons/buttons/MagnifierIcon.astro';

import { freight_contracts_history_csv_url } from '@helpers/api.minmatar.org/freights'
import type { User } from '@dtypes/jwt'
import * as jose from 'jose'

const page_title = t('freight_contracts.history.page_title');
const breadcrumb_items = [
    { label: t('freight.calculator.page_title'), href: translatePath('/market/freight/calculator/') },
    { label: t('freight_contracts.page_title'), href: translatePath('/market/freight/contracts/') },
    { label: t('freight_contracts.history.page_title') },
]
const contracts_count_text = t('showing_contracts_plural').replace('{count}', '0')
const csv_url = freight_contracts_history_csv_url()
const auth_token = Astro.cookies.has('auth_token')
    ? (Astro.cookies.get('auth_token')?.value as string)
    : false
const user: User | false = auth_token ? jose.decodeJwt(auth_token) as User : false
const can_download_csv = Boolean(auth_token && user)
---

<Viewport
    title={page_title}
    meta_description={t('freight_contracts.history.meta_description')}
    components={{
        tippy: true,
    }}
>
    <PageWide
        cover={{
            image: '/images/freight-service-cover.jpg',
            image_990: '/images/freight-service-cover.jpg',
            animated: false,
            scrollable: true,
            overlay: true,
        }}
        sticky={true}
        x-data={`{
            contracts_count: 0,
            last_updated_text: '',
            item_name_filter: '',
            contracts_plural: '${t('showing_contracts_plural')}',
            contracts_singular: '${t('showing_contracts_singular')}',
            countVisibleElements(selector, parent = document) {
                const elements = parent.querySelectorAll(selector)
                let visible_count = 0

                elements.forEach(element => {
                    const is_visible = element.offsetParent !== null
                    if (is_visible)
                        visible_count++
                })

                return visible_count
            },
            show_item(el) {
                const name_filter_element = el.querySelectorAll('.freight-contract-item')

                return ( this.item_name_filter === '' || name_filter_element[0].textContent.toLowerCase().includes(this.item_name_filter.toLowerCase()) )
            },
        }`}
    >
        <FlexInline slot="header" justification='space-between' class="[ w-full ]">
            <Flexblock gap="var(--space-s)">
                <Breadcrumb items={breadcrumb_items} />
                <Flexblock gap="var(--space-3xs)">
                    <PageTitle>
                        {page_title}
                    </PageTitle>
                    <small x-text="(contracts_count != 1 ? contracts_plural : contracts_singular).replace('{count}', String(contracts_count))">{contracts_count_text}</small>
                    <small x-show="last_updated_text" x-text="last_updated_text"></small>
                </Flexblock>
            </Flexblock>
            <FlexInline>
                {can_download_csv &&
                    <Button
                        href={csv_url}
                        size='sm'
                        data-tippy-content={t('download_freight_contracts_csv_tip')}
                    >
                        {t('download_freight_contracts_csv')}
                    </Button>
                }
                <Input type="text"
                    placeholder={t('search')}
                    x-model="item_name_filter"
                    x-on:keyup="setTimeout(function () { contracts_count = countVisibleElements('.freight-contract-item') })"
                    x-init="$el.focus()"
                    width='250px'
                >
                    <MagnifierIcon slot="icon" />
                </Input>
            </FlexInline>
        </FlexInline>

        <div
            id="freight-contracts-slot"
            data-freight-contracts-deferred="1"
            hx-get={FREIGHT_CONTRACTS_PARTIAL_URL}
            hx-trigger="load"
            hx-swap="innerHTML"
            hx-indicator=".loader"
            aria-busy="true"
            aria-live="polite"
        >
            <FreightContractsSkeleton show_history_cta={false} show_metrics={false} />
        </div>
    </PageWide>
</Viewport>

<script>
    function refreshFreightContractsSlot() {
        const slot = document.getElementById('freight-contracts-slot')
        if (!slot)
            return

        slot.setAttribute('aria-busy', 'false')
        if (typeof htmx !== 'undefined')
            htmx.process(slot)
        if (typeof Alpine !== 'undefined')
            Alpine.initTree(slot)
        if (typeof tippy === 'function') {
            tippy('#freight-contracts-slot [data-tippy-content]', {
                delay: [100, 200],
                arrow: true,
            })
        }
    }

    function isFreightContractsRequest(event: any): boolean {
        const path = String(
            event.detail?.pathInfo?.requestPath
                || event.detail?.xhr?.responseURL
                || event.detail?.elt?.getAttribute?.('hx-get')
                || '',
        )
        return path.includes('freight_contracts_component')
    }

    function bindFreightContractsDeferred() {
        const slot = document.getElementById('freight-contracts-slot')
        if (!slot || slot.dataset.bound === '1')
            return
        slot.dataset.bound = '1'

        document.body.addEventListener('htmx:afterSwap', (event: any) => {
            if (!isFreightContractsRequest(event))
                return
            refreshFreightContractsSlot()
        })

        document.body.addEventListener('htmx:afterRequest', (event: any) => {
            if (!isFreightContractsRequest(event))
                return
            if (!event.detail?.successful) {
                const root = document.getElementById('freight-contracts-slot')
                root?.setAttribute('aria-busy', 'false')
            }
        })
    }

    bindFreightContractsDeferred()
    document.addEventListener('astro:page-load', bindFreightContractsDeferred)
</script>
