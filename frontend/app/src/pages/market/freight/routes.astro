---
import { i18n } from '@helpers/i18n'
const { t, translatePath, lang } = i18n(Astro.url)

import { HTTP_404_Not_Found, login_redirect } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'
import { get_gates, can } from '@helpers/gates'
import { query_string } from '@helpers/string'

const { user } = get_request_user(Astro)
if (!user) return login_redirect(Astro)

let can_manage = false
try {
    can_manage = can(await get_gates(Astro), 'freight.manage')
} catch (error) {
    console.log(error)
}
if (!can_manage) return HTTP_404_Not_Found()

const partial_url = (values: Record<string, string>) => translatePath(`/partials/freight_routes_component/?${query_string(values)}`)

import Viewport from '@layouts/Viewport.astro'
import PageLanding from '@components/page/PageLanding.astro'
import PageBreadcrumbs from '@components/page/PageBreadcrumbs.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import LazyPartial from '@components/blocks/LazyPartial.astro'
import Button from '@components/blocks/Button.astro'
import DialogButton from '@components/blocks/DialogButton.astro'
import ManageHero from '@components/blocks/manage/ManageHero.astro'
import EntityPicker from '@components/blocks/manage/EntityPicker.astro'
import FreightPricingFields from '@components/blocks/market_settings/FreightPricingFields.astro'

const page_title = t('freight.routes.page_title')
const breadcrumbs = [
    { page_title: t('market.page_title'), accumulated_path: translatePath('/market/') },
    { page_title: t('manage.freight.crumb_freight'), accumulated_path: translatePath('/market/freight/calculator/') },
    { page_title: t('manage.freight.crumb'), accumulated_path: Astro.url.pathname },
]
---

<Viewport title={page_title} meta_description={t('freight.routes.meta_description')} components={{ alert_dialog: true }}>
<PageLanding wide={true} lang={lang}>
    <Flexblock gap="var(--space-xl)">
        <Flexblock gap="var(--space-m)">
            <PageBreadcrumbs is_landing_page={true} links_only={true} breadcrumbs={breadcrumbs} />
            <ManageHero title={page_title} role={t('manage.freight.role')} fact={t('manage.freight.fact')}>
                <Fragment slot="actions">
                    <Button color="transparent" href={translatePath('/market/freight/contracts/')}>{t('manage.freight.contract_stats')}</Button>
                    <DialogButton color="fleet-red" max_width="40rem">
                        {t('freight.routes.add_button')}
                        <form
                            slot="dialog"
                            class="[ manage-form ]"
                            hx-post={partial_url({ part: 'list' })}
                            hx-target="#freight-list-root"
                            hx-select="#freight-list-root"
                            hx-swap="outerHTML"
                            hx-include="#freight-filters"
                            x-data="{ submitting: false }"
                            {...{
                                // Only this form's own request: the picker's searches bubble up too.
                                'x-on:htmx:before-request': 'if ($event.target === $el) submitting = true',
                                'x-on:htmx:after-request': `if ($event.target !== $el) return; submitting = false; if ($event.detail.successful) { $el.reset(); close_dialog() } else $refs.error.textContent = $event.detail.xhr.responseText.replace(/<[^>]*>/g, '').trim() || ${JSON.stringify(t('manage.kit.confirm_failed'))}`,
                            }}
                        >
                            <input type="hidden" name="action" value="add_route" />
                            <h3>{t('freight.routes.add_button')}</h3>
                            <p class="[ manage-muted ]">{t('manage.freight.one_direction')}</p>
                            <div class="[ manage-fields ]">
                                <EntityPicker id="freight-add-origin" kind="location" name="origin_location_id" label={t('freight.routes.origin')} required={true} />
                                <EntityPicker id="freight-add-destination" kind="location" name="destination_location_id" label={t('freight.routes.destination')} required={true} />
                            </div>
                            <FreightPricingFields key="freight-add" />
                            <p class="[ manage-field__error ]" role="alert" x-ref="error"></p>
                            <FlexInline justification="flex-end">
                                <Button type="button" size="sm" color="transparent" x-on:click="close_dialog()">{t('cancel')}</Button>
                                <Button type="submit" size="sm" color="fleet-red" x-bind:disabled="submitting">{t('freight.routes.add_button')}</Button>
                            </FlexInline>
                        </form>
                    </DialogButton>
                </Fragment>
            </ManageHero>
        </Flexblock>

        <LazyPartial url={partial_url({ part: 'list' })} swap="outerHTML">
            <p class="[ manage-muted ]">{t('loading')}</p>
        </LazyPartial>
    </Flexblock>
</PageLanding>
</Viewport>
