---
import { i18n, t_key } from '@helpers/i18n'
const { t, lang, translatePath } = i18n(Astro.url)

import type { StructureLocationList } from '@dtypes/api.minmatar.org'
import { get_request_user } from '@helpers/request_user'
import { get_gates, can } from '@helpers/gates'
import { get_structure_locations } from '@helpers/api.minmatar.org/structure_locations'
import { get_item_icon } from '@helpers/eve_image_server'
import { in_view, STRUCTURE_VIEWS, type StructureView } from '@helpers/structure_locations'

const { auth_token } = get_request_user(Astro)
const gates = await get_gates(Astro)
const can_manage = can(gates, 'structures.locations.manage')

const requested = Astro.url.searchParams.get('view') ?? 'all'
const view: StructureView = (STRUCTURE_VIEWS as string[]).includes(requested) ? requested as StructureView : 'all'

let list: StructureLocationList | null = null
let list_error: Error | null = null
try {
    list = await get_structure_locations(auth_token)
} catch (failure) {
    list_error = failure as Error
}

const locations = list?.locations ?? []
const shown = locations.filter((card) => in_view(card, view))
const staging = locations.find((card) => card.staging)
const counts = Object.fromEntries(STRUCTURE_VIEWS.map((name) => [name, locations.filter((card) => in_view(card, name)).length]))

const page_title = t('structures.page_title')
const breadcrumbs = [{ page_title, accumulated_path: translatePath('/structures/') }]
const backdrop = get_item_icon(staging?.type_id ?? 35833, 512)

import Viewport from '@layouts/Viewport.astro'
import PageLanding from '@components/page/PageLanding.astro'
import PageBreadcrumbs from '@components/page/PageBreadcrumbs.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import Button from '@components/blocks/Button.astro'
import Textarea from '@components/blocks/Textarea.astro'
import Input from '@components/blocks/Input.astro'
import EmptyState from '@components/blocks/EmptyState.astro'
import StructureCard from '@components/blocks/structures/StructureCard.astro'
import StructureFlags from '@components/blocks/structures/StructureFlags.astro'
import StructureAddDialog from '@components/blocks/structures/StructureAddDialog.astro'
---

<Viewport title={page_title} meta_description={t('structures.description')} components={{ modal: true }}>
<PageLanding wide={true} lang={lang}>
    <Flexblock gap="var(--space-l)">
        <header class="[ structures-band ]">
            <img class="[ structures-band__art ]" src={backdrop} alt="" width="512" height="512" />
            <span class="[ structures-band__veil ]" aria-hidden="true"></span>
            <PageBreadcrumbs is_landing_page={true} links_only={true} breadcrumbs={breadcrumbs} />
            <div class="[ structures-band__top ]">
                <div>
                    <h1>{page_title}</h1>
                    <p class="[ structures-band__lead ]">{t('structures.lead')}</p>
                    {staging &&
                        <a class="[ structures-band__staging ]" href={translatePath(`/structures/${staging.location_id}/`)}>
                            <StructureFlags flags={[{ kind: 'staging' }]} />
                            <span>{staging.short_name}</span>
                        </a>
                    }
                </div>
                <div class="[ structures-band__acts ]">
                    {can_manage && <Button size="sm" color="transparent" href={translatePath('/structures/manage/')}>{t('structures.manage')}</Button>}
                    {list?.can_add && <StructureAddDialog />}
                </div>
            </div>
        </header>

        <div class="[ structures-controls ]" x-data="{ q: '' }">
            <label class="[ visually-hidden ]" for="structures-search">{t('structures.search')}</label>
            <Input id="structures-search" type="search" placeholder={t('structures.search')} x-model="q"
                x-on:input="document.querySelectorAll('[data-structure-name]').forEach((el) => el.hidden = q && !el.dataset.structureName.includes(q.toLowerCase()))" />
            <nav class="[ manage-chips ]" aria-label={t('structures.views')}>
                {STRUCTURE_VIEWS.map((name) => (
                    <a class:list={['[ manage-chip ]', { 'is-on': name === view }]} href={`?view=${name}`} aria-current={name === view ? 'page' : undefined}>
                        {t(t_key('structures.view_', name))} <span class="[ manage-muted ]">{counts[name]}</span>
                    </a>
                ))}
            </nav>
        </div>

        {list_error
            ? (
                <EmptyState title={t('structures.load_error')} hint={list_error.message} />
            )
            : (
                <div class="[ structures-grid ]">
                    {shown.map((card) => (
                        <div data-structure-name={`${card.name} ${card.solar_system_name} ${card.rigs.map((r) => r.label).join(' ')}`.toLowerCase()}>
                            <StructureCard card={card} view={view} />
                        </div>
                    ))}
                    {list?.can_add &&
                        <div class="[ structures-paste ]" x-data="{ text: '' }">
                            <label class="[ structures-paste__title ]" for="structures-paste">{t('structures.add.title')}</label>
                            <Textarea id="structures-paste" rows="6" x-model="text" placeholder={t('structures.add.quick_placeholder')} />
                            <Button type="button" size="sm" color="green"
                                x-on:click="window.dispatchEvent(new CustomEvent('structure-add-paste', { detail: text }))">
                                {t('structures.add.find_it')}
                            </Button>
                        </div>
                    }
                </div>
            )
        }
        {!list_error && shown.length === 0 && !list?.can_add &&
            <EmptyState title={t('structures.empty')} hint={auth_token ? undefined : t('structures.sign_in_hint')} />
        }
    </Flexblock>
</PageLanding>
</Viewport>

<style lang="scss">
    .structures-band {
        position: relative;
        isolation: isolate;
        display: flex;
        flex-direction: column;
        gap: var(--space-m);
        padding: var(--space-l) 0;
        overflow: hidden;
    }

    .structures-band__art {
        position: absolute;
        top: 0;
        right: 0;
        z-index: -2;
        width: 70%;
        height: 100%;
        object-fit: cover;
        filter: blur(4px);
        opacity: 0.8;
    }

    .structures-band__veil {
        position: absolute;
        inset: 0;
        z-index: -1;
        background:
            linear-gradient(90deg, var(--background) 0%, color-mix(in srgb, var(--background) 55%, transparent) 55%, color-mix(in srgb, var(--background) 35%, transparent) 100%),
            linear-gradient(0deg, var(--background) 0%, transparent 45%);
    }

    .structures-band__top {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: var(--space-m);
    }

    .structures-band__lead {
        margin-top: var(--space-2xs);
        font-size: var(--step-0);
    }

    .structures-band__staging {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2xs);
        margin-top: var(--space-s);
        font-weight: 600;
        color: var(--highlight);
        text-decoration: none;
    }

    .structures-band__acts {
        display: flex;
        align-items: center;
        gap: var(--space-s);
    }

    .structures-controls {
        display: flex;
        flex-direction: column;
        gap: var(--space-s);

        .manage-chip.is-on {
            color: var(--background);
            background-color: var(--fleet-yellow);
            border-color: var(--fleet-yellow);

            :global(.manage-muted) {
                color: inherit;
                opacity: 0.7;
            }
        }
    }

    .structures-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
        gap: var(--space-s);
    }

    .structures-paste {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
        min-height: 29rem;
        padding: var(--space-m);
        border: 1px dashed var(--hairline-strong);

        :global(textarea) {
            flex: 1;
        }
    }

    .structures-paste__title {
        font-family: var(--heading-font);
        font-size: var(--step-1);
        line-height: 1.05;
        text-transform: uppercase;
        color: var(--highlight);
    }
</style>
