---
import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

import { account_user_id_query } from '@helpers/account_user_query'
import { get_api_url, get_app_url } from '@helpers/env'

const redirect = Astro.url.searchParams.get('redirect')

if (redirect)
    Astro.cookies.set('redirect_after_add_primary_pilot', redirect, { path: '/' })

const account_user_query = account_user_id_query(Astro.cookies.get('auth_token')?.value)

return Astro.redirect(`${get_api_url()}/api/eveonline/characters/add?redirect_url=${get_app_url()}${translatePath('/redirects/add_primary_character')}&token_type=Basic${account_user_query}`)
---