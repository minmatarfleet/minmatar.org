---
import { i18n } from '@helpers/i18n'
import { get_discord_oauth_start_url } from '@helpers/env'
import { get_site_origin, page_seo_for_path, pathname_from_return_target } from '@helpers/seo'
import Viewport from '@layouts/Viewport.astro'
import PageCover from '@components/page/partials/PageCover.astro'
import DiscordLoginNotice from '@components/blocks/DiscordLoginNotice.astro'

const { t } = i18n(Astro.url)

const redirect = Astro.url.searchParams.get('redirect_url')

if (redirect)
    Astro.cookies.set('redirect_after_auth', redirect, { path: '/' })

const return_path = redirect ? pathname_from_return_target(redirect, Astro.url.origin) : null
const page_seo = return_path ? page_seo_for_path(return_path, t) : null
const title = page_seo?.title ?? t('discord_login_notice_title')
const meta_description = page_seo?.description ?? t('discord_login_notice_meta')
const canonical_url = page_seo && return_path
    ? new URL(return_path, get_site_origin(Astro.url.origin)).href
    : undefined

const AUTH_URL = get_discord_oauth_start_url()
const DISCORD_LOGIN_NOTICE_STORAGE_KEY = 'discord_login_notice_accepted'
const DISCORD_LOGIN_NOTICE_ACCEPTED_VALUE = '1'
---

<Viewport
    title={title}
    neocom={false}
    meta_description={meta_description}
    canonical_url={canonical_url}
    robots="noindex, nofollow"
>
    <script is:inline define:vars={{ AUTH_URL, DISCORD_LOGIN_NOTICE_STORAGE_KEY, DISCORD_LOGIN_NOTICE_ACCEPTED_VALUE }}>
        try {
            if (localStorage.getItem(DISCORD_LOGIN_NOTICE_STORAGE_KEY) === DISCORD_LOGIN_NOTICE_ACCEPTED_VALUE) {
                window.location.replace(AUTH_URL)
            }
        } catch (e) {}
    </script>

    <PageCover
        image="/images/account-cover.jpg"
        image_990="/images/account-cover-990.jpg"
        overlay={true}
    />

    <main
        id="content"
        class="[ auth-init ]"
    >
        <DiscordLoginNotice />
    </main>
</Viewport>

<style lang="scss">
    .auth-init {
        position: relative;
        z-index: 1;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>
