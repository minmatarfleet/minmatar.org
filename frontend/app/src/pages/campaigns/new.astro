---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import { HTTP_403_Forbidden, login_redirect } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'
import { get_gates, can } from '@helpers/gates'
import { get_campaign_choices, type CampaignChoice } from '@helpers/api.minmatar.org/campaigns'

import Viewport from '@layouts/Viewport.astro'
import PageDefault from '@components/page/PageDefault.astro'
import PageTitle from '@components/page/PageTitle.astro'
import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import CampaignNewForm from '@components/blocks/CampaignNewForm.astro'

const { auth_token, user } = get_request_user(Astro)
if (!user || !auth_token) return login_redirect(Astro)

const gates = await get_gates(Astro)
if (!can(gates, 'campaigns.create'))
    return HTTP_403_Forbidden()

// The same form as the "New campaign" dialog on /campaigns/; this route stays for released links.
let kinds: CampaignChoice[] = []
let fetch_error = ''
try {
    kinds = (await get_campaign_choices(auth_token)).kind
} catch (error) {
    fetch_error = error.message
}

const page_title = t('campaigns.manage.new')
const breadcrumbs = [
    { page_title: t('campaigns.page_title'), accumulated_path: '/campaigns/' },
    { page_title, accumulated_path: '/campaigns/new/' },
]
---

<Viewport title={page_title} meta_description={t('campaigns.new.meta_description')}>
    <PageDefault
        cover={{
            image: '/images/warzone-cover.jpg',
            image_990: '/images/warzone-cover.jpg',
            animated: false,
            scrollable: true,
            overlay: true,
        }}
        breadcrumbs={breadcrumbs}
    >
        <PageTitle slot="header">{page_title}</PageTitle>

        <ComponentBlock>
            <CampaignNewForm kinds={kinds} errors={fetch_error ? { form: fetch_error } : {}} show_title={false} />
        </ComponentBlock>
    </PageDefault>
</Viewport>
