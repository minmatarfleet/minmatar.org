---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden, login_redirect } from '@helpers/http_responses'

import { get_request_user } from '@helpers/request_user'

import { get_gates, can } from '@helpers/gates'

import Viewport from '@layouts/Viewport.astro'
import PageWide from '@components/page/PageWide.astro'
import PageTitle from '@components/page/PageTitle.astro'
import PageActions from '@components/page/PageActions.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import Button from '@components/blocks/Button.astro'
import FleetsHubTabs from '@components/blocks/FleetsHubTabs.astro'
import LazyPartial from '@components/blocks/LazyPartial.astro'
import CampaignListSkeleton from '@components/blocks/CampaignListSkeleton.astro'
import CogIcon from '@components/icons/buttons/CogIcon.astro'

const { user } = get_request_user(Astro)

if (!user) return login_redirect(Astro)

const gates = await get_gates(Astro)

const can_view_campaigns = can(gates, 'campaigns.view')
const can_manage_campaigns = can(gates, 'campaigns.manage')
const can_create_campaigns = can(gates, 'campaigns.create')

if (!can_view_campaigns)
    return HTTP_403_Forbidden()

// The list loads after the page: the shell answers without waiting for the
// campaigns call, and the partial renders the list (or ErrorRefetch).
const CAMPAIGNS_PARTIAL_URL = translatePath('/partials/campaign_list_component')

const page_title = t('campaigns.page_title')

const breadcrumbs = [
    { page_title, accumulated_path: '/campaigns/' },
]
---

<Viewport
    title={page_title}
    meta_description={t('campaigns.meta_description')}
    components={{
        alert_dialog: true,
        confirm_dialog: true,
    }}
>
    <PageWide
        cover={{
            image: '/images/warzone-cover.jpg',
            image_990: '/images/warzone-cover.jpg',
            animated: false,
            scrollable: true,
            overlay: true,
        }}
        breadcrumbs={breadcrumbs}
    >
        <FlexInline slot="header" justification='space-between' class="[ w-full ]">
            <PageTitle>
                {page_title}
            </PageTitle>
            <PageActions>
                {can_create_campaigns && (
                    <Button href={translatePath('/campaigns/new/')} color="fleet-red" size="sm">
                        {t('campaigns.new.page_title')}
                    </Button>
                )}
                {can_manage_campaigns && (
                    <Button
                        href={translatePath('/campaigns/event-codes/')}
                        color="transparent"
                        narrow={true}
                        aria-label={t('campaigns.codes.page_title')}
                        title={t('campaigns.codes.page_title')}
                    >
                        <CogIcon slot="icon" />
                    </Button>
                )}
            </PageActions>
        </FlexInline>

        <FleetsHubTabs active="campaigns" />

        <LazyPartial url={CAMPAIGNS_PARTIAL_URL} swap="outerHTML">
            <CampaignListSkeleton />
        </LazyPartial>
    </PageWide>

</Viewport>
