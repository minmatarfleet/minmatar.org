---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden } from '@helpers/http_responses'

import type { User } from '@dtypes/jwt'
import * as jose from 'jose'

import { get_user_permissions } from '@helpers/permissions'
import type { CampaignListItem } from '@dtypes/api.minmatar.org'
import { get_campaigns } from '@helpers/api.minmatar.org/campaigns'
import { getAllCampaigns } from '@/data/campaigns'

import Viewport from '@layouts/Viewport.astro'
import PageWide from '@components/page/PageWide.astro'
import PageTitle from '@components/page/PageTitle.astro'
import PageActions from '@components/page/PageActions.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import Button from '@components/blocks/Button.astro'
import CampaignList from '@components/blocks/CampaignList.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import CampaignSwapInit from '@components/partials/CampaignSwapInit.astro'
import CogIcon from '@components/icons/buttons/CogIcon.astro'

const auth_token = Astro.cookies.has('auth_token') ? (Astro.cookies.get('auth_token')?.value as string) : false
const user:User | false = auth_token ? jose.decodeJwt(auth_token) as User : false
const is_superuser = (user ? user?.is_superuser : false)
const user_is_staff = Boolean(user && user.is_staff)

if (!user) return Astro.redirect(`${translatePath('/redirects/auth_init')}?redirect_url=${Astro.url}`)

const user_permissions = (user ? await get_user_permissions(user?.username) : [])

const can_view_campaigns = is_superuser || user_permissions.includes('campaigns.view_campaign')
const can_edit_in_admin = user_is_staff || is_superuser || user_permissions.includes('campaigns.change_campaign')

if (!can_view_campaigns)
    return HTTP_403_Forbidden()

let fetch_campaigns_error:Error | false = false
let campaigns:CampaignListItem[] = []

try {
    campaigns = await get_campaigns(auth_token as string)
} catch (error) {
    fetch_campaigns_error = error
}

const retrospectives = getAllCampaigns()

const CAMPAIGNS_PARTIAL_URL = translatePath('/partials/campaign_list_component')

const page_title = t('campaigns.page_title')
const api_base = import.meta.env.API_URL || ''
const admin_campaigns_url = `${api_base}/admin/campaigns/campaign/`

const breadcrumbs = [
    { page_title, accumulated_path: '/campaigns/' },
]
---

<Viewport
    title={page_title}
    meta_description={t('campaigns.meta_description')}
    components={{
        alert_dialog: true,
        confirm_dialog: true,
    }}
>
    <PageWide
        cover={{
            image: '/images/warzone-cover.jpg',
            image_990: '/images/warzone-cover.jpg',
            animated: false,
            scrollable: true,
            overlay: true,
        }}
        breadcrumbs={breadcrumbs}
    >
        <FlexInline slot="header" justification='space-between' class="[ w-full ]">
            <PageTitle>
                {page_title}
            </PageTitle>
            <PageActions>
                {can_edit_in_admin && (
                    <Button
                        href={admin_campaigns_url}
                        color="transparent"
                        narrow={true}
                        new_tab={true}
                        aria-label={t('campaigns.manage_in_admin')}
                        title={t('campaigns.manage_in_admin')}
                    >
                        <CogIcon slot="icon" />
                    </Button>
                )}
            </PageActions>
        </FlexInline>

        {fetch_campaigns_error ? (
            <ErrorRefetch
                args={{
                    partial: CAMPAIGNS_PARTIAL_URL,
                    error: fetch_campaigns_error,
                    delay: 0,
                }}
            />
        ) : (
            <CampaignList campaigns={campaigns} retrospectives={retrospectives} />
        )}
    </PageWide>

    <CampaignSwapInit />
</Viewport>
