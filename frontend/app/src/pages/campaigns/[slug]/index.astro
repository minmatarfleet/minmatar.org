---
import { i18n } from '@helpers/i18n'
const { t, lang, translatePath } = i18n(Astro.url)
import { eve_day_short } from '@helpers/date'

import { HTTP_403_Forbidden, HTTP_404_Not_Found, login_redirect } from '@helpers/http_responses'

import { get_request_user } from '@helpers/request_user'

import { get_gates, can } from '@helpers/gates'
import type {
    CampaignDetail,
    CampaignWeek,
    CampaignFleet,
    CampaignLeaderboardRow,
    CampaignCorporationLeaderboardRow,
    CampaignKillmail,
    CampaignSite,
    CampaignRoster,
    CampaignReadiness,
} from '@dtypes/api.minmatar.org'
import {
    get_campaign,
    get_campaign_week,
    get_campaign_fleets,
    get_campaign_leaderboard,
    get_campaign_corporation_leaderboard,
    get_campaign_killmails,
    get_campaign_sites,
    get_campaign_roster,
    get_campaign_readiness,
    include_campaign_character,
    get_campaign_choices,
    type CampaignChoices,
} from '@helpers/api.minmatar.org/campaigns'
import { ACTIVITY_PAGE_SIZE, paginate } from '@helpers/fetching/campaigns'

import Viewport from '@layouts/Viewport.astro'
import PageWide from '@components/page/PageWide.astro'
import PageTitle from '@components/page/PageTitle.astro'
import PageActions from '@components/page/PageActions.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import Button from '@components/blocks/Button.astro'
import CampaignCountdown from '@components/blocks/CampaignCountdown.astro'
import Markdown from '@components/blocks/Markdown.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import CampaignDetailBody from '@components/blocks/CampaignDetail.astro'
import CampaignEnlistBar from '@components/blocks/CampaignEnlistBar.astro'
import DeploymentStrip from '@components/blocks/DeploymentStrip.astro'
import Tag from '@components/blocks/Tag.astro'
import CampaignSides from '@components/blocks/CampaignSides.astro'
import CampaignComingSoon from '@components/blocks/CampaignComingSoon.astro'

const { auth_token, user } = get_request_user(Astro)

if (!user) return login_redirect(Astro)

const gates = await get_gates(Astro)

const can_view_campaigns = can(gates, 'campaigns.view')

const slug = Astro.params.slug as string

const token_error = Astro.url.searchParams.get('error')
const token_error_message = token_error === 'wrong_character' || token_error === 'wrong_discord_account'
    ? t(token_error)
    : false

// The You tab sends a character through the ESI sign-in and comes back here
// with its id; including it now finishes the "Add to campaign" click.
const include_id = parseInt(Astro.url.searchParams.get('include') ?? '')
if (Number.isFinite(include_id) && include_id > 0) {
    try {
        await include_campaign_character(slug, auth_token as string, include_id)
    } catch (error) {
        console.log(`Could not include character ${include_id}: ${error.message}`)
    }
    const error_query = token_error ? `?error=${encodeURIComponent(token_error)}` : ''
    return Astro.redirect(`${translatePath(`/campaigns/${slug}/`)}${error_query}#you`)
}

let campaign:CampaignDetail | null = null
let fetch_campaign_error:Error | false = false

try {
    campaign = await get_campaign(slug, auth_token as string)
} catch (error) {
    if (error?.cause === 404)
        return HTTP_404_Not_Found()

    fetch_campaign_error = error
}

// Coordinators from outside the alliance have no campaigns gate; the API
// says who they are for this campaign.
const viewer_role = campaign?.viewer_role ?? 'member'
if (!can_view_campaigns && viewer_role !== 'coordinator')
    return HTTP_403_Forbidden()

/** Per-object rights come from the API: managers of this campaign. */
const can_manage_campaign = viewer_role === 'manager'
const is_coordinator = viewer_role === 'coordinator'
const is_redacted = campaign?.redacted ?? false
const before_start = campaign !== null && new Date(campaign.start_at).getTime() > Date.now()
const weeks = campaign
    ? Math.max(1, Math.round((new Date(campaign.end_at).getTime() - new Date(campaign.start_at).getTime()) / (7 * 86_400_000)))
    : 0

let week:CampaignWeek | null = null
let fleets:CampaignFleet[] = []
let leaderboard:CampaignLeaderboardRow[] = []
let corporation_board:CampaignCorporationLeaderboardRow[] = []
let killmails:{ rows:CampaignKillmail[]; has_more:boolean } = { rows: [], has_more: false }
let sites:{ rows:CampaignSite[]; has_more:boolean } = { rows: [], has_more: false }
let roster:CampaignRoster | null = null
let readiness:CampaignReadiness | null = null
let choices:CampaignChoices | null = null

/** Sub-resources answer 403 without `campaigns.view`; each section degrades on its own. */
if (campaign && !is_redacted) {
    const results = await Promise.allSettled([
        get_campaign_week(slug, auth_token as string),
        get_campaign_fleets(slug, auth_token as string, 25),
        get_campaign_leaderboard(slug, auth_token as string, 'kills', 'week'),
        get_campaign_killmails(slug, auth_token as string, '', ACTIVITY_PAGE_SIZE + 1),
        get_campaign_sites(slug, auth_token as string, ACTIVITY_PAGE_SIZE + 1),
        get_campaign_roster(slug, auth_token as string),
        get_campaign_readiness(auth_token as string),
        get_campaign_corporation_leaderboard(slug, auth_token as string, 'kills', 'week'),
        can_manage_campaign ? get_campaign_choices(auth_token as string) : Promise.resolve(null),
    ])

    week = results[0].status === 'fulfilled' ? results[0].value : null
    fleets = results[1].status === 'fulfilled' ? results[1].value : []
    leaderboard = results[2].status === 'fulfilled' ? results[2].value : []
    killmails = paginate(results[3].status === 'fulfilled' ? results[3].value : [])
    sites = paginate(results[4].status === 'fulfilled' ? results[4].value : [])
    roster = results[5].status === 'fulfilled' ? results[5].value : null
    readiness = results[6].status === 'fulfilled' ? results[6].value : null
    corporation_board = results[7].status === 'fulfilled' ? results[7].value : []
    choices = results[8].status === 'fulfilled' ? results[8].value : null
}

/** Enlisting only makes sense while the campaign can still be joined; coordinators are not in the alliance. */
const show_enlist_bar = campaign !== null && !is_coordinator && (campaign.status === 'active' || campaign.status === 'paused' || campaign.status === 'scheduled')

const CAMPAIGN_DETAIL_PARTIAL_URL = translatePath(`/partials/campaign_detail_component?slug=${slug}`)

const page_title = campaign ? campaign.name : t('campaigns.page_title')

const breadcrumbs = [
    { page_title: t('campaigns.page_title'), accumulated_path: '/campaigns/' },
    { page_title, accumulated_path: `/campaigns/${slug}/` },
]
---

<Viewport
    title={page_title}
    meta_description={campaign ? campaign.tagline : t('campaigns.meta_description')}
    components={{
        alert_dialog: true,
        confirm_dialog: true,
    }}
>
    <PageWide
        cover={{
            image: '/images/warzone-cover.jpg',
            image_990: '/images/warzone-cover.jpg',
            animated: false,
            scrollable: true,
            overlay: true,
        }}
        breadcrumbs={breadcrumbs}
    >
        <FlexInline slot="header" justification='space-between' class="[ w-full items-end ]">
            <Flexblock gap='var(--space-3xs)' class="[ campaign-header-title ]">
                {can_manage_campaign && campaign && (campaign.status === 'draft' || campaign.undisclosed) &&
                    <FlexInline gap='var(--space-3xs)'>
                        {campaign.status === 'draft' && <Tag text={t('draft')} variant='outline' />}
                        {campaign.undisclosed && <Tag text={t('campaigns.undisclosed')} variant='outline' />}
                    </FlexInline>
                }
                <PageTitle>
                    {page_title}
                </PageTitle>
                {campaign?.tagline && (
                    <p class="[ campaign-header-tagline ]">{campaign.tagline}</p>
                )}
                {campaign?.description_md && (
                    <Markdown markdown={campaign.description_md} inline={true} inline_element='p' class="[ campaign-header-description ]" />
                )}
            </Flexblock>
            <PageActions class="[ !items-end ]">
                {campaign && (
                    <Flexblock gap='var(--space-3xs)' class="[ campaign-header-countdown ]">
                        <small class="[ campaign-header-countdown-label ]">{before_start ? t('campaigns.starts_in') : t('campaigns.ends_in')}</small>
                        <CampaignCountdown
                            id={1}
                            date={new Date(before_start ? campaign.start_at : campaign.end_at)}
                            expired_text={t('campaigns.ended')}
                        />
                        {before_start && !is_redacted &&
                            <small class="[ campaign-header-runs ]">
                                {t('campaigns.runs_until').replace('{weeks}', String(weeks)).replace('{date}', eve_day_short(lang, campaign.end_at))}
                            </small>
                        }
                    </Flexblock>
                )}
                {can_manage_campaign && campaign?.kind === 'faction_warfare' && (
                    <Button
                        href={translatePath('/campaigns/event-codes/')}
                        color="transparent"
                        size="sm"
                    >
                        {t('campaigns.manage.payout_codes')}
                    </Button>
                )}
            </PageActions>
        </FlexInline>

        {campaign && !is_redacted && (campaign.parties?.length ?? 0) > 0 &&
            <CampaignSides parties={campaign.parties} all_href={can_manage_campaign ? '#settings' : null} class="[ campaign-header-sides ]" />
        }

        <DeploymentStrip />

        {campaign && is_redacted ?
            <CampaignComingSoon />
            :
        fetch_campaign_error || !campaign ?
            <ErrorRefetch
                args={{
                    partial: CAMPAIGN_DETAIL_PARTIAL_URL,
                    error: fetch_campaign_error || new Error(t('campaigns.action_failed')),
                    delay: 0,
                }}
            />
            :
            <CampaignDetailBody
                campaign={campaign}
                week={week}
                fleets={fleets}
                leaderboard={leaderboard}
                corporation_board={corporation_board}
                killmails={killmails}
                sites={sites}
                roster={roster}
                readiness={readiness}
                token_error={token_error_message}
                can_manage={can_manage_campaign}
                choices={choices}
                before_start={before_start}
            />
        }
    </PageWide>

    {show_enlist_bar && campaign &&
        <CampaignEnlistBar campaign={campaign} leaderboard={leaderboard} user_id={user.user_id} />
    }

</Viewport>

<style lang="scss">
    .campaign-header-title {
        min-width: 0;
        flex: 1 1 24rem;
    }

    .campaign-header-tagline {
        margin: 0;
        font-family: var(--heading-font);
        font-size: var(--step-0);
        line-height: 1.35;
        color: var(--highlight);
        max-width: 60ch;
    }

    .campaign-header-runs {
        color: var(--text-muted);
    }

    :global(.campaign-header-sides) {
        padding-block-start: var(--space-s);
        border-block-start: 1px solid var(--hairline);
    }

    .campaign-header-title :global(.campaign-header-description) {
        color: var(--foreground);
        max-width: 60ch;
    }

    .campaign-header-countdown {
        text-align: right;
    }

    .campaign-header-countdown-label {
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--foreground);
    }

    @media screen and (max-width: 767px) {
        .campaign-header-countdown {
            text-align: left;
        }
    }

    /* Phones: the countdown sits in the bottom action bar, so keep it to one or
       two short lines ("Ends in 14 days · Oct 31") instead of a 3-line block. */
    @media (max-width: 48rem) {
        .campaign-header-countdown :global(.campaign-countdown) {
            display: contents;
        }

        .campaign-header-countdown {
            flex-direction: row;
            flex-wrap: wrap;
            align-items: baseline;
            column-gap: var(--space-2xs);
            row-gap: 0;
            /* Take the row's free space so the admin cog stays beside it, not on a second row. */
            flex: 999 1 0;
            min-width: 0;
        }

        .campaign-header-countdown :global(.campaign-countdown-text) {
            font-size: var(--step-0);
            white-space: normal;
        }

        .campaign-header-countdown :global(.countdown) {
            font-size: var(--step-0);
            letter-spacing: 0.1em;
            text-indent: 0;
        }
    }
</style>
