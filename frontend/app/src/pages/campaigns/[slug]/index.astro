---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden, HTTP_404_Not_Found } from '@helpers/http_responses'

import type { User } from '@dtypes/jwt'
import * as jose from 'jose'

const auth_token = Astro.cookies.has('auth_token') ? (Astro.cookies.get('auth_token')?.value as string) : false
const user:User | false = auth_token ? jose.decodeJwt(auth_token) as User : false
const is_superuser = (user ? user?.is_superuser : false)

if (!user) return Astro.redirect(`${translatePath('/redirects/auth_init')}?redirect_url=${Astro.url}`)

import { get_user_permissions } from '@helpers/permissions'
const user_permissions = (user ? await get_user_permissions(user?.username) : [])

const can_view_campaigns = is_superuser || user_permissions.includes('campaigns.view_campaign')

if (!can_view_campaigns)
    return HTTP_403_Forbidden()

import type {
    CampaignDetail,
    CampaignWeek,
    CampaignFleet,
    CampaignLeaderboardRow,
    CampaignKillmail,
    CampaignSite,
    CampaignRoster,
    CampaignReadiness,
} from '@dtypes/api.minmatar.org'
import {
    get_campaign,
    get_campaign_week,
    get_campaign_fleets,
    get_campaign_leaderboard,
    get_campaign_killmails,
    get_campaign_sites,
    get_campaign_roster,
    get_campaign_readiness,
    include_campaign_character,
} from '@helpers/api.minmatar.org/campaigns'
import { ACTIVITY_PAGE_SIZE, paginate } from '@helpers/fetching/campaigns'

const slug = Astro.params.slug as string

// The You tab sends a character through the ESI sign-in and comes back here
// with its id; including it now finishes the "Add to campaign" click.
const include_id = parseInt(Astro.url.searchParams.get('include') ?? '')
if (Number.isFinite(include_id) && include_id > 0) {
    try {
        await include_campaign_character(slug, auth_token as string, include_id)
    } catch (error) {
        console.log(`Could not include character ${include_id}: ${error.message}`)
    }
    return Astro.redirect(`${translatePath(`/campaigns/${slug}/`)}#you`)
}

let campaign:CampaignDetail | null = null
let fetch_campaign_error:Error | false = false

try {
    campaign = await get_campaign(slug, auth_token as string)
} catch (error) {
    if (error?.cause === 404)
        return HTTP_404_Not_Found()

    fetch_campaign_error = error
}

let week:CampaignWeek | null = null
let fleets:CampaignFleet[] = []
let leaderboard:CampaignLeaderboardRow[] = []
let killmails:{ rows:CampaignKillmail[]; has_more:boolean } = { rows: [], has_more: false }
let sites:{ rows:CampaignSite[]; has_more:boolean } = { rows: [], has_more: false }
let roster:CampaignRoster | null = null
let readiness:CampaignReadiness | null = null

/** Sub-resources answer 403 without `campaigns.view`; each section degrades on its own. */
if (campaign) {
    const results = await Promise.allSettled([
        get_campaign_week(slug, auth_token as string),
        get_campaign_fleets(slug, auth_token as string, 25),
        get_campaign_leaderboard(slug, auth_token as string, 'points', 'week'),
        get_campaign_killmails(slug, auth_token as string, '', ACTIVITY_PAGE_SIZE + 1),
        get_campaign_sites(slug, auth_token as string, ACTIVITY_PAGE_SIZE + 1),
        get_campaign_roster(slug, auth_token as string),
        get_campaign_readiness(auth_token as string),
    ])

    week = results[0].status === 'fulfilled' ? results[0].value : null
    fleets = results[1].status === 'fulfilled' ? results[1].value : []
    leaderboard = results[2].status === 'fulfilled' ? results[2].value : []
    killmails = paginate(results[3].status === 'fulfilled' ? results[3].value : [])
    sites = paginate(results[4].status === 'fulfilled' ? results[4].value : [])
    roster = results[5].status === 'fulfilled' ? results[5].value : null
    readiness = results[6].status === 'fulfilled' ? results[6].value : null
}

const CAMPAIGN_DETAIL_PARTIAL_URL = translatePath(`/partials/campaign_detail_component?slug=${slug}`)

const page_title = campaign ? campaign.name : t('campaigns.page_title')

import Viewport from '@layouts/Viewport.astro'

import PageWide from '@components/page/PageWide.astro'
import PageTitle from '@components/page/PageTitle.astro'

import FlexInline from '@components/compositions/FlexInline.astro'
import Flexblock from '@components/compositions/Flexblock.astro'

import CampaignCountdown from '@components/blocks/CampaignCountdown.astro'
import Markdown from '@components/blocks/Markdown.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'

import CampaignDetailBody from '@components/blocks/CampaignDetail.astro'
import CampaignSwapInit from '@components/partials/CampaignSwapInit.astro'
---

<Viewport
    title={page_title}
    meta_description={campaign ? campaign.tagline : t('campaigns.meta_description')}
    components={{
        alert_dialog: true,
        confirm_dialog: true,
    }}
>
    <PageWide
        cover={{
            image: '/images/warzone-cover.jpg',
            image_990: '/images/warzone-cover.jpg',
            animated: false,
            scrollable: true,
            overlay: true,
        }}
    >
        <FlexInline slot="header" justification='space-between' class="[ w-full items-end ]">
            <Flexblock gap='var(--space-3xs)' class="[ campaign-header-title ]">
                <PageTitle>
                    {page_title}
                </PageTitle>
                {campaign?.description_md &&
                    <Markdown markdown={campaign.description_md} inline={true} inline_element='p' class="[ campaign-header-description ]" />
                }
            </Flexblock>
            {campaign &&
                <Flexblock gap='var(--space-3xs)' class="[ campaign-header-countdown ]">
                    <small class="[ campaign-header-countdown-label ]">{t('campaigns.ends_in')}</small>
                    <CampaignCountdown
                        id={1}
                        date={new Date(campaign.end_at)}
                        expired_text={t('campaigns.ended')}
                    />
                </Flexblock>
            }
        </FlexInline>

        {fetch_campaign_error || !campaign ?
            <ErrorRefetch
                args={{
                    partial: CAMPAIGN_DETAIL_PARTIAL_URL,
                    error: fetch_campaign_error || new Error(t('campaigns.action_failed')),
                    delay: 0,
                }}
            />
            :
            <CampaignDetailBody
                campaign={campaign}
                week={week}
                fleets={fleets}
                leaderboard={leaderboard}
                killmails={killmails}
                sites={sites}
                roster={roster}
                readiness={readiness}
            />
        }
    </PageWide>

    <CampaignSwapInit />
</Viewport>

<style lang="scss">
    .campaign-header-title {
        min-width: 0;
        flex: 1 1 24rem;
    }

    .campaign-header-title :global(.campaign-header-description) {
        color: var(--foreground);
        max-width: 60ch;
    }

    .campaign-header-countdown {
        text-align: right;
    }

    .campaign-header-countdown-label {
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--foreground);
    }

    @media screen and (max-width: 767px) {
        .campaign-header-countdown {
            text-align: left;
        }
    }
</style>
