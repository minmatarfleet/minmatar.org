---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden, login_redirect } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'
import { get_gates, can } from '@helpers/gates'

import Viewport from '@layouts/Viewport.astro'
import PageDefault from '@components/page/PageDefault.astro'
import PageTitle from '@components/page/PageTitle.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import Button from '@components/blocks/Button.astro'
import LazyPartial from '@components/blocks/LazyPartial.astro'

const { user } = get_request_user(Astro)
if (!user) return login_redirect(Astro)

const gates = await get_gates(Astro)
if (!can(gates, 'campaigns.manage'))
    return HTTP_403_Forbidden()

const slug = Astro.params.slug as string
if (!/^[a-z0-9-]+$/.test(slug))
    return HTTP_403_Forbidden()

const SETTINGS_PARTIAL_URL = translatePath(`/partials/campaign_settings_component?slug=${slug}`)
const page_title = t('campaigns.settings.page_title')

const breadcrumbs = [
    { page_title: t('campaigns.page_title'), accumulated_path: '/campaigns/' },
    { page_title: slug, accumulated_path: `/campaigns/${slug}/` },
    { page_title, accumulated_path: `/campaigns/${slug}/settings/` },
]
---

<Viewport title={page_title} meta_description={t('campaigns.settings.meta_description')}>
    <PageDefault
        cover={{
            image: '/images/warzone-cover.jpg',
            image_990: '/images/warzone-cover.jpg',
            animated: false,
            scrollable: true,
            overlay: true,
        }}
        breadcrumbs={breadcrumbs}
    >
        <FlexInline slot="header" justification='space-between' class="[ w-full ]">
            <PageTitle>{page_title}</PageTitle>
            <Button href={translatePath(`/campaigns/${slug}/`)} color="transparent" size="sm">
                {t('campaigns.settings.back')}
            </Button>
        </FlexInline>

        <LazyPartial url={SETTINGS_PARTIAL_URL}>
            <p>{t('campaigns.settings.loading')}</p>
        </LazyPartial>
    </PageDefault>
</Viewport>
