---
/**
 * Campaign settings moved into the campaign page's Settings tab. Released
 * links (and the desktop's web routes) still land here, so send them on.
 */
import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

import { HTTP_404_Not_Found } from '@helpers/http_responses'

const slug = Astro.params.slug as string
if (!/^[a-z0-9-]+$/.test(slug))
    return HTTP_404_Not_Found()

return Astro.redirect(`${translatePath(`/campaigns/${slug}/`)}#settings`, 301)
---
