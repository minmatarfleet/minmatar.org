---
/**
 * The Projects tab: open projects (lead, progress, target), finished ones,
 * and the templates to start from. Chips filter to projects the user
 * leads or has tasks in.
 */
import { i18n } from '@helpers/i18n'
const { t, lang, translatePath } = i18n(Astro.url)

import type { TaskProjectRow, TaskProjects } from '@dtypes/api.minmatar.org'
import { get_request_user } from '@helpers/request_user'
import { HTTP_403_Forbidden } from '@helpers/http_responses'
import { get_task_projects } from '@helpers/api.minmatar.org/tasks'
import { get_player_icon } from '@helpers/eve_image_server'
import { task_date } from '@helpers/tasks'

const { auth_token } = get_request_user(Astro)
if (!auth_token) return HTTP_403_Forbidden()

const VIEWS = ['all', 'i_lead', 'mine'] as const
type View = typeof VIEWS[number]
const raw_view = Astro.url.searchParams.get('view') as View
const view: View = VIEWS.includes(raw_view) ? raw_view : 'all'

const SELF_URL = translatePath('/partials/tasks_projects_component/')
const TARGET = 'tasks-projects'

let data: TaskProjects | null = null
let error: Error | null = null
try {
    data = await get_task_projects(auth_token)
} catch (failure) {
    error = failure as Error
}

const keep = (row: TaskProjectRow) => view === 'all' || (view === 'i_lead' ? row.i_lead : row.i_have_tasks)
const open_rows = data ? data.open.filter(keep) : []
const finished_rows = data ? data.finished.filter(keep) : []
const counts = data
    ? {
        all: data.open.length,
        i_lead: data.open.filter((row) => row.i_lead).length,
        mine: data.open.filter((row) => row.i_have_tasks).length,
    }
    : { all: 0, i_lead: 0, mine: 0 }

const percent = (row: TaskProjectRow) => row.tasks_total ? Math.round(100 * row.tasks_done / row.tasks_total) : 0
const sub = (row: TaskProjectRow) => [
    row.kind_label,
    row.team_label || t('tasks.projects.alliance'),
].filter(Boolean).join(' · ')

import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import EmptyState from '@components/blocks/EmptyState.astro'
import ManageTable from '@components/blocks/manage/ManageTable.astro'
import TaskProjectStartDialog from '@components/blocks/tasks/TaskProjectStartDialog.astro'
---

<div id={TARGET} class="[ tasks-projects ][ task-stack is-loose ]">
    {error || !data
        ? (
            <ErrorRefetch args={{
                partial: SELF_URL,
                error: error ?? new Error('Error fetching projects'),
                delay: 0,
                target: `#${TARGET}`,
            }} />
        )
        : (
            <>
                <nav class="[ manage-chips ]" aria-label={t('tasks.tab.projects')}>
                    {VIEWS.map((value) => (
                        <button
                            type="button"
                            class:list={['[ manage-chip ]', { 'is-on': view === value }]}
                            aria-current={view === value ? 'true' : undefined}
                            hx-get={`${SELF_URL}?view=${value}`}
                            hx-target={`#${TARGET}`}
                            hx-swap="outerHTML"
                        >
                            {t(value === 'all' ? 'tasks.projects.all' : value === 'i_lead' ? 'tasks.projects.i_lead' : 'tasks.projects.mine')}
                            <span class="[ manage-chip__count ]">{counts[value]}</span>
                        </button>
                    ))}
                </nav>

                {open_rows.length === 0 && finished_rows.length === 0 &&
                    <EmptyState title={t('tasks.projects.empty_title')} hint={data.can_start ? t('tasks.projects.empty_hint') : undefined} />
                }

                {([['open', open_rows], ['finished', finished_rows]] as const).map(([section, rows]) => rows.length > 0 && (
                    <section class="[ task-stack ]" aria-labelledby={`projects-${section}`}>
                        <h3 id={`projects-${section}`} class="[ manage-eyebrow ]">
                            {section === 'open' ? t('tasks.projects.open') : t('tasks.projects.finished')}
                        </h3>
                        <ManageTable
                            caption={section === 'open' ? t('tasks.projects.open') : t('tasks.projects.finished')}
                            expandable={false}
                            min_width="48rem"
                            columns={[
                                { label: t('tasks.projects.project') },
                                { label: t('tasks.projects.lead'), phone: false },
                                { label: t('tasks.projects.done'), phone: false },
                                { label: section === 'open' ? t('tasks.projects.target') : t('tasks.projects.finished_on'), align: 'num' },
                            ]}
                        >
                            <tbody>
                                {rows.map((row) => (
                                    <tr class="[ manage-row ]">
                                        <td>
                                            <a class="[ manage-who ]" href={translatePath(`/tasks/projects/${row.id}/`)}>
                                                <span class="[ manage-who__text ]">
                                                    <span class="[ manage-who__name ]">{row.name}</span>
                                                    <span class="[ manage-who__sub ]">
                                                        {sub(row)}
                                                        {row.update_missing && <span class="[ manage-warn ]"> · {t('tasks.projects.no_update')}</span>}
                                                    </span>
                                                </span>
                                            </a>
                                        </td>
                                        <td class="[ is-wide ]">
                                            {row.lead &&
                                                <span class="[ manage-who ]">
                                                    {row.lead.character_id && <img src={get_player_icon(row.lead.character_id, 64)} alt="" width="40" height="40" loading="lazy" />}
                                                    <span>{row.lead.name}</span>
                                                </span>
                                            }
                                        </td>
                                        <td class="[ is-wide ]">
                                            <div class="[ task-progress ]">
                                                <div class:list={['[ task-bar ]', { 'is-done': row.status !== 'open' }]} role="img" aria-label={t('tasks.projects.progress').replace('~DONE', String(row.tasks_done)).replace('~TOTAL', String(row.tasks_total))}>
                                                    <span style={`width: ${percent(row)}%`}></span>
                                                </div>
                                                <span>{t('tasks.projects.progress').replace('~DONE', String(row.tasks_done)).replace('~TOTAL', String(row.tasks_total))}</span>
                                            </div>
                                        </td>
                                        <td class:list={['[ num ]', { 'manage-good': row.status !== 'open' }]}>
                                            {row.status === 'open'
                                                ? (row.target_date ? task_date(row.target_date, lang) : '')
                                                : (row.finished_at ? task_date(row.finished_at, lang) : '')}
                                        </td>
                                    </tr>
                                ))}
                            </tbody>
                        </ManageTable>
                    </section>
                ))}

                {data.can_start && data.templates.length > 0 &&
                    <section class="[ task-stack ]" aria-labelledby="projects-start">
                        <h3 id="projects-start" class="[ manage-eyebrow ]">{t('tasks.projects.start')}</h3>
                        <TaskProjectStartDialog templates={data.templates} />
                    </section>
                }
            </>
        )
    }
</div>

