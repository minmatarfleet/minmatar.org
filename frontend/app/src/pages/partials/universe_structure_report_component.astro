---
/**
 * One step of the Report a structure dialog. The form posts `go` (the step to
 * show next) plus what the pilot entered so far; this renders that step.
 * Picking a known structure prefills owner, fit and hour from it.
 * Opened from a campaign, the form carries campaign_slug and the sent report
 * is attached to that campaign as well.
 */
// no-error-refetch: a form step; errors show inside the dialog.
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { UniverseStructure } from '@dtypes/api.minmatar.org'
import { get_request_user } from '@helpers/request_user'
import { HTTP_403_Forbidden } from '@helpers/http_responses'
import { match_universe_structures, report_universe_structure } from '@helpers/api.minmatar.org/universe'
import { attach_campaign_structure } from '@helpers/api.minmatar.org/campaigns'
import { get_structure_type } from '@helpers/eve'
import { parse_selected_item_timer } from '@helpers/selected_item_timer'
import UniverseReportSteps from '@components/blocks/universe/UniverseReportSteps.astro'
import type { UniverseReportState, UniverseReportStep } from '@components/blocks/universe/UniverseReportSteps.astro'

const { auth_token } = get_request_user(Astro)
if (!auth_token || Astro.request.method !== 'POST') return HTTP_403_Forbidden()

const form = await Astro.request.formData()
const text = (name: string) => String(form.get(name) ?? '').trim()
const number = (name: string) => {
    const value = parseInt(text(name))
    return Number.isFinite(value) ? value : null
}

const state: UniverseReportState = {
    system_name: text('system_name'),
    type_id: number('type_id'),
    name: text('name'),
    structure_id: number('structure_id'),
    campaign_slug: text('campaign_slug'),
    corporation_name: text('corporation_name'),
    alliance_name: text('alliance_name'),
    affiliated_alliance_name: text('affiliated_alliance_name'),
    fitting: text('fitting'),
    reinforce_hour: number('reinforce_hour'),
}

let step: UniverseReportStep = 'find'
let candidates: UniverseStructure[] = []
let picked: UniverseStructure | null = null
let error: string | null = null
const go = text('go') || 'find'

// The structures in that system like the one described, or an error for an unknown system.
const find_candidates = async () => {
    if (!state.system_name || state.type_id === null) throw new Error(t('universe.report.unknown_system'))
    const match = await match_universe_structures(auth_token, state.system_name, state.type_id, state.name)
    if (!match?.system_found) throw new Error(t('universe.report.unknown_system'))
    return match.candidates
}

// The Selected Item window gives the system and the name on its first line;
// the distance (and any timer) under it is dropped.
const read_selected_item = () => {
    const pasted = text('selected_item')
    if (!pasted) return
    const parsed = parse_selected_item_timer(pasted)
    if (!parsed.system_name) throw new Error(t('universe.report.unread'))
    const first = pasted.split(/\r?\n/).map((line) => line.trim()).find(Boolean) ?? ''
    state.system_name = parsed.system_name
    // As it shows in space ("Kamela - Knock Knock"); skyhooks keep their (location).
    state.name = first.includes(' - ') ? first : parsed.name
}

try {
    if (go === 'match') {
        read_selected_item()
        candidates = await find_candidates()
        step = 'match'
    } else if (go === 'owner') {
        if (text('prefill') && state.structure_id !== null) {
            // Picked a known structure: start from what we already hold, keep what the pilot typed.
            picked = (await find_candidates()).find((row) => row.id === state.structure_id) ?? null
            if (picked) {
                state.corporation_name ||= picked.corporation_name ?? ''
                state.alliance_name ||= picked.alliance_name ?? ''
                state.affiliated_alliance_name ||= picked.affiliated_alliance_name ?? ''
                state.fitting ||= picked.fitting ?? ''
                state.reinforce_hour ??= picked.reinforce_hour ?? null
            }
        }
        step = 'owner'
    } else if (go === 'fitting') {
        step = 'fitting'
    } else if (go === 'reinforce') {
        step = 'reinforce'
    } else if (go === 'send') {
        const report = {
            structure_id: state.structure_id,
            system_name: state.system_name,
            type_id: state.type_id ?? 0,
            name: state.name,
            corporation_name: state.corporation_name,
            alliance_name: state.alliance_name,
            affiliated_alliance_name: state.affiliated_alliance_name,
            reinforce_hour: state.reinforce_hour,
            fitting: state.fitting,
        }
        await report_universe_structure(auth_token, report)
        const structure_type = state.type_id === null ? null : get_structure_type(state.type_id)
        if (state.campaign_slug && structure_type) {
            await attach_campaign_structure(state.campaign_slug, auth_token, {
                name: report.name,
                structure_type,
                system_name: report.system_name,
                corporation_name: report.corporation_name,
                alliance_name: report.alliance_name,
                related_alliance_name: report.affiliated_alliance_name,
                fitting: report.fitting,
                reinforce_hour: report.reinforce_hour,
            })
        }
        step = 'sent'
    }
} catch (failure) {
    error = (failure as Error).message
    step = go === 'send' ? 'reinforce' : 'find'
}
---

<UniverseReportSteps step={step} state={state} candidates={candidates} picked={picked} error={error} selected_item={error && step === 'find' ? text('selected_item') : ''} />
