---
/**
 * Manage learning: Skillsets.
 *
 * part=list  the skillsets table (GET); new=1 adds an open blank row
 * part=edit  an open row's form (GET, id=)
 * part=save  save a skillset (POST): the row, open, inside a <table>
 * ?q=        skill-name typeahead: <option>s for the form's datalist
 *
 * Writes go through the learning manage API, which writes the audit log.
 */
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { get_request_user } from '@helpers/request_user'
import { HTTP_403_Forbidden } from '@helpers/http_responses'
import { get_gates, can } from '@helpers/gates'
import {
    get_manage_skillsets,
    save_manage_skillset,
    search_manage_skills,
} from '@helpers/api.minmatar.org/learning_manage'
import type { LearningManageSkillset } from '@dtypes/api.minmatar.org'
import { error_text, form_text } from '@helpers/manage_forms'
import { query_string } from '@helpers/string'
import { distinct_skills } from '@helpers/learning_manage'

import EmptyState from '@components/blocks/EmptyState.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import Button from '@components/blocks/Button.astro'
import ManageTable from '@components/blocks/manage/ManageTable.astro'
import LearningSkillsetRow from '@components/blocks/learning_manage/LearningSkillsetRow.astro'
import LearningSkillsetForm from '@components/blocks/learning_manage/LearningSkillsetForm.astro'

const { auth_token } = get_request_user(Astro)
if (!auth_token) return HTTP_403_Forbidden()
if (!can(await get_gates(Astro), 'skillsets.manage')) return HTTP_403_Forbidden()

const ROOT_ID = 'learning-manage-skillsets'
const params = Astro.url.searchParams
const part = params.get('part') ?? 'list'
const partial_url = (values: Record<string, string>) =>
    translatePath(`/partials/learning_manage_skillsets_component/?${query_string(values)}`)
const save_url = partial_url({ part: 'save' })
const search_url = translatePath('/partials/learning_manage_skillsets_component/')
const row_id_of = (id: number) => `skillset-${id}`

// Typeahead: the picker asks this partial for matching skill names.
const query = params.get('q')
if (query !== null) {
    const matches = query.trim().length >= 2 ? await search_manage_skills(auth_token, query.trim()) : []
    return new Response(matches.map((skill) => `<option value="${skill.name.replace(/&/g, '&amp;').replace(/"/g, '&quot;')}"></option>`).join(''), {
        headers: { 'Content-Type': 'text/html; charset=utf-8' },
    })
}

// part=save
let saved: LearningManageSkillset | null = null
let save_error: string | null = null
let posted: { id: number | null; name: string; skills: { name: string; level: number }[]; row_id: string } | null = null
if (part === 'save' && Astro.request.method === 'POST') {
    const form = await Astro.request.formData()
    const names = form.getAll('skill_name').map(String)
    const levels = form.getAll('skill_level').map((value) => parseInt(String(value)) || 5)
    const id = parseInt(form_text(form, 'skillset_id')) || null
    posted = {
        id,
        name: form_text(form, 'name'),
        skills: names.map((name, index) => ({ name, level: levels[index] ?? 5 })).filter((skill) => skill.name),
        row_id: form_text(form, 'row_id') || (id ? row_id_of(id) : 'skillset-new'),
    }
    try {
        saved = await save_manage_skillset(auth_token, id, { name: posted.name, skills: posted.skills })
    } catch (error) {
        save_error = error_text(error, t('learning_manage.error_save'))
    }
}

let skillsets: LearningManageSkillset[] = []
let error: Error | null = null
try {
    skillsets = await get_manage_skillsets(auth_token)
} catch (failure) {
    error = failure as Error
}

const COLUMNS = [
    { label: t('learning_admin.col_skillset') },
    { label: t('learning_admin.col_skills'), align: 'num' as const },
    { label: t('learning_admin.col_skill_points'), align: 'num' as const, phone: false },
]
const show_new = params.get('new') === '1'
const edit_skillset = part === 'edit' ? skillsets.find((skillset) => skillset.id === parseInt(params.get('id') ?? '')) ?? null : null
const row_skillset = saved ?? (posted?.id ? skillsets.find((skillset) => skillset.id === posted?.id) ?? null : null)
---

{part === 'list' && (
    error
        ? <div id={ROOT_ID}><ErrorRefetch args={{ partial: partial_url({ part: 'list' }), error, delay: 0 }} /></div>
        : (
            <div id={ROOT_ID} class="[ manage-list ]">
                {skillsets.length === 0 && !show_new
                    ? <EmptyState title={t('learning_admin.no_skillsets')} />
                    : (
                        <ManageTable caption={t('learning_admin.skillsets_caption')} columns={COLUMNS}>
                            {show_new &&
                                <LearningSkillsetRow skillset={null} row_id="skillset-new" open={true}>
                                    <LearningSkillsetForm slot="detail" name="" skills={[]} skillset_id={null} row_id="skillset-new" post_url={save_url} search_url={search_url} />
                                </LearningSkillsetRow>
                            }
                            {skillsets.map((skillset) => (
                                <LearningSkillsetRow
                                    skillset={skillset}
                                    row_id={row_id_of(skillset.id)}
                                    url={partial_url({ part: 'edit', id: String(skillset.id) })}
                                />
                            ))}
                        </ManageTable>
                    )
                }
                {!show_new &&
                    <div class="[ manage-actions ]">
                        <Button
                            type="button"
                            size="sm"
                            color="transparent"
                            narrow={true}
                            hx-get={partial_url({ part: 'list', new: '1' })}
                            hx-target={`#${ROOT_ID}`}
                            hx-swap="outerHTML"
                        >{t('learning_manage.skillsets_new')}</Button>
                    </div>
                }
            </div>
        )
)}

{part === 'edit' && (
    edit_skillset
        ? <LearningSkillsetForm name={edit_skillset.name} skills={distinct_skills(edit_skillset.skills)} skillset_id={edit_skillset.id} row_id={row_id_of(edit_skillset.id)} post_url={save_url} search_url={search_url} />
        : error
            ? <ErrorRefetch args={{ partial: partial_url({ part: 'edit', id: params.get('id') ?? '' }), error, delay: 0 }} />
            : <EmptyState title={t('learning_admin.skillset_gone')} />
)}

{part === 'save' && posted &&
    // Inside a <table>: htmx drops a bare <tbody> after Astro's leading styles.
    // The row keeps its id (a new skillset stays "skillset-new") so later saves find it.
    <table>
        <LearningSkillsetRow skillset={row_skillset} row_id={posted.row_id} open={true}>
            <LearningSkillsetForm
                slot="detail"
                name={saved?.name ?? posted.name}
                skills={distinct_skills(saved?.skills ?? posted.skills)}
                skillset_id={saved?.id ?? posted.id}
                row_id={posted.row_id}
                post_url={save_url}
                search_url={search_url}
                saved={saved !== null}
                error={save_error}
            />
        </LearningSkillsetRow>
    </table>
}
