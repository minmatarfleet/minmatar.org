---
import { i18n } from '@helpers/i18n'
const { t, translatePath, lang } = i18n(Astro.url)

import type { CorporationRedditPost, RedditMarkdownProblem } from '@dtypes/api.minmatar.org'
import { HTTP_403_Forbidden } from '@helpers/http_responses'
import {
    RedditSettingsError,
    disconnect_reddit_account,
    get_corporation_reddit_post,
    update_corporation_reddit_post,
} from '@helpers/api.minmatar.org/reddit'
import {
    format_eve_datetime,
    is_corporation_slug,
    parse_delivery_method,
    REDDIT_AUTOMATIC_POSTING,
    REDDIT_FORMATTING_GUIDE_URL,
    reddit_connect_flash,
    reddit_markdown_problem_key,
    reddit_save_error_key,
    reddit_section_summary,
    reddit_weekday_label,
} from '@helpers/corporations/reddit_settings'
import type { RedditFlash } from '@helpers/corporations/reddit_settings'
import { query_string } from '@helpers/string'

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import Button from '@components/blocks/Button.astro'
import Input from '@components/blocks/Input.astro'
import MarkdownTextArea from '@components/blocks/MarkdownTextArea.astro'
import Tag from '@components/blocks/Tag.astro'

const ROOT_ID = 'corporation-settings'
const PROBLEMS_ID = 'corp-settings-markdown-problems'
// Lives in the accordion header on the corporation page; refreshed out of band.
const SUMMARY_ID = 'corporation-settings-reddit-summary'

const auth_token = Astro.cookies.has('auth_token') ? Astro.cookies.get('auth_token')?.value : null
if (!auth_token) return HTTP_403_Forbidden()

const params = Astro.url.searchParams
const corporation_id = parseInt(params.get('corporation_id') ?? '')
const slug = params.get('corporation')
if (!corporation_id || !is_corporation_slug(slug)) return HTTP_403_Forbidden()

const PARTIAL_URL = translatePath(`/partials/corporation_settings_component/?${query_string({
    corporation_id: String(corporation_id),
    corporation: slug,
})}`)
const CONNECT_URL = translatePath(`/redirects/reddit_connect_init?${query_string({ corporation: slug })}`)

let flash: RedditFlash | null = reddit_connect_flash(params)
// Unsaved edits survive a failed save or an unlink.
let draft: { title: string, content: string, delivery_method: string } | null = null
let rejected_problems: RedditMarkdownProblem[] | null = null

if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData()
    draft = {
        title: String(form.get('title') ?? ''),
        content: String(form.get('content') ?? ''),
        delivery_method: parse_delivery_method(form.get('delivery_method')),
    }
    try {
        if (form.get('action') === 'disconnect') {
            await disconnect_reddit_account(auth_token)
            flash = { kind: 'success', key: 'corporations.settings.reddit_unlinked' }
        } else {
            await update_corporation_reddit_post(auth_token, corporation_id, {
                title: draft.title,
                content: draft.content,
                delivery_method: REDDIT_AUTOMATIC_POSTING
                    ? parse_delivery_method(draft.delivery_method)
                    : 'discord_reminder',
            })
            flash = { kind: 'success', key: 'corporations.settings.saved' }
            draft = null
        }
    } catch (error) {
        if (error instanceof RedditSettingsError && error.problems.length > 0)
            rejected_problems = error.problems
        flash = {
            kind: 'error',
            key: error instanceof RedditSettingsError
                ? reddit_save_error_key(error.message)
                : 'corporations.settings.error_save',
        }
    }
}

const settings = await get_corporation_reddit_post(auth_token, corporation_id) as CorporationRedditPost | null
if (!settings) return HTTP_403_Forbidden()

const title = draft?.title ?? settings.title
const content = draft?.content ?? settings.content
const delivery_method = REDDIT_AUTOMATIC_POSTING
    ? parse_delivery_method(draft?.delivery_method ?? settings.delivery_method)
    : 'discord_reminder'
const account = settings.reddit_account
const is_scheduled = Boolean(settings.posting_day && settings.subreddit)
// A rejected save lists what Reddit can't render in the typed text; otherwise
// any warnings about the saved text.
const markdown_problems = rejected_problems ?? (draft ? [] : settings.markdown_problems)
const has_blocking_problems = markdown_problems.some((problem) => problem.blocking)
const summary = reddit_section_summary({ ...settings, delivery_method }, {
    not_set_up: t('corporations.settings.summary_not_set_up'),
    unscheduled: t('corporations.settings.summary_unscheduled'),
    reminder: t('corporations.settings.summary_reminder'),
    automatic: t('corporations.settings.summary_automatic'),
    approved: t('corporations.settings.summary_approved'),
    awaiting: t('corporations.settings.summary_awaiting'),
}, lang)

const status_text = (() => {
    switch (settings.automatic_status) {
        case 'ready':
            return t('corporations.settings.status_ready').replace('~NAME', account?.username ?? '')
        case 'not_approved':
            return t('corporations.settings.status_not_approved')
        case 'no_account':
            return t('corporations.settings.status_no_account')
        case 'account_invalid':
            return t('corporations.settings.status_account_invalid')
        default:
            return ''
    }
})()
---

<span id={SUMMARY_ID} hx-swap-oob="true">{summary}</span>

<div id={ROOT_ID} class="[ corp-settings ]">
    <Flexblock gap="var(--space-l)">
        <p class="[ corp-settings__leading ]">{t('corporations.settings.leading')}</p>

        {flash &&
            <p
                class:list={['[ corp-settings__flash ]', { 'is-error': flash.kind === 'error' }]}
                role={flash.kind === 'error' ? 'alert' : 'status'}
            >
                {t(flash.key)}
            </p>
        }

        <section class="[ corp-settings__panel ]" aria-labelledby="corp-settings-schedule">
            <Flexblock gap="var(--space-xs)">
                <h3 id="corp-settings-schedule">{t('corporations.settings.schedule')}</h3>
                {is_scheduled ?
                    <dl class="[ corp-settings__facts ]">
                        <div>
                            <dt>{t('corporations.settings.subreddit')}</dt>
                            <dd>
                                <a
                                    href={`https://www.reddit.com/r/${settings.subreddit.replace(/^\/?r\//, '')}/`}
                                    target="_blank"
                                    rel="noreferrer noopener"
                                >r/{settings.subreddit.replace(/^\/?r\//, '')}</a>
                            </dd>
                        </div>
                        <div>
                            <dt>{t('corporations.settings.when')}</dt>
                            <dd>
                                {t('corporations.settings.when_value')
                                    .replace('~DAY', reddit_weekday_label(settings.posting_day, lang))
                                    .replace('~TIME', settings.posting_time)}
                            </dd>
                        </div>
                        {settings.next_run_at &&
                            <div>
                                <dt>{t('corporations.settings.next')}</dt>
                                <dd>{format_eve_datetime(settings.next_run_at, lang)}</dd>
                            </div>
                        }
                    </dl>
                    :
                    <p>{t('corporations.settings.unscheduled')}</p>
                }
                <small class="[ corp-settings__muted ]">{t('corporations.settings.schedule_note')}</small>
            </Flexblock>
        </section>

        <form
            method="post"
            action={PARTIAL_URL}
            hx-post={PARTIAL_URL}
            hx-target={`#${ROOT_ID}`}
            hx-swap="outerHTML"
        >
            <Flexblock gap="var(--space-m)">
                <Flexblock gap="var(--space-3xs)">
                    <label class="[ corp-settings__label ]" for="corp-settings-title">
                        {t('corporations.settings.title_label')}
                    </label>
                    <Input
                        id="corp-settings-title"
                        name="title"
                        type="text"
                        maxlength="250"
                        autocomplete="off"
                        value={title}
                        required
                    />
                </Flexblock>

                <Flexblock gap="var(--space-3xs)">
                    <FlexInline gap="var(--space-xs)" justification="space-between">
                        <label class="[ corp-settings__label ]" for="corp-settings-content">
                            {t('corporations.settings.content_label')}
                        </label>
                        <a href={REDDIT_FORMATTING_GUIDE_URL} target="_blank" rel="noreferrer noopener">
                            <small>{t('corporations.settings.markdown_guide')}</small>
                        </a>
                    </FlexInline>
                    <MarkdownTextArea
                        id="corp-settings-content"
                        name="content"
                        rows="16"
                        maxlength="40000"
                        guide_url={REDDIT_FORMATTING_GUIDE_URL}
                        guide_label={t('corporations.settings.markdown_guide')}
                        aria-invalid={has_blocking_problems ? 'true' : undefined}
                        aria-describedby={markdown_problems.length > 0 ? PROBLEMS_ID : undefined}
                        required
                    >{content}</MarkdownTextArea>
                    {markdown_problems.length > 0 &&
                        <div
                            id={PROBLEMS_ID}
                            class:list={['[ corp-settings__problems ]', { 'is-blocking': has_blocking_problems }]}
                        >
                            {!has_blocking_problems &&
                                <p>{t('corporations.settings.markdown_warnings')}</p>
                            }
                            <ul>
                                {markdown_problems.map((problem) =>
                                    <li class:list={[{ 'is-blocking': problem.blocking }]}>
                                        <strong>{t('corporations.settings.markdown_line').replace('~LINE', String(problem.line))}</strong>
                                        {' '}{t(reddit_markdown_problem_key(problem.code)).replace('~TEXT', problem.excerpt)}
                                    </li>
                                )}
                            </ul>
                        </div>
                    }
                </Flexblock>

                <fieldset class="[ corp-settings__delivery ]">
                    <legend class="[ corp-settings__label ]">{t('corporations.settings.delivery_label')}</legend>
                    <Flexblock gap="var(--space-xs)">
                        <label class="[ corp-settings__option ]">
                            <input
                                type="radio"
                                name="delivery_method"
                                value="discord_reminder"
                                checked={delivery_method === 'discord_reminder'}
                            />
                            <span class="[ corp-settings__option-body ]">
                                <strong>{t('corporations.settings.delivery_reminder')}</strong>
                                <small>{t('corporations.settings.delivery_reminder_help')}</small>
                                {!settings.discord_linked &&
                                    <small class="[ corp-settings__warning ]">{t('corporations.settings.no_discord')}</small>
                                }
                            </span>
                        </label>

                        <label class="[ corp-settings__option ]">
                            <input
                                type="radio"
                                name="delivery_method"
                                value="automatic"
                                checked={delivery_method === 'automatic'}
                                disabled={!REDDIT_AUTOMATIC_POSTING}
                            />
                            <span class="[ corp-settings__option-body ]">
                                <strong>{t('corporations.settings.delivery_automatic')}</strong>
                                <small>
                                    {REDDIT_AUTOMATIC_POSTING
                                        ? t('corporations.settings.delivery_automatic_help')
                                        : t('corporations.settings.delivery_automatic_coming_soon')}
                                </small>
                            </span>
                        </label>
                    </Flexblock>
                </fieldset>

                {REDDIT_AUTOMATIC_POSTING &&
                <section class="[ corp-settings__panel ]" aria-labelledby="corp-settings-automatic">
                    <Flexblock gap="var(--space-xs)">
                        <h3 id="corp-settings-automatic">{t('corporations.settings.automatic_heading')}</h3>
                        {settings.delivery_method === 'automatic' && status_text &&
                            <p class="[ corp-settings__status ]">{status_text}</p>
                        }
                        <dl class="[ corp-settings__facts ]">
                            <div>
                                <dt>{t('corporations.settings.reddit_account')}</dt>
                                <dd>
                                    <FlexInline gap="var(--space-xs)">
                                        {account ?
                                            <span>{t('corporations.settings.reddit_linked').replace('~NAME', account.username)}</span>
                                            :
                                            <span class="[ corp-settings__muted ]">{t('corporations.settings.reddit_not_linked')}</span>
                                        }
                                        {(!account || account.token_invalid) &&
                                            <Button href={CONNECT_URL} size="sm" color="fleet-red" narrow={true}>
                                                {account ? t('corporations.settings.reconnect') : t('corporations.settings.connect')}
                                            </Button>
                                        }
                                        {account &&
                                            <Button
                                                type="button"
                                                size="sm"
                                                color="transparent"
                                                narrow={true}
                                                off_disable={true}
                                                hx-post={PARTIAL_URL}
                                                hx-vals='{"action": "disconnect"}'
                                            >
                                                {t('corporations.settings.disconnect')}
                                            </Button>
                                        }
                                    </FlexInline>
                                    {account?.token_invalid &&
                                        <small class="[ corp-settings__warning ]">{t('corporations.settings.reddit_invalid')}</small>
                                    }
                                </dd>
                            </div>
                            <div>
                                <dt>{t('corporations.settings.approval')}</dt>
                                <dd>
                                    {settings.approved ?
                                        <Tag
                                            text={settings.approved_at
                                                ? t('corporations.settings.approved_on').replace('~DATE', format_eve_datetime(settings.approved_at, lang))
                                                : t('corporations.settings.approved')}
                                            color="green"
                                        />
                                        :
                                        <Tag text={t('corporations.settings.awaiting_approval')} color="fleet-yellow" />
                                    }
                                </dd>
                            </div>
                        </dl>
                        <small class="[ corp-settings__muted ]">{t('corporations.settings.approval_note')}</small>
                    </Flexblock>
                </section>
                }

                <FlexInline gap="var(--space-m)">
                    <Button type="submit" name="action" value="save" color="fleet-red" size="sm" off_disable={true}>
                        {t('corporations.settings.save')}
                    </Button>
                    {settings.last_post_at &&
                        <small class="[ corp-settings__muted ]">
                            {t('corporations.settings.last_posted')}:
                            {settings.last_reddit_post_url ?
                                <a href={settings.last_reddit_post_url} target="_blank" rel="noreferrer noopener">
                                    {format_eve_datetime(settings.last_post_at, lang)}
                                </a>
                                :
                                format_eve_datetime(settings.last_post_at, lang)
                            }
                        </small>
                    }
                    {settings.last_reminder_at &&
                        <small class="[ corp-settings__muted ]">
                            {t('corporations.settings.last_reminded')}: {format_eve_datetime(settings.last_reminder_at, lang)}
                        </small>
                    }
                </FlexInline>
            </Flexblock>
        </form>
    </Flexblock>
</div>

<style lang="scss">
    .corp-settings {
        max-width: var(--max-text-width);
    }

    // Flexblock spaces children with margin-block-start; keep that intact.
    h2,
    h3,
    p,
    dl {
        margin-block-end: 0;
    }

    h3 {
        font-size: var(--step-0);
    }

    .corp-settings__leading {
        color: var(--highlight);
    }

    .corp-settings__muted {
        color: var(--faded);
    }

    .corp-settings__label {
        font-family: var(--button-font);
        color: var(--highlight);
    }

    .corp-settings__flash {
        padding: var(--space-xs) var(--space-s);
        border-left: solid var(--space-3xs) var(--green);
        background-color: var(--component-background);
        color: var(--highlight);

        &.is-error {
            border-left-color: var(--fleet-red);
        }
    }

    .corp-settings__panel {
        padding: var(--space-s);
        border: solid 1px var(--border-color);
        background-color: var(--component-background);
    }

    .corp-settings__status {
        color: var(--highlight);
    }

    .corp-settings__problems {
        padding: var(--space-xs) var(--space-s);
        border-left: solid var(--space-3xs) var(--fleet-yellow);
        background-color: var(--component-background);
        font-size: var(--step--1);

        &.is-blocking {
            border-left-color: var(--fleet-red);
        }

        p {
            font-size: inherit;
            color: var(--highlight);
        }

        ul {
            margin: 0;
            padding-inline-start: var(--space-s);
        }

        li + li {
            margin-block-start: var(--space-3xs);
        }

        li.is-blocking strong {
            color: var(--fleet-red);
        }

        strong {
            color: var(--fleet-yellow);
        }
    }

    .corp-settings__warning {
        display: block;
        color: var(--fleet-red);
    }

    .corp-settings__facts {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-s) var(--space-xl);

        dt {
            font-size: var(--step--1);
            color: var(--faded);
        }

        dd {
            margin: 0;
            color: var(--highlight);
        }
    }

    .corp-settings__delivery {
        margin-inline: 0;
        padding: 0;
        border: none;

        legend {
            margin-bottom: var(--space-3xs);
        }
    }

    .corp-settings__option {
        display: flex;
        gap: var(--space-xs);
        align-items: flex-start;
        padding: var(--space-s);
        border: solid 1px var(--border-color);
        cursor: pointer;
        transition: border-color var(--fast-transition);

        &:hover {
            border-color: var(--border-color-hover);
        }

        &:has(input:checked) {
            border-color: var(--fleet-yellow);
        }

        &:has(input:disabled) {
            cursor: not-allowed;
            opacity: 0.6;

            &:hover {
                border-color: var(--border-color);
            }
        }

        input {
            margin-top: var(--space-3xs);
            accent-color: var(--fleet-red);
        }
    }

    .corp-settings__option-body {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);

        strong {
            color: var(--highlight);
        }
    }
</style>
