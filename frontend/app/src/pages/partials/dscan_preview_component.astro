---
import { HTTP_400_Bad_Request, HTTP_403_Forbidden } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'
import { get_gates, can } from '@helpers/gates'

// no-error-refetch: a paste the API can't read shows as "Not a d-scan or Local" in the controls.
// POST re-renders the controls under the paste box: what was detected, the system the scan names,
// and an enabled Share button. Nothing is saved.
const { auth_token } = get_request_user(Astro)
if (!auth_token) return HTTP_403_Forbidden()

const gates = await get_gates(Astro)
if (!can(gates, 'intel.report')) return HTTP_403_Forbidden()

if (Astro.request.method !== 'POST') return HTTP_400_Bad_Request()

import type { IntelPreview } from '@dtypes/api.minmatar.org'
import { preview_intel_report, type IntelPasteKind } from '@helpers/api.minmatar.org/intel'

const form = await Astro.request.formData()
const field = (key: string) => ((form.get(key) as string | null) ?? '')

const text = field('text')
// A new paste is detected afresh; only the D-scan / Local switch forces a kind.
const kind_field = field('kind')
const kind: IntelPasteKind | null = !field('auto') && (kind_field === 'dscan' || kind_field === 'local') ? kind_field : null
// The system field as the pilot left it. A value the last preview filled in from the scan
// doesn't count as typed, so the next paste names its own system.
const system_field = field('system').trim()
const system = system_field && system_field !== field('system_from_scan') ? system_field : ''
const note = field('note')

let preview: IntelPreview | null = null
let error: string | null = null

if (text.trim()) {
    try {
        preview = await preview_intel_report(auth_token, text, kind)
    } catch (e) {
        error = e.message
    }
}

import DscanPasteControls from '@components/blocks/DscanPasteControls.astro'
---

<DscanPasteControls preview={preview} error={error} system={system} note={note} />
