---
// no-error-refetch: a one-click mutation; a refusal answers 403 and the page stays as it was.
/**
 * POST: move a draft campaign to scheduled ("Publish campaign" on the
 * Get it ready checklist), then reload the page. The API checks the manager.
 */
import { HTTP_403_Forbidden } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'
import { change_campaign } from '@helpers/api.minmatar.org/campaigns'

const { auth_token, user } = get_request_user(Astro)
if (!user || !auth_token || Astro.request.method !== 'POST') return HTTP_403_Forbidden()

const slug = Astro.url.searchParams.get('slug') ?? ''
if (!/^[a-z0-9-]+$/.test(slug)) return HTTP_403_Forbidden()

try {
    await change_campaign(slug, auth_token, 'PATCH', '/settings', { status: 'scheduled' })
} catch (error) {
    console.log(`Could not publish campaign ${slug}: ${error.message}`)
    return HTTP_403_Forbidden()
}

Astro.response.headers.set('HX-Refresh', 'true')
---
