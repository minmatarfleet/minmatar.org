---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import { HTTP_400_Bad_Request, HTTP_403_Forbidden } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'
import { get_gates, can } from '@helpers/gates'

// GET lists the tags (the page's retry) or, with ?part=preview, renders a
// merge's consequence in post counts. POST creates, renames or merges a tag
// and answers with the tag panel; a rename's row picks itself out with
// hx-select. A failed create or merge answers 400 with the message, which
// the dialog that posted it shows.
const { auth_token } = get_request_user(Astro)
if (!auth_token) return HTTP_403_Forbidden()

const gates = await get_gates(Astro)
if (!can(gates, 'posts.tags.manage')) return HTTP_403_Forbidden()

const is_post = Astro.request.method === 'POST'
const params = Astro.url.searchParams

import type { PostTagCount, PostTagMergePreview } from '@dtypes/api.minmatar.org'
import {
    create_post_tag,
    get_post_tag_counts,
    get_post_tag_merge_preview,
    merge_post_tag,
    rename_post_tag,
} from '@helpers/api.minmatar.org/posts'

const form = is_post ? await Astro.request.formData() : new FormData()
const text = (key: string) => ((form.get(key) as string | null) ?? '').trim()
const action = text('action')
const tag_id = parseInt(is_post ? text('tag_id') : (params.get('tag_id') ?? ''))
const into_tag_id = parseInt(is_post ? text('into_tag_id') : (params.get('into_tag_id') ?? ''))
const is_preview = !is_post && params.get('part') === 'preview'

const posts_text = (count: number) => count === 1 ? t('admin_content.tags.posts_one') : t('admin_content.tags.posts_many').replace('~COUNT', String(count))
const failed = (message: string) => new Response(message, { status: 400, headers: { 'Content-Type': 'text/plain; charset=utf-8' } })

let preview: PostTagMergePreview | null = null
let preview_error: string | null = null
let error: string | null = null
let notice: string | null = null
let saved_id: number | null = null
let row_error: { tag_id: number, message: string, value: string } | null = null

if (is_preview) {
    if (!tag_id || !into_tag_id) return HTTP_400_Bad_Request()
    try {
        preview = await get_post_tag_merge_preview(auth_token, tag_id, into_tag_id)
    } catch (failure) {
        if ((failure as Error).cause === 403) return HTTP_403_Forbidden()
        preview_error = (failure as Error).message
    }
} else if (is_post) {
    try {
        if (action === 'create') {
            const tag = await create_post_tag(auth_token, text('tag'))
            notice = t('post_tags.manage.created').replace('{tag}', tag.tag)
        } else if (action === 'rename' && tag_id) {
            try {
                await rename_post_tag(auth_token, tag_id, text('tag'))
                saved_id = tag_id
            } catch (failure) {
                if ((failure as Error).cause === 403) throw failure
                row_error = { tag_id, message: (failure as Error).message, value: text('tag') }
            }
        } else if (action === 'merge' && tag_id && into_tag_id) {
            const tag = await merge_post_tag(auth_token, tag_id, into_tag_id)
            notice = t('post_tags.manage.merged').replace('{tag}', tag.tag)
        } else {
            return HTTP_400_Bad_Request()
        }
    } catch (failure) {
        if ((failure as Error).cause === 403) return HTTP_403_Forbidden()
        return failed((failure as Error).message)
    }
}

let tags: PostTagCount[] = []
if (!is_preview) {
    try {
        tags = await get_post_tag_counts(auth_token)
    } catch (failure) {
        if ((failure as Error).cause === 403) return HTTP_403_Forbidden()
        error = (failure as Error).message
    }
}

import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import PostTagsManager from '@components/blocks/PostTagsManager.astro'
---

{is_preview ?
    <span data-merge-consequence>
        {preview ?
            <Fragment>
                {preview.moving === 0
                    ? t('admin_content.tags.merge_none').replace('~INTO', preview.into_tag)
                    : t('admin_content.tags.merge_moves')
                        .replace('~POSTS', posts_text(preview.moving))
                        .replace('~INTO', preview.into_tag)
                        .replace('~TOTAL', String(preview.into_total))}
                {' '}
                {t('admin_content.tags.merge_deleted').replace('~NAME', preview.tag)}
            </Fragment>
            :
            <span class="[ manage-field__error ]">{preview_error}</span>
        }
    </span>
    : error && tags.length === 0 ?
    <ErrorRefetch args={{ partial: Astro.url.pathname, error: new Error(error), delay: 0 }} />
    :
    <PostTagsManager tags={tags} saved_id={saved_id} row_error={row_error} error={error} notice={notice} />
}
