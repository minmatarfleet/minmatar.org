---
// no-error-refetch: an action; a refusal shows in an alert.
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden, HTTP_404_Not_Found } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'

const { auth_token, user } = get_request_user(Astro)

if (!user)
    return HTTP_403_Forbidden()

const fleet_id = parseInt(Astro.url.searchParams.get('fleet_id') ?? '0')

if (!fleet_id || Astro.request.method !== 'POST')
    return HTTP_404_Not_Found()

import type { Alert } from '@dtypes/layout_components'
import { declassify_fleet } from '@helpers/api.minmatar.org/fleets'

// On success the page reloads as a normal fleet; a refusal shows as an alert.
let alert:Alert | false = false
try {
    await declassify_fleet(auth_token as string, fleet_id)
    return new Response(null, {
        status: 200,
        headers: { 'HX-Redirect': translatePath(`/fleets/upcoming/${fleet_id}`) },
    })
} catch (e) {
    alert = { title: t('fleets.private.declassify_confirm_title'), content: e.message }
}

import ShowAlert from '@components/blocks/ShowAlert.astro'
---

{alert && <ShowAlert alert={alert} />}
