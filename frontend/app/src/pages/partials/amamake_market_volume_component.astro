---
import {
import { get_request_user } from '@helpers/request_user'
    get_issue,
    get_latest_issue,
    SOLD_CLASS_ALL,
} from '@/data/amamake-market'
import AmamakeMarketVolume from '@components/blocks/amamake-market/AmamakeMarketVolume.astro'

const issue_slug = Astro.url.searchParams.get('issue') ?? ''
const page = Number(Astro.url.searchParams.get('page') ?? '1') || 1
const sold_class = Astro.url.searchParams.get('sold_class') ?? SOLD_CLASS_ALL
const q = Astro.url.searchParams.get('q') ?? ''
const issue = get_issue(issue_slug) ?? get_latest_issue()
const { auth_token } = get_request_user(Astro)
---

<AmamakeMarketVolume
    issue={issue}
    page={page}
    sold_class={sold_class}
    q={q}
    access_token={auth_token}
    panel_only={true}
/>
