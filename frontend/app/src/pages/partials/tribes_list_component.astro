---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { User } from '@dtypes/jwt'
import * as jose from 'jose'

const auth_token = Astro.cookies.has('auth_token') ? Astro.cookies.get('auth_token')?.value : false
const user = auth_token ? jose.decodeJwt(auth_token) as User : false

import type { Tribe, TribeGroup, TribeMembership } from '@dtypes/api.minmatar.org'
import { get_tribes, get_tribe_groups, get_memberships } from '@helpers/api.minmatar.org/tribes'

let tribes: Tribe[] = []
let directory_groups: {
    group: TribeGroup
    tribe: Tribe
    is_member: boolean
}[] = []
let get_tribes_error: Error | false = false

const initial_tribe_slug = Astro.url.searchParams.get('tribe') ?? 'all'
const delay = parseInt(Astro.url.searchParams.get('delay') ?? '0')

try {
    tribes = await get_tribes()
    const groups_lists = await Promise.all(
        tribes.map(async (tribe) => {
            const groups = await get_tribe_groups(tribe.id)
            return groups.map((group) => ({ group, tribe }))
        }),
    )
    const flat = groups_lists.flat()

    const member_group_ids = new Set<number>()
    if (auth_token && user) {
        await Promise.all(
            flat.map(async ({ group, tribe }) => {
                try {
                    const memberships = await get_memberships(
                        auth_token as string,
                        tribe.id,
                        group.id,
                        { mine: true, status: 'active' },
                    )
                    if (memberships.some((m: TribeMembership) => m.status === 'active'))
                        member_group_ids.add(group.id)
                } catch {
                    // ignore
                }
            }),
        )
    }

    directory_groups = flat
        .map(({ group, tribe }) => ({
            group,
            tribe,
            is_member: member_group_ids.has(group.id),
        }))
        .sort((a, b) => {
            const tribe_cmp = a.tribe.name.localeCompare(b.tribe.name)
            if (tribe_cmp !== 0) return tribe_cmp
            return a.group.name.localeCompare(b.group.name)
        })
} catch (error) {
    get_tribes_error = error as Error
}

const TRIBES_LIST_PARTIAL_URL = translatePath('/partials/tribes_list_component')

import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import TribesGroupsCatalog from '@components/blocks/TribesGroupsCatalog.astro'
---

{get_tribes_error ?
    <ErrorRefetch
        args={{
            partial: TRIBES_LIST_PARTIAL_URL,
            error: get_tribes_error,
            delay: delay,
        }}
    />
    :
    <TribesGroupsCatalog
        directory_groups={directory_groups}
        tribes={tribes}
        initial_tribe_slug={initial_tribe_slug}
        init_tooltips={true}
    />
}
