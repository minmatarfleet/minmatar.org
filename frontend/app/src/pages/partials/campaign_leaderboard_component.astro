---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden } from '@helpers/http_responses'

import { get_request_user } from '@helpers/request_user'

const { auth_token, user } = get_request_user(Astro)

if (!user)
    return HTTP_403_Forbidden()

import { get_gates, can } from '@helpers/gates'
const gates = await get_gates(Astro)

const can_view_campaigns = can(gates, 'campaigns.view')

if (!can_view_campaigns)
    return HTTP_403_Forbidden()

import type {
    CampaignLeaderboardRow,
    CampaignLeaderboardMetric,
    CampaignLeaderboardPeriod,
} from '@dtypes/api.minmatar.org'
import { get_campaign_leaderboard } from '@helpers/api.minmatar.org/campaigns'

const slug = Astro.url.searchParams.get('slug') as string
const metric = (Astro.url.searchParams.get('metric') ?? 'kills') as CampaignLeaderboardMetric
const period = (Astro.url.searchParams.get('period') ?? 'week') as CampaignLeaderboardPeriod
const delay = parseInt(Astro.url.searchParams.get('delay') ?? '0')

let fetch_leaderboard_error:Error | false = false
let rows:CampaignLeaderboardRow[] = []

try {
    rows = await get_campaign_leaderboard(slug, auth_token as string, metric, period)
} catch (error) {
    fetch_leaderboard_error = error
}

const LEADERBOARD_PARTIAL_URL = translatePath(`/partials/campaign_leaderboard_component?slug=${slug}&metric=${metric}&period=${period}`)

import CampaignLeaderboard from '@components/blocks/CampaignLeaderboard.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
---

{fetch_leaderboard_error ?
    <ErrorRefetch
        args={{
            partial: LEADERBOARD_PARTIAL_URL,
            error: fetch_leaderboard_error,
            delay: delay,
            target: '#campaign-leaderboard',
        }}
    />
    :
    <CampaignLeaderboard slug={slug} rows={rows} metric={metric} period={period} />
}
