---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { get_request_user } from '@helpers/request_user'
import { HTTP_403_Forbidden, login_redirect, partial_redirect } from '@helpers/http_responses'

const { auth_token, user } = get_request_user(Astro)

if (!user) return login_redirect(Astro)

import { get_gates, can } from '@helpers/gates'
const gates = await get_gates(Astro)
const can_view_page = can(gates, 'fleets.create')

if (!can_view_page) return HTTP_403_Forbidden()

import type { SummaryCharacter } from '@dtypes/api.minmatar.org'
import type { Alert } from '@dtypes/layout_components'
import { get_characters_summary_sorted } from '@helpers/fetching/characters'
import { start_fleet_now } from '@helpers/api.minmatar.org/fleets'
import { send_active_fleet_notification } from '@helpers/notifications'

let alert:Alert | false = false

if (Astro.request.method === 'POST') {
    const data = await Astro.request.formData()
    const fcId = data.get('fc_character_id')
    const fc_character_id = fcId != null && fcId !== '' ? parseInt(fcId as string) : undefined
    
    try {
        const fleet = await start_fleet_now(auth_token as string, fc_character_id)
        send_active_fleet_notification(auth_token as string, fleet.id)

        const fleet_path = translatePath(`/fleets/upcoming/${fleet.id}`)
        return partial_redirect(Astro.request, fleet_path)
    } catch (error) {
        alert = {
            title: t('starting_fleet'),
            content: error.message,
        }
    }
}

let pilots: SummaryCharacter[] = []
let fetch_error: Error | false = false

try {
    const summary = await get_characters_summary_sorted(auth_token as string)
    pilots = summary.characters ?? []
} catch (error) {
    fetch_error = error
}

const FLET_START_PARTIAL_URL = translatePath('/partials/fleet_start_component/')

import ShowAlert from '@components/blocks/ShowAlert.astro';
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro';
import StartFleet from '@components/blocks/StartFleet.astro'
---

{alert && <ShowAlert alert={alert} /> }

{fetch_error ?
    <ErrorRefetch
        args={{
            partial: FLET_START_PARTIAL_URL,
            error: fetch_error,
            delay: 0,
        }}
    /> :
    pilots.length > 0 ?
        <StartFleet pilots={pilots} /> :
        <p>{t('no_pilots_to_show')}</p>
}
