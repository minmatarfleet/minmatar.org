---
// no-error-refetch: search-as-you-type; a failed search shows no matches and the next keystroke retries.
import { i18n, t_key } from '@helpers/i18n'
const { lang, t, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden, HTTP_404_Not_Found } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'

const { auth_token, user } = get_request_user(Astro)

if (!user)
    return HTTP_403_Forbidden()

const fleet_id = parseInt(Astro.url.searchParams.get('fleet_id') ?? '0')
const q = (Astro.url.searchParams.get('q') ?? '').trim()
// "single": the Invites tab's one-pilot search, whose rows invite right away.
// Otherwise the dialog's Select names, whose rows add a pick.
const single = Astro.url.searchParams.get('mode') === 'single'
const timezones = Astro.url.searchParams.getAll('timezones').filter(Boolean)

if (!fleet_id)
    return HTTP_404_Not_Found()

import { get_fleet_invite_candidates, type FleetInviteCandidate } from '@helpers/api.minmatar.org/fleets'
import { query_string } from '@helpers/string'
import { invite_day, is_skipped, skip_note } from '@helpers/fleet_invites'

const INVITES_URL = `${translatePath('/partials/fleet_invites_component')}?${query_string({ fleet_id })}&action=invite_one`

let candidates:FleetInviteCandidate[] = []
if (q.length >= 2) {
    try {
        candidates = await get_fleet_invite_candidates(auth_token as string, fleet_id, q, single, timezones)
    } catch (e) {
        console.log(`Invite candidates: ${e.message}`)
    }
}

import EmptyState from '@components/blocks/EmptyState.astro'
import TimezoneTags from '@components/blocks/TimezoneTags.astro'
---

{q.length >= 2 && (candidates.length === 0 ?
    <EmptyState title={single ? t('fleets.invites.no_pilots') : t('fleets.private.no_results')} /> :
    <ul class="[ invite-candidates ]">
        {candidates.map(candidate => {
            const kind = t(t_key('fleets.private.kind_', candidate.kind))
            // Groups and corporations: how many of their members play in the chosen timezones.
            const in_timezone = candidate.members !== null && candidate.in_timezone !== null && candidate.in_timezone !== candidate.members ?
                t('fleets.invites.of_count').replace('{in}', candidate.in_timezone.toString()).replace('{total}', candidate.members.toString()) :
                null
            const detail = single || candidate.detail === kind ?
                candidate.detail :
                [kind, candidate.detail, in_timezone].filter(Boolean).join(' · ')
            const blocked = candidate.blocked ? t(t_key('fleets.invites.blocked_', candidate.blocked)) : ''
            // Skipped picks can still be added in the dialog; the chip says why.
            const skipped = !single && is_skipped(candidate.blocked)
            const free_day = candidate.capped ? invite_day(lang, candidate.capped.free_at) : ''
            const pick = {
                kind: candidate.kind,
                id: candidate.id,
                name: candidate.name,
                skip: skip_note(t, lang, candidate),
                // Pilots: their brackets, so the chip can say when they play in another timezone.
                ...(candidate.timezone ? { tz: candidate.timezone.brackets } : {}),
            }
            return <li class:list={[{ 'is-blocked': blocked && !skipped, 'is-skipped': skipped }]}>
                {single ?
                    <div class="[ invite-candidates__row ]">
                        <span>
                            <b>{candidate.name} <TimezoneTags timezone={candidate.timezone} /></b>
                            <small>{detail}</small>
                        </span>
                        {blocked ?
                            <small class:list={['[ invite-candidates__why ]', { 'is-skip': free_day }]}>
                                {blocked}
                                {free_day && <Fragment><br />{t('fleets.invites.again_on').replace('{day}', free_day)}</Fragment>}
                            </small> :
                            <button
                                type="button"
                                class="[ invite-candidates__invite ]"
                                hx-post={INVITES_URL}
                                hx-vals={JSON.stringify({ user_id: candidate.id, name: candidate.name })}
                                hx-target="#fleet-invites"
                                hx-swap="outerHTML"
                                hx-disabled-elt="this"
                            >{t('fleets.invites.invite')}</button>
                        }
                    </div> :
                    <button
                        type="button"
                        disabled={Boolean(blocked) && !skipped}
                        title={pick.skip || undefined}
                        x-on:click={blocked && !skipped ? undefined : `$dispatch('pick-candidate', ${JSON.stringify(pick)})`}
                    >
                        <b>{candidate.name} {candidate.kind === 'pilot' && <TimezoneTags timezone={candidate.timezone} />}</b>
                        <small>{skipped ? t('fleets.invites.will_be_skipped').replace('{reason}', blocked) : blocked || detail}</small>
                    </button>
                }
            </li>
        })}
    </ul>
)}

<style lang="scss">
    .invite-candidates {
        display: flex;
        flex-direction: column;
        padding: 0;
        list-style: none;
        border: 1px solid var(--border-color);

        li + li {
            border-top: 1px solid var(--hairline);
        }

        button {
            display: flex;
            width: 100%;
            justify-content: space-between;
            gap: var(--space-s);
            padding: var(--space-2xs) var(--space-xs);
            background: transparent;
            border: 0;
            color: var(--foreground);
            font: inherit;
            text-align: left;
            cursor: pointer;

            &:hover {
                background-color: var(--hairline);
            }
        }

        button:disabled {
            cursor: default;

            &:hover {
                background-color: transparent;
            }
        }

        b {
            color: var(--highlight);
        }

        small {
            color: var(--text-muted);
        }

        .is-blocked b {
            color: var(--text-muted);
        }

        .is-skipped small,
        .is-skip {
            color: var(--fleet-red-blind);
        }
    }

    .invite-candidates__why {
        text-align: right;
    }

    .invite-candidates__row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-s);
        padding: var(--space-3xs) var(--space-3xs) var(--space-3xs) var(--space-xs);

        > span {
            display: flex;
            flex-direction: column;
        }
    }

    .invite-candidates .invite-candidates__invite {
        display: inline-flex;
        flex: none;
        align-items: center;
        justify-content: center;
        width: auto;
        min-height: var(--space-l);
        padding: 0 var(--space-xs);
        border: 1px solid var(--border-color);
        color: var(--highlight);
        font-weight: 600;
    }
</style>
