---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden } from '@helpers/http_responses'

import { get_request_user } from '@helpers/request_user'

const { auth_token, user } = get_request_user(Astro)

if (!user)
    return HTTP_403_Forbidden()

import { get_gates, can } from '@helpers/gates'
const gates = await get_gates(Astro)

const can_view_fleets = can(gates, 'fleets.view')

if (!can_view_fleets)
    return HTTP_403_Forbidden()

import {
    fetch_fleet_schedule,
    fetch_fleet_history,
    type FleetSchedule as FleetScheduleData,
    type FleetHistory,
} from '@helpers/fetching/fleet_schedule'

let fetch_fleets_error: Error | false = false
let schedule: FleetScheduleData | null = null
let history: FleetHistory | null = null

const upcoming = JSON.parse(Astro.url.searchParams.get('upcoming') as string)

try {
    if (upcoming)
        schedule = await fetch_fleet_schedule(auth_token as string)
    else
        history = await fetch_fleet_history(auth_token as string)
} catch (error) {
    fetch_fleets_error = error
}

const fleets = (upcoming ? schedule?.fleets : history?.tracked) ?? []

let count_text = ''
if (upcoming)
    count_text = t(fleets.length !== 1 ? 'fleets_on_schedule_plural' : 'fleets_on_schedule_singular')
        .replace('{count}', String(fleets.length))
else
    count_text = t(fleets.length !== 1 ? 'fleets_in_the_past_30_days_plural' : 'fleets_in_the_past_30_days_singular')
        .replace('{count}', String(fleets.length))

const FLEET_LIST_PARTIAL_URL = translatePath(`/partials/fleet_list_component?upcoming=${JSON.stringify(upcoming)}`)

const delay = parseInt(Astro.url.searchParams.get('delay') ?? '0')

import FleetSchedule from '@components/blocks/FleetSchedule.astro';
import FleetHistoryList from '@components/blocks/FleetHistoryList.astro';
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro';
---

{fetch_fleets_error ?
    <ErrorRefetch
        args={{
            partial: FLEET_LIST_PARTIAL_URL,
            error: fetch_fleets_error,
            delay: delay,
        }}
    />
    :
    <>
        {!upcoming &&
            <small id="count-text-oob" hx-swap-oob="true">{count_text}</small>
        }
        {upcoming ?
            <FleetSchedule schedule={schedule as FleetScheduleData} init_tooltips={true} /> :
            <FleetHistoryList history={history as FleetHistory} init_tooltips={true} />
        }
    </>
}