---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_404_Not_Found, HTTP_403_Forbidden } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'

const { auth_token, user } = get_request_user(Astro)

if (!user)
    return HTTP_403_Forbidden()

const fleet_id = parseInt(Astro.url.searchParams.get('id') as string)

if (isNaN(fleet_id))
    return HTTP_404_Not_Found()

import type { SummaryCharacter, UserActiveFleet } from '@dtypes/api.minmatar.org'
import { get_characters_summary } from '@helpers/api.minmatar.org/characters'
import { get_my_active_fleets } from '@helpers/api.minmatar.org/fleets'
import { get_player_icon } from '@helpers/eve_image_server'

let characters:SummaryCharacter[] = []
let active_fleets:UserActiveFleet[] = []
let fetch_error:Error | false = false

try {
    // The boss check is a bonus: without it the list still starts the fleet.
    const [summary, fleets] = await Promise.allSettled([
        get_characters_summary(auth_token as string),
        get_my_active_fleets(auth_token as string),
    ])
    if (summary.status === 'rejected')
        throw summary.reason
    characters = [...(summary.value?.characters ?? [])].sort((a, b) =>
        Number(b.is_primary === true) - Number(a.is_primary === true) || a.character_name.localeCompare(b.character_name)
    )
    active_fleets = fleets.status === 'fulfilled' ? (fleets.value ?? []) : []
} catch (error) {
    fetch_error = error
}

const boss_ids = new Set(active_fleets
    .filter(fleet => fleet.fleet_boss_id === fleet.character_id)
    .map(fleet => fleet.character_id)
)

const PARTIAL_URL = `${translatePath('/partials/fleet_start_characters_component')}?id=${fleet_id}`

import StartFleetButton from '@components/blocks/StartFleetButton.astro'
import Tag from '@components/blocks/Tag.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import EmptyState from '@components/blocks/EmptyState.astro'
---

{fetch_error ?
    <ErrorRefetch args={{ partial: PARTIAL_URL, error: fetch_error, delay: 0 }} />
    :
    characters.length === 0 ?
        <EmptyState title={t('no_pilots_to_show')} />
        :
        <div class="[ start-characters ]" role="group" aria-label={t('start_as')}>
            <h4 class="[ start-characters__heading ]">{t('start_as')}</h4>
            {characters.map(character => (
                <StartFleetButton
                    id={fleet_id}
                    character_id={character.character_id}
                    variant="row"
                    aria-label={`${t('start_on_character')} ${character.character_name}`}
                >
                    <img
                        src={get_player_icon(character.character_id, 64)}
                        alt=""
                        width="32"
                        height="32"
                        loading="lazy"
                    />
                    <span class="[ start-characters__name ]">{character.character_name}</span>
                    {boss_ids.has(character.character_id) ?
                        <Tag text={t('fleet_boss')} color="green" narrow={true} /> :
                        character.is_primary && <small class="[ start-characters__main ]">{t('main_character')}</small>
                    }
                </StartFleetButton>
            ))}
        </div>
}

<style lang="scss">
    .start-characters {
        display: flex;
        flex-direction: column;
        min-width: 16rem;
    }

    .start-characters__heading {
        margin: 0;
        padding: var(--space-3xs) var(--space-2xs);
        font-size: var(--step--2);
        color: var(--text-muted);
        text-transform: uppercase;
    }

    .start-characters :global(.start-fleet-row) {
        display: flex;
        align-items: center;
        gap: var(--space-2xs);
        width: 100%;
        padding: var(--space-3xs) var(--space-2xs);
        text-align: left;
        transition: background-color var(--fast-transition);

        img {
            display: block;
            width: var(--space-l);
            height: var(--space-l);
        }
    }

    @media (hover: hover) {
        .start-characters :global(.start-fleet-row:hover) {
            background-color: var(--hairline);
        }
    }

    .start-characters__name {
        flex: 1 1 auto;
        color: var(--highlight);
    }

    .start-characters__main {
        color: var(--text-muted);
    }
</style>
