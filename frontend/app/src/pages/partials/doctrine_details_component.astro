---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

const { auth_token } = get_request_user(Astro)

import { get_request_user } from '@helpers/request_user'


import { get_gates, can } from '@helpers/gates'

const gates = await get_gates(Astro)
const can_view_fleets = can(gates, 'fleets.view')

const doctrine_id = Astro.url.searchParams.get('doctrine_id') as string
const active_location_id = parseInt(Astro.url.searchParams.get('location_id') ?? '0')

import type { DoctrineType } from '@dtypes/layout_components'
import { fetch_doctrine_by_id } from '@helpers/fetching/doctrines'
import type { FleetItem } from '@dtypes/layout_components'
import { fetch_fleets_auth } from '@helpers/fetching/fleets'
let doctrine:DoctrineType | null = null
let fetch_doctrine_error: Error | false = false
let recently_fleets:FleetItem[] = []

try {
    doctrine = await fetch_doctrine_by_id(parseInt(doctrine_id))
    if (auth_token && can_view_fleets) {
        recently_fleets = await fetch_fleets_auth(auth_token as string, false)
        recently_fleets = recently_fleets.filter((fleet) => fleet.doctrine_id === parseInt(doctrine_id))
    }
} catch (error) {
    fetch_doctrine_error = error
}

const DOCTRINE_DETAILS_PARTIAL_URL = translatePath('/partials/doctrine_details_component')

const delay = parseInt(Astro.url.searchParams.get('delay') ?? '0')

import DoctrineDetails from '@components/blocks/DoctrineDetails.astro';
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro';
---

{fetch_doctrine_error ?
    <ErrorRefetch
        args={{
            partial: `${DOCTRINE_DETAILS_PARTIAL_URL}?doctrine_id=${doctrine_id}${active_location_id ? `&location_id=${active_location_id}` : ''}`,
            error: fetch_doctrine_error,
            delay: delay,
        }}
    />
    :
    <DoctrineDetails 
        doctrine={doctrine as DoctrineType} 
        recently_fleets={recently_fleets}
    />
    
    <span x-data={`{
        init() {
            recently_fleets_count = ${recently_fleets?.length ?? 0}
            $el.remove()
        }
    }`}/>
}
