---
import { i18n, t_key } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import { HTTP_400_Bad_Request, HTTP_403_Forbidden } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'
import { get_gates, can } from '@helpers/gates'

// no-error-refetch: a one-off action; a failure is the status line it swaps in.
// POST puts an alliance or corporation at the front of the investigation queue.
const { auth_token } = get_request_user(Astro)
if (!auth_token) return HTTP_403_Forbidden()

const gates = await get_gates(Astro)
if (!can(gates, 'intel.affiliations')) return HTTP_403_Forbidden()

if (Astro.request.method !== 'POST') return HTTP_400_Bad_Request()

import { investigate_intel_entity } from '@helpers/api.minmatar.org/intel_affiliations'
import { fill, is_group_kind, parse_entity_kind, parse_id } from '@helpers/intel_affiliations'

const kind = parse_entity_kind(Astro.url.searchParams.get('kind'))
const eve_id = parse_id(Astro.url.searchParams.get('eve_id'))
if (!kind || !eve_id || !is_group_kind(kind)) return HTTP_400_Bad_Request()

let message = ''
let failed = false

try {
    const result = await investigate_intel_entity(auth_token, kind, eve_id)
    message = fill(t('intel.affiliations.entity.investigate_queued'), {
        priority: result.priority,
        status: t(t_key('intel.affiliations.entity_status.', result.status)) ?? result.status,
    })
} catch (error) {
    if ((error as Error).cause === 403) return HTTP_403_Forbidden()
    failed = true
    message = fill(t('intel.affiliations.entity.investigate_error'), { error: (error as Error).message })
}
---

<span class:list={['[ intel-investigate-status ]', { 'intel-investigate-status--error': failed }]} role="status">{message}</span>
