---
/**
 * Manage learning: Guides.
 *
 * part=list  chips (All, Published, Drafts), search, the guides table (GET);
 *            new=1 adds an open blank guide row at the top
 * part=edit  an open row's form (GET, slug=)
 * part=save  save a guide (POST): the row, open, inside a <table>
 *
 * Writes go through the learning manage API, which writes the audit log.
 * Order is not a guide's: certificates order their guides.
 */
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { get_request_user } from '@helpers/request_user'
import { HTTP_403_Forbidden } from '@helpers/http_responses'
import { get_gates, can } from '@helpers/gates'
import { get_manage_guides, save_manage_guide } from '@helpers/api.minmatar.org/learning_manage'
import type { LearningManageGuideRow } from '@helpers/api.minmatar.org/learning_manage'
import type { LearningManageGuideWrite } from '@dtypes/api.minmatar.org'
import { error_text, form_flag, form_int, form_text } from '@helpers/manage_forms'
import { guide_url } from '@helpers/learning_manage'
import { query_string } from '@helpers/string'

import EmptyState from '@components/blocks/EmptyState.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import HtmxPager from '@components/blocks/HtmxPager.astro'
import ViewChips from '@components/blocks/manage/ViewChips.astro'
import ManageSearch from '@components/blocks/manage/ManageSearch.astro'
import ManageTable from '@components/blocks/manage/ManageTable.astro'
import LearningGuideRow from '@components/blocks/learning_manage/LearningGuideRow.astro'
import LearningGuideForm from '@components/blocks/learning_manage/LearningGuideForm.astro'

const { auth_token } = get_request_user(Astro)
if (!auth_token) return HTTP_403_Forbidden()
if (!can(await get_gates(Astro), 'learning.manage')) return HTTP_403_Forbidden()

const PAGE_SIZE = 50
const params = Astro.url.searchParams
const part = params.get('part') ?? 'list'
const partial_url = (values: Record<string, string>) =>
    translatePath(`/partials/learning_manage_guides_component/?${query_string(values)}`)
const save_url = partial_url({ part: 'save' })
const row_id_of = (slug: string) => `guide-${slug}`

// part=save
let saved_slug: string | null = null
let save_error: string | null = null
let posted: LearningManageGuideWrite | null = null
let posted_original: string | null = null
let posted_row_id = ''
if (part === 'save' && Astro.request.method === 'POST') {
    const form = await Astro.request.formData()
    posted_original = form_text(form, 'original_slug') || null
    posted_row_id = form_text(form, 'row_id') || (posted_original ? row_id_of(posted_original) : 'guide-new')
    const slug = form_text(form, 'slug')
    const content_kind = form_text(form, 'content_kind') || 'guide'
    posted = {
        slug,
        title: form_text(form, 'title'),
        summary: form_text(form, 'summary'),
        // A guide-kind page's link follows its address.
        url: content_kind === 'guide' ? guide_url(slug) : form_text(form, 'url'),
        content_kind,
        thumbnail_url: form_text(form, 'thumbnail_url'),
        estimated_minutes: form_int(form, 'estimated_minutes'),
        published: form_flag(form, 'published'),
    }
    try {
        await save_manage_guide(auth_token, posted_original, posted)
        saved_slug = slug
    } catch (error) {
        save_error = error_text(error, t('learning_manage.error_save'))
    }
}

let guides: LearningManageGuideRow[] = []
let error: Error | null = null
try {
    guides = await get_manage_guides(auth_token)
} catch (failure) {
    error = failure as Error
}

// part=list
const view = params.get('view') === 'published' || params.get('view') === 'drafts' ? params.get('view') as string : 'all'
const query = (params.get('q') ?? '').trim().toLowerCase()
const page = Math.max(1, parseInt(params.get('page') ?? '1') || 1)
const searched = guides.filter((guide) =>
    !query || [guide.title, guide.slug, guide.certificate_title ?? ''].some((text) => text.toLowerCase().includes(query)))
const rows = searched.filter((guide) => view === 'all' || (view === 'published') === guide.published)
const total_pages = Math.max(1, Math.ceil(rows.length / PAGE_SIZE))
const page_rows = rows.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE)
const show_new = params.get('new') === '1'

const COLUMNS = [
    { label: t('learning_admin.col_guide') },
    { label: t('learning_admin.col_certificate'), phone: false },
    { label: t('learning_admin.col_status') },
]
const BLANK: LearningManageGuideWrite = {
    slug: '', title: '', summary: '', url: '', content_kind: 'guide', thumbnail_url: '', estimated_minutes: null, published: false,
}
const values_of = (guide: LearningManageGuideRow): LearningManageGuideWrite => ({
    slug: guide.slug,
    title: guide.title,
    summary: guide.summary,
    url: guide.url,
    content_kind: guide.content_kind,
    thumbnail_url: guide.thumbnail_url,
    estimated_minutes: guide.estimated_minutes,
    published: guide.published,
})

// part=edit
const edit_guide = part === 'edit' ? guides.find((guide) => guide.slug === params.get('slug')) ?? null : null

// part=save: the saved guide as stored, or (on error) the guide as it was.
const saved_guide = saved_slug ? guides.find((guide) => guide.slug === saved_slug) ?? null : null
const row_guide = saved_guide ?? (posted_original ? guides.find((guide) => guide.slug === posted_original) ?? null : null)
---

{part === 'list' && (
    error
        ? <div id="learning-manage-guides"><ErrorRefetch args={{ partial: partial_url({ part: 'list' }), error, delay: 0 }} /></div>
        : (
            <div id="learning-manage-guides" class="[ manage-list ]">
                <ViewChips
                    id="guides-filters"
                    url={partial_url({ part: 'list' })}
                    target="guides-list"
                    selected={view}
                    search_id="guides-search"
                    legend={t('learning_admin.guide_views')}
                    views={[
                        { value: 'all', label: t('learning_admin.view_all'), count: searched.length },
                        { value: 'published', label: t('learning_manage.published'), count: searched.filter((guide) => guide.published).length },
                        { value: 'drafts', label: t('learning_admin.drafts'), count: searched.filter((guide) => !guide.published).length },
                    ]}
                >
                    <div class="[ manage-toolbar ]">
                        <ManageSearch id="guides-search" value={params.get('q') ?? ''} label={t('learning_admin.guide_search')} placeholder={t('learning_admin.guide_search')} />
                    </div>
                </ViewChips>
                <div id="guides-list" class="[ manage-list ]" aria-live="polite">
                    {page_rows.length === 0 && !show_new
                        ? <EmptyState title={t('learning_admin.no_guides')} />
                        : (
                            <ManageTable caption={t('learning_admin.guides_caption')} columns={COLUMNS}>
                                {show_new &&
                                    <LearningGuideRow guide={null} row_id="guide-new" open={true}>
                                        <LearningGuideForm slot="detail" values={BLANK} original_slug={null} row_id="guide-new" post_url={save_url} />
                                    </LearningGuideRow>
                                }
                                {page_rows.map((guide) => (
                                    <LearningGuideRow
                                        guide={guide}
                                        row_id={row_id_of(guide.slug)}
                                        url={partial_url({ part: 'edit', slug: guide.slug })}
                                    />
                                ))}
                            </ManageTable>
                        )
                    }
                    <HtmxPager
                        page={page}
                        total_pages={total_pages}
                        url_for={(to) => partial_url({ part: 'list', page: String(to) })}
                        request={{ 'hx-target': '#guides-list', 'hx-select': '#guides-list', 'hx-swap': 'outerHTML', 'hx-include': '#guides-filters' }}
                    />
                </div>
            </div>
        )
)}

{part === 'edit' && (
    edit_guide
        ? <LearningGuideForm values={values_of(edit_guide)} original_slug={edit_guide.slug} row_id={row_id_of(edit_guide.slug)} post_url={save_url} />
        : error
            ? <ErrorRefetch args={{ partial: partial_url({ part: 'edit', slug: params.get('slug') ?? '' }), error, delay: 0 }} />
            : <EmptyState title={t('learning_admin.guide_gone')} />
)}

{part === 'save' && posted &&
    // Inside a <table>: htmx drops a bare <tbody> after Astro's leading styles.
    // The row keeps its id (a new guide stays "guide-new") so later saves find it.
    <table>
        <LearningGuideRow guide={row_guide} row_id={posted_row_id} open={true}>
            <LearningGuideForm
                slot="detail"
                values={saved_guide ? values_of(saved_guide) : posted}
                original_slug={saved_guide ? saved_guide.slug : posted_original}
                row_id={posted_row_id}
                post_url={save_url}
                saved={saved_slug !== null}
                error={save_error}
            />
        </LearningGuideRow>
    </table>
}
