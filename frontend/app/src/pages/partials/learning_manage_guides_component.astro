---
// no-error-refetch: an author form; a failed save shows inline above the form.
import { i18n } from '@helpers/i18n'
import { get_request_user } from '@helpers/request_user'
import { HTTP_403_Forbidden } from '@helpers/http_responses'
import { get_gates, can } from '@helpers/gates'
import { get_manage_guides, save_manage_guide } from '@helpers/api.minmatar.org/learning_manage'
import type { LearningManageGuide } from '@dtypes/api.minmatar.org'
import { error_text, form_flag, form_int, form_text } from '@helpers/manage_forms'
import type { ManageFlashState } from '@helpers/manage_forms'

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import Button from '@components/blocks/Button.astro'
import Input from '@components/blocks/Input.astro'
import Select from '@components/blocks/Select.astro'
import Textarea from '@components/blocks/Textarea.astro'
import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import ManageFlash from '@components/blocks/ManageFlash.astro'

const { t, translatePath } = i18n(Astro.url)
const ROOT_ID = 'learning-manage-guides'
const PARTIAL_URL = translatePath('/partials/learning_manage_guides_component/')
const KINDS = ['guide', 'blog', 'page', 'youtube', 'external', 'other']

const { auth_token } = get_request_user(Astro)
if (!auth_token) return HTTP_403_Forbidden()
if (!can(await get_gates(Astro), 'learning.manage')) return HTTP_403_Forbidden()

let flash: ManageFlashState | null = null
// A guide the author changed shows as a preview card until they publish it.
let previewed: LearningManageGuide | null = null

if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData()
    const original_slug = form_text(form, 'original_slug') || null
    const payload = {
        slug: form_text(form, 'slug'),
        title: form_text(form, 'title'),
        summary: form_text(form, 'summary'),
        url: form_text(form, 'url'),
        content_kind: form_text(form, 'content_kind') || 'guide',
        thumbnail_url: form_text(form, 'thumbnail_url'),
        estimated_minutes: form_int(form, 'estimated_minutes'),
        published: form_flag(form, 'published'),
    }
    try {
        if (form_text(form, 'action') === 'preview') {
            previewed = { id: 0, ...payload }
        } else {
            await save_manage_guide(auth_token, original_slug, payload)
            flash = { kind: 'success', message: t('learning_manage.saved') }
        }
    } catch (error) {
        flash = { kind: 'error', message: error_text(error, t('learning_manage.error_save')) }
    }
}

const guides = await get_manage_guides(auth_token)
const rows: (LearningManageGuide | null)[] = [...guides, null]
---

<div id={ROOT_ID}>
    <Flexblock gap="var(--space-l)">
        <ManageFlash flash={flash} />

        <p>{t('learning_manage.guides_lead')}</p>

        {previewed &&
            <ComponentBlock padding_inline="var(--space-s)" padding_block="var(--space-s)">
                <Flexblock gap="var(--space-xs)">
                    <small>{t('learning_manage.preview')}</small>
                    <h3>{previewed.title}</h3>
                    <p>{previewed.summary}</p>
                    <a href={previewed.url} target="_blank" rel="noreferrer noopener">{previewed.url}</a>
                    <small>{previewed.published ? t('learning_manage.published') : t('learning_manage.draft')}</small>
                </Flexblock>
            </ComponentBlock>
        }

        {rows.map((guide) =>
            <ComponentBlock padding_inline="var(--space-s)" padding_block="var(--space-s)">
                <form
                    method="post"
                    action={PARTIAL_URL}
                    hx-post={PARTIAL_URL}
                    hx-target={`#${ROOT_ID}`}
                    hx-swap="outerHTML"
                >
                    <Flexblock gap="var(--space-s)">
                        <FlexInline gap="var(--space-xs)" justification="space-between">
                            <h3>{guide ? guide.title : t('learning_manage.guides_new')}</h3>
                            {guide && !guide.published && <small>{t('learning_manage.draft')}</small>}
                        </FlexInline>
                        <input type="hidden" name="original_slug" value={guide?.slug ?? ''} />
                        <Input name="title" placeholder={t('learning_manage.title')} aria-label={t('learning_manage.title')} value={guide?.title ?? ''} required />
                        <Input name="slug" placeholder={t('learning_manage.slug')} aria-label={t('learning_manage.slug')} value={guide?.slug ?? ''} required />
                        <Input name="url" placeholder={t('learning_manage.url')} aria-label={t('learning_manage.url')} value={guide?.url ?? ''} required />
                        <Textarea name="summary" rows="3" aria-label={t('learning_manage.summary')} placeholder={t('learning_manage.summary')}>{guide?.summary ?? ''}</Textarea>
                        <Select name="content_kind" aria-label={t('learning_manage.kind')}>
                            {KINDS.map((kind) => <option value={kind} selected={(guide?.content_kind ?? 'guide') === kind}>{kind}</option>)}
                        </Select>
                        <Input name="thumbnail_url" type="url" placeholder={t('learning_manage.thumbnail')} aria-label={t('learning_manage.thumbnail')} value={guide?.thumbnail_url ?? ''} />
                        <Input name="estimated_minutes" type="number" min="1" placeholder={t('learning_manage.minutes')} aria-label={t('learning_manage.minutes')} value={guide?.estimated_minutes ? String(guide.estimated_minutes) : ''} />
                        <label>
                            <input type="checkbox" name="published" checked={guide?.published ?? true} />
                            {t('learning_manage.published')}
                        </label>
                        <FlexInline gap="var(--space-s)">
                            <Button type="submit" name="action" value="save" color="fleet-red" size="sm" off_disable={true}>{t('learning_manage.save')}</Button>
                            <Button type="submit" name="action" value="preview" color="transparent" size="sm" narrow={true} off_disable={true}>{t('learning_manage.preview_action')}</Button>
                        </FlexInline>
                    </Flexblock>
                </form>
            </ComponentBlock>
        )}
    </Flexblock>
</div>

<style lang="scss">
    h3 {
        font-size: var(--step-0);
        margin-block-end: 0;
    }
</style>
