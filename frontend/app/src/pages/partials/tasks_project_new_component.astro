---
/**
 * Starts a project from the Start a project dialog and sends the browser
 * to it. On failure, answers with the reason for the dialog's result slot.
 */
// no-error-refetch: a form submit; its result line says what went wrong.
import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

import { get_request_user } from '@helpers/request_user'
import { HTTP_403_Forbidden } from '@helpers/http_responses'
import { create_task_project } from '@helpers/api.minmatar.org/tasks'

const { auth_token } = get_request_user(Astro)
if (!auth_token || Astro.request.method !== 'POST') return HTTP_403_Forbidden()

let error: string | null = null
try {
    const form = await Astro.request.formData()
    const template_id = parseInt(String(form.get('template_id') ?? ''))
    const date = (name:string) => String(form.get(name) ?? '') || null
    const project = await create_task_project(auth_token, {
        name: String(form.get('name') ?? ''),
        template_id: Number.isFinite(template_id) ? template_id : null,
        starts_on: date('starts_on'),
        target_date: date('target_date'),
    })
    Astro.response.headers.set('HX-Redirect', translatePath(`/tasks/projects/${project.id}/`))
} catch (failure) {
    error = (failure as Error).message
}
---

{error && <p class="[ manage-field__error ]" role="alert">{error}</p>}
