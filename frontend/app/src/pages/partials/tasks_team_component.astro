---
/**
 * The Team tab. Without kind/id: every corporation and tribe the user
 * leads (open next to closed this week, alphabetical, never ranked). With
 * kind and id: one team's leader tasks, its groups, and its members' tasks
 * by kind; a needs-you kind opens in place to the pilots behind it.
 * POST with task_id and action (taking shared work) acts first.
 */
import { i18n, t_key } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { TaskTeamDetail, TaskTeamOverview, TaskTeamRow } from '@dtypes/api.minmatar.org'
import { get_request_user } from '@helpers/request_user'
import { HTTP_403_Forbidden } from '@helpers/http_responses'
import { get_task_team, get_task_teams, is_task_action, post_task_action } from '@helpers/api.minmatar.org/tasks'
import { get_corporation_logo, get_player_icon } from '@helpers/eve_image'

const { auth_token } = get_request_user(Astro)
if (!auth_token) return HTTP_403_Forbidden()

const KINDS = ['corporation', 'tribe', 'tribe_group']
const raw_kind = Astro.url.searchParams.get('kind') ?? ''
const kind = KINDS.includes(raw_kind) ? raw_kind : ''
const team_id = parseInt(Astro.url.searchParams.get('id') ?? '0')

const BASE_URL = translatePath('/partials/tasks_team_component/')
const SELF_URL = kind && team_id ? `${BASE_URL}?kind=${kind}&id=${team_id}` : BASE_URL
const TARGET = 'tasks-team'

let action_error: string | null = null
if (Astro.request.method === 'POST') {
    const task_id = parseInt(Astro.url.searchParams.get('task_id') ?? '0')
    const action = Astro.url.searchParams.get('action')
    if (task_id && is_task_action(action)) {
        try {
            await post_task_action(auth_token, task_id, action)
        } catch (failure) {
            action_error = (failure as Error).message
        }
    }
}

let overview: TaskTeamOverview | null = null
let detail: TaskTeamDetail | null = null
let error: Error | null = null
try {
    overview = await get_task_teams(auth_token)
    if (kind && team_id) detail = await get_task_team(auth_token, kind, team_id)
} catch (failure) {
    error = failure as Error
}

const teams: TaskTeamRow[] = overview ? [...overview.corporations, ...overview.tribes] : []
const team_url = (row: { kind: string, id: number }) => `${BASE_URL}?kind=${row.kind}&id=${row.id}`

import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import EmptyState from '@components/blocks/EmptyState.astro'
import ManageTable from '@components/blocks/manage/ManageTable.astro'
import TaskRollupRow from '@components/blocks/tasks/TaskRollupRow.astro'
import TaskGroup from '@components/blocks/tasks/TaskGroup.astro'
---

<div id={TARGET} class="[ tasks-team ][ task-stack is-loose ]">
    {error || !overview
        ? (
            <ErrorRefetch args={{
                partial: SELF_URL,
                error: error ?? new Error('Error fetching your teams'),
                delay: 0,
                target: `#${TARGET}`,
            }} />
        )
        : teams.length === 0 && overview.pilots.length === 0
            ? <EmptyState title={t('tasks.team.empty_title')} hint={t('tasks.team.empty_hint')} />
            : (
                <>
                    <nav class="[ manage-chips ]" aria-label={t('tasks.tab.team')}>
                        <button
                            type="button"
                            class:list={['[ manage-chip ]', { 'is-on': !detail }]}
                            aria-current={!detail ? 'true' : undefined}
                            hx-get={BASE_URL}
                            hx-target={`#${TARGET}`}
                            hx-swap="outerHTML"
                        >
                            {t('tasks.team.all_teams')}
                        </button>
                        {teams.map((row) => {
                            const on = detail?.kind === row.kind && detail?.id === row.id
                            return (
                                <button
                                    type="button"
                                    class:list={['[ manage-chip ]', { 'is-on': on }]}
                                    aria-current={on ? 'true' : undefined}
                                    hx-get={team_url(row)}
                                    hx-target={`#${TARGET}`}
                                    hx-swap="outerHTML"
                                >
                                    {row.name}
                                </button>
                            )
                        })}
                    </nav>

                    {action_error && <p class="[ manage-field__error ]" role="alert">{action_error}</p>}

                    {!detail &&
                        <>
                            {(['corporations', 'tribes'] as const).map((section) => overview![section].length > 0 && (
                                <section class="[ task-stack ]" aria-labelledby={`team-${section}`}>
                                    <h3 id={`team-${section}`} class="[ manage-eyebrow ]">{t(t_key('tasks.team.', section))}</h3>
                                    <ManageTable
                                        caption={t(t_key('tasks.team.', section))}
                                        expandable={false}
                                        min_width="30rem"
                                        columns={[
                                            { label: section === 'corporations' ? t('tasks.team.corporation') : t('tasks.team.tribe') },
                                            { label: t('tasks.team.open'), align: 'num' },
                                            { label: t('tasks.team.closed'), align: 'num' },
                                            { label: '', align: 'act', hidden: true },
                                        ]}
                                    >
                                        <tbody>
                                            {overview![section].map((row) => (
                                                <tr class="[ manage-row ]">
                                                    <td>
                                                        <span class="[ manage-who ]">
                                                            {row.kind === 'corporation' && <img src={get_corporation_logo(row.id, 64)} alt="" width="40" height="40" loading="lazy" />}
                                                            <span class="[ manage-who__text ]">
                                                                <span class="[ manage-who__name ]">{row.name}</span>
                                                                {row.detail && <span class="[ manage-who__sub ]">{row.detail}</span>}
                                                            </span>
                                                        </span>
                                                    </td>
                                                    <td class="[ num ]">{row.open}</td>
                                                    <td class="[ num manage-good ]">{row.closed_this_week}</td>
                                                    <td class="[ act ]">
                                                        <button type="button" class="[ task-quiet ]" hx-get={team_url(row)} hx-target={`#${TARGET}`} hx-swap="outerHTML">
                                                            {t('tasks.team.open_team')}
                                                        </button>
                                                    </td>
                                                </tr>
                                            ))}
                                        </tbody>
                                    </ManageTable>
                                </section>
                            ))}

                            {overview.pilots.length > 0 &&
                                <section class="[ task-stack ]" aria-labelledby="team-pilots">
                                    <h3 id="team-pilots" class="[ manage-eyebrow ]">{t('tasks.team.pilots')}</h3>
                                    <ManageTable
                                        caption={t('tasks.team.pilots')}
                                        expandable={false}
                                        min_width="30rem"
                                        columns={[
                                            { label: t('tasks.team.task') },
                                            { label: t('tasks.team.waiting'), align: 'num' },
                                            { label: t('tasks.team.closed'), align: 'num' },
                                        ]}
                                    >
                                        <tbody>
                                            {overview.pilots.map((row) => (
                                                <tr class="[ manage-row ]">
                                                    <td>
                                                        <span class="[ manage-who__text ]">
                                                            <span class="[ manage-who__name ]">{row.label}</span>
                                                            {row.weight === 'suggestion' && <span class="[ manage-who__sub ]">{t('tasks.team.suggestion')}</span>}
                                                        </span>
                                                    </td>
                                                    <td class="[ num ]">{row.waiting}</td>
                                                    <td class="[ num manage-good ]">{row.closed_this_week}</td>
                                                </tr>
                                            ))}
                                        </tbody>
                                    </ManageTable>
                                </section>
                            }
                        </>
                    }

                    {detail &&
                        <>
                            {detail.groups.length > 0 &&
                                <section class="[ task-stack ]" aria-labelledby="team-groups">
                                    <h3 id="team-groups" class="[ manage-eyebrow ]">{t('tasks.team.groups')}</h3>
                                    <ManageTable
                                        caption={t('tasks.team.groups')}
                                        expandable={false}
                                        min_width="30rem"
                                        columns={[
                                            { label: t('tasks.team.group') },
                                            { label: t('tasks.team.open'), align: 'num' },
                                            { label: t('tasks.team.closed'), align: 'num' },
                                        ]}
                                    >
                                        <tbody>
                                            {detail.groups.map((group) => (
                                                <tr class="[ manage-row ]">
                                                    <td>
                                                        <a class="[ manage-who ]" href={translatePath(`/alliance/tribes/${group.tribe_id}/${group.id}/`)}>
                                                            {group.chief?.character_id && <img src={get_player_icon(group.chief.character_id, 64)} alt="" width="40" height="40" loading="lazy" />}
                                                            <span class="[ manage-who__text ]">
                                                                <span class="[ manage-who__name ]">{group.name}</span>
                                                                <span class="[ manage-who__sub ]">
                                                                    {group.chief ? t('tasks.team.chief_is').replace('~NAME', group.chief.name) : t('tasks.team.no_chief')}
                                                                </span>
                                                            </span>
                                                        </a>
                                                    </td>
                                                    <td class="[ num ]">{group.open}</td>
                                                    <td class="[ num manage-good ]">{group.closed_this_week}</td>
                                                </tr>
                                            ))}
                                        </tbody>
                                    </ManageTable>
                                </section>
                            }

                            <TaskGroup
                                id="team-leaders"
                                title={t('tasks.team.leaders')}
                                tasks={detail.leader_tasks}
                                action_url={SELF_URL}
                                target={TARGET}
                            >
                                {detail.leader_closed_this_week > 0 &&
                                    <small slot="aside" class="[ manage-good ]">
                                        {t('tasks.team.leaders_closed').replace('~N', String(detail.leader_closed_this_week))}
                                    </small>
                                }
                            </TaskGroup>

                            <section class="[ task-stack ]" aria-labelledby="team-members">
                                <h3 id="team-members" class="[ manage-eyebrow ]">{t('tasks.team.members')}</h3>
                                {detail.members.length === 0
                                    ? <EmptyState title={t('tasks.team.no_members_waiting')} />
                                    : (
                                        <ManageTable
                                            caption={t('tasks.team.members')}
                                            min_width="30rem"
                                            columns={[
                                                { label: t('tasks.team.task') },
                                                { label: t('tasks.team.waiting'), align: 'num' },
                                                { label: t('tasks.team.closed'), align: 'num' },
                                            ]}
                                        >
                                            {detail.members.map((row) => (
                                                <TaskRollupRow row={row} team_kind={detail!.kind} team_id={detail!.id} />
                                            ))}
                                        </ManageTable>
                                    )
                                }
                                {detail.members_paused > 0 &&
                                    <p class="[ task-more ]">{t('tasks.team.paused_members').replace('~N', String(detail.members_paused))}</p>
                                }
                            </section>
                        </>
                    }
                </>
            )
    }
</div>

