---
// The Account tab's Discord nickname picker: GET renders the select, a change
// POSTs the chosen character and re-renders it with the saved choice.
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { get_request_user } from '@helpers/request_user'
import { HTTP_403_Forbidden } from '@helpers/http_responses'

const { auth_token, user } = get_request_user(Astro)

if (!auth_token || !user) return HTTP_403_Forbidden()

import { get_discord_nickname, set_discord_nickname } from '@helpers/api.minmatar.org/authentication'
import type { DiscordNickname } from '@dtypes/api.minmatar.org'

const PARTIAL_URL = translatePath('/partials/discord_nickname_component/')

let nickname: DiscordNickname | null = null
let get_error: Error | false = false
let save_failed = false

try {
    if (Astro.request.method === 'POST') {
        const form = await Astro.request.formData()
        const chosen = String(form.get('character_id') ?? '')

        try {
            nickname = await set_discord_nickname(auth_token, {
                character_id: chosen === '' ? null : parseInt(chosen),
            })
            save_failed = nickname === null
        } catch (error) {
            console.log(error)
            save_failed = true
        }
    }

    if (nickname === null)
        nickname = await get_discord_nickname(auth_token)
} catch (error) {
    get_error = error
}

import Select from '@components/blocks/Select.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
---

<div class="[ discord-nickname ]">
    {get_error ?
        <ErrorRefetch
            args={{
                partial: PARTIAL_URL,
                error: get_error,
                delay: 0,
                target: '.discord-nickname',
            }}
        />
        :
        nickname && nickname.options.length > 0 &&
        <Select
            id="discord-nickname"
            name="character_id"
            size='sm'
            width="var(--space-3xl-4xl, 16rem)"
            aria-label={t('account.discord_nickname')}
            hx-post={PARTIAL_URL}
            hx-trigger="change"
            hx-target="closest .discord-nickname"
            hx-swap="outerHTML"
            hx-disabled-elt="this"
        >
            <option value="" selected={nickname.character_id === null}>{t('account.discord_nickname_main')}</option>
            {nickname.options.map(option =>
                <option value={option.character_id} selected={nickname?.character_id === option.character_id}>
                    {option.nickname}
                </option>
            )}
        </Select>
    }
    {save_failed && <small role="alert">{t('account.discord_nickname_error')}</small>}
</div>
