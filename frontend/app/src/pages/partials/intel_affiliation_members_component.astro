---
import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'
import { get_gates, can } from '@helpers/gates'

// Members tab of /intel/affiliations/: our pilots on other blocs' kills.
const { auth_token } = get_request_user(Astro)
if (!auth_token) return HTTP_403_Forbidden()

const gates = await get_gates(Astro)
if (!can(gates, 'intel.affiliations')) return HTTP_403_Forbidden()

import type { IntelMemberCrosscheck } from '@dtypes/api.minmatar.org'
import { get_member_crosscheck } from '@helpers/api.minmatar.org/intel_affiliations'

const delay = parseInt(Astro.url.searchParams.get('delay') ?? '0') || 0

let members: IntelMemberCrosscheck[] = []
let data_fetching_error: any = null

try {
    members = await get_member_crosscheck(auth_token)
} catch (error) {
    data_fetching_error = error
}

const PARTIAL_URL = translatePath('/partials/intel_affiliation_members_component')

import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import IntelMembersTable from '@components/blocks/IntelMembersTable.astro'
---

{data_fetching_error ?
    <ErrorRefetch
        args={{
            partial: PARTIAL_URL,
            error: data_fetching_error,
            delay: delay,
        }}
    />
    :
    <IntelMembersTable members={members} />
}
