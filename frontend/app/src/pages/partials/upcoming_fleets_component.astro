---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import { HTTP_403_Forbidden, HTTP_500_Server_Error } from '@helpers/http_responses'

import { get_request_user } from '@helpers/request_user'

const { auth_token, user } = get_request_user(Astro)

if (!user)
    return HTTP_403_Forbidden()

import { get_gates, can } from '@helpers/gates'
const gates = await get_gates(Astro)

const can_view_fleets = can(gates, 'fleets.view')

if (!can_view_fleets)
    return HTTP_403_Forbidden()

import { fetch_fleet_schedule, type FleetSchedule as FleetScheduleData } from '@helpers/fetching/fleet_schedule'

let schedule: FleetScheduleData

try {
    schedule = await fetch_fleet_schedule(auth_token as string)
} catch (error) {
    return HTTP_500_Server_Error()
}

const fleets = schedule.fleets

const TIMEAGO_UPDATE_RATE_MS = 10000


import FleetSchedule from '@components/blocks/FleetSchedule.astro';
---

<div
    class="[ relative ]"
    x-data={`{
        last_update: ${new Date().getTime()},
        updated_time_ago: '',
        update_time_ago() {
            const now = new Date()

            const seconds_past = Math.floor((now.getTime() - this.last_update) / 1000);

            if (seconds_past < 60)
                this.updated_time_ago = '${t('updated_just_now')}';
            else if (seconds_past < 120)
                this.updated_time_ago = '${t('minute_ago')}';
            else {
                const minutes = Math.floor(seconds_past / 60)
                this.updated_time_ago = '${t('minutes_ago')}'.replace('MINUTES', minutes)
            }

            if ($refs.timeago_span !== undefined)
                setTimeout(() => this.update_time_ago(), ${TIMEAGO_UPDATE_RATE_MS})
        },
        init() {
            fleets_count = ${fleets?.length}
                
            this.update_time_ago()
            setTimeout(() => this.update_time_ago(), ${TIMEAGO_UPDATE_RATE_MS})
        }
    }`}
>
    {(fleets?.length ?? 0) > 0 &&
        <small class="[ absolute left-0 mt-[-30px] animate-fade-in-up ]" x-text="updated_time_ago" x-ref="timeago_span" />
    }

    <FleetSchedule
        schedule={schedule}
    />

    {(fleets?.length ?? 0) === 0 &&
        <small class="[ block text-center animate-fade-in-up ]" x-text="updated_time_ago" x-ref="timeago_span" />
    }
</div>