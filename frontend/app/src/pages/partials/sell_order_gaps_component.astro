---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { get_sell_order_supply } from '@helpers/api.minmatar.org/market'
import type { LiveSellOrderSupply } from '@dtypes/api.minmatar.org'
import { query_string } from '@helpers/string'

const location_id_param = Astro.url.searchParams.get('location_id')
const parsed_location_id = location_id_param != null && location_id_param !== ''
    ? parseInt(location_id_param, 10)
    : NaN
const location_id = Number.isNaN(parsed_location_id) ? undefined : parsed_location_id

let supply: LiveSellOrderSupply | null = null
let fetching_error: Error | false = false

if (location_id == null) {
    fetching_error = new Error('location_id is required')
} else {
    try {
        supply = await get_sell_order_supply(location_id)
    } catch (error) {
        fetching_error = error as Error
    }
}

const partial_url = translatePath(
    `/partials/sell_order_gaps_component${
        location_id != null
            ? `?${query_string({ location_id })}`
            : ''
    }`,
)

import SellOrderGapsList from '@components/blocks/SellOrderGapsList.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
---

{fetching_error !== false ?
    <ErrorRefetch
        args={{
            partial: partial_url,
            error: fetching_error,
            delay: 0,
        }}
    />
    : supply ?
        <SellOrderGapsList
            rows={supply.rows}
            hide_location={true}
            jita_copy_label={t('ops_copy_jita_buy_list')}
            jita_copy_tip={t('ops_copy_jita_buy_list_tip')}
            sales_history_days={supply.history_days ?? 0}
        />
    : null
}
