---
import { i18n } from '@helpers/i18n'
const { lang, t, translatePath } = i18n(Astro.url)

import type { LoyaltyCurrency, LoyaltyOffersList } from '@dtypes/api.minmatar.org'
import {
    get_loyalty_currencies,
    get_loyalty_offers,
} from '@helpers/api.minmatar.org/loyalty'
import { from_now_diff } from '@helpers/date'
import {
    DEFAULT_INCLUDE_FREIGHT,
    DEFAULT_INCLUDE_SALES_TAX,
    DEFAULT_LOYALTY_OFFERS_PARAMS,
    DEFAULT_LOYALTY_OFFERS_SIDE,
    TLIB_CORP_ID,
    compute_loyalty_offers_metrics,
    conversion_ordering_key,
    expand_useless_offer_excludes,
    sort_loyalty_offers,
    type LoyaltyOffersSide,
} from '@helpers/loyalty_offers_metrics'
import {
    api_offer_ordering,
    offer_row_figures,
    sort_offers_by_local_key,
    summarize_deep_offers,
} from '@helpers/loyalty_offers_rows'
import { tlf_currency } from '@helpers/loyalty_order_stats'
import { query_string } from '@helpers/string'

const params = Astro.url.searchParams

function binary_param(name: string): string | undefined {
    const value = params.get(name)
    if (value === '0' || value === '1')
        return value
    return undefined
}

// Only Tribal Liberation Force LP is traded; other militia stores are hidden.
const currency = TLIB_CORP_ID
const exclude_tags = binary_param('exclude_tags')
const exclude_blueprints = binary_param('exclude_blueprints')
const exclude_useless_offers = binary_param('exclude_useless_offers')
const exclude_below_set_lp_price = binary_param('exclude_below_set_lp_price')
const useless_excludes = expand_useless_offer_excludes(exclude_useless_offers)
const exclude_supply_packages = useless_excludes.exclude_supply_packages
const exclude_chips = useless_excludes.exclude_chips
const exclude_skins = useless_excludes.exclude_skins
const include_freight_raw = binary_param('include_freight')
const include_freight = include_freight_raw === '0'
    ? '0'
    : (include_freight_raw ?? (DEFAULT_INCLUDE_FREIGHT ? '1' : '0'))
const include_freight_enabled = include_freight !== '0'
const include_sales_tax_raw = binary_param('include_sales_tax')
const include_sales_tax = include_sales_tax_raw === '0'
    ? '0'
    : (include_sales_tax_raw ?? (DEFAULT_INCLUDE_SALES_TAX ? '1' : '0'))
const include_sales_tax_enabled = include_sales_tax !== '0'
const side_raw = params.get('side')
const side: LoyaltyOffersSide = side_raw === 'sell'
    ? 'sell'
    : side_raw === 'avg_7d'
        ? 'avg_7d'
        : DEFAULT_LOYALTY_OFFERS_SIDE
const q = (params.get('q') || '').trim() || undefined
const ordering_raw = params.get('ordering')
    || DEFAULT_LOYALTY_OFFERS_PARAMS.ordering
const ordering = ordering_raw.replace(
    /conversion_(?:sell|buy|avg_7d)/g,
    conversion_ordering_key(side),
)

const filter_state = {
    currency: String(currency),
    ...(exclude_tags ? { exclude_tags } : {}),
    ...(exclude_blueprints ? { exclude_blueprints } : {}),
    ...useless_excludes,
    ...(exclude_below_set_lp_price ? { exclude_below_set_lp_price } : {}),
    include_freight,
    include_sales_tax,
    side,
    ...(q ? { q } : {}),
    ordering,
}

const partial_url = translatePath(
    `/partials/loyalty_offers_component?${query_string(filter_state)}`,
)

let offers_list: LoyaltyOffersList = {
    items: [],
    total: 0,
    limit: 0,
    offset: 0,
}
let currencies: LoyaltyCurrency[] = []
let fetching_error: Error | false = false

try {
    ;[offers_list, currencies] = await Promise.all([
        get_loyalty_offers({
            currency,
            exclude_tags,
            exclude_supply_packages,
            exclude_chips,
            exclude_skins,
            exclude_blueprints,
            exclude_useless_offers,
            exclude_below_set_lp_price,
            side,
            q,
            ordering: api_offer_ordering(ordering, side),
        }),
        get_loyalty_currencies().then((rows) => rows.filter(
            (row) => row.corporation_id === TLIB_CORP_ID,
        )),
    ])
} catch (error) {
    fetching_error = error as Error
}

const delay = parseInt(params.get('delay') ?? '0')
const last_updated_text = offers_list.rebuilt_at
    ? t('last_updated_relative').replace(
        '{time}',
        from_now_diff(lang, new Date(offers_list.rebuilt_at)),
    )
    : ''
const offers = sort_offers_by_local_key(
    sort_loyalty_offers(
        offers_list.items,
        ordering,
        side,
        include_freight_enabled,
        include_sales_tax_enabled,
    ),
    ordering,
)
const metrics = compute_loyalty_offers_metrics(
    offers,
    side,
    include_freight_enabled,
    include_sales_tax_enabled,
)
const deep_offers = summarize_deep_offers(offers.map((offer) => offer_row_figures(
    offer,
    side,
    include_freight_enabled,
    include_sales_tax_enabled,
)))
const buyback_isk_per_lp = tlf_currency(currencies)?.default_isk_per_lp ?? null

import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import UpdateAlpineVariables from '@components/blocks/UpdateAlpineVariables.astro'
import LoyaltyOffersFilters from '@components/blocks/LoyaltyOffersFilters.astro'
import LoyaltyOffersMetrics from '@components/blocks/LoyaltyOffersMetrics.astro'
import LoyaltyOffersTable from '@components/blocks/LoyaltyOffersTable.astro'
import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import FixedFluid from '@components/compositions/FixedFluid.astro'
---

{fetching_error !== false ? (
    <ErrorRefetch
        args={{
            partial: partial_url,
            error: fetching_error,
            delay: delay,
        }}
    />
) : (
    <Flexblock gap="var(--space-l)" class="[ loyalty-offers-panel compensate-bottom-bar ]">
        <UpdateAlpineVariables
            variables={{
                offers_count: offers_list.total,
                last_updated_text: last_updated_text,
            }}
        />
        <LoyaltyOffersMetrics
            metrics={metrics}
            deep={deep_offers}
            buyback_isk_per_lp={buyback_isk_per_lp}
        />
        <ComponentBlock
            class="[ loyalty-offers-panel__body ]"
            padding_block="var(--space-s)"
            padding_inline="var(--space-s)"
        >
            <FixedFluid
                class="[ loyalty-offers-panel__layout ]"
                width="16rem"
                breakpoint="65%"
                gap="var(--space-m)"
            >
                <LoyaltyOffersFilters
                    currencies={currencies}
                    currency={currency}
                    exclude_tags={exclude_tags}
                    exclude_blueprints={exclude_blueprints}
                    exclude_useless_offers={exclude_useless_offers}
                    exclude_below_set_lp_price={exclude_below_set_lp_price}
                    include_freight={include_freight}
                    include_sales_tax={include_sales_tax}
                    side={side}
                    q={q || ''}
                    ordering={ordering}
                />
                <div class="[ loyalty-offers-panel__main ]">
                    {offers.length > 0 ? (
                        <LoyaltyOffersTable
                            offers={offers}
                            filter_state={filter_state}
                            ordering={ordering}
                            side={side}
                            include_freight={include_freight_enabled}
                            include_sales_tax={include_sales_tax_enabled}
                            buyback_isk_per_lp={buyback_isk_per_lp}
                        />
                    ) : (
                        <p class="[ loyalty-offers-empty ]">{t('industry.loyalty.offers.empty')}</p>
                    )}
                </div>
            </FixedFluid>
        </ComponentBlock>
    </Flexblock>
)}

<style lang="scss">
    :global(.loyalty-offers-panel__layout) {
        align-items: flex-start;
    }

    .loyalty-offers-empty {
        color: var(--foreground);
        font-size: var(--step-0);
    }
</style>
