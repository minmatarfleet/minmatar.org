---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden } from '@helpers/http_responses'

import type { User } from '@dtypes/jwt'
import * as jose from 'jose'

const auth_token = Astro.cookies.has('auth_token') ? (Astro.cookies.get('auth_token')?.value as string) : false
const user:User | false = auth_token ? jose.decodeJwt(auth_token) as User : false
const is_superuser = (user ? user?.is_superuser : false)

if (!user)
    return HTTP_403_Forbidden()

import { get_user_permissions } from '@helpers/permissions'
const user_permissions = (user ? await get_user_permissions(user?.username) : [])

const can_view_campaigns = is_superuser || user_permissions.includes('campaigns.view_campaign')

if (!can_view_campaigns)
    return HTTP_403_Forbidden()

import type {
    CampaignCorporationLeaderboardRow,
    CampaignLeaderboardMetric,
    CampaignLeaderboardPeriod,
} from '@dtypes/api.minmatar.org'
import { get_campaign_corporation_leaderboard } from '@helpers/api.minmatar.org/campaigns'

const slug = Astro.url.searchParams.get('slug') as string
const metric = (Astro.url.searchParams.get('metric') ?? 'kills') as CampaignLeaderboardMetric
const period = (Astro.url.searchParams.get('period') ?? 'week') as CampaignLeaderboardPeriod
const delay = parseInt(Astro.url.searchParams.get('delay') ?? '0')

let fetch_corporations_error:Error | false = false
let rows:CampaignCorporationLeaderboardRow[] = []

try {
    rows = await get_campaign_corporation_leaderboard(slug, auth_token as string, metric, period)
} catch (error) {
    fetch_corporations_error = error
}

const CORPORATIONS_PARTIAL_URL = translatePath(`/partials/campaign_corporations_component?slug=${slug}&metric=${metric}&period=${period}`)

import CampaignCorporationBoard from '@components/blocks/CampaignCorporationBoard.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
---

{fetch_corporations_error ?
    <ErrorRefetch
        args={{
            partial: CORPORATIONS_PARTIAL_URL,
            error: fetch_corporations_error,
            delay: delay,
            target: '#campaign-corporation-board',
        }}
    />
    :
    <CampaignCorporationBoard slug={slug} rows={rows} metric={metric} period={period} />
}
