---
// no-error-refetch: a section save; a failed save shows in the section it swaps back.
import { i18n } from '@helpers/i18n'
import { get_request_user } from '@helpers/request_user'
const { t, translatePath } = i18n(Astro.url)

import type { ManagedCorporationRequirements } from '@dtypes/api.minmatar.org'
import { HTTP_403_Forbidden } from '@helpers/http_responses'
import {
    RequirementError,
    create_corporation_requirement,
    delete_corporation_requirement,
    get_managed_corporation_requirements,
    put_corporation_interview_topics,
    update_corporation_requirement,
} from '@helpers/api.minmatar.org/applications'
import { over_asks, requirement_from_form } from '@helpers/corporations/requirements'
import { query_string } from '@helpers/string'

const ROOT_ID = 'corporation-requirements'
const TARGET = `#${ROOT_ID}`

const { auth_token } = get_request_user(Astro)
if (!auth_token) return HTTP_403_Forbidden()

const corporation_id = parseInt(Astro.url.searchParams.get('corporation_id') ?? '')
if (!corporation_id) return HTTP_403_Forbidden()

const partial_url = (extra: Record<string, string> = {}) => translatePath(`/partials/corporation_requirements_settings_component/?${query_string({
    corporation_id: String(corporation_id),
    ...extra,
})}`)
const PARTIAL_URL = partial_url()

// Which row is open for editing: a rule id, or "new" for the add form.
let editing = Astro.url.searchParams.get('edit') ?? ''
let error: string | null = null

const token: string = auth_token
async function current_topics() {
    const data = await get_managed_corporation_requirements(token, corporation_id)
    return data?.interview_topics ?? []
}

if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData()
    const action = String(form.get('action') ?? '')
    const rule_id = parseInt(String(form.get('rule_id') ?? ''))
    try {
        if (action === 'add') {
            await create_corporation_requirement(auth_token, corporation_id, requirement_from_form(form))
            editing = ''
        } else if (action === 'update' && rule_id) {
            const rule = requirement_from_form(form)
            await update_corporation_requirement(auth_token, corporation_id, rule_id, {
                params: rule.params,
                who: rule.who,
                importance: rule.importance,
            })
            editing = ''
        } else if (action === 'importance' && rule_id) {
            const importance = form.get('importance') === 'required' ? 'required' : 'preferred'
            await update_corporation_requirement(auth_token, corporation_id, rule_id, { importance })
        } else if (action === 'remove' && rule_id) {
            await delete_corporation_requirement(auth_token, corporation_id, rule_id)
            editing = ''
        } else if (action === 'add_topic') {
            const topic = String(form.get('topic') ?? '').trim()
            if (topic)
                await put_corporation_interview_topics(auth_token, corporation_id, [...await current_topics(), topic])
        } else if (action === 'remove_topic') {
            const index = parseInt(String(form.get('index') ?? ''))
            const topics = await current_topics()
            await put_corporation_interview_topics(auth_token, corporation_id, topics.filter((_, i) => i !== index))
        }
    } catch (failure) {
        error = failure instanceof RequirementError && failure.message !== 'not_allowed'
            ? failure.message
            : t('corporations.settings.error_save')
        if (action === 'add') editing = 'new'
        if (action === 'update' && rule_id) editing = String(rule_id)
    }
}

const data = await get_managed_corporation_requirements(auth_token, corporation_id) as ManagedCorporationRequirements | null
if (!data) return HTTP_403_Forbidden()

const rules = data.rules
const at_max = rules.length >= data.max_rules
const tag = (kind: string) => ({
    ships: t('corporations.requirements.tag_ships'),
    kills: t('corporations.requirements.tag_kills'),
    skill_points: t('corporations.requirements.tag_skill_points'),
    character_age: t('corporations.requirements.tag_character_age'),
    prime_time: t('corporations.requirements.tag_prime_time'),
} as Record<string, string>)[kind] ?? kind
const who = (value: string, kind: string) => kind === 'prime_time'
    ? null
    : ({
        main: t('corporations.requirements.who_main'),
        any: t('corporations.requirements.who_any'),
        other_account: t('corporations.requirements.who_other_account'),
    } as Record<string, string>)[value] ?? value
// One quiet line under the rule: what it checks, on whom, and how many members pass.
const meta = (rule: typeof rules[number]) => [
    tag(rule.kind),
    who(rule.who, rule.kind),
    rule.members_pass === null ? null : t('corporations.requirements.members_pass').replace('PERCENT', String(rule.members_pass)),
].filter(Boolean).join(' · ')
const importance_label = (value: 'required' | 'preferred') => t(value === 'required'
    ? 'corporations.requirements.importance_required'
    : 'corporations.requirements.importance_preferred')

import Button from '@components/blocks/Button.astro'
import ChipGroup from '@components/blocks/ChipGroup.astro'
import FilterChip from '@components/blocks/FilterChip.astro'
import EmptyState from '@components/blocks/EmptyState.astro'
import Input from '@components/blocks/Input.astro'
import StylessButton from '@components/blocks/StylessButton.astro'
import SettingsGroup from '@components/blocks/SettingsGroup.astro'
import SettingRow from '@components/blocks/SettingRow.astro'
import CorporationRequirementForm from '@components/blocks/CorporationRequirementForm.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
---

<div id={ROOT_ID} class="[ corp-req ]">
    <FlexInline class="[ settings-head ]" justification="space-between" gap="var(--space-2xs) var(--space-s)">
        <h2>{t('corporations.settings.requirements_section')}</h2>
        <a class="[ corp-req__preview ]" href="#apply">{t('corporations.requirements.preview')}</a>
    </FlexInline>

    {error && <p class="[ corp-req__error ]" role="alert">{error}</p>}

    <SettingsGroup title={t('corporations.requirements.settings_checked')}>
        {rules.length === 0 && editing !== 'new' &&
            <EmptyState
                title={t('corporations.requirements.empty')}
                hint={t('corporations.requirements.empty_hint')}
            />
        }

        {rules.map((rule) => {
            const warn = over_asks(rule)
            const open = editing === String(rule.id)
            return (
                <>
                    <SettingRow
                        title={rule.text}
                        description={meta(rule)}
                        class:list={['[ corp-req__rule ]', { 'is-open': open, 'is-attention': warn }]}
                    >
                        <ChipGroup
                            variant="segmented"
                            class="[ corp-req__importance ]"
                            aria_label={`${t('corporations.requirements.col_importance')}: ${rule.text}`}
                        >
                            {(['required', 'preferred'] as const).map((value) => (
                                <FilterChip
                                    active={rule.importance === value}
                                    hx-post={PARTIAL_URL}
                                    hx-target={TARGET}
                                    hx-swap="outerHTML"
                                    hx-vals={JSON.stringify({ action: 'importance', rule_id: String(rule.id), importance: value })}
                                >{importance_label(value)}</FilterChip>
                            ))}
                        </ChipGroup>
                        <Button
                            size="sm"
                            color="transparent"
                            aria-label={`${t('corporations.requirements.edit')}: ${rule.text}`}
                            aria-expanded={open ? 'true' : 'false'}
                            hx-get={open ? PARTIAL_URL : partial_url({ edit: String(rule.id) })}
                            hx-target={TARGET}
                            hx-swap="outerHTML"
                        >{t('corporations.requirements.edit_short')}</Button>
                    </SettingRow>
                    {warn &&
                        <div class="[ corp-req__nudge ]">
                            <span>{t('corporations.requirements.over_ask')}</span>
                            <StylessButton
                                type="button"
                                class="[ corp-req__nudge-action ]"
                                hx-post={PARTIAL_URL}
                                hx-target={TARGET}
                                hx-swap="outerHTML"
                                hx-vals={JSON.stringify({ action: 'importance', rule_id: String(rule.id), importance: 'preferred' })}
                            >{t('corporations.requirements.over_ask_action')}</StylessButton>
                        </div>
                    }
                    {open &&
                        <CorporationRequirementForm
                            options={data.options}
                            partial_url={PARTIAL_URL}
                            target={TARGET}
                            rule={rule}
                            class="[ corp-req__editor ]"
                        />
                    }
                </>
            )
        })}

        {editing === 'new' && !at_max &&
            <CorporationRequirementForm
                options={data.options}
                partial_url={PARTIAL_URL}
                target={TARGET}
                class="[ corp-req__editor corp-req__editor--new ]"
            />
        }

        {editing !== 'new' &&
            <div class="[ corp-req__footer ]">
                {at_max
                    ? <small class="[ corp-req__muted ]">{t('corporations.requirements.max_reached').replace('COUNT', String(data.max_rules))}</small>
                    : <Button
                        size="sm"
                        hx-get={partial_url({ edit: 'new' })}
                        hx-target={TARGET}
                        hx-swap="outerHTML"
                    >{t('corporations.requirements.add')}</Button>
                }
            </div>
        }
    </SettingsGroup>

    <SettingsGroup title={t('corporations.requirements.settings_interview')}>
        {data.interview_topics.length === 0 &&
            <EmptyState title={t('corporations.requirements.topics_empty')} />
        }
        {data.interview_topics.map((topic, index) => (
            <SettingRow title={topic} class="[ corp-req__topic ]">
                <StylessButton
                    type="button"
                    class="[ corp-req__remove ]"
                    aria-label={`${t('corporations.requirements.remove_topic')}: ${topic}`}
                    hx-post={PARTIAL_URL}
                    hx-target={TARGET}
                    hx-swap="outerHTML"
                    hx-vals={JSON.stringify({ action: 'remove_topic', index: String(index) })}
                >
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
                </StylessButton>
            </SettingRow>
        ))}
        <form hx-post={PARTIAL_URL} hx-target={TARGET} hx-swap="outerHTML">
            <input type="hidden" name="action" value="add_topic" />
            <SettingRow title={t('corporations.requirements.topic_label')} for="corp-req-topic" wide={true} class="[ corp-req__topic-add ]">
                <Input id="corp-req-topic" name="topic" maxlength="200" required placeholder={t('corporations.requirements.topic_placeholder')} />
                <Button type="submit" size="sm">{t('corporations.requirements.add_topic')}</Button>
            </SettingRow>
        </form>
    </SettingsGroup>
</div>

<style lang="scss">
    .corp-req {
        display: flex;
        flex-direction: column;
        gap: var(--space-l);
        padding-block: var(--space-s);
    }

    .corp-req__preview {
        font-size: var(--step--1);
    }

    .corp-req__error {
        margin: 0;
        color: var(--fleet-red);
    }

    // The importance toggle stays one line; the row wraps it under the rule on narrow screens.
    .corp-req :global(.corp-req__importance) {
        flex-wrap: nowrap;
    }

    .corp-req :global(.corp-req__importance .filter-chip) {
        min-width: 6.5em;
        justify-content: center;
    }

    // A rule most members fail: the pass rate line turns yellow, the nudge sits under it.
    .corp-req :global(.corp-req__rule.is-attention small) {
        color: var(--fleet-yellow);
    }

    .corp-req :global(.corp-req__rule.is-attention) {
        padding-block-end: var(--space-2xs);
    }

    .corp-req__nudge {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--space-3xs) var(--space-xs);
        padding-block-end: var(--space-s);
        font-size: var(--step--1);
        color: var(--foreground);
    }

    .corp-req :global(.corp-req__nudge-action) {
        color: var(--fleet-yellow);
        text-decoration: underline;
        text-underline-offset: 0.2em;
        cursor: pointer;

        &:hover {
            color: var(--highlight);
        }
    }

    // The open editor reads as part of its rule: inset under it, before the next rule's rule line.
    .corp-req :global(.corp-req__editor) {
        margin-block-end: var(--space-s);
    }

    .corp-req :global(.corp-req__editor--new) {
        margin-block-start: var(--space-s);
    }

    .corp-req__footer {
        padding-block: var(--space-s);
        border-block-start: 1px solid var(--border-color);
    }

    .corp-req__muted {
        color: var(--faded);
    }

    // A topic is one line of text with its remove button beside it, at every width.
    .corp-req :global(.corp-req__topic) {
        flex-wrap: nowrap;
        padding-block: var(--space-xs);
    }

    .corp-req :global(.corp-req__topic .setting-row__text) {
        flex-basis: 0;
    }

    .corp-req :global(.corp-req__topic strong) {
        font-weight: 400;
    }

    // The new topic field fills the row, its Add button stays beside it.
    .corp-req :global(.corp-req__topic-add .input-group) {
        flex: 1 1 12rem;
        min-width: 0;
    }

    .corp-req :global(.corp-req__topic-add input) {
        width: 100%;
    }

    .corp-req :global(.corp-req__remove) {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: var(--space-l);
        height: var(--space-l);
        color: var(--faded);
        cursor: pointer;

        svg {
            width: var(--step-0);
            height: var(--step-0);
        }

        &:hover {
            color: var(--fleet-red);
        }
    }
</style>
