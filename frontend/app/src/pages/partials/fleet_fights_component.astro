---
import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden, HTTP_404_Not_Found } from '@helpers/http_responses'

import { get_request_user } from '@helpers/request_user'

const { auth_token, user } = get_request_user(Astro)

if (!user)
    return HTTP_403_Forbidden()

const fleet_id = parseInt(Astro.url.searchParams.get('fleet_id') ?? '0')
const delay = parseInt(Astro.url.searchParams.get('delay') ?? '0')

if (!fleet_id)
    return HTTP_404_Not_Found()

import { get_fleet_fights, type FleetFights as FleetFightsData } from '@helpers/api.minmatar.org/fleets'

let fetch_error:Error | false = false
let fights:FleetFightsData | null = null

try {
    fights = await get_fleet_fights(auth_token as string, fleet_id)
} catch (error) {
    fetch_error = error
}

const PARTIAL_URL = translatePath(`/partials/fleet_fights_component?fleet_id=${fleet_id}`)

import FleetFights from '@components/blocks/FleetFights.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
---

{fetch_error ?
    <ErrorRefetch
        args={{
            partial: PARTIAL_URL,
            error: fetch_error,
            delay: delay,
            target: '#fleet-fights',
        }}
    />
    :
    fights ?
        <FleetFights fights={fights} fleet_id={fleet_id} />
        :
        <div id="fleet-fights" />
}
