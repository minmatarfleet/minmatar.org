---
import { login_redirect } from '@helpers/http_responses'
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { User } from '@dtypes/jwt'
import * as jose from 'jose'

const auth_token = Astro.cookies.has('auth_token') ? Astro.cookies.get('auth_token')?.value as string : false
const user: User | false = auth_token ? (jose.decodeJwt(auth_token) as User) : false

if (!user) return login_redirect(Astro)

const fleet_id = parseInt(Astro.url.searchParams.get('fleet_id') ?? '0')
const readonly = JSON.parse(Astro.url.searchParams.get('readonly') ?? 'true') as boolean
const is_fleet_commander = Astro.url.searchParams.get('is_fleet_commander') === 'true'

import type { Alert } from '@dtypes/layout_components'

import type { SummaryCharacter } from '@dtypes/api.minmatar.org'
import { get_characters_summary_sorted } from '@helpers/fetching/characters'
import {
    assign_fleet_ship_volunteer_system,
    get_fleet_composition,
    get_fleet_roles,
    type FleetCompositionEntry,
    type FleetRoleCoverage,
} from '@helpers/api.minmatar.org/fleets'
import { fetch_fleet_by_id } from '@helpers/fetching/fleets'

let fetch_error: Error | false = false
let pilots: SummaryCharacter[] = []
let roles: FleetRoleCoverage | null = null
let composition: FleetCompositionEntry[] = []
let alert:Alert | false = false
let history:boolean = false

// FC assigns (or clears) a cyno pilot's system; the API DMs the pilot.
if (Astro.request.method === 'PATCH') {
    const ship_volunteer_id = parseInt(Astro.url.searchParams.get('ship_volunteer_id') ?? '')
    const clear_system = Astro.url.searchParams.get('clear_system') === 'true'
    const solar_system_id = parseInt(Astro.url.searchParams.get('solar_system_id') ?? '')
    const solar_system_name = Astro.url.searchParams.get('solar_system_name') ?? ''

    try {
        if (isNaN(ship_volunteer_id))
            throw new Error(t('invalid_remove_id'))

        await assign_fleet_ship_volunteer_system(auth_token as string, fleet_id, ship_volunteer_id, clear_system ?
            { solar_system_id: null, solar_system_name: null } :
            { solar_system_id: isNaN(solar_system_id) ? null : solar_system_id, solar_system_name: solar_system_name }
        )
    } catch (error) {
        alert = {
            title: t('assign_cyno_system'),
            content: error.message as string,
        }
    }
}

try {
    if (isNaN(fleet_id))
        throw new Error(t('invalid_fleet_id'), { cause: 400 })

    const fleet = await fetch_fleet_by_id(auth_token as string, fleet_id)
    history = Boolean(fleet?.tracking?.end_time)

    if (!history) {
        const [summary, fetched_roles, fetched_composition] = await Promise.all([
            get_characters_summary_sorted(auth_token as string),
            get_fleet_roles(auth_token as string, fleet_id),
            get_fleet_composition(auth_token as string, fleet_id),
        ])
        pilots = summary.characters ?? []
        roles = fetched_roles
        composition = fetched_composition
    }
} catch (error) {
    fetch_error = error

    alert = {
        title: t('refresh_fleet_roles'),
        content: error.message,
    }
}

import { query_string } from '@helpers/string';
const FLEET_ROLES_PARTIAL_URL = translatePath(`/partials/fleet_role_component?${query_string({
    fleet_id: fleet_id,
    readonly: readonly,
    is_fleet_commander: is_fleet_commander,
})}`)

import ErrorRefetch from '@components/blocks/ErrorRefetch.astro';
import FleetRoles from '@components/blocks/FleetRoles.astro';
import ShowAlert from '@components/blocks/ShowAlert.astro';

const delay = parseInt(Astro.url.searchParams.get('delay') ?? '0')
---

{alert && <ShowAlert alert={alert} /> }

{fetch_error ?
    <ErrorRefetch
        args={{
            partial: FLEET_ROLES_PARTIAL_URL,
            error: fetch_error,
            delay: delay,
        }}
    />
    :
    !history && roles &&
        <FleetRoles
            roles={roles}
            composition={composition}
            pilots={pilots}
            fleet_id={fleet_id}
            readonly={readonly}
            is_fleet_commander={is_fleet_commander}
        />
}
