---
// no-error-refetch: on an API failure the ladder renders without readiness, the same as the page before it loads.
import { HTTP_404_Not_Found } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'
import { get_fleet_role } from '@/data/fleet-roles'
import { get_training_hulls } from '@helpers/api.minmatar.org/training'
import { get_doctrines } from '@helpers/api.minmatar.org/doctrines'
import type { Doctrine, TrainingHullReadiness } from '@dtypes/api.minmatar.org'
import type { HullDoctrine } from '@components/blocks/role-guide/RoleLadder.astro'

const guide = get_fleet_role(Astro.url.searchParams.get('role') ?? '')
if (!guide)
    return HTTP_404_Not_Found()

const { auth_token, user } = get_request_user(Astro)

// null = logged out; [] = the API failed, which shows the ladder without states.
let readiness: TrainingHullReadiness[] | null = null
if (user && auth_token) {
    try {
        readiness = await get_training_hulls(auth_token, guide.ladder.map((rung) => rung.ship_type_id))
    } catch (error) {
        console.log(`Ladder readiness unavailable: ${error.message}`)
        readiness = []
    }
}

// Which current doctrines fly each ladder hull, and in which slot. Public, so
// logged-out readers see it too.
const SLOTS = [
    ['primary_fittings', 'primary'],
    ['secondary_fittings', 'secondary'],
    ['support_fittings', 'support'],
    ['utility_fittings', 'utility'],
] as const
const hulls = new Set(guide.ladder.map((rung) => rung.ship_type_id))
const doctrines: Record<number, HullDoctrine[]> = {}
let all_doctrines: Doctrine[] = []
try {
    all_doctrines = await get_doctrines()
} catch (error) {
    console.log(`Ladder doctrines unavailable: ${error.message}`)
}
for (const doctrine of all_doctrines) {
    if (doctrine.retired) continue
    for (const [field, role] of SLOTS) {
        for (const fitting of doctrine[field] ?? []) {
            if (!hulls.has(fitting.ship_id)) continue
            const list = (doctrines[fitting.ship_id] ??= [])
            if (!list.some((d) => d.doctrine_id === doctrine.id))
                list.push({ doctrine_id: doctrine.id, name: doctrine.name, role })
        }
    }
}

import RoleLadder from '@components/blocks/role-guide/RoleLadder.astro'
---

<RoleLadder guide={guide} readiness={readiness} doctrines={all_doctrines.length > 0 ? doctrines : undefined} />
