---
/**
 * The pilot's own task switches, on the Account Notifications tab: show
 * suggestions, pause my tasks, and what to expect. POST saves one switch
 * (show_suggestions or paused, "on"/"off" or a checkbox) and re-renders.
 * The My tasks "I'm back" button posts here too (from=mine).
 */
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { TaskPreferences, TaskPreferencesPatch } from '@dtypes/api.minmatar.org'
import { get_request_user } from '@helpers/request_user'
import { HTTP_403_Forbidden } from '@helpers/http_responses'
import { get_task_preferences, patch_task_preferences } from '@helpers/api.minmatar.org/tasks'

const { auth_token } = get_request_user(Astro)
if (!auth_token) return HTTP_403_Forbidden()

const SELF_URL = translatePath('/partials/tasks_preferences_component/')

let prefs: TaskPreferences | null = null
let error: Error | null = null
try {
    if (Astro.request.method === 'POST') {
        const form = await Astro.request.formData()
        const field = String(form.get('field') ?? '')
        const value = (name:string) => {
            const raw = form.get(name)
            return raw === 'on' || raw === 'true'
        }
        const patch:TaskPreferencesPatch = {}
        if (form.has('paused') && !field) patch.paused = value('paused')
        if (field === 'paused') patch.paused = value('paused')
        if (field === 'show_suggestions') patch.show_suggestions = value('show_suggestions')
        prefs = await patch_task_preferences(auth_token, patch)
        Astro.response.headers.set('HX-Trigger', JSON.stringify({
            'tasks-changed': true,
            'tasks-count-changed': true,
        }))
    } else {
        prefs = await get_task_preferences(auth_token)
    }
} catch (failure) {
    error = failure as Error
}

import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import SettingRow from '@components/blocks/SettingRow.astro'
import ManageSwitch from '@components/blocks/manage/ManageSwitch.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
---

<div id="tasks-preferences">
    {prefs
        ? (
            <ComponentBlock>
                <Flexblock gap="0">
                    <h2 class="[ account-page__heading ]">{t('tasks.prefs.title')}</h2>
                    <SettingRow title={t('tasks.prefs.show_suggestions')} description={t('tasks.prefs.show_suggestions_hint')}>
                        <form hx-post={SELF_URL} hx-trigger="change" hx-target="#tasks-preferences" hx-swap="outerHTML">
                            <input type="hidden" name="field" value="show_suggestions" />
                            <ManageSwitch name="show_suggestions" label={t('tasks.prefs.show_suggestions')} hide_label={true} checked={prefs.show_suggestions} />
                        </form>
                    </SettingRow>
                    <SettingRow
                        title={t('tasks.prefs.paused')}
                        description={prefs.on_leave ? t('tasks.prefs.on_leave') : t('tasks.prefs.paused_hint')}
                    >
                        <form hx-post={SELF_URL} hx-trigger="change" hx-target="#tasks-preferences" hx-swap="outerHTML">
                            <input type="hidden" name="field" value="paused" />
                            <ManageSwitch name="paused" label={t('tasks.prefs.paused')} hide_label={true} checked={prefs.paused || prefs.on_leave} disabled={prefs.on_leave} />
                        </form>
                    </SettingRow>
                    <SettingRow title={t('tasks.prefs.visibility')} description={t('tasks.prefs.visibility_hint')} />
                    <SettingRow title={t('tasks.prefs.consequence')} description={t('tasks.prefs.consequence_hint')} />
                </Flexblock>
            </ComponentBlock>
        )
        : (
            <ErrorRefetch args={{
                partial: SELF_URL,
                error: error ?? new Error('Error fetching your task settings'),
                delay: 0,
                target: '#tasks-preferences',
            }} />
        )
    }
</div>
