---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden, HTTP_404_Not_Found } from '@helpers/http_responses'

import { get_request_user } from '@helpers/request_user'

const { auth_token, user } = get_request_user(Astro)

if (!user)
    return HTTP_403_Forbidden()

const fleet_id = parseInt(Astro.url.searchParams.get('fleet_id') ?? '0')
const delay = parseInt(Astro.url.searchParams.get('delay') ?? '0')

if (!fleet_id)
    return HTTP_404_Not_Found()

import { fetch_fleet_by_id } from '@helpers/fetching/fleets'
import { get_fleet_composition } from '@helpers/api.minmatar.org/fleets'
import { command_steps, type CommandStep } from '@helpers/fleet_command'
import type { FleetUI } from '@dtypes/layout_components'

let fleet:FleetUI | null = null
let steps:CommandStep[] = []
let fetch_error:Error | false = false
try {
    const [ loaded, composition ] = await Promise.all([
        fetch_fleet_by_id(auth_token as string, fleet_id),
        get_fleet_composition(auth_token as string, fleet_id).catch(() => []),
    ])
    fleet = loaded
    steps = command_steps({
        start_time: loaded.start_time,
        tracking: loaded.tracking,
        disable_motd: loaded.disable_motd,
        has_ships: (composition ?? []).length > 0,
    }, t)
} catch (error) {
    if (error?.cause === 404)
        return HTTP_404_Not_Found()
    fetch_error = error
}

const SELF_URL = translatePath(`/partials/fleet_command_steps_component?fleet_id=${fleet_id}`)

import FleetSetupSteps from '@components/blocks/FleetSetupSteps.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
---

{fetch_error || !fleet ?
    <ErrorRefetch args={{ partial: SELF_URL, error: fetch_error || new Error('No fleet'), delay, target: '#fleet-command-steps' }} />
    :
    <FleetSetupSteps
        fleet_id={fleet_id}
        steps={steps}
        refresh={Boolean(fleet.tracking?.start_time) && !fleet.tracking?.end_time}
    />
}
