---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { get_market_contracts_metrics } from '@helpers/api.minmatar.org/market'
import { number_thousand_separator } from '@helpers/numbers'
import { query_string } from '@helpers/string'
import type { ContractMetrics } from '@dtypes/api.minmatar.org'

const location_id_param = Astro.url.searchParams.get('location_id')
const parsed_location_id = location_id_param != null && location_id_param !== ''
    ? parseInt(location_id_param, 10)
    : NaN
const location_id = Number.isNaN(parsed_location_id) ? undefined : parsed_location_id

let metrics: ContractMetrics[] = []
let fetching_error: Error | false = false

if (location_id == null) {
    fetching_error = new Error('Missing location_id')
} else {
    try {
        metrics = await get_market_contracts_metrics(location_id)
    } catch (error) {
        fetching_error = error as Error
    }
}

const partial_url = translatePath(
    `/partials/ops_contracts_metrics_component${
        location_id != null
            ? `?${query_string({ location_id })}`
            : ''
    }`,
)

function format_fleets_per_month(value: number): string {
    if (Number.isInteger(value))
        return number_thousand_separator(value)
    return value.toFixed(1)
}

import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
---

{fetching_error !== false ?
    <ErrorRefetch
        args={{
            partial: partial_url,
            error: fetching_error,
            delay: 0,
        }}
    />
    :
    <>
        <div
            id="ops-contracts-metrics-json"
            hx-swap-oob="true"
            hidden
            data-metrics={JSON.stringify(metrics)}
        ></div>

        {metrics.map(row =>
            <>
                <span
                    id={`contract-metric-volume-${row.fitting_id}`}
                    class="[ market-contracts-card__metric-value ]"
                    hx-swap-oob="true"
                >{number_thousand_separator(row.volume_28d)}</span>
                <span
                    id={`contract-metric-fleets-available-${row.fitting_id}`}
                    class="[ market-contracts-card__metric-value ]"
                    hx-swap-oob="true"
                >{row.fleets_remaining != null
                    ? number_thousand_separator(row.fleets_remaining)
                    : t('ops_contract_fleets_remaining_unknown')}</span>
                <span
                    id={`contract-metric-fleets-mo-${row.fitting_id}`}
                    class="[ market-contracts-card__metric-value ]"
                    hx-swap-oob="true"
                >{row.fleets_per_month != null
                    ? format_fleets_per_month(row.fleets_per_month)
                    : t('ops_contract_fleets_remaining_unknown')}</span>
            </>
        )}
    </>
}
