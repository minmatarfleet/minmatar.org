---
import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

import {
    get_market_health,
    get_market_character_statistics,
} from '@helpers/api.minmatar.org/market'
import type {
    MarketHealth,
    MarketOperatorStatistics,
} from '@dtypes/api.minmatar.org'
import { query_string } from '@helpers/string'

const HISTORY_DAYS = 30

const location_id_param = Astro.url.searchParams.get('location_id')
const parsed_location_id = location_id_param != null && location_id_param !== ''
    ? parseInt(location_id_param, 10)
    : NaN
const location_id = Number.isNaN(parsed_location_id) ? undefined : parsed_location_id

let health: MarketHealth | null = null
let market_operators: MarketOperatorStatistics[] = []
let fetching_error: Error | false = false

if (location_id == null) {
    fetching_error = new Error('location_id is required')
} else {
    try {
        const [health_result, operators_result] = await Promise.all([
            get_market_health(location_id, { days: HISTORY_DAYS }),
            get_market_character_statistics().catch((error) => {
                console.log(error)
                return [] as MarketOperatorStatistics[]
            }),
        ])
        health = health_result
        market_operators = operators_result
    } catch (error) {
        fetching_error = error as Error
    }
}

const partial_url = translatePath(
    `/partials/market_health_component${
        location_id != null
            ? `?${query_string({ location_id })}`
            : ''
    }`,
)

import MarketHealthContent from '@components/blocks/MarketHealthContent.astro'
import MarketOperatorsReel from '@components/blocks/MarketOperatorsReel.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
---

{fetching_error !== false ?
    <ErrorRefetch
        args={{
            partial: partial_url,
            error: fetching_error,
            delay: 0,
        }}
    />
    : health ?
        <div class="[ compensate-bottom-bar ]">
            <MarketHealthContent
                health={health}
                history={health.chart}
                location_id={location_id}
            />
            <MarketOperatorsReel market_operators={market_operators} />
        </div>
    : null
}
