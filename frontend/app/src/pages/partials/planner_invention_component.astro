---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { get_planner_invention_quote } from '@helpers/api.minmatar.org/industry'
import type { PlannerInvention } from '@dtypes/api.minmatar.org'
import { format_isk, ISK_COMPACT_PRECISE, number_thousand_separator } from '@helpers/numbers'
import { query_string } from '@helpers/string'

const params = Astro.url.searchParams
const type_id = parseInt(params.get('type_id') ?? '0') || 0
const quantity = Math.max(1, parseInt(params.get('quantity') ?? '1') || 1)
const facility_key = params.get('facility_key') || 'amamake'
const decryptor = params.get('decryptor') || 'auto'
const source_type_id = parseInt(params.get('source_type_id') ?? '') || null
const delay = parseInt(params.get('delay') ?? '0') || 0

let quote: PlannerInvention | null = null
let fetching_error: Error | false = false

try {
    if (!type_id)
        throw new Error('Invalid type id', { cause: 400 })
    quote = await get_planner_invention_quote(type_id, { quantity, facility_key, decryptor, source_type_id })
} catch (error) {
    fetching_error = error as Error
}

const partial_url = translatePath(`/partials/planner_invention_component?${query_string({
    type_id,
    quantity,
    facility_key,
    decryptor,
    ...(source_type_id ? { source_type_id } : {}),
})}`)

const n = (value: number, digits = 0) => number_thousand_separator(Number(value.toFixed(digits)))
const pct = (value: number) => `${Math.round(value * 100)}%`
const isk = (value: number) => format_isk(value, { format: ISK_COMPACT_PRECISE })

const headline = quote
    ? t('industry.orders.planner.invention_headline')
        .replace('{decryptor}', quote.decryptor_name)
        .replace('{chance}', pct(quote.chance))
        .replace('{attempts}', quote.expected_attempts.toFixed(1))
        .replace('{isk}', isk(quote.invention_per_unit_isk))
    : ''

import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import ItemPicture from '@components/blocks/ItemPicture.astro'
import DataTable from '@components/blocks/DataTable.astro'
---

{fetching_error !== false || !quote ?
    <ErrorRefetch args={{
        partial: partial_url,
        error: fetching_error || new Error(t('industry.orders.planner.invention_error')),
        delay,
    }} />
    :
    <details class="[ invention-card ]">
        <summary>
            <strong>{headline}</strong>
            <small>
                {t('industry.orders.planner.invention_copy')
                    .replace('{runs}', n(quote.runs_per_copy))
                    .replace('{me}', n(quote.copy_me))
                    .replace('{te}', n(quote.copy_te))
                    .replace('{source}', quote.source_name)}
            </small>
        </summary>

        <div class="[ invention-body ]">
            <p class="[ invention-risk ]">
                {t('industry.orders.planner.invention_buy')
                    .replace('{buy}', n(quote.buy_attempts))
                    .replace('{p90}', n(quote.attempts_p90))}
            </p>

            <DataTable class="[ invention-table ]" density="dense" columns={[{ key: 'c0', label: t('industry.orders.planner.invention_input') }, { key: 'c1', label: t('industry.orders.planner.invention_per_attempt'), numeric: true }, { key: 'c2', label: t('industry.orders.planner.invention_to_buy'), numeric: true }, { key: 'c3', label: t('industry.orders.planner.invention_unit_price'), numeric: true }]}>
                        {quote.inputs.map(input =>
                            <tr>
                                <th scope="row">
                                    <span class="[ item ]">
                                        <ItemPicture item_id={input.type_id} size={32} icon_quality={64} />
                                        <span>{input.name}</span>
                                    </span>
                                </th>
                                <td class="[ num data-table__numeric ]">{n(input.quantity_per_attempt)}</td>
                                <td class="[ num data-table__numeric ]">{n(input.buy_quantity)}</td>
                                <td class="[ num data-table__numeric ]">{isk(input.unit_price)}</td>
                            </tr>
                        )}
                </DataTable>

            {quote.alternatives.length > 0 &&
                <DataTable class="[ invention-table ]" density="dense" caption_visible={true} caption={t('industry.orders.planner.invention_compare')} columns={[{ key: 'c0', label: t('industry.orders.planner.decryptor') }, { key: 'c1', label: t('industry.orders.planner.invention_chance'), numeric: true }, { key: 'c2', label: t('industry.orders.planner.invention_copy_col'), numeric: true }, { key: 'c3', label: t('industry.orders.planner.invention_unit_cost'), numeric: true }]}>
                            <tr class="[ is-best ]">
                                <th scope="row">{quote.decryptor_name}</th>
                                <td class="[ num data-table__numeric ]">{pct(quote.chance)}</td>
                                <td class="[ num data-table__numeric ]">{`${n(quote.runs_per_copy)} · ME ${n(quote.copy_me)}`}</td>
                                <td class="[ num data-table__numeric ]">{isk(quote.per_unit_isk)}</td>
                            </tr>
                            {quote.alternatives.map(option =>
                                <tr>
                                    <th scope="row">
                                        {option.decryptor_name}
                                        {option.source_type_id !== quote.source_type_id &&
                                            <small>{option.source_name}</small>
                                        }
                                    </th>
                                    <td class="[ num data-table__numeric ]">{pct(option.chance)}</td>
                                    <td class="[ num data-table__numeric ]">{`${n(option.runs_per_copy)} · ME ${n(option.copy_me)}`}</td>
                                    <td class="[ num data-table__numeric ]">{isk(option.per_unit_isk)}</td>
                                </tr>
                            )}
                    </DataTable>
            }
        </div>
    </details>
}

<style lang="scss">
    .invention-card {
        border: solid 1px var(--border-color);
        background: var(--component-background);

        summary {
            display: flex;
            flex-direction: column;
            gap: var(--space-3xs);
            padding: var(--space-s);
            cursor: pointer;

            strong {
                font-family: var(--heading-font);
                color: var(--highlight);
            }

            small {
                color: var(--foreground);
            }
        }
    }

    .invention-body {
        display: flex;
        flex-direction: column;
        gap: var(--space-s);
        padding: 0 var(--space-s) var(--space-s);
    }

    .invention-risk {
        margin: 0;
        font-size: var(--step--1);
        color: var(--foreground);
    }

    tbody th small {
        display: block;
        color: var(--faded);
    }

    .num {
        white-space: nowrap;
    }

    .is-best th,
    .is-best td {
        color: var(--highlight);
    }

    .item {
        display: flex;
        align-items: center;
        gap: var(--space-2xs);
    }
</style>
