---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'
import { get_gates, can } from '@helpers/gates'
import { invite_feedback_show_link } from '@helpers/api.minmatar.org/invite_feedback' // pragma: allowlist secret

const { auth_token, user } = get_request_user(Astro)
if (!user) return HTTP_403_Forbidden()

const gates = await get_gates(Astro)
let show = false
if (can(gates, 'fleets.manage_any')) {
    try {
        show = await invite_feedback_show_link(auth_token as string)
    } catch {
        show = false
    }
}
---

{show &&
    <p class="[ invite-feedback-link ]">
        <a href={translatePath('/fleets/invite-feedback/results/')}>{t('fleets.invite_feedback.link')}</a>
    </p>
}

<style lang="scss">
    .invite-feedback-link {
        margin: 0;

        a {
            color: var(--highlight);
        }
    }
</style>
