---
import { i18n } from '@helpers/i18n'
const { lang, t, translatePath } = i18n(Astro.url)

import type { User } from '@dtypes/jwt'
import * as jose from 'jose'
import { HTTP_400_Bad_Request, HTTP_403_Forbidden } from '@helpers/http_responses'

const auth_token = Astro.cookies.has('auth_token')
    ? (Astro.cookies.get('auth_token')?.value as string)
    : false
const user: User | false = auth_token ? jose.decodeJwt(auth_token) as User : false
const is_logged_in = !!(user && auth_token)

if (!is_logged_in)
    return HTTP_403_Forbidden()

const order_id = parseInt(Astro.url.searchParams.get('order_id') ?? '', 10)
if (isNaN(order_id) || order_id < 1)
    return HTTP_400_Bad_Request()

import {
    apply_fitting_buy_swap,
    put_fitting_buy_allocations,
    get_fitting_buy_order,
    patch_fitting_buy_order,
    paste_fitting_buy_landed_prices,
    poll_fitting_buy_jita_check,
    start_fitting_buy_jita_check,
    upsert_fitting_buy_line,
    delete_fitting_buy_line,
    delete_fitting_buy_order,
    type FittingBuyOrderDetail,
} from '@helpers/api.minmatar.org/fitting_buy_orders'
import {
    fitting_buy_status_color,
    fitting_buy_status_label,
} from '@helpers/fitting_buy_status'
import { format_date_time } from '@helpers/date'

let order: FittingBuyOrderDetail | null = null
let error_message: string | false = false
let check_id = parseInt(Astro.url.searchParams.get('check_id') ?? '', 10)
let poll_check = Astro.url.searchParams.get('poll') === '1'

const PARTIAL_BASE = translatePath(`/partials/fitting_buy_order_component?order_id=${order_id}`)
const token = auth_token as string

async function handle_post_action(action: string, form: FormData) {
    switch (action) {
        case 'stock':
            order = await patch_fitting_buy_order(token, order_id, {
                stock_paste: String(form.get('stock_paste') ?? ''),
            })
            return
        case 'update_line': {
            const fitting_id = parseInt(String(form.get('fitting_id') ?? ''), 10)
            const quantity = parseInt(String(form.get('quantity') ?? ''), 10)
            order = await upsert_fitting_buy_line(token, order_id, {
                fitting_id,
                quantity: Math.max(1, quantity || 1),
            })
            return
        }
        case 'remove_line': {
            const line_id = parseInt(String(form.get('line_id') ?? ''), 10)
            order = await delete_fitting_buy_line(token, order_id, line_id)
            return
        }
        case 'delete_order': {
            await delete_fitting_buy_order(token, order_id)
            return new Response(null, {
                status: 200,
                headers: {
                    'HX-Redirect': translatePath('/market/fitting_orders/'),
                },
            })
        }
        case 'swap':
            order = await apply_fitting_buy_swap(
                token,
                order_id,
                parseInt(String(form.get('line_id') ?? ''), 10),
                {
                    preferred_type_id: parseInt(String(form.get('preferred_type_id') ?? ''), 10),
                    substitute_type_id: parseInt(String(form.get('substitute_type_id') ?? ''), 10),
                    notes: String(form.get('notes') ?? ''),
                },
            )
            return
        case 'save_allocations': {
            const preferred_type_id = parseInt(String(form.get('preferred_type_id') ?? ''), 10)
            const entries: { type_id: number; qty: number }[] = []
            for (const [key, value] of form.entries()) {
                if (!key.startsWith('qty_'))
                    continue
                const type_id = parseInt(key.slice(4), 10)
                const qty = parseInt(String(value ?? ''), 10)
                if (isNaN(type_id) || isNaN(qty))
                    continue
                entries.push({ type_id, qty })
            }
            order = await put_fitting_buy_allocations(token, order_id, {
                preferred_type_id,
                entries,
            })
            return
        }
        case 'mark_pending_fitting': {
            const current = await get_fitting_buy_order(token, order_id)
            if (current.is_owner && current.status === 'draft') {
                order = await patch_fitting_buy_order(token, order_id, {
                    status: 'pending_fitting',
                })
            } else {
                order = current
            }
            return
        }
        case 'refresh_jita': {
            const check = await start_fitting_buy_jita_check(token, order_id, {
                force_refresh: true,
            })
            check_id = check.id
            poll_check = true
            order = {
                ...(await get_fitting_buy_order(token, order_id)),
                active_jita_check: check,
            }
            return
        }
        case 'landed_prices': {
            const result = await paste_fitting_buy_landed_prices(
                token,
                order_id,
                String(form.get('paste') ?? ''),
            )
            order = result.order
            return
        }
        default:
            order = await get_fitting_buy_order(token, order_id)
    }
}

try {
    if (Astro.request.method === 'POST') {
        const form = await Astro.request.formData()
        const action_result = await handle_post_action(String(form.get('action') ?? ''), form)
        if (action_result instanceof Response)
            return action_result
        // Swaps / stock / etc. may kick off a quiet Jita check — keep polling.
        if (
            order?.active_jita_check
            && (order.active_jita_check.status === 'pending'
                || order.active_jita_check.status === 'running')
        ) {
            check_id = order.active_jita_check.id
            poll_check = true
        }
    } else if (poll_check && !isNaN(check_id)) {
        const polled = await poll_fitting_buy_jita_check(token, order_id, check_id)
        if (polled.order)
            order = polled.order
        else
            order = await get_fitting_buy_order(token, order_id)

        poll_check = polled.check.status === 'pending' || polled.check.status === 'running'
        order = {
            ...order,
            active_jita_check: polled.check,
        }
    } else {
        order = await get_fitting_buy_order(token, order_id)
        if (order.active_jita_check &&
            (order.active_jita_check.status === 'pending' || order.active_jita_check.status === 'running')) {
            check_id = order.active_jita_check.id
            poll_check = true
        } else if (
            order.is_owner
            && !order.jita_checked_at
            && order.items.some((item) => item.buy_qty > 0)
        ) {
            try {
                const check = await start_fitting_buy_jita_check(token, order_id, {
                    force_refresh: false,
                })
                check_id = check.id
                poll_check = true
                order = {
                    ...order,
                    active_jita_check: check,
                }
            } catch {
                // Throttled or nothing to buy — show the list without depth.
            }
        }
    }
} catch (error) {
    const err = error as Error
    error_message = err?.message || String(error)
    if (!order) {
        try {
            order = await get_fitting_buy_order(token, order_id)
        } catch {
            // Keep the detail message even if the follow-up fetch fails.
        }
    }
}

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import Button from '@components/blocks/Button.astro'
import ButtonConfirm from '@components/blocks/ButtonConfirm.astro'
import Tag from '@components/blocks/Tag.astro'
import ItemPicture from '@components/blocks/ItemPicture.astro'
import ClipboardButton from '@components/blocks/ClipboardButton.astro'
import FittingBuyOrderShopping from '@components/blocks/FittingBuyOrderShopping.astro'

const MAX_PURCHASE_TYPES = 100
const is_owner = order?.is_owner ?? false
const can_edit_lines = !!(is_owner && order && order.status !== 'archived')
const buy_items = order?.items.filter((i) => i.buy_qty > 0) ?? []
const buy_type_count = buy_items.length
const purchase_list_too_large = buy_type_count > MAX_PURCHASE_TYPES
const short_count = buy_items.filter((i) => i.is_short).length
const show_fitting_actions = !!(
    order
    && (order.status === 'pending_fitting' || order.status === 'purchased')
)
const jita_running = !!(
    poll_check
    || order?.active_jita_check?.status === 'running'
    || order?.active_jita_check?.status === 'pending'
)
const jita_done = order?.active_jita_check?.done_count ?? 0
const jita_total = order?.active_jita_check?.total_count ?? 0
const jita_progress_pct = jita_total > 0
    ? Math.min(100, Math.round((jita_done / jita_total) * 100))
    : 0
const jita_skeleton_rows = Math.min(Math.max(jita_total || buy_type_count || 8, 4), 12)
const poll_url = `${PARTIAL_BASE}&poll=1&check_id=${check_id}`
const hx_attrs = poll_check
    ? {
        'hx-get': poll_url,
        'hx-trigger': 'every 1s',
        'hx-swap': 'outerHTML',
      }
    : {}

const shopping_summary = (() => {
    if (!order || order.items.length === 0)
        return ''
    const types = t('fitting_buy.types_to_buy').replace('{count}', String(buy_type_count))
    if (short_count > 0)
        return `${types} · ${t('fitting_buy.short_count').replace('{count}', String(short_count))}`
    return types
})()

const purchase_list_error = purchase_list_too_large
    ? t('fitting_buy.purchase_list_too_large').replace('{count}', String(buy_type_count))
    : ''

const multibuy_id = order ? `fitting-buy-multibuy-${order.id}` : ''
const quantity_label = t('fitting_buy.quantity')
---

<div id="fitting-buy-order" class="[ fitting-buy-order ]" {...hx_attrs}>
    {error_message && (
        <ComponentBlock>
            <p class="[ text-[var(--fleet-red)] ]">{error_message}</p>
        </ComponentBlock>
    )}

    {order && (
        <Flexblock gap="var(--space-xl)">
            <FlexInline gap="var(--space-s)" class="[ items-center flex-wrap fitting-buy-meta ]">
                <Tag
                    text={fitting_buy_status_label(order.status, t)}
                    color={fitting_buy_status_color(order.status)}
                />
                <small class="[ fitting-buy-meta__text ]">
                    {order.owner_username}
                    {order.jita_checked_at && (
                        <>
                            {' · '}
                            {t('fitting_buy.as_of')}{' '}
                            {format_date_time(lang, order.jita_checked_at)}
                        </>
                    )}
                </small>
                {!is_owner && (
                    <small class="[ text-[var(--highlight)] ]">{t('fitting_buy.read_only')}</small>
                )}
                {is_owner && (
                    <div class="[ fitting-buy-delete ]">
                        <ButtonConfirm
                            label={t('fitting_buy.delete_order')}
                            size="sm"
                            color="transparent"
                        >
                            <form
                                hx-post={PARTIAL_BASE}
                                hx-target="#fitting-buy-order"
                                hx-swap="outerHTML"
                            >
                                <input type="hidden" name="action" value="delete_order" />
                                <Button type="submit" size="sm">
                                    {t('fitting_buy.confirm_delete_order')}
                                </Button>
                            </form>
                        </ButtonConfirm>
                    </div>
                )}
            </FlexInline>

            {!is_owner && order.notes && (
                <p class="[ fitting-buy-notes-ro ]">{order.notes}</p>
            )}

            <ComponentBlock
                class:list={[
                    '[ fitting-buy-section ]',
                    { 'fitting-buy-section--fitting': show_fitting_actions },
                ]}
                heavier={show_fitting_actions}
            >
                <Flexblock gap="var(--space-s)">
                    <h2>{t('fitting_buy.fit_cart')}</h2>

                    {order.lines.length === 0 ? (
                        <p class="[ text-[var(--highlight)] ]">{t('fitting_buy.no_fits')}</p>
                    ) : (
                        <ul class="[ fitting-buy-lines ]">
                            {order.lines.flatMap((line) => {
                                const fit_copies = (line.fit_copies?.length
                                    ? line.fit_copies
                                    : [{
                                        quantity: line.quantity,
                                        eft: line.eft,
                                        is_swapped: line.has_swaps,
                                        variant_type_id: null,
                                        variant_name: '',
                                    }])
                                const show_split_rows = fit_copies.length > 1

                                return fit_copies.map((copy, row_index) => {
                                    // Only label rows when the line is split, or a named variant.
                                    // A lone full-qty row should not say "Swapped fit".
                                    const label = show_split_rows
                                        ? (copy.is_swapped
                                            ? (copy.variant_name || t('fitting_buy.swapped_fit'))
                                            : t('fitting_buy.original_fit'))
                                        : (copy.is_swapped && copy.variant_name
                                            ? copy.variant_name
                                            : null)
                                    return (
                                <li class:list={[{ 'is-swapped-fit': show_split_rows && copy.is_swapped }]}>
                                    <FlexInline
                                        justification="space-between"
                                        class="[ w-full flex-wrap items-center ]"
                                        gap="var(--space-s)"
                                    >
                                        <FlexInline gap="var(--space-2xs)" class="[ items-center min-w-0 ]">
                                            <ItemPicture
                                                item_id={line.ship_id}
                                                item_name={line.fitting_name}
                                                quantity={copy.quantity}
                                                size={32}
                                            />
                                            <div class="[ min-w-0 ]">
                                                <strong class="[ break-words ]">{line.fitting_name}</strong>
                                                <div class="[ fitting-buy-line-meta ]">
                                                    {label && (
                                                        <span class:list={[
                                                            'fitting-buy-fit-kind',
                                                            { 'is-swapped': copy.is_swapped },
                                                        ]}>
                                                            {label}
                                                        </span>
                                                    )}
                                                    {label && ' · '}
                                                    {t('fitting_buy.hulls_qty').replace(
                                                        '{count}',
                                                        String(copy.quantity),
                                                    )}
                                                    {!show_fitting_actions && !show_split_rows && line.max_completable != null && (
                                                        <>
                                                            {' · '}
                                                            <span class:list={[{
                                                                'is-short': line.max_completable < line.quantity,
                                                            }]}>
                                                                {t('fitting_buy.completable')}{' '}
                                                                {line.max_completable}/{line.quantity}
                                                            </span>
                                                        </>
                                                    )}
                                                </div>
                                            </div>
                                        </FlexInline>
                                        <FlexInline gap="var(--space-2xs)" class="[ items-center flex-wrap ]">
                                            {can_edit_lines && row_index === 0 && (
                                                <>
                                                    <form
                                                        class="[ fitting-buy-qty-form ]"
                                                        hx-post={PARTIAL_BASE}
                                                        hx-target="#fitting-buy-order"
                                                        hx-swap="outerHTML"
                                                        hx-trigger="change"
                                                    >
                                                        <input type="hidden" name="action" value="update_line" />
                                                        <input type="hidden" name="fitting_id" value={line.fitting_id} />
                                                        <label class="[ fitting-buy-qty-label ]">
                                                            <span class="[ visually-hidden ]">{quantity_label}</span>
                                                            <input
                                                                type="number"
                                                                name="quantity"
                                                                min="1"
                                                                step="1"
                                                                value={line.quantity}
                                                                class="[ fitting-buy-qty ]"
                                                                aria-label={quantity_label}
                                                            />
                                                        </label>
                                                    </form>
                                                    <form
                                                        hx-post={PARTIAL_BASE}
                                                        hx-target="#fitting-buy-order"
                                                        hx-swap="outerHTML"
                                                    >
                                                        <input type="hidden" name="action" value="remove_line" />
                                                        <input type="hidden" name="line_id" value={line.id} />
                                                        <Button
                                                            type="submit"
                                                            size="sm"
                                                            color="transparent"
                                                        >
                                                            {t('fitting_buy.remove')}
                                                        </Button>
                                                    </form>
                                                </>
                                            )}
                                            {show_fitting_actions && copy.eft && (
                                                <ClipboardButton
                                                    id={`fitting-buy-line-eft-${line.id}-${row_index}`}
                                                    size="sm"
                                                    text={t('fitting_buy.copy_fitting')}
                                                >
                                                    {copy.eft}
                                                </ClipboardButton>
                                            )}
                                        </FlexInline>
                                    </FlexInline>
                                </li>
                                    )
                                })
                            })}
                        </ul>
                    )}
                </Flexblock>
            </ComponentBlock>

            {is_owner && (
                <ComponentBlock class="[ fitting-buy-section ]">
                    <Flexblock gap="var(--space-s)">
                        <Flexblock gap="var(--space-3xs)">
                            <h2>{t('fitting_buy.stock_paste')}</h2>
                            <p class="[ fitting-buy-hint ]">{t('fitting_buy.stock_paste_tip')}</p>
                        </Flexblock>
                        <form
                            hx-post={PARTIAL_BASE}
                            hx-target="#fitting-buy-order"
                            hx-swap="outerHTML"
                        >
                            <input type="hidden" name="action" value="stock" />
                            <Flexblock gap="var(--space-xs)">
                                <textarea
                                    name="stock_paste"
                                    rows="5"
                                    class="[ fitting-buy-textarea ]"
                                    placeholder={t('fitting_buy.stock_placeholder')}
                                    aria-label={t('fitting_buy.stock_paste')}
                                >{order.stock_paste}</textarea>
                                <Button type="submit" size="sm">{t('fitting_buy.apply_stock')}</Button>
                            </Flexblock>
                        </form>
                        {order.unresolved_stock_names.length > 0 && (
                            <p class="[ text-[var(--fleet-red)] text-[var(--step--1)] ]">
                                {t('fitting_buy.unresolved_stock')}: {order.unresolved_stock_names.join(', ')}
                            </p>
                        )}
                    </Flexblock>
                </ComponentBlock>
            )}

            <FittingBuyOrderShopping
                order={order}
                is_owner={is_owner}
                partial_base={PARTIAL_BASE}
                jita_running={jita_running}
                jita_done={jita_done}
                jita_total={jita_total}
                jita_progress_pct={jita_progress_pct}
                jita_skeleton_rows={jita_skeleton_rows}
                shopping_summary={shopping_summary}
                purchase_list_error={purchase_list_error}
                allow_multibuy={!purchase_list_too_large}
                multibuy_id={multibuy_id}
            />

            {order.substitutions.length > 0 && (
                <ComponentBlock class="[ fitting-buy-section ]">
                    <Flexblock gap="var(--space-s)">
                        <Flexblock gap="var(--space-3xs)">
                            <h2>{t('fitting_buy.recommended_swap')}</h2>
                            <p class="[ fitting-buy-hint ]">{t('fitting_buy.swaps_tip')}</p>
                        </Flexblock>
                        <ul class="[ fitting-buy-subs ]">
                            {order.substitutions.map((sub) => {
                                const line = order.lines.find((l) => l.fitting_id === sub.fitting_id)
                                return (
                                    <li>
                                        <FlexInline
                                            justification="space-between"
                                            class="[ w-full flex-wrap items-center ]"
                                            gap="var(--space-s)"
                                        >
                                            <FlexInline gap="var(--space-2xs)" class="[ items-center min-w-0 flex-wrap ]">
                                                <ItemPicture
                                                    item_id={sub.preferred_type_id}
                                                    item_name={sub.preferred_name}
                                                    size={32}
                                                    icon_quality={32}
                                                />
                                                <strong class="[ break-words ]">{sub.preferred_name}</strong>
                                                <span aria-hidden="true">→</span>
                                                <ItemPicture
                                                    item_id={sub.substitute_type_id}
                                                    item_name={sub.substitute_name}
                                                    size={32}
                                                    icon_quality={32}
                                                />
                                                <span class="[ text-[var(--highlight)] break-words ]">{sub.substitute_name}</span>
                                                {sub.notes && (
                                                    <span class="[ fitting-buy-hint ]"> — {sub.notes}</span>
                                                )}
                                            </FlexInline>
                                            {is_owner && line && (
                                                <form
                                                    hx-post={PARTIAL_BASE}
                                                    hx-target="#fitting-buy-order"
                                                    hx-swap="outerHTML"
                                                >
                                                    <input type="hidden" name="action" value="swap" />
                                                    <input type="hidden" name="line_id" value={line.id} />
                                                    <input type="hidden" name="preferred_type_id" value={sub.preferred_type_id} />
                                                    <input type="hidden" name="substitute_type_id" value={sub.substitute_type_id} />
                                                    <input type="hidden" name="notes" value={sub.notes} />
                                                    <Button type="submit" size="sm">{t('fitting_buy.apply_swap')}</Button>
                                                </form>
                                            )}
                                        </FlexInline>
                                    </li>
                                )
                            })}
                        </ul>
                    </Flexblock>
                </ComponentBlock>
            )}

            {is_owner && (
                <ComponentBlock class="[ fitting-buy-section ]">
                    <Flexblock gap="var(--space-s)">
                        <Flexblock gap="var(--space-3xs)">
                            <h2>{t('fitting_buy.landed_prices')}</h2>
                            <p class="[ fitting-buy-hint ]">{t('fitting_buy.landed_prices_tip')}</p>
                        </Flexblock>
                        <form
                            hx-post={PARTIAL_BASE}
                            hx-target="#fitting-buy-order"
                            hx-swap="outerHTML"
                        >
                            <input type="hidden" name="action" value="landed_prices" />
                            <Flexblock gap="var(--space-xs)">
                                <textarea
                                    name="paste"
                                    rows="4"
                                    class="[ fitting-buy-textarea ]"
                                    placeholder={t('fitting_buy.landed_placeholder')}
                                    aria-label={t('fitting_buy.landed_prices')}
                                ></textarea>
                                <Button type="submit" size="sm">{t('fitting_buy.apply_prices')}</Button>
                            </Flexblock>
                        </form>
                    </Flexblock>
                </ComponentBlock>
            )}
        </Flexblock>
    )}
</div>

<style lang="scss">
    .fitting-buy-order {
        min-width: 0;
        max-width: 100%;

        h2 {
            margin: 0;
            font-size: var(--step-1);
        }

        h3 {
            margin: 0;
            font-size: var(--step-0);
        }
    }

    .fitting-buy-meta__text,
    .fitting-buy-hint,
    .fitting-buy-line-meta {
        color: var(--highlight);
        font-size: var(--step--1);
    }

    .fitting-buy-line-meta .is-short {
        color: var(--fleet-red);
    }

    .fitting-buy-fit-kind {
        color: var(--foreground);

        &.is-swapped {
            color: var(--fleet-yellow);
        }
    }

    .fitting-buy-lines li.is-swapped-fit {
        border-left: 2px solid var(--fleet-yellow);
        padding-left: var(--space-2xs);
        margin-left: calc(var(--space-2xs) * -1);
    }

    .fitting-buy-notes-ro {
        margin: 0;
        font-size: var(--step--1);
        color: var(--foreground);
        max-width: var(--max-text-width);
    }

    .fitting-buy-textarea {
        width: 100%;
        background: transparent;
        color: var(--foreground);
        border: 1px solid var(--border-color);
        padding: var(--space-2xs);
        font-family: var(--default-font);
        font-size: var(--step--1);
        resize: vertical;
    }

    .fitting-buy-lines,
    .fitting-buy-subs {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .fitting-buy-lines li,
    .fitting-buy-subs li {
        padding-block: var(--space-2xs);
        border-bottom: 1px solid var(--border-color);

        &:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        &:first-child {
            padding-top: 0;
        }
    }

    .fitting-buy-delete {
        margin-inline-start: auto;
    }

    .fitting-buy-qty-form {
        display: inline-flex;
        align-items: center;
    }

    .fitting-buy-qty-label {
        display: inline-flex;
    }

    .fitting-buy-qty {
        width: 4.5rem;
        background: transparent;
        color: var(--foreground);
        border: 1px solid var(--border-color);
        padding: var(--space-3xs) var(--space-2xs);
        font-family: var(--default-font);
