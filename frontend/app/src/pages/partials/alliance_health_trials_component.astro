---
import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

import { HTTP_200_Success, HTTP_400_Bad_Request, HTTP_403_Forbidden } from '@helpers/http_responses'

import type { User } from '@dtypes/jwt'
import * as jose from 'jose'

const auth_token = Astro.cookies.has('auth_token')
    ? (Astro.cookies.get('auth_token')?.value as string)
    : null
const user = auth_token ? (jose.decodeJwt(auth_token) as User) : false

if (!user) return HTTP_403_Forbidden()

import {
    get_alliance_health_trials,
    post_alliance_health_status,
} from '@helpers/api.minmatar.org/alliance_health'
import type {
    AllianceHealthTrialBucket,
    AllianceHealthTrialPilot,
} from '@dtypes/api.minmatar.org'
import AllianceHealthTrialsTable from '@components/blocks/AllianceHealthTrialsTable.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'

const user_id = parseInt(Astro.url.searchParams.get('user_id') ?? '', 10)
const action = Astro.url.searchParams.get('action')
const raw_bucket = Astro.url.searchParams.get('bucket') ?? 'current'
const bucket: AllianceHealthTrialBucket =
    raw_bucket === 'passing' ||
    raw_bucket === 'failing' ||
    raw_bucket === 'evaluating' ||
    raw_bucket === 'add' ||
    raw_bucket === 'remove' ||
    raw_bucket === 'flagged' ||
    raw_bucket === 'current' ||
    raw_bucket === 'approve' ||
    raw_bucket === 'too_early' ||
    raw_bucket === 'fail' ||
    raw_bucket === 'nudge'
        ? raw_bucket
        : 'current'

const initial_corp = Astro.url.searchParams.get('corp') || 'all'
const can_mutate = Astro.url.searchParams.get('can_mutate') === '1'
const alliance_wide = Astro.url.searchParams.get('alliance_wide') === '1'
const officer_corp_ids = (Astro.url.searchParams.get('officer_corps') ?? '')
    .split(',')
    .map((value) => parseInt(value, 10))
    .filter((value) => !Number.isNaN(value) && value > 0)

let pilots: AllianceHealthTrialPilot[] = []
let corp_options: string[] = []
let data_fetching_error: any

if (Astro.request.method === 'POST' && action === 'promote' && user_id) {
    try {
        await post_alliance_health_status(auth_token as string, user_id, 'promote')
        return HTTP_200_Success()
    } catch (error) {
        if (error?.cause === 403) return HTTP_403_Forbidden()
        return HTTP_400_Bad_Request()
    }
}

try {
    const trials = await get_alliance_health_trials(auth_token as string, bucket)
    pilots = trials.pilots
    corp_options = Object.keys(trials.counts_by_corp ?? {}).filter(
        (name) => name && name !== 'all' && name !== '—',
    )
} catch (error) {
    data_fetching_error = error
}

const PARTIAL_URL = translatePath('/partials/alliance_health_trials_component')
---

{
    data_fetching_error ? (
        <ErrorRefetch
            args={{
                partial: `${PARTIAL_URL}?bucket=${bucket}`,
                error: data_fetching_error,
                delay: 0,
            }}
        />
    ) : (
        <AllianceHealthTrialsTable
            pilots={pilots}
            can_promote={can_mutate}
            officer_corp_ids={officer_corp_ids}
            alliance_wide={alliance_wide}
            initial_corp={initial_corp}
            corp_options={corp_options}
            bucket={bucket}
            partial_url={PARTIAL_URL}
        />
    )
}
