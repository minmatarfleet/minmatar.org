---
/**
 * LP desk settings (pages/industry/loyalty/settings.astro).
 *
 * part=list          view chips + the corporations table (GET); POST action=add_currency adds one
 * part=row&id=       an open row's detail (GET); POST saves the rates and answers with the row
 * part=switch&id=    the "Desk open" switch (POST): nothing to swap
 * part=account_form  an account's form under the tiles (GET, &account= or new)
 * part=account&id=   an account save (POST): the accounts block + the row's count out of band
 * part=history&id=   the corp's recent price changes (GET)
 */
import { i18n, t_key } from '@helpers/i18n'
import { get_request_user } from '@helpers/request_user'
import { HTTP_403_Forbidden } from '@helpers/http_responses'
import { get_gates, can } from '@helpers/gates'
const { t, translatePath } = i18n(Astro.url)

import type { LoyaltyDeskCorp, LoyaltyPriceChange } from '@helpers/market_settings'
import {
    add_loyalty_account,
    add_loyalty_contact,
    add_loyalty_currency,
    delete_loyalty_contact,
    get_loyalty_currency_history,
    get_loyalty_settings,
    patch_loyalty_account,
    patch_loyalty_contact,
    patch_loyalty_currency,
} from '@helpers/api.minmatar.org/loyalty_settings'
import { error_text, form_flag, form_int, form_text } from '@helpers/manage_forms'
import { loyalty_active_accounts, loyalty_in_view } from '@helpers/market_settings'
import { query_string } from '@helpers/string'

import EmptyState from '@components/blocks/EmptyState.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import ViewChips from '@components/blocks/manage/ViewChips.astro'
import ManageTable from '@components/blocks/manage/ManageTable.astro'
import LpDeskRow from '@components/blocks/market_settings/LpDeskRow.astro'
import LpDeskDetail from '@components/blocks/market_settings/LpDeskDetail.astro'
import LpDeskAccounts from '@components/blocks/market_settings/LpDeskAccounts.astro'
import LpAccountForm from '@components/blocks/market_settings/LpAccountForm.astro'

const { auth_token } = get_request_user(Astro)
if (!auth_token) return HTTP_403_Forbidden()
if (!can(await get_gates(Astro), 'industry.loyalty.settings')) return HTTP_403_Forbidden()

const params = Astro.url.searchParams
const part = params.get('part') ?? 'list'
const id = parseInt(params.get('id') ?? '') || 0
const is_post = Astro.request.method === 'POST'
const form = is_post ? await Astro.request.formData() : new FormData()
const partial_url = (values: Record<string, string>) => translatePath(`/partials/loyalty_settings_component/?${query_string(values)}`)
const failed = t('manage.kit.confirm_failed')

const optional_int = (name: string) => form_text(form, name) === '' ? null : form_int(form, name)

let saved = false
let error: string | undefined

// Writes. A failed add from the dialog answers 400 so the dialog shows it.
if (is_post) {
    try {
        if (part === 'list' && form_text(form, 'action') === 'add_currency') {
            const corporation_id = form_int(form, 'corporation_id')
            if (!corporation_id)
                return new Response(t('manage.lp.pick_corporation'), { status: 400 })
            await add_loyalty_currency(auth_token, {
                name: form_text(form, 'name'),
                corporation_id,
                default_isk_per_lp: form_int(form, 'default_isk_per_lp') ?? 800,
                express_isk_per_lp: optional_int('express_isk_per_lp'),
            })
        } else if (part === 'switch' && id) {
            await patch_loyalty_currency(auth_token, id, { is_active: form_flag(form, 'is_active') })
            return new Response(null, { status: 204 })
        } else if (part === 'row' && id) {
            const express = optional_int('express_isk_per_lp')
            await patch_loyalty_currency(auth_token, id, {
                default_isk_per_lp: form_int(form, 'default_isk_per_lp') ?? undefined,
                express_isk_per_lp: express,
                clear_express: express === null,
                allow_buy: form_flag(form, 'allow_buy'),
                allow_sell: form_flag(form, 'allow_sell'),
            })
            saved = true
        } else if (part === 'account' && id) {
            await save_account(id)
            saved = true
        }
    } catch (caught) {
        if (part === 'list')
            return new Response(error_text(caught, failed), { status: 400 })
        if (part === 'switch')
            return new Response(error_text(caught, failed), { status: 400 })
        error = error_text(caught, failed)
    }
}

async function save_account(corp_id: number) {
    const price = optional_int('isk_per_lp')
    let account_id = form_int(form, 'account_id')
    if (form_text(form, 'action') === 'add_account') {
        const created = await add_loyalty_account(auth_token as string, {
            loyalty_point_id: corp_id,
            name: form_text(form, 'name'),
            role: form_text(form, 'role') || 'seller',
            isk_per_lp: price,
        })
        account_id = created.id
    } else if (account_id) {
        await patch_loyalty_account(auth_token as string, account_id, {
            name: form_text(form, 'name'),
            role: form_text(form, 'role'),
            isk_per_lp: price,
            clear_isk_per_lp: price === null,
            is_active: form_flag(form, 'is_active'),
        })
    }
    if (!account_id)
        return
    for (const contact_id of form.getAll('contact_ids').map((value) => parseInt(String(value))).filter(Boolean)) {
        const prefix = `contact_${contact_id}_`
        if (form_flag(form, `${prefix}remove`)) {
            await delete_loyalty_contact(auth_token as string, contact_id)
            continue
        }
        await patch_loyalty_contact(auth_token as string, contact_id, {
            character_name: form_text(form, `${prefix}name`),
            discord_username: form_text(form, `${prefix}discord`),
            is_active: form_flag(form, `${prefix}active`),
        })
    }
    const new_contact = form_text(form, 'new_contact_name')
    if (new_contact)
        await add_loyalty_contact(auth_token as string, {
            account_id,
            character_name: new_contact,
            discord_username: form_text(form, 'new_contact_discord'),
        })
}

// Reads.
let corps: LoyaltyDeskCorp[] = []
let history: LoyaltyPriceChange[] = []
let fetching_error: Error | false = false
try {
    if (part === 'history')
        history = (await get_loyalty_currency_history(auth_token, id)) ?? []
    else
        corps = ((await get_loyalty_settings(auth_token)) ?? []) as LoyaltyDeskCorp[]
} catch (caught) {
    fetching_error = caught as Error
}

const corp = corps.find((candidate) => candidate.id === id) ?? null
const view = params.get('view') ?? form_text(form, 'view') ?? 'all'
const selected_view = ['all', 'express', 'no_accounts'].includes(view) ? view : 'all'
const rows = corps.filter((candidate) => loyalty_in_view(selected_view, candidate))
const columns = [
    { label: t('manage.lp.col_corporation') },
    { label: t('manage.lp.standard'), align: 'num' as const, phone: false },
    { label: t('manage.lp.express'), align: 'num' as const, phone: false },
    { label: t('manage.lp.accounts'), align: 'num' as const, phone: false },
    { label: t('manage.lp.desk_open'), align: 'act' as const },
]
const account_form = params.get('account')
// The chips' counts change after a save, so saves send them back out of band.
const chips = {
    id: 'lp-filters',
    url: partial_url({ part: 'list' }),
    target: 'lp-list',
    selected: selected_view,
    legend: t('manage.lp.views'),
    views: [
        { value: 'all', label: t('manage.lp.view_all'), count: corps.length },
        { value: 'express', label: t('manage.lp.view_express'), count: corps.filter((c) => loyalty_in_view('express', c)).length },
    ],
    attention: [
        { value: 'no_accounts', label: t('manage.lp.view_no_accounts'), count: corps.filter((c) => loyalty_active_accounts(c) === 0).length, tone: 'warn' as const },
    ],
}
const tier_label = (change: LoyaltyPriceChange) => change.account_name
    ? t('manage.lp.tier_account').replace('~NAME', change.account_name)
    : t(t_key('manage.lp.tier_', change.tier === 'express' ? 'express' : 'standard'))
const eve_time = (iso: string) => `${iso.slice(0, 16).replace('T', ' ')} ${t('manage.kit.eve')}`
const price = (value: number | null) => value === null ? t('manage.lp.off') : String(value)
---

{fetching_error !== false
    ? <ErrorRefetch args={{ partial: partial_url({ part, id: String(id) }), error: fetching_error, delay: parseInt(params.get('delay') ?? '0') }} />
    : part === 'list'
        ? (
            <div id="lp-list-root" class="[ manage-list ]">
                <ViewChips {...chips} />
                <div id="lp-list" class="[ manage-list ]" aria-live="polite">
                    {rows.length === 0
                        ? <EmptyState title={corps.length === 0 ? t('industry.loyalty.settings.empty') : t('manage.lp.none_in_view')} />
                        : (
                            <ManageTable caption={t('manage.lp.caption')} columns={columns}>
                                {rows.map((row) => <LpDeskRow corp={row} />)}
                            </ManageTable>
                        )
                    }
                </div>
            </div>
        )
    : part === 'row' && corp
        ? (is_post
            // The row goes back inside a <table>; the request picks it with hx-select.
            ? <Fragment><table><LpDeskRow corp={corp} open={true} detail={{ saved, error }} /></table><ViewChips {...chips} hx-swap-oob="true" /></Fragment>
            : <LpDeskDetail corp={corp} />)
    : part === 'account_form' && corp
        ? <LpAccountForm corp_id={corp.id} account={account_form ? corp.accounts.find((a) => a.id === parseInt(account_form)) ?? null : null} />
    : part === 'account' && corp
        ? (
            <Fragment>
                <LpDeskAccounts
                    corp={corp}
                    saved={saved}
                    error={error}
                    oob_count={true}
                    form={error ? (form_int(form, 'account_id') ?? 'new') : null}
                />
                <ViewChips {...chips} hx-swap-oob="true" />
            </Fragment>
        )
    : part === 'history'
        ? (history.length === 0
            ? <p class="[ manage-muted ]">{t('manage.lp.no_history')}</p>
            : (
                <ul class="[ market-history market-note ]" role="list">
                    {history.map((change) => (
                        <li>
                            {`${eve_time(change.changed_at)} · `}<b>{change.changed_by ?? t('manage.lp.someone')}</b>{` · ${tier_label(change)} ${price(change.old_isk_per_lp)} → `}<b>{price(change.new_isk_per_lp)}</b>
                        </li>
                    ))}
                </ul>
            ))
        : <EmptyState title={t('manage.lp.not_found')} />
}
