---
import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

import type { LoyaltyCurrency, LoyaltyMarketOrdersList } from '@dtypes/api.minmatar.org'
import {
    get_loyalty_currencies,
    get_loyalty_orders,
} from '@helpers/api.minmatar.org/loyalty'
import {
    loyalty_history_partial_params,
    loyalty_history_query,
    parse_loyalty_history_params,
} from '@helpers/loyalty_order_history'
import { query_string } from '@helpers/string'

const params = Astro.url.searchParams
const filters = parse_loyalty_history_params(params)
const delay = parseInt(params.get('delay') ?? '0')

const partial_qs = query_string(loyalty_history_partial_params(filters))
const partial_url = `${translatePath('/partials/loyalty_order_history_component')}${partial_qs ? `?${partial_qs}` : ''}`

let history: LoyaltyMarketOrdersList = { items: [], total: 0, limit: null, offset: 0 }
let currencies: LoyaltyCurrency[] = []
let fetching_error: Error | false = false

try {
    ;[history, currencies] = await Promise.all([
        get_loyalty_orders(loyalty_history_query(filters)),
        get_loyalty_currencies(),
    ])
} catch (error) {
    fetching_error = error as Error
}

import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import LoyaltyOrderHistory from '@components/blocks/LoyaltyOrderHistory.astro'
---

{fetching_error !== false ? (
    <section id="loyalty-order-history">
        <ErrorRefetch
            args={{
                partial: partial_url,
                error: fetching_error,
                delay: delay,
                target: '#loyalty-order-history',
            }}
        />
    </section>
) : (
    <LoyaltyOrderHistory
        orders={history.items}
        currencies={currencies}
        total={history.total}
        filters={filters}
    />
)}
