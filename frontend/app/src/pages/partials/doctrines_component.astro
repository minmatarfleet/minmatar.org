---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { DoctrineType, DoctrineLocationUI } from '@dtypes/layout_components'
import { fetch_doctrines } from '@helpers/fetching/doctrines'
import { get_locations_by_ids } from '@helpers/api.minmatar.org/locations'
import type { Location } from '@dtypes/api.minmatar.org'
import { get_request_user } from '@helpers/request_user'
import { get_stagings } from '@helpers/api.minmatar.org/stagings'
import { doctrine_tabs, doctrines_at } from '@helpers/doctrine_tabs'

let doctrines:DoctrineType[] = []
let fetch_doctrines_error: Error | false = false
let all_locations:Location[] = []
let location_doctrine_counts_map: Map<number, number> = new Map()
let all_locations_ui: DoctrineLocationUI[] = []

const AMAMAKE_LOCATION_ID = 1022167642188
const active_location_id = parseInt(Astro.url.searchParams.get('location_id') ?? String(AMAMAKE_LOCATION_ID))

// `?tab=home|deployed` is a panel of the deployment doctrine tabs: the
// doctrines staged at that tab's locations, without the location reel.
const requested_tab = Astro.url.searchParams.get('tab')
const { auth_token } = get_request_user(Astro)
const doctrine_tab = doctrine_tabs(await get_stagings(auth_token)).find((tab) => tab.id === requested_tab)

try {
    doctrines = await fetch_doctrines()

    doctrines.forEach(doctrine => {
        if (doctrine.location_ids && doctrine.location_ids.length > 0) {
            doctrine.location_ids.forEach(location_id => {
                location_doctrine_counts_map.set(location_id, (location_doctrine_counts_map.get(location_id) || 0) + 1)
            })
        }
    })

    const all_location_ids = Array.from(location_doctrine_counts_map.keys())

    if (all_location_ids.length > 0) {
        try {
            const fetched_locations = await get_locations_by_ids(all_location_ids)
            all_locations = fetched_locations
                .filter(loc => 
                    location_doctrine_counts_map.has(loc.location_id) && 
                    loc.short_name && 
                    loc.short_name.trim() !== ''
                )
                .sort((a, b) => a.location_name.localeCompare(b.location_name))
        } catch (error) {
            console.error('Error fetching locations:', error)
        }
    }

    all_locations_ui = all_locations.map(locaction => {
        const location_doctrines = doctrines.filter(doctrine => 
            doctrine.location_ids && doctrine.location_ids.includes(locaction.location_id)
        )

        return {
            id: locaction.location_id,
            name: locaction.short_name,
            doctrine_count: location_doctrine_counts_map.get(locaction.location_id) || 0,
            doctrines: location_doctrines
        } as DoctrineLocationUI
    })

} catch (error) {
    fetch_doctrines_error = error
}

const tab_location_ui: DoctrineLocationUI | undefined = doctrine_tab && {
    id: doctrine_tab.location_ids[0],
    name: doctrine_tab.names.join(', '),
    doctrine_count: doctrines_at(doctrines, doctrine_tab.location_ids).length,
    doctrines: doctrines_at(doctrines, doctrine_tab.location_ids),
}

const active_doctrine_location_ui = tab_location_ui ?? all_locations_ui.find(location => location.id === active_location_id)

const non_active_doctrine_location_ui = tab_location_ui ? [] : all_locations_ui.filter(location => location.id !== active_location_id)

const DOCTRINES_PARTIAL_URL = translatePath(`/partials/doctrines_component${doctrine_tab ? `?tab=${doctrine_tab.id}` : active_location_id > 0 ? `?location_id=${active_location_id}` : ''}`)

import DoctrinesList from '@components/blocks/DoctrinesList.astro';
import EmptyState from '@components/blocks/EmptyState.astro';
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro';
---

{fetch_doctrines_error ?
    <ErrorRefetch
        args={{
            partial: DOCTRINES_PARTIAL_URL,
            error: fetch_doctrines_error,
            delay: 0,
        }}
    />
    :
    tab_location_ui && tab_location_ui.doctrines.length === 0 ?
        <EmptyState title={t('doctrines.tab.empty')} />
    :
    active_doctrine_location_ui !== undefined &&
        <DoctrinesList
            active_doctrine_location_ui={active_doctrine_location_ui}
            non_active_doctrine_location_ui={non_active_doctrine_location_ui}
        />
}
