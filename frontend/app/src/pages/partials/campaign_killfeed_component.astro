---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden } from '@helpers/http_responses'

import { get_request_user } from '@helpers/request_user'

const { auth_token, user } = get_request_user(Astro)

if (!user)
    return HTTP_403_Forbidden()

import { get_gates, can } from '@helpers/gates'
const gates = await get_gates(Astro)

const can_view_campaigns = can(gates, 'campaigns.view')

if (!can_view_campaigns)
    return HTTP_403_Forbidden()

import type { CampaignKillmail, CampaignKillmailOutcome, CampaignSystemSummary } from '@dtypes/api.minmatar.org'
import { get_campaign_killmails, get_campaign_systems } from '@helpers/api.minmatar.org/campaigns'
import { ACTIVITY_PAGE_SIZE, paginate } from '@helpers/fetching/campaigns'

const slug = Astro.url.searchParams.get('slug') as string
const outcome = (Astro.url.searchParams.get('outcome') ?? '') as CampaignKillmailOutcome | ''
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') ?? '1') || 1)
const delay = parseInt(Astro.url.searchParams.get('delay') ?? '0')

let fetch_killfeed_error:Error | false = false
let killmails:CampaignKillmail[] = []
let has_more = false
let systems:CampaignSystemSummary[] = []

try {
    const fetched = await get_campaign_killmails(slug, auth_token as string, outcome, ACTIVITY_PAGE_SIZE + 1, (page - 1) * ACTIVITY_PAGE_SIZE)
    ;({ rows: killmails, has_more } = paginate(fetched))
    systems = await get_campaign_systems(slug, auth_token as string)
} catch (error) {
    fetch_killfeed_error = error
}

const KILLFEED_PARTIAL_URL = translatePath(`/partials/campaign_killfeed_component?slug=${slug}&outcome=${outcome}&page=${page}`)

import CampaignKillfeed from '@components/blocks/CampaignKillfeed.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
---

{fetch_killfeed_error ?
    <ErrorRefetch
        args={{
            partial: KILLFEED_PARTIAL_URL,
            error: fetch_killfeed_error,
            delay: delay,
            target: '#campaign-killfeed',
        }}
    />
    :
    <CampaignKillfeed slug={slug} killmails={killmails} outcome={outcome} systems={systems} page={page} has_more={has_more} />
}
