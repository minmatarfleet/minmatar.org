---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden } from '@helpers/http_responses'

import type { User } from '@dtypes/jwt'
import * as jose from 'jose'

const auth_token = Astro.cookies.has('auth_token') ? (Astro.cookies.get('auth_token')?.value as string) : false
const user:User | false = auth_token ? jose.decodeJwt(auth_token) as User : false
const is_superuser = (user ? user?.is_superuser : false)

if (!user)
    return HTTP_403_Forbidden()

import { get_user_permissions } from '@helpers/permissions'
const user_permissions = (user ? await get_user_permissions(user?.username) : [])

const can_view_campaigns = is_superuser || user_permissions.includes('campaigns.view_campaign')

if (!can_view_campaigns)
    return HTTP_403_Forbidden()

import type { CampaignKillmail, CampaignKillmailOutcome, CampaignSystemSummary } from '@dtypes/api.minmatar.org'
import { get_campaign_killmails, get_campaign_systems } from '@helpers/api.minmatar.org/campaigns'

const slug = Astro.url.searchParams.get('slug') as string
const outcome = (Astro.url.searchParams.get('outcome') ?? '') as CampaignKillmailOutcome | ''
const delay = parseInt(Astro.url.searchParams.get('delay') ?? '0')

let fetch_killfeed_error:Error | false = false
let killmails:CampaignKillmail[] = []
let systems:CampaignSystemSummary[] = []

try {
    killmails = await get_campaign_killmails(slug, auth_token as string, outcome, 25)
    systems = await get_campaign_systems(slug, auth_token as string)
} catch (error) {
    fetch_killfeed_error = error
}

const KILLFEED_PARTIAL_URL = translatePath(`/partials/campaign_killfeed_component?slug=${slug}&outcome=${outcome}`)

import CampaignKillfeed from '@components/blocks/CampaignKillfeed.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
---

{fetch_killfeed_error ?
    <ErrorRefetch
        args={{
            partial: KILLFEED_PARTIAL_URL,
            error: fetch_killfeed_error,
            delay: delay,
            target: '#campaign-killfeed',
        }}
    />
    :
    <CampaignKillfeed slug={slug} killmails={killmails} outcome={outcome} systems={systems} />
}
