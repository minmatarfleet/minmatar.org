---
// no-error-refetch: mutation toggle; a failed save shows inline beside the checkbox.
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import { HTTP_403_Forbidden, HTTP_404_Not_Found } from '@helpers/http_responses'

import { get_request_user } from '@helpers/request_user'

const { auth_token, user } = get_request_user(Astro)

if (!user)
    return HTTP_403_Forbidden()

if (Astro.request.method !== 'POST')
    return HTTP_404_Not_Found()

const fleet_id = parseInt(Astro.url.searchParams.get('fleet_id') ?? '0')

if (!fleet_id)
    return HTTP_404_Not_Found()

import { update_fleet } from '@helpers/api.minmatar.org/fleets'

const data = await Astro.request.formData()
const hide_volunteers = data.get('hide_volunteers') === 'on'

// The backend checks the caller manages this fleet and refreshes the MOTD.
let saved = false
try {
    saved = Boolean(await update_fleet(auth_token as string, { hide_volunteers }, fleet_id))
} catch (error) {
    console.log(`Saving hide names failed: ${error.message}`)
}
---

{saved ?
    <small class="[ text-green ]">{t('fleets.command.saved')}</small> :
    <small role="alert">{t('fleets.command.save_failed')}</small>
}
