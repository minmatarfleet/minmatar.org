---
import { i18n } from '@helpers/i18n'
import { get_request_user } from '@helpers/request_user'
const { t, translatePath } = i18n(Astro.url)

const { auth_token } = get_request_user(Astro)

const product_id = parseInt(Astro.url.searchParams.get('product_id') ?? '0')
const attempt = parseInt(Astro.url.searchParams.get('attempt') ?? '0')
const delay = parseInt(Astro.url.searchParams.get('delay') ?? '5')
// The product page's Overview and Build tabs read the same cached insights.
const view = Astro.url.searchParams.get('view') === 'build' ? 'build' : 'overview'

import type { ProductInsights } from '@dtypes/api.minmatar.org'
import { get_product_insights } from '@helpers/api.minmatar.org/industry'
import { query_string } from '@helpers/string'

// The rollup runs in the background on a cold cache; poll a few times.
const MAX_ATTEMPTS = 12
const POLL_SECONDS = 5

let insights: ProductInsights | null = null
let fetch_error: Error | false = false

try {
    if (isNaN(product_id) || product_id <= 0)
        throw new Error(t('invalid_product_id'), { cause: 400 })

    if (auth_token)
        insights = await get_product_insights(auth_token, product_id)
} catch (error) {
    fetch_error = error
}

// Only products with a blueprint have a Build tab to link to.
const has_build = Astro.url.searchParams.get('build') === '1'

const PARTIAL_URL = `${translatePath('/partials/product_insights_component')}?${query_string({
    product_id,
    view,
    ...(has_build ? { build: 1 } : {}),
})}`
const BUILD_PATH = has_build ? translatePath(`/industry/products/${product_id}/build/`) : null
const POLL_URL = `${PARTIAL_URL}&attempt=${attempt + 1}`

import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import ProductBuildQueue from '@components/blocks/ProductBuildQueue.astro'
import ProductInsightsPanel from '@components/blocks/ProductInsightsPanel.astro'
---

{!auth_token ?
    <FlexInline>
        <p class="[ text-[var(--foreground)] ]">{t('industry.product.login_for_insights')}</p>
    </FlexInline>
    : fetch_error ?
    <ErrorRefetch
        args={{
            partial: PARTIAL_URL,
            error: fetch_error,
            delay: delay,
        }}
    />
    : insights && insights.ready ?
        view === 'build' ?
        <ProductBuildQueue insights={insights} />
        :
        <ProductInsightsPanel insights={insights} build_path={BUILD_PATH} />
    : attempt < MAX_ATTEMPTS ?
    <FlexInline
        hx-get={POLL_URL}
        hx-trigger={`load delay:${POLL_SECONDS}s`}
        hx-swap="outerHTML"
    >
        <p class="[ loading text-[var(--foreground)] ]">{t('industry.product.computing')}</p>
    </FlexInline>
    :
    <FlexInline>
        <p class="[ text-[var(--foreground)] ]">{t('industry.product.computing_slow')}</p>
    </FlexInline>
}
