---
/** Report a moon: posts the survey paste, then shows what it found. */
// no-error-refetch: a form; errors show inside the dialog.
import { get_request_user } from '@helpers/request_user'
import { HTTP_403_Forbidden } from '@helpers/http_responses'
import { report_universe_moons } from '@helpers/api.minmatar.org/universe'
import type { UniverseMoonReport as Result } from '@dtypes/api.minmatar.org'
import UniverseMoonReport from '@components/blocks/universe/UniverseMoonReport.astro'

const { auth_token } = get_request_user(Astro)
if (!auth_token || Astro.request.method !== 'POST') return HTTP_403_Forbidden()

const form = await Astro.request.formData()
const paste = String(form.get('paste') ?? '').trim()
let result: Result | null = null
let error: string | null = null
try {
    result = await report_universe_moons(auth_token, paste)
} catch (failure) {
    error = (failure as Error).message
}
---

<UniverseMoonReport result={result} error={error} paste={paste} />
