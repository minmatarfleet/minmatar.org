---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import { HTTP_400_Bad_Request, HTTP_403_Forbidden } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'
import { get_gates, can } from '@helpers/gates'

// no-error-refetch: a correction; a failed save shows in the panel it swaps back.
// POST edits or deletes a timer and answers with the timers panel;
// GET ?view=pings answers with the ping log (?failed_only=true filters it).
const { auth_token } = get_request_user(Astro)
if (!auth_token) return HTTP_403_Forbidden()

const gates = await get_gates(Astro)
if (!can(gates, 'structures.timers.correct')) return HTTP_403_Forbidden()

import type { StructurePing, StructureTimer, StructureTimerPatch } from '@dtypes/api.minmatar.org'
import { delete_structure_timer, get_structure_pings, get_structure_timers, update_structure_timer } from '@helpers/api.minmatar.org/structures'

import StructurePingsPanel from '@components/blocks/StructurePingsPanel.astro'
import StructureTimersManager from '@components/blocks/StructureTimersManager.astro'

const is_post = Astro.request.method === 'POST'
const show_pings = !is_post && Astro.url.searchParams.get('view') === 'pings'
const failed_only = Astro.url.searchParams.get('failed_only') === 'true'

let error: string | null = null
let notice: string | null = null
let timers: StructureTimer[] = []
let pings: StructurePing[] = []

try {
    if (is_post) {
        const form = await Astro.request.formData()
        const text = (key: string) => ((form.get(key) as string | null) ?? '').trim()
        const timer_id = parseInt(text('timer_id'))
        if (!timer_id) return HTTP_400_Bad_Request()

        if (text('action') === 'update') {
            const changes: StructureTimerPatch = {
                name: text('name'),
                system_name: text('system_name'),
                corporation_name: text('corporation_name'),
                alliance_name: text('alliance_name'),
                state: text('state') as StructureTimerPatch['state'],
                type: text('type') as StructureTimerPatch['type'],
                // the form's datetime-local value is EVE time
                timer: `${text('timer')}:00Z`,
            }
            await update_structure_timer(auth_token, timer_id, changes)
            notice = t('structure_timers_manage.saved')
        } else if (text('action') === 'delete') {
            if (!(await delete_structure_timer(auth_token, timer_id)))
                error = t('structure_timers_manage.delete_failed')
            else
                notice = t('structure_timers_manage.deleted')
        } else {
            return HTTP_400_Bad_Request()
        }
    }
} catch (failure) {
    if ((failure as Error).cause === 403) return HTTP_403_Forbidden()
    error = (failure as Error).message
}

try {
    if (show_pings)
        pings = await get_structure_pings(auth_token, failed_only)
    else
        timers = await get_structure_timers(auth_token, false)
} catch (failure) {
    if ((failure as Error).cause === 403) return HTTP_403_Forbidden()
    error = error ?? (failure as Error).message
}

if (!show_pings) {
    // newest first, as the manage page lists them
    timers = [...timers].sort((a, b) => new Date(b.timer).getTime() - new Date(a.timer).getTime()).slice(0, 100)
}
---

{show_pings ?
    <StructurePingsPanel pings={pings} failed_only={failed_only} error={error} />
    :
    <StructureTimersManager timers={timers} error={error} notice={notice} />
}
