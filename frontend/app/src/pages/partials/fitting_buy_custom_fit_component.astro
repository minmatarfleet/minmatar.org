---
import { get_type_icon } from '@helpers/eve_image'
export const partial = true

import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import { get_request_user } from '@helpers/request_user'
import { HTTP_400_Bad_Request, HTTP_403_Forbidden } from '@helpers/http_responses'

// no-error-refetch: a check that fails shows its message under the paste box; nothing is saved.
// POST checks the pasted EFT fit on the create-order page: the ship and fit it names, or the
// items the site doesn't know.
const { auth_token } = get_request_user(Astro)
if (!auth_token) return HTTP_403_Forbidden()

if (Astro.request.method !== 'POST') return HTTP_400_Bad_Request()

import type { FittingBuyCustomFitCheck } from '@dtypes/api.minmatar.org'
import { check_fitting_buy_custom_fit } from '@helpers/api.minmatar.org/fitting_buy_orders'

import FlexInline from '@components/compositions/FlexInline.astro'

const form = await Astro.request.formData()
const eft = String(form.get('custom_eft') ?? '')

let check: FittingBuyCustomFitCheck | null = null
let error: string | null = null

if (eft.trim()) {
    try {
        check = await check_fitting_buy_custom_fit(auth_token, eft)
    } catch (e) {
        error = (e as Error).message
    }
}

const unknown = check?.unknown_names ?? []
---

<div class="[ custom-fit-check ]" aria-live="polite">
    {check?.ok && check.ship_id && (
        <FlexInline gap="var(--space-2xs)" class="[ items-center min-w-0 ]">
            <img
                class="[ custom-fit-check__icon ]"
                src={get_type_icon(check.ship_id, 32)}
                alt={check.ship_name}
                width="32"
                height="32"
            />
            <span class="[ truncate ]">{check.fit_name}</span>
            <span class="[ custom-fit-check__muted ]">
                {t('fitting_buy.paste_fit_items').replace('{count}', String(check.item_count))}
            </span>
        </FlexInline>
    )}
    {check && !check.ok && unknown.length > 0 && (
        <div role="alert">
            <p class="[ custom-fit-check__error ]">{t('fitting_buy.paste_fit_unknown')}</p>
            <ul class="[ custom-fit-check__unknown ]">
                {unknown.map((name) => <li>{name}</li>)}
            </ul>
        </div>
    )}
    {check && !check.ok && unknown.length === 0 && (
        <p class="[ custom-fit-check__error ]" role="alert">{check.error}</p>
    )}
    {error && <p class="[ custom-fit-check__error ]" role="alert">{error}</p>}
</div>

<style lang="scss">
    .custom-fit-check {
        font-size: var(--step--1);
    }

    .custom-fit-check__icon {
        flex-shrink: 0;
        width: 2rem;
        height: 2rem;
    }

    .custom-fit-check__muted {
        color: var(--text-muted);
        flex-shrink: 0;
    }

    .custom-fit-check__error {
        color: var(--fleet-red);
    }

    .custom-fit-check__unknown {
        margin: var(--space-3xs) 0 0;
        padding-inline-start: var(--space-m);
    }
</style>
