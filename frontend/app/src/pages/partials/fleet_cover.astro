---
import { HTTP_400_Bad_Request } from '@helpers/http_responses'

const location_name = Astro.url.searchParams.get('location_name')?.trim()

if (!location_name)
    return HTTP_400_Bad_Request()

import {
    get_location_video_cover,
    get_location_video_cover_thumb,
    get_location_cover,
    get_location_cover_990,
} from '@helpers/covers'

const new_cover = get_location_cover(location_name) ?? '/images/fleets-cover.jpg'
const old_cover = Astro.request.headers.get('X-Page-Cover')

if (old_cover === new_cover)
    return HTTP_400_Bad_Request()

import PageCover from "@components/page/partials/PageCover.astro";
---

<PageCover
    video={get_location_video_cover(location_name) ?? undefined}
    video_thumb={get_location_video_cover_thumb(location_name) ?? undefined}
    image={get_location_cover(location_name) ?? '/images/fleets-cover.jpg'}
    image_990={get_location_cover_990(location_name) ?? '/images/fleets-cover.jpg'}
    animated={false}
    scrollable={true}
    overlay={true}
/>
