---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden } from '@helpers/http_responses'

import type { User } from '@dtypes/jwt'
import * as jose from 'jose'

const auth_token = Astro.cookies.has('auth_token') ? (Astro.cookies.get('auth_token')?.value as string) : false
const user:User | false = auth_token ? jose.decodeJwt(auth_token) as User : false
const is_superuser = (user ? user?.is_superuser : false)

if (!user)
    return HTTP_403_Forbidden()

import { get_user_permissions } from '@helpers/permissions'
const user_permissions = (user ? await get_user_permissions(user?.username) : [])

const can_view_campaigns = is_superuser || user_permissions.includes('campaigns.view_campaign')

if (!can_view_campaigns)
    return HTTP_403_Forbidden()

import type { CampaignSite } from '@dtypes/api.minmatar.org'
import { get_campaign_sites } from '@helpers/api.minmatar.org/campaigns'
import { ACTIVITY_PAGE_SIZE, paginate } from '@helpers/fetching/campaigns'

const slug = Astro.url.searchParams.get('slug') as string
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') ?? '1') || 1)
const delay = parseInt(Astro.url.searchParams.get('delay') ?? '0')

let fetch_sites_error:Error | false = false
let sites:CampaignSite[] = []
let has_more = false

try {
    const fetched = await get_campaign_sites(slug, auth_token as string, ACTIVITY_PAGE_SIZE + 1, (page - 1) * ACTIVITY_PAGE_SIZE)
    ;({ rows: sites, has_more } = paginate(fetched))
} catch (error) {
    fetch_sites_error = error
}

const SITES_PARTIAL_URL = translatePath(`/partials/campaign_sites_component?slug=${slug}&page=${page}`)

import CampaignSites from '@components/blocks/CampaignSites.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
---

{fetch_sites_error ?
    <ErrorRefetch
        args={{
            partial: SITES_PARTIAL_URL,
            error: fetch_sites_error,
            delay: delay,
            target: '#campaign-sites',
        }}
    />
    :
    <CampaignSites slug={slug} sites={sites} page={page} has_more={has_more} />
}
