---
import { i18n } from '@helpers/i18n'
const { lang, t, translatePath } = i18n(Astro.url)

import type { FreightContract } from '@dtypes/api.minmatar.org'
import type { SpaceTruckerStatistics } from '@dtypes/api.minmatar.org'
import type { FreightContractsStats } from '@dtypes/api.minmatar.org'
import {
    fetch_freight_contracts,
    filter_freight_contracts_by_location,
} from '@helpers/fetching/freights'
import { get_characters_statistics, get_contracts_stats } from '@helpers/api.minmatar.org/freights'
import { query_string } from '@helpers/string'
import { from_now_diff } from '@helpers/date'

const history = Boolean(JSON.parse(Astro.url.searchParams.get('is_history') ?? 'false'))
const location_name = Astro.url.searchParams.get('location_name')

let fetching_error: Error | false = false
let contracts: FreightContract[] = []
let space_truckers: SpaceTruckerStatistics[] = []
let contracts_stats: FreightContractsStats | null = null

try {
    contracts = filter_freight_contracts_by_location(
        await fetch_freight_contracts(history),
        location_name,
    )
} catch (error) {
    fetching_error = error as Error
}

if (fetching_error === false) {
    try {
        space_truckers = await get_characters_statistics()
    } catch (error) {
        console.log(error)
        space_truckers = []
    }

    if (!history) {
        try {
            contracts_stats = await get_contracts_stats()
        } catch (error) {
            console.log(error)
            contracts_stats = null
        }
    }
}

const contracts_count = contracts.length

const newest_updated_at = contracts.reduce<Date | null>((newest, contract) => {
    if (!contract.updated_at)
        return newest
    const updated_at = new Date(contract.updated_at)
    if (Number.isNaN(updated_at.getTime()))
        return newest
    if (!newest || updated_at > newest)
        return updated_at
    return newest
}, null)

const last_updated_text = newest_updated_at
    ? t('last_updated_relative').replace('{time}', from_now_diff(lang, newest_updated_at))
    : ''

const FREIGHT_CONTRACTS_PARTIAL_URL = translatePath(`/partials/freight_contracts_component?${query_string({
    ...(location_name ? { location_name } : {}),
    is_history: history,
})}`)

const delay = parseInt(Astro.url.searchParams.get('delay') ?? '0')

import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import FreightContractsTable from '@components/blocks/FreightContractsTable.astro'
import FreightContractsMetrics from '@components/blocks/FreightContractsMetrics.astro'
import UpdateAlpineVariables from '@components/blocks/UpdateAlpineVariables.astro'
import SpaceTruckersReel from '@components/blocks/SpaceTruckersReel.astro'
import Button from '@components/blocks/Button.astro'

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
---

{fetching_error !== false ?
    <ErrorRefetch
        args={{
            partial: FREIGHT_CONTRACTS_PARTIAL_URL,
            error: fetching_error,
            delay: delay,
        }}
    />
    :
    <Flexblock gap='var(--space-l)'>
        {!history && contracts_stats &&
            <FreightContractsMetrics stats={contracts_stats} />
        }
        {contracts.length > 0 ?
            <FreightContractsTable
                contracts={contracts}
                init_tooltips={false}
                is_history={history}
            />
            :
            <Flexblock gap='var(--space-l)' class="[ pb-[64px] ]">
                <p>{t('no_freighter_contracts')}</p>
                {!history &&
                    <FlexInline justification='center' class="[ w-full ]">
                        <Button
                            href={translatePath('/market/freight/contracts/history/')}
                            size='sm'
                        >
                            {t('view_all_historical_contracts')}
                        </Button>
                    </FlexInline>
                }
            </Flexblock>
        }
        <SpaceTruckersReel space_truckers={space_truckers} />
        <UpdateAlpineVariables
            variables={{
                contracts_count: contracts_count,
                last_updated_text: last_updated_text,
            }}
        />
    </Flexblock>
}
