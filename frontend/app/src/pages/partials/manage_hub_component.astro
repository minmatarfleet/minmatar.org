---
/** The Manage hub's queues and settings tiles: the retry target when /manage/ could not load them. */
import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

import type { ManageSummary } from '@dtypes/api.minmatar.org'
import { get_request_user } from '@helpers/request_user'
import { HTTP_403_Forbidden } from '@helpers/http_responses'
import { get_manage_summary } from '@helpers/api.minmatar.org/manage'

import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import ManageHubBody from '@components/blocks/manage/ManageHubBody.astro'

const { auth_token } = get_request_user(Astro)
if (!auth_token) return HTTP_403_Forbidden()

const delay = parseInt(Astro.url.searchParams.get('delay') ?? '0')
let summary: ManageSummary | null = null
let error: Error | null = null
try {
    summary = await get_manage_summary(auth_token)
} catch (failure) {
    error = failure as Error
}
---

{summary
    ? <ManageHubBody summary={summary} />
    : <ErrorRefetch args={{
        partial: translatePath('/partials/manage_hub_component/'),
        error: error ?? new Error('Error fetching the manage summary'),
        delay,
    }} />
}
