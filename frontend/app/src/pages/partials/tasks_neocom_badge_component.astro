---
/**
 * The Tasks Neocom button's count: open tasks that need the pilot, not
 * snoozed. Suggestions and team work up for grabs never count. Nothing
 * when zero, paused, or when the count fails (a badge is not worth an
 * error). Refreshes when a task changes ("tasks-count-changed").
 */
// no-error-refetch: a decorative count; on failure the Neocom shows no badge.
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { get_request_user } from '@helpers/request_user'
import { get_my_task_count } from '@helpers/api.minmatar.org/tasks'

const { auth_token } = get_request_user(Astro)

let total = 0
if (auth_token) {
    try {
        total = (await get_my_task_count(auth_token))?.needs_you ?? 0
    } catch (error) {
        console.log(error)
    }
}
---

<span
    class="[ neocom-badge-slot ]"
    hx-get={translatePath('/partials/tasks_neocom_badge_component/')}
    hx-trigger="tasks-count-changed from:body"
    hx-swap="outerHTML"
>
    {total > 0 &&
        <span class="[ neocom-badge ]" aria-label={`${t('tasks.need_you').replace('~COUNT', String(total))}`}>{total > 99 ? '99+' : total}</span>
    }
</span>
