---
/**
 * Saves the weekly list's settings and re-renders them with the last send.
 */
import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

import type { TaskDigest } from '@dtypes/api.minmatar.org'
import { get_request_user } from '@helpers/request_user'
import { HTTP_403_Forbidden } from '@helpers/http_responses'
import { get_task_digest, patch_task_digest } from '@helpers/api.minmatar.org/tasks'

const { auth_token } = get_request_user(Astro)
if (!auth_token) return HTTP_403_Forbidden()

let digest: TaskDigest | null = null
let error: Error | null = null
let save_error: string | null = null
let saved = false
if (Astro.request.method === 'POST') {
    try {
        const form = await Astro.request.formData()
        const number = (name:string) => {
            const value = parseInt(String(form.get(name) ?? ''))
            return Number.isFinite(value) ? value : null
        }
        digest = await patch_task_digest(auth_token, {
            enabled: form.get('enabled') === 'on',
            weekday: number('weekday'),
            hour: number('hour'),
        })
        saved = true
    } catch (failure) {
        save_error = (failure as Error).message
    }
}
if (!digest) {
    try {
        digest = await get_task_digest(auth_token)
    } catch (failure) {
        error = failure as Error
    }
}

import TaskDigestForm from '@components/blocks/tasks/TaskDigestForm.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
---

{digest
    ? <TaskDigestForm digest={digest} saved={saved} error={save_error} />
    : (
        <div id="tasks-digest">
            <ErrorRefetch args={{
                partial: translatePath('/partials/tasks_digest_component/'),
                error: error ?? new Error('Error fetching the weekly list settings'),
                delay: 0,
                target: '#tasks-digest',
            }} />
        </div>
    )
}
