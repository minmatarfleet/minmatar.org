---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_404_Not_Found, HTTP_403_Forbidden } from '@helpers/http_responses'

import { get_request_user } from '@helpers/request_user'

const { auth_token, user } = get_request_user(Astro)

import { get_gates, can } from '@helpers/gates'
const gates = await get_gates(Astro)

if (!user)
    return HTTP_403_Forbidden()

const fleet_id = parseInt(Astro.url.searchParams.get('fleet_id') as string)

if (isNaN(fleet_id))
    return HTTP_404_Not_Found()

import type { FleetUI, FleetCompositionUI, FleetRadarUI } from '@dtypes/layout_components'
import type { EveCharacterProfile } from '@dtypes/api.minmatar.org'
import { fetch_fleet_by_id, group_members_by_ship, group_members_by_location } from '@helpers/fetching/fleets'
import { get_fleet_members } from '@helpers/api.minmatar.org/fleets'
import { get_user_character } from '@helpers/fetching/characters'
import { get_system_id } from '@helpers/sde/map'

let fetch_fleets_error: Error | false = false
let fleet:FleetUI | null = null
let user_character:EveCharacterProfile | null = null
let fleet_composition:FleetCompositionUI[] = []
let fleet_radar:FleetRadarUI[] = []
let is_fleet_commander = false
let can_manage_fleet = false

import type { SummaryCharacter, FleetMetrics, FleetCommanderMetrics } from '@dtypes/api.minmatar.org'
import { get_characters_summary_sorted } from '@helpers/fetching/characters'
import {
    get_fleet_roles,
    get_fleet_ship_volunteers,
    get_fleet_refits,
    get_fleet_composition,
    type FleetRoleCoverage,
    type FleetShipVolunteer,
    type FleetRefit,
    type FleetCompositionEntry,
} from '@helpers/api.minmatar.org/fleets'
import {
    get_fleets_metrics,
    get_fleet_commander_metrics,
} from '@helpers/api.minmatar.org/fleets'
let pilots: SummaryCharacter[] = []
let roles: FleetRoleCoverage | null = null
let ship_volunteers: FleetShipVolunteer[] = []
let refits: FleetRefit[] = []
let composition: FleetCompositionEntry[] = []
let fleet_metrics: FleetMetrics | undefined
let fleet_commander_metrics: FleetCommanderMetrics | undefined

const upcoming = JSON.parse(Astro.url.searchParams.get('upcoming') as string)

import { fetch_fleet_supply, EMPTY_SUPPLY } from '@helpers/fleet_ships'
import type { FleetSupply } from '@helpers/api.minmatar.org/fleets'
import { settled_value } from '@helpers/settled'
// fetch_fleet_supply never rejects; it falls back to EMPTY_SUPPLY.
let supply_promise:Promise<FleetSupply> | null = null

// Two rounds of backend calls: the fleet and the viewer's character, then
// everything that needs the fleet. Results are read in the order the partial
// used to await them one by one, so a failure still lands where it did.
try {
    const [fleet_result, user_character_result] = await Promise.allSettled([
        fetch_fleet_by_id(auth_token as string, fleet_id),
        get_user_character(user.user_id),
    ])
    fleet = settled_value(fleet_result)
    user_character = settled_value(user_character_result)
    is_fleet_commander = (user_character?.character_id === fleet.fleet_commander_id)
    const is_strategic_fc = can(gates, 'fleets.manage_any')
    can_manage_fleet = is_fleet_commander || is_strategic_fc

    const loaded_fleet = fleet
    const load_fc_view = async () => {
        const staging_solar_system = loaded_fleet.location.split(' - ')[0]
        const staging_solar_system_id = await get_system_id(staging_solar_system)

        if (!staging_solar_system_id)
            throw new Error(t('invalid_staging_solar_system'), { cause: 400 })

        const members = await get_fleet_members(auth_token as string, fleet_id)
        return {
            composition: await group_members_by_ship(members),
            radar: await group_members_by_location(members, staging_solar_system_id),
        }
    }

    if (upcoming)
        supply_promise = fetch_fleet_supply(auth_token as string, fleet_id)

    const [
        fc_view_result,
        summary_result,
        roles_result,
        composition_result,
        ship_volunteers_result,
        refits_result,
        fleets_metrics_result,
        fleet_commanders_metrics_result,
    ] = await Promise.allSettled([
        is_fleet_commander && upcoming ? load_fc_view() : null,
        get_characters_summary_sorted(auth_token as string),
        get_fleet_roles(auth_token as string, fleet_id),
        upcoming ? get_fleet_composition(auth_token as string, fleet_id) : [],
        upcoming ? get_fleet_ship_volunteers(auth_token as string, fleet_id) : [],
        upcoming ? get_fleet_refits(auth_token as string, fleet_id) : [],
        get_fleets_metrics(auth_token as string, fleet_id),
        get_fleet_commander_metrics(auth_token as string),
    ])

    const fc_view = settled_value(fc_view_result)
    if (fc_view) {
        fleet_composition = fc_view.composition
        fleet_radar = fc_view.radar
    }

    const summary = settled_value(summary_result)
    roles = settled_value(roles_result)
    pilots = summary.characters ?? []

    if (upcoming) {
        composition = settled_value(composition_result)
        ship_volunteers = settled_value(ship_volunteers_result)
        refits = settled_value(refits_result)
    }

    // Filtered to this fleet by the API; find() keeps working against an
    // API that still returns every fleet.
    const fleets_metrics = settled_value(fleets_metrics_result)
    fleet_metrics = fleets_metrics.find(metric => metric.fleet_id === fleet_id)
    const fleet_commanders_metrics = settled_value(fleet_commanders_metrics_result)
    fleet_commander_metrics = fleet_commanders_metrics.find(metric => metric.primary_character_id === fleet?.fleet_commander_id)
} catch (error) {
    if (error?.cause === 403)
        return HTTP_403_Forbidden()
    
    fetch_fleets_error = error
}

const supply = fleet && upcoming ? await (supply_promise ?? fetch_fleet_supply(auth_token as string, fleet_id)) : EMPTY_SUPPLY

const FLEET_DETAIL_PARTIAL_URL = translatePath(`/partials/fleet_detail_component?fleet_id=${fleet_id}&upcoming=${JSON.stringify(upcoming)}`)

const delay = parseInt(Astro.url.searchParams.get('delay') ?? '0')

const can_remove_fleet = can(gates, 'fleets.delete') ||
                         user_character?.character_id === fleet?.fleet_commander_id


import ErrorRefetch from '@components/blocks/ErrorRefetch.astro';
import FleetDetails from '@components/blocks/FleetDetails.astro';
import Button from '@components/blocks/Button.astro';
---

{fetch_fleets_error ?
    <ErrorRefetch
        args={{
            partial: FLEET_DETAIL_PARTIAL_URL,
            error: fetch_fleets_error,
            delay: delay,
        }}
    />
    :
    <FleetDetails
        fleet={fleet as FleetUI }
        can_remove_fleet={can_remove_fleet}
        is_fleet_commander={is_fleet_commander}
        can_manage={can_manage_fleet}
        fleet_composition={fleet_composition}
        fleet_radar={fleet_radar}
        history={!upcoming}
        pilots={pilots}
        roles={roles}
        update_cover={true}
        fleet_metrics={fleet_metrics}
        fleet_commander_metrics={fleet_commander_metrics}
        init_tooltips={true}
        ship_volunteers={ship_volunteers}
        refits={refits}
        composition={composition}
        supply={supply}
    />
}