---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import Flexblock from '@components/compositions/Flexblock.astro'
import AddCharacterScopeGroups from '@components/blocks/AddCharacterScopeGroups.astro'

const is_main = JSON.parse(Astro.url.searchParams.get('is_main') as string) as boolean
---

<Flexblock gap="var(--space-s)">
    <p>{is_main ? t('add_primary_pilot_dialog_text') : t('add_pilot_dialog_text')}</p>
    <AddCharacterScopeGroups />
</Flexblock>
