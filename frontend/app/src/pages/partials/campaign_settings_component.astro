---
/**
 * The bodies of the campaign Settings tab's sections (CampaignSettingsPanel).
 * Each `part` GETs its form and POSTs back to itself; the form swaps only
 * itself and sends the section's summary out of band.
 *
 * part=features   the feature switches (one per tab or header part)
 * part=basics     name, tagline, status, start and end (EVE time)
 * part=systems    goal, role and priority per system, retire, add by name; one Save
 *                 (op=preview re-renders with a picked system added as a New row)
 * part=sides      enemies, allies and third parties picked by name
 * part=coordinators who helps run it: invite anyone as Coordinator, FC, Recon or Diplomat
 *                 (by character, or from the coordination Discord's members)
 * part=fittings   attached doctrines, each fitting on or off, and one-off fittings
 * part=targets    this week's targets: accept, nudge, propose again
 * part=order      the commander's order: publish, draft from the week plan
 * part=structures the structures under recon (added from the Structures tab)
 * part=coordination our Discord server and the servers coordinators linked, with channels
 */
import { i18n, t_key } from '@helpers/i18n'
const { t, lang, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'
import { get_gates, can } from '@helpers/gates'
import {
    get_campaign_settings,
    get_campaign_choices,
    get_campaign_coordination,
    put_campaign_coordination,
    get_campaign_discord_links,
    get_campaign_roles,
    get_campaign_role_suggestions,
    change_campaign,
    type CampaignChoices,
} from '@helpers/api.minmatar.org/campaigns'
import { get_fittings } from '@helpers/api.minmatar.org/ships'
import { get_doctrines } from '@helpers/api.minmatar.org/doctrines'
import type { CampaignCoordination, CampaignDiscordLink, CampaignRoles, CampaignRoleSuggestions, CampaignSettings, Doctrine, Fitting } from '@dtypes/api.minmatar.org'
import { get_item_icon, get_player_icon } from '@helpers/eve_image'
import { campaign_sides } from '@helpers/campaign_sides'
import { form_text } from '@helpers/manage_forms'
import { query_string } from '@helpers/string'
import {
    choice_label,
    systems_summary,
    sides_summary,
    eve_weekday_date,
    refusal_text,
    DISCORD_CHANNEL_SLOTS,
    discord_channel_body,
    discord_channel_label_key,
} from '@helpers/campaign_manage'
import { CAMPAIGN_FEATURES, features_on } from '@helpers/campaign_features'

const { auth_token, user } = get_request_user(Astro)
if (!user || !auth_token) return HTTP_403_Forbidden()

const gates = await get_gates(Astro)
if (!can(gates, 'campaigns.manage')) return HTTP_403_Forbidden()
if (Astro.url.searchParams.get('part') === 'coordination' && !can(gates, 'campaigns.coordination')) return HTTP_403_Forbidden()

const params = Astro.url.searchParams
const slug = params.get('slug') ?? ''
if (!/^[a-z0-9-]+$/.test(slug)) return HTTP_403_Forbidden()

const PARTS = ['features', 'basics', 'systems', 'sides', 'coordinators', 'fittings', 'targets', 'order', 'structures', 'coordination'] as const
const ROLE_KIND = /^(coordinator|fc|diplomat|recon|it)$/
type Part = typeof PARTS[number]
const part = (PARTS as readonly string[]).includes(params.get('part') ?? '') ? params.get('part') as Part : 'basics'
const has_structures_tab = params.get('tab') === '1'

const PART_URL = translatePath(`/partials/campaign_settings_component/?${query_string({ slug, part, ...(has_structures_tab ? { tab: '1' } : {}) })}`)
const section_id = `campaign-settings-${part}`
const body_id = `${section_id}-body`

const is_post = Astro.request.method === 'POST'
const form = is_post ? await Astro.request.formData() : null
const field = (name: string) => form ? form_text(form, name) : ''
const op = field('op')
const is_preview = is_post && part === 'systems' && op !== 'save'

/** A row of the systems table, from the stored system or from the posted form. */
interface SystemRow {
    key:                string;
    id:                 number | null;
    solar_system_id:    number;
    name:               string;
    goal:               string;
    role:               string;
    priority:           string;
    retire:             boolean;
    is_new:             boolean;
    error?:             string;
}

let saved = false
let error_message = ''
const row_errors: Record<string, string> = {}
const pending_new: SystemRow[] = []

const posted_number = (name: string) => {
    const value = parseInt(field(name))
    return Number.isFinite(value) ? value : null
}

async function load() {
    return await get_campaign_settings(slug, auth_token as string)
}

let settings: CampaignSettings | null = null
let choices: CampaignChoices | null = null
let fittings: Fitting[] = []
let coordination: CampaignCoordination | null = null
let doctrines: Doctrine[] = []
let links: CampaignDiscordLink[] = []
let roles_data: CampaignRoles | null = null
let discord_members: CampaignRoleSuggestions | null = null
let fetch_error: Error | false = false

try {
    [ settings, choices ] = await Promise.all([ load(), get_campaign_choices(auth_token) ])
} catch (error) {
    fetch_error = error
}

/** Rows as posted: existing systems keep their stored name; new ones carry theirs. */
function posted_rows(current: CampaignSettings): SystemRow[] {
    if (!form) return []
    const stored = new Map(current.systems.map((system) => [`e${system.id}`, system]))
    const rows: SystemRow[] = []
    for (const key of form.getAll('row').map(String)) {
        const values = {
            goal: field(`goal_${key}`),
            role: field(`role_${key}`),
            priority: field(`priority_${key}`),
            retire: field(`retire_${key}`) === 'on',
        }
        const system = stored.get(key)
        if (system) {
            rows.push({ key, id: system.id, solar_system_id: system.solar_system_id, name: system.name, is_new: false, ...values })
        } else if (/^n\d+$/.test(key)) {
            rows.push({ key, id: null, solar_system_id: parseInt(key.slice(1)), name: field(`name_${key}`), is_new: true, ...values, retire: false })
        }
    }
    return rows
}

function stored_rows(current: CampaignSettings): SystemRow[] {
    return current.systems
        .filter((system) => !system.retired)
        .map((system) => ({
            key: `e${system.id}`,
            id: system.id,
            solar_system_id: system.solar_system_id,
            name: system.name,
            goal: system.goal,
            role: system.role,
            priority: system.priority,
            retire: false,
            is_new: false,
        }))
}

let rows: SystemRow[] = []

if (is_post && settings && choices) {
    const current = settings
    try {
        switch (part) {
            case 'features':
                await change_campaign(slug, auth_token, 'PATCH', '/settings', {
                    features: Object.fromEntries(CAMPAIGN_FEATURES.map((feature) => [feature, field(`${feature}_enabled`) === 'on'])),
                })
                saved = true
                break
            case 'basics':
                await change_campaign(slug, auth_token, 'PATCH', '/settings', {
                    name: field('name'),
                    tagline: field('tagline'),
                    status: field('status'),
                    start_at: field('start_at') || undefined,
                    end_at: field('end_at') || undefined,
                    undisclosed: field('undisclosed') === 'on',
                })
                saved = true
                break
            case 'systems': {
                const posted = posted_rows(current)
                const added_id = posted_number('add_system_id')
                const live = (solar_id: number) => current.systems.some((system) => !system.retired && system.solar_system_id === solar_id)
                if (added_id && !posted.some((row) => row.solar_system_id === added_id) && !live(added_id)) {
                    posted.push({
                        key: `n${added_id}`,
                        id: null,
                        solar_system_id: added_id,
                        name: field('add_system_name'),
                        goal: 'take',
                        role: 'primary',
                        priority: 'medium',
                        retire: false,
                        is_new: true,
                    })
                }
                if (is_preview) {
                    rows = posted
                    break
                }
                const stored = new Map(current.systems.map((system) => [system.id, system]))
                for (const row of posted) {
                    try {
                        if (row.is_new) {
                            await change_campaign(slug, auth_token, 'POST', '/systems', {
                                solar_system_id: row.solar_system_id,
                                goal: row.goal,
                                role: row.role,
                                priority: row.priority,
                            })
                        } else if (row.retire && row.id) {
                            await change_campaign(slug, auth_token, 'DELETE', `/systems/${row.id}`)
                        } else if (row.id) {
                            const before = stored.get(row.id)
                            if (before && (before.goal !== row.goal || before.role !== row.role || before.priority !== row.priority)) {
                                await change_campaign(slug, auth_token, 'PATCH', `/systems/${row.id}`, {
                                    goal: row.goal,
                                    role: row.role,
                                    priority: row.priority,
                                })
                            }
                        }
                    } catch (error) {
                        row_errors[row.key] = refusal_text(error, t('campaigns.action_failed'))
                        if (row.is_new) pending_new.push({ ...row, error: row_errors[row.key] })
                    }
                }
                saved = Object.keys(row_errors).length === 0
                break
            }
            case 'sides':
                if (op === 'remove') {
                    await change_campaign(slug, auth_token, 'DELETE', `/parties/${posted_number('party_id')}`)
                } else {
                    // One add form per column: op is add_<side>, its fields end in _<side>.
                    const side = op.startsWith('add_') ? op.slice(4) : ''
                    if (!['enemy', 'ally', 'third_party'].includes(side)) throw new Error(t('campaigns.manage.pick_first'))
                    const kind = field(`kind_${side}`)
                    if (!['alliance', 'corporation', 'character'].includes(kind)) throw new Error(t('campaigns.manage.pick_first'))
                    const entity_id = posted_number(`${kind}_id_${side}`)
                    const name = field(`${kind}_name_${side}`)
                    if (!entity_id || !name) throw new Error(t('campaigns.manage.pick_first'))
                    await change_campaign(slug, auth_token, 'POST', '/parties', {
                        name,
                        kind,
                        side,
                        [`${kind}_id`]: entity_id,
                    })
                }
                saved = true
                break
            case 'coordinators':
                if (op === 'remove') {
                    await change_campaign(slug, auth_token, 'DELETE', `/coordinators/${posted_number('coordinator_id')}`)
                } else if (op === 'scope') {
                    const scope = field('scope')
                    const scopes = new Set(current.coordinator_scopes)
                    if (scopes.has(scope)) scopes.delete(scope)
                    else scopes.add(scope)
                    await change_campaign(slug, auth_token, 'PATCH', '/settings', { coordinator_scopes: [...scopes] })
                } else if (op === 'remove_role') {
                    const kind = field('kind')
                    if (!ROLE_KIND.test(kind)) throw new Error(t('campaigns.action_failed'))
                    await change_campaign(slug, auth_token, 'DELETE', `/roles/${kind}/members/${posted_number('member_id')}`)
                } else if (op === 'invite_discord') {
                    const discord_user_id = field('discord_user_id')
                    if (!/^\d+$/.test(discord_user_id)) throw new Error(t('campaigns.action_failed'))
                    const kind = field(`role_${discord_user_id}`)
                    if (!ROLE_KIND.test(kind)) throw new Error(t('campaigns.coordinators.pick_role'))
                    await change_campaign(slug, auth_token, 'POST', `/roles/${kind}/members`, {
                        discord_user_id,
                        character_name: field(`character_${discord_user_id}`).trim(),
                    })
                } else {
                    const kind = field('invite_role')
                    if (!ROLE_KIND.test(kind)) throw new Error(t('campaigns.coordinators.pick_role'))
                    const name = field('character_name').trim()
                    if (name.length < 3) throw new Error(t('campaigns.coordinators.not_found'))
                    await change_campaign(slug, auth_token, 'POST', `/roles/${kind}/members`, { character_name: name })
                }
                saved = true
                break
            case 'fittings':
                if (op === 'remove') {
                    await change_campaign(slug, auth_token, 'DELETE', `/fittings/${posted_number('row_id')}`)
                } else if (op === 'toggle') {
                    await change_campaign(slug, auth_token, 'PATCH', `/fittings/${posted_number('row_id')}`, { enabled: field('enabled') === 'true' })
                } else if (op === 'add_doctrine') {
                    const doctrine_id = posted_number('doctrine_id')
                    if (!doctrine_id) throw new Error(t('campaigns.doctrines.add'))
                    await change_campaign(slug, auth_token, 'POST', '/doctrines', { doctrine_id })
                } else if (op === 'remove_doctrine') {
                    await change_campaign(slug, auth_token, 'DELETE', `/doctrines/${posted_number('campaign_doctrine_id')}`)
                } else {
                    const fitting_id = posted_number('fitting_id')
                    if (!fitting_id) throw new Error(t('campaigns.manage.pick_fitting'))
                    await change_campaign(slug, auth_token, 'POST', '/fittings', {
                        fitting_id,
                        role_label: field('role_label'),
                    })
                }
                saved = true
                break
            case 'targets':
                if (op === 'propose') {
                    await change_campaign(slug, auth_token, 'POST', '/week/propose')
                } else {
                    for (const row of current.week_targets) {
                        const value = parseFloat(field(`target_${row.id}`))
                        if (Number.isFinite(value))
                            await change_campaign(slug, auth_token, 'PATCH', `/week/${row.id}`, { target: value })
                    }
                }
                saved = true
                break
            case 'coordination':
                if (op === 'remove_link') {
                    await change_campaign(slug, auth_token, 'DELETE', `/discord-links/${posted_number('link_id')}`)
                } else {
                    await put_campaign_coordination(slug, auth_token, {
                        guild_id: field('guild_id') || null,
                        ...discord_channel_body((slot) => field(`${slot}_channel_id`)),
                    })
                    for (const id of (form?.getAll('link_id') ?? []).map(String)) {
                        await change_campaign(slug, auth_token, 'PATCH', `/discord-links/${id}`,
                            discord_channel_body((slot) => field(`link_${slot}_${id}`)))
                    }
                }
                saved = true
                break
            case 'order':
                if (op === 'draft') {
                    await change_campaign(slug, auth_token, 'POST', '/commander-order/draft')
                } else if (op === 'publish_draft') {
                    await change_campaign(slug, auth_token, 'POST', '/commander-order/publish')
                } else {
                    await change_campaign(slug, auth_token, 'POST', '/commander-order', { text: field('text') })
                }
                saved = true
                break
        }
    } catch (error) {
        error_message = refusal_text(error, t('campaigns.action_failed'))
    }
    // Reload after a write, so the form and the summary show what is stored.
    if (!is_preview) {
        try {
            settings = await load()
        } catch (error) {
            fetch_error = error
        }
    }
}

if (settings && part === 'systems' && !is_preview)
    rows = [...stored_rows(settings), ...pending_new]

if (settings && part === 'fittings') {
    try {
        const [all_fittings, all_doctrines] = await Promise.all([get_fittings(), get_doctrines()])
        fittings = all_fittings.sort((a, b) => a.name.localeCompare(b.name))
        doctrines = all_doctrines.sort((a, b) => a.name.localeCompare(b.name))
    } catch (error) {
        console.log(`Could not load fittings: ${error.message}`)
    }
}

if (settings && part === 'coordinators') {
    // Discord can be slow or down: the section still works without the member list.
    const [roles_result, members_result] = await Promise.allSettled([
        get_campaign_roles(slug, auth_token),
        get_campaign_role_suggestions(slug, auth_token),
    ])
    if (roles_result.status === 'fulfilled') roles_data = roles_result.value
    else fetch_error = roles_result.reason
    if (members_result.status === 'fulfilled') discord_members = members_result.value
}

const SEARCH_URL = translatePath('/partials/campaign_character_search_component')

if (settings && part === 'coordination') {
    try {
        // A server picked in the form lists its own channels before it is saved.
        const picked = is_post ? '' : (params.get('guild_id') ?? '')
        coordination = await get_campaign_coordination(slug, auth_token, picked)
        links = coordination.links ?? []
    } catch (error) {
        fetch_error = error
    }
}

const BOT_CONNECT_URL = (purpose: 'ours' | 'link') => translatePath(`/redirects/campaign_discord_bot_connect_init?${query_string({ slug, purpose })}`)
const doctrine_ids = new Set((settings?.doctrines ?? []).map((row) => row.doctrine_id))
const fittings_on = (settings?.fittings ?? []).filter((row) => row.enabled).length

const retired = settings?.systems.filter((system) => system.retired && !rows.some((row) => row.solar_system_id === system.solar_system_id)) ?? []

function summary_for(current: CampaignSettings): string {
    switch (part) {
        case 'features':
            return t('campaigns.manage.features_summary')
                .replace('~COUNT', String(features_on(current.features)))
                .replace('~TOTAL', String(CAMPAIGN_FEATURES.length))
        case 'basics': {
            const status = choice_label(choices?.status, current.status)
            const ends = t('campaigns.manage.ends_on').replace('~DATE', eve_weekday_date(lang, current.end_at))
            return [current.tagline && `"${current.tagline}"`, status, ends].filter(Boolean).join(' · ')
        }
        case 'systems':
            return systems_summary(current.systems, choices?.goal) || t('campaigns.manage.none_yet')
        case 'sides':
            return sides_summary(current.parties, choices?.party_side) || t('campaigns.manage.none_yet')
        case 'coordinators':
            // The section lists its people; no summary line to repeat them.
            return ''
        case 'fittings': {
            if (current.fittings.length === 0) return t('campaigns.doctrines.none')
            return t('campaigns.doctrines.summary')
                .replace('{doctrines}', current.doctrines.map((row) => row.name).join(', ') || t('campaigns.doctrines.none'))
                .replace('{on}', String(current.fittings.filter((row) => row.enabled).length))
                .replace('{total}', String(current.fittings.length))
        }
        case 'targets': {
            const count = current.week_targets.length
            if (count === 0) return t('campaigns.manage.targets_none')
            const proposed = current.week_targets.filter((row) => row.proposed).length
            return [
                count === 1 ? t('campaigns.manage.targets_count_one') : t('campaigns.manage.targets_count').replace('~COUNT', String(count)),
                proposed > 0 ? t('campaigns.manage.targets_proposed').replace('~COUNT', String(proposed)) : '',
            ].filter(Boolean).join(' · ')
        }
        case 'order':
            return current.commander_order_text
                ? `${current.commander_order_text}${current.commander_order_is_draft ? ` ${t('campaigns.manage.order_draft_suffix')}` : ''}`
                : t('campaigns.manage.order_none')
        case 'coordination':
            return t('campaigns.discord.servers_summary').replace('{count}', String(1 + (coordination?.links?.length ?? 0)))
        case 'structures':
            return current.structures.length === 0
                ? t('campaigns.manage.none_yet')
                : current.structures.length === 1
                    ? t('campaigns.manage.structures_count_one')
                    : t('campaigns.manage.structures_count').replace('~COUNT', String(current.structures.length))
    }
}

const PARTY_KINDS = ['alliance', 'corporation', 'character'] as const
const party_kind_label = (kind: string) =>
    kind === 'alliance' ? t('campaigns.manage.party_alliance')
        : kind === 'corporation' ? t('campaigns.manage.party_corporation')
            : kind === 'character' ? t('campaigns.manage.party_character')
                : choice_label(choices?.party_kind, kind)

const format_number = (value: number) => value.toLocaleString(lang, { maximumFractionDigits: 1 })

import Button from '@components/blocks/Button.astro'
import FilterChip from '@components/blocks/FilterChip.astro'
import Input from '@components/blocks/Input.astro'
import CampaignCoordinatorsPanel from '@components/blocks/CampaignCoordinatorsPanel.astro'
import Select from '@components/blocks/Select.astro'
import Tag from '@components/blocks/Tag.astro'
import EmptyState from '@components/blocks/EmptyState.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import ManageTable from '@components/blocks/manage/ManageTable.astro'
import ManageField from '@components/blocks/manage/ManageField.astro'
import EntityPicker from '@components/blocks/manage/EntityPicker.astro'
import EveTimeInput from '@components/blocks/manage/EveTimeInput.astro'
import SectionSummary from '@components/blocks/manage/SectionSummary.astro'
import Switch from '@components/blocks/Switch.astro'
import StylessButton from '@components/blocks/StylessButton.astro'
---

{fetch_error || !settings || !choices ?
    <div id={body_id} class="[ manage-section__body ]">
        <ErrorRefetch
            args={{
                partial: PART_URL,
                error: fetch_error || new Error(t('campaigns.action_failed')),
                delay: 0,
                target: `#${body_id}`,
            }}
        />
    </div>
    :
    <form
        id={body_id}
        class="[ manage-section__body manage-form campaign-settings ]"
        hx-post={PART_URL}
        hx-target="this"
        hx-swap="outerHTML"
    >
        {part === 'features' &&
            <Fragment>
                <div class="[ campaign-features ]">
                    {CAMPAIGN_FEATURES.map((feature) =>
                        <Switch shape="square"
                            name={`${feature}_enabled`}
                            label={t(`campaigns.features.${feature}`)}
                            description={t(`campaigns.features.${feature}_help`)}
                            checked={settings.features[feature]}
                        />
                    )}
                </div>
                <div class="[ manage-actions ]">
                    <Button type="submit" size="sm">{t('campaigns.manage.save')}</Button>
                    {error_message && <span class="[ manage-field__error ]" role="alert">{error_message}</span>}
                    {saved && <span class="[ manage-saved ]">{t('campaigns.manage.saved')}</span>}
                </div>
            </Fragment>
        }

        {part === 'basics' &&
            <Fragment>
                <div class="[ manage-fields ]">
                    <ManageField label={t('campaigns.manage.name')} for="campaign-basics-name">
                        <Input id="campaign-basics-name" size="sm" name="name" value={settings.name} maxlength="128" required />
                    </ManageField>
                    <ManageField label={t('campaigns.manage.tagline')} for="campaign-basics-tagline" hint={t('campaigns.manage.tagline_hint')}>
                        <Input id="campaign-basics-tagline" size="sm" name="tagline" value={settings.tagline} maxlength="200" />
                    </ManageField>
                    <ManageField label={t('campaigns.manage.status')} for="campaign-basics-status">
                        <Select id="campaign-basics-status" size="sm" name="status">
                            {choices.status.map((choice) => <option value={choice.value} selected={choice.value === settings.status}>{choice.label}</option>)}
                        </Select>
                    </ManageField>
                    <EveTimeInput id="campaign-basics-start" name="start_at" label={t('campaigns.manage.starts')} value={settings.start_at} required />
                    <EveTimeInput id="campaign-basics-end" name="end_at" label={t('campaigns.manage.ends')} value={settings.end_at} required />
                </div>
                <Switch shape="square"
                    name="undisclosed"
                    label={t('campaigns.manage.undisclosed')}
                    description={t('campaigns.manage.undisclosed_hint')}
                    checked={settings.undisclosed}
                />
                <div class="[ manage-actions ]">
                    <Button type="submit" size="sm">{t('campaigns.manage.save')}</Button>
                    {error_message && <span class="[ manage-field__error ]" role="alert">{error_message}</span>}
                    {saved && <span class="[ manage-saved ]">{t('campaigns.manage.saved')}</span>}
                </div>
            </Fragment>
        }

        {part === 'systems' &&
            <Fragment>
                {rows.length === 0 ?
                    <EmptyState title={t('campaigns.manage.no_systems')} />
                    :
                    <ManageTable
                        caption={t('campaigns.manage.systems_caption')}
                        columns={[
                            { label: t('campaigns.manage.system') },
                            { label: t('campaigns.manage.goal') },
                            { label: t('campaigns.manage.role') },
                            { label: t('campaigns.manage.priority') },
                            { label: t('campaigns.manage.retire'), align: 'act', hidden: true },
                        ]}
                        expandable={false}
                        min_width="40rem"
                    >
                            <tbody>
                                {rows.map((row) => (
                                    <tr class:list={['[ campaign-systems__row ]', { 'is-new': row.is_new }]}>
                                        <td>
                                            <input type="hidden" name="row" value={row.key} />
                                            {row.is_new && <input type="hidden" name={`name_${row.key}`} value={row.name} />}
                                            <span class="[ campaign-systems__name ]">
                                                <span class="[ manage-who__name ]">{row.name}</span>
                                                {row.is_new && <Tag text={t('campaigns.manage.new_badge')} color="fleet-yellow" />}
                                            </span>
                                            {(row_errors[row.key] || row.error) &&
                                                <span class="[ manage-field__error ]" role="alert">{row_errors[row.key] || row.error}</span>
                                            }
                                        </td>
                                        <td>
                                            <Select size="sm" name={`goal_${row.key}`} aria-label={`${t('campaigns.manage.goal')}: ${row.name}`}>
                                                {choices.goal.map((choice) => <option value={choice.value} selected={choice.value === row.goal}>{choice.label}</option>)}
                                            </Select>
                                        </td>
                                        <td>
                                            <Select size="sm" name={`role_${row.key}`} aria-label={`${t('campaigns.manage.role')}: ${row.name}`}>
                                                {choices.role.map((choice) => <option value={choice.value} selected={choice.value === row.role}>{choice.label}</option>)}
                                            </Select>
                                        </td>
                                        <td>
                                            <Select size="sm" name={`priority_${row.key}`} aria-label={`${t('campaigns.manage.priority')}: ${row.name}`}>
                                                {choices.priority.map((choice) => <option value={choice.value} selected={choice.value === row.priority}>{choice.label}</option>)}
                                            </Select>
                                        </td>
                                        <td class="act">
                                            {row.is_new ?
                                                <StylessButton
                                                    type="button"
                                                    class="[ campaign-systems__action ]"
                                                    aria-label={t('campaigns.manage.remove_system').replace('~NAME', row.name)}
                                                    x-data
                                                    x-on:click="$el.closest('tr').remove()"
                                                >
                                                    {t('campaigns.manage.remove')}
                                                </StylessButton>
                                                :
                                                <label class="[ campaign-systems__action campaign-systems__retire ]">
                                                    <input type="checkbox" name={`retire_${row.key}`} checked={row.retire} class="[ visually-hidden ]" />
                                                    <span class="[ campaign-systems__retire-off ]">{t('campaigns.manage.retire')}</span>
                                                    <span class="[ campaign-systems__retire-on ]">{t('campaigns.manage.undo')}</span>
                                                </label>
                                            }
                                        </td>
                                    </tr>
                                ))}
                            </tbody>
                    </ManageTable>
                }
                {retired.length > 0 &&
                    <p class="[ manage-muted ]">{t('campaigns.manage.retired_systems').replace('~NAMES', retired.map((system) => system.name).join(', '))}</p>
                }
                <div class="[ campaign-systems__foot ]">
                    <div
                        class="[ campaign-systems__add ]"
                        hx-post={PART_URL}
                        hx-vals='{"op": "preview"}'
                        hx-trigger="manage-entity-picked"
                        hx-include="closest form"
                    >
                        <EntityPicker
                            id="campaign-systems-add"
                            kind="system"
                            name="add_system_id"
                            name_field="add_system_name"
                            label={t('campaigns.manage.add_system')}
                            placeholder={t('campaigns.manage.add_system')}
                        />
                    </div>
                    <div class="[ manage-actions ]">
                        <Button type="button" color="transparent" size="sm" hx-get={PART_URL}>{t('campaigns.manage.discard')}</Button>
                        <Button type="submit" size="sm" name="op" value="save">{t('campaigns.manage.save_systems')}</Button>
                        {saved && <span class="[ manage-saved ]">{t('campaigns.manage.saved')}</span>}
                    </div>
                </div>
            </Fragment>
        }

        {part === 'sides' &&
            <Fragment>
                <div class="[ campaign-sides-grid ]">
                    {campaign_sides(settings.parties).map((column) =>
                        <div class="[ campaign-sides-col ]" data-side={column.side} x-data="{ kind: 'alliance' }">
                            <span class="[ campaign-sides-col__label ]">{t(column.label_key)}</span>
                            <ul class="[ campaign-list ]" role="list">
                                {column.parties.map((party) => (
                                    <li class="[ campaign-list__row ]">
                                        <span class="[ campaign-list__name ]">
                                            <span class="[ manage-who__name ]">{party.name}{party.ticker && ` [${party.ticker}]`}</span>
                                            <span class="[ manage-who__sub ]">{party_kind_label(party.kind)}</span>
                                        </span>
                                        <StylessButton
                                            type="button"
                                            class="[ campaign-icon-button ]"
                                            aria-label={`${t('campaigns.manage.remove')} ${party.name}`}
                                            hx-post={PART_URL}
                                            hx-vals={JSON.stringify({ op: 'remove', party_id: String(party.id) })}
                                        ><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></StylessButton>
                                    </li>
                                ))}
                            </ul>
                            {column.parties.length === 0 &&
                                <p class="[ manage-muted ]">{t('campaigns.parties.none')}</p>
                            }
                            <div class="[ campaign-sides-add ]">
                                <ManageField label={t('campaigns.manage.party_kind')} for={`campaign-sides-kind-${column.side}`}>
                                    <Select id={`campaign-sides-kind-${column.side}`} size="sm" name={`kind_${column.side}`} x-model="kind">
                                        {PARTY_KINDS.map((kind) => <option value={kind}>{party_kind_label(kind)}</option>)}
                                    </Select>
                                </ManageField>
                                {PARTY_KINDS.map((kind) => (
                                    <EntityPicker
                                        id={`campaign-sides-${column.side}-${kind}`}
                                        kind={kind}
                                        name={`${kind}_id_${column.side}`}
                                        name_field={`${kind}_name_${column.side}`}
                                        label={party_kind_label(kind)}
                                        x-show={`kind === '${kind}'`}
                                        style={kind === 'alliance' ? undefined : 'display: none'}
                                    />
                                ))}
                                <Button type="submit" size="sm" name="op" value={`add_${column.side}`}>{t('campaigns.manage.add')}</Button>
                            </div>
                        </div>
                    )}
                </div>
                <div class="[ manage-actions ]">
                    {error_message && <span class="[ manage-field__error ]" role="alert">{error_message}</span>}
                    {saved && <span class="[ manage-saved ]">{t('campaigns.manage.saved')}</span>}
                </div>
            </Fragment>
        }

        {part === 'coordinators' && roles_data &&
            <CampaignCoordinatorsPanel
                roles={roles_data.roles}
                coordinators={settings.coordinators}
                coordinator_scopes={settings.coordinator_scopes}
                discord={discord_members}
                part_url={PART_URL}
                search_url={SEARCH_URL}
                error_message={error_message}
            />
        }

        {part === 'fittings' &&
            <Fragment>
                <div class="[ campaign-doctrines ]">
                    {settings.doctrines.map((row) =>
                        <FilterChip
                            removable={true}
                            remove_label={t('campaigns.doctrines.remove').replace('{name}', row.name)}
                            remove_attributes={{
                                'hx-post': PART_URL,
                                'hx-vals': JSON.stringify({ op: 'remove_doctrine', campaign_doctrine_id: String(row.id) }),
                            }}
                        >{row.name}</FilterChip>
                    )}
                    <label for="campaign-doctrine" class="[ visually-hidden ]">{t('campaigns.doctrines.add')}</label>
                    <Select id="campaign-doctrine" size="sm" name="doctrine_id">
                        <option value="">{t('campaigns.doctrines.add')}</option>
                        {doctrines.filter((doctrine) => !doctrine_ids.has(doctrine.id)).map((doctrine) => <option value={doctrine.id}>{doctrine.name}</option>)}
                    </Select>
                    <Button type="submit" size="sm" name="op" value="add_doctrine">{t('campaigns.manage.add')}</Button>
                </div>
                {settings.fittings.length > 0 &&
                    <ul class="[ campaign-list ]" role="list">
                        {settings.fittings.map((fitting) => (
                            <li class:list={['[ campaign-list__row ]', { 'is-off': !fitting.enabled }]}>
                                {fitting.ship_id && <img src={get_item_icon(fitting.ship_id, 64)} alt="" width="40" height="40" class="[ campaign-portrait ]" />}
                                <span class="[ campaign-list__name ]">
                                    <span class="[ manage-who__name ]">{fitting.name}</span>
                                    {fitting.doctrine_name && <span class="[ manage-who__sub ]">{fitting.doctrine_name}</span>}
                                </span>
                                <span class="[ campaign-fitting__role ]">{fitting.role_label}</span>
                                <FilterChip
                                    tone="green"
                                    active={fitting.enabled}
                                    aria-label={t('campaigns.doctrines.toggle').replace('{name}', fitting.name)}
                                    hx-post={PART_URL}
                                    hx-vals={JSON.stringify({ op: 'toggle', row_id: String(fitting.id), enabled: String(!fitting.enabled) })}
                                >{fitting.enabled ? t('campaigns.doctrines.on') : t('campaigns.doctrines.off')}</FilterChip>
                                {!fitting.doctrine_id ?
                                    <StylessButton
                                        type="button"
                                        class="[ campaign-icon-button ]"
                                        aria-label={`${t('campaigns.manage.remove')} ${fitting.name}`}
                                        hx-post={PART_URL}
                                        hx-vals={JSON.stringify({ op: 'remove', row_id: String(fitting.id) })}
                                    ><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></StylessButton>
                                    :
                                    <span class="[ campaign-icon-spacer ]" aria-hidden="true"></span>
                                }
                            </li>
                        ))}
                    </ul>
                }
                <div class="[ manage-fields ]">
                    <ManageField label={t('campaigns.doctrines.outside')} for="campaign-fittings-fitting">
                        <Select id="campaign-fittings-fitting" size="sm" name="fitting_id">
                            <option value="">{t('campaigns.manage.pick_fitting')}</option>
                            {fittings.map((fitting) => <option value={fitting.id}>{fitting.name}</option>)}
                        </Select>
                    </ManageField>
                    <ManageField label={t('campaigns.manage.fitting_role')} for="campaign-fittings-role" hint={t('campaigns.manage.fitting_role_hint')}>
                        <Input id="campaign-fittings-role" size="sm" name="role_label" maxlength="64" />
                    </ManageField>
                </div>
                <div class="[ manage-actions ]">
                    <Button type="submit" size="sm" name="op" value="add">{t('campaigns.manage.add')}</Button>
                    {error_message && <span class="[ manage-field__error ]" role="alert">{error_message}</span>}
                    {saved && <span class="[ manage-saved ]">{t('campaigns.manage.saved')}</span>}
                </div>
            </Fragment>
        }

        {part === 'targets' &&
            <Fragment>
                {settings.week_targets.length === 0 ?
                    <p class="[ manage-muted ]">{t('campaigns.manage.targets_empty')}</p>
                    :
                    <ManageTable
                        caption={t('campaigns.manage.targets_caption')}
                        columns={[
                            { label: t('campaigns.manage.system') },
                            { label: t('campaigns.manage.metric') },
                            { label: t('campaigns.manage.progress'), align: 'num' },
                            { label: t('campaigns.manage.target') },
                            { label: t('campaigns.manage.target_state') },
                        ]}
                        expandable={false}
                        min_width="36rem"
                    >
                            <tbody>
                                {settings.week_targets.map((row) => (
                                    <tr>
                                        <td><span class="[ manage-who__name ]">{row.system}</span></td>
                                        <td>{choice_label(choices.metric, row.metric)}</td>
                                        <td class="num">{format_number(row.progress)}</td>
                                        <td>
                                            <Input
                                                size="sm"
                                                width="8rem"
                                                type="number"
                                                step="any"
                                                name={`target_${row.id}`}
                                                value={row.target}
                                                class="[ manage-amount ]"
                                                aria-label={`${t('campaigns.manage.target')}: ${row.system}, ${choice_label(choices.metric, row.metric)}`}
                                            />
                                        </td>
                                        <td class:list={[row.proposed ? 'manage-warn' : 'manage-good']}>
                                            {row.proposed ? t('campaigns.manage.proposed') : t('campaigns.manage.accepted')}
                                        </td>
                                    </tr>
                                ))}
                            </tbody>
                    </ManageTable>
                }
                <div class="[ manage-actions ]">
                    {settings.week_targets.length > 0 &&
                        <Button type="submit" size="sm" name="op" value="accept">{t('campaigns.manage.accept_targets')}</Button>
                    }
                    <Button type="submit" color="transparent" size="sm" name="op" value="propose">{t('campaigns.manage.propose_again')}</Button>
                    {error_message && <span class="[ manage-field__error ]" role="alert">{error_message}</span>}
                    {saved && <span class="[ manage-saved ]">{t('campaigns.manage.saved')}</span>}
                </div>
            </Fragment>
        }

        {part === 'order' &&
            <Fragment>
                <div class="[ manage-fields campaign-order ]">
                    <ManageField
                        label={settings.commander_order_is_draft ? `${t('campaigns.manage.order_text')} ${t('campaigns.manage.order_draft_suffix')}` : t('campaigns.manage.order_text')}
                        for="campaign-order-text"
                        hint={t('campaigns.manage.order_hint')}
                    >
                        <Input id="campaign-order-text" size="sm" name="text" value={settings.commander_order_text} maxlength="280" />
                    </ManageField>
                </div>
                <div class="[ manage-actions ]">
                    <Button type="submit" size="sm" name="op" value="publish">{t('campaigns.manage.order_publish')}</Button>
                    <Button type="submit" color="transparent" size="sm" name="op" value="draft">{t('campaigns.manage.order_draft')}</Button>
                    {settings.commander_order_is_draft &&
                        <Button type="submit" color="transparent" size="sm" name="op" value="publish_draft">{t('campaigns.manage.order_publish_draft')}</Button>
                    }
                    {error_message && <span class="[ manage-field__error ]" role="alert">{error_message}</span>}
                    {saved && <span class="[ manage-saved ]">{t('campaigns.manage.saved')}</span>}
                </div>
            </Fragment>
        }

        {part === 'structures' &&
            <Fragment>
                {settings.structures.length === 0 ?
                    <p class="[ manage-muted ]">{t('campaigns.manage.none_yet')}</p>
                    :
                    <ul class="[ campaign-list ]" role="list">
                        {settings.structures.map((structure) => (
                            <li class="[ campaign-list__row ]">
                                <span class="[ campaign-list__name ]">
                                    <span class="[ manage-who__name ]">{structure.name}</span>
                                    <span class="[ manage-who__sub ]">{[structure.structure_type, structure.system_name].filter(Boolean).join(' · ')}</span>
                                </span>
                            </li>
                        ))}
                    </ul>
                }
                <div class="[ manage-actions ]">
                    {has_structures_tab
                        ? <Button color="transparent" size="sm" href="#structures">{t('campaigns.manage.structures_open')}</Button>
                        : <span class="[ manage-muted ]">{t('campaigns.manage.structures_scout')}</span>
                    }
                </div>
            </Fragment>
        }

        {part === 'coordination' && coordination &&
            <Fragment>
                <ul class="[ campaign-list ]" role="list">
                    <li class="[ campaign-list__row campaign-server ]">
                        <span class="[ campaign-list__name ]">
                            <ManageField label={t('campaigns.manage.coordination_server')} for="campaign-coordination-server">
                                <Select
                                    id="campaign-coordination-server"
                                    size="sm"
                                    name="guild_id"
                                    hx-get={PART_URL}
                                    hx-trigger="change"
                                    hx-include="this"
                                    hx-target={`#${body_id}`}
                                    hx-swap="outerHTML"
                                >
                                    {coordination.servers.map((server) =>
                                        <option value={server.id} selected={server.id === coordination.guild_id}>{server.name}</option>
                                    )}
                                </Select>
                            </ManageField>
                            <span class="[ manage-who__sub ]">{t('campaigns.discord.ours')}</span>
                        </span>
                        {DISCORD_CHANNEL_SLOTS.map((slot) =>
                            <ManageField label={t(discord_channel_label_key(slot))} for={`campaign-coordination-${slot}`}>
                                <Select id={`campaign-coordination-${slot}`} size="sm" name={`${slot}_channel_id`} disabled={coordination.channels.length === 0}>
                                    <option value="">{coordination.channels.length === 0 ? t('campaigns.discord.needs_bot') : t('campaigns.manage.coordination_none')}</option>
                                    {coordination.channels.map((channel) => <option value={channel.id} selected={channel.id === coordination[`${slot}_channel_id`]}>#{channel.name}</option>)}
                                </Select>
                            </ManageField>
                        )}
                        {coordination.invite_url && !(coordination.servers.find((server) => server.id === coordination.guild_id)?.is_administrator) ?
                            <Button size="sm" href={BOT_CONNECT_URL('ours')}>{t('campaigns.discord.add_bot')}</Button>
                            :
                            <span class="[ campaign-icon-spacer ]" aria-hidden="true"></span>
                        }
                    </li>
                    {links.map((link) =>
                        <li class="[ campaign-list__row campaign-server ]">
                            <input type="hidden" name="link_id" value={String(link.id)} />
                            <span class="[ campaign-list__name ]">
                                <span class="[ manage-who__name ]">{link.guild_name || link.guild_id}</span>
                                {link.linked_by && <span class="[ manage-who__sub ]">{t('campaigns.discord.linked_by').replace('{name}', link.linked_by)}</span>}
                            </span>
                            {DISCORD_CHANNEL_SLOTS.map((slot) =>
                                <ManageField label={t(discord_channel_label_key(slot))} for={`campaign-link-${slot}-${link.id}`}>
                                    <Select id={`campaign-link-${slot}-${link.id}`} size="sm" name={`link_${slot}_${link.id}`}>
                                        <option value="">{t('campaigns.manage.coordination_none')}</option>
                                        {link.channels.map((channel) => <option value={channel.id} selected={channel.id === link[`${slot}_channel_id`]}>#{channel.name}</option>)}
                                    </Select>
                                </ManageField>
                            )}
                            <StylessButton
                                type="button"
                                class="[ campaign-icon-button ]"
                                aria-label={t('campaigns.discord.remove').replace('{name}', link.guild_name || link.guild_id)}
                                hx-post={PART_URL}
                                hx-vals={JSON.stringify({ op: 'remove_link', link_id: String(link.id) })}
                            ><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></StylessButton>
                        </li>
                    )}
                </ul>
                <div class="[ manage-actions ]">
                    <Button type="submit" size="sm" color="green">{t('campaigns.manage.save')}</Button>
                    {coordination.link_url &&
                        <Button color="transparent" size="sm" href={BOT_CONNECT_URL('link')}>{t('campaigns.discord.link_server')}</Button>
                    }
                    {error_message && <span class="[ manage-field__error ]" role="alert">{error_message}</span>}
                    {saved && <span class="[ manage-saved ]">{t('campaigns.manage.saved')}</span>}
                </div>
            </Fragment>
        }

        {is_post && !is_preview && <SectionSummary section_id={section_id} text={summary_for(settings)} />}
    </form>
}

<style lang="scss">
    .campaign-features {
        display: flex;
        flex-direction: column;
        gap: var(--space-s);
    }

    .campaign-settings :global(select) {
        min-width: 8rem;
    }

    .campaign-systems__name {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2xs);
    }

    .campaign-systems__row.is-new > td {
        background: color-mix(in srgb, var(--fleet-yellow) var(--tint-subtle), transparent);
    }

    .campaign-systems__action {
        font-family: var(--button-font);
        font-weight: 600;
        color: var(--highlight);
        cursor: pointer;
        white-space: nowrap;
        background: none;
        border: 0;
        padding: var(--space-3xs) var(--space-2xs);
    }

    .campaign-systems__retire-on {
        display: none;
    }

    .campaign-systems__row:has(.campaign-systems__retire input:checked) {
        > td { opacity: 0.5; }
        > td.act { opacity: 1; }

        .campaign-systems__retire-on { display: inline; }
        .campaign-systems__retire-off { display: none; }
    }

    .campaign-systems__retire:has(input:focus-visible) {
        outline: 2px solid var(--highlight);
        outline-offset: 2px;
    }

    .campaign-systems__foot {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: var(--space-s);
    }

    .campaign-systems__add {
        flex: 0 1 22rem;
        min-width: 0;
    }

    .campaign-list {
        display: flex;
        flex-direction: column;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .campaign-list__row {
        display: flex;
        align-items: center;
        gap: var(--space-s);
        padding-block: var(--space-2xs);
        border-block-end: 1px solid var(--border-color);
    }

    .campaign-list__name {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        min-width: 0;
    }

    .campaign-sides-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
        gap: var(--space-l);
    }

    .campaign-sides-col {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        min-width: 0;
    }

    .campaign-sides-col__label {
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-size: var(--step--2);
    }

    [data-side='enemy'] > .campaign-sides-col__label { color: var(--fleet-red); }
    [data-side='ally'] > .campaign-sides-col__label { color: var(--alliance-blue-300); }
    [data-side='third_party'] > .campaign-sides-col__label { color: var(--fleet-yellow); }

    .campaign-sides-add {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        padding-block-start: var(--space-2xs);
    }

    .campaign-icon-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        inline-size: 2.75rem;
        block-size: 2.75rem;
        flex: none;
        background: none;
        border: 0;
        color: var(--faded);
        cursor: pointer;

        @media (hover: hover) {
            &:hover { color: var(--highlight); }
        }
    }

    .campaign-icon-spacer {
        inline-size: 2.75rem;
        flex: none;
    }

    .campaign-portrait {
        inline-size: 2.5rem;
        block-size: 2.5rem;
        flex: none;
    }

    .campaign-list__row.is-off > :not(.filter-chip) {
        opacity: 0.5;
    }

    .campaign-fitting__role {
        flex: 0 0 8rem;
    }

    .campaign-doctrines {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2xs);
    }

    .campaign-server {
        flex-wrap: wrap;
        align-items: flex-end;

        > :global(.manage-field) {
            flex: 1 1 12rem;
        }
    }

    @media (max-width: 48rem) {
        .campaign-systems__add {
            flex-basis: 100%;
        }
    }
</style>
