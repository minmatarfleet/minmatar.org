---
/**
 * The bodies of the campaign Settings tab's sections (CampaignSettingsPanel).
 * Each `part` GETs its form and POSTs back to itself; the form swaps only
 * itself and sends the section's summary out of band.
 *
 * part=basics     name, tagline, status, start and end (EVE time)
 * part=systems    goal, role and priority per system, retire, add by name; one Save
 *                 (op=preview re-renders with a picked system added as a New row)
 * part=sides      enemies and allies picked by name
 * part=fittings   the campaign's fittings
 * part=targets    this week's targets: accept, nudge, propose again
 * part=order      the commander's order: publish, draft from the week plan
 * part=structures the structures under recon (added from the Structures tab)
 */
import { i18n } from '@helpers/i18n'
const { t, lang, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'
import { get_gates, can } from '@helpers/gates'
import {
    get_campaign_settings,
    get_campaign_choices,
    change_campaign,
    type CampaignChoices,
} from '@helpers/api.minmatar.org/campaigns'
import { get_fittings } from '@helpers/api.minmatar.org/ships'
import type { CampaignSettings, Fitting } from '@dtypes/api.minmatar.org'
import { form_text } from '@helpers/manage_forms'
import { query_string } from '@helpers/string'
import {
    choice_label,
    systems_summary,
    sides_summary,
    eve_weekday_date,
    refusal_text,
} from '@helpers/campaign_manage'

const { auth_token, user } = get_request_user(Astro)
if (!user || !auth_token) return HTTP_403_Forbidden()

const gates = await get_gates(Astro)
if (!can(gates, 'campaigns.manage')) return HTTP_403_Forbidden()

const params = Astro.url.searchParams
const slug = params.get('slug') ?? ''
if (!/^[a-z0-9-]+$/.test(slug)) return HTTP_403_Forbidden()

const PARTS = ['basics', 'systems', 'sides', 'fittings', 'targets', 'order', 'structures'] as const
type Part = typeof PARTS[number]
const part = (PARTS as readonly string[]).includes(params.get('part') ?? '') ? params.get('part') as Part : 'basics'
const has_structures_tab = params.get('tab') === '1'

const PART_URL = translatePath(`/partials/campaign_settings_component/?${query_string({ slug, part, ...(has_structures_tab ? { tab: '1' } : {}) })}`)
const section_id = `campaign-settings-${part}`
const body_id = `${section_id}-body`

const is_post = Astro.request.method === 'POST'
const form = is_post ? await Astro.request.formData() : null
const field = (name: string) => form ? form_text(form, name) : ''
const op = field('op')
const is_preview = is_post && part === 'systems' && op !== 'save'

/** A row of the systems table, from the stored system or from the posted form. */
interface SystemRow {
    key:                string;
    id:                 number | null;
    solar_system_id:    number;
    name:               string;
    goal:               string;
    role:               string;
    priority:           string;
    retire:             boolean;
    is_new:             boolean;
    error?:             string;
}

let saved = false
let error_message = ''
const row_errors: Record<string, string> = {}
const pending_new: SystemRow[] = []

const posted_number = (name: string) => {
    const value = parseInt(field(name))
    return Number.isFinite(value) ? value : null
}

async function load() {
    return await get_campaign_settings(slug, auth_token as string)
}

let settings: CampaignSettings | null = null
let choices: CampaignChoices | null = null
let fittings: Fitting[] = []
let fetch_error: Error | false = false

try {
    [ settings, choices ] = await Promise.all([ load(), get_campaign_choices(auth_token) ])
} catch (error) {
    fetch_error = error
}

/** Rows as posted: existing systems keep their stored name; new ones carry theirs. */
function posted_rows(current: CampaignSettings): SystemRow[] {
    if (!form) return []
    const stored = new Map(current.systems.map((system) => [`e${system.id}`, system]))
    const rows: SystemRow[] = []
    for (const key of form.getAll('row').map(String)) {
        const values = {
            goal: field(`goal_${key}`),
            role: field(`role_${key}`),
            priority: field(`priority_${key}`),
            retire: field(`retire_${key}`) === 'on',
        }
        const system = stored.get(key)
        if (system) {
            rows.push({ key, id: system.id, solar_system_id: system.solar_system_id, name: system.name, is_new: false, ...values })
        } else if (/^n\d+$/.test(key)) {
            rows.push({ key, id: null, solar_system_id: parseInt(key.slice(1)), name: field(`name_${key}`), is_new: true, ...values, retire: false })
        }
    }
    return rows
}

function stored_rows(current: CampaignSettings): SystemRow[] {
    return current.systems
        .filter((system) => !system.retired)
        .map((system) => ({
            key: `e${system.id}`,
            id: system.id,
            solar_system_id: system.solar_system_id,
            name: system.name,
            goal: system.goal,
            role: system.role,
            priority: system.priority,
            retire: false,
            is_new: false,
        }))
}

let rows: SystemRow[] = []

if (is_post && settings && choices) {
    const current = settings
    try {
        switch (part) {
            case 'basics':
                await change_campaign(slug, auth_token, 'PATCH', '/settings', {
                    name: field('name'),
                    tagline: field('tagline'),
                    status: field('status'),
                    start_at: field('start_at') || undefined,
                    end_at: field('end_at') || undefined,
                })
                saved = true
                break
            case 'systems': {
                const posted = posted_rows(current)
                const added_id = posted_number('add_system_id')
                const live = (solar_id: number) => current.systems.some((system) => !system.retired && system.solar_system_id === solar_id)
                if (added_id && !posted.some((row) => row.solar_system_id === added_id) && !live(added_id)) {
                    posted.push({
                        key: `n${added_id}`,
                        id: null,
                        solar_system_id: added_id,
                        name: field('add_system_name'),
                        goal: 'take',
                        role: 'primary',
                        priority: 'medium',
                        retire: false,
                        is_new: true,
                    })
                }
                if (is_preview) {
                    rows = posted
                    break
                }
                const stored = new Map(current.systems.map((system) => [system.id, system]))
                for (const row of posted) {
                    try {
                        if (row.is_new) {
                            await change_campaign(slug, auth_token, 'POST', '/systems', {
                                solar_system_id: row.solar_system_id,
                                goal: row.goal,
                                role: row.role,
                                priority: row.priority,
                            })
                        } else if (row.retire && row.id) {
                            await change_campaign(slug, auth_token, 'DELETE', `/systems/${row.id}`)
                        } else if (row.id) {
                            const before = stored.get(row.id)
                            if (before && (before.goal !== row.goal || before.role !== row.role || before.priority !== row.priority)) {
                                await change_campaign(slug, auth_token, 'PATCH', `/systems/${row.id}`, {
                                    goal: row.goal,
                                    role: row.role,
                                    priority: row.priority,
                                })
                            }
                        }
                    } catch (error) {
                        row_errors[row.key] = refusal_text(error, t('campaigns.action_failed'))
                        if (row.is_new) pending_new.push({ ...row, error: row_errors[row.key] })
                    }
                }
                saved = Object.keys(row_errors).length === 0
                break
            }
            case 'sides':
                if (op === 'remove') {
                    await change_campaign(slug, auth_token, 'DELETE', `/parties/${posted_number('party_id')}`)
                } else {
                    const kind = field('kind')
                    if (!['alliance', 'corporation', 'character'].includes(kind)) throw new Error(t('campaigns.manage.pick_first'))
                    const entity_id = posted_number(`${kind}_id`)
                    const name = field(`${kind}_name`)
                    if (!entity_id || !name) throw new Error(t('campaigns.manage.pick_first'))
                    await change_campaign(slug, auth_token, 'POST', '/parties', {
                        name,
                        kind,
                        side: field('side'),
                        [`${kind}_id`]: entity_id,
                    })
                }
                saved = true
                break
            case 'fittings':
                if (op === 'remove') {
                    await change_campaign(slug, auth_token, 'DELETE', `/fittings/${posted_number('row_id')}`)
                } else {
                    const fitting_id = posted_number('fitting_id')
                    if (!fitting_id) throw new Error(t('campaigns.manage.pick_fitting'))
                    await change_campaign(slug, auth_token, 'POST', '/fittings', {
                        fitting_id,
                        role_label: field('role_label'),
                    })
                }
                saved = true
                break
            case 'targets':
                if (op === 'propose') {
                    await change_campaign(slug, auth_token, 'POST', '/week/propose')
                } else {
                    for (const row of current.week_targets) {
                        const value = parseFloat(field(`target_${row.id}`))
                        if (Number.isFinite(value))
                            await change_campaign(slug, auth_token, 'PATCH', `/week/${row.id}`, { target: value })
                    }
                }
                saved = true
                break
            case 'order':
                if (op === 'draft') {
                    await change_campaign(slug, auth_token, 'POST', '/commander-order/draft')
                } else if (op === 'publish_draft') {
                    await change_campaign(slug, auth_token, 'POST', '/commander-order/publish')
                } else {
                    await change_campaign(slug, auth_token, 'POST', '/commander-order', { text: field('text') })
                }
                saved = true
                break
        }
    } catch (error) {
        error_message = refusal_text(error, t('campaigns.action_failed'))
    }
    // Reload after a write, so the form and the summary show what is stored.
    if (!is_preview) {
        try {
            settings = await load()
        } catch (error) {
            fetch_error = error
        }
    }
}

if (settings && part === 'systems' && !is_preview)
    rows = [...stored_rows(settings), ...pending_new]

if (settings && part === 'fittings') {
    try {
        fittings = (await get_fittings()).sort((a, b) => a.name.localeCompare(b.name))
    } catch (error) {
        console.log(`Could not load fittings: ${error.message}`)
    }
}

const retired = settings?.systems.filter((system) => system.retired && !rows.some((row) => row.solar_system_id === system.solar_system_id)) ?? []

function summary_for(current: CampaignSettings): string {
    switch (part) {
        case 'basics': {
            const status = choice_label(choices?.status, current.status)
            const ends = t('campaigns.manage.ends_on').replace('~DATE', eve_weekday_date(lang, current.end_at))
            return [current.tagline && `"${current.tagline}"`, status, ends].filter(Boolean).join(' · ')
        }
        case 'systems':
            return systems_summary(current.systems, choices?.goal) || t('campaigns.manage.none_yet')
        case 'sides':
            return sides_summary(current.parties, choices?.party_side) || t('campaigns.manage.none_yet')
        case 'fittings':
            return current.fittings.map((fitting) => fitting.role_label ? `${fitting.name} (${fitting.role_label})` : fitting.name).join(' · ') || t('campaigns.manage.none_yet')
        case 'targets': {
            const count = current.week_targets.length
            if (count === 0) return t('campaigns.manage.targets_none')
            const proposed = current.week_targets.filter((row) => row.proposed).length
            return [
                count === 1 ? t('campaigns.manage.targets_count_one') : t('campaigns.manage.targets_count').replace('~COUNT', String(count)),
                proposed > 0 ? t('campaigns.manage.targets_proposed').replace('~COUNT', String(proposed)) : '',
            ].filter(Boolean).join(' · ')
        }
        case 'order':
            return current.commander_order_text
                ? `${current.commander_order_text}${current.commander_order_is_draft ? ` ${t('campaigns.manage.order_draft_suffix')}` : ''}`
                : t('campaigns.manage.order_none')
        case 'structures':
            return current.structures.length === 0
                ? t('campaigns.manage.none_yet')
                : current.structures.length === 1
                    ? t('campaigns.manage.structures_count_one')
                    : t('campaigns.manage.structures_count').replace('~COUNT', String(current.structures.length))
    }
}

const PARTY_KINDS = ['alliance', 'corporation', 'character'] as const
const party_kind_label = (kind: string) =>
    kind === 'alliance' ? t('campaigns.manage.party_alliance')
        : kind === 'corporation' ? t('campaigns.manage.party_corporation')
            : kind === 'character' ? t('campaigns.manage.party_character')
                : choice_label(choices?.party_kind, kind)

const format_number = (value: number) => value.toLocaleString(lang, { maximumFractionDigits: 1 })

import Button from '@components/blocks/Button.astro'
import Input from '@components/blocks/Input.astro'
import Select from '@components/blocks/Select.astro'
import Tag from '@components/blocks/Tag.astro'
import EmptyState from '@components/blocks/EmptyState.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import XFadeScroll from '@components/compositions/XFadeScroll.astro'
import ManageField from '@components/blocks/manage/ManageField.astro'
import EntityPicker from '@components/blocks/manage/EntityPicker.astro'
import EveTimeInput from '@components/blocks/manage/EveTimeInput.astro'
import SectionSummary from '@components/blocks/manage/SectionSummary.astro'
---

{fetch_error || !settings || !choices ?
    <div id={body_id} class="[ manage-section__body ]">
        <ErrorRefetch
            args={{
                partial: PART_URL,
                error: fetch_error || new Error(t('campaigns.action_failed')),
                delay: 0,
                target: `#${body_id}`,
            }}
        />
    </div>
    :
    <form
        id={body_id}
        class="[ manage-section__body manage-form campaign-settings ]"
        hx-post={PART_URL}
        hx-target="this"
        hx-swap="outerHTML"
    >
        {part === 'basics' &&
            <Fragment>
                <div class="[ manage-fields ]">
                    <ManageField label={t('campaigns.manage.name')} for="campaign-basics-name">
                        <Input id="campaign-basics-name" size="sm" name="name" value={settings.name} maxlength="128" required />
                    </ManageField>
                    <ManageField label={t('campaigns.manage.tagline')} for="campaign-basics-tagline" hint={t('campaigns.manage.tagline_hint')}>
                        <Input id="campaign-basics-tagline" size="sm" name="tagline" value={settings.tagline} maxlength="200" />
                    </ManageField>
                    <ManageField label={t('campaigns.manage.status')} for="campaign-basics-status">
                        <Select id="campaign-basics-status" size="sm" name="status">
                            {choices.status.map((choice) => <option value={choice.value} selected={choice.value === settings.status}>{choice.label}</option>)}
                        </Select>
                    </ManageField>
                    <EveTimeInput id="campaign-basics-start" name="start_at" label={t('campaigns.manage.starts')} value={settings.start_at} required />
                    <EveTimeInput id="campaign-basics-end" name="end_at" label={t('campaigns.manage.ends')} value={settings.end_at} required />
                </div>
                <div class="[ manage-actions ]">
                    <Button type="submit" size="sm">{t('campaigns.manage.save')}</Button>
                    {error_message && <span class="[ manage-field__error ]" role="alert">{error_message}</span>}
                    {saved && <span class="[ manage-saved ]">{t('campaigns.manage.saved')}</span>}
                </div>
            </Fragment>
        }

        {part === 'systems' &&
            <Fragment>
                {rows.length === 0 ?
                    <EmptyState title={t('campaigns.manage.no_systems')} />
                    :
                    <XFadeScroll>
                        <table class="[ manage-table campaign-systems ]" style="--manage_table_min_width: 40rem">
                            <caption class="[ visually-hidden ]">{t('campaigns.manage.systems_caption')}</caption>
                            <thead>
                                <tr>
                                    <th scope="col">{t('campaigns.manage.system')}</th>
                                    <th scope="col">{t('campaigns.manage.goal')}</th>
                                    <th scope="col">{t('campaigns.manage.role')}</th>
                                    <th scope="col">{t('campaigns.manage.priority')}</th>
                                    <th scope="col" class="act"><span class="[ visually-hidden ]">{t('campaigns.manage.retire')}</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                {rows.map((row) => (
                                    <tr class:list={['[ campaign-systems__row ]', { 'is-new': row.is_new }]}>
                                        <td>
                                            <input type="hidden" name="row" value={row.key} />
                                            {row.is_new && <input type="hidden" name={`name_${row.key}`} value={row.name} />}
                                            <span class="[ campaign-systems__name ]">
                                                <span class="[ manage-who__name ]">{row.name}</span>
                                                {row.is_new && <Tag text={t('campaigns.manage.new_badge')} color="fleet-yellow" />}
                                            </span>
                                            {(row_errors[row.key] || row.error) &&
                                                <span class="[ manage-field__error ]" role="alert">{row_errors[row.key] || row.error}</span>
                                            }
                                        </td>
                                        <td>
                                            <Select size="sm" name={`goal_${row.key}`} aria-label={`${t('campaigns.manage.goal')}: ${row.name}`}>
                                                {choices.goal.map((choice) => <option value={choice.value} selected={choice.value === row.goal}>{choice.label}</option>)}
                                            </Select>
                                        </td>
                                        <td>
                                            <Select size="sm" name={`role_${row.key}`} aria-label={`${t('campaigns.manage.role')}: ${row.name}`}>
                                                {choices.role.map((choice) => <option value={choice.value} selected={choice.value === row.role}>{choice.label}</option>)}
                                            </Select>
                                        </td>
                                        <td>
                                            <Select size="sm" name={`priority_${row.key}`} aria-label={`${t('campaigns.manage.priority')}: ${row.name}`}>
                                                {choices.priority.map((choice) => <option value={choice.value} selected={choice.value === row.priority}>{choice.label}</option>)}
                                            </Select>
                                        </td>
                                        <td class="act">
                                            {row.is_new ?
                                                <button
                                                    type="button"
                                                    class="[ campaign-systems__action ]"
                                                    aria-label={t('campaigns.manage.remove_system').replace('~NAME', row.name)}
                                                    x-data
                                                    x-on:click="$el.closest('tr').remove()"
                                                >
                                                    {t('campaigns.manage.remove')}
                                                </button>
                                                :
                                                <label class="[ campaign-systems__action campaign-systems__retire ]">
                                                    <input type="checkbox" name={`retire_${row.key}`} checked={row.retire} class="[ visually-hidden ]" />
                                                    <span class="[ campaign-systems__retire-off ]">{t('campaigns.manage.retire')}</span>
                                                    <span class="[ campaign-systems__retire-on ]">{t('campaigns.manage.undo')}</span>
                                                </label>
                                            }
                                        </td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </XFadeScroll>
                }
                {retired.length > 0 &&
                    <p class="[ manage-muted ]">{t('campaigns.manage.retired_systems').replace('~NAMES', retired.map((system) => system.name).join(', '))}</p>
                }
                <div class="[ campaign-systems__foot ]">
                    <div
                        class="[ campaign-systems__add ]"
                        hx-post={PART_URL}
                        hx-vals='{"op": "preview"}'
                        hx-trigger="manage-entity-picked"
                        hx-include="closest form"
                    >
                        <EntityPicker
                            id="campaign-systems-add"
                            kind="system"
                            name="add_system_id"
                            name_field="add_system_name"
                            label={t('campaigns.manage.add_system')}
                            placeholder={t('campaigns.manage.add_system')}
                        />
                    </div>
                    <div class="[ manage-actions ]">
                        <Button type="button" color="transparent" size="sm" hx-get={PART_URL}>{t('campaigns.manage.discard')}</Button>
                        <Button type="submit" size="sm" name="op" value="save">{t('campaigns.manage.save_systems')}</Button>
                        {saved && <span class="[ manage-saved ]">{t('campaigns.manage.saved')}</span>}
                    </div>
                </div>
            </Fragment>
        }

        {part === 'sides' &&
            <Fragment>
                {settings.parties.length === 0 ?
                    <p class="[ manage-muted ]">{t('campaigns.manage.no_sides')}</p>
                    :
                    <ul class="[ campaign-list ]" role="list">
                        {settings.parties.map((party) => (
                            <li class="[ campaign-list__row ]">
                                <span class="[ campaign-list__name ]">
                                    <span class="[ manage-who__name ]">{party.name}{party.ticker && ` [${party.ticker}]`}</span>
                                    <span class="[ manage-who__sub ]">{party_kind_label(party.kind)}</span>
                                </span>
                                <Tag text={choice_label(choices.party_side, party.side)} color={party.side === 'enemy' ? 'fleet-red' : 'alliance-blue'} />
                                <Button
                                    type="button"
                                    color="transparent"
                                    size="sm"
                                    hx-post={PART_URL}
                                    hx-vals={JSON.stringify({ op: 'remove', party_id: String(party.id) })}
                                >{t('campaigns.manage.remove')}</Button>
                            </li>
                        ))}
                    </ul>
                }
                <div class="[ manage-fields ]" x-data="{ kind: 'alliance' }">
                    <ManageField label={t('campaigns.manage.side')} for="campaign-sides-side">
                        <Select id="campaign-sides-side" size="sm" name="side">
                            {choices.party_side.map((choice) => <option value={choice.value}>{choice.label}</option>)}
                        </Select>
                    </ManageField>
                    <ManageField label={t('campaigns.manage.party_kind')} for="campaign-sides-kind">
                        <Select id="campaign-sides-kind" size="sm" name="kind" x-model="kind">
                            {PARTY_KINDS.map((kind) => <option value={kind}>{party_kind_label(kind)}</option>)}
                        </Select>
                    </ManageField>
                    {PARTY_KINDS.map((kind) => (
                        <EntityPicker
                            id={`campaign-sides-${kind}`}
                            kind={kind}
                            name={`${kind}_id`}
                            name_field={`${kind}_name`}
                            label={party_kind_label(kind)}
                            x-show={`kind === '${kind}'`}
                            style={kind === 'alliance' ? undefined : 'display: none'}
                        />
                    ))}
                </div>
                <div class="[ manage-actions ]">
                    <Button type="submit" size="sm" name="op" value="add">{t('campaigns.manage.add_side')}</Button>
                    {error_message && <span class="[ manage-field__error ]" role="alert">{error_message}</span>}
                    {saved && <span class="[ manage-saved ]">{t('campaigns.manage.saved')}</span>}
                </div>
            </Fragment>
        }

        {part === 'fittings' &&
            <Fragment>
                {settings.fittings.length === 0 ?
                    <p class="[ manage-muted ]">{t('campaigns.manage.no_fittings')}</p>
                    :
                    <ul class="[ campaign-list ]" role="list">
                        {settings.fittings.map((fitting) => (
                            <li class="[ campaign-list__row ]">
                                <span class="[ campaign-list__name ]">
                                    <span class="[ manage-who__name ]">{fitting.name}</span>
                                    {(fitting.ship_name || fitting.role_label) &&
                                        <span class="[ manage-who__sub ]">{[fitting.ship_name, fitting.role_label].filter(Boolean).join(' · ')}</span>
                                    }
                                </span>
                                <Button
                                    type="button"
                                    color="transparent"
                                    size="sm"
                                    hx-post={PART_URL}
                                    hx-vals={JSON.stringify({ op: 'remove', row_id: String(fitting.id) })}
                                >{t('campaigns.manage.remove')}</Button>
                            </li>
                        ))}
                    </ul>
                }
                <div class="[ manage-fields ]">
                    <ManageField label={t('campaigns.manage.fitting')} for="campaign-fittings-fitting">
                        <Select id="campaign-fittings-fitting" size="sm" name="fitting_id">
                            <option value="">{t('campaigns.manage.pick_fitting')}</option>
                            {fittings.map((fitting) => <option value={fitting.id}>{fitting.name}</option>)}
                        </Select>
                    </ManageField>
                    <ManageField label={t('campaigns.manage.fitting_role')} for="campaign-fittings-role" hint={t('campaigns.manage.fitting_role_hint')}>
                        <Input id="campaign-fittings-role" size="sm" name="role_label" maxlength="64" />
                    </ManageField>
                </div>
                <div class="[ manage-actions ]">
                    <Button type="submit" size="sm" name="op" value="add">{t('campaigns.manage.add')}</Button>
                    {error_message && <span class="[ manage-field__error ]" role="alert">{error_message}</span>}
                    {saved && <span class="[ manage-saved ]">{t('campaigns.manage.saved')}</span>}
                </div>
            </Fragment>
        }

        {part === 'targets' &&
            <Fragment>
                {settings.week_targets.length === 0 ?
                    <p class="[ manage-muted ]">{t('campaigns.manage.targets_empty')}</p>
                    :
                    <XFadeScroll>
                        <table class="[ manage-table ]" style="--manage_table_min_width: 36rem">
                            <caption class="[ visually-hidden ]">{t('campaigns.manage.targets_caption')}</caption>
                            <thead>
                                <tr>
                                    <th scope="col">{t('campaigns.manage.system')}</th>
                                    <th scope="col">{t('campaigns.manage.metric')}</th>
                                    <th scope="col" class="num">{t('campaigns.manage.progress')}</th>
                                    <th scope="col">{t('campaigns.manage.target')}</th>
                                    <th scope="col">{t('campaigns.manage.target_state')}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {settings.week_targets.map((row) => (
                                    <tr>
                                        <td><span class="[ manage-who__name ]">{row.system}</span></td>
                                        <td>{choice_label(choices.metric, row.metric)}</td>
                                        <td class="num">{format_number(row.progress)}</td>
                                        <td>
                                            <Input
                                                size="sm"
                                                width="8rem"
                                                type="number"
                                                step="any"
                                                name={`target_${row.id}`}
                                                value={row.target}
                                                class="[ manage-amount ]"
                                                aria-label={`${t('campaigns.manage.target')}: ${row.system}, ${choice_label(choices.metric, row.metric)}`}
                                            />
                                        </td>
                                        <td class:list={[row.proposed ? 'manage-warn' : 'manage-good']}>
                                            {row.proposed ? t('campaigns.manage.proposed') : t('campaigns.manage.accepted')}
                                        </td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </XFadeScroll>
                }
                <div class="[ manage-actions ]">
                    {settings.week_targets.length > 0 &&
                        <Button type="submit" size="sm" name="op" value="accept">{t('campaigns.manage.accept_targets')}</Button>
                    }
                    <Button type="submit" color="transparent" size="sm" name="op" value="propose">{t('campaigns.manage.propose_again')}</Button>
                    {error_message && <span class="[ manage-field__error ]" role="alert">{error_message}</span>}
                    {saved && <span class="[ manage-saved ]">{t('campaigns.manage.saved')}</span>}
                </div>
            </Fragment>
        }

        {part === 'order' &&
            <Fragment>
                <div class="[ manage-fields campaign-order ]">
                    <ManageField
                        label={settings.commander_order_is_draft ? `${t('campaigns.manage.order_text')} ${t('campaigns.manage.order_draft_suffix')}` : t('campaigns.manage.order_text')}
                        for="campaign-order-text"
                        hint={t('campaigns.manage.order_hint')}
                    >
                        <Input id="campaign-order-text" size="sm" name="text" value={settings.commander_order_text} maxlength="280" />
                    </ManageField>
                </div>
                <div class="[ manage-actions ]">
                    <Button type="submit" size="sm" name="op" value="publish">{t('campaigns.manage.order_publish')}</Button>
                    <Button type="submit" color="transparent" size="sm" name="op" value="draft">{t('campaigns.manage.order_draft')}</Button>
                    {settings.commander_order_is_draft &&
                        <Button type="submit" color="transparent" size="sm" name="op" value="publish_draft">{t('campaigns.manage.order_publish_draft')}</Button>
                    }
                    {error_message && <span class="[ manage-field__error ]" role="alert">{error_message}</span>}
                    {saved && <span class="[ manage-saved ]">{t('campaigns.manage.saved')}</span>}
                </div>
            </Fragment>
        }

        {part === 'structures' &&
            <Fragment>
                {settings.structures.length === 0 ?
                    <p class="[ manage-muted ]">{t('campaigns.manage.none_yet')}</p>
                    :
                    <ul class="[ campaign-list ]" role="list">
                        {settings.structures.map((structure) => (
                            <li class="[ campaign-list__row ]">
                                <span class="[ campaign-list__name ]">
                                    <span class="[ manage-who__name ]">{structure.name}</span>
                                    <span class="[ manage-who__sub ]">{[structure.structure_type, structure.system_name].filter(Boolean).join(' · ')}</span>
                                </span>
                            </li>
                        ))}
                    </ul>
                }
                <div class="[ manage-actions ]">
                    {has_structures_tab
                        ? <Button color="transparent" size="sm" href="#structures">{t('campaigns.manage.structures_open')}</Button>
                        : <span class="[ manage-muted ]">{t('campaigns.manage.structures_scout')}</span>
                    }
                </div>
            </Fragment>
        }

        {is_post && !is_preview && <SectionSummary section_id={section_id} text={summary_for(settings)} />}
    </form>
}

