---
import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

import { HTTP_400_Bad_Request, HTTP_403_Forbidden, partial_redirect } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'
import { get_gates, can } from '@helpers/gates'

// no-error-refetch: a form save; a refusal shows under the Share button.
// POST shares the paste and opens its report.
const { auth_token } = get_request_user(Astro)
if (!auth_token) return HTTP_403_Forbidden()

const gates = await get_gates(Astro)
if (!can(gates, 'intel.report')) return HTTP_403_Forbidden()

if (Astro.request.method !== 'POST') return HTTP_400_Bad_Request()

import { create_intel_report, type IntelPasteKind } from '@helpers/api.minmatar.org/intel'

const form = await Astro.request.formData()
const field = (key: string) => ((form.get(key) as string | null) ?? '')
const kind_field = field('kind')
const kind: IntelPasteKind | null = kind_field === 'dscan' || kind_field === 'local' ? kind_field : null

let error: string | null = null
try {
    const report = await create_intel_report(auth_token, field('text'), field('system').trim(), field('note').trim(), kind)
    return partial_redirect(Astro.request, translatePath(`/dscan/${encodeURIComponent(report.report_id)}/`))
} catch (e) {
    error = e.message
}
---

<p class="[ dscan-share-error ]" role="alert">{error}</p>

<style lang="scss">
    .dscan-share-error {
        margin: 0;
        color: var(--fleet-red-blind);
        font-size: var(--step--1);
    }
</style>
