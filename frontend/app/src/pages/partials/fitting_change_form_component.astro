---
// no-error-refetch: a mutation partial that shows the API error inline in the form result
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'

const { auth_token, user } = get_request_user(Astro)

if (!user)
    return HTTP_403_Forbidden()

import { get_gates } from '@helpers/gates'
import { can_edit_doctrines } from '@helpers/doctrine_editor'

const gates = await get_gates(Astro)

if (!await can_edit_doctrines(gates))
    return HTTP_403_Forbidden()

import type { DoctrineChangePreview } from '@dtypes/api.minmatar.org'
import { submit_fitting_change } from '@helpers/api.minmatar.org/doctrine_changes'

const fitting_id = parseInt(Astro.url.searchParams.get('fitting_id') ?? '0')

let result:DoctrineChangePreview | null = null
let error_message:string | false = false

if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData()
    const preview = form.get('intent') !== 'submit'

    try {
        result = await submit_fitting_change(auth_token as string, fitting_id, {
            eft_format: String(form.get('eft_format') ?? ''),
            description: String(form.get('description') ?? ''),
            tags: form.getAll('tags').map(String),
            preview,
        })
    } catch (error) {
        error_message = error instanceof Error ? error.message : t('doctrine_changes.action_failed')
    }
}

import ChangeDiff from '@components/blocks/ChangeDiff.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
---

<Flexblock gap="var(--space-s)">
    {error_message && <p role="alert">⚠️ {error_message}</p>}
    {result &&
        <>
            {result.request ?
                <p>
                    ✅ {t('doctrine_changes.submitted')}
                    <a href={translatePath('/ships/doctrines/review/')}>{t('doctrine_changes.review_queue')}</a>
                </p>
                :
                <strong>{t('doctrine_changes.preview_title')}</strong>
            }
            <ChangeDiff diffs={result.diffs} />
        </>
    }
</Flexblock>
