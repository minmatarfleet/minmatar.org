---
import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden } from '@helpers/http_responses'

import type { User } from '@dtypes/jwt'
import * as jose from 'jose'

const auth_token = Astro.cookies.has('auth_token')
    ? (Astro.cookies.get('auth_token')?.value as string)
    : null
const user = auth_token ? (jose.decodeJwt(auth_token) as User) : false

if (!user) return HTTP_403_Forbidden()

import {
    get_alliance_health_leave,
    post_alliance_health_status,
} from '@helpers/api.minmatar.org/alliance_health'
import type {
    AllianceHealthLeaveBucket,
    AllianceHealthLeavePilot,
} from '@dtypes/api.minmatar.org'
import AllianceHealthLeaveTable from '@components/blocks/AllianceHealthLeaveTable.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'

const user_id = parseInt(Astro.url.searchParams.get('user_id') ?? '', 10)
const action = Astro.url.searchParams.get('action')
const raw_bucket = Astro.url.searchParams.get('bucket') ?? 'current'
const bucket: AllianceHealthLeaveBucket =
    raw_bucket === 'add' ||
    raw_bucket === 'remove' ||
    raw_bucket === 'flagged' ||
    raw_bucket === 'current' ||
    raw_bucket === 'inactive' ||
    raw_bucket === 'returning'
        ? raw_bucket
        : 'current'

const initial_corp = Astro.url.searchParams.get('corp') || 'all'

let pilots: AllianceHealthLeavePilot[] = []
let data_fetching_error: any
let applied_user_id: number | null = null

if (Astro.request.method === 'POST' && action === 'leave' && user_id) {
    try {
        await post_alliance_health_status(auth_token as string, user_id, 'leave')
        applied_user_id = user_id
    } catch (error) {
        data_fetching_error = error
    }
}

try {
    const leave = await get_alliance_health_leave(auth_token as string, bucket)
    pilots = applied_user_id
        ? leave.pilots.filter((pilot) => pilot.user_id !== applied_user_id)
        : leave.pilots
} catch (error) {
    data_fetching_error = error
}

const PARTIAL_URL = translatePath('/partials/alliance_health_leave_component')
---

{
    data_fetching_error ? (
        <ErrorRefetch
            args={{
                partial: `${PARTIAL_URL}?bucket=${bucket}`,
                error: data_fetching_error,
                delay: 0,
            }}
        />
    ) : (
        <AllianceHealthLeaveTable
            pilots={pilots}
            initial_corp={initial_corp}
            bucket={bucket}
        />
    )
}
