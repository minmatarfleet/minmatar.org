---
/**
 * A campaign's four roles (Coordinator, FC, Diplomat, Recon), mirrored from
 * its coordination Discord server, and who holds each. Discord decides: the
 * sync replaces the rosters with the server's role holders. Managers and
 * Coordinators add someone by character (they get the Discord role once
 * they link Discord) or remove them (here and on Discord); managers point a
 * role at a Discord role. The API checks every step.
 */
import { i18n, t_key } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'
import { change_campaign, get_campaign_roles } from '@helpers/api.minmatar.org/campaigns'
import type { CampaignRoles } from '@dtypes/api.minmatar.org'
import { form_text } from '@helpers/manage_forms'
import { query_string } from '@helpers/string'
import { refusal_text } from '@helpers/campaign_manage'

const { auth_token, user } = get_request_user(Astro)
if (!user || !auth_token) return HTTP_403_Forbidden()

const slug = Astro.url.searchParams.get('slug') ?? ''
if (!/^[a-z0-9-]+$/.test(slug)) return HTTP_403_Forbidden()

const PART_URL = translatePath(`/partials/campaign_roles_component?${query_string({ slug })}`)
const KIND = /^(coordinator|fc|diplomat|recon)$/

let data: CampaignRoles | null = null
let fetch_error: Error | false = false
let error_message = ''
let open_kind = ''

if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData()
    const field = (name: string) => form_text(form, name)
    const kind = field('kind')
    open_kind = KIND.test(kind) ? kind : ''
    try {
        const op = field('op')
        if (op === 'sync') {
            data = await change_campaign(slug, auth_token, 'POST', '/roles/sync') as CampaignRoles
        } else if (op === 'add' && open_kind) {
            data = await change_campaign(slug, auth_token, 'POST', `/roles/${open_kind}/members`, { character_name: field('character_name') }) as CampaignRoles
        } else if (op === 'remove' && open_kind) {
            data = await change_campaign(slug, auth_token, 'DELETE', `/roles/${open_kind}/members/${parseInt(field('member_id'))}`) as CampaignRoles
        } else if (op === 'map' && open_kind) {
            data = await change_campaign(slug, auth_token, 'PATCH', `/roles/${open_kind}`, { discord_role_id: field('discord_role_id') || null }) as CampaignRoles
        }
    } catch (error) {
        error_message = refusal_text(error, t('campaigns.action_failed'))
    }
}

if (!data) {
    try {
        data = await get_campaign_roles(slug, auth_token)
    } catch (error) {
        fetch_error = error
    }
}

const roles = data?.roles ?? []
const last_sync = roles.map((role) => role.synced_at).filter(Boolean).sort().at(-1) ?? null
const COLORS: Record<string, string> = {
    coordinator: 'var(--fleet-red)',
    fc: 'var(--fleet-yellow)',
    diplomat: 'var(--militia-purple)',
    recon: 'var(--text-muted)',
}
const action = (extra: Record<string, string>) => ({ 'hx-post': PART_URL, 'hx-vals': JSON.stringify(extra), 'hx-target': 'closest .campaign-roles', 'hx-swap': 'outerHTML' })

import Button from '@components/blocks/Button.astro'
import Input from '@components/blocks/Input.astro'
import Select from '@components/blocks/Select.astro'
import Badge from '@components/blocks/Badge.astro'
import Tag from '@components/blocks/Tag.astro'
import PilotBadge from '@components/blocks/PilotBadge.astro'
import EmptyState from '@components/blocks/EmptyState.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import CollapsibleBlock from '@components/blocks/CollapsibleBlock.astro'
import LocalTime from '@components/blocks/LocalTime.astro'
---

{fetch_error || !data ?
    <ErrorRefetch args={{ partial: PART_URL, error: fetch_error || new Error(t('campaigns.action_failed')), delay: 0 }} />
    :
    <ComponentBlock class="[ campaign-roles ]" padding_inline="var(--space-m)" padding_block="var(--space-m)">
        <div class="[ campaign-roles__head ]">
            <div>
                <h3>{t('campaigns.roles.title').replace('{count}', String(roles.length))}</h3>
                <p class="[ campaign-roles__muted ]">{t('campaigns.roles.discord_decides')}</p>
            </div>
            <div class="[ campaign-roles__sync ]">
                <small class="[ campaign-roles__muted ]">
                    {last_sync ? <>{t('campaigns.roles.synced')} <LocalTime eve_time={new Date(last_sync)} /></> : t('campaigns.roles.never_synced')}
                </small>
                {data.can_change &&
                    <Button type="button" size="sm" color="transparent" {...action({ op: 'sync' })} hx-disabled-elt="this">{t('campaigns.roles.sync')}</Button>
                }
            </div>
        </div>

        {error_message && <p class="[ manage-field__error ]" role="alert">{error_message}</p>}

        <div class="[ campaign-roles__columns ]" aria-hidden="true">
            <span>{t('campaigns.roles.role')}</span>
            <span>{t('campaigns.roles.members')}</span>
        </div>

        <ul class="[ campaign-roles__list ]" role="list">
            {roles.map((role) => (
                <li class="[ campaign-roles__role ]" style={`--role_color: ${COLORS[role.kind] ?? 'var(--text-muted)'}`}>
                    <CollapsibleBlock expanded={open_kind === role.kind} padding_inline="0" gap="var(--space-s)">
                        <div slot="head" class="[ campaign-roles__row ]">
                            <span class="[ campaign-roles__name ]">
                                <svg class="[ campaign-roles__shield ]" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3Z" />
                                    <circle cx="12" cy="10" r="2.6" class="cut" />
                                    <path d="M7.6 16.4c.9-2 2.6-3 4.4-3s3.5 1 4.4 3" class="cut" />
                                </svg>
                                <b>{role.label}</b>
                                {role.discord_role_name && <small class="[ campaign-roles__muted ]">@{role.discord_role_name}</small>}
                            </span>
                            <span class="[ campaign-roles__count ]" title={t('campaigns.roles.members')}>
                                {role.members.length}
                                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7Z" /></svg>
                            </span>
                        </div>

                        <div class="[ campaign-roles__body ]">
                            <p class="[ campaign-roles__muted ]">
                                {t('campaigns.roles.unlocks')} {role.reads.map((scope) => t(t_key('campaigns.roles.scope_', scope))).join(', ')}.
                                {role.edits.length > 0 && <> {t('campaigns.roles.edits')} {role.edits.map((scope) => t(t_key('campaigns.roles.edit_', scope))).join(', ')}.</>}
                            </p>
                            {role.sync_error && <p class="[ campaign-roles__warn ]">{role.sync_error}</p>}

                            {role.members.length === 0 ?
                                <EmptyState title={t('campaigns.roles.empty')} />
                                :
                                <ul class="[ campaign-roles__members ]" role="list">
                                    {role.members.map((member) => (
                                        <li class="[ campaign-roles__member ]">
                                            {member.character_id
                                                ? <PilotBadge character_id={member.character_id} character_name={member.character_name} size={32} icon_quality={64}>
                                                    <small class="[ campaign-roles__muted ]">{[member.corporation_name, member.alliance_name, member.discord_name && `@${member.discord_name}`].filter(Boolean).join(' · ')}</small>
                                                  </PilotBadge>
                                                : <Badge title={member.discord_name || member.character_name} subtitle={t('campaigns.roles.discord_only')} size={32} />
                                            }
                                            <span class="[ campaign-roles__state ]">
                                                {member.source === 'site'
                                                    ? <Tag text={t('campaigns.roles.waiting')} color="fleet-yellow" variant="outline" narrow />
                                                    : !member.signed_in && <Tag text={t('campaigns.roles.not_signed_in')} color="var(--text-muted)" variant="outline" narrow />
                                                }
                                                {data.can_change &&
                                                    <Button type="button" size="sm" color="transparent" narrow
                                                        {...action({ op: 'remove', kind: role.kind, member_id: String(member.id) })}
                                                        hx-confirm={t('campaigns.roles.remove_confirm').replace('{name}', member.character_name || member.discord_name)}
                                                        aria-label={t('campaigns.roles.remove').replace('{name}', member.character_name || member.discord_name)}>
                                                        {t('campaigns.roles.remove_short')}
                                                    </Button>
                                                }
                                            </span>
                                        </li>
                                    ))}
                                </ul>
                            }

                            {data.can_change &&
                                <form class="[ campaign-roles__add ]" hx-post={PART_URL} hx-target="closest .campaign-roles" hx-swap="outerHTML">
                                    <input type="hidden" name="op" value="add" />
                                    <input type="hidden" name="kind" value={role.kind} />
                                    <Input size="sm" width="auto" name="character_name" required minlength="3" aria-label={t('campaigns.roles.add_label').replace('{role}', role.label)} placeholder={t('campaigns.coordinators.invite_placeholder')} />
                                    <Button type="submit" size="sm" color="fleet-red" hx-disabled-elt="this">{t('campaigns.roles.add')}</Button>
                                </form>
                            }

                            {data.can_map &&
                                <form class="[ campaign-roles__add ]" hx-post={PART_URL} hx-target="closest .campaign-roles" hx-swap="outerHTML" hx-trigger="change">
                                    <input type="hidden" name="op" value="map" />
                                    <input type="hidden" name="kind" value={role.kind} />
                                    <label class="[ manage-field__label ]" for={`campaign-role-map-${role.kind}`}>{t('campaigns.roles.discord_role')}</label>
                                    <Select id={`campaign-role-map-${role.kind}`} name="discord_role_id" size="sm">
                                        <option value="">{t('campaigns.roles.no_discord_role')}</option>
                                        {data.discord_roles.map((option) => <option value={option.id} selected={option.id === role.discord_role_id}>{option.name}</option>)}
                                    </Select>
                                </form>
                            }
                        </div>
                    </CollapsibleBlock>
                </li>
            ))}
        </ul>
    </ComponentBlock>
}

<style lang="scss" is:global>
    .campaign-roles {
        display: flex;
        flex-direction: column;
        gap: var(--space-s);

        h3 {
            margin: 0;
        }
    }

    .campaign-roles__head {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: var(--space-s);
    }

    .campaign-roles__sync {
        display: flex;
        align-items: center;
        gap: var(--space-xs);
    }

    .campaign-roles__muted {
        margin: 0;
        color: var(--text-muted);
    }

    .campaign-roles__warn {
        margin: 0;
        color: var(--fleet-yellow);
    }

    .campaign-roles__columns,
    .campaign-roles__row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 6rem;
        align-items: center;
        gap: var(--space-s);
    }

    .campaign-roles__columns {
        padding-block-end: var(--space-2xs);
        font-size: var(--step--1);
        font-weight: 700;
        border-block-end: 1px solid var(--hairline-medium);

        span:last-child {
            text-align: right;
        }
    }

    .campaign-roles__list,
    .campaign-roles__members {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .campaign-roles__role {
        padding-block: var(--space-xs);
        border-block-end: 1px solid var(--hairline);
    }

    .campaign-roles__row {
        width: 100%;
    }

    .campaign-roles__name {
        display: flex;
        align-items: center;
        gap: var(--space-2xs);
        min-width: 0;

        b {
            color: var(--highlight);
        }
    }

    .campaign-roles__shield {
        flex: none;
        width: var(--step-2);
        height: var(--step-2);
        fill: var(--role_color);

        .cut {
            fill: var(--background);
            stroke: var(--background);
            stroke-width: 0.5;
        }
    }

    .campaign-roles__count {
        display: inline-flex;
        align-items: center;
        justify-content: flex-end;
        gap: var(--space-3xs);
        color: var(--text-muted);

        svg {
            width: var(--step-1);
            height: var(--step-1);
            fill: currentColor;
        }
    }

    .campaign-roles__body {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
        padding-inline-start: var(--space-l);
    }

    .campaign-roles__members {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
    }

    .campaign-roles__member {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-xs);
        padding: var(--space-2xs) var(--space-xs);
        background-color: var(--surface-sunken);
    }

    .campaign-roles__state {
        display: flex;
        align-items: center;
        gap: var(--space-2xs);
    }

    .campaign-roles__add {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-xs);

        > :is(input, .input, select) {
            flex: 1 1 14rem;
        }
    }
</style>
