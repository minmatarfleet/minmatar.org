---
import { i18n } from '@helpers/i18n'
import { ui } from '@i18n/ui'
const { t, translatePath } = i18n(Astro.url)

/**
 * ContentViewer's body: one viewable page, rendered by the same body component
 * its page renders. Which pages are viewable, and what they resolve to, is in
 * `@helpers/content_viewer_sources`.
 *
 * Asked for by `?source=<source>&id=<id>` (a ContentViewerLink), by
 * `?path=<page path>` (a link clicked inside the viewer), or by the older
 * `?post=<id>` and `?guide=<slug>`. Public, like the pages: a members-only post
 * shows a gate and the link to its page.
 */
import type { AstroComponentFactory } from 'astro/runtime/server/index.js'
import { get_request_user } from '@helpers/request_user'
import {
    parse_viewer_source,
    resolve_viewer_path,
    resolve_viewer_target,
} from '@helpers/content_viewer_sources'
import type { ViewerSource, ViewerTarget } from '@helpers/content_viewer_sources'

import EmptyState from '@components/blocks/EmptyState.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'

// Each source's body: the component its page renders around its own frame.
// Imported here, statically, so the partial route ships their styles.
import ViewerPostBody from '@components/blocks/content_viewer/ViewerPostBody.astro'
import ViewerGuideBody from '@components/blocks/content_viewer/ViewerGuideBody.astro'
import WarzoneReportIssue from '@components/blocks/warzone/WarzoneReportIssue.astro'
import AmamakeMarketReportIssue from '@components/blocks/amamake-market/AmamakeMarketReportIssue.astro'
import NewsletterIssue from '@components/blocks/newsletter/NewsletterIssue.astro'
import AllianceValues from '@components/blocks/AllianceValues.astro'
import RatChronicle from '@components/blocks/RatChronicle.astro'

const BODIES: Record<ViewerSource, AstroComponentFactory> = {
    post: ViewerPostBody,
    guide: ViewerGuideBody,
    warzone: WarzoneReportIssue,
    market: AmamakeMarketReportIssue,
    newsletter: NewsletterIssue,
    values: AllianceValues,
    story: RatChronicle,
}

// RatChronicle predates the snake_case props; the rest take theirs as is.
function body_props(source: ViewerSource, props: Record<string, any>): Record<string, any> {
    return source === 'story' ? { activeChapterId: props.chapter_id } : props
}

const params = Astro.url.searchParams

function requested_target(): ViewerTarget | null {
    const source = parse_viewer_source(params.get('source'))
    if (source) return { source, id: params.get('id') ?? '' }
    const path = params.get('path')
    if (path) return resolve_viewer_path(path, Object.keys(ui))
    const post = params.get('post')
    if (post) return { source: 'post', id: post }
    const guide = params.get('guide')
    if (guide) return { source: 'guide', id: guide }
    return null
}

const target = requested_target()
const { auth_token } = get_request_user(Astro)
const result = target ? await resolve_viewer_target(target, { t, auth_token }) : null

const resolved = result?.status === 'ok' ? result : null
const Body = resolved ? BODIES[resolved.source] : null
const page_href = result ? translatePath(result.page_path) : ''
const self_url = `${translatePath('/partials/content_viewer_component/')}${Astro.url.search}`
---

<div
    class="[ content-viewer-content ]"
    data-source={resolved?.source ?? ''}
    data-kind={resolved?.kind ?? 'missing'}
    data-width={resolved?.width ?? 'narrow'}
    data-title={resolved?.title ?? ''}
    data-href={page_href}
>
    {result?.status === 'members_only' &&
        <EmptyState title={t('content_viewer.members_only')} hint={t('content_viewer.members_only_hint')} />
    }
    {result?.status === 'error' &&
        <ErrorRefetch args={{ partial: self_url, error: result.error, delay: 0, target: '#content-viewer-body' }} />
    }
    {(!result || result.status === 'not_found') &&
        <EmptyState title={t('content_viewer.not_found')} hint={t('content_viewer.not_found_hint')} />
    }

    {resolved && Body && <Body {...body_props(resolved.source, resolved.props)} />}
</div>

<style lang="scss">
    .content-viewer-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-s);
        min-height: 100%;
    }
</style>
