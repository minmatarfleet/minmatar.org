---
import { i18n } from '@helpers/i18n'
import { get_request_user } from '@helpers/request_user'
const { t, translatePath, lang } = i18n(Astro.url)

import { HTTP_403_Forbidden } from '@helpers/http_responses'
import { get_corporation_members } from '@helpers/api.minmatar.org/corporations'
import { get_player_icon } from '@helpers/eve_image_server'
import {
    MEMBER_ATTENTION_VIEWS,
    MEMBER_PAGE_SIZE,
    MEMBER_STATUS_FILTERS,
    MEMBER_TIMEZONE_FILTERS,
    MEMBER_VIEWS,
    build_member_roster,
    corporation_member_attention,
    corporation_member_characters,
    corporation_member_primary,
    days_since,
    filter_corporation_member_rows,
    group_corporation_members,
    paginate_corporation_member_rows,
    parse_member_params,
} from '@helpers/corporations/detail'
import type {
    CorporationMemberRow,
    MemberAttention,
    MemberRosterParams,
    MemberView,
} from '@helpers/corporations/detail'
import { month_year, short_date } from '@helpers/corporations/about'
import { query_string } from '@helpers/string'

import Input from '@components/blocks/Input.astro'
import Select from '@components/blocks/Select.astro'
import Button from '@components/blocks/Button.astro'
import HtmxPager from '@components/blocks/HtmxPager.astro'
import MagnifierIcon from '@components/icons/buttons/MagnifierIcon.astro'
import EmptyState from '@components/blocks/EmptyState.astro'
import TimezoneTags from '@components/blocks/TimezoneTags.astro'
import LazyPartial from '@components/blocks/LazyPartial.astro'
import XFadeScroll from '@components/compositions/XFadeScroll.astro'

const BODY_ID = 'corporation-members-body'
const SEARCH_ID = 'corporation-member-search'
const FORM_ID = 'corporation-member-filters'
const VISIBLE_ALT_NAMES = 6

const { auth_token } = get_request_user(Astro)
if (!auth_token) return HTTP_403_Forbidden()

const corporation_id = parseInt(Astro.url.searchParams.get('corporation_id') ?? '')
if (!corporation_id) return HTTP_403_Forbidden()

const params = parse_member_params(Astro.url.searchParams)
const members_result = await get_corporation_members(auth_token, corporation_id)
if (!members_result) return HTTP_403_Forbidden()

const grouped = group_corporation_members(members_result)
const roster = build_member_roster(grouped, { ...params, ids: [] })
const pagination = paginate_corporation_member_rows(roster, params.page, MEMBER_PAGE_SIZE)
const now = new Date()

// Counts respect the search and dropdowns, so each shows what picking it yields.
function count_with(overrides: Partial<MemberRosterParams>) {
    return filter_corporation_member_rows(grouped, { ...params, ...overrides }).length
}

function partial_url(overrides: Record<string, string> = {}) {
    return translatePath(`/partials/corporation_members_table_component/?${query_string({
        corporation_id: String(corporation_id),
        ...overrides,
    })}`)
}

const export_url = translatePath(`/api/corporations/members.csv?${query_string({
    corporation_id: String(corporation_id),
    q: params.query,
    tz: params.timezone ?? '',
    status: params.status ?? '',
    view: params.view,
    sort: params.sort,
})}`)

function view_label(view: MemberView): string {
    switch (view) {
        case 'all': return t('corporations.members.view_all')
        case 'flying': return t('corporations.members.view_flying')
        case 'quiet': return t('corporations.members.view_quiet')
        case 'new': return t('corporations.members.view_new')
        case 'ready': return t('corporations.members.view_ready')
        case 'unlinked': return t('corporations.members.view_unlinked')
        case 'esi': return t('corporations.members.view_esi')
        default: return view
    }
}

function status_label(code: string | null): string {
    switch (code) {
        case 'active': return t('corporations.detail.status_active')
        case 'trial': return t('corporations.detail.status_trial')
        case 'on_leave': return t('corporations.detail.status_on_leave')
        default: return t('corporations.detail.status_none')
    }
}

function attention_label(attention: MemberAttention): string {
    switch (attention) {
        case 'esi_suspended': return t('corporations.members.attention_esi_suspended')
        case 'no_account': return t('corporations.members.attention_no_account')
        case 'token_missing': return t('corporations.members.attention_token_missing')
        case 'trial_ready': return t('corporations.members.attention_trial_ready')
        default: return attention
    }
}

function tenure_label(iso: string | null): string {
    const days = days_since(iso, now)
    if (days === null)
        return '—'
    const months = Math.max(1, Math.floor(days / 30.44))
    if (months < 12)
        return t('corporations.members.tenure_months').replace('~N', String(months))
    return t('corporations.members.tenure_years')
        .replace('~Y', String(Math.floor(months / 12)))
        .replace('~M', String(months % 12))
}

function last_fleet_label(iso: string | null): string {
    const days = days_since(iso, now)
    if (days === null || days > 90)
        return t('corporations.members.not_in_90')
    if (days === 0)
        return t('corporations.members.today')
    if (days === 1)
        return t('corporations.members.yesterday')
    return t('corporations.members.days_ago').replace('~COUNT', String(days))
}

function alts_label(row: CorporationMemberRow): string {
    const count = row.hidden_character_count > 0
        ? row.hidden_character_count
        : corporation_member_characters(row).length
    if (count === 0)
        return ''
    return count === 1
        ? t('corporations.members.alts_one')
        : t('corporations.members.alts').replace('~COUNT', String(count))
}

function bars(weeks: number[]) {
    const peak = Math.max(1, ...weeks)
    return weeks.map((week) => ({ week, height: week > 0 ? Math.max(12, Math.round((week / peak) * 100)) : 0 }))
}

function sort_label(sort: MemberRosterParams['sort']): string {
    switch (sort) {
        case 'kills': return t('corporations.members.sort_kills')
        case 'name': return t('corporations.members.sort_name')
        case 'joined': return t('corporations.members.sort_joined')
        case 'last': return t('corporations.members.sort_last')
        default: return t('corporations.members.sort_fleets')
    }
}

const timezone_options = [
    { value: '', label: t('corporations.detail.all_timezones') },
    ...MEMBER_TIMEZONE_FILTERS.map((code) => ({ value: code, label: code === 'none' ? t('timezones.no_tz_yet') : code })),
]
const status_options = [
    { value: '', label: t('corporations.detail.all_statuses') },
    ...MEMBER_STATUS_FILTERS.map((code) => ({ value: code, label: status_label(code === 'none' ? null : code) })),
]

// Every request swaps the body plus the controls whose counts or values change;
// the search box is never replaced, so it keeps focus while typing.
const hx_swap = {
    'hx-target': `#${BODY_ID}`,
    'hx-select': `#${BODY_ID}`,
    'hx-select-oob': '#cm-views,#cm-attention,#cm-sort',
    'hx-swap': 'outerHTML',
}

interface SortHeader {
    key: MemberRosterParams['sort']
    label: string
    css: string
}

const pilot_header: SortHeader = { key: 'name', label: t('corporations.members.pilot'), css: 'col-pilot' }
const sort_headers: SortHeader[] = [
    { key: 'joined', label: t('corporations.members.in_corp'), css: 'col-joined' },
    { key: 'fleets', label: t('corporations.members.fleets_weeks'), css: 'col-fleets' },
    { key: 'last', label: t('corporations.members.last_fleet'), css: 'col-last' },
    { key: 'kills', label: t('corporations.members.kills'), css: 'col-kills is-numeric' },
]

const names_by_id = Object.fromEntries(pagination.rows.map((row) => [row.character_id, corporation_member_primary(row).character_name]))
const page_ids = pagination.rows.map((row) => row.character_id)
const can_prev = pagination.page > 1
const can_next = pagination.page < pagination.total_pages
const range_start = pagination.total === 0 ? 0 : (pagination.page - 1) * pagination.page_size + 1
const range_end = Math.min(pagination.total, pagination.page * pagination.page_size)
const selected_template = t('corporations.members.selected')
---

<div class="cm">
    <form
        id={FORM_ID}
        class="cm-controls"
        role="search"
        hx-get={partial_url()}
        hx-trigger={`keyup changed delay:300ms from:#${SEARCH_ID}, search from:#${SEARCH_ID}, change, submit`}
        hx-sync="this:replace"
        {...hx_swap}
    >
        <input type="hidden" id="cm-sort" name="sort" value={params.sort} />
        <div class="cm-filter-row">
            <fieldset id="cm-views" class="cm-views">
                <legend class="visually-hidden">{t('corporations.members.views')}</legend>
                {MEMBER_VIEWS.map((view) => (
                    <label class:list={['cm-chip', { 'is-on': params.view === view }]}>
                        <input class="visually-hidden" type="radio" name="view" value={view} checked={params.view === view} />
                        <span>{view_label(view)}</span>
                        <span class="cm-count">{count_with({ view })}</span>
                    </label>
                ))}
            </fieldset>
            <fieldset id="cm-attention" class="cm-attention">
                <legend class="cm-eyebrow">{t('corporations.members.needs_attention')}</legend>
                {MEMBER_ATTENTION_VIEWS.map((view) => (
                    <label class:list={['cm-chip', view === 'ready' ? 'is-good' : 'is-warn', { 'is-on': params.view === view }]}>
                        <input class="visually-hidden" type="radio" name="view" value={view} checked={params.view === view} />
                        <span>{view_label(view)}</span>
                        <span class="cm-count">{count_with({ view })}</span>
                    </label>
                ))}
            </fieldset>
        </div>
        <div class="cm-toolbar">
            <label class="cm-search">
                <span class="visually-hidden">{t('corporations.detail.search_members')}</span>
                <Input
                    type="search"
                    name="q"
                    id={SEARCH_ID}
                    value={params.query}
                    placeholder={t('corporations.detail.search_members_placeholder')}
                    size="sm"
                    width="100%"
                    autocomplete="off"
                >
                    <MagnifierIcon slot="icon" />
                </Input>
            </label>
            <label class="cm-select">
                <span class="visually-hidden">{t('corporations.detail.timezone')}</span>
                <Select size="sm" width="100%" name="tz">
                    {timezone_options.map((option) => (
                        <option value={option.value} selected={option.value === (params.timezone ?? '')}>{option.label}</option>
                    ))}
                </Select>
            </label>
            <label class="cm-select">
                <span class="visually-hidden">{t('corporations.detail.community_status')}</span>
                <Select size="sm" width="100%" name="status">
                    {status_options.map((option) => (
                        <option value={option.value} selected={option.value === (params.status ?? '')}>{option.label}</option>
                    ))}
                </Select>
            </label>
        </div>
    </form>

<div
    id={BODY_ID}
    class="cm-body"
    aria-live="polite"
    x-data={`{
        picked: [],
        page_ids: ${JSON.stringify(page_ids)},
        names: ${JSON.stringify(names_by_id)},
        copied: false,
        get all_picked() { return this.page_ids.length > 0 && this.picked.length === this.page_ids.length },
        toggle_all(on) { this.picked = on ? [...this.page_ids] : [] },
        copy_names() {
            navigator.clipboard.writeText(this.picked.map((id) => this.names[id]).join('\\n'))
            this.copied = true
            setTimeout(() => this.copied = false, 1500)
        },
    }`}
>
    {pagination.rows.length === 0
        ? <EmptyState title={t('corporations.detail.no_members')} />
        : (
            <div class="cm-panel">
            <XFadeScroll>
                <table class="cm-table">
                    <thead>
                        <tr x-show="picked.length === 0">
                            <th scope="col" class="col-check">
                                <input
                                    type="checkbox"
                                    class="cm-check"
                                    aria-label={t('corporations.members.select_all')}
                                    x-bind:checked="all_picked"
                                    x-on:change="toggle_all($event.target.checked)"
                                />
                            </th>
                            <th scope="col" class={pilot_header.css} aria-sort={params.sort === pilot_header.key ? 'ascending' : undefined}>
                                <button
                                    type="button"
                                    class="cm-sort"
                                    hx-get={partial_url()}
                                    hx-include={`#${FORM_ID}`}
                                    hx-vals={JSON.stringify({ sort: pilot_header.key, page: '1' })}
                                    {...hx_swap}
                                >
                                    {pilot_header.label}
                                    {params.sort === pilot_header.key && <span aria-hidden="true">▾</span>}
                                </button>
                            </th>
                            <th scope="col" class="col-status">{t('corporations.members.status')}</th>
                            {sort_headers.map((header) => (
                                <th scope="col" class={header.css} aria-sort={params.sort === header.key ? 'descending' : undefined}>
                                    <button
                                        type="button"
                                        class="cm-sort"
                                        hx-get={partial_url()}
                                        hx-include={`#${FORM_ID}`}
                                        hx-vals={JSON.stringify({ sort: header.key, page: '1' })}
                                        {...hx_swap}
                                    >
                                        {header.key === 'fleets'
                                            ? <><span class="cm-label-full">{header.label}</span><span class="cm-label-short">{t('corporations.detail.fleets')}</span></>
                                            : header.label}
                                        {params.sort === header.key && <span aria-hidden="true">▾</span>}
                                    </button>
                                </th>
                            ))}
                            <th scope="col" class="col-voice is-numeric">{t('corporations.members.voice')}</th>
                            <th scope="col" class="col-prime">{t('corporations.detail.timezone')}</th>
                            <th scope="col" class="col-chevron"></th>
                        </tr>
                        <tr class="cm-bulk" x-show="picked.length > 0" x-cloak>
                            <th scope="col" class="col-check">
                                <input
                                    type="checkbox"
                                    class="cm-check"
                                    aria-label={t('corporations.members.select_all')}
                                    x-bind:checked="all_picked"
                                    x-on:change="toggle_all($event.target.checked)"
                                />
                            </th>
                            <th scope="col" colspan="9">
                                <span class="cm-bulk-row">
                                    <span x-text={`${JSON.stringify(selected_template)}.replace('~COUNT', picked.length)`}></span>
                                    <span class="cm-bulk-actions">
                                        <Button type="button" size="sm" color="transparent" x-on:click="copy_names()">
                                            <span x-show="!copied">{t('corporations.members.copy_names')}</span>
                                            <span x-show="copied" x-cloak>{t('corporations.members.copied')}</span>
                                        </Button>
                                        <Button size="sm" color="transparent" href={export_url} x-bind:href={`${JSON.stringify(export_url)} + '&ids=' + picked.join(',')`}>
                                            {t('corporations.members.export_selected')}
                                        </Button>
                                        <Button type="button" size="sm" color="transparent" x-on:click="picked = []">
                                            {t('corporations.members.clear')}
                                        </Button>
                                    </span>
                                </span>
                            </th>
                        </tr>
                    </thead>
                    {pagination.rows.map((member) => {
                        const primary = corporation_member_primary(member)
                        const characters = corporation_member_characters(member)
                        const attention = corporation_member_attention(member)
                        const weeks = bars(member.weekly_fleets)
                        const alts = alts_label(member)
                        const last = last_fleet_label(member.last_fleet_at)
                        const last_stale = (days_since(member.last_fleet_at, now) ?? 999) > 14
                        const details_label = t('corporations.members.details').replace('~NAME', primary.character_name)
                        const character_count = 1 + (member.hidden_character_count || characters.length)
                        return (
                            <tbody x-data="{ open: false }" x-bind:class="{ 'is-open': open }">
                                <tr class="cm-row">
                                    <td class="col-check">
                                        <input
                                            type="checkbox"
                                            class="cm-check"
                                            value={member.character_id}
                                            x-model.number="picked"
                                            aria-label={t('corporations.members.select').replace('~NAME', primary.character_name)}
                                        />
                                    </td>
                                    <td class="col-pilot">
                                        <button type="button" class="cm-pilot" x-on:click="open = !open" x-bind:aria-expanded="open" aria-label={details_label}>
                                            <img class="cm-portrait" src={get_player_icon(primary.character_id, 64)} alt="" width="36" height="36" loading="lazy" />
                                            <span class="cm-pilot__text">
                                                <span class="cm-pilot__name">{primary.character_name}</span>
                                                <span class="cm-pilot__sub">
                                                    {alts && <span class="cm-muted">{alts}</span>}
                                                    {attention &&
                                                        <span class:list={['cm-attention-text', attention === 'trial_ready' ? 'is-good' : 'is-warn']}>{attention_label(attention)}</span>
                                                    }
                                                    {!attention &&
                                                        <span class="cm-mobile-meta cm-muted">{tenure_label(member.corp_joined_at)} · {last}</span>
                                                    }
                                                </span>
                                            </span>
                                        </button>
                                    </td>
                                    <td class="col-status">
                                        <span class="cm-status" data-status={member.community_status ?? 'none'}>{status_label(member.community_status)}</span>
                                    </td>
                                    <td class="col-joined">
                                        <span class="cm-joined">
                                            <span class="cm-strong">{tenure_label(member.corp_joined_at)}</span>
                                            <span class="cm-muted">{month_year(member.corp_joined_at, lang)}</span>
                                        </span>
                                    </td>
                                    <td class="col-fleets">
                                        <span class="cm-fleets">
                                            <span class="cm-number">{member.fleets_90d}</span>
                                            <span class="cm-spark" aria-hidden="true">
                                                {weeks.map((bar) => <span style={`height: ${bar.height}%`}></span>)}
                                            </span>
                                        </span>
                                    </td>
                                    <td class:list={['col-last', { 'is-stale': last_stale }]}>{last}</td>
                                    <td class="col-kills is-numeric"><span class="cm-number">{member.kills_90d}</span></td>
                                    <td class="col-voice is-numeric">{member.linked ? `${member.voice_hours_90d}h` : '—'}</td>
                                    <td class="col-prime">
                                        {member.linked
                                            ? <TimezoneTags timezone={member.timezone} />
                                            : <span class="cm-muted">—</span>
                                        }
                                    </td>
                                    <td class="col-chevron">
                                        <button type="button" class="cm-chevron" x-on:click="open = !open" x-bind:aria-expanded="open" aria-label={details_label}>
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
                                        </button>
                                    </td>
                                </tr>
                                <tr class="cm-detail" x-show="open" x-cloak>
                                    <td colspan="10">
                                        <div class="cm-detail__body">
                                            <LazyPartial
                                                class="cm-insights"
                                                url={translatePath(`/partials/corporation_member_insights_component/?corporation_id=${corporation_id}&character_id=${primary.character_id}`)}
                                                trigger="reveal"
                                                indicator={false}
                                            >
                                                <p class="cm-muted cm-insights__loading">{t('corporations.members.insights_loading')}</p>
                                            </LazyPartial>
                                            <div class="cm-detail__grid">
                                                <div class="cm-block">
                                                    <h4 class="cm-eyebrow">{t('corporations.members.fleets_per_week')}</h4>
                                                    <span class="cm-weeks" aria-hidden="true">
                                                        {weeks.map((bar) => <span style={`height: ${bar.height}%`}></span>)}
                                                    </span>
                                                    <span class="cm-weeks__axis cm-muted" aria-hidden="true">
                                                        <span>{t('corporations.members.weeks_ago').replace('~COUNT', String(weeks.length))}</span>
                                                        <span>{t('corporations.members.this_week')}</span>
                                                    </span>
                                                </div>
                                                <div class="cm-block">
                                                    <h4 class="cm-eyebrow">{t('corporations.members.characters').replace('~COUNT', String(character_count))}</h4>
                                                    <ul class="cm-list cm-characters">
                                                        <li>
                                                            <span class="cm-strong">{primary.character_name}</span>
                                                            <span class="cm-muted">{t('corporations.members.main')}</span>
                                                            <span class:list={['cm-token', { 'is-warn': member.linked && !member.main_registered }]}>
                                                                {!member.linked
                                                                    ? t('corporations.members.not_linked')
                                                                    : member.main_registered ? member.token_level || '—' : t('corporations.members.no_token')}
                                                            </span>
                                                        </li>
                                                        {member.hidden_character_count > 0
                                                            ? <li class="cm-muted">{t('corporations.detail.characters_hidden')}</li>
                                                            : characters.slice(0, VISIBLE_ALT_NAMES).map((alt) => (
                                                                <li>
                                                                    <span class="cm-strong">{alt.character_name}</span>
                                                                    <span class="cm-muted">{t('corporations.members.alt')}</span>
                                                                    <span class:list={['cm-token', { 'is-warn': alt.registered === false || alt.esi_suspended }]}>
                                                                        {alt.esi_suspended
                                                                            ? t('corporations.members.attention_esi_suspended')
                                                                            : alt.registered === false ? t('corporations.members.no_token') : alt.token_level || '—'}
                                                                    </span>
                                                                </li>
                                                            ))}
                                                        {member.hidden_character_count === 0 && characters.length > VISIBLE_ALT_NAMES &&
                                                            <li class="cm-muted">{t('corporations.members.alts').replace('~COUNT', String(characters.length - VISIBLE_ALT_NAMES))}</li>
                                                        }
                                                    </ul>
                                                </div>
                                                <div class="cm-block">
                                                    <h4 class="cm-eyebrow">{t('corporations.members.history')}</h4>
                                                    <ul class="cm-list cm-history">
                                                        {member.corp_joined_at &&
                                                            <li>
                                                                <span>{t('corporations.members.joined_corp')}</span>
                                                                <span class="cm-muted">{short_date(member.corp_joined_at, lang)}</span>
                                                            </li>
                                                        }
                                                        {member.status_history.map((change) => (
                                                            <li>
                                                                <span>{t('corporations.members.became').replace('~STATUS', status_label(change.to_status))}</span>
                                                                <span class="cm-muted">{short_date(change.changed_at, lang)}</span>
                                                            </li>
                                                        ))}
                                                    </ul>
                                                    <h4 class="cm-eyebrow cm-block__subhead">{t('corporations.members.tribes')}</h4>
                                                    <p class="cm-tribes">{member.tribe_groups.length > 0 ? member.tribe_groups.join(', ') : t('corporations.members.none_yet')}</p>
                                                </div>
                                            </div>
                                            <div class="cm-detail__actions">
                                                <Button
                                                    type="button"
                                                    size="sm"
                                                    color="transparent"
                                                    x-on:click={`navigator.clipboard.writeText(${JSON.stringify(primary.character_name)})`}
                                                >
                                                    {t('corporations.members.copy_name')}
                                                </Button>
                                                <Button
                                                    size="sm"
                                                    color="transparent"
                                                    href={`https://zkillboard.com/character/${primary.character_id}/`}
                                                    external={true}
                                                    new_tab={true}
                                                >
                                                    {t('corporations.members.zkillboard')}
                                                </Button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        )
                    })}
                </table>
            </XFadeScroll>
            </div>
        )
    }

    <HtmxPager
        class="cm-pager"
        page={pagination.page}
        total_pages={pagination.total_pages}
        url_for={(to) => partial_url({ page: String(to) })}
        request={{ ...hx_swap, 'hx-include': `#${FORM_ID}` }}
        gap="var(--space-xs)"
