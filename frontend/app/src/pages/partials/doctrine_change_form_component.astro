---
// no-error-refetch: a mutation partial that shows the API error inline in the dialog
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'

const { auth_token, user } = get_request_user(Astro)

if (!user)
    return HTTP_403_Forbidden()

import { get_gates } from '@helpers/gates'
import {
    can_edit_doctrines,
    composition_changes,
    DOCTRINE_ROLES,
    editor_fitting,
    is_doctrine_role,
    ship_icon,
    type CompositionChange,
    type DoctrineComposition,
    type DoctrineRole,
    type EditorFitting,
} from '@helpers/doctrine_editor'

const gates = await get_gates(Astro)

if (!await can_edit_doctrines(gates))
    return HTTP_403_Forbidden()

import type { Doctrine, NewFittingResult } from '@dtypes/api.minmatar.org'
import { get_doctrine_by_id } from '@helpers/api.minmatar.org/doctrines'
import { get_fittings } from '@helpers/api.minmatar.org/ships'
import {
    get_change_requests,
    review_change_request,
    submit_doctrine_change,
    submit_new_fitting,
} from '@helpers/api.minmatar.org/doctrine_changes'
import { is_capital_group } from '@helpers/ship_groups'

const doctrine_id = parseInt(Astro.url.searchParams.get('doctrine_id') ?? '0')
const intent = Astro.url.searchParams.get('intent') ?? 'review'

const ROLE_LABELS:Record<DoctrineRole, string> = {
    primary: t('doctrine_changes.role_primary'),
    secondary: t('doctrine_changes.role_academy'),
    support: t('doctrine_changes.role_support'),
    utility: t('doctrine_changes.role_utility'),
    capitals: t('doctrine_changes.role_capitals'),
}

interface ChangeRow {
    ship_id: number | null
    name:    string
    what:    string
    kind:    CompositionChange['kind'] | 'detail'
}

let error_message:string | false = false
let rows:ChangeRow[] = []
let doctrine:Doctrine | null = null
// Pasted EFT: what it reads as (read_fit), or the fitting it created (create_fit).
let read:NewFittingResult | null = null
let created:EditorFitting | null = null
let created_role:DoctrineRole = 'primary'

if (Astro.request.method === 'POST') {
    try {
        if (intent === 'withdraw') {
            const request_id = parseInt(Astro.url.searchParams.get('request_id') ?? '0')
            await review_change_request(auth_token as string, 'doctrine', request_id, 'cancel')
            // The page reloads into the editor.
            return new Response(null, { status: 200, headers: { 'HX-Refresh': 'true' } })
        }

        const form = await Astro.request.formData()

        if (intent === 'read_fit' || intent === 'create_fit') {
            const eft_format = String(form.get('eft_format') ?? '').trim()
            if (intent === 'read_fit' && !eft_format) {
                read = null
            } else {
                read = await submit_new_fitting(auth_token as string, {
                    eft_format,
                    preview: intent === 'read_fit',
                })
            }
            if (intent === 'create_fit' && read?.fitting_id) {
                const role = String(form.get('role') ?? 'primary')
                created_role = is_doctrine_role(role) ? role : 'primary'
                created = editor_fitting(
                    { id: read.fitting_id, name: read.name, ship_id: read.ship_id },
                    read.ship_name,
                    read.ship_group,
                    is_capital_group,
                )
                // The editor picks the new fit in that role and closes the dialog.
                Astro.response.headers.set('HX-Trigger', JSON.stringify({
                    'doctrine-fit-created': { id: created.id, role: created_role },
                }))
            }
        }
        const ids = (key:string) => form.getAll(key).map((value) => parseInt(String(value))).filter((id) => !isNaN(id))
        const composition = Object.fromEntries(DOCTRINE_ROLES.map((role) => [role, ids(role)])) as DoctrineComposition
        const body = {
            name: String(form.get('name') ?? ''),
            type: String(form.get('type') ?? ''),
            description: String(form.get('description') ?? ''),
            composition,
            note: String(form.get('note') ?? ''),
        }

        if (intent === 'submit') {
            await submit_doctrine_change(auth_token as string, doctrine_id, { ...body, preview: false })
            // The page reloads into its pending (or applied) state.
            return new Response(null, { status: 200, headers: { 'HX-Refresh': 'true' } })
        }

        if (intent === 'review') {
            // Review: the API validates the edit, then the dialog lists it per ship.
            await submit_doctrine_change(auth_token as string, doctrine_id, { ...body, preview: true })
            const [live, fittings, requests] = await Promise.all([
                get_doctrine_by_id(doctrine_id),
                get_fittings(),
                get_change_requests(auth_token as string),
            ])
            doctrine = live
            const by_id = new Map<number, { name:string, ship_id:number | null }>(
                fittings.map((fitting) => [fitting.id, { name: fitting.name, ship_id: fitting.ship_id }])
            )
            // New fittings waiting for review are not in the catalog yet.
            for (const row of requests)
                if (row.kind === 'fitting' && row.change_kind === 'fitting_create' && !by_id.has(row.target_id))
                    by_id.set(row.target_id, { name: row.target_name, ship_id: row.target_ship_id ?? null })
            const current:DoctrineComposition = {
                primary: live.primary_fittings.map((fitting) => fitting.id),
                secondary: live.secondary_fittings.map((fitting) => fitting.id),
                support: live.support_fittings.map((fitting) => fitting.id),
                utility: (live.utility_fittings ?? []).map((fitting) => fitting.id),
                capitals: (live.capitals_fittings ?? []).map((fitting) => fitting.id),
            }

            if (body.name.trim() !== live.name)
                rows.push({ ship_id: null, name: t('doctrine_changes.name'), what: body.name.trim(), kind: 'detail' })
            if (body.description !== live.description)
                rows.push({ ship_id: null, name: t('doctrine_changes.description'), what: t('doctrine_changes.edited'), kind: 'detail' })

            for (const change of composition_changes(current, composition)) {
                const fitting = by_id.get(change.fitting_id)
                const what = change.kind === 'added'
                    ? t('doctrine_changes.added_to').replace('{role}', ROLE_LABELS[change.to!])
                    : change.kind === 'moved'
                    ? t('doctrine_changes.moved_to').replace('{role}', ROLE_LABELS[change.to!])
                    : t('doctrine_changes.removed_from').replace('{role}', ROLE_LABELS[change.from!])
                rows.push({ ship_id: fitting?.ship_id ?? null, name: fitting?.name ?? `#${change.fitting_id}`, what, kind: change.kind })
            }
        }
    } catch (error) {
        error_message = error instanceof Error ? error.message : t('doctrine_changes.action_failed')
    }
}

const FORM_PARTIAL_URL = translatePath(`/partials/doctrine_change_form_component/?doctrine_id=${doctrine_id}`)
const doctrine_type = String(doctrine?.type ?? '')
const reviewer_line = doctrine_type === 'experimental'
    ? t('doctrine_changes.applies_now')
    : doctrine_type === 'non_strategic'
    ? t('doctrine_changes.reviewer_non_strategic')
    : t('doctrine_changes.reviewer_strategic')
const title = (rows.length === 1 ? t('doctrine_changes.send_title_one') : t('doctrine_changes.send_title'))
    .replace('{count}', String(rows.length))

import Button from '@components/blocks/Button.astro'
import DoctrineEditorResult from '@components/blocks/DoctrineEditorResult.astro'
import DoctrineEditorRow from '@components/blocks/DoctrineEditorRow.astro'
import EmptyState from '@components/blocks/EmptyState.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
---

{(intent === 'read_fit' || intent === 'create_fit') ?
    <Flexblock gap="var(--space-s)">
        {error_message ?
            <p role="alert" class="[ doctrine-paste__error ]">{error_message}</p>
            : created ?
            <>
                <EmptyState title={t('doctrine_changes.paste_empty')} />
                {DOCTRINE_ROLES.map((role) =>
                    <div hx-swap-oob={`beforeend:#doctrine-rows-${role}`}>
                        <DoctrineEditorRow role={role} fitting={created!} role_labels={ROLE_LABELS} />
                    </div>
                )}
                <div hx-swap-oob="afterbegin:#doctrine-add-results">
                    <DoctrineEditorResult fitting={created} />
                </div>
            </>
            : read ?
            <>
                <div class="[ doctrine-paste__read ]">
                    <img src={ship_icon(read.ship_id)} alt="" width="36" height="36" />
                    <span class="[ doctrine-row__text ]">
                        <span>{read.name}</span>
                        <small>
                            {[read.ship_name, read.ship_group].filter(Boolean).join(' · ')} · {t('doctrine_changes.paste_lines').replace('{count}', String(read.item_lines))}
                        </small>
                    </span>
                </div>
                <small class="[ doctrine-review__muted ]">{t('doctrine_changes.paste_reviewed_with')}</small>
                <FlexInline justification="flex-end" gap="var(--space-s)">
                    <button type="button" class="[ doctrine-review__link ]" x-on:click="close_dialog()">{t('doctrine_changes.cancel_paste')}</button>
                    <Button
                        type="button"
                        color="fleet-red"
                        hx-post={`${FORM_PARTIAL_URL}&intent=create_fit`}
                        hx-include="#doctrine-paste-form"
                        hx-target="#doctrine-paste-result"
                        hx-swap="innerHTML"
                    >
                        {t('doctrine_changes.paste_add')}
                    </Button>
                </FlexInline>
            </>
            :
            <EmptyState title={t('doctrine_changes.paste_empty')} />
        }
    </Flexblock>
    :
<Flexblock gap="var(--space-s)" class="[ doctrine-review ]">
    {error_message ?
        <Flexblock gap="var(--space-s)">
            <h2>{t('doctrine_changes.review_failed')}</h2>
            <p role="alert">{error_message}</p>
            <FlexInline justification="flex-end">
                <button type="button" class="[ doctrine-review__link ]" x-on:click="close_dialog()">{t('doctrine_changes.keep_editing')}</button>
            </FlexInline>
        </Flexblock>
        :
        <Flexblock gap="var(--space-s)">
            <h2>{title}</h2>
            <ul class="[ doctrine-review__rows ]">
                {rows.map((row) =>
                    <li class="[ doctrine-review__row ]">
                        {row.ship_id
                            ? <img src={`https://images.evetech.net/types/${row.ship_id}/icon?size=64`} alt="" width="32" height="32" loading="lazy" />
                            : <span class="[ doctrine-review__spacer ]" aria-hidden="true"></span>
                        }
                        <span class="[ doctrine-review__name ]">{row.name}</span>
                        <small class="[ doctrine-review__what ]" data-kind={row.kind}>{row.what}</small>
                    </li>
                )}
            </ul>
            <Flexblock gap="var(--space-3xs)">
                <label for="doctrine-review-note">
                    {t('doctrine_changes.note_label')} <small class="[ doctrine-review__muted ]">{t('doctrine_changes.optional')}</small>
                </label>
                <textarea id="doctrine-review-note" name="note" rows="3" class="[ doctrine-review__note ]"></textarea>
            </Flexblock>
            <small class="[ doctrine-review__muted ]">{reviewer_line}</small>
            <FlexInline justification="flex-end" gap="var(--space-s)">
                <button type="button" class="[ doctrine-review__link ]" x-on:click="close_dialog()">{t('doctrine_changes.keep_editing')}</button>
                <Button
                    type="button"
                    color="fleet-red"
                    hx-post={`${FORM_PARTIAL_URL}&intent=submit`}
                    hx-include="#doctrine-form, #doctrine-review-note"
                    hx-target="#doctrine-review"
                    hx-swap="innerHTML"
                >
                    {t('doctrine_changes.send_for_review')}
                </Button>
            </FlexInline>
        </Flexblock>
    }
</Flexblock>
}

<style lang="scss">
    .doctrine-review__rows {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .doctrine-review__row {
        display: flex;
        align-items: center;
        gap: var(--space-xs);
        min-height: 3.25rem;
        border-top: 1px solid var(--hairline);

        img,
        .doctrine-review__spacer {
            flex: none;
            width: 2rem;
            height: 2rem;
        }
    }

    .doctrine-review__name {
        flex: 1 1 auto;
        min-width: 0;
    }

    .doctrine-review__what {
        flex: none;
        font-weight: 600;
        color: var(--text-muted);

        &[data-kind="added"] {
            color: var(--green);
        }

        &[data-kind="moved"] {
            color: var(--fleet-yellow);
        }
    }

    .doctrine-review__muted {
        color: var(--text-muted);
    }

    .doctrine-review__note {
        padding: var(--space-2xs) var(--space-xs);
        background: var(--surface-sunken);
        border: 1px solid var(--border-color);
        color: var(--highlight);
        resize: vertical;
    }

    .doctrine-paste__read {
        display: flex;
        align-items: center;
        gap: var(--space-xs);
        padding: var(--space-2xs) var(--space-xs);
        border: 1px solid color-mix(in srgb, var(--green) 45%, transparent);
        background: color-mix(in srgb, var(--green) 8%, transparent);

        img {
            flex: none;
            width: 2.25rem;
            height: 2.25rem;
        }
    }

    .doctrine-paste__error {
        color: var(--fleet-yellow);
    }

    .doctrine-review__link {
        min-height: 2.75rem;
        background: none;
        border: 0;
        color: var(--text-muted);
        font-size: var(--step--1);
        text-decoration: underline;
        cursor: pointer;
    }
</style>
