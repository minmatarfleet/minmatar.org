---
import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden, HTTP_404_Not_Found } from '@helpers/http_responses'

import { get_request_user } from '@helpers/request_user'

const { auth_token, user } = get_request_user(Astro)

if (!user)
    return HTTP_403_Forbidden()

// The FC's save and delete forms post here; everything else is a GET.
const form = Astro.request.method === 'POST' ? await Astro.request.formData() : null
const fleet_id = parseInt((form?.get('fleet_id') ?? Astro.url.searchParams.get('fleet_id') ?? '0').toString())

if (!fleet_id)
    return HTTP_404_Not_Found()

import {
    create_fleet_battle_segment,
    delete_fleet_battle_segment,
    get_fleet_battle_report,
    get_fleet_fights,
    type FleetBattleReport as FleetBattleReportData,
    type FleetFights,
} from '@helpers/api.minmatar.org/fleets'
import { scope_params, type BattleScope } from '@helpers/fleet_fights'
import { query_string } from '@helpers/string'

// The scope to render: a segment, a window, or the whole fleet.
const read_scope = (params: { get: (name: string) => FormDataEntryValue | string | null }): BattleScope => ({
    start: params.get('start')?.toString() || null,
    end: params.get('end')?.toString() || null,
    segment: parseInt(params.get('segment')?.toString() ?? '') || null,
    sides: params.get('sides')?.toString() || null,
})

let scope = read_scope(form ?? Astro.url.searchParams)
let fetch_error:Error | false = false

if (form) {
    try {
        if (form.get('action') === 'save') {
            const segment = await create_fleet_battle_segment(
                auth_token as string,
                fleet_id,
                form.get('name')?.toString() ?? '',
                form.get('start')?.toString() ?? '',
                form.get('end')?.toString() ?? '',
            )
            scope = { segment: segment.id }
        } else if (form.get('action') === 'delete') {
            const segment_id = parseInt(form.get('segment_id')?.toString() ?? '')
            await delete_fleet_battle_segment(auth_token as string, fleet_id, segment_id)
            if (scope.segment === segment_id) scope = {}
        }
    } catch (error) {
        fetch_error = error
    }
}

let fights:FleetFights | null = null
let report:FleetBattleReportData | null = null

if (!fetch_error) {
    try {
        [fights, report] = await Promise.all([
            get_fleet_fights(auth_token as string, fleet_id),
            get_fleet_battle_report(auth_token as string, fleet_id, scope),
        ])
    } catch (error) {
        fetch_error = error
    }
}

if (!fetch_error && (!fights || !report))
    return HTTP_404_Not_Found()

// The address bar keeps the scope and sides, so the link shares the report as shown.
const params = query_string(scope_params(scope))
const page_url = translatePath(`/fleets/history/${fleet_id}/report`)
Astro.response.headers.set('HX-Push-Url', params ? `${page_url}?${params}` : page_url)

const RETRY_URL = `${translatePath('/partials/fleet_battle_report_component')}?${query_string({ fleet_id, ...scope_params(scope) })}`
const back_href = translatePath(fights?.live ? `/fleets/upcoming/${fleet_id}#aar` : `/fleets/history/${fleet_id}#aar`)

import FleetBattleReport from '@components/blocks/FleetBattleReport.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
---

{fetch_error ?
    <div id="battle-report">
        <ErrorRefetch
            args={{
                partial: RETRY_URL,
                error: fetch_error,
                delay: 0,
                target: '#battle-report',
            }}
        />
    </div>
    :
    <FleetBattleReport report={report as FleetBattleReportData} fleet_id={fleet_id} back_href={back_href} />
}
