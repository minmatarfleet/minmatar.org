---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import { get_request_user } from '@helpers/request_user'
import { HTTP_400_Bad_Request, HTTP_403_Forbidden } from '@helpers/http_responses'
import type { Tribe, TribeGroupPublishing } from '@dtypes/api.minmatar.org'
import type { DiscordChannelUI } from '@dtypes/layout_components'
import {
    get_discord_channels,
    get_group_publishing,
    get_tribe,
    get_tribe_group,
    get_tribe_group_roster,
    update_group_publishing,
} from '@helpers/api.minmatar.org/tribes'
import { discord_channel_ui } from '@helpers/tribe_group_page'
import {
    discord_settings_patch,
    parse_settings_section,
    publishing_settings_patch,
} from '@helpers/tribe_group_settings'

// no-error-refetch: a section save; a failed save or load shows in the form it swaps back.
// One Settings section of the group page (Discord or Publishing). POST saves
// that section only, then renders it again with a saved / error line.
const { auth_token } = get_request_user(Astro)
if (!auth_token) return HTTP_403_Forbidden()

const params = Astro.url.searchParams
const section = parse_settings_section(params.get('section'))
const tribe_id = parseInt(params.get('tribe_id') ?? '')
const group_id = parseInt(params.get('group_id') ?? '')
if (!section || !Number.isFinite(tribe_id) || !Number.isFinite(group_id))
    return HTTP_400_Bad_Request()

let status: { kind: 'success' | 'error', message: string } | null = null
let saved: TribeGroupPublishing | null = null

if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData()
    try {
        const patch = section === 'discord' ? discord_settings_patch(form) : publishing_settings_patch(form)
        saved = await update_group_publishing(auth_token, group_id, patch)
        status = { kind: 'success', message: t('tribes.settings.saved') }
    } catch (error) {
        status = { kind: 'error', message: t('tribes.settings.error').replace('{error}', (error as Error).message) }
    }
}

let settings: TribeGroupPublishing | null = saved
let tribe: Tribe | null = null
let group_name = ''
let channels: DiscordChannelUI[] | null = null
let roster: { character_id: number, character_name: string }[] = []

try {
    const [group, loaded_tribe, loaded_settings] = await Promise.all([
        get_tribe_group(tribe_id, group_id, auth_token),
        get_tribe(tribe_id),
        settings ? Promise.resolve(settings) : get_group_publishing(auth_token, group_id),
    ])
    if (!group.can_manage) return HTTP_403_Forbidden()
    group_name = group.name
    tribe = loaded_tribe
    settings = loaded_settings

    if (section === 'discord') {
        channels = await get_discord_channels(auth_token, 'text')
            .then((list) => list.map(discord_channel_ui))
            .catch(() => null)
    } else {
        roster = (await get_tribe_group_roster(auth_token, tribe_id, group_id).catch(() => []))
            .filter((entry) => entry.primary_character_id)
            .map((entry) => ({ character_id: entry.primary_character_id as number, character_name: entry.primary_character_name }))
    }
} catch (error) {
    settings = null
    status = { kind: 'error', message: `${t('tribes.settings.load_error')} ${(error as Error).message}` }
}

import TribeGroupDiscordSettings from '@components/blocks/TribeGroupDiscordSettings.astro'
import TribeGroupPublishingSettings from '@components/blocks/TribeGroupPublishingSettings.astro'
---

{!settings || !tribe ?
    <p class="[ tribe-settings-section__status is-error ]" role="alert">{status?.message ?? t('tribes.settings.load_error')}</p>
    : section === 'discord' ?
        <TribeGroupDiscordSettings
            settings={settings}
            channels={channels}
            tribe_id={tribe_id}
            group_id={group_id}
            tribe_name={tribe.name}
            group_name={group_name}
            status={status}
        />
        :
        <TribeGroupPublishingSettings
            settings={settings}
            roster={roster}
            tribe_id={tribe_id}
            group_id={group_id}
            tribe_name={tribe.name}
            group_name={group_name}
            status={status}
        />
}
