---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden, HTTP_404_Not_Found } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'

const { auth_token, user } = get_request_user(Astro)

if (!user)
    return HTTP_403_Forbidden()

import type { TrainingDoctrineCell } from '@dtypes/api.minmatar.org'
import { get_training_doctrine } from '@helpers/api.minmatar.org/training'
import { get_item_icon, get_player_icon } from '@helpers/eve_image_server'
import { TRAINING_DOCTRINE_PARTIAL, TRAINING_PARTIAL, time_label, training_url } from '@helpers/training'

const doctrine_id = parseInt(Astro.url.searchParams.get('doctrine_id') ?? '0') || 0
const column = Astro.url.searchParams.get('column') ?? ''
const delay = parseInt(Astro.url.searchParams.get('delay') ?? '0')

if (!doctrine_id || !column)
    return HTTP_404_Not_Found()

let cell:TrainingDoctrineCell | null = null
let fetch_error:Error | false = false

try {
    cell = await get_training_doctrine(auth_token as string, doctrine_id, column)
} catch (error) {
    fetch_error = error as Error
}

// One row per account (or character on no account): its best character.
const ready = cell ? cell.seats.filter(seat => seat.ready).length : 0

import Button from '@components/blocks/Button.astro'
import EmptyState from '@components/blocks/EmptyState.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
---

{fetch_error ?
    <ErrorRefetch
        args={{
            partial: translatePath(training_url(TRAINING_DOCTRINE_PARTIAL, { doctrine_id, column })),
            error: fetch_error,
            delay: delay,
            target: '#modal-description',
        }}
    />
    : cell &&
    <div class="[ training-doctrine ]">
        <div class="[ training-doctrine__head ]">
            <img src={get_item_icon(cell.ship_type_id, 64)} alt="" width="52" height="52" />
            <div>
                <h2>{`${cell.name} · ${cell.column}`}</h2>
                {cell.seats.length > 1 &&
                    <p class="[ training-muted ]">
                        {t('training.accounts_ready').replace('{ready}', ready.toString()).replace('{total}', cell.seats.length.toString())}
                    </p>
                }
            </div>
        </div>

        {cell.seats.length === 0 ?
            <EmptyState title={t('training.nobody_close')} />
            :
            <ul role="list">
                {cell.seats.map(seat =>
                    <li>
                        <span class="[ training-doctrine__account ]">
                            {seat.account !== null && t('training.account').replace('{number}', seat.account.toString())}
                        </span>
                        <img src={get_player_icon(seat.character_id, 64)} alt="" width="40" height="40" loading="lazy" />
                        <span class="[ training-doctrine__name ]">
                            <strong>{seat.name}</strong>
                            <small class="[ training-muted ]">{seat.ships.join(', ')}</small>
                        </span>
                        {seat.ready ?
                            <span class="[ training-doctrine__ready ]" aria-label={t('training.ready')}>✓</span>
                            :
                            <span class="[ training-doctrine__closest ]">
                                <strong>{time_label(t, seat.days)}</strong>
                                {seat.fitting_id !== null &&
                                    <button
                                        type="button"
                                        class="[ training-doctrine__train ]"
                                        modal-action="accept"
                                        hx-post={translatePath(training_url(TRAINING_PARTIAL, { mode: 'add_goal', character_id: seat.character_id, fitting_id: seat.fitting_id }))}
                                        hx-target="#training"
                                        hx-swap="outerHTML"
                                    >
                                        {t('training.train')}
                                    </button>
                                }
                            </span>
                        }
                    </li>
                )}
            </ul>
        }

        <div class="[ training-doctrine__actions ]">
            <Button type="button" size="sm" color="transparent" modal-action="cancel">{t('training.close')}</Button>
        </div>
    </div>
}

<style lang="scss">
    .training-doctrine {
        display: flex;
        flex-direction: column;
        gap: var(--space-m);
        max-height: 88dvh;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding: var(--space-s);
        color: var(--highlight);

        ul {
            margin: 0;
            padding: 0;
            list-style: none;
        }

        li {
            display: flex;
            align-items: center;
            gap: var(--space-s);
            min-height: 3.5rem;
            padding-block: var(--space-2xs);
            border-top: 1px solid var(--hairline);

            img {
                border-radius: var(--space-3xs);
            }
        }
    }

    .training-doctrine__head {
        display: flex;
        align-items: center;
        gap: var(--space-s);
        padding-inline-end: var(--space-xl);

        img {
            border-radius: var(--space-3xs);
        }

        h2 {
            font-family: var(--heading-font);
            font-size: var(--step-2);
            color: var(--fleet-yellow);
        }
    }

    .training-muted {
        color: var(--text-muted);
    }

    .training-doctrine__account {
        flex: 0 0 6rem;
        font-family: var(--heading-font);
        font-size: var(--step--1);
        letter-spacing: 0.06em;
        color: var(--text-muted);
    }

    .training-doctrine__name {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        min-width: 0;

        small {
            font-size: var(--step--1);
        }
    }

    .training-doctrine__train {
        padding: 0;
        border: 0;
        background: none;
        color: var(--fleet-yellow);
        font-size: var(--step--1);
        font-weight: 600;
        text-decoration: underline;
        text-underline-offset: 3px;
        cursor: pointer;
    }

    .training-doctrine__ready {
        color: var(--green);
        font-weight: 700;
    }

    .training-doctrine__closest {
        display: flex;
        flex-direction: column;
        align-items: flex-end;

        strong {
            color: var(--fleet-yellow);
        }
    }

    .training-doctrine__actions {
        display: flex;
        justify-content: flex-end;
    }
</style>
