---
import { i18n } from '@helpers/i18n'
import { get_request_user } from '@helpers/request_user'
const { t, translatePath } = i18n(Astro.url)

import type { CorporationForumPost } from '@dtypes/api.minmatar.org'
import { HTTP_403_Forbidden } from '@helpers/http_responses'
import {
    ForumPostError,
    get_corporation_forum_post,
    update_corporation_forum_post,
} from '@helpers/api.minmatar.org/recruitment'
import {
    forum_post_error_key,
    forum_post_link_text,
    forum_post_section_summary,
    parse_forum_post_action,
    RECRUITMENT_CENTER_URL,
} from '@helpers/corporations/forum_post_settings'
import type { ForumPostFlash } from '@helpers/corporations/forum_post_settings'
import { query_string } from '@helpers/string'

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import Button from '@components/blocks/Button.astro'
import SettingsGroup from '@components/blocks/SettingsGroup.astro'
import SettingRow from '@components/blocks/SettingRow.astro'
import SaveBar from '@components/blocks/SaveBar.astro'
import Input from '@components/blocks/Input.astro'

const ROOT_ID = 'corporation-forum-post'

const { auth_token } = get_request_user(Astro)
if (!auth_token) return HTTP_403_Forbidden()

const corporation_id = parseInt(Astro.url.searchParams.get('corporation_id') ?? '')
if (!corporation_id) return HTTP_403_Forbidden()

const PARTIAL_URL = translatePath(`/partials/corporation_forum_post_component/?${query_string({
    corporation_id: String(corporation_id),
})}`)

let flash: ForumPostFlash | null = null
// The typed URL survives a failed save.
let draft_url: string | null = null

if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData()
    const action = parse_forum_post_action(form.get('action'))
    const typed_url = String(form.get('url') ?? '').trim()
    try {
        await update_corporation_forum_post(auth_token, corporation_id, {
            url: action === 'remove' ? '' : typed_url,
        })
        flash = {
            kind: 'success',
            key: action === 'remove' || !typed_url
                ? 'corporations.forum_post.removed'
                : 'corporations.forum_post.saved',
        }
    } catch (error) {
        draft_url = typed_url
        flash = {
            kind: 'error',
            key: error instanceof ForumPostError
                ? forum_post_error_key(error.message)
                : 'corporations.settings.error_save',
        }
    }
}

const delay = parseInt(Astro.url.searchParams.get('delay') ?? '0')
let fetch_post_error: Error | false = false
let post = null as CorporationForumPost | null
try {
    post = await get_corporation_forum_post(auth_token, corporation_id) as CorporationForumPost | null
} catch (error) {
    fetch_post_error = error
}
if (!fetch_post_error && !post) return HTTP_403_Forbidden()

const url_value = draft_url ?? post?.url ?? ''
const summary = post ? forum_post_section_summary(post, {
    not_linked: t('corporations.forum_post.summary_not_linked'),
    linked: t('corporations.forum_post.summary_linked'),
}) : ''
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
---

{fetch_post_error || !post ?
<ErrorRefetch args={{ partial: PARTIAL_URL, error: fetch_post_error as Error, delay: delay }} />
:
<>
<div id={ROOT_ID} class="[ corp-forum-post ]">
    <form
        method="post"
        action={PARTIAL_URL}
        hx-post={PARTIAL_URL}
        hx-target={`#${ROOT_ID}`}
        hx-swap="outerHTML"
    >
        <Flexblock gap="var(--space-l)">
            <FlexInline class="[ settings-head ]" justification="space-between" gap="var(--space-2xs) var(--space-s)">
                <h2>{t('corporations.settings.forum_section')}</h2>
                <small class="[ corp-forum-post__muted ]">{summary}</small>
            </FlexInline>

            {flash &&
                <p
                    class:list={['[ corp-forum-post__flash ]', { 'is-error': flash.kind === 'error' }]}
                    role={flash.kind === 'error' ? 'alert' : 'status'}
                >
                    {t(flash.key)}
                </p>
            }

            <SettingsGroup>
                <SettingRow title={t('corporations.forum_post.thread')} wide={true}>
                    {post.exists && post.url ?
                        <a
                            class="[ corp-forum-post__thread ]"
                            href={post.url}
                            target="_blank"
                            rel="noreferrer noopener"
                        >{forum_post_link_text(post)}</a>
                        :
                        <span class="[ corp-forum-post__muted ]">{t('corporations.forum_post.not_linked')}</span>
                    }
                    {post.exists && !post.title &&
                        <small class="[ corp-forum-post__muted ]">{t('corporations.forum_post.title_unavailable')}</small>
                    }
                    {post.exists &&
                        <Button
                            type="submit"
                            name="action"
                            value="remove"
                            formnovalidate
                            color="transparent"
                            size="sm"
                            narrow={true}
                            off_disable={true}
                            data-save-bar-ignore
                        >
                            {t('corporations.forum_post.remove')}
                        </Button>
                    }
                </SettingRow>
                <SettingRow
                    title={t('corporations.forum_post.url_label')}
                    description={t('corporations.forum_post.url_help')}
                    for="corp-forum-post-url"
                    wide={true}
                >
                    <Input
                        id="corp-forum-post-url"
                        name="url"
                        type="url"
                        inputmode="url"
                        autocomplete="off"
                        placeholder="https://forums.eveonline.com/t/…"
                        value={url_value}
                        aria-invalid={flash?.kind === 'error' ? 'true' : undefined}
                        required
                    />
                    <a href={RECRUITMENT_CENTER_URL} target="_blank" rel="noreferrer noopener">
                        <small>{t('corporations.forum_post.recruitment_center')}</small>
                    </a>
                </SettingRow>
            </SettingsGroup>

            <SaveBar shown={flash?.kind === 'error'} save_label={t('corporations.forum_post.save')} />
        </Flexblock>
    </form>
</div>
</>
}

<style lang="scss">
    .corp-forum-post__muted {
        color: var(--faded);
    }

    .corp-forum-post__thread {
        overflow-wrap: anywhere;
    }

    .corp-forum-post__flash {
        padding: var(--space-xs) var(--space-s);
        border-left: solid var(--space-3xs) var(--green);
        background-color: var(--component-background);
        color: var(--highlight);

        &.is-error {
            border-left-color: var(--fleet-red);
        }
    }
</style>
