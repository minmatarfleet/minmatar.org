---
// no-error-refetch: on an API failure the spotlight shows its empty state; the guide reads complete without it.
import { HTTP_404_Not_Found } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'
import { get_fleet_role } from '@/data/fleet-roles'
import { get_training_roles } from '@helpers/api.minmatar.org/training'
import type { TrainingRoleSpotlight } from '@dtypes/api.minmatar.org'

const guide = get_fleet_role(Astro.url.searchParams.get('role') ?? '')
const part = Astro.url.searchParams.get('part') === 'fleets' ? 'fleets' : 'pilots'
if (!guide)
    return HTTP_404_Not_Found()

const { auth_token, user } = get_request_user(Astro)

let spotlight: TrainingRoleSpotlight | null = null
if (user && auth_token) {
    try {
        spotlight = await get_training_roles(auth_token, guide.capabilities, guide.ladder.map((rung) => rung.ship_type_id))
    } catch (error) {
        console.log(`Role spotlight unavailable: ${error.message}`)
        spotlight = { pilots: [], fleets: [], fleets_days: 60 }
    }
}

import RoleSpotlight from '@components/blocks/role-guide/RoleSpotlight.astro'
---

<RoleSpotlight part={part} spotlight={spotlight} />
