---
// no-error-refetch: a section save; a failed check or save shows in the form it swaps back.
import { i18n } from '@helpers/i18n'
import { get_request_user } from '@helpers/request_user'
const { t, translatePath } = i18n(Astro.url)

import type { CorporationDiscordInvitePreview, CorporationDiscordSettings } from '@dtypes/api.minmatar.org'
import { HTTP_403_Forbidden } from '@helpers/http_responses'
import {
    DiscordInviteError,
    check_corporation_discord,
    disconnect_corporation_discord_bot,
    get_corporation_discord,
    remove_corporation_discord,
    retry_corporation_discord_bot,
    update_corporation_discord,
} from '@helpers/api.minmatar.org/corporations'
import {
    discord_bot_connect_flash,
    discord_bot_needs_attention,
    discord_bot_next_poll,
    discord_bot_status_key,
    discord_error_key,
    discord_invite_label,
    discord_section_summary,
    discord_server_initials,
    discord_status_key,
    parse_discord_action,
} from '@helpers/corporations/discord_settings'
import type { DiscordSettingsFlash } from '@helpers/corporations/discord_settings'
import { query_string } from '@helpers/string'

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import Button from '@components/blocks/Button.astro'
import Input from '@components/blocks/Input.astro'

const ROOT_ID = 'corporation-discord'
const URL_HELP_ID = 'corp-discord-url-help'
// Lives in the accordion header on the corporation page; refreshed out of band.
const SUMMARY_ID = 'corporation-settings-discord-summary'

const { auth_token } = get_request_user(Astro)
if (!auth_token) return HTTP_403_Forbidden()

const corporation_id = parseInt(Astro.url.searchParams.get('corporation_id') ?? '')
if (!corporation_id) return HTTP_403_Forbidden()

const partial_url = (extra: Record<string, string> = {}) => translatePath(`/partials/corporation_discord_component/?${query_string({
    corporation_id: String(corporation_id),
    ...extra,
})}`)
const PARTIAL_URL = partial_url()
// A full page navigation: Discord's install page, then back to Settings.
const BOT_CONNECT_URL = translatePath(`/redirects/discord_bot_connect_init?${query_string({
    corporation_id: String(corporation_id),
})}`)
const poll = parseInt(Astro.url.searchParams.get('poll') ?? '0') || 0

// Set when Discord sends the CEO back from the bot install page.
let flash: DiscordSettingsFlash | null = poll ? null : discord_bot_connect_flash(Astro.url.searchParams)
// The typed link survives a failed check or save.
let draft_url: string | null = null
let preview: CorporationDiscordInvitePreview | null = null
let editing = false

if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData()
    const action = parse_discord_action(form.get('action'))
    const typed_url = String(form.get('invite_url') ?? '').trim()
    try {
        if (action === 'check') {
            editing = true
            draft_url = typed_url
            preview = await check_corporation_discord(auth_token, corporation_id, typed_url)
            draft_url = preview.invite_url
        } else if (action === 'save') {
            await update_corporation_discord(auth_token, corporation_id, typed_url)
            flash = { kind: 'success', key: 'corporations.discord.saved' }
        } else if (action === 'remove') {
            await remove_corporation_discord(auth_token, corporation_id)
            flash = { kind: 'success', key: 'corporations.discord.removed' }
        } else if (action === 'replace') {
            editing = true
        } else if (action === 'disconnect_bot') {
            await disconnect_corporation_discord_bot(auth_token, corporation_id)
            flash = { kind: 'success', key: 'corporations.discord.bot_disconnected' }
        } else if (action === 'retry_bot') {
            await retry_corporation_discord_bot(auth_token, corporation_id)
            flash = { kind: 'success', key: 'corporations.discord.bot_retrying' }
        }
    } catch (error) {
        editing = true
        draft_url = typed_url
        preview = null
        flash = {
            kind: 'error',
            key: error instanceof DiscordInviteError
                ? discord_error_key(error.message)
                : 'corporations.settings.error_save',
        }
    }
}

const settings = await get_corporation_discord(auth_token, corporation_id) as CorporationDiscordSettings | null
if (!settings) return HTTP_403_Forbidden()

const bot = settings.bot
// While the bot is linked it is the page's Discord; the pasted link stays
// stored as the fallback but isn't edited here.
const bot_connected = bot.connected
const bot_attention = bot_connected && discord_bot_needs_attention(bot.status)
const next_poll = bot_connected ? discord_bot_next_poll(bot.status, poll) : null
const bot_slow = bot_connected && bot.status === 'pending' && next_poll === null

const is_dead = !bot_connected && settings.exists && settings.status === 'dead'
// The bot is the main path; the paste box opens on request, or when it's the
// only way forward (no bot here, or the pasted link died).
const show_input = !bot_connected && (editing || (!settings.exists && !bot.available) || is_dead)
const can_cancel = editing && (settings.exists || bot.available) && !is_dead
const show_link_card = !bot_connected && settings.exists
const offer_bot = !bot_connected && bot.available && !editing
const summary = discord_section_summary(settings, {
    not_set: t('corporations.discord.summary_not_set'),
    set: t('corporations.discord.summary_set'),
    dead: t('corporations.discord.summary_dead'),
    setting_up: t('corporations.discord.summary_setting_up'),
    attention: t('corporations.discord.summary_attention'),
})
const server_name = settings.guild_name ?? t('corporations.discord.unknown_server')
const bot_server_name = bot.guild_name ?? t('corporations.discord.unknown_server')
---

<span id={SUMMARY_ID} hx-swap-oob="innerHTML">
    <span class:list={['[ corp-discord__summary ]', { 'is-attention': is_dead || bot_attention }]}>{summary}</span>
</span>

<div
    id={ROOT_ID}
    class="[ corp-discord ]"
    hx-get={next_poll ? partial_url({ poll: String(next_poll) }) : undefined}
    hx-trigger={next_poll ? 'load delay:3s' : undefined}
    hx-target={next_poll ? 'this' : undefined}
    hx-swap={next_poll ? 'outerHTML' : undefined}
>
    <form
        method="post"
        action={PARTIAL_URL}
        hx-post={PARTIAL_URL}
        hx-target={`#${ROOT_ID}`}
        hx-swap="outerHTML"
    >
        <Flexblock gap="var(--space-m)">
            {!settings.exists && !bot_connected &&
                <p class="[ corp-discord__muted ]">
                    {bot.available ? t('corporations.discord.bot_leading') : t('corporations.discord.leading')}
                </p>
            }

            {flash &&
                <p
                    class:list={['[ corp-discord__flash ]', { 'is-error': flash.kind === 'error' }]}
                    role={flash.kind === 'error' ? 'alert' : 'status'}
                >
                    {t(flash.key)}
                </p>
            }

            {bot_connected &&
                <div class="[ corp-discord__server ]">
                    {bot.icon_url ?
                        <img class="[ corp-discord__avatar ]" src={bot.icon_url} alt="" width="48" height="48" loading="lazy" />
                        :
                        <span class="[ corp-discord__avatar ]" aria-hidden="true">{discord_server_initials(bot.guild_name)}</span>
                    }
                    <div class="[ corp-discord__name ]">
                        <span class="[ corp-discord__title ]">{bot_server_name}</span>
                        {bot.invite_url ?
                            <a href={bot.invite_url} target="_blank" rel="noreferrer noopener">
                                <small>{discord_invite_label(bot.invite_url)}</small>
                            </a>
                            : bot.channel_name &&
                            <small class="[ corp-discord__muted ]">{t('corporations.discord.bot_channel').replace('{channel}', bot.channel_name)}</small>
                        }
                    </div>
                    <small class:list={['[ corp-discord__status ]', `is-${bot.status}`]}>
                        {t(discord_bot_status_key(bot.status))}
                    </small>
                    <FlexInline gap="var(--space-3xs)">
                        {bot.status === 'no_permission' &&
                            <Button type="submit" name="action" value="retry_bot" formnovalidate color="transparent" size="sm" narrow={true} off_disable={true}>
                                {t('corporations.discord.bot_retry')}
                            </Button>
                        }
                        {bot.status === 'removed' &&
                            <Button href={BOT_CONNECT_URL} color="transparent" size="sm" narrow={true}>
                                {t('corporations.discord.bot_add_again')}
                            </Button>
                        }
                        <Button type="submit" name="action" value="disconnect_bot" formnovalidate color="transparent" size="sm" narrow={true} off_disable={true}>
                            {t('corporations.discord.bot_disconnect')}
                        </Button>
                    </FlexInline>
                </div>
            }

            {bot_connected && !flash && bot.status === 'pending' &&
                <p class="[ corp-discord__muted ]" role="status">
                    {bot_slow ? t('corporations.discord.bot_pending_slow') : t('corporations.discord.bot_pending_help')}
                </p>
            }

            {bot_attention && !flash &&
                <p class="[ corp-discord__attention ]">
                    {bot.status === 'removed' ? t('corporations.discord.bot_removed_help') : t('corporations.discord.bot_no_permission_help')}
                    {settings.page_source === 'link' && <> {t('corporations.discord.bot_fallback')}</>}
                </p>
            }

            {bot_connected && bot.status === 'ok' && !flash &&
                <small class="[ corp-discord__muted ]">
                    {bot.channel_name && <>{t('corporations.discord.bot_channel').replace('{channel}', bot.channel_name)} · </>}
                    {t('corporations.discord.bot_renewed')}
                </small>
            }

            {offer_bot &&
                <FlexInline gap="var(--space-xs)">
                    <Button href={BOT_CONNECT_URL} color={settings.exists ? 'transparent' : 'fleet-red'} size="sm">
                        {settings.exists ? t('corporations.discord.bot_instead') : t('corporations.discord.bot_add')}
                    </Button>
                    {!settings.exists &&
                        <Button type="submit" name="action" value="replace" formnovalidate color="transparent" size="sm" narrow={true} off_disable={true}>
                            {t('corporations.discord.paste_instead')}
                        </Button>
                    }
                </FlexInline>
            }

            {show_link_card &&
                <div class="[ corp-discord__server ]">
                    {settings.icon_url ?
                        <img class="[ corp-discord__avatar ]" src={settings.icon_url} alt="" width="48" height="48" loading="lazy" />
                        :
                        <span class="[ corp-discord__avatar ]" aria-hidden="true">{discord_server_initials(settings.guild_name)}</span>
                    }
                    <div class="[ corp-discord__name ]">
                        <span class="[ corp-discord__title ]">{server_name}</span>
                        <a href={settings.invite_url} target="_blank" rel="noreferrer noopener">
                            <small>{discord_invite_label(settings.invite_url)}</small>
                        </a>
                    </div>
                    <small class:list={['[ corp-discord__status ]', `is-${settings.status}`]}>
                        {t(discord_status_key(settings.status))}
                    </small>
                    <FlexInline gap="var(--space-3xs)">
                        {!show_input &&
                            <Button type="submit" name="action" value="replace" formnovalidate color="transparent" size="sm" narrow={true} off_disable={true}>
                                {t('corporations.discord.replace')}
                            </Button>
                        }
                        <Button type="submit" name="action" value="remove" formnovalidate color="transparent" size="sm" narrow={true} off_disable={true}>
                            {t('corporations.discord.remove')}
                        </Button>
                    </FlexInline>
                </div>
            }

            {is_dead && !flash &&
                <p class="[ corp-discord__attention ]">{t('corporations.discord.dead_help')}</p>
            }

            {show_input &&
                <Flexblock gap="var(--space-3xs)">
                    <label class="[ corp-discord__label ]" for="corp-discord-url">
                        {t('corporations.discord.url_label')}
                    </label>
                    <FlexInline gap="var(--space-xs)" class="[ corp-discord__field ]">
                        <Input
                            id="corp-discord-url"
                            name="invite_url"
                            type="text"
                            inputmode="url"
                            autocomplete="off"
                            placeholder="https://discord.gg/…"
                            value={draft_url ?? ''}
                            aria-describedby={URL_HELP_ID}
                            aria-invalid={flash?.kind === 'error' ? 'true' : undefined}
                            required
                        />
                        <Button type="submit" name="action" value="check" color="transparent" size="sm" off_disable={true}>
                            {t('corporations.discord.check')}
                        </Button>
                    </FlexInline>
                    <small id={URL_HELP_ID} class="[ corp-discord__muted ]">
                        {t('corporations.discord.url_help')}
                    </small>
                </Flexblock>
            }

            {preview &&
                <Flexblock gap="var(--space-s)">
                    <div class="[ corp-discord__server ]">
                        {preview.icon_url ?
                            <img class="[ corp-discord__avatar ]" src={preview.icon_url} alt="" width="48" height="48" loading="lazy" />
                            :
                            <span class="[ corp-discord__avatar ]" aria-hidden="true">{discord_server_initials(preview.guild_name)}</span>
                        }
                        <div class="[ corp-discord__name ]">
                            <span class="[ corp-discord__title ]">{preview.guild_name ?? t('corporations.discord.unknown_server')}</span>
                            <small class="[ corp-discord__muted ]">{discord_invite_label(preview.invite_url)}</small>
                        </div>
                        {preview.checked &&
                            <small class="[ corp-discord__status is-ok ]">{t('corporations.discord.never_expires')}</small>
                        }
                    </div>
                    {!preview.checked &&
                        <p class="[ corp-discord__muted ]">{t('corporations.discord.unchecked')}</p>
                    }
                </Flexblock>
            }

            {(preview || can_cancel) &&
                <FlexInline gap="var(--space-m)">
                    {preview &&
                        <Button type="submit" name="action" value="save" color="fleet-red" size="sm" off_disable={true}>
                            {t('corporations.discord.save')}
                        </Button>
                    }
                    {can_cancel &&
                        <Button type="submit" name="action" value="cancel" formnovalidate color="transparent" size="sm" narrow={true} off_disable={true}>
                            {t('corporations.discord.cancel')}
                        </Button>
                    }
                </FlexInline>
            }
        </Flexblock>
    </form>
</div>

<style lang="scss">
    .corp-discord {
        max-width: var(--max-text-width);
    }

    // Flexblock spaces children with margin-block-start; keep that intact.
    p {
        margin-block-end: 0;
    }

    .corp-discord__muted {
        color: var(--faded);
    }

    .corp-discord__attention,
    .corp-discord__summary.is-attention {
        color: var(--fleet-yellow);
    }

    .corp-discord__label {
        font-family: var(--button-font);
        color: var(--highlight);
    }

    // The button drops below the box on phones instead of squeezing it.
    .corp-discord__field > :global(:first-child) {
        flex: 1 1 calc(var(--space-3xl) * 3);
        min-width: 0;
    }

    .corp-discord__server {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-xs) var(--space-s);
        padding: var(--space-s);
        border: solid 1px var(--border-color);
        background-color: var(--component-background);
    }

    .corp-discord__avatar {
        display: grid;
        place-items: center;
        flex: none;
        width: var(--space-xl);
        height: var(--space-xl);
        border-radius: 50%;
        background-color: var(--surface-sunken);
        color: var(--highlight);
        font-weight: 700;
    }

    .corp-discord__name {
        display: flex;
        flex-direction: column;
        // Wide enough for a server name before the status wraps below it.
        flex: 1 1 calc(var(--space-3xl) * 2);
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .corp-discord__title {
        color: var(--highlight);
        font-weight: 600;
    }

    .corp-discord__status {
        font-weight: 600;
        color: var(--faded);

        &.is-ok {
            color: var(--green);
        }

        &.is-dead,
        &.is-no_permission,
        &.is-removed {
            color: var(--fleet-yellow);
        }
    }

    .corp-discord__flash {
        padding: var(--space-xs) var(--space-s);
        border-left: solid var(--space-3xs) var(--green);
        background-color: var(--component-background);
        color: var(--highlight);

        &.is-error {
            border-left-color: var(--fleet-red);
        }
    }
</style>
