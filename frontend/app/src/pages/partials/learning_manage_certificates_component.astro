---
// no-error-refetch: an author form; a failed save shows inline above the form.
import { i18n, t_key } from '@helpers/i18n'
import { get_request_user } from '@helpers/request_user'
import { HTTP_403_Forbidden } from '@helpers/http_responses'
import { get_gates, can } from '@helpers/gates'
import {
    change_manage_award,
    get_manage_certificates,
    get_manage_guides,
    save_manage_certificate,
} from '@helpers/api.minmatar.org/learning_manage'
import type { LearningManageCertificate } from '@dtypes/api.minmatar.org'
import { error_text, form_flag, form_int, form_lines, form_text } from '@helpers/manage_forms'
import type { ManageFlashState } from '@helpers/manage_forms'

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import Button from '@components/blocks/Button.astro'
import Input from '@components/blocks/Input.astro'
import Select from '@components/blocks/Select.astro'
import Textarea from '@components/blocks/Textarea.astro'
import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import ManageFlash from '@components/blocks/ManageFlash.astro'

const { t, translatePath } = i18n(Astro.url)
const ROOT_ID = 'learning-manage-certificates'
const PARTIAL_URL = translatePath('/partials/learning_manage_certificates_component/')
const PERSONAS = ['alliance', 'militia', 'other']

const { auth_token } = get_request_user(Astro)
if (!auth_token) return HTTP_403_Forbidden()
if (!can(await get_gates(Astro), 'learning.manage')) return HTTP_403_Forbidden()

let flash: ManageFlashState | null = null

if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData()
    const action = form_text(form, 'action')
    try {
        if (action === 'award' || action === 'revoke') {
            await change_manage_award(auth_token, action === 'revoke', {
                username: form_text(form, 'username'),
                certificate_slug: form_text(form, 'certificate_slug'),
                reason: form_text(form, 'reason'),
            })
            flash = {
                kind: 'success',
                message: action === 'award' ? t('learning_manage.award_awarded') : t('learning_manage.award_revoked'),
            }
        } else {
            const original_slug = form_text(form, 'original_slug') || null
            await save_manage_certificate(auth_token, original_slug, {
                slug: form_text(form, 'slug'),
                title: form_text(form, 'title'),
                summary: form_text(form, 'summary'),
                published: form_flag(form, 'published'),
                sort_order: form_int(form, 'sort_order') ?? 0,
                personas: PERSONAS.filter((persona) => form_flag(form, `persona_${persona}`)),
                learning_slugs: form_lines(form, 'learning_slugs'),
            })
            flash = { kind: 'success', message: t('learning_manage.saved') }
        }
    } catch (error) {
        flash = { kind: 'error', message: error_text(error, t('learning_manage.error_save')) }
    }
}

const certificates = await get_manage_certificates(auth_token)
const guides = await get_manage_guides(auth_token)
const rows: (LearningManageCertificate | null)[] = [...certificates, null]
---

<div id={ROOT_ID}>
    <Flexblock gap="var(--space-l)">
        <ManageFlash flash={flash} />

        <p>{t('learning_manage.certificates_lead')}</p>

        <small>{t('learning_manage.available_guides')} {guides.map((guide) => guide.slug).join(', ')}</small>

        {rows.map((certificate) =>
            <ComponentBlock padding_inline="var(--space-s)" padding_block="var(--space-s)">
                <form
                    method="post"
                    action={PARTIAL_URL}
                    hx-post={PARTIAL_URL}
                    hx-target={`#${ROOT_ID}`}
                    hx-swap="outerHTML"
                >
                    <Flexblock gap="var(--space-s)">
                        <h3>{certificate ? certificate.title : t('learning_manage.certificates_new')}</h3>
                        <input type="hidden" name="original_slug" value={certificate?.slug ?? ''} />
                        <Input name="title" placeholder={t('learning_manage.title')} aria-label={t('learning_manage.title')} value={certificate?.title ?? ''} required />
                        <Input name="slug" placeholder={t('learning_manage.slug')} aria-label={t('learning_manage.slug')} value={certificate?.slug ?? ''} required />
                        <Textarea name="summary" rows="2" aria-label={t('learning_manage.summary')} placeholder={t('learning_manage.summary')}>{certificate?.summary ?? ''}</Textarea>
                        <Input name="sort_order" type="number" min="0" aria-label={t('learning_manage.sort_order')} placeholder={t('learning_manage.sort_order')} value={String(certificate?.sort_order ?? 0)} />
                        <FlexInline gap="var(--space-m)">
                            {PERSONAS.map((persona) =>
                                <label>
                                    <input type="checkbox" name={`persona_${persona}`} checked={certificate?.personas.includes(persona) ?? false} />
                                    {t(t_key("learning_manage.persona_", persona))}
                                </label>
                            )}
                            <label>
                                <input type="checkbox" name="published" checked={certificate?.published ?? true} />
                                {t('learning_manage.published')}
                            </label>
                        </FlexInline>
                        <label for={`learning-manage-guides-${certificate?.slug ?? 'new'}`}>{t('learning_manage.certificate_guides')}</label>
                        <Textarea id={`learning-manage-guides-${certificate?.slug ?? 'new'}`} name="learning_slugs" rows="4">{certificate?.learning_slugs.join('\n') ?? ''}</Textarea>
                        <FlexInline gap="var(--space-s)" class="[ items-center ]">
                            <Button type="submit" color="fleet-red" size="sm" off_disable={true}>{t('learning_manage.save')}</Button>
                            {certificate && <small>{t('learning_manage.award_count').replace('{count}', String(certificate.award_count))}</small>}
                        </FlexInline>
                    </Flexblock>
                </form>
            </ComponentBlock>
        )}

        <ComponentBlock padding_inline="var(--space-s)" padding_block="var(--space-s)">
            <form
                method="post"
                action={PARTIAL_URL}
                hx-post={PARTIAL_URL}
                hx-target={`#${ROOT_ID}`}
                hx-swap="outerHTML"
            >
                <Flexblock gap="var(--space-s)">
                    <h3>{t('learning_manage.award_heading')}</h3>
                    <Input name="username" placeholder={t('learning_manage.username')} aria-label={t('learning_manage.username')} required />
                    <Select name="certificate_slug" aria-label={t('learning_manage.certificate')} required>
                        {certificates.map((certificate) => <option value={certificate.slug}>{certificate.title}</option>)}
                    </Select>
                    <Input name="reason" placeholder={t('learning_manage.reason')} aria-label={t('learning_manage.reason')} required />
                    <FlexInline gap="var(--space-s)">
                        <Button type="submit" name="action" value="award" color="fleet-red" size="sm" off_disable={true}>{t('learning_manage.award')}</Button>
                        <Button type="submit" name="action" value="revoke" color="transparent" size="sm" narrow={true} off_disable={true}>{t('learning_manage.revoke')}</Button>
                    </FlexInline>
                    <small>{t('learning_manage.award_hint')}</small>
                </Flexblock>
            </form>
        </ComponentBlock>
    </Flexblock>
</div>

<style lang="scss">
    h3 {
        font-size: var(--step-0);
        margin-block-end: 0;
    }
</style>
