---
/**
 * Manage learning: Certificates.
 *
 * part=list   the certificates table, in their order (GET); new=1 adds an
 *             open blank certificate row
 * part=edit   an open row's form (GET, slug=)
 * part=save   save a certificate (POST): the row, open, inside a <table>
 * part=order  save the order after a row moves (POST, order=slug...)
 * part=award  the "Award by hand" section body (GET), and its award or
 *             revoke (POST), which swaps the body
 *
 * Writes go through the learning manage API, which writes the audit log.
 */
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { get_request_user } from '@helpers/request_user'
import { HTTP_403_Forbidden } from '@helpers/http_responses'
import { get_gates, can } from '@helpers/gates'
import {
    change_manage_award,
    get_manage_certificates,
    get_manage_guides,
    order_manage_certificates,
    save_manage_certificate,
} from '@helpers/api.minmatar.org/learning_manage'
import type { LearningManageGuideRow } from '@helpers/api.minmatar.org/learning_manage'
import type { LearningManageCertificate, LearningManageCertificateWrite } from '@dtypes/api.minmatar.org'
import { error_text, form_flag, form_text } from '@helpers/manage_forms'
import { CERTIFICATE_ORDER_EVENT, PERSONAS } from '@helpers/learning_manage'
import { query_string } from '@helpers/string'

import EmptyState from '@components/blocks/EmptyState.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import Button from '@components/blocks/Button.astro'
import Input from '@components/blocks/Input.astro'
import Select from '@components/blocks/Select.astro'
import ManageTable from '@components/blocks/manage/ManageTable.astro'
import ManageField from '@components/blocks/manage/ManageField.astro'
import SettingsSection from '@components/blocks/manage/SettingsSection.astro'
import LearningCertificateRow from '@components/blocks/learning_manage/LearningCertificateRow.astro'
import LearningCertificateForm from '@components/blocks/learning_manage/LearningCertificateForm.astro'

const { auth_token } = get_request_user(Astro)
if (!auth_token) return HTTP_403_Forbidden()
if (!can(await get_gates(Astro), 'learning.manage')) return HTTP_403_Forbidden()

const ROOT_ID = 'learning-manage-certificates'
const params = Astro.url.searchParams
const part = params.get('part') ?? 'list'
const is_post = Astro.request.method === 'POST'
const partial_url = (values: Record<string, string>) =>
    translatePath(`/partials/learning_manage_certificates_component/?${query_string(values)}`)
const save_url = partial_url({ part: 'save' })
const row_id_of = (slug: string) => `certificate-${slug}`
const form = is_post ? await Astro.request.formData() : null

// part=order
if (part === 'order' && form) {
    try {
        await order_manage_certificates(auth_token, form.getAll('order').map(String))
    } catch (error) {
        return new Response(error_text(error, t('learning_manage.error_save')), { status: 400 })
    }
}

// part=save
let saved_slug: string | null = null
let save_error: string | null = null
let posted: LearningManageCertificateWrite | null = null
let posted_original: string | null = null
let posted_row_id = ''
if (part === 'save' && form) {
    posted_original = form_text(form, 'original_slug') || null
    posted_row_id = form_text(form, 'row_id') || (posted_original ? row_id_of(posted_original) : 'certificate-new')
    const chosen = form.getAll('personas').map(String)
    posted = {
        slug: form_text(form, 'slug'),
        title: form_text(form, 'title'),
        summary: form_text(form, 'summary'),
        published: form_flag(form, 'published'),
        personas: PERSONAS.filter((persona) => chosen.includes(persona)),
        learning_slugs: form.getAll('learning_slugs').map(String).filter(Boolean),
    }
    try {
        const certificates_now = await get_manage_certificates(auth_token)
        const existing = certificates_now.find((certificate) => certificate.slug === posted_original)
        // Order is set by dragging rows; a new certificate goes last.
        posted.sort_order = existing?.sort_order ?? Math.max(0, ...certificates_now.map((certificate) => certificate.sort_order)) + 1
        await save_manage_certificate(auth_token, posted_original, posted)
        saved_slug = posted.slug
    } catch (error) {
        save_error = error_text(error, t('learning_manage.error_save'))
    }
}

// part=award
let award_message: { kind: 'good' | 'error'; text: string } | null = null
if (part === 'award' && form) {
    const revoke = form_text(form, 'action') === 'revoke'
    try {
        await change_manage_award(auth_token, revoke, {
            username: form_text(form, 'username'),
            certificate_slug: form_text(form, 'certificate_slug'),
            reason: form_text(form, 'reason'),
        })
        award_message = { kind: 'good', text: revoke ? t('learning_manage.award_revoked') : t('learning_manage.award_awarded') }
    } catch (error) {
        award_message = { kind: 'error', text: error_text(error, t('learning_manage.error_save')) }
    }
}

let certificates: LearningManageCertificate[] = []
let guides: LearningManageGuideRow[] = []
let error: Error | null = null
if (part !== 'order') {
    try {
        [certificates, guides] = await Promise.all([
            get_manage_certificates(auth_token),
            part === 'award' ? Promise.resolve([]) : get_manage_guides(auth_token),
        ])
    } catch (failure) {
        error = failure as Error
    }
}
const guide_options = guides
    .map((guide) => ({ slug: guide.slug, title: guide.title, published: guide.published }))
    .sort((a, b) => a.title.localeCompare(b.title))

const COLUMNS = [
    { label: t('learning_admin.col_certificate') },
    { label: t('learning_admin.col_guides'), align: 'num' as const, phone: false },
    { label: t('learning_admin.col_awarded'), align: 'num' as const, phone: false },
    { label: t('learning_admin.col_status') },
    { label: t('learning_admin.col_order'), align: 'act' as const, hidden: true },
]
const BLANK: LearningManageCertificateWrite = { slug: '', title: '', summary: '', published: false, personas: [], learning_slugs: [] }
const values_of = (certificate: LearningManageCertificate): LearningManageCertificateWrite => ({
    slug: certificate.slug,
    title: certificate.title,
    summary: certificate.summary,
    published: certificate.published,
    personas: certificate.personas,
    learning_slugs: certificate.learning_slugs,
})
const show_new = params.get('new') === '1'
const edit_certificate = part === 'edit' ? certificates.find((certificate) => certificate.slug === params.get('slug')) ?? null : null
const saved_certificate = saved_slug ? certificates.find((certificate) => certificate.slug === saved_slug) ?? null : null
const row_certificate = saved_certificate ?? (posted_original ? certificates.find((certificate) => certificate.slug === posted_original) ?? null : null)
const award_count = certificates.reduce((sum, certificate) => sum + certificate.award_count, 0)
---

{part === 'list' && (
    error
        ? <div id={ROOT_ID}><ErrorRefetch args={{ partial: partial_url({ part: 'list' }), error, delay: 0 }} /></div>
        : (
            <div id={ROOT_ID} class="[ manage-list ]">
                <div id="certificates-table" x-data="{ dragging: null }">
                    {certificates.length === 0 && !show_new
                        ? <EmptyState title={t('learning_admin.no_certificates')} />
                        : (
                            <ManageTable caption={t('learning_admin.certificates_caption')} columns={COLUMNS}>
                                {certificates.map((certificate) => (
                                    <LearningCertificateRow
                                        certificate={certificate}
                                        row_id={row_id_of(certificate.slug)}
                                        url={partial_url({ part: 'edit', slug: certificate.slug })}
                                    />
                                ))}
                                {show_new &&
                                    <LearningCertificateRow certificate={null} row_id="certificate-new" open={true}>
                                        <LearningCertificateForm slot="detail" values={BLANK} original_slug={null} row_id="certificate-new" post_url={save_url} guides={guide_options} />
                                    </LearningCertificateRow>
                                }
                            </ManageTable>
                        )
                    }
                </div>
                <div class="[ manage-actions ]">
                    {!show_new &&
                        <Button
                            type="button"
                            size="sm"
                            color="transparent"
                            narrow={true}
                            hx-get={partial_url({ part: 'list', new: '1' })}
                            hx-target={`#${ROOT_ID}`}
                            hx-swap="outerHTML"
                        >{t('learning_admin.certificates_new_action')}</Button>
                    }
                    <span class="[ manage-muted ]">{t('learning_admin.order_hint')}</span>
                    {/* Saves the order whenever a row moves. */}
                    <span
                        id="certificates-order-saved"
                        aria-live="polite"
                        hx-post={partial_url({ part: 'order' })}
                        hx-trigger={`${CERTIFICATE_ORDER_EVENT} from:body`}
                        hx-include="#certificates-table input[name=order]"
                        hx-target="this"
                        hx-swap="innerHTML"
                    ></span>
                </div>

                <SettingsSection
                    id="certificates-award"
                    title={t('learning_manage.award_heading')}
                    summary={t('learning_admin.award_summary').replace('~COUNT', String(award_count))}
                    url={partial_url({ part: 'award' })}
                    load="open"
                />
            </div>
        )
)}

{part === 'order' && <span class="[ manage-saved ]">{t('learning_admin.order_saved')}</span>}

{part === 'edit' && (
    edit_certificate
        ? <LearningCertificateForm values={values_of(edit_certificate)} original_slug={edit_certificate.slug} row_id={row_id_of(edit_certificate.slug)} post_url={save_url} guides={guide_options} />
        : error
            ? <ErrorRefetch args={{ partial: partial_url({ part: 'edit', slug: params.get('slug') ?? '' }), error, delay: 0 }} />
            : <EmptyState title={t('learning_admin.certificate_gone')} />
)}

{part === 'save' && posted &&
    // Inside a <table>: htmx drops a bare <tbody> after Astro's leading styles.
    <table>
        <LearningCertificateRow certificate={row_certificate} row_id={posted_row_id} open={true}>
            <LearningCertificateForm
                slot="detail"
                values={saved_certificate ? values_of(saved_certificate) : posted}
                original_slug={saved_certificate ? saved_certificate.slug : posted_original}
                row_id={posted_row_id}
                post_url={save_url}
                guides={guide_options}
                saved={saved_slug !== null}
                error={save_error}
            />
        </LearningCertificateRow>
    </table>
}

{part === 'award' && (
    error
        ? <div class="[ manage-section__body ]"><ErrorRefetch args={{ partial: partial_url({ part: 'award' }), error, delay: 0 }} /></div>
        : (
            <form
                class="[ manage-section__body manage-form ]"
                hx-post={partial_url({ part: 'award' })}
                hx-target="this"
                hx-swap="outerHTML"
            >
                <div class="[ manage-fields ]">
                    <ManageField label={t('learning_manage.username')} for="award-username" hint={t('learning_admin.username_hint')}>
                        <Input id="award-username" name="username" required autocomplete="off" />
                    </ManageField>
                    <ManageField label={t('learning_manage.certificate')} for="award-certificate">
                        <Select id="award-certificate" name="certificate_slug" required>
                            {certificates.map((certificate) => <option value={certificate.slug}>{certificate.title}</option>)}
                        </Select>
                    </ManageField>
                    <ManageField label={t('learning_manage.reason')} for="award-reason">
                        <Input id="award-reason" name="reason" required />
                    </ManageField>
                </div>
                <p class="[ manage-field__hint ]">{t('learning_manage.award_hint')}</p>
                {award_message?.kind === 'error' && <p class="[ manage-field__error ]" role="alert">{award_message.text}</p>}
                <div class="[ manage-actions ]">
                    <Button type="submit" size="sm" name="action" value="award">{t('learning_manage.award')}</Button>
                    <Button type="submit" size="sm" color="transparent" narrow={true} name="action" value="revoke">{t('learning_manage.revoke')}</Button>
                    {award_message?.kind === 'good' && <span class="[ manage-saved ]">{award_message.text}</span>}
                </div>
            </form>
        )
)}
