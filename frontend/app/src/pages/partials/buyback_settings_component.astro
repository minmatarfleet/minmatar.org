---
import { i18n } from '@helpers/i18n'
import { get_request_user } from '@helpers/request_user'
import { HTTP_403_Forbidden } from '@helpers/http_responses'
import { get_gates, can } from '@helpers/gates'
const { t, translatePath } = i18n(Astro.url)

import type { BuybackManageSettings } from '@dtypes/api.minmatar.org'
import {
    add_buyback_item,
    delete_buyback_item,
    get_buyback_manage_settings,
    patch_buyback_item,
    patch_buyback_settings,
    search_buyback_types,
} from '@helpers/api.minmatar.org/buyback_settings'

import Button from '@components/blocks/Button.astro'
import Input from '@components/blocks/Input.astro'
import EmptyState from '@components/blocks/EmptyState.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'

const ROOT_ID = 'buyback-settings'
const PARTIAL_URL = translatePath('/partials/buyback_settings_component/')

const { auth_token } = get_request_user(Astro)
if (!auth_token) return HTTP_403_Forbidden()
if (!can(await get_gates(Astro), 'buyback.manage')) return HTTP_403_Forbidden()

let flash: { error: boolean, text: string } | null = null
let search_query = ''
let search_results: { type_id: number, name: string }[] = []
let new_category = 'ore'

if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData()
    const action = String(form.get('action') ?? '')
    const text = (name: string) => String(form.get(name) ?? '').trim()
    const number = (name: string) => parseFloat(text(name))
    try {
        switch (action) {
            case 'save_settings': {
                const location_id = parseInt(text('location_id'))
                await patch_buyback_settings(auth_token, {
                    active: form.get('active') === 'on',
                    location_id: location_id || null,
                    clear_location: !location_id,
                    // The form shows percentages; the API takes shares from 0 to 1.
                    ore_refine: number('ore_refine') / 100,
                    demand_jita_buy: number('demand_jita_buy') / 100,
                    surplus_jita_buy: number('surplus_jita_buy') / 100,
                })
                flash = { error: false, text: t('buyback.settings.saved') }
                break
            }
            case 'search':
                search_query = text('q')
                new_category = text('category') || 'ore'
                search_results = (await search_buyback_types(auth_token, search_query)) ?? []
                break
            case 'add_item':
                await add_buyback_item(auth_token, parseInt(text('type_id')), text('category'))
                flash = { error: false, text: t('buyback.settings.item_added') }
                break
            case 'save_item':
                await patch_buyback_item(auth_token, parseInt(text('type_id')), {
                    active: form.get('active') === 'on',
                    category: text('category'),
                })
                break
            case 'delete_item':
                await delete_buyback_item(auth_token, parseInt(text('type_id')))
                break
        }
    } catch (error) {
        flash = { error: true, text: (error as Error).message }
    }
}

let settings: BuybackManageSettings | null = null
let fetching_error: Error | false = false
try {
    settings = await get_buyback_manage_settings(auth_token)
} catch (error) {
    fetching_error = error as Error
}
if (!fetching_error && !settings) return HTTP_403_Forbidden()

const percent = (share: number) => String(Math.round(share * 1000) / 10)
const form_attrs = { 'hx-post': PARTIAL_URL, 'hx-target': `#${ROOT_ID}`, 'hx-swap': 'outerHTML' }
---

{fetching_error !== false || !settings ?
    <ErrorRefetch args={{ partial: PARTIAL_URL, target: `#${ROOT_ID}`, error: fetching_error || new Error(), delay: parseInt(Astro.url.searchParams.get('delay') ?? '0') }} />
:
<div id={ROOT_ID} class="[ settings-editor ]">
    {flash &&
        <p class:list={['[ settings-editor__flash ]', { 'is-error': flash.error }]} role={flash.error ? 'alert' : 'status'}>
            {flash.text}
        </p>
    }

    <section class="[ settings-editor__panel ]" aria-labelledby="buyback-settings-rates">
        <h3 id="buyback-settings-rates">{t('buyback.settings.rates')}</h3>
        <form {...form_attrs} class="[ settings-editor__inline ]">
            <input type="hidden" name="action" value="save_settings" />
            <label class="[ settings-editor__field ]">{t('buyback.settings.demand_jita_buy')}
                <Input type="number" name="demand_jita_buy" size="sm" min="0" max="100" step="0.1" value={percent(settings.demand_jita_buy)} required />
            </label>
            <label class="[ settings-editor__field ]">{t('buyback.settings.surplus_jita_buy')}
                <Input type="number" name="surplus_jita_buy" size="sm" min="0" max="100" step="0.1" value={percent(settings.surplus_jita_buy)} required />
            </label>
            <label class="[ settings-editor__field ]">{t('buyback.settings.ore_refine')}
                <Input type="number" name="ore_refine" size="sm" min="0" max="100" step="0.1" value={percent(settings.ore_refine)} required />
            </label>
            <label class="[ settings-editor__field ]">{t('buyback.settings.location')}
                <select name="location_id">
                    <option value="">—</option>
                    {settings.locations.map((location) =>
                        <option value={location.location_id} selected={location.location_id === settings.location_id}>{location.name}</option>
                    )}
                </select>
            </label>
            <label class="[ settings-editor__check ]"><input type="checkbox" name="active" checked={settings.active} />{t('buyback.settings.active')}</label>
            <Button type="submit" size="sm" color="fleet-red" narrow={true}>{t('buyback.settings.save')}</Button>
        </form>
    </section>

    <section class="[ settings-editor__panel ]" aria-labelledby="buyback-settings-items">
        <h3 id="buyback-settings-items">{t('buyback.settings.items')}</h3>
        {settings.items.length === 0 && <EmptyState title={t('buyback.settings.no_items')} />}
        {settings.items.map((item) =>
            <div class:list={['[ settings-editor__row ]', { 'is-off': !item.active }]}>
                <form {...form_attrs} class="[ settings-editor__inline ]">
                    <input type="hidden" name="action" value="save_item" />
                    <input type="hidden" name="type_id" value={item.type_id} />
                    <span class="[ settings-editor__grow ]">{item.name}</span>
                    <select name="category" aria-label={t('buyback.settings.category')}>
                        {settings.categories.map((category) => <option value={category} selected={category === item.category}>{category.toUpperCase()}</option>)}
                    </select>
                    <label class="[ settings-editor__check ]"><input type="checkbox" name="active" checked={item.active} />{t('buyback.settings.active')}</label>
                    <Button type="submit" size="sm" color="transparent" narrow={true}>{t('buyback.settings.save')}</Button>
                </form>
                <form {...form_attrs} hx-confirm={t('buyback.settings.confirm_delete')}>
                    <input type="hidden" name="action" value="delete_item" />
                    <input type="hidden" name="type_id" value={item.type_id} />
                    <Button type="submit" size="sm" color="transparent" narrow={true}>{t('buyback.settings.delete')}</Button>
                </form>
            </div>
        )}

        <h4>{t('buyback.settings.add_item')}</h4>
        <form {...form_attrs} class="[ settings-editor__inline ]">
            <input type="hidden" name="action" value="search" />
            <label class="[ settings-editor__field ]">{t('buyback.settings.search')}
                <Input type="search" name="q" size="sm" value={search_query} minlength="2" required />
            </label>
            <label class="[ settings-editor__field ]">{t('buyback.settings.category')}
                <select name="category">
                    {settings.categories.map((category) => <option value={category} selected={category === new_category}>{category.toUpperCase()}</option>)}
                </select>
            </label>
            <Button type="submit" size="sm" color="transparent" narrow={true}>{t('buyback.settings.search_button')}</Button>
        </form>
        {search_query && search_results.length === 0 && <EmptyState title={t('buyback.settings.no_results')} />}
        {search_results.map((result) =>
            <form {...form_attrs} class="[ settings-editor__row ]">
                <input type="hidden" name="action" value="add_item" />
                <input type="hidden" name="type_id" value={result.type_id} />
                <input type="hidden" name="category" value={new_category} />
                <span class="[ settings-editor__grow ]">{result.name}</span>
                <Button type="submit" size="sm" color="green" narrow={true}>{t('buyback.settings.accept').replace('{category}', new_category.toUpperCase())}</Button>
            </form>
        )}
    </section>
</div>
}
