---
/**
 * The project lead posts an update (action=update) or finishes the
 * project (action=finish). Both reload the page so every tab agrees.
 */
// no-error-refetch: a form submit; its result line says what went wrong.
import { get_request_user } from '@helpers/request_user'
import { HTTP_403_Forbidden, HTTP_404_Not_Found } from '@helpers/http_responses'
import { finish_task_project, post_task_project_update } from '@helpers/api.minmatar.org/tasks'

const { auth_token } = get_request_user(Astro)
if (!auth_token || Astro.request.method !== 'POST') return HTTP_403_Forbidden()

const project_id = parseInt(Astro.url.searchParams.get('project_id') ?? '0')
if (!project_id) return HTTP_404_Not_Found()

const HEALTH = ['on_track', 'at_risk', 'off_track']

let error: string | null = null
try {
    if (Astro.url.searchParams.get('action') === 'finish') {
        await finish_task_project(auth_token, project_id)
    } else {
        const form = await Astro.request.formData()
        const health = String(form.get('health') ?? '')
        await post_task_project_update(
            auth_token,
            project_id,
            HEALTH.includes(health) ? health : 'on_track',
            String(form.get('body') ?? ''),
        )
    }
    Astro.response.headers.set('HX-Refresh', 'true')
} catch (failure) {
    error = (failure as Error).message
}
---

{error && <p class="[ manage-field__error ]" role="alert">{error}</p>}
