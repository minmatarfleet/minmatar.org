---
/**
 * The Manage Neocom button's count: everything waiting on the user across
 * the manage queues. Nothing when zero or when the summary fails (a badge
 * is not worth an error).
 */
// no-error-refetch: a decorative count; on failure the Neocom shows no badge.
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import { get_request_user } from '@helpers/request_user'
import { get_manage_summary } from '@helpers/api.minmatar.org/manage'

const { auth_token } = get_request_user(Astro)

let total = 0
if (auth_token) {
    try {
        total = (await get_manage_summary(auth_token))?.total ?? 0
    } catch (error) {
        console.log(error)
    }
}
---

{total > 0 &&
    <span class="[ neocom-badge ]" aria-label={`${t('manage.waiting')}: ${total}`}>{total > 99 ? '99+' : total}</span>
}
