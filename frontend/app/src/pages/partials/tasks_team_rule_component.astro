---
/**
 * The pilots behind one needs-you count on a team's Members table (an
 * opened ExpandRow). Suggestions are never listed by name.
 */
import { i18n } from '@helpers/i18n'
const { t, lang, translatePath } = i18n(Astro.url)

import type { TaskTeamRulePilot } from '@dtypes/api.minmatar.org'
import { get_request_user } from '@helpers/request_user'
import { HTTP_403_Forbidden, HTTP_404_Not_Found } from '@helpers/http_responses'
import { get_task_team_rule, remind_task_pilot } from '@helpers/api.minmatar.org/tasks'
import { get_player_icon } from '@helpers/eve_image'
import { task_date, waiting_label } from '@helpers/tasks'

const { auth_token } = get_request_user(Astro)
if (!auth_token) return HTTP_403_Forbidden()

const kind = Astro.url.searchParams.get('kind') ?? ''
const team_id = parseInt(Astro.url.searchParams.get('id') ?? '0')
const rule = Astro.url.searchParams.get('rule') ?? ''
if (!kind || !team_id || !rule) return HTTP_404_Not_Found()

let pilots: TaskTeamRulePilot[] = []
let error: Error | null = null
let remind_error: string | null = null
const task_id = parseInt(Astro.url.searchParams.get('task_id') ?? '0')
if (Astro.request.method === 'POST' && task_id) {
    try {
        pilots = await remind_task_pilot(auth_token, kind, team_id, rule, task_id)
    } catch (failure) {
        remind_error = (failure as Error).message
    }
}
if (pilots.length === 0) {
    try {
        pilots = await get_task_team_rule(auth_token, kind, team_id, rule)
    } catch (failure) {
        error = failure as Error
    }
}
const SELF_URL = translatePath(`/partials/tasks_team_rule_component/?kind=${encodeURIComponent(kind)}&id=${team_id}&rule=${encodeURIComponent(rule)}`)

const now = new Date()

import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import StylessButton from '@components/blocks/StylessButton.astro'
---

{error
    ? (
        <ErrorRefetch args={{
            partial: translatePath(`/partials/tasks_team_rule_component/?${Astro.url.searchParams.toString()}`),
            error,
            delay: 0,
        }} />
    )
    : (
        <div class="[ task-stack ]">
            {remind_error && <p class="[ manage-field__error ]" role="alert">{remind_error}</p>}
            <ul class="[ task-pilots is-remind ]" role="list">
                {pilots.map((row) => (
                    <li>
                        <span class="[ manage-who ]">
                            {row.pilot?.character_id && <img src={get_player_icon(row.pilot.character_id, 64)} alt="" width="40" height="40" loading="lazy" />}
                            <span class="[ manage-who__name ]">{row.pilot?.name ?? ''}</span>
                        </span>
                        <span class="[ manage-muted ]">{row.detail}</span>
                        <span>{waiting_label(t, row.opened_at, now)}</span>
                        <span>
                            {row.can_remind
                                ? (
                                    <StylessButton
                                        type="button"
                                        class="[ task-quiet ]"
                                        hx-post={`${SELF_URL}&task_id=${row.task_id}`}
                                        hx-target="closest .manage-detail__body"
                                        hx-swap="innerHTML"
                                        hx-disabled-elt="this"
                                    >
                                        {t('tasks.team.remind_once')}
                                    </StylessButton>
                                )
                                : row.reminders_off
                                    ? <span class="[ manage-muted ]">{t('tasks.team.reminders_off')}</span>
                                : row.reminded_at
                                    ? <span class="[ manage-muted ]">{t('tasks.team.reminded_on').replace('~DATE', task_date(row.reminded_at, lang))}</span>
                                    : <span class="[ manage-muted ]">{t('tasks.team.in_weekly_list')}</span>
                            }
                        </span>
                    </li>
                ))}
            </ul>
        </div>
    )
}
