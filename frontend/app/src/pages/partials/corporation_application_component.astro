---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_404_Not_Found, HTTP_403_Forbidden } from '@helpers/http_responses'

import type { User } from '@dtypes/jwt'
import * as jose from 'jose'

const auth_token = Astro.cookies.has('auth_token') ? (Astro.cookies.get('auth_token')?.value as string) : false
const user = auth_token ? jose.decodeJwt(auth_token) as User : false
const is_superuser = (user ? user?.is_superuser : false)

import { get_user_permissions } from '@helpers/permissions'
const user_permissions = (user ? await get_user_permissions(user?.username) : [])

const can_view_page = is_superuser || user_permissions.includes('applications.change_evecorporationapplication')

import type { CharacterBasic, CorporationBasic } from '@dtypes/layout_components'
const corporation = JSON.parse(Astro.url.searchParams.get('corporation') as string) as CorporationBasic

const corporation_id = corporation?.id ?? 0
const application_id = parseInt(Astro.url.searchParams.get('application_id') as string)

const valid_request = (corporation_id > 0 && application_id > 0)

if (!can_view_page)
    return HTTP_403_Forbidden()

if (!valid_request)
    return HTTP_404_Not_Found()

import type { ApplicationDetail, Alert } from '@dtypes/layout_components'
import { get_application_by_id } from '@helpers/fetching/applications'
import {
    accept_corporation_applications,
    reject_corporation_applications,
    transfer_corporation_application,
} from '@helpers/api.minmatar.org/applications'
import { query_string } from '@helpers/string'

let application_action_error
let action
let alert:Alert | false = false
let redirect_url:string | false = false
let display_corporation:CorporationBasic = corporation
let fetch_corporation_id = corporation_id

if (Astro.request.method === "POST") {
    action = Astro.url.searchParams.get('action')

    try {
        if (action == 'accept') {
            await accept_corporation_applications(auth_token as string, corporation_id, application_id)
        } else if (action == 'deny') {
            await reject_corporation_applications(auth_token as string, corporation_id, application_id)
        } else if (action == 'transfer') {
            const target_corporation = JSON.parse(
                Astro.url.searchParams.get('target_corporation') as string
            ) as CorporationBasic
            const target_corporation_id = target_corporation?.id ?? 0

            if (target_corporation_id <= 0) {
                throw new Error(t('transfer_application_error'))
            }

            await transfer_corporation_application(
                auth_token as string,
                corporation_id,
                application_id,
                target_corporation_id,
            )

            display_corporation = target_corporation
            fetch_corporation_id = target_corporation_id
            redirect_url = translatePath(
                `/alliance/corporations/application/${target_corporation_id}/${application_id}`
            )
        }
    } catch (error) {
        application_action_error = error.message
    }
}

let application:ApplicationDetail | null = null
let get_corporation_application_error: Error | false = false

try {
    application = await get_application_by_id(
        auth_token as string,
        fetch_corporation_id,
        application_id,
    )
} catch (error) {
    get_corporation_application_error = error
}

if (application_action_error) {
    const dialog_title = action === 'accept'
        ? t('accept_application_dialog_title')
        : action === 'transfer'
            ? t('transfer_application_dialog_title')
            : t('deny_application_dialog_title')

    alert = {
        title: dialog_title,
        content: application_action_error,
    }

    const character:CharacterBasic = {
        character_id: application?.character_id ?? 0,
        character_name: application?.character_name ?? t('unknown_character'),
    }

    const dialog_corporation = action === 'transfer'
        ? (
            JSON.parse(Astro.url.searchParams.get('target_corporation') as string) as CorporationBasic
            ?? corporation
        )
        : corporation

    const params = {
        character: JSON.stringify(character),
        corporation: JSON.stringify(dialog_corporation),
        application_id: application?.id?.toString() ?? application_id.toString(),
        type: action,
        message: application_action_error,
    }

    alert.partial = `${translatePath('/partials/dialog_with_application/')}?${query_string(params)}`
}

const CORPORATION_APPLICATION_PARTIAL_URL = `${translatePath('/partials/corporation_application_component')}?${query_string({
    corporation: JSON.stringify(display_corporation),
    application_id: application_id,
})}`

const delay = parseInt(Astro.url.searchParams.get('delay') ?? '0')

import CorporationApplication from '@components/blocks/CorporationApplication.astro';
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro';
---

{get_corporation_application_error ?
    <ErrorRefetch
        args={{
            partial: translatePath(CORPORATION_APPLICATION_PARTIAL_URL),
            error: get_corporation_application_error,
            delay: delay,
        }}
    />
    :
    <CorporationApplication
        application={application as ApplicationDetail}
        corporation_id={display_corporation.id}
        corporation_name={display_corporation.name}
        alert={alert}
        redirect_url={redirect_url}
    />
}
