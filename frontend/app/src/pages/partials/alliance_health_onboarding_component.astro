---
import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden } from '@helpers/http_responses'

import { get_request_user } from '@helpers/request_user'

const { auth_token, user } = get_request_user(Astro)

if (!user) return HTTP_403_Forbidden()

import type { AllianceHealthOnboardingBucket } from '@dtypes/api.minmatar.org'
import { get_alliance_health_onboarding } from '@helpers/api.minmatar.org/alliance_health'
import AllianceHealthOnboardingTable from '@components/blocks/AllianceHealthOnboardingTable.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'

const raw_bucket = Astro.url.searchParams.get('bucket') ?? 'first_week'
const bucket: AllianceHealthOnboardingBucket =
    raw_bucket === 'more_fleets' ? 'more_fleets' : 'first_week'
const initial_corp = Astro.url.searchParams.get('corp') || 'all'

let pilots: Awaited<
    ReturnType<typeof get_alliance_health_onboarding>
>['pilots'] = []
let corp_options: string[] = []
let data_fetching_error: any

try {
    const onboarding = await get_alliance_health_onboarding(
        auth_token as string,
        bucket,
    )
    pilots = onboarding.pilots
    corp_options = Object.keys(onboarding.counts_by_corp ?? {}).filter(
        (name) => name && name !== 'all' && name !== '—',
    )
} catch (error) {
    data_fetching_error = error
}

const PARTIAL_URL = translatePath('/partials/alliance_health_onboarding_component')
---

{
    data_fetching_error ? (
        <ErrorRefetch
            args={{
                partial: `${PARTIAL_URL}?bucket=${bucket}`,
                error: data_fetching_error,
                delay: 0,
            }}
        />
    ) : (
        <AllianceHealthOnboardingTable
            pilots={pilots}
            initial_corp={initial_corp}
            corp_options={corp_options}
            bucket={bucket}
        />
    )
}
