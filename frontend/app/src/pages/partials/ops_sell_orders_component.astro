---
/* Legacy htmx partial path — redirect to sell-order gaps partial */

import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

const qs = Astro.url.searchParams.toString()
const target = translatePath(
    `/partials/sell_order_gaps_component${qs ? `?${qs}` : ''}`,
)

return Astro.redirect(target, 301)
---
