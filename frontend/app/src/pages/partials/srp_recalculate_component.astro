---
/**
 * An open "Filed at an old amount" row on SRP amounts: the hull's open
 * requests filed at an amount it no longer pays (pilot, filed, filed at,
 * new amount), with "Pay N at <amount>" and "Keep filed amounts". Both post
 * to srp_programs_component, which answers with the grid again.
 *
 * GET ?ship_type_id=
 */
import { i18n } from '@helpers/i18n'
const { lang, t, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'

const { auth_token, user } = get_request_user(Astro)

if (!user || !auth_token)
    return HTTP_403_Forbidden()

import { get_gates, can } from '@helpers/gates'
const gates = await get_gates(Astro)

if (!can(gates, 'srp.programs.manage'))
    return HTTP_403_Forbidden()

import type { SRPRecalculationPreview } from '@dtypes/api.minmatar.org'
import { get_srp_hull_recalculation_preview } from '@helpers/api.minmatar.org/srp'
import { format_isk_shorthand } from '@helpers/isk_shorthand'
import { number_thousand_separator } from '@helpers/numbers'
import { get_player_icon } from '@helpers/eve_image_server'
import { query_string } from '@helpers/string'

// character_id and created_at are new on the API; the generated types catch
// up when the schema is regenerated.
type Change = SRPRecalculationPreview['changes'][number] & { character_id?: number, created_at?: string | null }

const ship_type_id = parseInt(Astro.url.searchParams.get('ship_type_id') ?? '0') || 0
const delay = parseInt(Astro.url.searchParams.get('delay') ?? '0')
const SELF_URL = translatePath(`/partials/srp_recalculate_component/?${query_string({ ship_type_id: String(ship_type_id) })}`)
const PROGRAMS_PARTIAL_URL = translatePath('/partials/srp_programs_component/')
const BODY_ID = `srp-recalc-${ship_type_id}`

let preview: SRPRecalculationPreview | null = null
let fetch_error: Error | false = false
try {
    preview = await get_srp_hull_recalculation_preview(auth_token, ship_type_id)
} catch (error) {
    fetch_error = error as Error
}

const changes = (preview?.changes ?? []) as Change[]
const new_amount = changes[0]?.new_amount ?? 0
const difference = (preview?.new_total ?? 0) - (preview?.current_total ?? 0)
const format_full = (value: number) => number_thousand_separator(value, lang)
// Amounts show whole ISK, or the shorthand at phone width (srp-recalc__short).
const filed_on = (iso: string | null | undefined) => iso
    ? new Date(iso).toLocaleDateString(lang, { day: 'numeric', month: 'short', timeZone: 'UTC' })
    : '—'
const action = (part: 'pay' | 'keep') => ({
    'hx-post': `${PROGRAMS_PARTIAL_URL}?${query_string({ part, ship_type_id: String(ship_type_id) })}`,
    'hx-target': '#srp-programs',
    'hx-select': '#srp-programs',
    'hx-swap': 'outerHTML',
    // The row sits inside the amounts form: send none of its fields.
    'hx-params': 'none',
})

import Button from '@components/blocks/Button.astro'
import EmptyState from '@components/blocks/EmptyState.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
---

<div id={BODY_ID} class="[ srp-recalc ]">
    {fetch_error ?
        <ErrorRefetch args={{ partial: SELF_URL, target: `#${BODY_ID}`, error: fetch_error, delay }} />
        : changes.length === 0 ?
        <EmptyState title={t('admin_srp.nothing_filed_old')} />
        :
        <>
            <table class="[ manage-table srp-recalc__table ]" style="--manage_table_min_width: 0">
                <caption class="[ visually-hidden ]">{t('admin_srp.filed_old')}</caption>
                <thead>
                    <tr>
                        <th scope="col">{t('admin_srp.pilot')}</th>
                        <th scope="col" class="[ is-wide ]">{t('admin_srp.filed')}</th>
                        <th scope="col" class="num">{t('admin_srp.filed_at')}</th>
                        <th scope="col" class="num">{t('admin_srp.at_amount').replace('~AMOUNT', format_isk_shorthand(new_amount, lang))}</th>
                    </tr>
                </thead>
                <tbody>
                    {changes.map((change) => (
                        <tr>
                            <td>
                                <span class="[ manage-who ]">
                                    {change.character_id ? <img src={get_player_icon(change.character_id)} alt="" width="40" height="40" loading="lazy" /> : null}
                                    <span class="[ manage-who__text ]">
                                        <span class="[ manage-who__name ]">{change.character_name}</span>
                                    </span>
                                </span>
                            </td>
                            <td class="[ is-wide ]">{filed_on(change.created_at)}</td>
                            <td class="[ num manage-muted ]"><span class="[ srp-recalc__full ]">{format_full(change.current_amount)}</span><span class="[ srp-recalc__short ]">{format_isk_shorthand(change.current_amount, lang)}</span></td>
                            <td class="num"><span class="[ srp-recalc__full ]">{format_full(change.new_amount)}</span><span class="[ srp-recalc__short ]">{format_isk_shorthand(change.new_amount, lang)}</span></td>
                        </tr>
                    ))}
                </tbody>
            </table>
            <div class="[ manage-actions ]">
                <Button type="button" size="sm" {...action('pay')}>
                    {t('admin_srp.pay_count').replace('~COUNT', String(preview?.changed_count ?? changes.length)).replace('~AMOUNT', format_isk_shorthand(new_amount, lang))}
                </Button>
                <Button type="button" size="sm" color="transparent" {...action('keep')}>{t('admin_srp.keep')}</Button>
                <span class="[ manage-actions__end manage-muted ]">
                    {(difference >= 0 ? t('admin_srp.adds') : t('admin_srp.saves'))
                        .replace('~AMOUNT', format_isk_shorthand(Math.abs(difference), lang))}
                </span>
            </div>
        </>
    }
</div>

<style lang="scss">
    .srp-recalc {
        display: flex;
        flex-direction: column;
        gap: var(--space-s);
    }

    .srp-recalc__table {
        width: 100%;
    }

    .srp-recalc__short {
        display: none;
    }

    @media (max-width: 48rem) {
        .srp-recalc__full {
            display: none;
        }

        .srp-recalc__short {
            display: inline;
        }
    }
</style>
