---
import { i18n, t_key } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { get_request_user } from '@helpers/request_user'

const { auth_token, user } = get_request_user(Astro)

if (!user) return new Response(null, { status: 403 })

const fleet_id = parseInt(Astro.url.searchParams.get('fleet_id') ?? '0')
const can_manage = Astro.url.searchParams.get('can_manage') === 'true'

if (isNaN(fleet_id))
    return new Response(null, { status: 400 })

import {
    get_fleet_composition,
    get_fleet_my_pilots,
    get_fleet_targets,
    get_my_target_hangar,
    type MyTargetHangar,
    type ShipTargetProgress,
    type FleetCompositionEntry,
    type MyFleetPilot,
} from '@helpers/api.minmatar.org/fleets'
import { is_capital_entry } from '@helpers/fleet_ships'
import { BURST_KINDS, counts_from_bursts, default_burst_counts } from '@helpers/fleet_roles'
import type { BurstKind } from '@helpers/api.minmatar.org/fleets'
import { query_string } from '@helpers/string'
import { get_ship_hulls } from '@helpers/sde/ships'
import { get_item_icon } from '@helpers/eve_image_server'
import type { ShipHull } from '@dtypes/layout_components'

let composition: FleetCompositionEntry[] = []
let pilots: MyFleetPilot[] = []
let hulls: ShipHull[] = []
let targets: ShipTargetProgress[] = []
let hangar: MyTargetHangar = { lines_by_ship: [], hangars: [] }
let fetch_error: Error | false = false

try {
    ;[composition, pilots, hulls, targets, hangar] = await Promise.all([
        get_fleet_composition(auth_token as string, fleet_id),
        get_fleet_my_pilots(auth_token as string, fleet_id),
        get_ship_hulls(),
        // Ship targets the fleet is still short of; never blocks the picker.
        get_fleet_targets(auth_token as string, fleet_id).catch(() => []),
        // Which line each doctrine hull fills and what each character owns.
        get_my_target_hangar(auth_token as string, fleet_id).catch(() => ({ lines_by_ship: [], hangars: [] })),
    ])
} catch (error) {
    fetch_error = error
}

// Academy fits are only for Minmatar Fleet Academy pilots; the backend refuses
// them for everyone else.
if (!pilots.some(pilot => pilot.can_fly_academy))
    composition = composition.filter(entry => entry.role !== 'secondary')

// A pilot bringing a hull the FC didn't list: shown under "Off doctrine".
const hull_names = new Map(hulls.map(hull => [hull.type_id, hull.name]))
const HULLS_LIST_ID = `pick-ships-hulls-${fleet_id}`

const recent = pilots.filter(pilot => pilot.recent_fleets)
const others = pilots.filter(pilot => !pilot.recent_fleets)
// New accounts have no fleet history yet: show everyone rather than nothing.
const show_all_by_default = recent.length === 0

const groups = [
    { title: t('primary_ships'), entries: composition.filter(e => e.role === 'primary' && !is_capital_entry(e)) },
    { title: t('secondary_ships'), entries: composition.filter(e => e.role === 'secondary' && !is_capital_entry(e)) },
    { title: t('support_ships'), entries: composition.filter(e => e.role === 'support' && !is_capital_entry(e)) },
    { title: t('utility_ships'), entries: composition.filter(e => e.role === 'utility' && !is_capital_entry(e)) },
    { title: t('capital_ships'), entries: composition.filter(is_capital_entry) },
].filter(group => group.entries.length > 0)

// Before the first save the backend suggests the hull each character flew
// most in past fleets; it is only pre-selected, Save still has to be pressed.
const selected_key = (pilot:MyFleetPilot) => {
    if (pilot.selection?.ship_type_id) return `s:${pilot.selection.ship_type_id}`
    const pick = pilot.selection ?? pilot.suggestion
    if (!pick) return ''
    return pick.fitting_id ? `f:${pick.fitting_id}` : `m:${pick.fleet_fitting_id}`
}

const off_doctrine_hull = (pilot:MyFleetPilot) => {
    const type_id = pilot.selection?.ship_type_id
    return type_id ? { key: `s:${type_id}`, name: hull_names.get(type_id) ?? t('pick_ships_other_ship') } : null
}

const has_suggestions = pilots.some(pilot => pilot.suggestion)

// Ship targets: each option says which line it fills and whether that line
// is still short; hulls a character owns are listed first, and a character
// not bringing anything is offered an owned hull for a short line.
const target_by_id = new Map(targets.map(target => [target.id, target]))
const line_by_ship = new Map(hangar.lines_by_ship.map(row => [row.ship_type_id, target_by_id.get(row.target_id)]))
const owned_by_character = new Map(hangar.hangars.map(row => [row.character_id, new Set(row.ship_type_ids)]))

// Which ship target line each picker value fills, so "Still needed" can
// count the picks live. Off-doctrine hulls count toward a line too.
const line_for_ship = (ship_type_id:number) =>
    line_by_ship.get(ship_type_id) ?? targets.find(target => target.ship_type_ids.includes(ship_type_id))
const line_of_key:Record<string, number> = {}
for (const entry of composition) {
    const line = line_for_ship(entry.ship_id)
    if (line) line_of_key[entry.key] = line.id
}

const saved_key = (pilot:MyFleetPilot) => {
    const pick = pilot.selection
    if (!pick) return ''
    if (pick.ship_type_id) return `s:${pick.ship_type_id}`
    return pick.fitting_id ? `f:${pick.fitting_id}` : pick.fleet_fitting_id ? `m:${pick.fleet_fitting_id}` : ''
}
for (const pilot of pilots) {
    const type_id = pilot.selection?.ship_type_id
    const line = type_id ? line_for_ship(type_id) : undefined
    if (type_id && line) line_of_key[`s:${type_id}`] = line.id
}

// `have` already counts this user's saved ships; take them out so the bar
// can show the picks in this form as "Your picks" instead.
const saved_mine = (line_id:number) => pilots.filter(pilot => line_of_key[saved_key(pilot)] === line_id).length
const lines = [...targets]
    .sort((a, b) => b.short - a.short || a.name.localeCompare(b.name))
    .map(target => ({
        id: target.id,
        name: target.name,
        target: target.target,
        base: Math.max(target.have - saved_mine(target.id), 0),
        met_at_load: target.short === 0,
    }))
const line_index = new Map(lines.map((line, index) => [line.id, index]))
const lines_open = lines.filter(line => !line.met_at_load)
const lines_met = lines.filter(line => line.met_at_load)

// What the picker button shows for each value: hull icon, hull name and the
// line it fills. A hull listed twice also shows the fit's name.
const hull_count = new Map<number, number>()
composition.forEach(entry => hull_count.set(entry.ship_id, (hull_count.get(entry.ship_id) ?? 0) + 1))
const fit_name = (entry:FleetCompositionEntry) => (hull_count.get(entry.ship_id) ?? 0) > 1 ? entry.name : ''
const ship_name = (entry:FleetCompositionEntry) => entry.ship_name || entry.name
const line_name = (key:string) => lines.find(line => line.id === line_of_key[key])?.name ?? ''

const ships:Record<string, { name:string, fit:string, line:string, icon:string }> = {
    other: { name: t('pick_ships_other_ship'), fit: '', line: '', icon: '' },
}
for (const entry of composition)
    ships[entry.key] = { name: ship_name(entry), fit: fit_name(entry), line: line_name(entry.key), icon: get_item_icon(entry.ship_id, 64) }
for (const pilot of pilots) {
    const hull = off_doctrine_hull(pilot)
    if (hull) ships[hull.key] = { name: hull.name, fit: '', line: line_name(hull.key), icon: get_item_icon(pilot.selection!.ship_type_id!, 64) }
}

// The ship menu: one group per target line, most needed first, then the
// doctrine's other ships by role. Hulls a character owns say "In hangar".
interface MenuGroup {
    title:      string;
    line_index?: number;
    entries:    FleetCompositionEntry[];
}
const menu_groups:MenuGroup[] = [
    ...lines.map(line => ({
        title: line.name,
        line_index: line_index.get(line.id),
        entries: composition.filter(entry => line_of_key[entry.key] === line.id),
    })),
    ...groups.map(group => ({
        title: group.title,
        entries: group.entries.filter(entry => line_of_key[entry.key] === undefined),
    })),
].filter(group => group.entries.length > 0)

const owns = (pilot:MyFleetPilot, entry:FleetCompositionEntry) =>
    owned_by_character.get(pilot.character_id)?.has(entry.ship_id) ?? false
const owned_entries = (pilot:MyFleetPilot) => composition.filter(entry => owns(pilot, entry))
const hangar_hint = (pilot:MyFleetPilot) => {
    const entry = owned_entries(pilot).find(entry => (line_by_ship.get(entry.ship_id)?.short ?? 0) > 0)
    if (!entry) return null
    return { entry, line: line_by_ship.get(entry.ship_id)! }
}
const search_terms = (entry:FleetCompositionEntry) => `${ship_name(entry)} ${entry.name}`.toLowerCase()

const suggested_label = (pilot:MyFleetPilot) => {
    const { ship_name, fleets } = pilot.suggestion!
    return (fleets === 1 ? t('pick_ships_suggested_one') : t('pick_ships_suggested'))
        .replace('{ship}', ship_name)
        .replace('{count}', fleets.toString())
}

// Links fits: one dropdown per burst the hull runs at once. The form starts
// from the pilot's saved pick, else the doctrine's online bursts, and posts
// per-kind counts as before.
const links_entries = composition.filter(entry => entry.fit_roles?.links)

const burst_label = (kind:BurstKind) => t(t_key('burst_kind_', kind))

const fitted_kinds = (entry:FleetCompositionEntry):BurstKind[] =>
    BURST_KINDS.filter(kind => (entry.fit_roles.bursts_fitted[kind] ?? 0) > 0)

const slot_count = (entry:FleetCompositionEntry) => Math.min(
    entry.fit_roles.burst_slots,
    fitted_kinds(entry).reduce((sum, kind) => sum + (entry.fit_roles.bursts_fitted[kind] ?? 0), 0),
)

const initial_counts = (pilot:MyFleetPilot, entry:FleetCompositionEntry) => {
    const saved = selected_key(pilot) === entry.key && (pilot.selection?.bursts?.length ?? 0) > 0
    const counts = saved ?
        counts_from_bursts(pilot.selection!.bursts!) :
        default_burst_counts(entry.fit_roles)
    return Object.fromEntries(fitted_kinds(entry).map(kind => [kind, counts[kind] ?? 0]))
}

const initial_slots = (pilot:MyFleetPilot, entry:FleetCompositionEntry) => {
    const counts = initial_counts(pilot, entry)
    const picked = fitted_kinds(entry).flatMap(kind => Array(counts[kind] ?? 0).fill(kind))
    return Array.from({ length: slot_count(entry) }, (_, index) => picked[index] ?? '')
}

const picks = Object.fromEntries(pilots.map(pilot => [pilot.character_id, selected_key(pilot)]))
const initial_flying = Object.values(picks).filter(key => key).length

const NEEDED = t('fleets.targets.needed')
const MET = t('pick_ships_met')
const FLYING = t('pick_ships_flying')
const FLYING_ONE = t('pick_ships_flying_one')
const NOT_FLYING = t('pick_ships_not_flying')

const form_state = `{
    show_all: ${show_all_by_default},
    picks: ${JSON.stringify(picks)},
    lines: ${JSON.stringify(lines)},
    line_of: ${JSON.stringify(line_of_key)},
    ships: ${JSON.stringify(ships)},
    mine(line) { return Object.values(this.picks).filter(key => this.line_of[key] === line.id).length },
    needed(line) { return Math.max(line.target - line.base - this.mine(line), 0) },
    needed_text(line) { const n = this.needed(line); return n > 0 ? ${JSON.stringify(NEEDED)}.replace('{count}', n) : ${JSON.stringify(MET)} },
    base_width(line) { return Math.min(100, 100 * line.base / Math.max(line.target, 1)) },
    mine_width(line) { return Math.min(100 - this.base_width(line), 100 * this.mine(line) / Math.max(line.target, 1)) },
    get met_names() { return this.lines.filter(line => line.met_at_load && this.needed(line) === 0).map(line => line.name).join(', ') },
    get flying() { return Object.values(this.picks).filter(key => key).length },
    get flying_text() { return this.flying === 1 ? ${JSON.stringify(FLYING_ONE)} : ${JSON.stringify(FLYING)}.replace('{count}', this.flying) },
}`

const pick_label = (pilot:MyFleetPilot) => {
    const key = selected_key(pilot)
    return key ? ships[key] : null
}

const SAVE_URL = `${translatePath('/partials/fleet_ship_volunteers_component/')}?${query_string({
    fleet_id: fleet_id,
    action: 'pick_ships',
    ...(can_manage && { can_manage: true }),
})}`

const CLOSE_MODAL = "if (event.detail.successful) document.querySelector('.modal-backdrop')?.click()"
// The save response sends fleet-ships-picked only when it stored at least one ship.
const SIGNED_UP = "window.capture_event && window.capture_event('fleet_signed_up', { fleet_id: event.detail.fleet_id, ships: event.detail.ships })"

import Flexblock from '@components/compositions/Flexblock.astro'
import Wrapper from '@components/compositions/Wrapper.astro'

import Button from '@components/blocks/Button.astro'
import Select from '@components/blocks/Select.astro'
import Input from '@components/blocks/Input.astro'
import PilotBadge from '@components/blocks/PilotBadge.astro'
import CaretIcon from '@components/icons/CaretIcon.astro'
---

{fetch_error ?
    <p>{(fetch_error as Error).message}</p>
    :
    <Wrapper padding_block='var(--space-m)' padding_inline='var(--space-m)' max_width='100%'>
    <form
        class="[ pick-ships ]"
        hx-post={SAVE_URL}
        hx-target="#fleet-ships"
        hx-swap="outerHTML transition:true"
        hx-indicator=".loader"
        hx-on--after-request={CLOSE_MODAL}
        hx-on:fleet-ships-picked={SIGNED_UP}
        x-data={form_state}
    >
        <Flexblock gap='var(--space-m)' class="[ pick-ships__body ]">
            <Flexblock gap='var(--space-3xs)' class="[ pick-ships__header ]">
                <h3 class="[ pick-ships__title ]">{t('pick_ships_title')}</h3>
                <small>{t(has_suggestions ? 'pick_ships_suggested_subtitle' : 'pick_ships_subtitle')}</small>
            </Flexblock>

            {lines.length > 0 &&
                <section class="[ pick-ships__needed ]" aria-labelledby={`pick-ships-needed-${fleet_id}`}>
                    <div class="[ pick-ships__needed-head ]">
                        <b id={`pick-ships-needed-${fleet_id}`}>{t('fleets.targets.still_needed')}</b>
                        <span class="[ pick-ships__legend ]"><span aria-hidden="true"></span>{t('pick_ships_your_picks')}</span>
                    </div>
                    <div class="[ pick-ships__lines ]">
                        {lines.map((line, index) =>
                            <div
                                class="[ pick-ships__line ]"
                                x-show={line.met_at_load ? `needed(lines[${index}]) > 0` : undefined}
                                x-cloak={line.met_at_load ? true : undefined}
                            >
                                <b title={line.name}>{line.name}</b>
                                <span class="[ pick-ships__track ]" role="img" x-bind:aria-label={`lines[${index}].name + ': ' + needed_text(lines[${index}])`}>
                                    <span class="[ pick-ships__base ]" x-bind:style={`{ width: base_width(lines[${index}]) + '%' }`}></span>
                                    <span class="[ pick-ships__mine ]" x-bind:style={`{ width: mine_width(lines[${index}]) + '%' }`}></span>
                                </span>
                                <span
                                    class="[ pick-ships__need ]"
                                    x-bind:class={`{ 'is-met': needed(lines[${index}]) === 0 }`}
                                    x-text={`needed_text(lines[${index}])`}
                                ></span>
                            </div>
                        )}
                    </div>
                    {lines_met.length > 0 &&
                        <p class="[ pick-ships__met ]" x-show="met_names">
                            <b>{MET}</b>
                            <span x-text="met_names">{lines_met.map(line => line.name).join(', ')}</span>
                        </p>
                    }
                </section>
            }

            {composition.length === 0 ?
                <p>{t('fleet_ships_empty')}</p>
                :
                <datalist id={HULLS_LIST_ID}>
                    {hulls.map(hull => <option value={hull.name} />)}
                </datalist>
                <div class="[ pick-ships__rows ]" role="list">
                    {pilots.map(pilot =>
                        <div
                            role="listitem"
                            class="[ pick-ships__row ]"
                            x-show={pilot.recent_fleets ? 'true' : 'show_all'}
                            x-cloak={!pilot.recent_fleets && !show_all_by_default ? true : undefined}
                            x-data={`{ cid: ${pilot.character_id}, open: false, search: '' }`}
                        >
                            <PilotBadge
                                character_id={pilot.character_id}
                                character_name={pilot.character_name}
                                size={40}
                                icon_quality={64}
                                inert={true}
                            >
                                <small class="[ pick-ships__quiet ]">
                                    {pilot.suggestion ? suggested_label(pilot) :
                                        pilot.recent_fleets ? t('pick_ships_recent') : t('pick_ships_no_recent')}
                                </small>
                            </PilotBadge>

                            <div
                                class="[ pick-ships__picker ]"
                                x-on:keydown.escape.stop="open = false"
                                x-on:click.outside="open = false"
                            >
                                <input type="hidden" name={`ship_${pilot.character_id}`} value={selected_key(pilot)} x-bind:value="picks[cid]" />
                                <button
                                    type="button"
                                    class="[ pick-ships__trigger ]"
                                    x-ref="trigger"
                                    aria-haspopup="listbox"
                                    x-bind:aria-expanded="open.toString()"
                                    aria-label={t('pick_ships_ship_for').replace('{name}', pilot.character_name)}
                                    x-on:click="open = !open; if (open) { search = ''; $nextTick(() => $refs.search.focus()) }"
                                >
                                    <img
                                        src={pick_label(pilot)?.icon || undefined}
                                        x-bind:src="ships[picks[cid]]?.icon || ''"
                                        x-show="ships[picks[cid]]?.icon"
                                        alt=""
                                        width="36"
                                        height="36"
                                        loading="lazy"
                                    />
                                    <span class="[ pick-ships__value ]">
                                        <span
                                            x-bind:class="{ 'pick-ships__quiet': !picks[cid] }"
                                            x-text={`picks[cid] ? ships[picks[cid]]?.name ?? '' : ${JSON.stringify(NOT_FLYING)}`}
                                        >{pick_label(pilot)?.name ?? NOT_FLYING}</span>
                                        <small x-show="ships[picks[cid]]?.line" x-text="ships[picks[cid]]?.line ?? ''">{pick_label(pilot)?.line}</small>
                                    </span>
                                    <CaretIcon aria-hidden="true" />
                                </button>

                                <div
                                    class="[ pick-ships__menu ]"
                                    x-show="open"
                                    x-cloak
                                    x-anchor.fixed.bottom-end.offset.4="$refs.trigger"
                                >
                                    <label class="[ pick-ships__search ]">
                                        <span class="[ visually-hidden ]">{t('pick_ships_search')}</span>
                                        <input
                                            type="search"
                                            x-ref="search"
                                            x-model="search"
                                            placeholder={t('pick_ships_search')}
                                            autocomplete="off"
                                            x-on:keydown.enter.prevent
                                        />
                                    </label>
                                    <div class="[ pick-ships__options ]" role="listbox" aria-label={t('pick_ships_ship_for').replace('{name}', pilot.character_name)}>
                                        <button
                                            type="button"
                                            role="option"
                                            class="[ pick-ships__option ]"
                                            x-show="!search"
                                            x-bind:aria-selected="(picks[cid] === '').toString()"
                                            x-on:click="picks[cid] = ''; open = false"
                                        >
                                            <span class="[ pick-ships__quiet ]">{NOT_FLYING}</span>
                                        </button>
                                        {menu_groups.map(group =>
                                            <div
                                                class="[ pick-ships__group ]"
                                                role="group"
                                                aria-label={group.title}
                                                x-show={`${JSON.stringify(group.entries.map(search_terms))}.some(term => term.includes(search.toLowerCase()))`}
                                            >
                                                <div class="[ pick-ships__group-head ]" aria-hidden="true">
                                                    <span>{group.title}</span>
                                                    {group.line_index !== undefined &&
                                                        <span
                                                            class="[ pick-ships__need ]"
                                                            x-bind:class={`{ 'is-met': needed(lines[${group.line_index}]) === 0 }`}
                                                            x-text={`needed_text(lines[${group.line_index}])`}
                                                        ></span>
                                                    }
                                                </div>
                                                {group.entries.map(entry =>
                                                    <button
                                                        type="button"
                                                        role="option"
                                                        class="[ pick-ships__option ]"
                                                        x-show={`${JSON.stringify(search_terms(entry))}.includes(search.toLowerCase())`}
                                                        x-bind:aria-selected={`(picks[cid] === ${JSON.stringify(entry.key)}).toString()`}
                                                        x-on:click={`picks[cid] = ${JSON.stringify(entry.key)}; open = false`}
                                                    >
                                                        <img src={get_item_icon(entry.ship_id, 64)} alt="" width="32" height="32" loading="lazy" />
                                                        <span class="[ pick-ships__value ]">
                                                            <span>{ship_name(entry)}</span>
                                                            {fit_name(entry) && <small>{fit_name(entry)}</small>}
                                                        </span>
                                                        {owns(pilot, entry) && <small class="[ pick-ships__hangar ]">{t('pick_ships_in_hangar')}</small>}
                                                    </button>
                                                )}
                                            </div>
                                        )}
                                        <div class="[ pick-ships__group ]" role="group" aria-label={t('pick_ships_off_doctrine')} x-show="!search">
                                            <div class="[ pick-ships__group-head ]" aria-hidden="true"><span>{t('pick_ships_off_doctrine')}</span></div>
                                            {off_doctrine_hull(pilot) &&
                                                <button
                                                    type="button"
                                                    role="option"
                                                    class="[ pick-ships__option ]"
                                                    x-bind:aria-selected={`(picks[cid] === ${JSON.stringify(off_doctrine_hull(pilot)!.key)}).toString()`}
                                                    x-on:click={`picks[cid] = ${JSON.stringify(off_doctrine_hull(pilot)!.key)}; open = false`}
                                                >
                                                    <img src={get_item_icon(pilot.selection!.ship_type_id!, 64)} alt="" width="32" height="32" loading="lazy" />
                                                    <span>{off_doctrine_hull(pilot)!.name}</span>
                                                </button>
                                            }
                                            <button
                                                type="button"
                                                role="option"
                                                class="[ pick-ships__option ]"
                                                x-bind:aria-selected="(picks[cid] === 'other').toString()"
                                                x-on:click="picks[cid] = 'other'; open = false"
                                            >
                                                <span>{t('pick_ships_other_ship')}</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            {hangar_hint(pilot) &&
                                <p class="[ pick-ships__hint ]" x-show="picks[cid] === ''" x-cloak={selected_key(pilot) !== '' ? true : undefined}>
                                    <img src={get_item_icon(hangar_hint(pilot)!.entry.ship_id, 32)} alt="" width="24" height="24" loading="lazy" />
                                    <span>
                                        {t('fleets.targets.has_hull').replace('{ship}', hangar_hint(pilot)!.entry.ship_name || hangar_hint(pilot)!.entry.name)}
                                        {' '}<b>{t('fleets.targets.line_needs_it').replace('{name}', hangar_hint(pilot)!.line.name)}</b>
                                    </span>
                                    <button type="button" x-on:click={`picks[cid] = ${JSON.stringify(hangar_hint(pilot)!.entry.key)}`}>{t('fleets.targets.bring_it')}</button>
                                </p>
                            }
                            <label class="[ pick-ships__other ]" x-show="picks[cid] === 'other'" x-cloak>
                                <span class="[ visually-hidden ]">{t('pick_ships_other_ship_label')}</span>
                                <Input
                                    size="sm"
                                    type="text"
                                    name={`other_ship_${pilot.character_id}`}
                                    list={HULLS_LIST_ID}
                                    autocomplete="off"
                                    placeholder={t('pick_ships_other_ship_placeholder')}
                                    x-bind:disabled="picks[cid] !== 'other'"
                                    x-bind:required="picks[cid] === 'other'"
                                    disabled
                                />
                                <small>{t('pick_ships_other_ship_hint')}</small>
                            </label>
                            {links_entries.map(entry =>
                                <div
                                    class="[ pick-ships__links ]"
                                    x-show={`picks[cid] === ${JSON.stringify(entry.key)}`}
                                    x-cloak={selected_key(pilot) !== entry.key ? true : undefined}
                                    x-data={`{ slots: ${JSON.stringify(initial_slots(pilot, entry))} }`}
                                >
                                    <span class="[ pick-ships__links-label ]" id={`links-${pilot.character_id}-${entry.key.replace(':', '-')}`}>{t('pick_ships_links')}</span>
                                    <div class="[ pick-ships__slots ]" role="group" aria-labelledby={`links-${pilot.character_id}-${entry.key.replace(':', '-')}`}>
                                        {initial_slots(pilot, entry).map((kind, index) =>
                                            <Select
                                                size="sm"
                                                x-model={`slots[${index}]`}
                                                aria-label={t('pick_ships_link_slot').replace('{n}', (index + 1).toString())}
                                                x-bind:disabled={`picks[cid] !== ${JSON.stringify(entry.key)}`}
                                            >
                                                <option value="" selected={kind === ''}>{t('pick_ships_link_off')}</option>
                                                {fitted_kinds(entry).map(option =>
                                                    <option
                                                        value={option}
                                                        selected={kind === option}
                                                        x-bind:disabled={`slots.filter((slot, other) => other !== ${index} && slot === '${option}').length >= ${entry.fit_roles.bursts_fitted[option]}`}
                                                    >{burst_label(option)}</option>
                                                )}
                                            </Select>
                                        )}
                                    </div>
                                    {fitted_kinds(entry).map(kind =>
                                        <input
                                            type="hidden"
                                            name={`bursts_${pilot.character_id}_${kind}`}
                                            value={initial_counts(pilot, entry)[kind]}
                                            x-bind:value={`slots.filter(slot => slot === '${kind}').length`}
                                            x-bind:disabled={`picks[cid] !== ${JSON.stringify(entry.key)}`}
                                            disabled={selected_key(pilot) !== entry.key}
                                        />
                                    )}
                                </div>
                            )}
                        </div>
                    )}
                    {others.length > 0 && !show_all_by_default &&
                        <div class="[ pick-ships__more ]">
                            <button type="button" class="[ pick-ships__toggle ]" x-on:click="show_all = !show_all" x-bind:aria-expanded="show_all.toString()">
                                <span x-show="!show_all">{t('pick_ships_show_all').replace('{count}', others.length.toString())}</span>
                                <span x-show="show_all" x-cloak>{t('pick_ships_show_recent')}</span>
                                <CaretIcon aria-hidden="true" x-bind:class="{ 'is-open': show_all }" />
                            </button>
                        </div>
                    }
                </div>
            }

            <div class="[ pick-ships__footer ]">
                <span class="[ pick-ships__flying ]" x-text="flying_text">
                    {initial_flying === 1 ? FLYING_ONE : FLYING.replace('{count}', initial_flying.toString())}
                </span>
                <Button size='sm' type="button" color='transparent' onclick="document.querySelector('.modal-backdrop')?.click()">{t('cancel')}</Button>
                {composition.length > 0 &&
                    <Button size='sm' type="submit">{t('save')}</Button>
                }
            </div>
        </Flexblock>
    </form>
    </Wrapper>
}

