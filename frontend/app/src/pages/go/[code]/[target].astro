---
import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

import { record_scout_click } from '@helpers/api.minmatar.org/recruitment'
import { is_scout_link_target, scout_link_destination } from '@helpers/scout_links'

const code = Astro.params.code ?? ''
const target = Astro.params.target ?? ''
const destination = scout_link_destination(target)

if (is_scout_link_target(target)) {
    await record_scout_click(
        code,
        target,
        (Astro.locals as any)?.clientIP ?? '',
        Astro.request.headers.get('user-agent') ?? '',
    )
}

// Site pages stay relative: behind the proxy Astro.url may not be the public origin.
const location = destination.startsWith('/') ? translatePath(destination) : destination

// Never cached, so every visit reaches this page and is counted.
return new Response(null, {
    status: 302,
    headers: { 'Location': location, 'Cache-Control': 'no-store' },
})
---
