---
import { i18n } from '@helpers/i18n'
const { t, lang, translatePath } = i18n(Astro.url)

import type { TaskDigest } from '@dtypes/api.minmatar.org'
import { HTTP_403_Forbidden, login_redirect } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'
import { get_gates, can } from '@helpers/gates'
import { get_task_digest } from '@helpers/api.minmatar.org/tasks'

const { auth_token, user } = get_request_user(Astro)
if (!auth_token || !user) return login_redirect(Astro)
if (!can(await get_gates(Astro), 'tasks.manage')) return HTTP_403_Forbidden()

let digest: TaskDigest | null = null
let error: Error | null = null
try {
    digest = await get_task_digest(auth_token)
} catch (failure) {
    error = failure as Error
}

const page_title = t('tasks.settings.weekly_title')
const breadcrumbs = [
    { page_title: t('tasks.page_title'), accumulated_path: translatePath('/tasks/') },
    { page_title: t('tasks.tab.settings'), accumulated_path: translatePath('/tasks/#settings') },
    { page_title, accumulated_path: translatePath('/tasks/settings/weekly/') },
]

import Viewport from '@layouts/Viewport.astro'
import PageLanding from '@components/page/PageLanding.astro'
import PageBreadcrumbs from '@components/page/PageBreadcrumbs.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import ManageHero from '@components/blocks/manage/ManageHero.astro'
import TaskDigestForm from '@components/blocks/tasks/TaskDigestForm.astro'
---

<Viewport title={page_title} meta_description={t('tasks.description')}>
<PageLanding wide={true} lang={lang}>
    <Flexblock gap="var(--space-xl)">
        <Flexblock gap="var(--space-m)">
            <PageBreadcrumbs is_landing_page={true} links_only={true} breadcrumbs={breadcrumbs} />
            <ManageHero
                title={page_title}
                fact={digest ? (digest.enabled ? t('tasks.settings.weekly_on') : t('tasks.settings.weekly_off')) : undefined}
            />
        </Flexblock>
        {digest
            ? <TaskDigestForm digest={digest} />
            : <ErrorRefetch args={{ partial: translatePath('/partials/tasks_digest_component/'), error: error ?? new Error('Error fetching the weekly list settings'), delay: 0 }} />
        }
    </Flexblock>
</PageLanding>
</Viewport>
