---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import {
    guideMeta,
    credits,
    guideSections,
    buildDreadnoughtGuideJsonLd,
    DREADS_GROUP_ID,
    CAPITALS_TRIBE_NAME,
    DREADS_GROUP_NAME,
    load_capital_guide_runtime,
    overview,
    metaBlocks,
    shipsLead,
    dreadHulls,
    tierLists,
    guidanceLead,
    guidanceReasons,
    revelationSkillPlan,
    crosstrainingLead,
    crosstrainingRows,
} from '@/data/dreadnought-guide'
import { pageProgressFromSections } from '@helpers/pageProgress'
import { get_site_origin } from '@helpers/seo'
import { LEARNING_HUB_PATH, guidePath } from '@/data/guides/urls'
import CapitalGuidePage from '@components/blocks/capital-guide/CapitalGuidePage.astro'
import CapitalClassGuide from '@components/blocks/capital-guide/CapitalClassGuide.astro'

const page_title = t('ships.dreadnought_guide.page_title')
const meta_title = t('ships.dreadnought_guide.meta_title').replace('{site}', t('index.page_title'))
const meta_description = t('ships.dreadnought_guide.meta_description')
const site_origin = get_site_origin(Astro.url.origin)
const canonical_url = new URL(translatePath(guidePath('dreadnought-guide')), site_origin).href
const meta_image = new URL(guideMeta.seoImage, site_origin).href
const guides_url = new URL(translatePath(LEARNING_HUB_PATH), site_origin).href

const structured_data = buildDreadnoughtGuideJsonLd({
    canonicalUrl: canonical_url,
    siteName: t('index.page_title'),
    siteOrigin: site_origin,
    metaTitle: meta_title,
    metaDescription: meta_description,
    metaImage: meta_image,
    guidesUrl: guides_url,
    authorName: credits.author,
    publisherName: 'Minmatar Fleet Alliance',
    editionLabel: `${guideMeta.edition} · ${guideMeta.yc}`,
})

const progress = pageProgressFromSections({
    page_key: 'guides/dreadnought-guide',
    page_title,
    sections: guideSections,
    version_source: JSON.stringify({
        edition: guideMeta.edition,
        yc: guideMeta.yc,
        sections: guideSections.map((section) => section.id),
    }),
})

const { fitting_library, capitals_chief, group_chief, tribe } = await load_capital_guide_runtime({
    group_id: DREADS_GROUP_ID,
    tribe_name_fallback: CAPITALS_TRIBE_NAME,
    group_name_fallback: DREADS_GROUP_NAME,
    subject_phrase: 'Dreadnoughts are a member of',
    teach_topic: 'you how to fly one',
    translate_path: translatePath,
})
---

<CapitalGuidePage
    page_title={page_title}
    meta_title={meta_title}
    meta_description={meta_description}
    meta_image={meta_image}
    canonical_url={canonical_url}
    cover_image={guideMeta.coverImage}
    cover_alt={guideMeta.coverAlt}
    structured_data={structured_data}
    progress={progress}
>
    <CapitalClassGuide
        guide_meta={guideMeta}
        overview={overview}
        meta_blocks={metaBlocks}
        ships_lead={shipsLead}
        hulls={dreadHulls}
        tier_lists={tierLists}
        guidance_lead={guidanceLead}
        guidance_reasons={guidanceReasons}
        guidance_reasons_ordered={true}
        skill_plans={[
            {
                id: 'revelation',
                title: t('ships.dreadnought_guide.skill_plan_title'),
                skills: revelationSkillPlan,
                copy_label: t('ships.dreadnought_guide.copy_skill_plan'),
            },
        ]}
        crosstraining_lead={crosstrainingLead}
        crosstraining_rows={crosstrainingRows}
        crosstraining_column_header="Dreadnought"
        tribe={tribe}
        guide_sections={guideSections}
        fitting_library={fitting_library}
        capitals_chief={capitals_chief}
        group_chief={group_chief}
        capitals_chief_label={t('ships.dreadnought_guide.capitals_tribe_chief')}
        group_chief_label={t('ships.dreadnought_guide.dreads_group_chief')}
        id_prefix="dread"
    />
</CapitalGuidePage>
