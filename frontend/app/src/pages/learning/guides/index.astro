---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import Viewport from '@layouts/Viewport.astro'
import PageLanding from '@components/page/PageLanding.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import LearningHeader from '@components/blocks/LearningHeader.astro'
import GuidesCatalog from '@components/blocks/GuidesCatalog.astro'

const page_title = `${t('learning.guides_page_title')} · ${t('learning.center_title')}`
---

<Viewport title={page_title} meta_description={t('learning.center_lead')}>
    <PageLanding
        cover={{
            image: '/images/guides-cover.jpg',
            image_990: '/images/guides-cover.jpg',
            overlay: true,
            scrollable: true,
        }}
        wide={true}
    >
        <Flexblock gap="var(--space-2xl)">
            <LearningHeader active="guides" />
            <GuidesCatalog show_heading={false} />
        </Flexblock>
    </PageLanding>
</Viewport>
