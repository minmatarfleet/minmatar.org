---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { get_site_origin } from '@helpers/seo'
import { pageProgressFromSections } from '@helpers/pageProgress'
import { get_item_icon } from '@helpers/eve_image_server'
import { guides } from '@/data/guides'
import { getGuideCoverImage, getGuideSeoImage } from '@/data/guides/covers'
import { buildGuideJsonLd, getGuidePageSeo } from '@/data/guides/seo'
import { certificatePath, guidePath } from '@/data/guides/urls'
import { FLEET_ROLES_HUB_SLUG, fleet_role_guides, guide_sims } from '@/data/fleet-roles'
import CapitalGuidePage from '@components/blocks/capital-guide/CapitalGuidePage.astro'
import GuideShell from '@components/blocks/GuideShell.astro'

const meta = guides.find((guide) => guide.slug === FLEET_ROLES_HUB_SLUG)!
const site_origin = get_site_origin(Astro.url.origin)
const seo = getGuidePageSeo({
    guide: meta,
    siteName: t('index.page_title'),
    siteOrigin: site_origin,
    translatePath,
    t,
    coverImage: getGuideSeoImage(meta),
})
const structured_data = buildGuideJsonLd({ guide: meta, siteName: t('index.page_title'), siteOrigin: site_origin, ...seo })
const progress = pageProgressFromSections({
    page_key: `guides/${FLEET_ROLES_HUB_SLUG}`,
    page_title: meta.title,
    sections: ['roles', 'practise'],
})

// Every simulator, with the guide and lesson it belongs to.
const practice = fleet_role_guides.flatMap((guide) =>
    guide_sims(guide).map((sim) => {
        const lesson = guide.lessons.find((l) => l.sim === sim)
        const anchor = sim === guide.featured_sim ? 'mechanics' : `lesson-${lesson?.id}`
        return {
            role: guide.name,
            title: lesson?.title ?? sim,
            summary: lesson?.summary ?? '',
            href: `${guidePath(guide.guide_slug)}#${anchor}`,
        }
    }),
)
---

<CapitalGuidePage
    page_title={meta.title}
    meta_title={seo.metaTitle}
    meta_description={seo.metaDescription}
    meta_image={seo.metaImage}
    canonical_url={seo.canonicalUrl}
    cover_image={getGuideCoverImage(meta)}
    cover_alt=""
    structured_data={structured_data}
    progress={progress}
    robots={meta.unlisted ? 'noindex, nofollow' : undefined}
>
    <GuideShell title={t('fleet_roles.hub_title')} subtitle={t('fleet_roles.hub_subtitle')}>
        <div class="[ role-hub ]">
            <p class="[ role-hub__lede ]">{t('fleet_roles.hub_lede')}</p>
            <section id="roles" data-section-id="roles" class="[ role-hub__section ]" aria-labelledby="role-hub-roles">
                <h2 id="role-hub-roles" class="[ role-hub__title ]">{t('fleet_roles.pick_role')}</h2>
                <ul class="[ role-hub__roles ]">
                    {fleet_role_guides.map((guide) => (
                        <li>
                            <a class="[ role-hub__role ]" href={translatePath(guidePath(guide.guide_slug))}>
                                <img src={get_item_icon(guide.hero_type_id, 256)} alt="" width="256" height="256" loading="lazy" />
                                <span class="[ role-hub__role-body ]">
                                    <span class="[ role-hub__role-name ]">{guide.name}</span>
                                    <span>{guide.lede}</span>
                                    <span class="[ role-hub__muted ]">{guide.ladder[0].name} → {guide.ladder[guide.ladder.length - 1].name}</span>
                                </span>
                            </a>
                        </li>
                    ))}
                </ul>
                <p class="[ role-hub__muted ]">
                    {t('fleet_roles.hub_certificate')}
                    <a href={translatePath(certificatePath('fleet-roles'))}>{t('fleet_roles.hub_certificate_link')}</a>
                    · <a href={translatePath('/account/#training')}>{t('fleet_roles.open_training')}</a>
                </p>
            </section>

            <section id="practise" data-section-id="practise" class="[ role-hub__section ]" aria-labelledby="role-hub-practise">
                <h2 id="role-hub-practise" class="[ role-hub__title ]">{t('fleet_roles.practise')}</h2>
                <p class="[ role-hub__muted ]">{t('fleet_roles.practise_lead')}</p>
                <ul class="[ role-hub__sims ]">
                    {practice.map((sim) => (
                        <li>
                            <a class="[ role-hub__sim ]" href={translatePath(sim.href)}>
                                <span class="[ role-hub__role-name ]">{sim.title}</span>
                                <span class="[ role-hub__muted ]">{sim.role} · {sim.summary}</span>
                            </a>
                        </li>
                    ))}
                </ul>
            </section>
        </div>
    </GuideShell>
</CapitalGuidePage>

<style lang="scss">
    .role-hub {
        container-type: inline-size;
        display: flex;
        flex-direction: column;
        gap: var(--space-l);
    }

    .role-hub__section {
        display: flex;
        flex-direction: column;
        gap: var(--space-s);
    }

    .role-hub__title {
        margin: 0;
        font-family: var(--heading-font);
        font-size: var(--step-2);
        letter-spacing: 0.04em;
        color: var(--fleet-yellow);
    }

    .role-hub__roles,
    .role-hub__sims {
        display: grid;
        gap: var(--space-s);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .role-hub__roles {
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));

        @container (min-width: 50rem) {
            grid-template-columns: repeat(5, minmax(0, 1fr));
        }
    }

    .role-hub__lede {
        margin: 0;
        max-width: var(--max-text-width);
        font-size: var(--step-1);
        color: var(--highlight);
    }

    .role-hub__sims {
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    }

    .role-hub__role,
    .role-hub__sim {
        display: flex;
        flex-direction: column;
        height: 100%;
        box-sizing: border-box;
        border: 1px solid var(--hairline-medium);
        background: var(--surface-sunken);
        color: var(--foreground);
        text-decoration: none;

        @media (hover: hover) {
            &:hover {
                border-color: var(--hairline-strong);
            }
        }
    }

    .role-hub__role img {
        width: 100%;
        height: auto;
        aspect-ratio: 1;
        object-fit: cover;
        background: var(--background);
    }

    .role-hub__role-body {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: var(--space-2xs);
        padding: var(--space-s);
        font-size: var(--step--1);
    }

    .role-hub__sim {
        gap: var(--space-3xs);
        padding: var(--space-s);
    }

    .role-hub__role-name {
        font-family: var(--heading-font);
        font-size: var(--step-1);
        letter-spacing: 0.03em;
        color: var(--fleet-yellow);
    }

    .role-hub__sim .role-hub__role-name {
        font-family: inherit;
        font-size: var(--step-0);
        font-weight: 600;
        color: var(--highlight);
    }

    .role-hub__muted {
        margin: 0;
        font-size: var(--step--1);
        color: var(--text-muted);

        a {
            color: var(--highlight);
        }
    }
</style>
