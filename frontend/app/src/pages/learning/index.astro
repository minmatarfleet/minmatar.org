---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { User } from '@dtypes/jwt'
import * as jose from 'jose'

import type {
    LearningCertificate,
    LearningMeResponse,
    LearningPersona,
    LearningPersonaRecommendation,
} from '@dtypes/api.minmatar.org'
import {
    get_learning_certificates,
    get_learning_me,
    get_learning_persona_recommendation,
} from '@helpers/api.minmatar.org/learning'
import { get_primary_characters } from '@helpers/api.minmatar.org/characters'
import { get_characters_summary_sorted, get_skillsets } from '@helpers/fetching/characters'
import { get_user_permissions } from '@helpers/permissions'
import { PERSONA_COOKIE } from '@helpers/learning'
import { getPublishedGuides } from '@/data/guides'
import { GUIDES_INDEX_COVER } from '@/data/guides/covers'
import { buildLandingCollectionJsonLd, getLearningHubSeo } from '@/data/guides/seo'
import { LEARNING_HUB_PATH } from '@/data/guides/urls'
import { get_site_origin } from '@helpers/seo'
import { get_api_url } from '@helpers/env'
import type { CharacterBasic, Skillset } from '@dtypes/layout_components'

import Viewport from '@layouts/Viewport.astro'
import PageLanding from '@components/page/PageLanding.astro'
import PageTitle from '@components/page/PageTitle.astro'
import TextBox from '@components/layout/TextBox.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import LearningCenterHub from '@components/blocks/LearningCenterHub.astro'

const auth_token = Astro.cookies.has('auth_token')
    ? Astro.cookies.get('auth_token')!.value
    : ''

const cookie_persona = Astro.cookies.has(PERSONA_COOKIE)
    ? (Astro.cookies.get(PERSONA_COOKIE)!.value as LearningPersona)
    : null

const query_persona = Astro.url.searchParams.get('persona') as LearningPersona | null
const unavailable = Astro.url.searchParams.get('unavailable') === '1'

let me: LearningMeResponse | null = null
let recommendation: LearningPersonaRecommendation | null = null
let readiness_character_id = 0
let skillsets: Skillset[] = []
let skillsets_character: CharacterBasic | null = null
let certificates_admin_href: string | null = null
let skillsets_admin_href: string | null = null
const skillsets_login_href = auth_token
    ? null
    : `${translatePath('/redirects/auth_init')}?redirect_url=${Astro.url}`

if (auth_token) {
    try {
        const user = jose.decodeJwt(auth_token) as User
        ;[me, recommendation] = await Promise.all([
            get_learning_me(auth_token),
            get_learning_persona_recommendation(auth_token),
        ])

        const user_permissions = await get_user_permissions(user?.username)
        if (user_permissions.includes('eveonline.add_evecharactertag')) {
            const character_summary = await get_characters_summary_sorted(auth_token)
            readiness_character_id = character_summary.characters?.[0]?.character_id ?? 0
        }

        const api_base = get_api_url()
        if (
            user.is_superuser
            || user_permissions.includes('learning.change_certificate')
            || user_permissions.includes('learning.view_certificate')
        ) {
            certificates_admin_href = `${api_base}/admin/learning/certificate/`
        }
        if (
            user.is_superuser
            || user_permissions.includes('eveonline.change_eveskillset')
            || user_permissions.includes('eveonline.view_eveskillset')
        ) {
            skillsets_admin_href = `${api_base}/admin/eveonline/eveskillset/`
        }

        try {
            const primary = await get_primary_characters(auth_token)
            if (primary?.character_id) {
                const primary_skillsets = await get_skillsets(auth_token, primary.character_id)
                skillsets = primary_skillsets.skillsets
                skillsets_character = {
                    character_id: primary_skillsets.character_id,
                    character_name: primary_skillsets.character_name,
                }
            }
        } catch (skillsets_error) {
            console.error(skillsets_error)
        }
    } catch (e) {
        console.error(e)
    }
}

const valid_personas = new Set(['alliance', 'militia', 'other'])
const persona_candidates = [
    query_persona,
    me?.persona,
    cookie_persona,
    recommendation?.persona,
].filter((p): p is LearningPersona => !!p && valid_personas.has(p))

const persona = persona_candidates[0] ?? null
const persona_confirmed = Boolean(me?.persona_confirmed || cookie_persona || query_persona)

const show_persona_gate =
    !persona_confirmed ||
    (Boolean(auth_token) && me !== null && !me.persona_confirmed && !query_persona && !cookie_persona)

let certificates: LearningCertificate[] = []
let certificates_error = false
try {
    certificates = await get_learning_certificates(
        show_persona_gate ? null : persona,
    )
} catch (e) {
    console.error(e)
    certificates_error = true
}

const completed_slugs = me?.completed_learning_slugs ?? []
const site_origin = get_site_origin(Astro.url.origin)
const seo = getLearningHubSeo({
    siteName: t('index.page_title'),
    siteOrigin: site_origin,
    translatePath,
    t,
    coverImage: GUIDES_INDEX_COVER.image,
})
const structured_data = buildLandingCollectionJsonLd({
    siteName: t('index.page_title'),
    siteOrigin: site_origin,
    metaTitle: seo.metaTitle,
    metaDescription: seo.metaDescription,
    canonicalUrl: seo.canonicalUrl,
    metaImage: seo.metaImage,
    guides: getPublishedGuides(),
    translatePath,
})

const page_title = t('learning.page_title')
---

<Viewport
    title={seo.metaTitle}
    meta_description={seo.metaDescription}
    meta_image={seo.metaImage}
    canonical_url={seo.canonicalUrl}
    components={{
        alert_dialog: true,
        modal: true,
    }}
>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structured_data)} />
    <PageLanding
        cover={{
            image: '/images/alliance-cover.jpg',
            image_990: '/images/alliance-cover.jpg',
            overlay: true,
            scrollable: true,
        }}
        wide={true}
    >
        <Flexblock gap="var(--space-2xl)">
            {unavailable &&
                <TextBox>
                    <p class="[ excerpt ]">{t('learning_center.certificate_unavailable')}</p>
                </TextBox>
            }
            <LearningCenterHub
                certificates={show_persona_gate ? [] : certificates}
                certificates_error={!show_persona_gate && certificates_error}
                completed_slugs={completed_slugs}
                persona={persona}
                recommendation={recommendation}
                auth_token={auth_token}
                needs_persona={show_persona_gate}
                persona_confirmed_on_server={Boolean(me?.persona_confirmed)}
                readiness_character_id={readiness_character_id}
                catalog_path={LEARNING_HUB_PATH}
                skillsets={skillsets}
                skillsets_character={skillsets_character}
                skillsets_login_href={skillsets_login_href}
                certificates_admin_href={certificates_admin_href}
                skillsets_admin_href={skillsets_admin_href}
            >
                <Flexblock slot="intro" gap="var(--space-l)">
                    <TextBox>
                        <PageTitle is_landing={true}>{page_title}</PageTitle>
                    </TextBox>
                    <TextBox>
                        <p class="[ excerpt ]">{t('learning.leading_text')}</p>
                    </TextBox>
                </Flexblock>
            </LearningCenterHub>
        </Flexblock>
    </PageLanding>
</Viewport>
