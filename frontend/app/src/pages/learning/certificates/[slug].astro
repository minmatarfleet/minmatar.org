---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { LearningCertificate, LearningMeResponse } from '@dtypes/api.minmatar.org'
import {
    get_learning_certificate,
    get_learning_me,
} from '@helpers/api.minmatar.org/learning'
import { certificateProgressPercent } from '@helpers/learning'
import { LEARNING_HUB_PATH } from '@/data/guides/urls'

import Viewport from '@layouts/Viewport.astro'
import PageDefault from '@components/page/PageDefault.astro'
import PageTitle from '@components/page/PageTitle.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import Breadcrumb from '@components/blocks/Breadcrumb.astro'
import LearningCertificateDetail from '@components/blocks/LearningCertificateDetail.astro'

const { slug } = Astro.params

const auth_token = Astro.cookies.has('auth_token')
    ? Astro.cookies.get('auth_token')!.value
    : ''

let certificate: LearningCertificate | null = null
let certificate_fetch_failed = false
try {
    certificate = await get_learning_certificate(slug as string)
} catch (e: any) {
    console.error(e)
    // Unpublished / missing: soft unavailable instead of generic 404.
    if (e?.cause === 404) {
        certificate_fetch_failed = false
    } else {
        certificate_fetch_failed = true
    }
}

if (!certificate && !certificate_fetch_failed) {
    return Astro.redirect(
        `${translatePath(LEARNING_HUB_PATH)}?unavailable=1`,
    )
}

if (!certificate) {
    return Astro.redirect('/404')
}

let me: LearningMeResponse | null = null
if (auth_token) {
    try {
        me = await get_learning_me(auth_token)
    } catch (e) {
        console.error(e)
    }
}

const completed_slugs = me?.completed_learning_slugs ?? []
const percent = certificateProgressPercent(
    certificate.learnings.map((l) => l.slug),
    completed_slugs,
)

const page_title = certificate.title
const breadcrumb_items = [
    { label: t('learning.page_title'), href: translatePath(LEARNING_HUB_PATH) },
    { label: certificate.title },
]
---

<Viewport
    title={page_title}
    meta_description={certificate.summary || t('learning_center.meta_description')}
    components={{
        alert_dialog: true,
    }}
>
    <PageDefault
        cover={{
            image: '/images/alliance-cover.jpg',
            image_990: '/images/alliance-cover.jpg',
            overlay: true,
            scrollable: true,
        }}
    >
        <FlexInline slot="header" justification="space-between" class="[ w-full ]">
            <Flexblock gap="var(--space-3xs)">
                <Breadcrumb items={breadcrumb_items} />
                <PageTitle>{page_title}</PageTitle>
            </Flexblock>
        </FlexInline>

        <LearningCertificateDetail
            certificate={certificate}
            completed_slugs={completed_slugs}
            auth_token={auth_token}
            percent={percent}
        />
    </PageDefault>
</Viewport>
