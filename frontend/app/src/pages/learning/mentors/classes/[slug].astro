---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { login_redirect } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'

const { auth_token, user } = get_request_user(Astro)

if (!user)
    return login_redirect(Astro)

import { get_mentor_class } from '@helpers/api.minmatar.org/mentors'
import { MENTOR_CLASS_PARTIAL, mentor_class_cover, mentors_url } from '@helpers/mentors'

const slug = Astro.params.slug ?? ''
const partial_url = translatePath(mentors_url(MENTOR_CLASS_PARTIAL, { slug }))

// The page background is the cover a learning manager picked for the class.
// The class itself renders in the partial; a failed lookup keeps the default.
let cover_image_url = ''
let class_title = ''
try {
    const detail = await get_mentor_class(auth_token as string, slug)
    cover_image_url = detail.cover_image_url
    class_title = detail.title
} catch {
    // The partial shows the error with a retry.
}
const cover = mentor_class_cover(cover_image_url)
const page_title = `${class_title || t('mentors.page_title')} · ${t('learning.center_title')}`

import Viewport from '@layouts/Viewport.astro'
import PageLanding from '@components/page/PageLanding.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import LearningHeader from '@components/blocks/LearningHeader.astro'
import LazyPartial from '@components/blocks/LazyPartial.astro'
---

<Viewport
    title={page_title}
    meta_description={t('mentors.meta_description')}
    components={{ alert_dialog: true, confirm_dialog: true, modal: true }}
>
    <PageLanding
        cover={{
            image: cover,
            image_990: cover,
            overlay: true,
            scrollable: true,
        }}
        wide={true}
    >
        <Flexblock gap="var(--space-xl)">
            <LearningHeader active="mentors" />
            <LazyPartial url={partial_url} swap="outerHTML">
                <p class="[ mentors-loading ]">{t('loading')}</p>
            </LazyPartial>
        </Flexblock>
    </PageLanding>
</Viewport>

<style lang="scss">
    .mentors-loading {
        color: var(--text-muted);
    }
</style>
