---
import { i18n } from '@helpers/i18n'
import { get_request_user } from '@helpers/request_user'
const { t, translatePath } = i18n(Astro.url)

const { auth_token } = get_request_user(Astro)

import type { Product, ProductInsights } from '@dtypes/api.minmatar.org'
import { get_product_by_id, get_product_insights } from '@helpers/api.minmatar.org/industry'

const product_id = parseInt(Astro.params.id ?? '0')

let product: Product | null = null
let fetching_error: Error | false = false

try {
    if (isNaN(product_id) || product_id <= 0)
        throw new Error(t('invalid_product_id'), { cause: 400 })

    product = await get_product_by_id(product_id)
} catch (error) {
    fetching_error = error
}

if (fetching_error && (fetching_error.cause === 404 || fetching_error.cause === 400))
    return Astro.redirect(translatePath('/industry/products/'))

// Render the panel here when the cache is warm. Its styles only reach the
// page if the page renders it; htmx drops the <link> a partial leads with.
let insights: ProductInsights | null = null

if (product && auth_token) {
    try {
        insights = await get_product_insights(auth_token, product_id)
    } catch {
        // The partial below retries and shows the error.
    }
}

import { query_string } from '@helpers/string'

const has_build = !!product?.blueprint_or_reaction_type_id
const BUILD_PATH = has_build ? translatePath(`/industry/products/${product_id}/build/`) : null
const INSIGHTS_PARTIAL_URL = `${translatePath('/partials/product_insights_component')}?${query_string({
    product_id,
    view: 'overview',
    ...(has_build ? { build: 1 } : {}),
})}`
const strategy_path = (strategy: string) => strategy === 'produced'
    ? '/industry/products/'
    : `/industry/products?strategy=${strategy}`

const page_title = product?.name ?? t('industry.products.page_title')
const breadcrumbs = [
    { page_title: t('industry.page_title'), accumulated_path: '/industry/' },
    {
        page_title: t('industry.products.page_title'),
        accumulated_path: product ? strategy_path(product.strategy) : '/industry/products/',
    },
    { page_title: page_title, accumulated_path: Astro.url.pathname },
]

import Viewport from '@layouts/Viewport.astro'

import PageWide from '@components/page/PageWide.astro'
import PageTitle from '@components/page/PageTitle.astro'

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'

import ButtonAuth from '@components/blocks/ButtonAuth.astro'
import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import ItemPicture from '@components/blocks/ItemPicture.astro'
import ProductHeader from '@components/blocks/ProductHeader.astro'
import ProductInsightsPanel from '@components/blocks/ProductInsightsPanel.astro'
---

<Viewport
    title={page_title}
    meta_description={t('industry.product.meta_description').replace('{name}', page_title)}
>
    <PageWide
        cover={{
            image: "/images/blueprint-cover.jpg",
            image_990: "/images/blueprint-cover.jpg",
            overlay: true,
            scrollable: true,
        }}
        breadcrumbs={breadcrumbs}
    >
        {product ?
            <ProductHeader slot="header" product={product} view="overview" />
            :
            <PageTitle slot="header">{page_title}</PageTitle>
        }

        {fetching_error !== false || !product ?
            <ErrorRefetch
                args={{
                    partial: INSIGHTS_PARTIAL_URL,
                    error: fetching_error || new Error(t('invalid_product_id')),
                    delay: 0,
                }}
            />
            :
            <Flexblock gap="var(--space-xl)">
                {auth_token && insights?.ready ?
                    <ProductInsightsPanel insights={insights} build_path={BUILD_PATH} />
                    : auth_token ?
                    <div
                        hx-get={INSIGHTS_PARTIAL_URL}
                        hx-trigger="load"
                        hx-swap="outerHTML"
                    >
                        <p class="[ loading muted ]">{t('industry.product.loading_insights')}</p>
                    </div>
                    :
                    <FlexInline gap="var(--space-s)" class="[ items-center ]">
                        <p class="[ muted ]">{t('industry.product.login_for_insights')}</p>
                        <ButtonAuth size="sm">{t('industry.orders.assign_log_in')}</ButtonAuth>
                    </FlexInline>
                }

                {(product.supplies.length > 0 || product.supplied_for.length > 0) &&
                    <ComponentBlock padding_inline="var(--space-m)" padding_block="var(--space-m)">
                        <section class="[ relations ]" aria-labelledby="supply-chain-heading">
                            <header class="[ relations-header ]">
                                <h3 id="supply-chain-heading">{t('industry.product.supply_chain_title')}</h3>
                                {has_build && BUILD_PATH &&
                                    <a href={BUILD_PATH}>{t('industry.product.see_quantities')}</a>
                                }
                            </header>
                            {product.supplies.length > 0 &&
                                <Flexblock gap="var(--space-2xs)">
                                    <small class="[ subheading ]">{t('industry.product.made_from')}</small>
                                    <ul class="[ chips ]" role="list">
                                        {product.supplies.map(component =>
                                            <li>
                                                <a class="[ chip ]" href={translatePath(`/industry/products/${component.id}/`)}>
                                                    <ItemPicture item_id={component.type_id} size={32} icon_quality={64} />
                                                    <span>{component.name}</span>
                                                </a>
                                            </li>
                                        )}
                                    </ul>
                                </Flexblock>
                            }
                            {product.supplied_for.length > 0 &&
                                <Flexblock gap="var(--space-2xs)">
                                    <small class="[ subheading ]">{t('industry.product.used_in')}</small>
                                    <ul class="[ chips ]" role="list">
                                        {product.supplied_for.map(parent =>
                                            <li>
                                                <a class="[ chip ]" href={translatePath(`/industry/products/${parent.id}/`)}>
                                                    <ItemPicture item_id={parent.type_id} size={32} icon_quality={64} />
                                                    <span>{parent.name}</span>
                                                </a>
                                            </li>
                                        )}
                                    </ul>
                                </Flexblock>
                            }
                        </section>
                    </ComponentBlock>
                }
            </Flexblock>
        }
    </PageWide>
</Viewport>

<style lang="scss">
    .muted {
        color: var(--foreground);
    }

    .relations {
        display: flex;
        flex-direction: column;
        gap: var(--space-m);

        h3 {
            font-size: var(--step-1);
        }
    }

    .relations-header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: baseline;
        gap: var(--space-2xs) var(--space-s);
        font-size: var(--step--1);
    }

    .subheading {
        color: var(--fleet-yellow);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 600;
        font-size: var(--step--2);
    }

    .chips {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
        gap: var(--space-2xs);
        padding: 0;
        margin: 0;
    }

    .chip {
        display: flex;
        align-items: center;
        gap: var(--space-xs);
        height: 100%;
        min-height: var(--space-xl);
        padding: var(--space-2xs) var(--space-xs);
        border: solid 1px var(--border-color);
        background-color: var(--background);
        color: var(--highlight);
        font-size: var(--step--1);
        text-decoration: none;
        transition: border-color var(--fast-transition);

        @media (hover: hover) {
            &:hover {
                border-color: var(--fleet-yellow);
            }
        }
    }
</style>
