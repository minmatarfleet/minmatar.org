---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { DEFAULT_LOYALTY_OFFERS_PARAMS, TLIB_CORP_ID } from '@helpers/loyalty_offers_metrics'
import { get_corporation_logo } from '@helpers/eve_image_server'
import { query_string } from '@helpers/string'

const LOYALTY_OFFERS_PARTIAL_URL = translatePath(
    `/partials/loyalty_offers_component?${query_string(DEFAULT_LOYALTY_OFFERS_PARAMS)}`,
)

import Viewport from '@layouts/Viewport.astro'
import PageWide from '@components/page/PageWide.astro'
import PageTitle from '@components/page/PageTitle.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import LoyaltyOffersSkeleton from '@components/blocks/LoyaltyOffersSkeleton.astro'
import LazyPartial from '@components/blocks/LazyPartial.astro'

const page_title = t('industry.loyalty.offers.page_title')
const breadcrumbs = [
    { page_title: t('market.page_title'), accumulated_path: '/market/' },
    { page_title: t('industry.loyalty.page_title'), accumulated_path: '/industry/loyalty/' },
    { page_title: page_title, accumulated_path: Astro.url.pathname },
]
const offers_count_text = t('industry.loyalty.offers.showing_plural').replace('{count}', '0')
---

<Viewport
    title={page_title}
    meta_description={t('industry.loyalty.offers.meta_description')}
    components={{
        tippy: true,
    }}
>
    <PageWide
        cover={{
            image: '/images/loyalty-points-cover.webp',
            image_990: '/images/loyalty-points-cover.webp',
            overlay: true,
            scrollable: true,
        }}
        sticky={true}
        breadcrumbs={breadcrumbs}
        x-data={`{
            offers_count: 0,
            last_updated_text: '',
            offers_plural: '${t('industry.loyalty.offers.showing_plural')}',
            offers_singular: '${t('industry.loyalty.offers.showing_singular')}',
        }`}
    >
        <FlexInline slot="header" justification="space-between" class="[ w-full ]">
            <Flexblock gap="var(--space-2xs)" class="[ loyalty-offers-header ]">
                <FlexInline gap="var(--space-2xs)" class="[ !items-center ]">
                    <img
                        class="[ loyalty-offers-header__logo ]"
                        src={get_corporation_logo(TLIB_CORP_ID, 64)}
                        width="64"
                        height="64"
                        alt={t('industry.loyalty.offers.corp_logo_alt')}
                    />
                    <span class="[ loyalty-offers-header__eyebrow ]">{t('industry.loyalty.offers.eyebrow')}</span>
                </FlexInline>
                <PageTitle>{page_title}</PageTitle>
                <p class="[ loyalty-offers-header__lede ]">{t('industry.loyalty.offers.lede')}</p>
                <FlexInline gap="var(--space-xs)">
                    <small
                        class="[ loyalty-offers-header__meta ]"
                        x-text="(offers_count != 1 ? offers_plural : offers_singular).replace('{count}', String(offers_count))"
                    >{offers_count_text}</small>
                    <small class="[ loyalty-offers-header__meta ]" x-show="last_updated_text" x-text="last_updated_text"></small>
                </FlexInline>
            </Flexblock>
        </FlexInline>

        <LazyPartial
            id="loyalty-offers-slot"
            data-loyalty-offers-deferred="1"
            url={LOYALTY_OFFERS_PARTIAL_URL}
        >
            <LoyaltyOffersSkeleton />
        </LazyPartial>
    </PageWide>
</Viewport>

<style lang="scss">
    .loyalty-offers-header__eyebrow {
        font-size: var(--step--1);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--fleet-yellow);
    }

    .loyalty-offers-header__logo {
        width: var(--space-l);
        height: var(--space-l);
        border-radius: 2px;
        background-color: var(--background);
    }

    .loyalty-offers-header__lede {
        margin: 0;
        max-width: var(--max-text-width);
        font-size: var(--step-0);
        color: var(--highlight);
    }

    .loyalty-offers-header__meta {
        color: var(--faded);
    }
</style>
