---
import { get_public_api_url } from '@helpers/env'
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { User } from '@dtypes/jwt'
import * as jose from 'jose'

const auth_token = Astro.cookies.has('auth_token') ? Astro.cookies.get('auth_token')?.value : false
const user = auth_token ? jose.decodeJwt(auth_token) as User : false
const is_logged_in = Boolean(auth_token && user)
const user_is_staff = Boolean(user && user.is_staff)

import type {
    LoyaltyCurrency,
    LoyaltyMarketOrder,
    LoyaltyMarketOrdersList,
    LoyaltyOrderStats as LoyaltyOrderStatsData,
} from '@dtypes/api.minmatar.org'
import {
    get_loyalty_capabilities,
    get_loyalty_currencies,
    get_loyalty_orders,
    get_loyalty_stats,
} from '@helpers/api.minmatar.org/loyalty'
import { get_characters_summary } from '@helpers/api.minmatar.org/characters'
import { tlf_currency } from '@helpers/loyalty_order_stats'
import { get_corporation_logo } from '@helpers/eve_image_server'
import {
    loyalty_history_query,
    parse_loyalty_history_params,
} from '@helpers/loyalty_order_history'

// The buyback book only trades Tribal Liberation Force LP.
let currency: LoyaltyCurrency | null = null
let orders: LoyaltyMarketOrder[] = []
let stats: LoyaltyOrderStatsData | null = null
let week_stats: LoyaltyOrderStatsData | null = null
let order_history: LoyaltyMarketOrdersList = { items: [], total: 0, limit: null, offset: 0 }
const history_filters = parse_loyalty_history_params(Astro.url.searchParams)
let fetching_error: Error | false = false
let claim_characters: {
    character_name: string
    corp_name: string
    is_primary: boolean
}[] = []
let claim_corporations: string[] = []
let default_claim_corporation = ''
let default_claim_character = ''
let can_manage_buyback = false
const current_user_id = user ? Number(user.user_id) : 0

// Stats are decoration: a failure must not hide the order book.
const quiet_stats = (loyalty_point_id: number, days?: number) =>
    get_loyalty_stats(loyalty_point_id, days).catch((error) => {
        console.log(error)
        return null
    })

try {
    currency = tlf_currency(await get_loyalty_currencies())
    if (currency) {
        const loyalty_point_id = currency.id
        let active_orders: LoyaltyMarketOrdersList
        ;[active_orders, order_history, stats, week_stats] = await Promise.all([
            get_loyalty_orders({ loyalty_point_id }),
            get_loyalty_orders(loyalty_history_query(history_filters, loyalty_point_id)),
            quiet_stats(loyalty_point_id),
            quiet_stats(loyalty_point_id, 7),
        ])
        orders = active_orders.items
    }
} catch (error) {
    fetching_error = error as Error
}

if (is_logged_in && auth_token) {
    // Settled separately: a failed character summary must not hide the
    // manager actions that capabilities grant (and vice versa).
    const [summary_result, capabilities_result] = await Promise.allSettled([
        get_characters_summary(auth_token),
        get_loyalty_capabilities(auth_token),
    ])
    if (capabilities_result.status === 'fulfilled') {
        can_manage_buyback = Boolean(capabilities_result.value.can_manage)
    } else {
        console.log(capabilities_result.reason)
    }
    if (summary_result.status === 'fulfilled') {
        const summary = summary_result.value
        claim_characters = (summary.characters ?? [])
            .map((character) => ({
                character_name: character.character_name,
                corp_name: character.corp_name || '',
                is_primary: Boolean(character.is_primary),
            }))
            .sort((a, b) => {
                if (a.is_primary !== b.is_primary) return a.is_primary ? -1 : 1
                return a.character_name.localeCompare(b.character_name)
            })
        claim_corporations = [...new Set(
            claim_characters
                .map((character) => character.corp_name)
                .filter((name) => Boolean(name))
        )].sort((a, b) => a.localeCompare(b))
        const primary = claim_characters.find((c) => c.is_primary) || claim_characters[0] || null
        default_claim_character = primary?.character_name || ''
        default_claim_corporation = primary?.corp_name
            || claim_corporations[0]
            || ''
    } else {
        console.log(summary_result.reason)
    }
}

const highlight_order_id = Astro.url.searchParams.get('order')
const my_orders = current_user_id
    ? orders.filter((order) => order.created_by_user_id === current_user_id)
    : []
const week_median_seconds = week_stats?.median_close_seconds ?? null
const login_url = `${translatePath('/redirects/auth_init')}?redirect_url=${encodeURIComponent(Astro.url.toString())}`
const default_tab = orders.length > 0 || highlight_order_id ? 'open' : 'history'

import Viewport from '@layouts/Viewport.astro'
import PageWide from '@components/page/PageWide.astro'
import PageActions from '@components/page/PageActions.astro'
import PageTitle from '@components/page/PageTitle.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import LoyaltyQuote from '@components/blocks/LoyaltyQuote.astro'
import LoyaltySaleSteps from '@components/blocks/LoyaltySaleSteps.astro'
import LoyaltyMyOrders from '@components/blocks/LoyaltyMyOrders.astro'
import LoyaltyOrderBook from '@components/blocks/LoyaltyOrderBook.astro'
import LoyaltyOrderHistory from '@components/blocks/LoyaltyOrderHistory.astro'
import Button from '@components/blocks/Button.astro'
import CogIcon from '@components/icons/buttons/CogIcon.astro'

const page_title = t('industry.loyalty.page_title')
const breadcrumbs = [
    { page_title: t('market.page_title'), accumulated_path: '/market/' },
    { page_title: page_title, accumulated_path: Astro.url.pathname },
]
const api_base = get_public_api_url()
const admin_loyalty_url = `${api_base}/admin/industry/loyalty/`
---

<Viewport
    title={page_title}
    meta_description={t('industry.loyalty.meta_description')}
    components={{
        alert_dialog: true,
        tippy: true,
    }}
>
    <PageWide
        cover={{
            image: '/images/loyalty-points-cover.webp',
            image_990: '/images/loyalty-points-cover.webp',
            overlay: true,
            scrollable: true,
        }}
        sticky={true}
        breadcrumbs={breadcrumbs}
        breadcrumb_page_title={page_title}
    >
        <FlexInline slot="header" justification="space-between" class="[ w-full ]">
            <Flexblock gap="var(--space-2xs)" class="[ loyalty-hero ]">
                <FlexInline gap="var(--space-xs)" class="[ loyalty-hero__eyebrow ]">
                    <img
                        src={get_corporation_logo(currency?.corporation_id ?? 1000182, 64)}
                        alt={currency?.name ?? ''}
                        width="44"
                        height="44"
                    />
                    <span>{t('industry.loyalty.hero.eyebrow')}</span>
                </FlexInline>
                <PageTitle>{t('industry.loyalty.hero.title')}</PageTitle>
                <p class="[ loyalty-hero__lede ]">{t('industry.loyalty.hero.lede')}</p>
            </Flexblock>
            <PageActions>
                <Button
                    href={translatePath('/industry/loyalty/offers/')}
                    color="transparent"
                >
                    {t('industry.loyalty.view_offers')}
                </Button>
                {can_manage_buyback && (
                    <Button
                        href={translatePath('/industry/loyalty/desk/')}
                        color="transparent"
                    >
                        {t('industry.loyalty.desk_link')}
                    </Button>
                )}
                {user_is_staff && (
                    <Button
                        href={admin_loyalty_url}
                        color="transparent"
                        narrow={true}
                        new_tab={true}
                        aria-label={t('industry.loyalty.edit_in_admin')}
                        title={t('industry.loyalty.edit_in_admin')}
                    >
                        <CogIcon slot="icon" />
                    </Button>
                )}
            </PageActions>
        </FlexInline>

        <Flexblock gap="var(--space-2xl)">
            {fetching_error ? (
                <ErrorRefetch
                    args={{
                        partial: highlight_order_id
                            ? `${translatePath('/industry/loyalty/')}?order=${encodeURIComponent(highlight_order_id)}`
                            : translatePath('/industry/loyalty/'),
                        error: fetching_error,
                        delay: 0,
                    }}
                />
            ) : !currency ? (
                <p>{t('industry.loyalty.rates.empty')}</p>
            ) : (
                <>
                    <LoyaltyQuote
                        currency={currency}
                        stats={stats}
                        week_stats={week_stats}
                        is_logged_in={is_logged_in}
                        login_url={login_url}
                    />

                    <LoyaltyMyOrders orders={my_orders} current_user_id={current_user_id} />

                    <LoyaltySaleSteps />

                    <section
                        class="[ loyalty-book ]"
                        aria-labelledby="loyalty-book-title"
                        x-data={`{ tab: ${JSON.stringify(default_tab)} }`}
                    >
                        <Flexblock gap="var(--space-s)">
                            <FlexInline justification="space-between" class="[ w-full ]">
                                <h2 id="loyalty-book-title">{t('industry.loyalty.book.title')}</h2>
                                <div class="[ loyalty-book__tabs ]" role="group" aria-label={t('industry.loyalty.book.view')}>
                                    <button
                                        type="button"
                                        x-bind:aria-pressed="tab === 'open'"
                                        x-on:click="tab = 'open'"
                                    >
                                        {t('industry.loyalty.book.open').replace('{count}', String(orders.length))}
                                    </button>
                                    <button
                                        type="button"
                                        x-bind:aria-pressed="tab === 'history'"
                                        x-on:click="tab = 'history'"
                                    >
                                        {t('industry.loyalty.book.history')}
                                    </button>
                                </div>
                            </FlexInline>
                            <div x-show="tab === 'open'" x-cloak={default_tab !== 'open' ? '' : undefined}>
                                <LoyaltyOrderBook
                                    orders={orders}
                                    currency={currency}
                                    is_logged_in={is_logged_in}
                                    current_user_id={current_user_id}
                                    can_manage_buyback={can_manage_buyback}
                                    highlight_order_id={highlight_order_id}
                                    claim_characters={claim_characters}
                                    claim_corporations={claim_corporations}
                                    default_claim_character={default_claim_character}
                                    default_claim_corporation={default_claim_corporation}
                                    show_title={false}
                                    week_median_seconds={week_median_seconds}
                                />
                            </div>
                            <div x-show="tab === 'history'" x-cloak={default_tab !== 'history' ? '' : undefined}>
                                <LoyaltyOrderHistory
                                    orders={order_history.items}
                                    total={order_history.total}
                                    filters={history_filters}
                                />
                            </div>
                        </Flexblock>
                    </section>

                    <section class="[ loyalty-alt ]" aria-labelledby="loyalty-alt-title">
                        <Flexblock gap="var(--space-3xs)" class="[ loyalty-alt__text ]">
                            <h2 id="loyalty-alt-title">{t('industry.loyalty.alt.title')}</h2>
                            <p>{t('industry.loyalty.alt.text')}</p>
                        </Flexblock>
                        <Button href={translatePath('/industry/loyalty/offers/')}>
                            {t('industry.loyalty.alt.link')}
                        </Button>
                    </section>
                </>
            )}
        </Flexblock>
    </PageWide>
</Viewport>

<style lang="scss">
    .loyalty-hero__eyebrow {
        align-items: center;
        flex-wrap: nowrap;

        img {
            flex: none;
            width: var(--space-xl);
            height: var(--space-xl);
            border: 1px solid color-mix(in srgb, var(--fleet-yellow) 35%, transparent);
            background-color: var(--background);
        }

        span {
            font-size: var(--step--1);
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--fleet-yellow);
        }
    }

    .loyalty-hero__lede {
        max-width: var(--max-text-width);
        margin: 0;
        font-size: var(--step-0);
        line-height: 1.55;
        color: var(--highlight);
    }

    /* The sticky bar keeps just the title and actions. */
    @supports (container-type: scroll-state) {
        @container sticky-heading scroll-state(stuck: top) {
            .loyalty-hero__eyebrow,
            .loyalty-hero__lede {
                display: none;
            }
        }
    }

    .loyalty-book {
        h2 {
            margin: 0;
            font-size: var(--step-2);
        }
    }

    .loyalty-book__tabs {
        display: inline-flex;
        gap: var(--space-3xs);
        padding: var(--space-3xs);
        border: 1px solid var(--border-color);
        background-color: var(--component-background);

        button {
            min-height: var(--space-l);
            padding-inline: var(--space-s);
            border: 0;
            background: transparent;
            color: var(--faded);
            font-family: var(--button-font);
            font-size: var(--step--1);
            font-weight: 700;
            cursor: pointer;

            &[aria-pressed='true'] {
                background-color: var(--border-color-hover);
                color: var(--highlight);
            }
        }
    }

    .loyalty-alt {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-s) var(--space-m);
        padding: var(--space-m);
        border: 1px dashed var(--border-color-hover);

        h2 {
            margin: 0;
            font-family: var(--default-font);
            font-size: var(--step-1);
            text-transform: none;
        }

        p {
            margin: 0;
            max-width: var(--max-text-width);
            font-size: var(--step--1);
            line-height: 1.55;
            color: var(--foreground);
        }
    }

    .loyalty-alt__text {
        flex: 1 1 24rem;
    }

    [x-cloak] {
        display: none !important;
    }
</style>

<script define:vars={{ highlight_order_id }}>
    if (highlight_order_id) {
        const el = document.getElementById(`order-${highlight_order_id}`)
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' })
    }
</script>
