---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { User } from '@dtypes/jwt'
import * as jose from 'jose'

const auth_token = Astro.cookies.has('auth_token') ? Astro.cookies.get('auth_token')?.value : false
const user = auth_token ? jose.decodeJwt(auth_token) as User : false

import { should_redirect_to_orders_onboarding } from '@helpers/onboarding/ordersRedirect'

if (auth_token && user) {
    if (await should_redirect_to_orders_onboarding(auth_token as string)) {
        const return_to = encodeURIComponent(Astro.url.pathname + Astro.url.search)
        return Astro.redirect(`${translatePath('/industry/orders/onboarding/')}?return=${return_to}`)
    }
}

import { load_industry_orders_page } from '@helpers/fetching/industry_orders_page'

const {
    orders_locations,
    fetching_error,
    manufacturers,
} = await load_industry_orders_page()

let active_location_name = Astro.url.searchParams.get('location_name') ?? (orders_locations[0]?.location_name ?? '')

if (orders_locations.length > 0) {
    if (active_location_name === '' || !orders_locations.find(location => location.location_name === active_location_name) )
        active_location_name = orders_locations[0].location_name
}

const active_orders_locations = orders_locations.find(location => location.location_name === active_location_name)
const orders_count = active_orders_locations?.orders.length ?? 0
const orders_count_text = (orders_count != 1 ? t('showing_orders_plural') : t('showing_orders_singular')).replace('{count}', String(orders_count))

const non_active_orders_locations = orders_locations.filter(location => location.location_name !== active_location_name)

import { query_string } from '@helpers/string';

const INDUSTRY_ORDERS_PARTIAL_URL = translatePath(`/partials/industry_orders_component${active_location_name ? `?${query_string({
    location_name: active_location_name
})}` : ''}`)

import {
    get_location_video_cover,
    get_location_video_cover_thumb,
    get_location_cover,
    get_location_cover_990,
} from '@helpers/covers'

import Viewport from '@layouts/Viewport.astro';

import PageWide from '@components/page/PageWide.astro';
import PageActions from '@components/page/PageActions.astro';
import PageTitle from '@components/page/PageTitle.astro';
import PageSubheader from '@components/page/PageSubheader.astro';

import Flexblock from '@components/compositions/Flexblock.astro';
import FlexInline from '@components/compositions/FlexInline.astro';

import Input from '@components/blocks/Input.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import OrdersTable from '@components/blocks/OrdersTable.astro'
import Button from '@components/blocks/Button.astro'
import ButtonOrdersLearnMore from '@components/blocks/ButtonOrdersLearnMore.astro'
import Breadcrumb from '@components/blocks/Breadcrumb.astro'
import TextBox from '@components/layout/TextBox.astro'
import IndustryManufacturersReel from '@components/blocks/IndustryManufacturersReel.astro'

import MagnifierIcon from '@components/icons/buttons/MagnifierIcon.astro';

const page_title = t('industry.orders.page_title');
const leading_text = t('industry.orders.leading_text');
const breadcrumb_items = [
    { label: t('market.page_title'), href: translatePath('/market/') },
    { label: t('industry.orders.page_title') },
]
---

<Viewport
    title={page_title}
    meta_description={t('industry.orders.meta_description')}
    components={{
        alert_dialog: true,
        modal: true,
    }}
>
    <PageWide
        cover={{
			video: get_location_video_cover(active_location_name) ?? undefined,
			video_thumb: get_location_video_cover_thumb(active_location_name) ?? undefined,
            image: get_location_cover(active_location_name) ?? '/images/industry-cover.jpg',
            image_990: get_location_cover_990(active_location_name) ?? '/images/industry-cover.jpg',
            animated: false,
            scrollable: true,
            overlay: true,
        }}
        sticky={true}
        x-data={`{
            orders_count: ${orders_count},
            item_name_filter: '',
            orders_plural: '${t('showing_orders_plural')}',
            orders_singular: '${t('showing_orders_singular')}',
            countVisibleElements(selector, parent = document) {
                const elements = parent.querySelectorAll(selector)
                let visible_count = 0

                elements.forEach(element => {
                    const is_visible = element.offsetParent !== null
                    if (is_visible)
                        visible_count++
                })

                return visible_count
            },
            show_item(el) {
                const name_filter_element = el.querySelectorAll('.order-item')

                return ( this.item_name_filter === '' || name_filter_element[0].textContent.toLowerCase().includes(this.item_name_filter.toLowerCase()) )
            },
        }`}
    >
        <FlexInline slot="header" justification='space-between' class="[ w-full ]">
            <Flexblock gap="var(--space-s)">
                <Breadcrumb items={breadcrumb_items} />
                <Flexblock gap="var(--space-3xs)">
                    <PageTitle>
                        {page_title}
                    </PageTitle>
                    <small x-text="(orders_count != 1 ? orders_plural : orders_singular).replace('{count}', String(orders_count))">{orders_count_text}</small>
                </Flexblock>
            </Flexblock>
            <PageActions>
                <Input type="text"
                    placeholder={t('search')}
                    x-model="item_name_filter"
                    x-on:keyup="setTimeout(function () { orders_count = countVisibleElements('.order-item') })"
                    x-init="$el.focus()"
                    width='250px'
                >
                    <MagnifierIcon slot="icon" />
                </Input>
            </PageActions>
        </FlexInline>

        <PageSubheader slot="subheader">
            <ButtonOrdersLearnMore />

            <Button
                href={translatePath('/industry/orders/summary/')}
                size='sm'
            >
                {t('view_orders_summary')}
            </Button>

            <Button
                href={translatePath('/industry/orders/history/')}
                size='sm'
            >
                {t('view_orders_history')}
            </Button>
        </PageSubheader>

        <Flexblock gap="var(--space-xl)" class="[ compensate-bottom-bar ]">
            <TextBox>
                <p class="[ excerpt ]">{leading_text}</p>
            </TextBox>

            {fetching_error !== false ?
                <ErrorRefetch
                    args={{
                        partial: INDUSTRY_ORDERS_PARTIAL_URL,
                        error: fetching_error,
                        delay: 0,
                    }}
                />
                :
                active_orders_locations !== undefined ?
                    <OrdersTable
                        active_orders_locations={active_orders_locations}
                        non_active_orders_locations={non_active_orders_locations}
                        is_history={false}
                        init_tooltips={false}
                    />
                    :
                    <p>{t('no_manufacturing_orders')}</p>
            }
        </Flexblock>
    </PageWide>

    <IndustryManufacturersReel manufacturers={manufacturers} />
</Viewport>