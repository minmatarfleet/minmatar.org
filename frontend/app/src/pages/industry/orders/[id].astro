---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { User } from '@dtypes/jwt'
import * as jose from 'jose'

const auth_token = Astro.cookies.has('auth_token') ? Astro.cookies.get('auth_token')?.value : false
const user = auth_token ? jose.decodeJwt(auth_token) as User : false

import { should_redirect_to_orders_onboarding } from '@helpers/onboarding/ordersRedirect'

if (auth_token && user) {
    if (await should_redirect_to_orders_onboarding(auth_token as string)) {
        const return_to = encodeURIComponent(Astro.url.pathname + Astro.url.search)
        return Astro.redirect(`${translatePath('/industry/orders/onboarding/')}?return=${return_to}`)
    }
}

import { HTTP_400_Bad_Request } from '@helpers/http_responses'
import { get_site_origin } from '@helpers/seo'
import { query_string } from '@helpers/string'

const order_id = parseInt(Astro.params.id ?? '0')
if (isNaN(order_id) || order_id <= 0)
    return HTTP_400_Bad_Request()

const order_code = String(order_id)

const page_title = t('industry.orders.detail.page_title').replace(
    '{code}',
    order_code,
)
const page_description = t('industry.orders.detail.leading_text')
const meta_title = t('industry.orders.detail.meta_title')
    .replace('{code}', order_code)
    .replace('{site}', t('index.page_title'))
const meta_description = t('industry.orders.detail.meta_description').replace(
    '{code}',
    order_code,
)
const site_origin = get_site_origin(Astro.url.origin)
const canonical_url = new URL(
    translatePath(`/industry/orders/${order_id}/`),
    site_origin,
).href
const meta_image = new URL('/images/industry-cover.jpg', site_origin).href

const HEADER_PARTIAL = translatePath(
    `/partials/order_detail_header_component?${query_string({
        order_id: String(order_id),
    })}`,
)
const PROFIT_PARTIAL = translatePath(
    `/partials/order_detail_profit_component?${query_string({
        order_id: String(order_id),
    })}`,
)
const BREAKDOWN_PARTIAL = translatePath(
    `/partials/order_breakdown_component?${query_string({
        order_id: String(order_id),
    })}`,
)

import Viewport from '@layouts/Viewport.astro'

import TextBox from '@components/layout/TextBox.astro';

import PageWide from '@components/page/PageWide.astro'
import PageTitle from '@components/page/PageTitle.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'

import OrderDetailHeaderSkeleton from '@components/blocks/industry/OrderDetailHeaderSkeleton.astro'
import OrderDetailSectionSkeleton from '@components/blocks/industry/OrderDetailSectionSkeleton.astro'
import LazyPartial from '@components/blocks/LazyPartial.astro'

// Once a section's partial answers (or fails), hide its skeleton. The metrics
// partial also fills the chart section out of band.
const clear_stack = (id: string) =>
    `document.getElementById('${id}-stack')?.classList.remove('is-loading'); document.getElementById('${id}')?.setAttribute('aria-busy', 'false')`
const breadcrumbs = [
    { page_title: t('market.page_title'), accumulated_path: translatePath('/market/') },
    { page_title: t('industry.orders.page_title'), accumulated_path: translatePath('/industry/orders/') },
    { page_title: page_title, accumulated_path: Astro.url.pathname },
]
---

<Viewport
    title={meta_title}
    meta_description={meta_description}
    meta_image={meta_image}
    canonical_url={canonical_url}
    og_type="article"
    components={{
        alert_dialog: true,
        tippy: true,
    }}
>
    <PageWide
        wide={true}
        cover={{
            image: '/images/industry-cover.jpg',
            image_990: '/images/industry-cover.jpg',
            animated: false,
            scrollable: true,
            overlay: true,
        }}
        breadcrumbs={breadcrumbs}
    >
        <FlexInline slot="header" justification='space-between' class="[ w-full ]">
            <FlexInline>
                <PageTitle>
                    {page_title}
                </PageTitle>
            </FlexInline>
        </FlexInline>

        
        <Flexblock gap="var(--space-xl)">
            <TextBox>
                <p class="[ excerpt ]">{page_description}</p>
            </TextBox>

            <Flexblock
                gap="var(--space-l)"
                class="[ w-full ]"
                id="order-detail-body"
                data-order-detail-deferred="1"
            >
                <LazyPartial
                    id="order-detail-header-slot"
                    url={HEADER_PARTIAL}
                >
                    <OrderDetailHeaderSkeleton />
                </LazyPartial>

                <div
                    id="order-detail-metrics-stack"
                    class="[ order-detail-deferred-stack is-loading w-full ]"
                >
                    <LazyPartial
                        id="order-detail-metrics"
                        class="[ order-detail-deferred-content w-full ]"
                        url={PROFIT_PARTIAL}
                        after_request={`${clear_stack('order-detail-metrics')}; ${clear_stack('order-detail-chart')}`}
                    >
                    </LazyPartial>
                    <OrderDetailSectionSkeleton section="metrics" />
                </div>

                <div
                    id="order-detail-assignments-stack"
                    class="[ order-detail-deferred-stack is-loading w-full ]"
                >
                    <LazyPartial
                        id="order-detail-assignments"
                        class="[ order-detail-deferred-content w-full ]"
                        url={BREAKDOWN_PARTIAL}
                        after_request={clear_stack('order-detail-assignments')}
                    >
                    </LazyPartial>
                    <OrderDetailSectionSkeleton section="assignments" />
                </div>

                <div
                    id="order-detail-chart-stack"
                    class="[ order-detail-deferred-stack is-loading w-full ]"
                >
                    <div
                        id="order-detail-chart"
                        class="[ order-detail-deferred-content w-full ]"
                        aria-busy="true"
                        aria-live="polite"
                    >
                    </div>
                    <OrderDetailSectionSkeleton section="chart" />
                </div>
            </Flexblock>
        </Flexblock>
    </PageWide>
</Viewport>

<style lang="scss">
    .order-detail-meta {
        flex-wrap: wrap;
        gap: var(--space-s);
    }

    .order-detail-meta__contractor {
        flex: 1 1 auto;
        min-width: 0;
    }

    .order-detail-meta__actions {
        flex-wrap: wrap;
    }

    .order-detail-meta__aside {
        flex-shrink: 0;
        text-align: right;
    }

    .order-detail-deferred-stack {
        min-width: 0;
        position: relative;
    }

    h3 {
        font-size: var(--step-1);
    }
</style>
