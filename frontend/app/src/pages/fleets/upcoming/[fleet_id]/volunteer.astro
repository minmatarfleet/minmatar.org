---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_404_Not_Found, HTTP_403_Forbidden } from '@helpers/http_responses'

import type { User } from '@dtypes/jwt'
import * as jose from 'jose'

const auth_token = Astro.cookies.has('auth_token') ? Astro.cookies.get('auth_token')?.value as string : false
const user: User | false = auth_token ? (jose.decodeJwt(auth_token) as User) : false

if (!user) return Astro.redirect(`${translatePath('/redirects/auth_init')}?redirect_url=${encodeURIComponent(Astro.url.toString())}`)

const fleet_id = parseInt(Astro.params?.fleet_id ?? '')
if (isNaN(fleet_id)) return HTTP_404_Not_Found()

import type { SummaryCharacter } from '@dtypes/api.minmatar.org'
import type { FleetUI } from '@dtypes/layout_components'
import { get_characters_summary_sorted } from '@helpers/fetching/characters'
import { fetch_fleet_by_id } from '@helpers/fetching/fleets'
import {
    get_fleet_role_volunteers,
    get_fleet_ship_volunteers,
    get_fleet_composition,
    get_fleet_refits,
    type FleetRoleVolunteer,
    type FleetShipVolunteer,
    type FleetCompositionEntry,
    type FleetRefit,
    type FleetSupply,
} from '@helpers/api.minmatar.org/fleets'
import { get_user_character } from '@helpers/fetching/characters'
import { fetch_fleet_supply, EMPTY_SUPPLY } from '@helpers/fleet_ships'

let fleet: FleetUI | null = null
let pilots: SummaryCharacter[] = []
let volunteers: FleetRoleVolunteer[] = []
let ship_volunteers: FleetShipVolunteer[] = []
let composition: FleetCompositionEntry[] = []
let refits: FleetRefit[] = []
let supply: FleetSupply = EMPTY_SUPPLY
let is_fleet_commander = false
let fetch_error: Error | false = false

try {
    fleet = await fetch_fleet_by_id(auth_token as string, fleet_id)
    const history = Boolean(fleet?.tracking?.end_time)

    if (history) return Astro.redirect(translatePath(`/fleets/upcoming/${fleet_id}`))
} catch (error) {
    if (error.message?.includes('403')) return HTTP_403_Forbidden()
    if (error.message?.includes('404')) return HTTP_404_Not_Found()
    fetch_error = error
}

if (fleet) {
    try {
        const summary = await get_characters_summary_sorted(auth_token as string)
        pilots = summary.characters ?? []
        volunteers = await get_fleet_role_volunteers(auth_token as string, fleet_id)
        const [fetched_composition, fetched_ship_volunteers, fetched_refits, fetched_supply] = await Promise.all([
            get_fleet_composition(auth_token as string, fleet_id),
            get_fleet_ship_volunteers(auth_token as string, fleet_id),
            get_fleet_refits(auth_token as string, fleet_id),
            fetch_fleet_supply(auth_token as string, fleet_id),
        ])
        composition = fetched_composition
        ship_volunteers = fetched_ship_volunteers
        refits = fetched_refits
        supply = fetched_supply
        const user_character = await get_user_character(user.user_id)
        is_fleet_commander = user_character?.character_id === fleet.fleet_commander_id
    } catch (error) {
        fetch_error = error
    }
}

import { query_string } from '@helpers/string';
const FLEET_ROLES_PARTIAL_URL = translatePath(`/partials/fleet_role_component?${query_string({
    fleet_id: fleet_id,
    readonly: false,
})}`)

import Viewport from '@layouts/Viewport.astro'

import PageDefault from '@components/page/PageDefault.astro'
import PageActions from '@components/page/PageActions.astro'
import PageTitle from '@components/page/PageTitle.astro'

import FlexInline from '@components/compositions/FlexInline.astro'
import Flexblock from '@components/compositions/Flexblock.astro'


import Button from '@components/blocks/Button.astro'
import FleetRoles from '@components/blocks/FleetRoles.astro'
import FleetShips from '@components/blocks/FleetShips.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import PilotBadge from '@components/blocks/PilotBadge.astro'
import Breadcrumb from '@components/blocks/Breadcrumb.astro'
import FleetManageMenu from '@components/blocks/FleetManageMenu.astro'

const page_title = t('fleets.volunteer.page_title').replace('{fleet_id}', fleet_id.toString())
const breadcrumb_items = [
    { label: t('fleets'), href: translatePath('/fleets/upcoming/') },
    { label: t('upcoming_fleets_short'), href: translatePath('/fleets/upcoming/') },
    { label: `${t('fleet')} ${fleet_id}`, href: translatePath(`/fleets/upcoming/${fleet_id}`) },
    { label: t('fleet_actions_volunteer') },
]
---

<Viewport
    title={page_title}
    components={{
        alert_dialog: true,
    }}
>
    <PageDefault
        cover={{
            image: '/images/fleets-cover.jpg',
            image_990: '/images/fleets-cover.jpg',
            animated: false,
            scrollable: true,
            overlay: true,
        }}
    >
        <FlexInline slot="header" justification="space-between" class="[ w-full ]">
            <Flexblock id="header-oob" gap="var(--space-3xs)">
                <Breadcrumb items={breadcrumb_items} />
                <PageTitle>{page_title}</PageTitle>
            </Flexblock>
            <PageActions>
                {fleet?.fleet_commander_id &&
                    <PilotBadge
                        character_id={fleet.fleet_commander_id}
                        character_name={fleet.fleet_commander_name}
                        size={32}
                        centered={true}
                    >
                        <small>{t('fleet_commander')}</small>
                    </PilotBadge>
                }
                {fleet && is_fleet_commander &&
                    <FleetManageMenu fleet={fleet} />
                }
            </PageActions>
        </FlexInline>


        {fetch_error ?
            <ErrorRefetch
                args={{
                    partial: FLEET_ROLES_PARTIAL_URL,
                    error: fetch_error,
                    delay: 0,
                }}
            />
            :
            <Flexblock gap='var(--space-2xl)'>
                <FleetRoles
                    volunteers={volunteers}
                    pilots={pilots}
                    fleet_id={fleet_id}
                    readonly={false}
                    is_fleet_commander={is_fleet_commander}
                />

                <FleetShips
                    fleet_id={fleet_id}
                    composition={composition}
                    volunteers={ship_volunteers}
                    refits={refits}
                    pilots={pilots}
                    supply={supply}
                    readonly={false}
                    can_manage={is_fleet_commander}
                    doctrine_name={fleet?.doctrine?.name ?? null}
                />
            </Flexblock>
        }
    </PageDefault>
</Viewport>

<style is:global>
    .volunteer-remove-btn {
        font-family: var(--button-font);
        font-weight: 600;
        font-size: var(--step--2);
        padding: var(--space-3xs) var(--space-2xs);
        border: solid 1px var(--fleet-red);
        color: var(--fleet-yellow);
        background-color: var(--fleet-red);
        border-radius: 2px;
        cursor: pointer;
        transition: var(--fast-transition);
    }
    .volunteer-remove-btn:hover { filter: brightness(1.1); }
    .volunteer-remove-btn:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--fleet-yellow); }
</style>
