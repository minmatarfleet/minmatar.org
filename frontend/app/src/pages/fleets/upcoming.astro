---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden, login_redirect, login_url } from '@helpers/http_responses'

import { get_request_user } from '@helpers/request_user'

const { auth_token, user } = get_request_user(Astro)

if (!user) return login_redirect(Astro)

import { get_gates, can } from '@helpers/gates'
const gates = await get_gates(Astro)

const can_add_fleets = can(gates, 'fleets.create')
const can_view_fleets = can(gates, 'fleets.view')

if (!can_view_fleets)
    return HTTP_403_Forbidden()

import type { Alert } from '@dtypes/layout_components'
import { parse_host_filter } from '@helpers/fleet_hosts'

const host_filter = parse_host_filter(Astro.url.searchParams.get('host'))

import { get_audiences } from '@helpers/api.minmatar.org/fleets'
import { invite_feedback_show_link } from '@helpers/fleet_invite_feedback'
import type { Audience } from '@dtypes/api.minmatar.org'

const show_feedback_link = can(gates, 'fleets.manage_any')
    ? await invite_feedback_show_link(auth_token as string).catch(() => false)
    : false

// Audiences are only used by the flash-form button, which only fleet creators
// see, so nobody else waits for them.
const audiences_promise = can_add_fleets ? get_audiences(auth_token as string) : null
audiences_promise?.catch(() => null)

const flash_form_error = Astro.cookies.has('flash_form_error') ? Astro.cookies.get('flash_form_error')?.value : false
if (Astro.cookies.has('flash_form_error')) Astro.cookies.delete('flash_form_error', { path: '/' })

const alert = !flash_form_error ? false : {
    title: t('flash_form'),
    content: flash_form_error
} as Alert

let audiences:Audience[] = []
let fetch_audiences_error: Error | false = false

try {
    audiences = audiences_promise ? await audiences_promise : []
} catch (error) {
    fetch_audiences_error = error
}

// The schedule loads after the page, behind a skeleton: the shell no longer
// waits for it. The partial also fades the cover to a live fleet's location.
const SCHEDULE_PARTIAL_URL = translatePath(`/partials/upcoming_fleets_initial_component/${host_filter !== 'all' ? `?host=${host_filter}` : ''}`)

const AUTH_REDIRECT_URL = login_url(Astro)

import { marked } from 'marked';
const AUTH_FLEET_SUBHINT = (marked.parseInline(t('authenticate_fleet_subhint')) as string)
    .replace(
        'AUTH_LINK', AUTH_REDIRECT_URL
    )

// The default cover; when a fleet is live, the schedule partial fades it to
// that fleet's location cover once the list has loaded.
const DEFAULT_COVER = '/images/fleets-cover.jpg'

import Viewport from '@layouts/Viewport.astro';

import PageWide from '@components/page/PageWide.astro';
import PageTitle from '@components/page/PageTitle.astro';
import FleetsHubTabs from '@components/blocks/FleetsHubTabs.astro';
import PageActions from '@components/page/PageActions.astro'

import Flexblock from '@components/compositions/Flexblock.astro';
import FlexInline from '@components/compositions/FlexInline.astro';

import LazyPartial from '@components/blocks/LazyPartial.astro';
import FleetScheduleSkeleton from '@components/blocks/FleetScheduleSkeleton.astro';
import Button from '@components/blocks/Button.astro';
import ShowAlert from '@components/blocks/ShowAlert.astro';
import FlashFormButton from '@components/blocks/FlashFormButton.astro'
import UpcomingFleetsUpdater from '@components/blocks/UpcomingFleetsUpdater.astro'

import AddIcon from '@components/icons/buttons/AddIcon.astro';

const page_title = t('fleets.upcoming.page_title');
---

{alert && <ShowAlert alert={alert} /> }

<Viewport
    title={page_title}
    meta_description={t('page_finder.fleets.upcoming.meta_description')}
    components={{
        alert_dialog: true,
        confirm_dialog: true
    }}
>
    <PageWide
        cover={{
            video: undefined,
            video_thumb: undefined,
            image: DEFAULT_COVER,
            image_990: DEFAULT_COVER,
            animated: false,
            scrollable: true,
            overlay: true,
            align: 'left',
        }}
        x-data={`{
			show_fc_ranking: false,
            fleets_count: 0,
        }`}
        breadcrumbs={[{
            accumulated_path: '/fleets/upcoming/',
            page_title: page_title
        }]}
    >
        <FlexInline slot="header" justification='space-between' class="[ w-full ]">
            <FlexInline>
                <Flexblock gap="var(--space-3xs)">
                    <PageTitle>
                        {page_title}
                    </PageTitle>
                </Flexblock>
            </FlexInline>
            <PageActions>
                {can_add_fleets &&
                    <Button color={'green'} href={translatePath('/fleets/add/')}>
                        <AddIcon slot="icon" />
                        {t('schedule_fleet')}
                    </Button>
                    <>{!fetch_audiences_error && <FlashFormButton audiences={audiences} /> }</>
                }
            </PageActions>
        </FlexInline>

        <FleetsHubTabs active="upcoming" />

        {show_feedback_link &&
            <p class="[ invite-feedback-link ]">
                <a href={translatePath('/fleets/invite-feedback/results/')}>{t('fleets.invite_feedback.link')}</a>
            </p>
        }

        
        <UpcomingFleetsUpdater
            id="upcoming-fleets"
            refresh_rate_seconds={240}
            current_cover={DEFAULT_COVER}
        >
            <LazyPartial url={SCHEDULE_PARTIAL_URL} swap="outerHTML">
                <FleetScheduleSkeleton />
            </LazyPartial>
        </UpcomingFleetsUpdater>
	</PageWide>
</Viewport>

<style lang="scss">
    .invite-feedback-link {
        margin: 0;

        a {
            color: var(--highlight);
        }
    }
</style>
