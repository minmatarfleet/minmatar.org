---
import { i18n } from '@helpers/i18n'
const { t, translatePath, lang } = i18n(Astro.url)

import { HTTP_403_Forbidden, login_redirect } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'
import { get_gates, can } from '@helpers/gates'

const { auth_token, user } = get_request_user(Astro)
if (!auth_token || !user) return login_redirect(Astro)

const gates = await get_gates(Astro)
if (!can(gates, 'fleets.npsi_sources.manage')) return HTTP_403_Forbidden()

import type { NpsiSourceListing } from '@helpers/api.minmatar.org/npsi_sources'
import { get_npsi_source_listing } from '@helpers/api.minmatar.org/npsi_sources'
import { query_string } from '@helpers/string'

let list: NpsiSourceListing = { sources: [], audiences: [] }
let data_fetching_error: Error | false = false

try {
    list = await get_npsi_source_listing(auth_token)
} catch (error) {
    if (error?.cause === 403) return HTTP_403_Forbidden()
    data_fetching_error = error
}

const page_title = t('manage.npsi.title')
const list_url = translatePath(`/partials/npsi_sources_component/?${query_string({ part: 'list', new: '1' })}`)

import Viewport from '@layouts/Viewport.astro'
import PageLanding from '@components/page/PageLanding.astro'
import PageBreadcrumbs from '@components/page/PageBreadcrumbs.astro'
import Flexblock from '@components/compositions/Flexblock.astro'

import Button from '@components/blocks/Button.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import ManageHero from '@components/blocks/manage/ManageHero.astro'
import NpsiSourcesManager from '@components/blocks/NpsiSourcesManager.astro'
---

<Viewport title={page_title} meta_description={t('page_finder.fleets.npsi_sources.description')}>
<PageLanding wide={true} lang={lang}>
    <Flexblock gap="var(--space-xl)">
        <Flexblock gap="var(--space-m)">
            <PageBreadcrumbs is_landing_page={true} links_only={true} breadcrumb_page_title={page_title} />
            <ManageHero title={page_title} role={t('manage.npsi.role')} fact={t('manage.npsi.fact')}>
                <Fragment slot="actions">
                    {!data_fetching_error &&
                        <Button
                            type="button"
                            hx-get={list_url}
                            hx-include="#npsi-filters"
                            hx-target="#npsi-list"
                            hx-select="#npsi-list"
                            hx-swap="outerHTML"
                        >
                            {t('manage.npsi.add')}
                        </Button>
                    }
                </Fragment>
            </ManageHero>
        </Flexblock>

        {data_fetching_error ?
            <div>
                <ErrorRefetch args={{ partial: translatePath('/partials/npsi_sources_component/?part=list'), error: data_fetching_error, delay: 0 }} />
            </div>
            :
            <NpsiSourcesManager list={list} />
        }
    </Flexblock>
</PageLanding>
</Viewport>
