---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_404_Not_Found, HTTP_403_Forbidden } from '@helpers/http_responses'

import type { User } from '@dtypes/jwt'
import * as jose from 'jose'

const user_agent = Astro.request.headers.get('user-agent')

const auth_token = Astro.cookies.has('auth_token') ? (Astro.cookies.get('auth_token')?.value as string) : false
const user:User | false = auth_token ? jose.decodeJwt(auth_token) as User : false
const is_superuser = (user ? user?.is_superuser : false)

if (!user) return Astro.redirect(`${translatePath('/redirects/auth_init')}?redirect_url=${Astro.url}`)

import { get_gates, can } from '@helpers/gates'
const gates = await get_gates(Astro)

const can_view_fleets = can(gates, 'fleets.view')

if (!can_view_fleets)
    return HTTP_403_Forbidden()

const fleet_id = parseInt(Astro.params.fleet_id ?? '0')

if (isNaN(fleet_id))
    return HTTP_404_Not_Found()

import type { FleetUI, FleetCombatLog } from '@dtypes/layout_components'
import type { EveCharacterProfile, FleetMetrics, FleetCommanderMetrics } from '@dtypes/api.minmatar.org'
import { fetch_fleet_by_id } from '@helpers/fetching/fleets'
import { get_user_character } from '@helpers/fetching/characters'
import { get_fleet_combatlogs } from '@helpers/fetching/combatlog'
import type { FleetKills, FleetSrpLoss } from '@helpers/api.minmatar.org/fleets'
import {
    get_fleets_metrics,
    get_fleet_commander_metrics,
    get_fleet_kills,
    get_fleet_my_srp,
} from '@helpers/api.minmatar.org/fleets'

let fetch_fleets_error: Error | false = false
let fleet:FleetUI | null = null
let user_character:EveCharacterProfile | null = null
let saved_logs:FleetCombatLog[] = []
let fleet_metrics: FleetMetrics | undefined
let fleet_commander_metrics: FleetCommanderMetrics | undefined

try {
    fleet = await fetch_fleet_by_id(auth_token as string, fleet_id)
    user_character = await get_user_character(user.user_id)

    const fleets_metrics = await get_fleets_metrics(auth_token as string)
    fleet_metrics = fleets_metrics.find(metric => metric.fleet_id === fleet_id)
    const fleet_commanders_metrics = await get_fleet_commander_metrics(auth_token as string)
    fleet_commander_metrics = fleet_commanders_metrics.find(metric => metric.primary_character_id === fleet?.fleet_commander_id)
} catch (error) {
    if (error.message === 'Error fetching fleet: HTTP error! Status: 403')
        return HTTP_403_Forbidden()
    
    fetch_fleets_error = error
}

try {
    saved_logs = user && !fetch_fleets_error ? await get_fleet_combatlogs(auth_token as string, fleet_id) : []
} catch (error) {
    console.log(error)
}

// Render the kills here: their styles only reach the page if the page renders
// FleetKills, since htmx drops the <link> a partial leads with.
let fleet_kills:FleetKills | null = null
let srp_losses:FleetSrpLoss[] | null = null

if (fleet?.tracking) {
    try {
        fleet_kills = await get_fleet_kills(auth_token as string, fleet_id)
    } catch (error) {
        // FleetDetails falls back to the partial, which retries and shows the error.
        console.log(error)
    }

    if (fleet_kills && can(gates, 'srp.resolve')) {
        try {
            srp_losses = await get_fleet_my_srp(auth_token as string, fleet_id)
        } catch (error) {
            console.log(`Skipping SRP losses: ${error.message}`)
        }
    }
}

const can_remove_fleet = can(gates, 'fleets.delete') ||
                         user_character?.character_id === fleet?.fleet_commander_id

const FLEET_DETAIL_PARTIAL_URL = translatePath(`/partials/fleet_detail_component?fleet_id=${fleet_id}&upcoming=${JSON.stringify(false)}`)

import {
    get_location_video_cover,
    get_location_video_cover_thumb,
    get_location_cover,
    get_location_cover_990,
} from '@helpers/covers'

import Viewport from '@layouts/Viewport.astro';

import PageWide from '@components/page/PageWide.astro';
import PageActions from '@components/page/PageActions.astro';
import PageTitle from '@components/page/PageTitle.astro';

import FlexInline from '@components/compositions/FlexInline.astro';

import FleetDetails from '@components/blocks/FleetDetails.astro';
import Button from '@components/blocks/Button.astro';
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro';

import AddIcon from '@components/icons/buttons/AddIcon.astro';
import FleetIcon from '@components/icons/buttons/FleetIcon.astro';

const page_title = fleet?.objective ? fleet.objective : `${t('fleet')} ${fleet_id}`;
const breadcrumbs = [
    { page_title: t('fleets'), accumulated_path: '/fleets/upcoming/' },
    { page_title: t('fleets.history.page_title'), accumulated_path: '/fleets/history/' },
    { page_title: page_title, accumulated_path: Astro.url.pathname },
]
---

<Viewport
    title={page_title}
    components={{
        alert_dialog: true,
        confirm_dialog: true,
    }}
>
    <PageWide
        cover={{
            video: get_location_video_cover(fleet?.location ?? '') ?? undefined,
            video_thumb: get_location_video_cover_thumb(fleet?.location ?? '') ?? undefined,
            image: get_location_cover(fleet?.location ?? '') ?? '/images/fleets-cover.jpg',
            image_990: get_location_cover_990(fleet?.location ?? '') ?? '/images/fleets-cover.jpg',
            animated: false,
            scrollable: true,
            overlay: true,
            align: get_location_video_cover(fleet?.location ?? '') ? 'right' : 'left',
        }}
        breadcrumbs={breadcrumbs}
    >
        <FlexInline slot="header" justification='space-between' class="[ w-full ]">
            <FlexInline>
                <PageTitle>
                    {page_title}
                </PageTitle>
            </FlexInline>
            <PageActions>
                <Button href={translatePath('/fleets/history/')}>
                    <FleetIcon slot="icon" />
                    {t('fleet_history')}
                </Button>
                <Button color={'green'} href={translatePath('/fleets/add/')}>
                    <AddIcon slot="icon" />
                    {t('schedule_fleet')}
                </Button>
            </PageActions>
        </FlexInline>

        {fetch_fleets_error ?
            <ErrorRefetch
                args={{
                    partial: FLEET_DETAIL_PARTIAL_URL,
                    error: fetch_fleets_error,
                    delay: 0,
                }}
            />
            :
            <FleetDetails
                fleet={fleet as FleetUI }
                history={true}
                can_remove_fleet={can_remove_fleet}
                saved_logs={saved_logs}
                pilots={[]}
                update_cover={false}
                fleet_metrics={fleet_metrics}
                fleet_commander_metrics={fleet_commander_metrics}  
                fleet_kills={fleet_kills}
                srp_losses={srp_losses}
            />
        }
    </PageWide>
</Viewport>