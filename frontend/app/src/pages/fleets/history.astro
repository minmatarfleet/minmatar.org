---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden, login_redirect, login_url } from '@helpers/http_responses'

import { get_request_user } from '@helpers/request_user'

const { auth_token, user } = get_request_user(Astro)

if (!user) return login_redirect(Astro)

import { get_gates, can } from '@helpers/gates'
const gates = await get_gates(Astro)

const can_add_fleets = can(gates, 'fleets.create')
const can_view_fleets = can(gates, 'fleets.view')

if (!can_view_fleets)
    return HTTP_403_Forbidden()

import { fetch_fleet_history, type FleetHistory } from '@helpers/fetching/fleet_schedule'

// /fleets/history/?group=<id>: one tribe group's fleets (the group page links here).
const group_param = parseInt(Astro.url.searchParams.get('group') ?? '')
const host_group_id = Number.isFinite(group_param) && group_param > 0 ? group_param : null

let fetch_fleets_error: Error | false = false
let history: FleetHistory | null = null

try {
    history = await fetch_fleet_history(auth_token as string, host_group_id)
} catch (error) {
    fetch_fleets_error = error
}

const fleets = history?.tracked ?? []

// The chip names the group from its fleets; with none in the list it falls back to a generic label.
const filter_group = host_group_id === null ? null :
    [ ...(history?.tracked ?? []), ...(history?.untracked ?? []) ]
        .map(fleet => fleet.host_group)
        .find(group => group?.id === host_group_id) ?? null
const filter_group_name = filter_group?.name ?? t('fleets.host.group_fallback')

const FLEET_LIST_PARTIAL_URL = translatePath(`/partials/fleet_list_component?upcoming=${JSON.stringify(false)}${host_group_id ? `&group=${host_group_id}` : ''}`)

const AUTH_REDIRECT_URL = login_url(Astro)

import { marked } from 'marked';
const AUTH_FLEET_SUBHINT = (marked.parseInline(t('authenticate_fleet_subhint')) as string)
    .replace(
        'AUTH_LINK', AUTH_REDIRECT_URL
    )

const count_text = t(fleets.length !== 1 ? 'fleets_in_the_past_30_days_plural' : 'fleets_in_the_past_30_days_singular')
    .replace('{count}', String(fleets.length))

import Viewport from '@layouts/Viewport.astro';

import PageWide from '@components/page/PageWide.astro';
import PageTitle from '@components/page/PageTitle.astro';
import FleetsHubTabs from '@components/blocks/FleetsHubTabs.astro';
import PageActions from '@components/page/PageActions.astro';

import Flexblock from '@components/compositions/Flexblock.astro';
import FlexInline from '@components/compositions/FlexInline.astro';

import FleetHistoryList from '@components/blocks/FleetHistoryList.astro';
import Button from '@components/blocks/Button.astro';
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro';
import FleetHistoryGroupFilter from '@components/blocks/FleetHistoryGroupFilter.astro';

import AddIcon from '@components/icons/buttons/AddIcon.astro';


const page_title = t('fleets.history.page_title');
const page_description = t('page_finder.fleets.history.description');
---

<Viewport title={page_title} meta_description={page_description}>
    <PageWide
        cover={{
            image: "/images/fleets-cover.jpg",
            image_990: "/images/fleets-cover.jpg",
            animated: false,
            scrollable: true,
            overlay: true
        }}
        x-data={`{
            fleets_count: ${fleets.length}
        }`}
        breadcrumbs={[{
            accumulated_path: '/fleets/upcoming/',
            page_title: page_title
        }]}
    >
        <FlexInline slot="header" justification='space-between' class="[ w-full ]">
            <FlexInline>
                <Flexblock gap="var(--space-3xs)">
                    <PageTitle>
                        {page_title}
                    </PageTitle>
                    <small id="count-text-oob">{count_text}</small>
                </Flexblock>
            </FlexInline>
            <PageActions>
                {can_add_fleets &&
                    <Button color={'green'} href={translatePath('/fleets/add/')}>
                        <AddIcon slot="icon" />
                        {t('schedule_fleet')}
                    </Button>
                }
            </PageActions>
        </FlexInline>

        <FleetsHubTabs active="history" />        
        
        <Flexblock gap='var(--space-xl)'>
            {host_group_id !== null &&
                <FleetHistoryGroupFilter
                    group_name={filter_group_name}
                    group={filter_group}
                    remove_href={translatePath('/fleets/history/')}
                />
            }

            {fetch_fleets_error ?
                <ErrorRefetch
                    args={{
                        partial: FLEET_LIST_PARTIAL_URL,
                        error: fetch_fleets_error,
                        delay: 0,
                    }}
                />
                :
                <FleetHistoryList
                    history={history as FleetHistory}
                />
            }
        </Flexblock>
	</PageWide>
</Viewport>