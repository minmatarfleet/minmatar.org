---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden, login_redirect } from '@helpers/http_responses'

import { get_request_user } from '@helpers/request_user'

const { auth_token, user } = get_request_user(Astro)

if (!user) return login_redirect(Astro)

import { get_gates, can } from '@helpers/gates'
const gates = await get_gates(Astro)
const can_view_page = can(gates, 'fleets.create')

if (!can_view_page) return HTTP_403_Forbidden()

import type { SummaryCharacter } from '@dtypes/api.minmatar.org'
import { get_characters_summary_sorted } from '@helpers/fetching/characters'

let pilots: SummaryCharacter[] = []
let fetch_error: Error | false = false

try {
    const summary = await get_characters_summary_sorted(auth_token as string)
    pilots = summary.characters ?? []
} catch (error) {
    fetch_error = error
}

const FLET_START_PARTIAL_URL = translatePath('/partials/fleet_start_component/')

import Viewport from '@layouts/Viewport.astro'

import PageDefault from '@components/page/PageDefault.astro'
import PageTitle from '@components/page/PageTitle.astro'

import TextBox from '@components/layout/TextBox.astro'

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'

import Button from '@components/blocks/Button.astro'
import FleetIcon from '@components/icons/buttons/FleetIcon.astro'
import StartFleet from '@components/blocks/StartFleet.astro';
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro';

const page_title = t('fleets.start.page_title')
---

<Viewport
    title={page_title}
    components={{
        alert_dialog: true,
    }}
>
    <PageDefault
        cover={{
            image: '/images/fleets-cover.jpg',
            image_990: '/images/fleets-cover.jpg',
            animated: false,
            scrollable: true,
            overlay: true,
        }}
    >
        <FlexInline slot="header" justification="space-between" class="[ w-full ]">
            <PageTitle>{page_title}</PageTitle>
            <Button href={translatePath('/fleets/upcoming/')}>
                <FleetIcon slot="icon" />
                {t('upcoming_fleets')}
            </Button>
        </FlexInline>

        <Flexblock gap="var(--space-xl)">
            <TextBox>
                <p class="[ excerpt ]">{t('fleets.start.choose_character')}</p>
            </TextBox>

            <div
                id="fleet-start"
            >
                {fetch_error ?
                    <ErrorRefetch
                        args={{
                            partial: FLET_START_PARTIAL_URL,
                            error: fetch_error,
                            delay: 0,
                        }}
                    /> :
                    pilots.length > 0 ?
                        <StartFleet pilots={pilots} /> :
                        <p>{t('no_pilots_to_show')}</p>
                }
            </div>
        </Flexblock>
    </PageDefault>
</Viewport>
