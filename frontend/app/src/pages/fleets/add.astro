---
import { i18n } from '@helpers/i18n'
import { eve_day, eve_clock } from '@helpers/date'
const { lang, t, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden, login_redirect } from '@helpers/http_responses'

import type { User } from '@dtypes/jwt'
import { get_request_user } from '@helpers/request_user'

const { auth_token, user } = get_request_user(Astro)

if (!user) return login_redirect(Astro)

import { get_gates, can } from '@helpers/gates'
const gates = await get_gates(Astro)

const can_create_alliance_fleets = can(gates, 'fleets.create')

import { get_publishable_groups } from '@helpers/api.minmatar.org/tribes'
import type { PublishableGroup } from '@dtypes/api.minmatar.org'

// Tribe groups this pilot can schedule fleets for. None (or an error) keeps
// today's form; a group publisher without fleets.create gets the groups only.
let host_groups:PublishableGroup[] = []
try {
    host_groups = await get_publishable_groups(auth_token as string, 'fleet')
} catch (error) {
    console.log(`Skipping fleet host groups: ${error.message}`)
}

const can_view_page = can_create_alliance_fleets || host_groups.length > 0

if (!can_view_page)
    return HTTP_403_Forbidden()

import { create_fleet, get_audiences, get_locations, start_fleet } from '@helpers/api.minmatar.org/fleets'
import type { FleetRequest, FleetTypes, Audience, Location, CampaignListItem } from '@dtypes/api.minmatar.org'
import { ALLIANCE_HOST, fleet_host_fields, parse_host_param, ping_preview_request, tribe_group_path } from '@helpers/fleet_hosts'
import { fetch_fleet_ping_preview, type FleetPingPreviewUI } from '@helpers/fetching/fleet_ping_preview'
import { AMAMAKE_LOCATION_ID } from '@helpers/market_ops_redirect'
import type { DoctrineType, CharacterBasic, Alert } from '@dtypes/layout_components'
import { send_active_fleet_notification } from '@helpers/notifications'

let create_fleet_error
let alert:Alert | false = false
// The host picked on a failed submit, so the re-rendered form keeps it.
let posted_host:string | null = null

if (Astro.request.method === "POST") {
    const data = await Astro.request.formData()
    const is_flash_form = data.get('flash_form')
    
    try {
        const doctrine = data.get('doctrine_id') as string
        const doctrine_id = doctrine !== '-1' ? parseInt(doctrine) : null
        console.log('1 - doctrine_id')
        console.log(doctrine_id)
        const start_time = is_flash_form ?
            new Date(new Date().getTime()) :
            new Date(`${data.get('eve_date')}T${data.get('eve_time')}Z`)

        // Absent when the FC has no campaigns to pick from, in which case the
        // fleet is simply scheduled without one.
        const campaign = data.get('campaign_id') as string | null
        const campaign_id = campaign && campaign !== '-1' ? parseInt(campaign) : null

        // Null when the form had no Host row: the request is then exactly today's.
        const host_fields = fleet_host_fields(data, host_groups)
        posted_host = data.get('host') as string | null
        const is_group_fleet = Boolean(host_fields?.host_group_id)

        const fleet_data = {
            doctrine_id: doctrine_id,
            campaign_id: campaign_id,
            description: data.get('description') as string,
            objective: data.get('objective') as string,
            start_time: start_time,
            type: data.get('fleet_type') as FleetTypes,
            // A group fleet has no audience (the API ignores it), but the field is required.
            audience_id: is_group_fleet ? 0 : parseInt(data.get('audience_id') as string),
            location_id: parseInt(data.get('location_id') as string),
            disable_motd: (data.get('disable_motd' as string) === 'on'),
            hide_volunteers: (data.get('hide_volunteers' as string) === 'on'),
            immediate_ping: false, //(data.get('immediate_ping' as string) === 'on'),
            ...(host_fields && is_group_fleet && host_fields),
        } as FleetRequest
        
        const new_fleet = await create_fleet(auth_token as string, fleet_data)

        if (!new_fleet?.id) {
            if (is_flash_form) {
                Astro.cookies.set('flash_form_error', t('flash_form_error'), { path: '/' })
                return Astro.redirect(translatePath('/fleets/upcoming'))
            }

            create_fleet_error = t('create_fleet_error')
        } else {
            try {
                let tracking_started = false
                
                if (data.get('start_tracking' as string) === 'on')
                    tracking_started = await start_fleet(auth_token as string, new_fleet?.id)

                if (tracking_started) send_active_fleet_notification(auth_token as string, new_fleet?.id)
            } catch (error) {
                const start_fleet_error = error.message
                Astro.cookies.set('fleet_tracking_error', start_fleet_error, { path: '/' })
            }

            return Astro.redirect(translatePath(`/fleets/upcoming/${new_fleet?.id}`))
        }
    } catch (error) {
        if (is_flash_form) {
            Astro.cookies.set('flash_form_error', t('flash_form_error'), { path: '/' })
            return Astro.redirect(translatePath('/fleets/upcoming'))
        }

        create_fleet_error = error.message
    }

    alert = {
        title: t('create_fleet_dialog_title'),
        content: create_fleet_error,
    }
}

import { get_user_character } from '@helpers/fetching/characters'
import { fetch_doctrine_options } from '@helpers/fetching/doctrines'
import { fetch_campaign_options } from '@helpers/fetching/campaigns'

let doctrines:DoctrineType[] = []
let campaigns:CampaignListItem[] = []
let fleet_commander:CharacterBasic | null = null
let fetch_doctrines_error: Error | false = false
let audiences:Audience[] = []
let locations:Location[] = []

try {
    const user_profile = await get_user_character((user as User).user_id)

    if (!user_profile)
        throw new Error(t('not_valid_character'), { cause: 400 })

    fleet_commander = {
        character_id: user_profile.character_id,
        character_name: user_profile.character_name,
    }

    doctrines = await fetch_doctrine_options()
    audiences = await get_audiences(auth_token as string)
    locations = await get_locations(auth_token as string)
    // Never fatal: swallows its own errors and answers [] instead.
    campaigns = await fetch_campaign_options(auth_token as string)
} catch (error) {
    fetch_doctrines_error = error
}

// A campaign page links here with its id so the picker opens on that campaign.
const preselected_campaign = parseInt(Astro.url.searchParams.get('campaign_id') ?? '')
const default_campaign_id = Number.isFinite(preselected_campaign) ? preselected_campaign : null

const FLEET_FORM_PARTIAL_URL = translatePath('/partials/fleet_form_component')

// `?host=<group_id>` (the group page's New fleet) opens the form on that group,
// and Cancel goes back to the group's Fleets tab.
const host_param = parse_host_param(Astro.url.searchParams.get('host'), host_groups)
const host_param_group = host_groups.find((group) => group.id === host_param) ?? null
const selected_host = posted_host ?? (
    host_param !== null ? String(host_param) :
    can_create_alliance_fleets ? ALLIANCE_HOST :
    String(host_groups[0]?.id ?? ALLIANCE_HOST)
)

const referer = Astro.request.headers.get('referer')
const same_site_referer = (() => {
    try {
        const url = referer ? new URL(referer) : null
        return url && url.origin === Astro.url.origin && url.pathname !== Astro.url.pathname ? `${url.pathname}${url.search}${url.hash}` : null
    } catch {
        return null
    }
})()
const cancel_href = host_groups.length === 0 ? null :
    host_param_group ? translatePath(tribe_group_path(host_param_group, 'fleets')) :
    same_site_referer ?? translatePath('/fleets/upcoming/')

// The start ping these defaults would send; the form re-renders it as fields change.
let ping_preview:FleetPingPreviewUI | null = null
if (host_groups.length > 0 && !fetch_doctrines_error) {
    const selected_group = host_groups.find((group) => String(group.id) === selected_host) ?? null
    const default_location = locations.find((location) => location.location_id === AMAMAKE_LOCATION_ID)
    const preview_form = new Map<string, string>([
        [ 'host', selected_host ],
        [ 'fleet_type', selected_group ? 'non_strategic' : 'strategic' ],
        [ 'location_id', String(default_location?.location_id ?? '') ],
        [ 'audience_id', audiences.length === 1 ? String(audiences[0].id) : '' ],
    ])
    ping_preview = await fetch_fleet_ping_preview(
        auth_token as string,
        ping_preview_request({ get: (name:string) => preview_form.get(name) ?? null }),
        selected_group?.tribe_id ?? null,
    )
}

import Viewport from '@layouts/Viewport.astro';

import PageDefault from '@components/page/PageDefault.astro';
import PageActions from '@components/page/PageActions.astro';
import PageTitle from '@components/page/PageTitle.astro';

import TextBox from '@components/layout/TextBox.astro';

import Flexblock from '@components/compositions/Flexblock.astro';
import FlexInline from '@components/compositions/FlexInline.astro';

import Button from '@components/blocks/Button.astro';
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro';

import HistoryIcon from '@components/icons/buttons/HistoryIcon.astro';
import FleetIcon from '@components/icons/buttons/FleetIcon.astro';
import FleetForm from '@components/blocks/FleetForm.astro'

const page_title = t('fleets.add.page_title');

const timer = Astro.url.searchParams.get('timer')
const eve_datetime = timer ? new Date(timer) : new Date()
eve_datetime.setMinutes(eve_datetime.getMinutes() + 15)

// The form labels these as EVE time, so both parts must come from UTC
const eve_date = eve_day(eve_datetime)
const eve_time = eve_clock(eve_datetime)
---

<Viewport
    title={page_title}
    components={{
        alert_dialog: true
    }}
>
    <PageDefault
        cover={{
            image: "/images/fleets-cover.jpg",
            image_990: "/images/fleets-cover.jpg",
            animated: false,
            scrollable: true,
            overlay: true
        }}
        x-data={`{
            init() {
                ${alert !== false ? `show_alert_dialog(${JSON.stringify(alert)})` : ''}
            }
        }`}
    >
        <FlexInline slot="header" justification='space-between' class="[ w-full ]">
            <FlexInline>
                <PageTitle>
                    {page_title}
                </PageTitle>
            </FlexInline>
            <PageActions>
                <Button href={translatePath('/fleets/upcoming/')}>
                    <FleetIcon slot="icon" />
                    {t('upcoming_fleets')}
                </Button>
                <Button href={translatePath('/fleets/history/')}>
                    <HistoryIcon slot="icon" />
                    {t('fleet_history')}
                </Button>
            </PageActions>
        </FlexInline>

        <Flexblock gap="var(--space-xl)">
            <TextBox><p>{t('fleets.add.page_leading_text')}</p></TextBox>

            {fetch_doctrines_error ?
                <ErrorRefetch
                    args={{
                        partial: `${FLEET_FORM_PARTIAL_URL}`,
                        error: fetch_doctrines_error,
                        delay: 0,
                    }}
                />
                :
                <FleetForm
                    audiences={audiences}
                    locations={locations}
                    doctrines={doctrines}
                    campaigns={campaigns}
                    default_campaign_id={default_campaign_id}
                    fleet_commander={fleet_commander as CharacterBasic}
                    eve_date={eve_date}
                    eve_time={eve_time}
                    disable_motd={false}
                    hide_volunteers={false}
                    lang={lang}
                    host_groups={host_groups}
                    selected_host={selected_host}
                    allow_alliance_host={can_create_alliance_fleets}
                    cancel_href={cancel_href}
                    ping_preview={ping_preview}
                />
            }
        </Flexblock>
	</PageDefault>
</Viewport>