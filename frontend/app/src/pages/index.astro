---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

// The homepage. (It was tried out at /landing-new, which now redirects here.)
import type { LandingPulse, LandingMoment, LandingWeek } from '@dtypes/api.minmatar.org'
import type { Alert, PostListUI } from '@dtypes/layout_components'
import { get_landing_pulse, get_landing_week } from '@helpers/api.minmatar.org/landing'
import { fetch_latest_published_posts, fetch_published_posts_tagged } from '@helpers/fetching/posts'
import { dedupe_posts, format_number, pick_premium_posts, week_last_column, WEEK_GRID, WEEK_LAST_LABELS } from '@helpers/landing'
import { get_latest_issue as get_latest_market_issue } from '@/data/amamake-market'
import { get_latest_issue as get_latest_warzone_issue } from '@/data/warzone'
import { t_key } from '@helpers/i18n'
import { post_page_path } from '@helpers/content_viewer'

// A failed EVE SSO login comes back here with an auth_error cookie: show it once.
const auth_error = Astro.cookies.get('auth_error')?.value ?? false
if (auth_error) Astro.cookies.delete('auth_error', { path: '/' })
const alert = auth_error ? { title: t('auth_error_dialog_title'), content: auth_error } as Alert : false

// The pulse, the week's tab counts (the rows load through the partial) and
// the news don't depend on each other, so fetch them together.
const [pulse_result, week_result, posts_result, videos_result, cope_result] = await Promise.allSettled([
    get_landing_pulse(),
    get_landing_week('fights', 1),
    fetch_latest_published_posts(16),
    // The premium series: the yearly review and The Cope are videos, older
    // Cope episodes sit under their own tag.
    fetch_published_posts_tagged('Videos', 50),
    fetch_published_posts_tagged('The Cope', 10),
])

const pulse: LandingPulse | null = pulse_result.status === 'fulfilled' ? pulse_result.value : null
const pulse_error: string | null = pulse_result.status === 'rejected'
    ? (pulse_result.reason instanceof Error ? pulse_result.reason.message : String(pulse_result.reason))
    : null
const week: LandingWeek | null = week_result.status === 'fulfilled' ? week_result.value : null
const WEEK_TABS = ['fights', 'kills', 'warzone', 'mining', 'industry'] as const
const week_tabs = WEEK_TABS.map((id) => ({
    id,
    label: t(t_key('landing_new.tab.', id)) ?? id,
    meta: week ? format_number(week.counts[id]) : undefined,
}))
const week_url = (tab:string) => translatePath(`/partials/landing_week_component/?tab=${tab}&page=1`)

const posts: PostListUI[] = posts_result.status === 'fulfilled' ? dedupe_posts(posts_result.value.chunk) : []

// The public post page (/posts/<id> is the editor). Cards open the post in
// the page's ContentViewer; the link stays for new tabs and no-JS.
// The hero's one button cycles through what a visitor can do here, every
// HERO_CTA_SECONDS, and holds still while hovered or focused.
const HERO_CTA_SECONDS = 4
// Each destination has its own colour, so the change reads at a glance.
const HERO_CTAS = [
    { label: t('landing_new.cta.corporation'), href: translatePath('/alliance/corporations/'), color: 'fleet-red' },
    { label: t('landing_new.cta.values'), href: translatePath('/alliance/values/'), color: 'militia-purple' },
    { label: t('landing_new.cta.discord'), href: 'https://discord.gg/minmatar', external: true, color: 'discord-blurple' },
    { label: t('landing_new.cta.market'), href: translatePath('/amamake-market/'), color: 'green' },
    { label: t('landing_new.cta.structures'), href: translatePath('/structures/'), color: 'alliance-blue' },
    { label: t('landing_new.cta.learn'), href: translatePath('/learning/'), color: 'tech-ii' },
]

const post_href = (post: PostListUI) => translatePath(post_page_path(post))
const post_image = (post: PostListUI, fallback: string) => post.image || fallback
// YouTube's maxresdefault is 1280px; the thumbnails here are a few hundred.
const post_thumb = (post: PostListUI, fallback: string) =>
    post_image(post, fallback).replace(/(\/\/i\.ytimg\.com\/vi\/[^/]+\/)maxresdefault\.jpg$/, '$1hqdefault.jpg')

// The hero cycles through our premium content: the year in review, the
// newest Cope, and the monthly economic and frontline reports. The news
// feed sits further down the page.
const series_posts = [videos_result, cope_result].flatMap((result) => result.status === 'fulfilled' ? result.value.chunk : [])
const premium_posts = pick_premium_posts(dedupe_posts(series_posts))
const month_label = (date: Date) =>
    `${date.toLocaleString('en-US', { month: 'long', timeZone: 'UTC' })} YC${date.getUTCFullYear() - 1898}`
const market_issue = get_latest_market_issue()
const warzone_issue = get_latest_warzone_issue()

type PremiumItem = { kicker: string, title: string, href: string, image: string, thumb: string, post_id?: number }
const premium_post_item = (kicker: string, post: PostListUI | undefined): PremiumItem[] => post ? [{
    kicker,
    title: post.title,
    href: post_href(post),
    image: post_image(post, '/images/videos-cover.jpg'),
    thumb: post_thumb(post, '/images/videos-cover.jpg'),
    post_id: post.post_id,
}] : []
const premium: PremiumItem[] = [
    ...premium_post_item(t('landing_new.premium.review'), premium_posts.review),
    ...premium_post_item(t('landing_new.premium.cope'), premium_posts.cope),
    {
        kicker: t('landing_new.premium.economic'),
        title: `${t('landing_new.premium.economic_title')} · ${month_label(market_issue.published_at)}`,
        href: translatePath('/amamake-market/'),
        image: market_issue.cover_image,
        thumb: market_issue.cover_image,
    },
    {
        kicker: t('landing_new.premium.frontline'),
        title: `${t('landing_new.premium.frontline_title')} · ${month_label(warzone_issue.published_at)}`,
        href: translatePath('/warzone/'),
        image: warzone_issue.cover_image,
        thumb: warzone_issue.cover_image,
    },
]
const LATEST_SECONDS = 7

const premium_ids = new Set(premium.map((item) => item.post_id).filter((id) => id !== undefined))
const more_news = posts.filter((post) => !premium_ids.has(post.post_id)).slice(0, 8)

const MOMENT_IMAGES: Record<string, string> = {
    record: '/images/videos-cover.jpg',
    comms: '/images/ceos.webp',
    warzone: '/images/propaganda-cover.jpg',
    fleet: '/images/fleets-cover.jpg',
}

const month_ago = Date.now() - 30 * 24 * 3600 * 1000
const reel_items = [
    ...(pulse?.moments ?? []).map((moment: LandingMoment) => ({
        kicker: t(t_key('landing_new.moment.', moment.kind)) ?? moment.kind,
        occurred_at: moment.occurred_at,
        title: moment.title,
        image: MOMENT_IMAGES[moment.kind] ?? '/images/alliance-cover.jpg',
        value: format_number(moment.value),
        unit: moment.unit,
    })),
    ...posts
        .filter((post) => new Date(post.date_posted).getTime() >= month_ago)
        .slice(0, 4)
        .map((post) => ({
            kicker: t('landing_new.moment.post'),
            occurred_at: post.date_posted,
            title: post.title,
            image: post_image(post, '/images/posts-cover.jpg'),
            href: post_href(post),
            post_id: post.post_id,
        })),
].sort((a, b) => new Date(b.occurred_at).getTime() - new Date(a.occurred_at).getTime())
 .slice(0, 8)

const PUBLICATIONS = [
    { name: 'Metropolis', image: '/images/icons/Metropolis.webp' },
    { name: 'Frontlines', image: '/images/icons/Frontlines.webp' },
    { name: 'Metro Daily News', image: '/images/icons/Metro-Daily-News.webp' },
    { name: 'The Cope', image: '/images/icons/The-Cope.webp' },
    { name: 'The Waifu Wars', image: '/images/icons/Waifu-Wars.webp' },
    { name: 'Rust and Blood', image: '/images/icons/Rust-and-Blood.webp' },
]

import Viewport from '@layouts/Viewport.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import Wrapper from '@components/compositions/Wrapper.astro'

import Button from '@components/blocks/Button.astro'
import ColorBlindPrompt from '@components/blocks/ColorBlindPrompt.astro'
import ContentViewer from '@components/blocks/ContentViewer.astro'
import ContentViewerLink from '@components/blocks/ContentViewerLink.astro'
import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import DataGridSkeleton from '@components/blocks/DataGridSkeleton.astro'
import EmptyState from '@components/blocks/EmptyState.astro'
import ShowAlert from '@components/blocks/ShowAlert.astro'
import LazyPartial from '@components/blocks/LazyPartial.astro'
import SectionTabPanel from '@components/blocks/SectionTabPanel.astro'
import SectionTabs from '@components/blocks/SectionTabs.astro'
import LandingBars from '@components/blocks/landing/LandingBars.astro'
import LandingLive from '@components/blocks/landing/LandingLive.astro'
import LandingReel from '@components/blocks/landing/LandingReel.astro'
---

<Viewport
    title={t('index.page_title')}
    meta_description={t('index.leading_text')}
    components={{
        alert_dialog: true,
    }}
>
    {alert && <ShowAlert alert={alert} />}
    <ColorBlindPrompt />
    <div class="landing">
        <section class="landing-hero">
            <img class="landing-hero__cover" src="/images/home-amamake-cover.jpg" alt="" />

            <Wrapper padding_inline="var(--landing-gutter)" padding_block="0" centered={true} class="[ landing-hero__inner ]">
                <div class="landing-hero__main">
                    <div class="landing-hero__pitch">
                        <p class="landing-eyebrow">{t('landing_new.eyebrow')}</p>
                        <h1>{t('landing_new.title_1')}<br />{t('landing_new.title_2')}</h1>
                        <p class="landing-hero__lead">{t('landing_new.lead')}</p>
                        <div
                            class="[ landing-actions landing-cta ]"
                            x-data={`{
                                ...landing_rotator(${HERO_CTAS.length}, ${HERO_CTA_SECONDS * 1000}),
                                items: ${JSON.stringify(HERO_CTAS)},
                                get item() { return this.items[this.index] },
                            }`}
                            x-on:mouseenter="pause(true)"
                            x-on:mouseleave="pause(false)"
                            x-on:focusin="pause(true)"
                            x-on:focusout="pause(false)"
                        >
                            <Button
                                href={HERO_CTAS[0].href}
                                class="[ landing-cta__button ]"
                                x-bind:href="item.href"
                                x-bind:target="item.external ? '_blank' : null"
                                x-bind:rel="item.external ? 'noopener noreferrer' : null"
                                x-bind:style="`--button_background_color: var(--${item.color}); --inner_button_color: var(--highlight)`"
                            >
                                <span
                                    class="[ landing-cta__label ]"
                                    x-text="item.label"
                                    x-effect="index; if (!still && $el.isConnected) $el.animate([{ opacity: 0, transform: 'translateY(0.25em)' }, { opacity: 1, transform: 'none' }], 250)"
                                >{HERO_CTAS[0].label}</span>
                            </Button>
                            <span class="[ landing-cta__bar ]" aria-hidden="true" x-show="!still"><span x-ref="bar"></span></span>
                        </div>
                    </div>
    
                    <aside
                        class="landing-latest"
                        aria-label={t('landing_new.premium')}
                        x-data={`landing_rotator(${premium.length}, ${LATEST_SECONDS * 1000})`}
                        x-on:mouseenter="pause(true)"
                        x-on:mouseleave="pause(false)"
                        x-on:focusin="pause(true)"
                        x-on:focusout="pause(false)"
                    >
                        <div class="landing-latest__header">
                            <h2>{t('landing_new.premium')}</h2>
                            <a href="#news">{t('landing_new.view_news')}</a>
                        </div>
                        {/* Every lead is rendered, stacked in one cell; the current one shows. */}
                        <div class="landing-latest__leads">
                            {premium.map((item, i) =>
                                <ContentViewerLink
                                    class:list={['landing-latest__lead', { 'is-current': i === 0 }]}
                                    href={item.href}
                                    post={item.post_id}
                                    title={item.title}
                                    x-bind:class={`{ 'is-current': index === ${i} }`}
                                    x-bind:tabindex={`index === ${i} ? null : -1`}
                                    x-bind:aria-hidden={`index === ${i} ? null : 'true'`}
                                    tabindex={i === 0 ? undefined : -1}
                                    aria-hidden={i === 0 ? undefined : 'true'}
                                >
                                    <img src={item.image} alt="" loading={i === 0 ? 'eager' : 'lazy'} />
                                    <span class="landing-latest__lead-copy">
                                        <span class="landing-latest__kicker">{item.kicker}</span>
                                        <span class="landing-latest__lead-title">{item.title}</span>
                                    </span>
                                </ContentViewerLink>
                            )}
                        </div>
                        <span class="[ landing-latest__bar ]" aria-hidden="true" x-show="!still && count > 1"><span x-ref="bar"></span></span>
                        {/* Up next: the rest, in the order they come round. */}
                        {premium.map((item, i) =>
                            <ContentViewerLink
                                class="landing-latest__row"
                                href={item.href}
                                post={item.post_id}
                                title={item.title}
                                x-show={`after(${i}) !== 0`}
                                x-bind:style={`{ order: after(${i}) }`}
                                style={i === 0 ? 'display: none;' : `order: ${i}`}
                            >
                                <img src={item.thumb} alt="" loading="lazy" />
                                <span>
                                    <span class="landing-latest__kicker">{item.kicker}</span>
                                    <span class="landing-latest__row-title">{item.title}</span>
                                </span>
                            </ContentViewerLink>
                        )}
                    </aside>
                </div>
    
                {pulse && <LandingLive events={pulse.events} view_all_href="#week" />}
    
                {pulse_error && <EmptyState title={t('landing_new.error')} hint={pulse_error} />}
            </Wrapper>
        </section>

        {reel_items.length > 0 &&
            <section class="landing-section">
                <Wrapper padding_inline="var(--landing-gutter)" padding_block="0" centered={true}>
                    <LandingReel items={reel_items} />
                </Wrapper>
            </section>
        }

        <section id="news" class="landing-section">
            <Wrapper padding_inline="var(--landing-gutter)" padding_block="0" centered={true}>
                <div class="landing-section__header">
                    <div>
                        <p class="landing-eyebrow">{t('landing_new.news_eyebrow')}</p>
                        <h2 class="landing-title">{t('landing_new.news_title')}</h2>
                    </div>
                    <a href={translatePath('/posts/')}>{t('landing_new.all_stories')}</a>
                </div>
                {more_news.length > 0 &&
                    <ol class="landing-news">
                        {more_news.map((post) =>
                            <li>
                                <ContentViewerLink href={post_href(post)} post={post.post_id} title={post.title}>
                                    <img src={post_thumb(post, '/images/series-cover.jpg')} alt="" loading="lazy" />
                                    <span class="landing-news__copy">
                                        <span class="landing-latest__kicker">{post.tags[0] ?? ''}</span>
                                        <span class="landing-news__title">{post.title}</span>
                                        <span class="landing-muted">{new Date(post.date_posted).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', timeZone: 'UTC' })}</span>
                                    </span>
                                </ContentViewerLink>
                            </li>
                        )}
                    </ol>
                }
                <nav class="landing-publications" aria-label={t('landing_new.publications')}>
                    <p class="landing-muted landing-eyebrow">{t('landing_new.publications')}</p>
                    <div>
                        {PUBLICATIONS.map((publication) =>
                            <a href={translatePath('/alliance/content/')}>
                                <img src={publication.image} alt={publication.name} loading="lazy" />
                            </a>
                        )}
                    </div>
                </nav>
            </Wrapper>
        </section>

        <section id="week" class="landing-section">
            <Wrapper padding_inline="var(--landing-gutter)" padding_block="0" centered={true}>
                <p class="landing-eyebrow">{t('landing_new.week_eyebrow')}</p>
                <h2 class="landing-title">{t('landing_new.week_title')}</h2>
                <SectionTabs tabs={week_tabs} aria_label={t('landing_new.week_title')} id_prefix="landing-week" default_tab="fights">
                    {WEEK_TABS.map((id) =>
                        <SectionTabPanel id={id} id_prefix="landing-week" is_default={id === 'fights'}>
                            <ComponentBlock padding_block="0" padding_inline="0" class="[ landing-week-panel ]">
                                <LazyPartial url={week_url(id)} swap="outerHTML" trigger={id === 'fights' ? 'load' : 'reveal'} indicator={false}>
                                    <DataGridSkeleton
                                        columns={[t('landing_new.week_time'), t('landing_new.week_what'), t(WEEK_LAST_LABELS[week_last_column(id)])]}
                                        template={WEEK_GRID.template}
                                        rows={WEEK_GRID.rows}
                                        media={[1]}
                                        numeric={[2]}
                                        min_width="0"
                                        variant="ledger"
                                        stack={true}
                                        pager={true}
                                        class="[ landing-week-grid ]"
                                    />
                                </LazyPartial>
                            </ComponentBlock>
                        </SectionTabPanel>
                    )}
                </SectionTabs>
            </Wrapper>
        </section>


        <section class="landing-section">
            <Wrapper padding_inline="var(--landing-gutter)" padding_block="0" centered={true} class="[ landing-join ]">
                <div class="landing-join__pitch">
                    <p class="landing-eyebrow">{t('landing_new.join_eyebrow')}</p>
                    <h2 class="landing-title">{t('landing_new.join_title')}</h2>
                    <p class="landing-join__lead">{t('landing_new.join_lead')}</p>
                    <FlexInline gap="var(--space-s)" class="[ landing-actions ]">
                        <Button href="https://discord.gg/minmatar" narrow={true} new_tab={true}>{t('landing_new.join_discord')}</Button>
                    </FlexInline>
                </div>
                {pulse &&
                    <div class="landing-join__chart">
                        <p class="landing-join__chart-title">
                            <span>{t('landing_new.tz_chart_title')}</span>
                            <span class="landing-muted">{t('landing_new.tz_chart_note')}</span>
                        </p>
                        <LandingBars
                            values={pulse.timezone_kills.map((h) => h.average_kills)}
                            hours={pulse.timezone_kills.map((h) => h.hour)}
                            label={t('landing_new.tz_chart_title')}
                            height="var(--space-3xl)"
                        />
                        <div class="landing-join__zones" aria-hidden="true">
                            <span>USTZ</span>
                            <span>AUTZ</span>
                            <span>EUTZ</span>
                        </div>
                    </div>
                }
            </Wrapper>
        </section>
    </div>

    <ContentViewer />
</Viewport>

<style lang="scss">
    // One gutter and one section rhythm for the whole page: the content sits
    // in an 80rem column (Wrapper), sections are --space-2xl-3xl apart.
    .landing {
        --landing-gutter: var(--space-2xl-3xl);

        background: var(--background);
        color: var(--fleet-yellow);
    }

    .landing-eyebrow {
        margin: 0 0 var(--space-2xs);
        font-size: var(--step--1);
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .landing-title {
        margin: 0 0 var(--space-xl);
        font-family: var(--heading-font);
        font-weight: normal;
        font-size: var(--step-4);
        line-height: 1;
        color: var(--highlight);
    }

    .landing-muted {
        color: var(--faded);
    }

    .landing-actions {
        margin-top: var(--space-l);
    }

    // The label fades in (x-effect) each time the button changes; the button
    // keeps one width (the longest label's) so nothing around it moves.
    .landing-cta__label {
        display: inline-block;
    }

    .landing-cta {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-3xs);
    }

    // The colour eases from one destination to the next.
    .landing-cta :global(.landing-cta__button) {
        transition: var(--slow-transition);
        min-inline-size: min(100%, calc(var(--space-3xl) * 3));

        @media (max-width: 48rem) {
            inline-size: 100%;
        }
    }

    // Fills while the current destination shows, then the next takes over.
    .landing-cta__bar {
        display: block;
        inline-size: min(100%, calc(var(--space-3xl) * 3));
        block-size: 2px;
        background: var(--border-color-hover);

        @media (max-width: 48rem) {
            inline-size: 100%;
        }

        span {
            display: block;
            block-size: 100%;
            background: var(--highlight);
            transform: scaleX(0);
            transform-origin: left;
        }
    }

    .landing-week-panel {
        overflow: hidden;
    }

    /* Hero: everything the page is for, inside the first screen. */
    .landing-hero {
        position: relative;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        padding-block: var(--space-xl) var(--space-2xl);
        overflow: hidden;

        > *:not(.landing-hero__cover) {
            position: relative;
        }
    }

    .landing-hero__inner {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xl);
    }

    .landing-hero__cover {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 60% 35%;
        mask-image: linear-gradient(180deg, var(--background) 45%, transparent 100%);
        opacity: 0.45;
    }

    .landing-hero__main {
        display: grid;
        grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
        gap: var(--space-xl);
        align-items: start;

        h1 {
            margin: 0;
            font-family: var(--heading-font);
            font-weight: normal;
            font-size: clamp(3.5rem, 7vw, 6rem);
            line-height: 0.95;
            color: var(--highlight);
        }
    }

    .landing-hero__lead {
        margin: var(--space-m) 0 0;
        max-width: 36rem;
        font-size: var(--step-1);
        line-height: 1.55;
        color: var(--highlight);
        opacity: 0.85;
    }

    .landing-latest {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
    }

    .landing-latest__header {
        order: -3;
        display: flex;
        justify-content: space-between;
        align-items: baseline;

        h2 {
            margin: 0;
            font-size: var(--step--1);
            font-weight: 600;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--highlight);
        }
    }

    // One cell for every lead, so a change never moves anything; the current
    // one fades in over the last.
    .landing-latest__leads {
        display: grid;
        order: -2;

        > :global(*) {
            grid-area: 1 / 1;
        }
    }

    .landing-latest__lead {
        opacity: 0;
        visibility: hidden;
        transition: opacity var(--slow-transition), visibility 0s linear 1s;

        &.is-current {
            opacity: 1;
            visibility: visible;
            transition: opacity var(--slow-transition), visibility 0s;
        }
    }

    .landing-latest__bar {
        display: block;
        order: -1;
        block-size: 2px;
        margin-top: calc(var(--space-xs) * -1);
        background: var(--border-color-hover);

        span {
            display: block;
            block-size: 100%;
            background: var(--fleet-yellow);
            transform: scaleX(0);
            transform-origin: left;
        }
    }

    .landing-latest__lead {
        position: relative;
        display: flex;
        align-items: flex-end;
        height: 15rem;
        overflow: hidden;
        text-decoration: none;

        img {
