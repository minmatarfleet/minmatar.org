---
import { i18n } from '@helpers/i18n'
const { t, translatePath, lang } = i18n(Astro.url)

import { HTTP_403_Forbidden, login_redirect } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'
import { get_gates, can } from '@helpers/gates'

const { auth_token, user } = get_request_user(Astro)
if (!auth_token || !user) return login_redirect(Astro)

const gates = await get_gates(Astro)
if (!can(gates, 'help_tickets.manage')) return HTTP_403_Forbidden()

import type { HelpSettings } from '@dtypes/api.minmatar.org'
import { get_help_settings } from '@helpers/api.minmatar.org/help_tickets'

let settings: HelpSettings | null = null
let data_fetching_error: Error | false = false

try {
    settings = await get_help_settings(auth_token)
} catch (error) {
    if (error?.cause === 403) return HTTP_403_Forbidden()
    data_fetching_error = error
}

const page_title = t('help_settings.page_title')
const PARTIAL_URL = translatePath('/partials/help_tickets_settings_component')

const shown = settings?.categories.filter(category => category.is_active).length ?? 0
const options_summary = settings ? t('admin_content.help.options_summary').replace('~COUNT', String(settings.categories.length)).replace('~SHOWN', String(shown)) : ''
const panel_summary = settings?.panel.channel_name
    ? t('admin_content.help.posted_in').replace('~CHANNEL', settings.panel.channel_name)
    : settings?.panel.channel_id && settings.panel.channel_id !== '0' ? t('admin_content.help.channel_unknown') : t('admin_content.help.no_channel')
const free_groups = settings?.tribe_groups.filter(group => !group.taken) ?? []

import Viewport from '@layouts/Viewport.astro'
import PageLanding from '@components/page/PageLanding.astro'
import PageBreadcrumbs from '@components/page/PageBreadcrumbs.astro'

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'

import Button from '@components/blocks/Button.astro'
import DialogButton from '@components/blocks/DialogButton.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import Input from '@components/blocks/Input.astro'
import ManageField from '@components/blocks/manage/ManageField.astro'
import ManageHero from '@components/blocks/manage/ManageHero.astro'
import Select from '@components/blocks/Select.astro'
import SettingsSection from '@components/blocks/manage/SettingsSection.astro'
---

<Viewport title={page_title} meta_description={t('page_finder.help_tickets.description')}>
<PageLanding wide={true} lang={lang}>
    <Flexblock gap="var(--space-xl)">
        <Flexblock gap="var(--space-m)">
            <PageBreadcrumbs is_landing_page={true} links_only={true} />
            <ManageHero title={page_title} role={t('admin_content.help.role')} fact={t('admin_content.help.fact')}>
                {settings &&
                    <Fragment slot="actions">
                        <DialogButton color="fleet-red" size="lg" max_width="32rem">
                            {t('admin_content.help.add')}
                            <form
                                slot="dialog"
                                class="[ manage-form ]"
                                hx-post={PARTIAL_URL}
                                hx-target="#help-options-body"
                                hx-select="#help-options-body"
                                hx-swap="outerHTML"
                                x-data="{ submitting: false }"
                                {...{
                                    'x-on:htmx:before-request': 'submitting = true; $refs.error.textContent = ""',
                                    'x-on:htmx:after-request': `submitting = false; if ($event.detail.successful) { $el.reset(); close_dialog() } else $refs.error.textContent = $event.detail.xhr.responseText.replace(/<[^>]*>/g, '').trim() || ${JSON.stringify(t('manage.kit.confirm_failed'))}`,
                                }}
                            >
                                <input type="hidden" name="action" value="create" />
                                <h3>{t('admin_content.help.add')}</h3>
                                <ManageField label={t('help_settings.field.title')} for="help-option-new-title">
                                    <Input id="help-option-new-title" type="text" name="title" required maxlength="100" autocomplete="off" />
                                </ManageField>
                                <ManageField label={t('help_settings.field.owner')} for="help-option-new-owner" hint={t('admin_content.help.owner_hint')}>
                                    <Select id="help-option-new-owner" name="tribe_group_id">
                                        <option value="">{t('admin_content.help.nobody')}</option>
                                        {free_groups.map(group =>
                                            <option value={String(group.id)}>{group.tribe_name} · {group.name}</option>
                                        )}
                                    </Select>
                                </ManageField>
                                <p class="[ manage-field__error ]" role="alert" x-ref="error"></p>
                                <FlexInline justification="flex-end">
                                    <Button type="button" size="sm" color="transparent" x-on:click="close_dialog()">{t('cancel')}</Button>
                                    <Button type="submit" size="sm" x-bind:disabled="submitting">{t('admin_content.help.add')}</Button>
                                </FlexInline>
                            </form>
                        </DialogButton>
                    </Fragment>
                }
            </ManageHero>
        </Flexblock>

        {settings ?
            <Flexblock gap="var(--space-s)">
                <SettingsSection
                    id="help-panel"
                    title={t('help_settings.panel')}
                    summary={panel_summary}
                    url={translatePath('/partials/help_tickets_settings_component/?part=panel')}
                />
                <SettingsSection
                    id="help-options"
                    title={t('admin_content.help.options')}
                    summary={options_summary}
                    url={translatePath('/partials/help_tickets_settings_component/?part=options')}
                    expanded={true}
                />
            </Flexblock>
            :
            <ErrorRefetch args={{ partial: `${PARTIAL_URL}?part=options`, error: data_fetching_error || new Error(), delay: 0 }} />
        }
    </Flexblock>
</PageLanding>
</Viewport>
