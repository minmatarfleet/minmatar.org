---
import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

import { HTTP_404_Not_Found } from '@helpers/http_responses'
import { get_tribe } from '@helpers/api.minmatar.org/tribes'

const tribe_id = parseInt(Astro.params.tribe_id as string)
if (isNaN(tribe_id))
    return HTTP_404_Not_Found()

try {
    const tribe = await get_tribe(tribe_id)
    return Astro.redirect(
        translatePath(`/alliance/tribes/?tribe=${encodeURIComponent(tribe.slug)}`),
    )
} catch {
    return HTTP_404_Not_Found()
}
---
