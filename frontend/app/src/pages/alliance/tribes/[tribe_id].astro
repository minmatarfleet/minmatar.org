---
import { i18n } from '@helpers/i18n'
import { get_request_user } from '@helpers/request_user'
const { t, lang, translatePath } = i18n(Astro.url)

import { HTTP_404_Not_Found, login_url } from '@helpers/http_responses'
import { help_wanted_props } from '@helpers/tribe_chiefs'
import { query_string } from '@helpers/string'
import { strip_markdown } from '@helpers/string'
import { get_tribe, get_tribe_about } from '@helpers/api.minmatar.org/tribes'
import { TRIBES_COVER_FALLBACK } from '@helpers/tribe_covers'
import { PULSE_ORDER, type TribeAboutVital } from '@helpers/tribe_about'
import { format_isk, number_thousand_separator } from '@helpers/numbers'
import { fill_template } from '@helpers/tribe_activity'
import type { Tribe, TribeAbout } from '@dtypes/api.minmatar.org'

const { auth_token, user } = get_request_user(Astro)

const tribe_id = parseInt(Astro.params.tribe_id as string)
if (isNaN(tribe_id))
    return HTTP_404_Not_Found()

let tribe: Tribe
try {
    tribe = await get_tribe(tribe_id, auth_token)
} catch {
    return HTTP_404_Not_Found()
}

// The chief, else the executor standing in (Help wanted).
const chief = tribe.acting_chief ?? null
const chief_label = tribe.chief_is_interim ? t('tribes.chief.interim') : t('tribes.about.tribe_chief')
const volunteers_url = translatePath(`/partials/tribe_chief_volunteers_component?${query_string({
    tribe_id,
    seat_name: tribe.name,
})}`)

// The About rollup is cached by Celery; until it exists the page shows the tribe without it.
const about: TribeAbout | null = await get_tribe_about(tribe_id, auth_token).catch(() => null)
const ready = Boolean(about?.ready)

const vitals = [
    {
        value: number_thousand_separator(ready ? about!.people : tribe.total_member_count),
        label: t('tribes.about.people'),
        detail: t('tribes.about.people_detail'),
    },
    ready && {
        value: number_thousand_separator(about!.character_count),
        label: t('tribes.about.characters'),
    },
    ready && {
        value: number_thousand_separator(about!.corporation_count),
        label: t('tribes.about.corporations'),
    },
    ready && {
        value: format_isk(about!.isk_destroyed),
        label: t('tribes.about.isk_destroyed'),
        detail: t('tribes.about.isk_destroyed_detail'),
    },
].filter(Boolean) as TribeAboutVital[]

const tribes_url = translatePath('/alliance/tribes/')
const groups_url = translatePath(`/alliance/tribes/?tribe=${encodeURIComponent(tribe.slug)}`)
const cover = tribe.banner_url || TRIBES_COVER_FALLBACK
const meta_description = await strip_markdown(tribe.description || '')
const updated = about?.generated_at
    ? new Date(about.generated_at).toLocaleString(lang, {
        day: 'numeric',
        month: 'short',
        hour: '2-digit',
        minute: '2-digit',
        timeZone: 'UTC',
    })
    : ''

const breadcrumbs = [
    { page_title: t('alliance.page_title'), accumulated_path: translatePath('/alliance/') },
    { page_title: t('tribes.page_title'), accumulated_path: tribes_url },
    { page_title: tribe.name, accumulated_path: Astro.url.pathname },
]

import Viewport from '@layouts/Viewport.astro'

import PageBreadcrumbs from '@components/page/PageBreadcrumbs.astro'
import PageLanding from '@components/page/PageLanding.astro'
import PageTitle from '@components/page/PageTitle.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'

import Button from '@components/blocks/Button.astro'
import CharacterPicture from '@components/blocks/CharacterPicture.astro'
import LazyPartial from '@components/blocks/LazyPartial.astro'
import TribeChiefHelpWanted from '@components/blocks/TribeChiefHelpWanted.astro'
import TribeChiefSwap from '@components/blocks/TribeChiefSwap.astro'
import TribeAboutBody from '@components/blocks/tribe_about/TribeAboutBody.astro'
import TribeAboutIntro from '@components/blocks/tribe_about/TribeAboutIntro.astro'
import TribeCapitalLine from '@components/blocks/tribe_about/TribeCapitalLine.astro'
import TribeSupplyChain from '@components/blocks/tribe_about/TribeSupplyChain.astro'
import TribeGroupGrid from '@components/blocks/tribe_about/TribeGroupGrid.astro'
import TribePulseShowcase from '@components/blocks/tribe_about/TribePulseShowcase.astro'
import TribeAboutGrowth from '@components/blocks/tribe_about/TribeAboutGrowth.astro'
---

<Viewport
    title={tribe.name}
    meta_description={meta_description}
>
    <PageLanding
        cover={{
            image: cover,
            image_990: cover,
            overlay: true,
            scrollable: true,
        }}
        wide={true}
    >
        <TribeAboutBody gap="var(--space-2xl)">
            <FlexInline class="[ w-full !items-start ]" justification="space-between">
                <Flexblock gap="var(--space-s)">
                    <PageBreadcrumbs is_landing_page={true} breadcrumbs={breadcrumbs} />
                    <FlexInline gap="var(--space-xs)" class="[ tribe-title-row ]">
                        {chief ?
                            <Flexblock gap="var(--space-3xs)" class="[ tribe-chief ]">
                                <TribeChiefSwap tribe_id={tribe.id} group_id={null} seat_name={tribe.name} can_set={tribe.can_set_chief}>
                                    <div class:list={['[ tribe-chief-portrait ]', { 'is-interim': tribe.chief_is_interim }]}>
                                        <CharacterPicture
                                            character_id={chief.character_id}
                                            character_name={chief.character_name}
                                            size={128}
                                            icon_quality={256}
                                            inert={tribe.can_set_chief}
                                            tooltip={`${chief.character_name} · ${chief_label}`}
                                        />
                                    </div>
                                </TribeChiefSwap>
                                {tribe.chief_is_interim &&
                                    <small class="[ tribe-chief-interim-label ]">{chief_label}</small>
                                }
                            </Flexblock>
                            : tribe.can_set_chief &&
                            <TribeChiefSwap tribe_id={tribe.id} group_id={null} seat_name={tribe.name} can_set={true} empty={true} />
                        }
                        <PageTitle is_landing={true}>{tribe.name}</PageTitle>
                    </FlexInline>
                </Flexblock>
                <Button href={groups_url} size="sm">{t('tribes.about.browse_groups')}</Button>
            </FlexInline>

            {tribe.chief_is_interim &&
                <Flexblock gap="var(--space-l)" class="[ w-full ]">
                    <TribeChiefHelpWanted
                        {...help_wanted_props(tribe)}
                        is_auth={Boolean(user)}
                        login_href={login_url(Astro)}
                    />
                    {tribe.can_appoint_chief &&
                        <LazyPartial url={volunteers_url}>
                            <span class="[ text-muted ]">{t('tribes.chief.volunteers')}</span>
                        </LazyPartial>
                    }
                </Flexblock>
            }

            <TribeAboutIntro lede={tribe.description} markdown={tribe.content} vitals={vitals} />

            {ready && about ?
                <>
                    {tribe.slug === 'capitals' && about.capitals &&
                        <TribeCapitalLine capitals={about.capitals} groups={about.groups} tribe_id={tribe_id} />
                    }
                    {tribe.slug === 'supply' &&
                        <TribeSupplyChain supply={about.supply} groups={about.groups} tribe_id={tribe_id} />
                    }
                    {tribe.slug === 'pulse' &&
                        <>
                            <TribeGroupGrid
                                groups={about.groups}
                                tribe_id={tribe_id}
                                order={PULSE_ORDER}
                                title={t('tribes.about.pulse.services_title')}
                                caption={t('tribes.about.pulse.services_caption')}
                            />
                            <TribePulseShowcase groups={about.groups} />
                        </>
                    }
                    {!['capitals', 'supply', 'pulse'].includes(tribe.slug) &&
                        <TribeGroupGrid
                            groups={about.groups}
                            tribe_id={tribe_id}
                            title={t('tribes.about.groups_title')}
                            caption={t('tribes.about.groups_caption')}
                        />
                    }
                    <TribeAboutGrowth about={about} />
                    {updated &&
                        <p class="[ tribe-about-footnote ]">
                            {fill_template(t('tribes.about.footnote'), { time: updated })}
                        </p>
                    }
                </>
                :
                <p class="[ tribe-about-pending ]">{t('tribes.about.pending')}</p>
            }
        </TribeAboutBody>
    </PageLanding>
</Viewport>

<style lang="scss">
    // Same title row as the group pages.
    .tribe-title-row {
        align-items: center;
        flex-wrap: nowrap;

        :global(.page-title h1.is-landing) {
            line-height: 1;
        }
    }

    .tribe-chief {
        flex: 0 0 auto;
        align-items: center;
    }

    .tribe-chief-interim-label {
        color: var(--attention);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-size: var(--step--1);
    }

    .tribe-chief-portrait {
        flex: 0 0 auto;

        &.is-interim {
            outline: solid 2px var(--attention);
            outline-offset: -2px;
        }

        inline-size: var(--step-5);
        block-size: var(--step-5);

        :global(picture) {
            display: block;
            inline-size: 100%;
            block-size: 100%;
        }

        :global(img) {
            display: block;
            inline-size: 100%;
            block-size: 100%;
            max-inline-size: none;
            object-fit: cover;
        }
    }

    .tribe-about-footnote,
    .tribe-about-pending {
        margin: 0;
        font-size: var(--step--1);
        color: var(--faded);
    }

    .tribe-about-pending {
        padding: var(--space-m);
        box-shadow: inset 0 0 0 1px var(--border-color-hover);
    }
</style>
