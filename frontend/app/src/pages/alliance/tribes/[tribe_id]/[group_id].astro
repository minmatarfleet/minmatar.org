---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { get_request_user } from '@helpers/request_user'

const { auth_token, user } = get_request_user(Astro)
const is_auth = Boolean(user)

import { get_user_profile } from '@helpers/permissions'
import { get_gates, can } from '@helpers/gates'
import { HTTP_400_Bad_Request, HTTP_404_Not_Found } from '@helpers/http_responses'
import { strip_markdown } from '@helpers/string'
import { tribe_group_cover } from '@helpers/tribe_covers'
import { getGuidesByTribeGroupCode } from '@/data/guides'
import { get_posts } from '@helpers/api.minmatar.org/posts'
import { get_fleets_v3 } from '@helpers/api.minmatar.org/fleets'
import { add_fleet_info } from '@helpers/fetching/fleets'
import { fetch_doctrine_names, type FleetScheduleDoctrine } from '@helpers/fetching/fleet_schedule'

import type {
    Tribe,
    TribeGroup,
    TribeMembership,
    SummaryCharacter,
    TribeAvailableCharacter,
    TribeGroupRosterEntry,
    TribeGroupShowcase,
    TribeEvent,
    TribeGroupPublishing,
    TribeGroupAbout as TribeGroupAboutData,
} from '@dtypes/api.minmatar.org'
import type { DiscordChannelUI, FleetItem, PostTileUI, TribeVisibility } from '@dtypes/layout_components'
import type { GuideMeta } from '@/data/guides/types'
import {
    get_tribe,
    get_tribe_group,
    get_memberships,
    get_membership_characters_available,
    get_tribe_group_roster,
    get_tribe_group_showcase,
    get_tribe_group_about,
    get_group_events,
    get_group_publishing,
    get_discord_channels,
} from '@helpers/api.minmatar.org/tribes'
import { get_characters_summary_sorted } from '@helpers/fetching/characters'
import { TRIBE_ACTIVITY_BY_CODE } from '@helpers/tribe_activity'
import { tribe_group_can_manage, tribe_group_is_leader } from '@helpers/tribe_group_viewer'
import {
    TRIBE_GROUP_HASH_ALIASES,
    discord_channel_ui,
    fleet_visibility,
    post_tile,
    sort_newest_first,
    tribe_group_tab_ids,
    tribe_new_menu_items,
    type GroupPostSource,
    type TribeGroupTab,
} from '@helpers/tribe_group_page'

const tribe_id = parseInt(Astro?.params?.tribe_id ?? '')
const group_id = parseInt(Astro?.params?.group_id ?? '')

if (isNaN(tribe_id) || isNaN(group_id))
    return HTTP_400_Bad_Request()

const user_profile = user && user?.username ? await get_user_profile(user.username) : null
const gates = await get_gates(Astro)
const is_alliance_member = can(gates, 'tribes.roster.view')
const user_on_trial = user_profile?.community_status === 'trial'

let tribe: Tribe | null = null
let tribe_group: TribeGroup | null = null
let user_characters: SummaryCharacter[] = []
let available_characters: TribeAvailableCharacter[] = []
const membership_by_group = new Map<number, TribeMembership | null>()
let roster: TribeGroupRosterEntry[] | null = null
let showcase: TribeGroupShowcase | null = null
let group_about: TribeGroupAboutData | null = null
let guides: GuideMeta[] = []
let posts: PostTileUI[] = []
let fleets: FleetItem[] = []
const fleet_visibility_by_id: Record<number, TribeVisibility> = {}
let fleet_doctrines: Record<number, FleetScheduleDoctrine> = {}
let events: TribeEvent[] = []
let voice_channels: DiscordChannelUI[] = []
let publishing: TribeGroupPublishing | null = null
let text_channels: DiscordChannelUI[] | null = null
let fetch_group_error: Error | false = false

try {
    tribe = await get_tribe(tribe_id)
    tribe_group = await get_tribe_group(tribe_id, group_id, auth_token)

    showcase = tribe_group?.code && tribe_group.code in TRIBE_ACTIVITY_BY_CODE
        ? await get_tribe_group_showcase(tribe_id, group_id, auth_token).catch(() => null)
        : null

    guides = getGuidesByTribeGroupCode(tribe_group.code)
    const post_href = (post_id: number) => translatePath(`/alliance/propaganda/${post_id}`)
    const can_view_fleets = Boolean(auth_token) && can(gates, 'fleets.view')
    const manages = Boolean(auth_token && tribe_group.can_manage)
    const [posts_page, group_fleets, group_events, voice_list, loaded_publishing, text_list, loaded_about] = await Promise.all([
        // With a token the API adds members-only posts the viewer may read.
        get_posts({ tribe_group_id: group_id, status: 'published', page_num: 1, page_size: 12 }, auth_token)
            .catch(() => ({ total_posts: 0, posts: [] })),
        // Members-only fleets are already left out for outsiders.
        can_view_fleets
            ? get_fleets_v3(auth_token as string, 'upcoming', group_id).catch(() => [])
            : Promise.resolve([]),
        get_group_events(group_id, auth_token).catch(() => []),
        // Tells stage channels from voice on the Events tab.
        auth_token && tribe_group.can_create_events
            ? get_discord_channels(auth_token, 'voice').catch(() => [])
            : Promise.resolve([]),
        manages ? get_group_publishing(auth_token as string, group_id).catch(() => null) : Promise.resolve(null),
        manages ? get_discord_channels(auth_token as string, 'text').catch(() => null) : Promise.resolve(null),
        // Cached by Celery; until it exists the About tab shows the write-up and headcount.
        get_tribe_group_about(tribe_id, group_id, auth_token).catch(() => null),
    ])
    group_about = loaded_about
    posts = sort_newest_first(posts_page.posts as unknown as GroupPostSource[])
        .map((post) => post_tile(post, group_id, post_href(post.post_id)))
    const listed_fleets = group_fleets.filter((fleet) => fleet.fleet_commander)
    listed_fleets.forEach((fleet) => { fleet_visibility_by_id[fleet.id] = fleet_visibility(fleet) })
    fleets = listed_fleets.map((fleet) => add_fleet_info(fleet, [], []))
    fleet_doctrines = await fetch_doctrine_names(fleets)
    events = group_events
    voice_channels = voice_list.map(discord_channel_ui)
    publishing = loaded_publishing
    text_channels = text_list ? text_list.map(discord_channel_ui) : null

    if (auth_token && user) {
        const [summary, memberships, available] = await Promise.all([
            get_characters_summary_sorted(auth_token),
            get_memberships(auth_token as string, tribe_id, group_id, { mine: true }).catch(() => []),
            get_membership_characters_available(auth_token as string, tribe_id, group_id).catch(() => []),
        ])
        user_characters = summary.characters ?? []
        membership_by_group.set(group_id, memberships[0] ?? null)
        available_characters = available
    }
} catch (error) {
    fetch_group_error = error as Error
}

if (!fetch_group_error && !tribe_group)
    return HTTP_404_Not_Found()

const membership = membership_by_group.get(group_id) ?? null
const is_leader = tribe_group_is_leader({
    group: tribe_group,
    membership,
    user_characters,
})
const can_manage = tribe_group_can_manage({
    group: tribe_group,
    is_leader,
})
const roster_hidden = Boolean(tribe_group?.roster_hidden)
const can_see_roster = roster_hidden
    ? Boolean(can_manage || membership?.status === 'active')
    : is_alliance_member

if (!fetch_group_error && auth_token && tribe_group && can_see_roster) {
    roster = await get_tribe_group_roster(
        auth_token as string,
        tribe_id,
        group_id,
    ).catch(() => [])
}

const activity = tribe_group?.code
    ? TRIBE_ACTIVITY_BY_CODE[tribe_group.code]
    : undefined

const TRIBE_GROUP_PARTIAL_URL = translatePath(
    `/alliance/tribes/${tribe_id}/${group_id}/`,
)
const tribes_url = translatePath('/alliance/tribes/')
const tribe_url = translatePath(`/alliance/tribes/${tribe_id}/`)
const cover = tribe_group_cover(group_id)
const page_title = tribe_group?.name ?? ''
const page_description = tribe_group?.description ?? ''
const meta_description = await strip_markdown(page_description)
const about_markdown = (tribe_group?.content || tribe_group?.description || '').trim()
const chief = tribe_group?.chief ?? null
const has_qualification_requirements = (tribe_group?.requirements?.length ?? 0) > 0
const has_membership_requirements = Boolean(tribe_group?.require_off_trial)
    || (tribe_group?.allowed_affiliations?.length ?? 0) > 0
const has_token_requirement = Boolean((tribe_group?.required_token_type ?? '').trim())
const has_any_requirements = has_qualification_requirements
    || has_membership_requirements
    || has_token_requirement
const breadcrumbs = [
    { page_title: t('alliance.page_title'), accumulated_path: translatePath('/alliance/') },
    { page_title: t('tribes.page_title'), accumulated_path: tribes_url },
    ...(tribe
        ? [{ page_title: tribe.name, accumulated_path: tribe_url }]
        : []),
    { page_title: page_title, accumulated_path: Astro.url.pathname },
]

function tribe_tab_label(tab: TribeGroupTab) {
    switch (tab) {
        case 'about':
            return t('tribes.detail.tab.about')
        case 'requirements':
            return t('tribes.detail.tab.requirements')
        case 'guides':
            return t('tribes.detail.tab.guides')
        case 'activity':
            return t('tribes.detail.tab.activity')
        case 'members':
            return t('tribes.detail.tab.members')
        case 'fleets':
            return t('tribes.detail.tab.fleets')
        case 'events':
            return t('tribes.detail.tab.events')
        case 'posts':
            return t('tribes.detail.tab.posts')
        case 'settings':
            return t('tribes.detail.tab.settings')
        default: {
            const unexpected: never = tab
            return unexpected
        }
    }
}

// Settings needs the publishing settings, which only the API's managers get.
const show_settings = Boolean(tribe_group?.can_manage && publishing)
const tribe_tab_ids = tribe_group_tab_ids({
    // The year's numbers always have something to say, even with no write-up.
    has_about: true,
    has_guides: guides.length > 0,
    has_activity: Boolean(activity),
    fleet_count: fleets.length,
    event_count: events.length,
    post_count: posts.length,
    can_schedule_fleets: Boolean(tribe_group?.can_schedule_fleets),
    can_create_events: Boolean(tribe_group?.can_create_events),
    can_post: Boolean(tribe_group?.can_post),
    can_manage: show_settings,
})
const tribe_tabs = tribe_tab_ids.map((id) => ({
    id,
    label: tribe_tab_label(id),
}))
const default_tribe_tab = tribe_tabs[0]?.id
const new_menu_items = tribe_group ? tribe_new_menu_items(tribe_group, tribe_id, group_id) : []
// Non-members never see members-only fleets, so tell them they exist.
const show_members_only_fleet_note = Boolean(tribe_group && !tribe_group.is_member && !can_manage)
const publishing_roster = (roster ?? [])
    .filter((entry) => entry.primary_character_id)
    .map((entry) => ({ character_id: entry.primary_character_id as number, character_name: entry.primary_character_name }))

import Viewport from '@layouts/Viewport.astro'

import PageBreadcrumbs from '@components/page/PageBreadcrumbs.astro'
import PageLanding from '@components/page/PageLanding.astro'
import PageTitle from '@components/page/PageTitle.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import Wrapper from '@components/compositions/Wrapper.astro'

import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import Breadcrumb from '@components/blocks/Breadcrumb.astro'
import CharacterPicture from '@components/blocks/CharacterPicture.astro'
import TribalGroupRequirements from '@components/blocks/TribalGroupRequirements.astro'
import RequirementSwiper from '@components/blocks/RequirementSwiper.astro'
import NotificationBadge from '@components/blocks/NotificationBadge.astro'
import TribeGroupActivity from '@components/blocks/TribeGroupActivity.astro'
import TribeGroupAbout from '@components/blocks/tribe_about/TribeGroupAbout.astro'
import TribeGroupMembersGallery from '@components/blocks/TribeGroupMembersGallery.astro'
import TribeGroupActions from '@components/blocks/TribeGroupActions.astro'
import TribeGroupApplyHint from '@components/blocks/TribeGroupApplyHint.astro'
import TribeGroupTokenRequirement from '@components/blocks/TribeGroupTokenRequirement.astro'
import TribeGroupMembershipRequirements from '@components/blocks/TribeGroupMembershipRequirements.astro'
import GuidePostCard from '@components/blocks/GuidePostCard.astro'
import TribeGroupNewMenu from '@components/blocks/TribeGroupNewMenu.astro'
import TribeGroupFleets from '@components/blocks/TribeGroupFleets.astro'
import TribeGroupEvents from '@components/blocks/TribeGroupEvents.astro'
import TribeGroupPosts from '@components/blocks/TribeGroupPosts.astro'
import TribeGroupDiscordSettings from '@components/blocks/TribeGroupDiscordSettings.astro'
import TribeGroupPublishingSettings from '@components/blocks/TribeGroupPublishingSettings.astro'
import LandingSwiper from '@components/blocks/LandingSwiper.astro'
import Button from '@components/blocks/Button.astro'
import SectionTabs from '@components/blocks/SectionTabs.astro'
import SectionTabPanel from '@components/blocks/SectionTabPanel.astro'
---

<Viewport
    title={page_title}
    meta_description={meta_description}
    components={{
        alert_dialog: true,
        confirm_dialog: true,
        modal: true,
    }}
>
    <PageLanding
        cover={{
            image: cover,
            image_990: cover,
            overlay: true,
            scrollable: true,
        }}
        wide={true}
    >
        <Flexblock gap="var(--space-l)">
            <FlexInline class="[ w-full !items-start ]" justification="space-between">
                <Flexblock gap="var(--space-s)">
                    <PageBreadcrumbs is_landing_page={true} breadcrumbs={breadcrumbs} />
                    <FlexInline gap="var(--space-xs)" class="[ tribe-group-title-row ]">
                        {chief &&
                            <div class="[ tribe-group-chief-portrait ]">
                                <CharacterPicture
                                    character_id={chief.character_id}
                                    character_name={chief.character_name}
                                    size={128}
                                    icon_quality={256}
                                    tooltip={`${chief.character_name} · ${t('group_chief')}`}
                                />
                            </div>
                        }
                        <PageTitle is_landing={true}>{page_title}</PageTitle>
                    </FlexInline>
                </Flexblock>
                {tribe_group &&
                    <FlexInline gap="var(--space-xs)" class="[ items-start! ]">
                        {can_manage &&
                            <Button
                                href={translatePath(`/alliance/tribes/${tribe_id}/${group_id}/members`)}
                                size="sm"
                            >
                                {t('manage_membership')}
                            </Button>
                        }
                        <TribeGroupNewMenu group_name={tribe_group.name} items={new_menu_items} />
                        <TribeGroupActions
                            group={tribe_group}
                            tribe_id={tribe_id}
                            group_id={group_id}
                            is_auth={is_auth}
                            is_leader={is_leader}
                            user_on_trial={user_on_trial}
                            user_characters={user_characters}
                            available_characters={available_characters}
                            membership_by_group={membership_by_group}
                        />
                    </FlexInline>
                }
            </FlexInline>

            {fetch_group_error ?
                <ErrorRefetch
                    args={{
                        partial: TRIBE_GROUP_PARTIAL_URL,
                        error: fetch_group_error,
                        delay: 0,
                    }}
                />
                :
                tribe_group &&
                    <div id="tribe-group-hub">
                        <SectionTabs
                            aria_label={t('tribes.detail.tabs_label')}
                            id_prefix="tribe-group"
                            tabs={tribe_tabs}
                            hash_aliases={TRIBE_GROUP_HASH_ALIASES}
                        >
                            <SectionTabPanel id="about" id_prefix="tribe-group" is_default={default_tribe_tab === 'about'}>
                                <TribeGroupAbout
                                    markdown={about_markdown}
                                    group_name={tribe_group.name}
                                    group_code={tribe_group.code}
                                    member_count={tribe_group.member_count}
                                    tribe_id={tribe_id}
                                    tribe_name={tribe?.name ?? tribe_group.tribe_name}
                                    about={group_about}
                                />
                            </SectionTabPanel>

                            <SectionTabPanel id="requirements" id_prefix="tribe-group" is_default={default_tribe_tab === 'requirements'}>
                                <Flexblock gap="var(--space-m)" class="[ tribe-group-requirements ]">
                                    <Flexblock gap="var(--space-3xs)">
                                        <h2>{t('tribes.detail.requirements')}</h2>
                                        {tribe_group.requirements.length > 1 &&
                                            <small>
                                                {t('tribal_group_requirement_text').replace(
                                                    '{count}',
                                                    String(tribe_group.requirements.length),
                                                )}
                                            </small>
                                        }
                                    </Flexblock>

                                    {has_qualification_requirements ?
                                        <Wrapper
                                            class="[ requirements-reel ]"
                                            padding_block="0"
                                            padding_inline="0"
                                            max_width="100%"
                                        >
                                            <div id="tribe-group-requirements-reel" class="[ swiper ][ w-full ]">
                                                <RequirementSwiper
                                                    swiper_selector="#tribe-group-requirements-reel"
                                                    pagination={false}
                                                    gap={60}
                                                    slides_per_view={1}
                                                >
                                                    {tribe_group.requirements.map((req, index) =>
                                                        <div class="[ swiper-slide ]">
                                                            {tribe_group.requirements.length > 1 &&
                                                                <NotificationBadge
                                                                    class="[ requirement-number ]"
                                                                    number={index + 1}
                                                                    color="fleet-yellow"
                                                                    text_color="var(--background)"
                                                                />
                                                            }
                                                            <TribalGroupRequirements
                                                                requirement={req}
                                                            />
                                                        </div>
                                                    )}
                                                </RequirementSwiper>
                                            </div>
                                            {tribe_group.requirements.length > 1 &&
                                                <>
                                                    <div id="tribe-group-requirements-reel-button-prev" class="[ swiper-button-prev ]"></div>
                                                    <div id="tribe-group-requirements-reel-button-next" class="[ swiper-button-next ]"></div>
                                                </>
                                            }
                                        </Wrapper>
                                        :
                                        !has_any_requirements &&
                                            <p>{t('tribes.detail.no_requirements')}</p>
                                    }

                                    <TribeGroupMembershipRequirements
                                        require_off_trial={Boolean(tribe_group.require_off_trial)}
                                        allowed_affiliations={tribe_group.allowed_affiliations ?? []}
                                        show_top_separator={has_qualification_requirements}
                                    />

                                    <TribeGroupTokenRequirement
                                        required_token_type={tribe_group.required_token_type}
                                    />

                                    <TribeGroupApplyHint
                                        group={tribe_group}
                                        tribe_id={tribe_id}
                                        group_id={group_id}
                                        is_auth={is_auth}
                                        is_leader={is_leader}
                                        user_on_trial={user_on_trial}
                                        user_characters={user_characters}
                                        available_characters={available_characters}
                                        membership_by_group={membership_by_group}
                                    />
                                </Flexblock>
                            </SectionTabPanel>

                            {guides.length > 0 &&
                                <SectionTabPanel id="guides" id_prefix="tribe-group" is_default={default_tribe_tab === 'guides'}>
                                    <Flexblock gap="var(--space-m)">
                                        <h2>{t('content.guides.section_title')}</h2>
                                        <Wrapper padding_block="0" padding_inline="0" max_width="100%">
                                            <div id="tribe-group-guides-swiper" class="[ swiper ][ w-full ]">
                                                <LandingSwiper
                                                    swiper_selector="#tribe-group-guides-swiper"
                                                    align="start"
                                                    gap={10}
                                                    pagination={false}
                                                >
                                                    {guides.map((guide) => (
                                                        <div class="[ swiper-slide ]" style="margin-right: 10px; width: min(100%, 320px)">
                                                            <GuidePostCard guide={guide} />
                                                        </div>
                                                    ))}
                                                </LandingSwiper>
                                            </div>
                                        </Wrapper>
                                    </Flexblock>
                                </SectionTabPanel>
                            }

                            {activity &&
                                <SectionTabPanel id="activity" id_prefix="tribe-group" is_default={default_tribe_tab === 'activity'}>
                                    <TribeGroupActivity
                                        activity={activity}
                                        showcase={showcase}
                                        can_see_names={can_see_roster}
                                    />
                                </SectionTabPanel>
                            }

                            <SectionTabPanel id="members" id_prefix="tribe-group" is_default={default_tribe_tab === 'members'}>
                                <TribeGroupMembersGallery
                                    roster={roster}
                                    member_count={tribe_group.member_count}
                                    is_alliance_member={can_see_roster}
                                    is_auth={is_auth}
                                    roster_redacted={roster_hidden && !can_see_roster}
                                />
                            </SectionTabPanel>

                            {tribe_tab_ids.includes('fleets') &&
                                <SectionTabPanel id="fleets" id_prefix="tribe-group" is_default={default_tribe_tab === 'fleets'}>
                                    <TribeGroupFleets
                                        fleets={fleets}
                                        visibility={fleet_visibility_by_id}
                                        doctrines={fleet_doctrines}
                                        group_id={group_id}
                                        group_name={tribe_group.name}
                                        show_members_only_note={show_members_only_fleet_note}
                                        can_schedule={Boolean(tribe_group.can_schedule_fleets)}
                                    />
                                </SectionTabPanel>
                            }

                            {tribe_tab_ids.includes('events') &&
                                <SectionTabPanel id="events" id_prefix="tribe-group" is_default={default_tribe_tab === 'events'}>
                                    <TribeGroupEvents
                                        events={events}
                                        tribe_id={tribe_id}
                                        group_id={group_id}
                                        group_name={tribe_group.name}
                                        cover_url={cover}
                                        can_create={Boolean(tribe_group.can_create_events)}
                                        voice_channels={voice_channels}
                                    />
                                </SectionTabPanel>
                            }

                            {tribe_tab_ids.includes('posts') &&
                                <SectionTabPanel id="posts" id_prefix="tribe-group" is_default={default_tribe_tab === 'posts'}>
                                    <TribeGroupPosts
                                        posts={posts}
                                        crest_url={cover}
                                        group_name={tribe_group.name}
                                        can_post={Boolean(tribe_group.can_post)}
                                    />
                                </SectionTabPanel>
                            }

                            {show_settings && publishing &&
                                <SectionTabPanel id="settings" id_prefix="tribe-group" is_default={default_tribe_tab === 'settings'}>
                                    <Flexblock gap="var(--space-l)">
                                        <TribeGroupDiscordSettings
                                            settings={publishing}
                                            channels={text_channels}
                                            tribe_id={tribe_id}
                                            group_id={group_id}
                                            tribe_name={tribe?.name ?? tribe_group.tribe_name}
                                            group_name={tribe_group.name}
                                        />
                                        <TribeGroupPublishingSettings
                                            settings={publishing}
                                            roster={publishing_roster}
                                            tribe_id={tribe_id}
                                            group_id={group_id}
                                            tribe_name={tribe?.name ?? tribe_group.tribe_name}
                                            group_name={tribe_group.name}
                                        />
                                    </Flexblock>
                                </SectionTabPanel>
                            }
                        </SectionTabs>
                    </div>
            }
        </Flexblock>
    </PageLanding>
</Viewport>

<style lang="scss">
    #tribe-group-hub {
        width: 100%;
        min-width: 0;
    }

    .tribe-group-title-row {
        align-items: center;
        flex-wrap: nowrap;

        :global(.page-title h1.is-landing) {
            line-height: 1;
        }
    }

    .tribe-group-chief-portrait {
        flex: 0 0 auto;
        width: var(--step-5);
        height: var(--step-5);

        :global(picture) {
            display: block;
            width: 100%;
            height: 100%;
        }

        :global(img) {
            display: block;
            width: 100%;
            height: 100%;
            max-width: none;
            object-fit: cover;
        }
    }

    .tribe-group-requirements {
        width: 100%;
        min-width: 0;
    }

    .requirements-reel {
        position: relative;
        width: 100%;
    }

    .tribe-group-requirements :global(.swiper-slide) {
        width: 100%;
        box-sizing: border-box;
    }

    .requirement-number {
        position: absolute;
        top: 0;
        right: 0;
    }

    .swiper-button-prev,
    .swiper-button-next {
        --swiper-navigation-color: var(--highlight);
