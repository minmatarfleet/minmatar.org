---
import { i18n } from '@helpers/i18n'
import { login_redirect } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'
const { translatePath } = i18n(Astro.url)

import { get_public_api_url, get_app_url } from '@helpers/env'

const { auth_token } = get_request_user(Astro)

if (!auth_token)
    return login_redirect(Astro)

const return_url = get_app_url(translatePath('/alliance/content/'))
const connect_url =
    `${get_public_api_url()}/api/creators/youtube/connect` +
    `?redirect_url=${encodeURIComponent(return_url)}` +
    `&token=${encodeURIComponent(auth_token)}`

return Astro.redirect(connect_url)
---
