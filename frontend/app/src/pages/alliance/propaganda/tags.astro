---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden, login_redirect } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'
import { get_gates, can } from '@helpers/gates'

const { auth_token, user } = get_request_user(Astro)
if (!auth_token || !user) return login_redirect(Astro)

const gates = await get_gates(Astro)
if (!can(gates, 'posts.tags.manage')) return HTTP_403_Forbidden()

import type { PostTag } from '@dtypes/api.minmatar.org'
import { get_posts_tags } from '@helpers/api.minmatar.org/posts'

let tags: PostTag[] = []
let data_fetching_error: Error | false = false

try {
    tags = await get_posts_tags()
} catch (error) {
    data_fetching_error = error
}

const page_title = t('post_tags.manage.page_title')

import Viewport from '@layouts/Viewport.astro'
import PageWide from '@components/page/PageWide.astro'
import PageTitle from '@components/page/PageTitle.astro'
import PageActions from '@components/page/PageActions.astro'

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'

import Button from '@components/blocks/Button.astro'
import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import PostTagsManager from '@components/blocks/PostTagsManager.astro'
---

<Viewport title={page_title} meta_description={t('page_finder.propaganda.tags.description')}>
    <PageWide
        cover={{
            image: '/images/propaganda-cover.jpg',
            image_990: '/images/propaganda-cover.jpg',
            overlay: true,
            scrollable: true,
        }}
    >
        <FlexInline slot="header" justification="space-between" class="[ w-full ]">
            <PageTitle>{page_title}</PageTitle>
            <PageActions>
                <Button href={translatePath('/alliance/propaganda/my_posts/')}>{t('my_posts')}</Button>
            </PageActions>
        </FlexInline>

        <Flexblock gap="var(--space-l)">
            <p>{t('post_tags.manage.leading_text')}</p>
            {data_fetching_error ?
                <ErrorRefetch args={{ partial: translatePath('/partials/post_tags_component'), error: data_fetching_error, delay: 0 }} />
                :
                <ComponentBlock padding_inline="var(--space-m)" padding_block="var(--space-s)">
                    <PostTagsManager tags={tags} />
                </ComponentBlock>
            }
        </Flexblock>
    </PageWide>
</Viewport>
