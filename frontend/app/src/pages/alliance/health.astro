---
import { i18n } from '@helpers/i18n'
const { t, translatePath, lang } = i18n(Astro.url)

import { HTTP_403_Forbidden } from '@helpers/http_responses'

import type { User } from '@dtypes/jwt'
import * as jose from 'jose'

const auth_token = Astro.cookies.has('auth_token')
    ? (Astro.cookies.get('auth_token')?.value as string)
    : null
const user = auth_token ? (jose.decodeJwt(auth_token) as User) : false

if (!user)
    return Astro.redirect(
        `${translatePath('/redirects/auth_init')}?redirect_url=${Astro.url}`,
    )

import type {
    AllianceHealthAttention,
    AllianceHealthAttentionBucket,
    AllianceHealthCorporations,
    AllianceHealthLeave,
    AllianceHealthLeaveBucket,
    AllianceHealthOnboarding,
    AllianceHealthOnboardingBucket,
    AllianceHealthOverview,
    AllianceHealthTrialBucket,
    AllianceHealthTrials,
} from '@dtypes/api.minmatar.org'
import {
    get_alliance_health_attention,
    get_alliance_health_corporations,
    get_alliance_health_leave,
    get_alliance_health_onboarding,
    get_alliance_health_overview,
    get_alliance_health_trials,
} from '@helpers/api.minmatar.org/alliance_health'
import { parse_alliance_health_bucket } from '@helpers/alliance_health_url'
import { from_now_diff } from '@helpers/date'

let overview: AllianceHealthOverview | null = null
let corporations: AllianceHealthCorporations | null = null
let onboarding: AllianceHealthOnboarding | null = null
let attention: AllianceHealthAttention | null = null
let trials: AllianceHealthTrials | null = null
let leave: AllianceHealthLeave | null = null
let data_fetching_error: any

const health_query = Astro.url.searchParams
const initial_bucket: AllianceHealthAttentionBucket = parse_alliance_health_bucket(
    'attention',
    health_query.get('attention'),
)
const initial_trial_bucket: AllianceHealthTrialBucket = parse_alliance_health_bucket(
    'trials',
    health_query.get('trials'),
)
const initial_leave_bucket: AllianceHealthLeaveBucket = parse_alliance_health_bucket(
    'leave',
    health_query.get('leave'),
)
const initial_onboarding_bucket: AllianceHealthOnboardingBucket =
    parse_alliance_health_bucket('onboarding', health_query.get('onboarding'))

try {
    ;[overview, corporations, onboarding, attention, trials, leave] =
        await Promise.all([
            get_alliance_health_overview(auth_token as string),
            get_alliance_health_corporations(auth_token as string),
            get_alliance_health_onboarding(
                auth_token as string,
                initial_onboarding_bucket,
            ),
            get_alliance_health_attention(auth_token as string, initial_bucket),
            get_alliance_health_trials(
                auth_token as string,
                initial_trial_bucket,
            ),
            get_alliance_health_leave(
                auth_token as string,
                initial_leave_bucket,
            ),
        ])
} catch (error) {
    if (error?.cause === 403) return HTTP_403_Forbidden()
    data_fetching_error = error
}

const ATTENTION_PARTIAL_URL = translatePath(
    '/partials/alliance_health_attention_component',
)
const TRIALS_PARTIAL_URL = translatePath(
    '/partials/alliance_health_trials_component',
)
const LEAVE_PARTIAL_URL = translatePath(
    '/partials/alliance_health_leave_component',
)
const ONBOARDING_PARTIAL_URL = translatePath(
    '/partials/alliance_health_onboarding_component',
)

const viewer = overview?.viewer
const can_mutate = viewer?.can_mutate ?? false
const can_leave_any = viewer?.can_leave_any ?? false
const alliance_wide = viewer?.alliance_wide ?? true
const officer_corp_ids = viewer?.officer_corp_ids ?? []
const ceo_corp_ids = viewer?.ceo_corp_ids ?? []
const home_corp_name =
    viewer?.home_corp_id && corporations
        ? corporations.corporations.find(
              (row) => row.corporation_id === viewer.home_corp_id,
          )?.name ?? 'all'
        : 'all'
const initial_corp = alliance_wide ? 'all' : home_corp_name

import Viewport from '@layouts/Viewport.astro'
import PageWide from '@components/page/PageWide.astro'
import PageTitle from '@components/page/PageTitle.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import TextBox from '@components/layout/TextBox.astro'
import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import AllianceHealthSummary from '@components/blocks/AllianceHealthSummary.astro'
import AllianceHealthMonthlyChart from '@components/blocks/AllianceHealthMonthlyChart.astro'
import AllianceHealthTribesChart from '@components/blocks/AllianceHealthTribesChart.astro'
import AllianceHealthAttention from '@components/blocks/AllianceHealthAttention.astro'
import AllianceHealthPilotsTable from '@components/blocks/AllianceHealthPilotsTable.astro'
import AllianceHealthTrials from '@components/blocks/AllianceHealthTrials.astro'
import AllianceHealthTrialsTable from '@components/blocks/AllianceHealthTrialsTable.astro'
import AllianceHealthLeave from '@components/blocks/AllianceHealthLeave.astro'
import AllianceHealthLeaveTable from '@components/blocks/AllianceHealthLeaveTable.astro'
import AllianceHealthOnboarding from '@components/blocks/AllianceHealthOnboarding.astro'
import AllianceHealthOnboardingTable from '@components/blocks/AllianceHealthOnboardingTable.astro'
import AllianceHealthCorpsTable from '@components/blocks/AllianceHealthCorpsTable.astro'

const page_title = t('alliance.health.page_title')
const last_updated_text = overview?.computed_at
    ? t('last_updated_relative').replace(
          '{time}',
          from_now_diff(lang, new Date(overview.computed_at)),
      )
    : ''
---

<Viewport
    title={page_title}
    components={{ alert_dialog: true, confirm_dialog: true }}
>
    <PageWide
        padding_block="var(--space-2xl)"
        cover={{
            image: '/images/alliance-cover.jpg',
            image_990: '/images/alliance-cover.jpg',
            animated: false,
            scrollable: true,
            overlay: true,
        }}
    >
        <Flexblock slot="header" gap="var(--space-3xs)">
            <PageTitle>{page_title}</PageTitle>
            {last_updated_text && <small>{last_updated_text}</small>}
        </Flexblock>

        {
            data_fetching_error ? (
                <ErrorRefetch
                    args={{
                        partial: translatePath('/alliance/health'),
                        error: data_fetching_error,
                        delay: 0,
                    }}
                />
            ) : overview &&
              corporations &&
              onboarding &&
              attention &&
              trials &&
              leave ? (
                <Flexblock gap="var(--space-2xl)">
                    <TextBox>
                        <p class="[ excerpt ]">{t('alliance.health.leading_text')}</p>
                    </TextBox>

                    <AllianceHealthSummary overview={overview} />

                    <Flexblock gap="var(--space-m)">
                        <Flexblock gap="var(--space-3xs)">
                            <h2>{t('alliance.health.monthly.title')}</h2>
                            <small>{t('alliance.health.monthly.caption')}</small>
                        </Flexblock>
                        <ComponentBlock padding_inline="var(--space-m)">
                            <AllianceHealthMonthlyChart
                                monthly={overview.monthly}
                                goal_map={overview.goal_map}
                            />
                        </ComponentBlock>
                    </Flexblock>

                    <Flexblock gap="var(--space-m)">
                        <Flexblock gap="var(--space-3xs)">
                            <h2>{t('alliance.health.onboarding.title')}</h2>
                            <small>{t('alliance.health.onboarding.caption')}</small>
                        </Flexblock>
                        <AllianceHealthOnboarding
                            counts={onboarding.counts}
                            bucket={onboarding.bucket}
                            partial_url={ONBOARDING_PARTIAL_URL}
                            initial_corp={initial_corp}
                        >
                            <AllianceHealthOnboardingTable
                                pilots={onboarding.pilots}
                                initial_corp={initial_corp}
                                bucket={onboarding.bucket}
                            />
                        </AllianceHealthOnboarding>
                    </Flexblock>

                    <Flexblock gap="var(--space-m)">
                        <Flexblock gap="var(--space-3xs)">
                            <h2>{t('alliance.health.attention.title')}</h2>
                            <small>{t('alliance.health.attention.caption')}</small>
                        </Flexblock>
                        <AllianceHealthAttention
                            quiet={overview.quiet}
                            bucket={attention.bucket}
                            partial_url={ATTENTION_PARTIAL_URL}
                            initial_corp={initial_corp}
                            can_mutate={can_mutate}
                            alliance_wide={alliance_wide}
                            officer_corp_ids={officer_corp_ids}
                            can_leave_any={can_leave_any}
                            ceo_corp_ids={ceo_corp_ids}
                        >
                            <AllianceHealthPilotsTable
                                pilots={attention.pilots}
                                initial_corp={initial_corp}
                                can_leave_any={can_leave_any}
                                ceo_corp_ids={ceo_corp_ids}
                                bucket={attention.bucket}
                                partial_url={ATTENTION_PARTIAL_URL}
                            />
                        </AllianceHealthAttention>
                    </Flexblock>

                    {
                        overview.tribes_monthly?.series?.length > 0 && (
                            <Flexblock gap="var(--space-m)">
                                <Flexblock gap="var(--space-3xs)">
                                    <h2>{t('alliance.health.tribes.title')}</h2>
                                    <small>{t('alliance.health.tribes.caption')}</small>
                                </Flexblock>
                                <ComponentBlock padding_inline="var(--space-m)">
                                    <AllianceHealthTribesChart
                                        tribes_monthly={overview.tribes_monthly}
                                    />
                                </ComponentBlock>
                            </Flexblock>
                        )
                    }

                    <Flexblock gap="var(--space-m)">
                        <Flexblock gap="var(--space-3xs)">
                            <h2>{t('alliance.health.trials.title')}</h2>
                            <small>{t('alliance.health.trials.caption')}</small>
                        </Flexblock>
                        <AllianceHealthTrials
                            counts={overview.hygiene?.trial ?? trials.counts}
                            bucket={trials.bucket}
                            partial_url={TRIALS_PARTIAL_URL}
                            initial_corp={initial_corp}
                            can_mutate={can_mutate}
                            alliance_wide={alliance_wide}
                            officer_corp_ids={officer_corp_ids}
                        >
                            <AllianceHealthTrialsTable
                                pilots={trials.pilots}
                                can_promote={
                                    can_mutate &&
                                    (trials.bucket === 'passing' ||
                                        trials.bucket === 'remove' ||
                                        trials.bucket === 'approve')
                                }
                                officer_corp_ids={officer_corp_ids}
                                alliance_wide={alliance_wide}
                                initial_corp={initial_corp}
                                bucket={trials.bucket}
                                partial_url={TRIALS_PARTIAL_URL}
                            />
                        </AllianceHealthTrials>
                    </Flexblock>

                    <Flexblock gap="var(--space-m)">
                        <Flexblock gap="var(--space-3xs)">
                            <h2>{t('alliance.health.leave.title')}</h2>
                            <small>{t('alliance.health.leave.caption')}</small>
                        </Flexblock>
                        <AllianceHealthLeave
                            counts={overview.hygiene?.leave ?? leave.counts}
                            bucket={leave.bucket}
                            partial_url={LEAVE_PARTIAL_URL}
                            initial_corp={initial_corp}
                            can_mutate={can_mutate}
                            alliance_wide={alliance_wide}
                            officer_corp_ids={officer_corp_ids}
                        >
                            <AllianceHealthLeaveTable
                                pilots={leave.pilots}
                                initial_corp={initial_corp}
                                bucket={leave.bucket}
                            />
                        </AllianceHealthLeave>
                    </Flexblock>

                    <Flexblock gap="var(--space-m)">
                        <Flexblock gap="var(--space-3xs)">
                            <h2>{t('alliance.health.corps.title')}</h2>
                            <small>{t('alliance.health.corps.caption')}</small>
                        </Flexblock>
                        <ComponentBlock padding_inline="var(--space-m)">
                            <AllianceHealthCorpsTable
                                corporations={corporations.corporations}
                                initial_corp={initial_corp}
                            />
                        </ComponentBlock>
                    </Flexblock>
                </Flexblock>
            ) : null
        }
    </PageWide>
</Viewport>

<style lang="scss">
    .excerpt {
        font-size: var(--step-1);
        line-height: 1.6;
    }

    h2 {
        margin: 0;
    }

    small {
        color: var(--faded);
    }
</style>
