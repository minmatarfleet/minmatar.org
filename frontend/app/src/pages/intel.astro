---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import { get_gates, can } from '@helpers/gates'
const gates = await get_gates(Astro)

const can_view_timers = can(gates, 'structures.timers.view#strict')
const can_add_moons = can(gates, 'moons.manage#strict')
const can_view_moons = can(gates, 'moons.view#strict')
const can_view_affiliations = can(gates, 'intel.affiliations')

import Viewport from '@layouts/Viewport.astro';

import PageLanding from '@components/page/PageLanding.astro';
import PageTitle from '@components/page/PageTitle.astro';

import TextBox from '@components/layout/TextBox.astro';

import Flexblock from '@components/compositions/Flexblock.astro';

import IntelTiles from '@components/blocks/IntelTiles.astro';

const page_title = t('intel.page_title');
const leading_text = t('intel.leading_text');
---

<Viewport
    title={page_title}
    meta_description={t('intel.meta_description')}
    components={{
        alert_dialog: true,
        confirm_dialog: true,
    }}
>
    <PageLanding
        cover={{
            image: "/images/intel-cover.jpg",
            image_990: "/images/intel-cover.jpg",
            overlay: true,
            scrollable: true,
        }}
        wide={true}
    >
        <Flexblock gap='var(--space-2xl)'>
            <TextBox>
                <PageTitle is_landing={true}>{page_title}</PageTitle>
            </TextBox>
            
            <TextBox>
                <p class="[ excerpt ]">{leading_text}</p>
            </TextBox>
            
            <IntelTiles
                can_view_timers={can_view_timers}
                can_add_moons={can_add_moons}
                can_view_moons={can_view_moons}
                can_view_affiliations={can_view_affiliations}
            />
        </Flexblock>
    </PageLanding>
</Viewport>