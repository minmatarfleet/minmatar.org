---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden, login_redirect } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'
import { get_gates, can } from '@helpers/gates'

const { auth_token, user } = get_request_user(Astro)
if (!auth_token || !user) return login_redirect(Astro)

const gates = await get_gates(Astro)
if (!can(gates, 'structures.timers.correct')) return HTTP_403_Forbidden()

import type { StructurePing, StructureTimer } from '@dtypes/api.minmatar.org'
import { get_structure_pings, get_structure_timers } from '@helpers/api.minmatar.org/structures'

let timers: StructureTimer[] = []
let pings: StructurePing[] = []
let data_fetching_error: Error | false = false

try {
    ;[timers, pings] = await Promise.all([
        get_structure_timers(auth_token, false),
        get_structure_pings(auth_token, false),
    ])
    timers = [...timers].sort((a, b) => new Date(b.timer).getTime() - new Date(a.timer).getTime()).slice(0, 100)
} catch (error) {
    if (error?.cause === 403) return HTTP_403_Forbidden()
    data_fetching_error = error
}

const tabs = [
    { id: 'timers', label: t('structure_timers_manage.tab.timers'), meta: String(timers.length) },
    { id: 'pings', label: t('structure_timers_manage.tab.pings') },
]

const page_title = t('structure_timers_manage.page_title')

import Viewport from '@layouts/Viewport.astro'
import PageWide from '@components/page/PageWide.astro'
import PageTitle from '@components/page/PageTitle.astro'
import PageActions from '@components/page/PageActions.astro'

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'

import Button from '@components/blocks/Button.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import SectionTabs from '@components/blocks/SectionTabs.astro'
import SectionTabPanel from '@components/blocks/SectionTabPanel.astro'
import StructurePingsPanel from '@components/blocks/StructurePingsPanel.astro'
import StructureTimersManager from '@components/blocks/StructureTimersManager.astro'
---

<Viewport title={page_title} meta_description={t('page_finder.intel.timers.manage.description')}>
    <PageWide
        cover={{
            image: '/images/intel-cover.jpg',
            image_990: '/images/intel-cover-990.jpg',
            alt: t('intel.cover_alt'),
            animated: false,
            scrollable: true,
            overlay: true,
        }}
    >
        <FlexInline slot="header" justification="space-between" class="[ w-full ]">
            <PageTitle>{page_title}</PageTitle>
            <PageActions>
                <Button href={translatePath('/intel/timers/active/')}>{t('structure_timers_manage.back')}</Button>
            </PageActions>
        </FlexInline>

        <Flexblock gap="var(--space-l)">
            <p>{t('structure_timers_manage.leading_text')}</p>
            {data_fetching_error ?
                <ErrorRefetch args={{ partial: translatePath('/partials/structure_timers_manage_component'), error: data_fetching_error, delay: 0 }} />
                :
                <SectionTabs aria_label={t('structure_timers_manage.tabs_label')} id_prefix="structure-timers-manage" tabs={tabs}>
                    <SectionTabPanel id="timers" id_prefix="structure-timers-manage" is_default={true}>
                        <StructureTimersManager timers={timers} />
                    </SectionTabPanel>
                    <SectionTabPanel id="pings" id_prefix="structure-timers-manage">
                        <StructurePingsPanel pings={pings} />
                    </SectionTabPanel>
                </SectionTabs>
            }
        </Flexblock>
    </PageWide>
</Viewport>
