---
import { i18n } from '@helpers/i18n'
const { t, translatePath, lang } = i18n(Astro.url)

import { HTTP_403_Forbidden, login_redirect } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'
import { get_gates, can } from '@helpers/gates'

const { auth_token, user } = get_request_user(Astro)
if (!auth_token || !user) return login_redirect(Astro)

const gates = await get_gates(Astro)
if (!can(gates, 'structures.timers.correct')) return HTTP_403_Forbidden()

import type { StructurePing, StructureTimer } from '@dtypes/api.minmatar.org'
import { get_structure_pings, get_structure_timers } from '@helpers/api.minmatar.org/structures'

let timers: StructureTimer[] = []
let pings: StructurePing[] = []
let data_fetching_error: Error | false = false

try {
    ;[timers, pings] = await Promise.all([
        get_structure_timers(auth_token, false),
        get_structure_pings(auth_token, false),
    ])
} catch (error) {
    if (error?.cause === 403) return HTTP_403_Forbidden()
    data_fetching_error = error
}

const failed_pings = pings.filter((ping) => !ping.discord_success).length
const tabs = [
    { id: 'timers', label: t('manage.timers.tab_timers') },
    {
        id: 'pings',
        label: t('manage.timers.tab_pings'),
        ...(failed_pings > 0 && { meta: t('manage.timers.failed_count').replace('~COUNT', String(failed_pings)), flag: 'attention' as const }),
    },
]

const page_title = t('manage.timers.title')

import Viewport from '@layouts/Viewport.astro'
import PageLanding from '@components/page/PageLanding.astro'
import PageBreadcrumbs from '@components/page/PageBreadcrumbs.astro'
import Flexblock from '@components/compositions/Flexblock.astro'

import Button from '@components/blocks/Button.astro'
import ErrorRefetch from '@components/blocks/ErrorRefetch.astro'
import SectionTabs from '@components/blocks/SectionTabs.astro'
import SectionTabPanel from '@components/blocks/SectionTabPanel.astro'
import ManageHero from '@components/blocks/manage/ManageHero.astro'
import StructurePingsPanel from '@components/blocks/StructurePingsPanel.astro'
import StructureTimersManager from '@components/blocks/StructureTimersManager.astro'
---

<Viewport title={page_title} meta_description={t('page_finder.intel.timers.manage.description')}>
<PageLanding wide={true} lang={lang}>
    <Flexblock gap="var(--space-xl)">
        <Flexblock gap="var(--space-m)">
            <PageBreadcrumbs
                is_landing_page={true}
                links_only={true}
                breadcrumbs={[
                    { page_title: t('structure_timers'), accumulated_path: translatePath('/intel/timers/active/') },
                    { page_title: t('manage.timers.crumb_manage'), accumulated_path: translatePath('/intel/timers/manage/') },
                ]}
            />
            <ManageHero title={page_title} role={t('manage.timers.role')} fact={t('manage.timers.fact')}>
                <Fragment slot="actions">
                    <Button color="transparent" href={translatePath('/intel/timers/active/')}>{t('manage.timers.active')}</Button>
                    {can(gates, 'structures.timers.manage') &&
                        <Button href={translatePath('/intel/timers/add/')}>{t('manage.timers.add')}</Button>
                    }
                </Fragment>
            </ManageHero>
        </Flexblock>

        {data_fetching_error ?
            <div>
                <ErrorRefetch args={{ partial: translatePath('/partials/structure_timers_manage_component/?part=list'), error: data_fetching_error, delay: 0 }} />
            </div>
            :
            <SectionTabs aria_label={t('manage.timers.tabs')} id_prefix="structure-timers-manage" tabs={tabs}>
                <SectionTabPanel id="timers" id_prefix="structure-timers-manage" is_default={true}>
                    <StructureTimersManager timers={timers} />
                </SectionTabPanel>
                <SectionTabPanel id="pings" id_prefix="structure-timers-manage">
                    <StructurePingsPanel pings={pings} />
                </SectionTabPanel>
            </SectionTabs>
        }
    </Flexblock>
</PageLanding>
</Viewport>
