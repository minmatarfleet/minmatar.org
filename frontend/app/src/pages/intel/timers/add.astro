---
/**
 * Adding a timer is the shared Add a timer dialog now (TimerAddDialog). Old
 * links land where that dialog lives: the campaign's Timers tab, or the
 * timer board.
 */
import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

const campaign_slug = Astro.url.searchParams.get('campaign_slug')
const target = campaign_slug
    ? `/campaigns/${encodeURIComponent(campaign_slug)}/#timers`
    : '/intel/timers/active/'

return Astro.redirect(translatePath(target), 301)
---
