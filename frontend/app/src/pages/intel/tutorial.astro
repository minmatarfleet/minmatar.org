---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import { is_prod_mode } from '@helpers/env'
import { HTTP_404_Not_Found } from '@helpers/http_responses'

import { get_request_user } from '@helpers/request_user'

const { auth_token, user } = get_request_user(Astro)

import { get_gates, can } from '@helpers/gates'
const gates = await get_gates(Astro)

if (is_prod_mode() && !can(gates, 'site.debug_pages'))
    return HTTP_404_Not_Found()

import Viewport from '@layouts/Viewport.astro';

import PageYTVideo from '@components/page/PageYTVideo.astro';

import Flexblock from '@components/compositions/Flexblock.astro';

const page_title = t('intel.tutrial.page_title');
---

<Viewport
    title={page_title}
    components={{
        modal: true,
    }}
>
    <PageYTVideo
        cover={{
            image: "/images/intel-cover.jpg",
            image_990: "/images/intel-cover.jpg",
            animated: false,
            scrollable: true,
            overlay: true
        }}
        video={{
            id: 'ANKrefcxGNo',
            title: 'Structure Intel Course - EVE Online',
            credits: {
                character_id: 634915984,
                character_name: 'BearThatCares',
            }
        }}
    >
        <Flexblock gap="var(--space-l)" class="[ slide-in ]">
            <h1>{t('intel.tutrial.page_title')}</h1>
            <p>{t('intel.tutrial.leading_text')}</p>
        </Flexblock>
    </PageYTVideo>
</Viewport>

<style lang="scss">
	.markdown {
		font-size: var(--step-0);
	}
</style>