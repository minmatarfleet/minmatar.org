---
// Moved to /dscan/<id>/. Installed desktop apps keep opening this path
// (desktop/src/main/web_routes.js), so it stays as a permanent redirect.
import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

const report_id = Astro.params.report_id ?? ''
return Astro.redirect(translatePath(`/dscan/${encodeURIComponent(report_id)}/`), 301)
---
