---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { HTTP_403_Forbidden } from '@helpers/http_responses'

import type { User } from '@dtypes/jwt'
import * as jose from 'jose'

const auth_token = Astro.cookies.has('auth_token') ? (Astro.cookies.get('auth_token')?.value as string) : false
const user:User | false = auth_token ? jose.decodeJwt(auth_token) as User : false
const is_superuser = (user ? user?.is_superuser : false)

if (!user) return Astro.redirect(`${translatePath('/redirects/auth_init')}?redirect_url=${Astro.url}`)

import { get_user_permissions } from '@helpers/permissions'
const user_permissions = (user ? await get_user_permissions(user?.username) : [])

if (!is_superuser && !user_permissions.includes('structures.add_evestructuretimer'))
    return HTTP_403_Forbidden()

import { attach_campaign_structure, get_campaigns } from '@helpers/api.minmatar.org/campaigns'
import { structure_types, structure_states } from '@dtypes/api.minmatar.org'
import type {
    CampaignListItem,
    CampaignStructureAttachRequest,
    StructureState,
    StructureType,
} from '@dtypes/api.minmatar.org'
import type { Alert } from '@dtypes/layout_components'

const campaign_slug = Astro.url.searchParams.get('campaign_slug') ?? ''
let live_campaigns:CampaignListItem[] = []
let selected_campaign_slug = campaign_slug

try {
    live_campaigns = (await get_campaigns(auth_token as string)).filter(
        campaign => campaign.status === 'active' || campaign.status === 'scheduled'
    )
    if (campaign_slug && !live_campaigns.find(campaign => campaign.slug === campaign_slug))
        selected_campaign_slug = ''
} catch (error) {
    console.log(error)
}

let report_error:string | false = false
let alert:Alert | false = false

const parse_reinforce_hour = (raw:string):number | null => {
    if (!raw) return null
    const hour = parseInt(raw.split(':')[0] ?? '', 10)
    if (!Number.isFinite(hour) || hour < 0 || hour > 23) return null
    return hour
}

if (Astro.request.method === "POST") {
    try {
        const data = await Astro.request.formData()
        const slug = (data.get('campaign_slug') as string) || ''
        if (!slug)
            throw new Error(t('intel.add_structure.campaign_required'))

        const reinforce_raw = (data.get('reinforce_hour') as string) || ''
        const reinforce_hour = parse_reinforce_hour(reinforce_raw)
        if (reinforce_raw && reinforce_hour === null)
            throw new Error(t('intel.add_structure.reinforce_hour_invalid'))

        const create_timer = data.get('create_timer') === 'on'
        const timer_date = data.get('timer_date') as string
        const timer_time = data.get('timer_time') as string
        let timer_at:string | null = null
        let timer_state:StructureState | null = null

        if (create_timer) {
            if (!timer_date || !timer_time)
                throw new Error(t('intel.add_structure.timer_required'))
            const parsed = new Date(`${timer_date} ${timer_time}`)
            if (Number.isNaN(parsed.getTime()))
                throw new Error(t('intel.add_structure.timer_required'))
            timer_at = parsed.toISOString()
            timer_state = data.get('timer_state') as StructureState
        }

        const corporation_id = Number(data.get('corporation_id'))
        const related_alliance_id = Number(data.get('related_alliance_id'))

        const payload:CampaignStructureAttachRequest = {
            name: data.get('structure_name') as string,
            structure_type: data.get('structure_type') as StructureType,
            system_name: data.get('system') as string,
            corporation_name: (data.get('corporation_name') as string) || '',
            corporation_id: Number.isInteger(corporation_id) && corporation_id > 0 ? corporation_id : null,
            related_alliance_name: (data.get('related_alliance_name') as string) || '',
            related_alliance_id: Number.isInteger(related_alliance_id) && related_alliance_id > 0 ? related_alliance_id : null,
            fitting: (data.get('fitting') as string) || '',
            reinforce_hour,
            timer_at,
            timer_state,
        }

        await attach_campaign_structure(slug, auth_token as string, payload)

        return Astro.redirect(translatePath(`/campaigns/${slug}/#structures`))
    } catch (error) {
        report_error = error.message
        alert = {
            title: t('intel.add_structure.submit_error_title'),
            content: report_error,
        }
    }
}

import { get_item_icon } from '@helpers/eve_image_server'
import { get_structure_id } from '@helpers/eve'

const STRUCTURE_ICONS = {}
structure_types.forEach((type) => STRUCTURE_ICONS[type] = get_item_icon(get_structure_id(type)))

import Viewport from '@layouts/Viewport.astro'
import PageTitle from '@components/page/PageTitle.astro'
import PageAside from '@components/page/PageAside.astro'
import PageActions from '@components/page/PageActions.astro'

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import FixedFluid from '@components/compositions/FixedFluid.astro'

import Button from '@components/blocks/Button.astro'
import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import Input from '@components/blocks/Input.astro'
import Select from '@components/blocks/Select.astro'
import Textarea from '@components/blocks/Textarea.astro'
import ButtonStack from '@components/blocks/ButtonStack.astro'
import VerticalCenter from '@components/blocks/VerticalCenter.astro'
import FlatPicker from '@components/blocks/FlatPicker.astro'
import SwitchSquare from '@components/blocks/SwitchSquare.astro'

import MagnifierIcon from '@components/icons/buttons/MagnifierIcon.astro'
import TutorialIcon from '@components/icons/TutorialIcon.astro'
import PlayIcon from '@components/icons/buttons/PlayIcon.astro'

const page_title = t('intel.add_structure.page_title')
---

<Viewport
    title={page_title}
    components={{
        alert_dialog: true
    }}
>
    <PageAside
        cover={{
            image: "/images/intel-cover.jpg",
            image_990: "/images/intel-cover.jpg",
            animated: false,
            scrollable: true,
            overlay: true
        }}
        x-data={`{
            structure_type: 'fortizar',
            structure_name: '',
            submitted: false,
            get_structure_icon(name) {
                const structure_ids = ${JSON.stringify(STRUCTURE_ICONS)}
                return structure_ids[name]
            },
            init() {
                ${alert !== false ? `show_alert_dialog(${JSON.stringify(alert)})` : ''}
            }
        }`}
    >
        <FlexInline slot="header" justification='space-between' class="[ w-full ]">
            <FlexInline>
                <img
                    loading="lazy"
                    height="64"
                    width="64"
                    src={get_item_icon(get_structure_id('fortizar'))}
                    x-bind:src={`get_structure_icon(structure_type)`}
                    alt=""
                />
                <PageTitle x-text={`structure_name != '' ? structure_name : '${page_title}'`} />
            </FlexInline>
            <PageActions>
                <Button href={translatePath('/intel/timers/active/')}>
                    <MagnifierIcon slot="icon" />
                    {t('view_structure_timers')}
                </Button>
            </PageActions>
        </FlexInline>

        <Flexblock gap='var(--space-xl)'>
            <ComponentBlock>
                <Flexblock class="[ w-full ]" gap='var(--space-m)'>
                    <Flexblock gap='var(--space-3xs)'>
                        <h2>{t('structure_information')}</h2>
                        <p>{t('intel.add_structure.leading_text')}</p>
                    </Flexblock>

                    <form
                        method="POST"
                        x-on:submit="submitted = true"
                    >
                        <Flexblock>
                            <VerticalCenter>
                                <FixedFluid class="[ w-full items-center ]" gap="var(--space-3xs)" width="250px" breakpoint="60%">
                                    <label for="campaign_slug">{t('intel.add_structure.campaign')}</label>
                                    <Select id="campaign_slug" name="campaign_slug" required>
                                        <option value="">{t('campaigns.structures.no_campaign')}</option>
                                        {live_campaigns.map(campaign =>
                                            <option
                                                value={campaign.slug}
                                                selected={campaign.slug === selected_campaign_slug}
                                            >
                                                {campaign.name}
                                            </option>
                                        )}
                                    </Select>
                                </FixedFluid>
                            </VerticalCenter>

                            <VerticalCenter>
                                <FixedFluid class="[ w-full items-center ]" gap="var(--space-3xs)" width="250px" breakpoint="60%">
                                    <label for="structure_name">{t('structure_name')}</label>
                                    <Input id="structure_name" name="structure_name" type="text" x-model="structure_name" required />
                                </FixedFluid>
                            </VerticalCenter>

                            <VerticalCenter>
                                <FixedFluid class="[ w-full items-center ]" gap="var(--space-3xs)" width="250px" breakpoint="60%">
                                    <label for="structure_type">{t('structure_type')}</label>
                                    <FixedFluid
                                        class="[ w-full items-center ]"
                                        gap="0"
                                        width="64px"
                                        breakpoint="60%"
                                    >
                                        <img
                                            loading="lazy"
                                            height="64"
                                            width="64"
                                            src={get_item_icon(get_structure_id('fortizar'))}
                                            x-bind:src={`get_structure_icon(structure_type)`}
                                            alt=""
                                        />
                                        <Select id="structure_type" name="structure_type" x-model="structure_type" required>
                                            {structure_types.map(type =>
                                                <option value={type}>{t(type as any) ?? type}</option>
                                            )}
                                        </Select>
                                    </FixedFluid>
                                </FixedFluid>
                            </VerticalCenter>

                            <VerticalCenter>
                                <FixedFluid class="[ w-full items-center ]" gap="var(--space-3xs)" width="250px" breakpoint="60%">
                                    <label for="system">{t('system')}</label>
                                    <Input id="system" name="system" type="text" required />
                                </FixedFluid>
                            </VerticalCenter>

                            <FixedFluid class="[ w-full items-start ]" gap="var(--space-3xs)" width="250px" breakpoint="60%">
                                <label for="corporation_name">{t('intel.add_structure.owner_corporation')}</label>
                                <Flexblock gap="var(--space-3xs)">
                                    <div class="entity-field">
                                        <Input
                                            id="corporation_name"
                                            name="corporation_name"
                                            type="text"
                                            required
                                            autocomplete="off"
                                            placeholder={t('intel.add_structure.search_placeholder')}
                                            hx-get={`${translatePath('/partials/entity_search_component')}?kind=corporation`}
                                            hx-trigger="keyup changed delay:300ms"
                                            hx-target="#corporation_name-results"
                                            hx-swap="innerHTML"
                                            oninput="document.getElementById('corporation_id').value=''"
                                        />
                                        <div id="corporation_name-results" class="entity-results"></div>
                                    </div>
                                    <input type="hidden" id="corporation_id" name="corporation_id" value="" />
                                    <small class="[ field-hint ]">{t('intel.add_structure.owner_corporation_hint')}</small>
                                </Flexblock>
                            </FixedFluid>

                            <FixedFluid class="[ w-full items-start ]" gap="var(--space-3xs)" width="250px" breakpoint="60%">
                                <label for="related_alliance_name">{t('intel.add_structure.related_alliance')}</label>
                                <Flexblock gap="var(--space-3xs)">
                                    <div class="entity-field">
                                        <Input
                                            id="related_alliance_name"
                                            name="related_alliance_name"
                                            type="text"
                                            required
                                            autocomplete="off"
                                            placeholder={t('intel.add_structure.search_placeholder')}
                                            hx-get={`${translatePath('/partials/entity_search_component')}?kind=alliance`}
                                            hx-trigger="keyup changed delay:300ms"
                                            hx-target="#related_alliance_name-results"
                                            hx-swap="innerHTML"
                                            oninput="document.getElementById('related_alliance_id').value=''"
                                        />
                                        <div id="related_alliance_name-results" class="entity-results"></div>
                                    </div>
                                    <input type="hidden" id="related_alliance_id" name="related_alliance_id" value="" />
                                    <small class="[ field-hint ]">{t('intel.add_structure.related_alliance_hint')}</small>
                                </Flexblock>
                            </FixedFluid>

                            <FixedFluid class="[ w-full items-start ]" gap="var(--space-3xs)" width="250px" breakpoint="60%">
                                <label for="reinforce_hour">{t('intel.add_structure.reinforce_hour')}</label>
                                <Flexblock gap="var(--space-3xs)">
                                    <Input
                                        id="reinforce_hour"
                                        name="reinforce_hour"
                                        type="time"
                                        step="3600"
                                    />
                                    <small class="[ field-hint ]">{t('intel.add_structure.reinforce_hour_hint')}</small>
                                </Flexblock>
                            </FixedFluid>

                            <VerticalCenter>
                                <Flexblock class="[ w-full ]" gap="var(--space-3xs)">
                                    <label for="fitting">{t('fitting')}</label>
                                    <Textarea
                                        id="fitting"
                                        name="fitting"
                                        rows="10"
                                        placeholder={t('intel.add_structure.fitting_placeholder')}
                                    />
                                </Flexblock>
                            </VerticalCenter>

                            <SwitchSquare
                                class="[ w-full ]"
                                name="create_timer"
                                label={t('intel.add_structure.create_timer_label')}
                                description={t('intel.add_structure.create_timer_description')}
                            />

                            <Flexblock>
                                <VerticalCenter>
                                    <FixedFluid class="[ w-full items-center ]" gap="var(--space-3xs)" width="250px" breakpoint="60%">
                                        <label for="timer_state">{t('state')}</label>
                                        <Select id="timer_state" name="timer_state">
                                            {structure_states.map(state =>
                                                <option value={state}>{t(state as any) ?? state}</option>
                                            )}
                                        </Select>
                                    </FixedFluid>
                                </VerticalCenter>
                                <VerticalCenter>
                                    <FixedFluid class="[ w-full items-center ]" gap="var(--space-3xs)" width="250px" breakpoint="60%">
                                        <label for="timer_date">{t('intel.add_structure.timer_date')}</label>
                                        <FlatPicker
                                            id="timer_date"
                                            type="date"
                                            name="timer_date"
                                            options={{
                                                minDate: "today",
                                            } as any}
                                        />
                                    </FixedFluid>
                                </VerticalCenter>
                                <VerticalCenter>
                                    <FixedFluid class="[ w-full items-center ]" gap="var(--space-3xs)" width="250px" breakpoint="60%">
                                        <label for="timer_time">{t('intel.add_structure.timer_time')}</label>
                                        <FlatPicker
                                            id="timer_time"
                                            name="timer_time"
                                            options={{
                                                enableTime: true,
                                                noCalendar: true,
                                                dateFormat: "H:i",
                                                time_24hr: true,
                                            } as any}
                                        />
                                    </FixedFluid>
                                </VerticalCenter>
                            </Flexblock>

                            <Button x-bind:disabled="submitted" type="submit" color={'green'} class="[ w-full ]">
                                {t('intel.add_structure.submit')}
                            </Button>
                        </Flexblock>
                    </form>
                </Flexblock>
            </ComponentBlock>
        </Flexblock>

        <ComponentBlock slot="aside" class="sticky top-[var(--sticky-top)]">
            <Flexblock>
                <FixedFluid width="48" class="[ items-center ]">
                    <TutorialIcon />
                    <h2>{t('intel.tutrial.page_title')}</h2>
                </FixedFluid>

                <p>{t('intel.add_structure.aside_text')}</p>

                <ButtonStack>
                    <Button href={translatePath('/intel/tutorial/')}>
                        <PlayIcon slot="icon" />
                        {t('how_to_scan')}
                    </Button>
                </ButtonStack>
            </Flexblock>
        </ComponentBlock>
    </PageAside>
</Viewport>

<script is:inline>
    function pick_entity(button) {
        const input = document.getElementById(button.dataset.input)
        const hidden = document.getElementById(button.dataset.hidden)
        const results = document.getElementById(button.dataset.results)
        if (input) input.value = button.dataset.name || ''
        if (hidden) hidden.value = button.dataset.id || ''
        if (results) results.innerHTML = ''
    }
</script>

<style lang="scss">
    .field-hint {
        color: var(--highlight);
        line-height: 1.35;
    }

    .entity-field {
        position: relative;
    }

    .entity-results:not(:empty) {
        position: absolute;
        z-index: var(--sticky-z-index);
        inset-inline: 0;
        top: 100%;
        margin-block-start: var(--space-3xs);
        background-color: var(--background);
        border: 1px solid var(--border-color);
        max-block-size: calc(var(--space-xl) * 8);
        overflow: auto;
    }
</style>
