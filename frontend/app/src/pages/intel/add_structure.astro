---
/**
 * Reporting a structure is the shared Report a structure dialog now
 * (StructureReportDialog). Old links land where that dialog lives: the
 * campaign's Structures tab, or Universe > Structures.
 */
import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

const campaign_slug = Astro.url.searchParams.get('campaign_slug')
const target = campaign_slug
    ? `/campaigns/${encodeURIComponent(campaign_slug)}/#structures`
    : '/universe/#structures'

return Astro.redirect(translatePath(target), 301)
---
