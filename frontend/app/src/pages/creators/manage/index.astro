---
import { i18n } from '@helpers/i18n'
const { t, translatePath, lang } = i18n(Astro.url)

import { HTTP_403_Forbidden, login_redirect } from '@helpers/http_responses'
import { get_request_user } from '@helpers/request_user'
import { get_gates, can } from '@helpers/gates'

const { auth_token, user } = get_request_user(Astro)
if (!auth_token || !user) return login_redirect(Astro)
if (!can(await get_gates(Astro), 'creators.moderate')) return HTTP_403_Forbidden()

const page_title = t('creators_moderation.page_title')

const breadcrumbs = [
    { page_title: t('creators_manage.crumb_creators'), accumulated_path: translatePath('/creators/') },
    { page_title: t('creators_manage.crumb_moderation'), accumulated_path: translatePath('/creators/manage/') },
]

import Viewport from '@layouts/Viewport.astro'
import PageLanding from '@components/page/PageLanding.astro'
import PageBreadcrumbs from '@components/page/PageBreadcrumbs.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import LazyPartial from '@components/blocks/LazyPartial.astro'
import ManageHero from '@components/blocks/manage/ManageHero.astro'
---

<Viewport title={page_title} meta_description={t('creators_moderation.description')}>
<PageLanding wide={true} lang={lang}>
    <Flexblock gap="var(--space-xl)">
        <Flexblock gap="var(--space-m)">
            <PageBreadcrumbs is_landing_page={true} links_only={true} breadcrumbs={breadcrumbs} />
            <ManageHero
                title={t('creators_manage.title')}
                role={t('creators_manage.role')}
                fact={t('creators_manage.fact')}
            />
        </Flexblock>

        <LazyPartial url={translatePath('/partials/creators_moderation_component/')} swap="outerHTML">
            <p class="[ loading ]">{t('loading')}</p>
        </LazyPartial>
    </Flexblock>
</PageLanding>
</Viewport>
