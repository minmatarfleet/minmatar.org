---
import { get_issue } from '@/data/newsletter'
import { HTTP_404_Not_Found } from '@helpers/http_responses'
import NewsletterLanding from '@components/blocks/newsletter/NewsletterLanding.astro'

const slug = Astro.params.issue ?? ''
const issue = get_issue(slug)

if (!issue) {
    return HTTP_404_Not_Found()
}
---

<NewsletterLanding issue={issue} canonical_path={issue.permalink_path} />
