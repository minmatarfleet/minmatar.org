---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { User } from '@dtypes/jwt'
import * as jose from 'jose'

import type {
    LearningCertificate,
    LearningMeResponse,
    LearningPersona,
    LearningPersonaRecommendation,
} from '@dtypes/api.minmatar.org'
import {
    get_learning_certificates,
    get_learning_me,
    get_learning_persona_recommendation,
} from '@helpers/api.minmatar.org/learning'
import { get_characters_summary_sorted } from '@helpers/fetching/characters'
import { get_user_permissions } from '@helpers/permissions'
import { PERSONA_COOKIE } from '@helpers/learning'

import Viewport from '@layouts/Viewport.astro'
import PageLanding from '@components/page/PageLanding.astro'
import PageTitle from '@components/page/PageTitle.astro'
import TextBox from '@components/layout/TextBox.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import LearningCenterHub from '@components/blocks/LearningCenterHub.astro'

const auth_token = Astro.cookies.has('auth_token')
    ? Astro.cookies.get('auth_token')!.value
    : ''

const cookie_persona = Astro.cookies.has(PERSONA_COOKIE)
    ? (Astro.cookies.get(PERSONA_COOKIE)!.value as LearningPersona)
    : null

const query_persona = Astro.url.searchParams.get('persona') as LearningPersona | null
const unavailable = Astro.url.searchParams.get('unavailable') === '1'

let me: LearningMeResponse | null = null
let recommendation: LearningPersonaRecommendation | null = null
let readiness_character_id = 0

if (auth_token) {
    try {
        const user = jose.decodeJwt(auth_token) as User
        ;[me, recommendation] = await Promise.all([
            get_learning_me(auth_token),
            get_learning_persona_recommendation(auth_token),
        ])

        const user_permissions = await get_user_permissions(user?.username)
        if (user_permissions.includes('eveonline.add_evecharactertag')) {
            const character_summary = await get_characters_summary_sorted(auth_token)
            readiness_character_id = character_summary.characters?.[0]?.character_id ?? 0
        }
    } catch (e) {
        console.error(e)
    }
}

const valid_personas = new Set(['alliance', 'militia', 'other'])
const persona_candidates = [
    query_persona,
    me?.persona,
    cookie_persona,
    recommendation?.persona,
].filter((p): p is LearningPersona => !!p && valid_personas.has(p))

const persona = persona_candidates[0] ?? null
const persona_confirmed = Boolean(me?.persona_confirmed || cookie_persona || query_persona)

// Logged-in first visit: show picker with recommendation pre-selected.
const show_persona_gate =
    !persona_confirmed ||
    (Boolean(auth_token) && me !== null && !me.persona_confirmed && !query_persona && !cookie_persona)

let certificates: LearningCertificate[] = []
let certificates_error = false
try {
    certificates = await get_learning_certificates(
        show_persona_gate ? null : persona,
    )
} catch (e) {
    console.error(e)
    certificates_error = true
}

const completed_slugs = me?.completed_learning_slugs ?? []

const page_title = t('learning_center.page_title')
---

<Viewport
    title={page_title}
    meta_description={t('learning_center.meta_description')}
    components={{
        alert_dialog: true,
    }}
>
    <PageLanding
        cover={{
            image: '/images/alliance-cover.jpg',
            image_990: '/images/alliance-cover.jpg',
            overlay: true,
            scrollable: true,
        }}
        wide={true}
    >
        <Flexblock gap="var(--space-2xl)">
            {unavailable &&
                <TextBox>
                    <p class="[ excerpt ]">{t('learning_center.certificate_unavailable')}</p>
                </TextBox>
            }
            <LearningCenterHub
                certificates={show_persona_gate ? [] : certificates}
                certificates_error={!show_persona_gate && certificates_error}
                completed_slugs={completed_slugs}
                persona={persona}
                recommendation={recommendation}
                auth_token={auth_token}
                needs_persona={show_persona_gate}
                persona_confirmed_on_server={Boolean(me?.persona_confirmed)}
                readiness_character_id={readiness_character_id}
            >
                <Flexblock slot="intro" gap="var(--space-l)">
                    <TextBox>
                        <PageTitle is_landing={true}>{page_title}</PageTitle>
                    </TextBox>
                    <TextBox>
                        <p class="[ excerpt ]">{t('learning_center.leading_text')}</p>
                    </TextBox>
                </Flexblock>
            </LearningCenterHub>
        </Flexblock>
    </PageLanding>
</Viewport>
