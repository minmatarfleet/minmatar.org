---
import { i18n } from '@helpers/i18n'
const { t, lang, translatePath } = i18n(Astro.url)

import { get_voice_session, VOICE_RETURNING_COOKIE } from '@helpers/voice_session'
import { login_url } from '@helpers/http_responses'

// No gate: guests (NPSI pilots, campaign allies) use this page too.
const session = get_voice_session(Astro)
const login_failed = Astro.url.searchParams.get('error') !== null
// This browser connected before: a lapsed sign-in offers "Sign in and connect".
const returning = Astro.cookies.get(VOICE_RETURNING_COOKIE)?.value === '1'
// Back from "Sign in and connect": open Mumble without another click.
const auto_connect = Astro.url.searchParams.get('connect') === '1'

const SIGN_IN_URL = translatePath('/voice/sign-in')
const STATUS_PARTIAL_URL = `${translatePath('/partials/voice_status_component/')}${auto_connect ? '?connect=1' : ''}`
const SITE_LOGIN_URL = login_url(Astro, new URL(translatePath('/voice'), Astro.url).href)
const page_title = t('voice.page_title')

const sign_in_points = [
    { title: t('voice.sign_in.public'), text: t('voice.sign_in.public_text') },
    { title: t('voice.sign_in.no_account'), text: t('voice.sign_in.no_account_text') },
    { title: t('voice.sign_in.no_typing'), text: t('voice.sign_in.no_typing_text') },
]

import Viewport from '@layouts/Viewport.astro'
import PageLanding from '@components/page/PageLanding.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import Grid from '@components/compositions/Grid.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import Button from '@components/blocks/Button.astro'
import LazyPartial from '@components/blocks/LazyPartial.astro'
---

<Viewport title={page_title} meta_description={t('voice.meta_description')}>
<PageLanding lang={lang}>
    <Flexblock gap="var(--space-xl)">
        <Flexblock gap="var(--space-s)">
            <h1>{page_title}</h1>
            <p class="[ voice-lead ]">{t('voice.lead')}</p>
        </Flexblock>

        {login_failed &&
            <p class="[ voice-error ]" role="alert">{t('voice.login.failed')}</p>
        }

        {session
            ? <LazyPartial url={STATUS_PARTIAL_URL}>
                <p>{t('loading')}</p>
            </LazyPartial>
            : returning
                ? <ComponentBlock>
                    <Flexblock gap="var(--space-m)">
                        <Flexblock gap="var(--space-2xs)">
                            <small>{t('voice.welcome_back')}</small>
                            <h2>{t('voice.welcome_back.title')}</h2>
                            <p>{t('voice.welcome_back.text')}</p>
                        </Flexblock>
                        <FlexInline gap="var(--space-m)">
                            <Button href={`${SIGN_IN_URL}?then=connect`} color="green">{t('voice.welcome_back.title')}</Button>
                            <img src="/images/mumble-logo.svg" alt="" width="40" height="40" />
                        </FlexInline>
                        <FlexInline gap="var(--space-m)">
                            <a href={SIGN_IN_URL}>{t('voice.welcome_back.setup')}</a>
                            <a href={SITE_LOGIN_URL}>{t('voice.sign_in.site')}</a>
                        </FlexInline>
                    </Flexblock>
                </ComponentBlock>
                : <ComponentBlock>
                    <Flexblock gap="var(--space-m)">
                        <Flexblock gap="var(--space-2xs)">
                            <h2>{t('voice.sign_in.title')}</h2>
                            <p>{t('voice.sign_in.text')}</p>
                        </Flexblock>
                        <FlexInline gap="var(--space-m)">
                            <Button href={SIGN_IN_URL}>{t('voice.sign_in.button')}</Button>
                            <a href={SITE_LOGIN_URL}>{t('voice.sign_in.site')}</a>
                        </FlexInline>
                        <Grid min_item_width="12rem" row_gap="var(--space-s)" column_gap="var(--space-s)">
                            {sign_in_points.map((point) =>
                                <Flexblock gap="var(--space-3xs)">
                                    <strong class="[ voice-point ]">{point.title}</strong>
                                    <small>{point.text}</small>
                                </Flexblock>
                            )}
                        </Grid>
                    </Flexblock>
                </ComponentBlock>
        }
    </Flexblock>
</PageLanding>
</Viewport>

<style lang="scss">
    .voice-lead {
        max-width: 60ch;
        color: var(--faded);
        font-size: var(--step-0);
    }

    .voice-error {
        color: var(--fleet-red-text);
    }

    .voice-point {
        color: var(--highlight);
    }
</style>
