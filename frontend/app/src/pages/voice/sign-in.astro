---
// Starts the EVE sign-in for /voice. The random state goes in a cookie here
// and through EVE SSO; /voice/login keeps the token only when they match,
// so a link carrying someone else's token can't sign this browser in.
import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

import { get_app_url } from '@helpers/env'
import { VOICE_LOGIN_STATE_COOKIE, VOICE_LOGIN_STATE_MINUTES, new_login_state } from '@helpers/voice_session'
import { voice_login_url } from '@helpers/api.minmatar.org/voice'

const state = new_login_state()
Astro.cookies.set(VOICE_LOGIN_STATE_COOKIE, state, {
    path: '/',
    httpOnly: true,
    secure: import.meta.env.PROD,
    sameSite: 'lax',
    maxAge: VOICE_LOGIN_STATE_MINUTES * 60,
})

return Astro.redirect(voice_login_url(`${get_app_url()}${translatePath('/voice/login')}`, state))
---
