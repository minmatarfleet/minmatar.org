---
// The EVE sign-in for /voice lands here with ?token=<voice session>&state=.
// The token is kept only when state matches the cookie /voice/sign-in set.
// "Sign in and connect" comes back to /voice?connect=1, which opens Mumble.
import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

import {
    VOICE_SESSION_COOKIE,
    VOICE_SESSION_DAYS,
    VOICE_LOGIN_STATE_COOKIE,
    VOICE_LOGIN_THEN_COOKIE,
    login_state_matches,
} from '@helpers/voice_session'

const token = Astro.url.searchParams.get('token')
const expected_state = Astro.cookies.get(VOICE_LOGIN_STATE_COOKIE)?.value
Astro.cookies.delete(VOICE_LOGIN_STATE_COOKIE, { path: '/' })
const then_connect = Astro.cookies.get(VOICE_LOGIN_THEN_COOKIE)?.value === 'connect'
Astro.cookies.delete(VOICE_LOGIN_THEN_COOKIE, { path: '/' })
if (!token || Astro.url.searchParams.get('error') || !login_state_matches(Astro.url.searchParams.get('state'), expected_state))
    return Astro.redirect(translatePath('/voice?error=login'))

Astro.cookies.set(VOICE_SESSION_COOKIE, token, {
    path: '/',
    httpOnly: true,
    secure: import.meta.env.PROD,
    sameSite: 'lax',
    maxAge: VOICE_SESSION_DAYS * 24 * 60 * 60,
})

return Astro.redirect(translatePath(then_connect ? '/voice?connect=1' : '/voice'))
---
