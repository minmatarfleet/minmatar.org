---
interface Props {
    min_content_width?: string;
    fade?:              boolean;
    [propName: string]: any;
}

const {
    min_content_width = '400px',
    fade = false,
    ...attributes
} = Astro.props;

delete attributes.class

import XFadeScroll from '@components/compositions/XFadeScroll.astro';

const Wrapper = fade ? XFadeScroll : 'div';
---

<Wrapper class:list={['scrollx', Astro.props.class]} {...attributes}>
    <slot />
</Wrapper>

<style lang="scss" is:global define:vars={{
    scrollx_min_content_width: min_content_width
}}>
    .scrollx > * {
        min-width: var(--scrollx_min_content_width);
        width: 100%;
        max-width: 100%;
    }
</style>

<style lang="scss" is:global>
    .scrollx {
        overflow-x: auto;
        width: 100%;
        display: block;
    }
</style>