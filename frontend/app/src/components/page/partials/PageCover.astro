---
interface Props {
    image:          string;
    image_990:      string;
    video?:         string;
    video_thumb?:   string;
    alt?:           string;
    animated?:      boolean; // deprecated
    scrollable?:    boolean; // deprecated
    overlay?:       boolean; // deprecated
    oob_swap?:      boolean;
    full_screen?:   boolean;
    align?:         'right' | 'left',
    [propName: string]: any;
}

const {
    image,
    image_990,
    video,
    video_thumb,
    alt = '',
    animated = true, // deprecated
    scrollable = false,
    overlay = false,
    oob_swap = false,
    full_screen = false,
    align = 'left',
    attributes,
} = Astro.props

const optional_attributes = {
    ...(alt && { "alt": alt }),
}

const old_cover = oob_swap ? Astro.request.headers.get('X-Page-Cover') : ''
const animate_cover = !oob_swap || (old_cover !== image)
---

<div
    class:list={['wrapper', { scrollable: scrollable }, { overlay: overlay }, { 'fix-pixel': video }, { 'fixed!': full_screen }, Astro.props.class]}
    class="[ viewport-cover ]"
    id="viewport-cover-oob"
    hx-swap-oob={oob_swap ? 'true' : undefined}
    x-init={`sessionStorage.setItem("current_bg", '${image ?? ''}')`}
    {...attributes}
>
    {!video ?
        <picture
            class:list={[ { '!hidden animate-fade-in': animate_cover }, { 'full-screen': full_screen }, align ]}
            x-data={animate_cover ? '{ loaded: false }' : undefined}
            x-init={animate_cover ? 'loaded = $refs.img.complete' : undefined}
            x-bind:class={animate_cover ? "{ '!hidden': !loaded }" : undefined}
        >
            <source srcset={image_990} media="(max-width: 990px)" />
            <img
                src={image}
                role={!alt ? 'presentation' : undefined}
                x-ref="img"
                x-on:load="loaded = true"
                {...optional_attributes}
            />
        </picture>
        :
        <picture class:list={[ { 'full-screen': full_screen }, align ]}>
            <video
                class={animate_cover ? "[ animate-fade-in ]" : undefined}
                width="1920"
                height="1080"
                poster={video_thumb}
                autoplay
                loop
                playsinline
                webkit-playsinline
                muted
            >
                <source src={video} type="video/webm" />
            </video>
        </picture>
    }
</div>

<style lang="scss" is:global>
    .viewport-cover {
        position: fixed;
        inset: 0;
        max-height: 100%;
        max-height: 100vh;

        picture {
            position: absolute;
            inset: 0;
            max-width: 50%;
            max-width: min(50%, 1000px);
            mask-image: radial-gradient(ellipse at top left, black 0%, transparent 70%);
            width: 100%;

            &.full-screen {
                max-width: 100%;
                mask-image: none;

                img,
                video {
                    width: 100%;
                }
            }

            &.right {
                mask-image: radial-gradient(ellipse at top right, black 0%, transparent 70%);
                left: unset;
            }
        }

        video,
        img {
            display: block;
            height: 100%;
            object-fit: cover;
            object-position: top 0 right 20%;
            opacity: 0.6;
        }

        video {
            right: 0;
            position: absolute;
        }
    }
</style>