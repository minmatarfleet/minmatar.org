---
import { i18n } from '@helpers/i18n'
const { lang } = i18n(Astro.url)

import { get_request_user } from '@helpers/request_user'

const { user } = get_request_user(Astro)

import type { PageCoverOptions } from '@dtypes/layout_components'

interface Props {
    cover?:                 false | PageCoverOptions;
    wide?:                  boolean;
    fullscreen?:            boolean;
    neocom?:                boolean;
    [propName: string]:     any;
}

const {
    cover,
    wide = false,
    fullscreen = false,
    neocom = true,
    ...attributes
} = Astro.props;

import { is_referral_url } from '@helpers/fetching/referrals'
const is_referral_page = user ? is_referral_url(Astro.url.pathname, lang) : false

const max_width = (wide ? 'var(--max-content-width)' : 'var(--max-text-width)')

import PageCover from '@components/page/partials/PageCover.astro';
import Wrapper from '@components/compositions/Wrapper.astro';

import ReferralLink from '@components/blocks/ReferralLink.astro';
---

<main id="content" {...attributes}>
    {is_referral_page && user &&
        <div class="[ referral-wrapper ]">
            <ReferralLink user_id={user.user_id} position='left' />
        </div>
    }

    {cover && <PageCover {...cover} /> }
    <slot name="cover" />

    <Wrapper class="[ w-full ]" max_width={max_width} centered={true} padding_block={fullscreen ? '0' : 'var(--space-2xl)'} neocom={neocom}>
        <slot />
    </Wrapper>
</main>