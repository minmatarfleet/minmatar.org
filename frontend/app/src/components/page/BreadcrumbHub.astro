---
import type { Pages } from '@dtypes/layout_components'

interface Props {
    page_title:     string;
    hub_links:      Pages[];
}

const {
    page_title,
    hub_links,
} = Astro.props

import StylessButton from '@components/blocks/StylessButton.astro';

import CaretIcon from '@components/icons/CaretIcon.astro';
---

<div
    x-bind:class="{ 'is-open': expanded }"
    x-data={`{
        id: $id('dropdown'),
        expanded: false,
        close() {
            this.expanded = false
        },
        toggle() {
            this.expanded = !this.expanded
        },
        close_if_outside(event) {
            if (this.$refs.trigger?.contains(event.target)) return
            this.close()
        },
    }`}
    @keydown.escape.prevent.stop="close()"
>
    <StylessButton
        class="[ hub-button ]"
        @click="toggle()"
        :id="id"
        x-ref="trigger"
        x-bind:aria-expanded="expanded.toString()"
        aria-haspopup="true"
    >
        <small class="[ inline-block ]">{page_title} <CaretIcon x-bind:class="expanded ? 'expanded' : 'collapsed'" /></small>
    </StylessButton>
 
    <template x-teleport="body">
        <div
            class:list={[
                '[ dropdown-panel solid-transparency ][ px-[var(--space-3xs)] py-[var(--space-3xs)] ]',
            ]}
            x-ref="panel"
            x-show="expanded"
            x-cloak
            x-anchor.fixed.bottom-start="$refs.trigger"
            x-bind:style="expanded ? { '--button-dropdown-min-width': `${$refs.trigger?.offsetWidth || 0}px` } : {}"
            @mousedown.outside="expanded && close_if_outside($event)"
            @keydown.escape.prevent.stop="close()"
            x-init="if (typeof htmx !== 'undefined') htmx.process($el); $watch('expanded', v => { if (v && typeof htmx !== 'undefined') htmx.process($el) })"
            style="display: none"
            x-trap="expanded"
            tabindex="-1"
        >
            <slot />
        </div>
    </template>
</div>

<style lang="scss">
    .hub-button {
        display: inline-block;
        background-color: var(--fleet-red);
        color: var(--button-color);
        text-decoration: none;
        padding: 2px 20px 2px 20px;
        text-wrap: nowrap;
        
        clip-path: polygon(0 0,calc(100% - 10px) 0,100% 50%,calc(100% - 10px) 100%,0 100%,10px 50%);

        .expanded {
            transform: rotate(180deg);
        }

        .collapsed {
            transform: rotate(0);
        }
    }

    .hub-button:focus-within,
    .hub-button:focus-visible,
    .hub-button:hover {
        outline: none;
    }

    /* Keyboard focus scales everywhere; hover and click focus only where the pointer can hover. */
    .hub-button:focus-visible small,
    .hub-button:has(:focus-visible) small {
        transform: scale(1.07);
    }

    @media (hover: hover) {
        .hub-button:focus-within small,
        .hub-button:hover small {
            transform: scale(1.07);
        }
    }

    @media (hover: none) {
        .hub-button:active small {
            transform: scale(0.95);
        }
    }

    .dropdown-panel {
        z-index: var(--tooltips-z-index);

        &:focus-visible {
            outline: none;
        }
    }
</style>