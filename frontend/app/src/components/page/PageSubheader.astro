---
interface Props {
    is_empty?:              boolean;
    [propName: string]:     any;
}

const {
    is_empty = false,
    ...attributes
} = Astro.props

delete attributes.class

const subheader_content = await Astro.slots.render('default');

import FlexInline from '@components/compositions/FlexInline.astro';
---

<FlexInline
    class:list={[ 'subheader-content', { 'is-empty': subheader_content === null }, Astro.props.class ]}
    {...attributes}
>
    <slot />
</FlexInline>

<style lang="scss">
    @media screen and (min-width: 1280px) {
        .subheader-content:not(.is-empty) {
            padding-bottom: var(--space-s);
        }
    }
</style>