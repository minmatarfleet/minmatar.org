---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { CampaignSystemSummary } from '@dtypes/api.minmatar.org'
import { clamp_percent, status_chip_color, status_chip_i18n_key } from '@helpers/fetching/campaigns'

interface Props {
    system:             CampaignSystemSummary;
    [propName: string]: any;
}

const {
    system,
    ...attributes
} = Astro.props

delete attributes.class

const contested = clamp_percent(system.contested_percent)
const change = system.contested_change_24h ?? 0
const net = system.advantage_net_pct ?? 0
const goal_key = system.goal === 'capture' ? 'campaigns.goal.capture' : 'campaigns.goal.defend'

import FlexInline from '@components/compositions/FlexInline.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import Tag from '@components/blocks/Tag.astro'
import CampaignMeter from '@components/blocks/CampaignMeter.astro'
---

<div class:list={['[ campaign-system-row ]', Astro.props.class]} {...attributes}>
    <Flexblock gap='var(--space-3xs)' class="[ campaign-system-row-name ]">
        <FlexInline gap='var(--space-2xs)' class="[ items-center ]">
            <span class="[ text-[var(--highlight)] ]">{system.name}</span>
            <Tag text={t(goal_key as any)} color='militia-purple' narrow={true} />
        </FlexInline>
        <Tag
            text={t(status_chip_i18n_key(system.status_chip) as any)}
            color={status_chip_color(system.status_chip)}
            narrow={true}
        />
    </Flexblock>

    <Flexblock gap='var(--space-3xs)' class="[ campaign-system-row-contest ]">
        <FlexInline gap='var(--space-3xs)' justification='space-between'>
            <small>{t('campaigns.system.contested')}</small>
            <small class="[ text-[var(--highlight)] ]">
                {contested.toFixed(1)}% <span class="[ campaign-change ]">{change >= 0 ? '+' : ''}{change.toFixed(1)}</span>
            </small>
        </FlexInline>
        <CampaignMeter
            percent={contested}
            label={`${system.name} ${t('campaigns.system.contested')}`}
        />
    </Flexblock>

    <Flexblock gap='var(--space-3xs)' class="[ campaign-system-row-advantage ]">
        <small>{t('campaigns.system.advantage')}</small>
        <small class="[ text-[var(--highlight)] ]">{net >= 0 ? '+' : ''}{net.toFixed(1)}%</small>
    </Flexblock>

    <Flexblock gap='var(--space-3xs)' class="[ campaign-system-row-kills ]">
        <small>{t('campaigns.system.kills_losses')}</small>
        <small class="[ text-[var(--highlight)] ]">{system.kills_24h} / {system.losses_24h}</small>
    </Flexblock>
</div>

<style lang="scss">
    .campaign-system-row {
        display: grid;
        grid-template-columns: minmax(8rem, 1fr) minmax(10rem, 2fr) minmax(5rem, auto) minmax(6rem, auto);
        gap: var(--space-xs);
        align-items: center;
        padding-block: var(--space-2xs);
        border-top: solid 1px var(--border-color);
    }

    .campaign-change {
        color: var(--foreground);
    }

    @media screen and (max-width: 767px) {
        .campaign-system-row {
            grid-template-columns: 1fr 1fr;
        }

        .campaign-system-row-contest {
            grid-column: 1 / -1;
            order: 3;
        }
    }
</style>
