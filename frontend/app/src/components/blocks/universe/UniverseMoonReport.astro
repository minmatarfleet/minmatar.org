---
/** The Report a moon dialog body: the paste, then what it found. */
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { UniverseMoonReport as Result } from '@dtypes/api.minmatar.org'

interface Props {
    result?:    Result | null;
    error?:     string | null;
    paste?:     string;
}

const { result = null, error = null, paste = '' } = Astro.props

import Button from '@components/blocks/Button.astro'
import Textarea from '@components/blocks/Textarea.astro'
import ManageField from '@components/blocks/manage/ManageField.astro'
---

<div class="[ structure-add ]">
    <h2>{t('universe.moons.report')}</h2>
    {error && <p class="[ manage-field__error ]" role="alert">{error}</p>}
    {result
        ? (
            <div class="[ structure-add__body ]">
                <div class="[ structure-add__sent ]">
                    <h3>{t('universe.report.sent_title')}</h3>
                    <p>{t('universe.moons.report_done').replace('~ADDED', String(result.moons_added)).replace('~IGNORED', String(result.moons_ignored))}</p>
                    {result.errors.map((message) => <p class="[ manage-field__error ]">{message}</p>)}
                </div>
                <div class="[ manage-actions ]">
                    <Button type="button" size="sm" color="fleet-red" x-on:click="close_dialog()">{t('universe.report.done')}</Button>
                </div>
            </div>
        )
        : (
            <div class="[ structure-add__body ]">
                <ManageField label={t('universe.moons.report_label')} for="universe-moon-paste">
                    <Textarea id="universe-moon-paste" name="paste" rows="8" required>{paste}</Textarea>
                </ManageField>
                <div class="[ manage-actions ]">
                    <Button type="submit" size="sm" color="fleet-red">{t('universe.moons.report_send')}</Button>
                    <Button type="button" size="sm" color="transparent" x-on:click="close_dialog()">{t('cancel')}</Button>
                </div>
            </div>
        )
    }
</div>
