---
/**
 * The body of the Report a structure dialog, one piece at a time:
 * Selected Item (find, then match) → Owner → Fitting → Reinforcement → Sent.
 * Each step posts to
 * universe_structure_report_component, which renders the next one; what the
 * pilot entered so far travels along as hidden fields. It renders inside the
 * shared StructureSteps shell with StructureHowTo clips, like Add a
 * structure. With a campaign_slug the report also lands on that campaign.
 */
import { i18n, t_key } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { UniverseStructure } from '@dtypes/api.minmatar.org'
import { get_item_icon } from '@helpers/eve_image'

export interface UniverseReportState {
    system_name:                string;
    type_id:                    number | null;
    name:                       string;
    structure_id:               number | null;
    campaign_slug:              string;
    corporation_name:           string;
    fitting:                    string;
    reinforce_hour:             number | null;
}

export type UniverseReportStep = 'find' | 'match' | 'owner' | 'fitting' | 'reinforce' | 'sent'

interface Props {
    step:           UniverseReportStep;
    state?:         Partial<UniverseReportState>;
    candidates?:    UniverseStructure[];
    picked?:        UniverseStructure | null;
    error?:         string | null;
    /** The Selected Item text as pasted, kept when it could not be read. */
    selected_item?: string;
}

const { step, candidates = [], picked = null, error = null } = Astro.props
const state: UniverseReportState = {
    system_name: '', type_id: null, name: '', structure_id: null, campaign_slug: '',
    corporation_name: '', fitting: '', reinforce_hour: null,
    ...(Astro.props.state ?? {}),
}

// Types a pilot can report; the backend holds the same list.
const REPORTABLE_TYPES: [number, string][] = [
    [35832, 'Astrahus'], [35833, 'Fortizar'], [35834, 'Keepstar'],
    [35825, 'Raitaru'], [35826, 'Azbel'], [35827, 'Sotiyo'],
    [35835, 'Athanor'], [35836, 'Tatara'],
    [35841, 'Ansiblex Jump Gate'], [81826, 'Metenox Moon Drill'],
]
const type_name = REPORTABLE_TYPES.find(([id]) => id === state.type_id)?.[1] ?? ''

const URL = translatePath('/partials/universe_structure_report_component/')
// One piece per step, in the order the client gives it: the structure
// (Selected Item), who owns it (Show Info), its fit (ship scan), then its
// reinforcement hour (hacking). Match is the second half of the first step.
const STEPS = ['find', 'owner', 'fitting', 'reinforce', 'sent'] as const
const current = step === 'match' ? 0 : STEPS.indexOf(step)
const fit_lines = state.fitting.split('\n').filter((line) => line.trim()).length
const summary = [
    [picked?.name ?? state.name, type_name, state.system_name].filter(Boolean).join(' · '),
    state.corporation_name,
    fit_lines ? t('universe.report.fit_lines').replace('~COUNT', String(fit_lines)) : t('universe.report.skipped'),
    state.reinforce_hour === null ? t('universe.report.not_known') : `${String(state.reinforce_hour).padStart(2, '0')}:00 EVE`,
    '',
]
const steps = STEPS.map((name, index) => ({
    label: t(t_key('universe.report.step_', name)),
    note: index < current ? summary[index] : index === current ? t(t_key('universe.report.step_now_', step === 'match' ? 'match' : name)) : '',
}))
const go = (value: string, extra: Record<string, string> = {}) => JSON.stringify({ go: value, ...extra })
const move = (value: string, extra: Record<string, string> = {}) => ({ 'hx-post': URL, 'hx-vals': go(value, extra), 'hx-target': 'closest form', 'hx-swap': 'innerHTML' })

// Everything entered so far travels as hidden fields, except what this step shows.
const VISIBLE: Record<UniverseReportStep, string[]> = {
    find: ['system_name', 'type_id', 'name'],
    match: ['structure_id'],
    owner: ['corporation_name'],
    fitting: ['fitting'],
    reinforce: ['reinforce_hour'],
    sent: [],
}
// Back on the first step, the paste box shows what was read, as the client copies it.
const pasted = Astro.props.selected_item || (state.system_name && state.name
    ? (state.name.toLowerCase().startsWith(state.system_name.toLowerCase()) ? state.name : `${state.system_name} - ${state.name}`)
    : '')
const carried = (Object.entries(state) as [string, string | number | null][])
    .filter(([key]) => !VISIBLE[step].includes(key))

import Button from '@components/blocks/Button.astro'
import StylessButton from '@components/blocks/StylessButton.astro'
import Input from '@components/blocks/Input.astro'
import Select from '@components/blocks/Select.astro'
import Textarea from '@components/blocks/Textarea.astro'
import ManageField from '@components/blocks/manage/ManageField.astro'
import StructureSteps from '@components/blocks/structures/StructureSteps.astro'
import StructureHowTo from '@components/blocks/structures/StructureHowTo.astro'
import OptionCard from '@components/blocks/OptionCard.astro'
---

<StructureSteps title={t('universe.report.title')} steps_label={t('universe.report.steps')} steps={steps} current={current}>
    {step !== 'sent' && carried.map(([key, value]) => <input type="hidden" name={key} value={value ?? ''} />)}

    {error && <p class="[ manage-field__error ]" role="alert">{error}</p>}

    {step === 'find' &&
        <div class="[ structure-add__body ]" x-data={`{ by_hand: ${pasted ? 'false' : String(Boolean(state.system_name))} }`}>
            <StructureHowTo topics={['name']} />
            <ManageField label={t('universe.report.type')} for="universe-report-type">
                <Select id="universe-report-type" name="type_id" size="sm">
                    {REPORTABLE_TYPES.map(([id, name]) => <option value={id} selected={state.type_id === id}>{name}</option>)}
                </Select>
            </ManageField>
            <template x-if="!by_hand">
                <div class="[ structure-add__body ]">
                    <ManageField label={t('universe.report.selected_item')} for="universe-report-paste">
                        <Textarea id="universe-report-paste" name="selected_item" rows="3" placeholder={t('universe.report.selected_item_placeholder')}>{pasted}</Textarea>
                    </ManageField>
                    <StylessButton type="button" class="[ structure-add__link ]" x-on:click="by_hand = true">{t('universe.report.by_hand')}</StylessButton>
                </div>
            </template>
            <template x-if="by_hand">
                <div class="[ structure-add__two ]">
                    <ManageField label={t('universe.report.system')} for="universe-report-system">
                        <Input id="universe-report-system" name="system_name" value={state.system_name} required />
                    </ManageField>
                    <ManageField label={t('universe.report.name')} for="universe-report-name">
                        <Input id="universe-report-name" name="name" value={state.name} />
                    </ManageField>
                </div>
            </template>
            <div class="[ manage-actions ]">
                <Button type="button" size="sm" color="fleet-red" {...move('match')} hx-disabled-elt="this">{t('universe.report.next')}</Button>
                <Button type="button" size="sm" color="transparent" x-on:click="close_dialog()">{t('cancel')}</Button>
            </div>
        </div>
    }

    {step === 'match' &&
        <div class="[ structure-add__body ]">
            <span class="[ manage-field__label ]">{candidates.length ? t('universe.report.is_it_one') : t('universe.report.no_candidates')}</span>
            <fieldset class="[ universe-report__choices ]">
                {candidates.map((structure, index) => (
                    <OptionCard name="structure_id" value={String(structure.id)} checked={state.structure_id === null ? index === 0 : state.structure_id === structure.id}>
                        <img src={get_item_icon(structure.type_id, 64)} alt="" width="56" height="56" />
                        <div>
                            <b>{structure.name}</b>
                            <small>{[structure.type_name, structure.system_name, structure.corporation_name].filter(Boolean).join(' · ')}</small>
                        </div>
                    </OptionCard>
                ))}
                <OptionCard name="structure_id" value="" checked={candidates.length === 0}>
                    <span class="[ structure-add__glyph ]" aria-hidden="true"></span>
                    <div>
                        <b>{t('universe.report.none')}</b>
                        <small>{t('universe.report.none_hint')}</small>
                    </div>
                </OptionCard>
            </fieldset>
            <div class="[ manage-actions ]">
                <Button type="button" size="sm" color="fleet-red" {...move('owner', { prefill: '1' })}>{t('universe.report.next')}</Button>
                <Button type="button" size="sm" color="transparent" {...move('find')}>{t('universe.report.back')}</Button>
            </div>
        </div>
    }

    {step === 'owner' &&
        <div class="[ structure-add__body ]">
            <StructureHowTo topics={['owner']} />
            <ManageField label={t('universe.report.corporation')} for="universe-report-corp" hint={t('universe.report.corporation_hint')}>
                <Input id="universe-report-corp" name="corporation_name" value={state.corporation_name} />
            </ManageField>
            <div class="[ manage-actions ]">
                <Button type="button" size="sm" color="fleet-red" {...move('fitting')}>{t('universe.report.next')}</Button>
                <Button type="button" size="sm" color="transparent" {...move('match')}>{t('universe.report.back')}</Button>
            </div>
        </div>
    }

    {step === 'fitting' &&
        <div class="[ structure-add__body ]">
            <StructureHowTo topics={['fitting']} />
            <ManageField label={t('universe.report.fitting')} for="universe-report-fit">
                <Textarea id="universe-report-fit" name="fitting" rows="6">{state.fitting}</Textarea>
            </ManageField>
            <div class="[ manage-actions ]">
                <Button type="button" size="sm" color="fleet-red" {...move('reinforce')}>{t('universe.report.next')}</Button>
                <Button type="button" size="sm" color="transparent" {...move('owner')}>{t('universe.report.back')}</Button>
            </div>
        </div>
    }

    {step === 'reinforce' &&
        <div class="[ structure-add__body ]">
            <StructureHowTo topics={['reinforce']} />
            <ManageField label={t('universe.report.reinforce')} for="universe-report-hour">
                <Select id="universe-report-hour" name="reinforce_hour" size="sm">
                    <option value="">{t('universe.report.not_known')}</option>
                    {Array.from({ length: 24 }, (_, hour) => (
                        <option value={hour} selected={state.reinforce_hour === hour}>{String(hour).padStart(2, '0')}:00 EVE</option>
                    ))}
                </Select>
            </ManageField>
            <div class="[ manage-actions ]">
                <Button type="button" size="sm" color="fleet-red" {...move('send')} hx-disabled-elt="this">{t('universe.report.send')}</Button>
                <Button type="button" size="sm" color="transparent" {...move('fitting')}>{t('universe.report.back')}</Button>
            </div>
        </div>
    }

    {step === 'sent' &&
        <div class="[ structure-add__body ]">
            {state.campaign_slug && <input type="hidden" name="campaign_slug" value={state.campaign_slug} />}
            <div class="[ structure-add__sent ]">
                <h3>{t('universe.report.sent_title')}</h3>
                <p>{state.campaign_slug ? t('universe.report.sent_body_campaign') : t('universe.report.sent_body')}</p>
            </div>
            <div class="[ manage-actions ]">
                <Button type="button" size="sm" color="fleet-red" x-on:click="close_dialog()">{t('universe.report.done')}</Button>
                <Button type="button" size="sm" color="transparent" {...move('find')}>{t('universe.report.another')}</Button>
            </div>
        </div>
    }
</StructureSteps>

<style lang="scss" is:global>
    .universe-report__choices {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        margin: 0;
        padding: 0;
        border: 0;

        b {
            display: block;
            color: var(--highlight);
        }

        small {
            color: var(--faded);
        }
    }
</style>
