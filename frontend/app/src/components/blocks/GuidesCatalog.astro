---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import {
    getGuidesByCategory,
    guideCategories,
} from '@/data/guides'
import type { GuideMeta } from '@/data/guides/types'

import Flexblock from '@components/compositions/Flexblock.astro'
import Grid from '@components/compositions/Grid.astro'
import ChipGroup from '@components/blocks/ChipGroup.astro'
import FilterChip from '@components/blocks/FilterChip.astro'

import GuideCard from '@components/blocks/GuideCard.astro'

interface Props {
    show_heading?: boolean
    show_count?: boolean
}

const {
    show_heading = true,
    show_count = true,
} = Astro.props

const guides_by_category = getGuidesByCategory()
const categories = guideCategories.filter(
    (category) => (guides_by_category[category] ?? []).length > 0,
)

const ordered_guides: GuideMeta[] = categories.flatMap(
    (category) => guides_by_category[category] ?? [],
)

const filters = [
    { id: 'all', label: t('all_categories'), count: ordered_guides.length },
    ...categories.map((category) => ({
        id: category,
        label: category,
        count: (guides_by_category[category] ?? []).length,
    })),
]

const count_text = t(ordered_guides.length !== 1 ? 'guides_plural' : 'guides_singular')
    .replace('{count}', String(ordered_guides.length))

const guides_plural = t('guides_plural')
const guides_singular = t('guides_singular')
const filters_json = JSON.stringify(filters)
---

<section
    id="guides"
    class:list={[
        'guides-catalog',
        show_heading && 'guides-catalog--nested',
    ]}
    x-data={`{
        category: 'all',
        filters: ${filters_json},
        set_category(id) {
            this.category = id
        },
        matches(el) {
            return this.category === 'all' || el.dataset.category === this.category
        },
        visible_count() {
            const match = this.filters.find((f) => f.id === this.category)
            return match ? match.count : 0
        },
        count_label() {
            const n = this.visible_count()
            return n !== 1
                ? ${JSON.stringify(guides_plural)}.replace('{count}', String(n))
                : ${JSON.stringify(guides_singular)}
        },
    }`}
>
    <Flexblock gap="var(--space-m)">
        {(show_heading || show_count) &&
            <Flexblock gap="var(--space-3xs)">
                {show_heading &&
                    <h2 class="[ guides-catalog__title ]">{t('guides.page_title')}</h2>
                }
                {show_count &&
                    <small x-text="count_label()">{count_text}</small>
                }
            </Flexblock>
        }

        <ChipGroup>
            {filters.map((filter) => (
                <FilterChip
                    x-bind:class={`category === ${JSON.stringify(filter.id)} && 'is-active'`}
                    x-on:click={`set_category(${JSON.stringify(filter.id)})`}
                    x-bind:aria-pressed={`category === ${JSON.stringify(filter.id)} ? 'true' : 'false'`}
                >
                    {filter.label}
                </FilterChip>
            ))}
        </ChipGroup>

        <Grid
            class="[ w-full grid-fill ]"
            row_gap="var(--space-3xs)"
            column_gap="var(--space-3xs)"
            min_item_width="400px"
        >
            {ordered_guides.map((guide) => (
                <div
                    class="[ guides-catalog__item ]"
                    data-category={guide.category}
                    x-show="matches($el)"
                >
                    <GuideCard guide={guide} />
                </div>
            ))}
        </Grid>
    </Flexblock>
</section>

<style lang="scss">
    .guides-catalog__title {
        font-size: var(--step-2);
    }

    .guides-catalog__item {
        height: 100%;

        :global(.guide-card) {
            height: 100%;
        }
    }
</style>
