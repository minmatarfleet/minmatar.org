---
import { i18n } from '@helpers/i18n'
const { lang, t } = i18n(Astro.url)

import type { CampaignRosterCorporation } from '@dtypes/api.minmatar.org'
import { format_date_short } from '@helpers/date'
import { format_isk } from '@helpers/numbers'
import { get_corporation_logo } from '@helpers/eve_image_server'

/** The roster rolled up by each pilot's primary character's corporation. */
interface Props {
    corporations:       CampaignRosterCorporation[];
    [propName: string]: any;
}

const {
    corporations,
    ...attributes
} = Astro.props

delete attributes.class

const columns = [
    t('campaigns.roster.corporation'),
    t('campaigns.corporations.pilots'),
    t('campaigns.corporations.active'),
    t('campaigns.roster.characters'),
    t('campaigns.stat.kills'),
    t('campaigns.stat.losses'),
    t('campaigns.stat.isk_destroyed'),
    t('campaigns.stat.complexes'),
    t('campaigns.corporations.fleets'),
    t('campaigns.roster.last_active'),
]

import DataGrid from '@components/blocks/DataGrid.astro'
---

{corporations.length === 0 ?
    <small class:list={[Astro.props.class]} {...attributes}>{t('campaigns.roster.none')}</small>
    :
    <DataGrid
        class:list={['[ campaign-corporations ]', Astro.props.class]}
        min_width='56rem'
        stack={true}
        template='minmax(12rem, 1fr) 4rem 4rem 6rem 4rem 4rem 6rem 6rem 4rem 7rem'
        numeric={[ 1, 2, 3, 4, 5, 6, 7, 8 ]}
        columns={columns}
        {...attributes}
    >
        {corporations.map(corporation =>
            <div class="[ data-grid-row ]" role="row">
                <div class="[ data-grid-media ]" role="cell">
                    {corporation.corporation_id &&
                        <img
                            loading='lazy'
                            width='32'
                            height='32'
                            src={get_corporation_logo(corporation.corporation_id, 32)}
                            alt=''
                        />
                    }
                    <span>{corporation.corporation_name || t('campaigns.corporations.unknown')}</span>
                </div>
                <span data-label={columns[1]} role="cell" class="[ data-grid-numeric ]">{corporation.pilots}</span>
                <span data-label={columns[2]} role="cell" class="[ data-grid-numeric ]" title={t('campaigns.corporations.active_hint')}>{corporation.active_pilots}</span>
                <span data-label={columns[3]} role="cell" class="[ data-grid-numeric ]">{corporation.characters_included}</span>
                <span data-label={columns[4]} role="cell" class="[ data-grid-numeric ]">{corporation.kills}</span>
                <span data-label={columns[5]} role="cell" class="[ data-grid-numeric ]">{corporation.losses}</span>
                <span data-label={columns[6]} role="cell" class="[ data-grid-numeric ]">{format_isk(corporation.isk_destroyed)}</span>
                <span data-label={columns[7]} role="cell" class="[ data-grid-numeric ]">{corporation.complexes}</span>
                <span data-label={columns[8]} role="cell" class="[ data-grid-numeric ]">{corporation.fleets_attended}</span>
                <small data-label={columns[9]} role="cell" class="[ data-grid-muted ]">
                    {corporation.last_active_day ? format_date_short(lang, corporation.last_active_day) : '—'}
                </small>
            </div>
        )}
    </DataGrid>
}

<style lang="scss">
    @media (max-width: 48rem) {
        .data-grid-row {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: var(--space-2xs) var(--space-s);
            align-items: start;
            padding-inline: 0;
            padding-block: var(--space-xs);
        }

        .data-grid-row > :first-child {
            grid-column: 1 / -1;
        }

        .data-grid-row > .data-grid-numeric {
            text-align: left;
        }
    }
</style>
