---
import { i18n } from '@helpers/i18n'
const { lang, t } = i18n(Astro.url)

import type { CampaignRosterCorporation } from '@dtypes/api.minmatar.org'
import { format_date_short } from '@helpers/date'
import { format_isk } from '@helpers/numbers'
import { get_corporation_logo } from '@helpers/eve_image_server'

/** The roster rolled up by each pilot's primary character's corporation. */
interface Props {
    corporations:       CampaignRosterCorporation[];
    [propName: string]: any;
}

const {
    corporations,
    ...attributes
} = Astro.props

delete attributes.class

const columns = [
    t('campaigns.roster.corporation'),
    t('campaigns.corporations.pilots'),
    t('campaigns.corporations.active'),
    t('campaigns.roster.characters'),
    t('campaigns.stat.kills'),
    t('campaigns.stat.losses'),
    t('campaigns.stat.isk_destroyed'),
    t('campaigns.stat.complexes'),
    t('campaigns.corporations.fleets'),
    t('campaigns.roster.last_active'),
]

import CampaignTable from '@components/blocks/CampaignTable.astro'
---

{corporations.length === 0 ?
    <small class:list={[Astro.props.class]} {...attributes}>{t('campaigns.roster.none')}</small>
    :
    <CampaignTable
        class:list={['[ campaign-corporations ]', Astro.props.class]}
        min_width='56rem'
        template='minmax(12rem, 1fr) 4rem 4rem 6rem 4rem 4rem 6rem 6rem 4rem 7rem'
        numeric={[ 1, 2, 3, 4, 5, 6, 7, 8 ]}
        columns={columns}
        {...attributes}
    >
        {corporations.map(corporation =>
            <div class="[ campaign-table-row ]" role="row">
                <div class="[ campaign-cell-media ]" role="cell">
                    {corporation.corporation_id &&
                        <img
                            loading='lazy'
                            width='32'
                            height='32'
                            src={get_corporation_logo(corporation.corporation_id, 32)}
                            alt=''
                        />
                    }
                    <span>{corporation.corporation_name || t('campaigns.corporations.unknown')}</span>
                </div>
                <span role="cell" class="[ campaign-table-numeric ]">{corporation.pilots}</span>
                <span role="cell" class="[ campaign-table-numeric ]" title={t('campaigns.corporations.active_hint')}>{corporation.active_pilots}</span>
                <span role="cell" class="[ campaign-table-numeric ]">{corporation.characters_included}</span>
                <span role="cell" class="[ campaign-table-numeric ]">{corporation.kills}</span>
                <span role="cell" class="[ campaign-table-numeric ]">{corporation.losses}</span>
                <span role="cell" class="[ campaign-table-numeric ]">{format_isk(corporation.isk_destroyed)}</span>
                <span role="cell" class="[ campaign-table-numeric ]">{corporation.complexes}</span>
                <span role="cell" class="[ campaign-table-numeric ]">{corporation.fleets_attended}</span>
                <small role="cell" class="[ campaign-table-muted ]">
                    {corporation.last_active_day ? format_date_short(lang, corporation.last_active_day) : '—'}
                </small>
            </div>
        )}
    </CampaignTable>
}
