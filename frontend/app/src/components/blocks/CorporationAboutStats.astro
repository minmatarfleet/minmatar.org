---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { CorporationPublicSummary, CorporationSummarySlice } from '@dtypes/api.minmatar.org'

import Flexblock from '@components/compositions/Flexblock.astro'
import Grid from '@components/compositions/Grid.astro'

interface Props {
    summary: CorporationPublicSummary
    [propName: string]: any
}

const { summary } = Astro.props

type SliceTone = 'red' | 'yellow' | 'blue' | 'green' | 'highlight'

interface StatSlice {
    key: string
    label: string
    count: number
    percent: number
    share: number
    tone: SliceTone
}

interface StatBlock {
    key: string
    title: string
    slices: StatSlice[]
}

function visible_slices(
    rows: CorporationSummarySlice[] | undefined,
    label_for: (key: string) => string,
    tone_for: (key: string) => SliceTone,
    denominator?: number,
): StatSlice[] {
    const rows_with_counts = (rows ?? []).filter((row) => row.count > 0)
    const summed = rows_with_counts.reduce((sum, row) => sum + row.count, 0)
    const total = denominator && denominator > 0 ? denominator : summed
    const percents = percent_shares(rows_with_counts.map((row) => row.count), total)
    return rows_with_counts.map((row, index) => {
        const percent = percents[index] ?? 0
        const width = total > 0 ? (row.count / total) * 100 : 0
        return {
            key: row.key,
            label: label_for(row.key),
            count: row.count,
            percent,
            share: row.count > 0 ? Math.max(width, 1) : 0,
            tone: tone_for(row.key),
        }
    })
}

function percent_shares(counts: number[], total: number): number[] {
    if (total <= 0)
        return counts.map(() => 0)
    const exact = counts.map((count) => (count / total) * 100)
    const floors = exact.map((value) => Math.floor(value))
    const summed = counts.reduce((sum, count) => sum + count, 0)
    if (summed !== total)
        return exact.map((value) => Math.round(value))
    let leftover = 100 - floors.reduce((sum, value) => sum + value, 0)
    const order = exact
        .map((value, index) => ({
            index,
            fraction: value - Math.floor(value),
        }))
        .sort((left, right) => right.fraction - left.fraction || left.index - right.index)
    for (const row of order) {
        if (leftover <= 0)
            break
        floors[row.index] += 1
        leftover -= 1
    }
    return floors
}

function share_label(percent: number, count: number): string {
    if (count > 0 && percent <= 0)
        return '<1%'
    return `${percent}%`
}


function fleet_label(key: string) {
    switch (key) {
        case 'inactive':
            return t('corporations.detail.fleet_inactive')
        case 'lapsing':
            return t('corporations.detail.fleet_lapsing')
        case 'regular':
            return t('corporations.detail.fleet_regular')
        case 'core':
            return t('corporations.detail.fleet_core')
        default:
            return key
    }
}

function ship_label(key: string) {
    switch (key) {
        case 'dps':
            return t('corporations.detail.ship_dps')
        case 'logistics':
            return t('corporations.detail.ship_logistics')
        case 'support':
            return t('corporations.detail.ship_support')
        case 'capital':
            return t('corporations.detail.ship_capital')
        case 'industrial':
            return t('corporations.detail.ship_industrial')
        case 'other':
            return t('corporations.detail.ship_other')
        default:
            return key
    }
}

function kill_label(key: string) {
    switch (key) {
        case 'solo':
            return t('corporations.detail.kill_solo')
        case 'small_gang':
            return t('corporations.detail.kill_small_gang')
        case 'fleet':
            return t('corporations.detail.kill_fleet')
        default:
            return key
    }
}

function fleet_tone(key: string): SliceTone {
    switch (key) {
        case 'inactive':
            return 'red'
        case 'lapsing':
            return 'yellow'
        case 'regular':
            return 'blue'
        case 'core':
            return 'green'
        default:
            return 'highlight'
    }
}

function ship_tone(key: string): SliceTone {
    switch (key) {
        case 'dps':
            return 'red'
        case 'logistics':
            return 'green'
        case 'support':
            return 'blue'
        case 'capital':
            return 'yellow'
        case 'industrial':
        case 'other':
            return 'highlight'
        default:
            return 'highlight'
    }
}

function kill_tone(key: string): SliceTone {
    switch (key) {
        case 'solo':
            return 'yellow'
        case 'small_gang':
            return 'blue'
        case 'fleet':
            return 'red'
        default:
            return 'highlight'
    }
}

const fleet_slices = visible_slices(
    summary.fleet_participation?.slices,
    fleet_label,
    fleet_tone,
)
const ship_slices = visible_slices(
    summary.fleet_ships?.slices?.filter(
        (row) => row.key !== 'industrial' && row.key !== 'other',
    ),
    ship_label,
    ship_tone,
)
const kill_slices = visible_slices(
    summary.kills?.slices,
    kill_label,
    kill_tone,
)

const blocks: StatBlock[] = [
    {
        key: 'fleets',
        title: t('corporations.detail.stats_fleets'),
        slices: fleet_slices,
    },
    {
        key: 'ships',
        title: t('corporations.detail.stats_ships'),
        slices: ship_slices,
    },
    {
        key: 'kills',
        title: t('corporations.detail.stats_kills'),
        slices: kill_slices,
    },
]

---

<Flexblock gap="var(--space-s)" class="about-stats">
    <h2>{t('corporations.detail.stats_heading')}</h2>
    <Grid
        min_item_width="calc(var(--space-3xl) * 2)"
        row_gap="var(--space-m)"
        column_gap="var(--space-m)"
    >
        {blocks.map((block) => (
            <article class="stat-block" data-stat={block.key}>
                <Flexblock gap="var(--space-3xs)">
                    <h3>{block.title}</h3>
                    {block.slices.length > 0 &&
                        <ul class="blend">
                            {block.slices.map((slice) => (
                                <li class="blend-row">
                                    <span class="blend-label">{slice.label}</span>
                                    <span class="track" aria-hidden="true">
                                        <span
                                            class="bar"
                                            data-tone={slice.tone}
                                            style={`width: ${slice.share}%`}
                                        />
                                    </span>
                                    <span class="blend-count">{share_label(slice.percent, slice.count)}</span>
                                </li>
                            ))}
                        </ul>
                    }
                </Flexblock>
            </article>
        ))}
    </Grid>
</Flexblock>

<style lang="scss">

    .stat-block {
        min-width: 0;
        height: 100%;
        padding: var(--space-m) var(--space-m) var(--space-l);
        background: var(--component-background);
    }

    h2,
    h3 {
        margin: 0;
    }

    h3 {
        font-size: var(--step-0);
        color: var(--foreground);
    }


    .blend {
        list-style: none;
        margin: 0;
        padding: 0;
        margin-block-start: var(--space-s);
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
    }

    .blend-row {
        display: grid;
        grid-template-columns: calc(var(--space-2xl) + var(--space-s)) minmax(0, 1fr) var(--space-xl);
        column-gap: var(--space-s);
        align-items: center;
    }

    .blend-label,
    .blend-count {
        font-size: var(--step--1);
        color: var(--highlight);
        white-space: nowrap;
    }

    .blend-count {
        text-align: end;
        font-variant-numeric: tabular-nums;
    }

    .track {
        width: 100%;
        height: var(--space-2xs);
        background: color-mix(in srgb, var(--highlight) 18%, transparent);
    }

    .bar {
        display: block;
        height: 100%;
        background: var(--highlight);
    }

    .bar[data-tone='red'] {
        background: var(--fleet-red);
    }

    .bar[data-tone='yellow'] {
        background: var(--fleet-yellow);
    }

    .bar[data-tone='blue'] {
        background: var(--alliance-blue);
    }

    .bar[data-tone='green'] {
        background: var(--green);
    }

    .bar[data-tone='highlight'] {
        background: var(--highlight);
    }
</style>
