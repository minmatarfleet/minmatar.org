---
import type { ButtonColors, ButtonSizes } from '@dtypes/layout_components';

interface Props {
    variant?:           'default' | 'button';
    color?:             ButtonColors;
    size?:              ButtonSizes;
    [propName: string]: any;
}

const {
    variant = 'default',
    color = 'fleet-red',
    size = 'sm',
    ...attributes
} = Astro.props

import CollapsableButton from "@components/blocks/CollapsableButton.astro";
---

<div
    {...attributes}
    class:list={[ attributes.class, { 'button-dropdown': variant === 'button' } ]}
    x-bind:class="{ 'is-open': expanded }"
    x-data={`{
        id: $id('dropdown'),
        expanded: false,
        close() {
            this.expanded = false
        },
        toggle() {
            this.expanded = !this.expanded
        },
        close_if_outside(event) {
            if (this.$refs.trigger?.contains(event.target)) return
            this.close()
        },
    }`}
    @keydown.escape.prevent.stop="close()"
>
    <CollapsableButton
        appearance={variant === 'button' ? 'button' : 'plain'}
        color={color}
        size={size}
        @click="toggle()"
        :id="id"
        x-ref="trigger"
        x-bind:aria-expanded="expanded.toString()"
        aria-haspopup="true"
    >
        <slot name="button" />
    </CollapsableButton>
 
    <template x-teleport="body">
        <div
            class:list={[
                attributes.class,
                '[ dropdown-panel light-transparency ][ px-[var(--space-3xs)] py-[var(--space-3xs)] ]',
                { 'button-dropdown-panel': variant === 'button' },
            ]}
            x-ref="panel"
            x-show="expanded"
            x-cloak
            x-anchor.fixed.bottom-end="$refs.trigger"
            x-bind:style="expanded ? { '--button-dropdown-min-width': `${$refs.trigger?.offsetWidth || 0}px` } : {}"
            @mousedown.outside="expanded && close_if_outside($event)"
            @keydown.escape.prevent.stop="close()"
            style="display: none"
        >
            <slot />
        </div>
    </template>
</div>

<style lang="scss">
    .button-dropdown {
        position: relative;
    }

    .dropdown-panel {
        z-index: var(--tooltips-z-index);
    }

    .button-dropdown-panel {
        min-width: var(--button-dropdown-min-width, 0px);
        width: var(--button-dropdown-min-width, max-content);
        box-sizing: border-box;
    }

    [x-cloak] {
        display: none !important;
    }
</style>
