---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { FleetParticipants } from '@helpers/api.minmatar.org/fleets'
import { get_item_icon, get_player_icon } from '@helpers/eve_image_server'
import { query_string } from '@helpers/string'

/**
 * Who flew what after the fleet: each pilot once, by hull, for the whole
 * fleet or one engagement (picked here, swapped in by
 * fleet_participants_flew_component). A hull opens to its pilots.
 */
interface Props {
    participants:   FleetParticipants;
    fleet_id:       number;
}

const { participants, fleet_id } = Astro.props

const HULLS_SHOWN = 11
const PILOTS_SHOWN = 40

const rest = participants.flew.slice(HULLS_SHOWN)
const rest_pilots = rest.reduce((sum, hull) => sum + hull.count, 0)
const top = Math.max(1, ...participants.flew.map(hull => hull.count))

const role_label:Record<string, string> = {
    logi: t('fleets.after.logi'),
    links: t('fleets.after.links'),
    cyno: t('fleets.after.cyno'),
}
const fills_label:Record<string, string> = {}
participants.roles_flown.forEach(role => role.hulls.forEach(hull => { fills_label[hull.ship_name] = role_label[role.role] ?? role.label }))

const engagement = participants.engagements.find(item => item.position === participants.engagement) ?? null
const summary = engagement ?
    t('fleets.after.flew_in').replace('{pilots}', participants.pilots.toString()).replace('{name}', t('fleets.fights.round').replace('{number}', engagement.number.toString())) :
    t('fleets.after.flew_summary').replace('{pilots}', participants.pilots.toString()).replace('{changed}', participants.changed_ship.toString())

const PARTIAL_URL = (position: number | null) => `${translatePath('/partials/fleet_participants_flew_component')}?${query_string({
    fleet_id,
    ...(position !== null && { engagement: position }),
})}`
const pills = [
    { position: null, label: t('fleets.after.whole_fleet') },
    ...participants.engagements.map(item => ({ position: item.position, label: t('fleets.fights.round').replace('{number}', item.number.toString()) })),
]
---

<section id="fleet-flew" class="[ fleet-flew ]" aria-labelledby="fleet-flew-title" x-data="{ all: false }">
    <header>
        <h2 id="fleet-flew-title">{t('fleets.after.flew_title')}</h2>
        <small>{summary}</small>
    </header>

    {participants.engagements.length > 1 &&
        <div class="[ fleet-flew__pills ]" role="group" aria-label={t('fleets.killfeed.engagement')}>
            {pills.map(pill =>
                <button
                    type="button"
                    aria-pressed={pill.position === participants.engagement ? 'true' : 'false'}
                    hx-get={PARTIAL_URL(pill.position)}
                    hx-target="#fleet-flew"
                    hx-swap="outerHTML"
                    hx-disabled-elt="this"
                >{pill.label}</button>
            )}
        </div>
    }

    {participants.flew.length === 0 ?
        <small>{t('fleets.after.nobody_in')}</small>
        :
        <div class="[ fleet-after__scroll ]">
            <table class="[ fleet-after__table ]">
                <thead>
                    <tr>
                        <th scope="col"><span class="[ visually-hidden ]">{t('fleets.after.hull')}</span></th>
                        <th scope="col">{t('fleets.after.hull')}</th>
                        <th scope="col"><span class="[ visually-hidden ]">{t('fleets.after.pilots')}</span></th>
                        <th scope="col" class="[ num ]">{t('fleets.after.pilots')}</th>
                        <th scope="col">{t('fleets.after.fills')}</th>
                    </tr>
                </thead>
                {participants.flew.map((hull, index) =>
                    <tbody
                        x-data="{ open: false }"
                        x-show={index >= HULLS_SHOWN ? 'all' : undefined}
                        x-cloak={index >= HULLS_SHOWN ? true : undefined}
                    >
                        <tr>
                            <td><img src={get_item_icon(hull.ship_type_id, 64)} alt="" width="40" height="40" loading="lazy" /></td>
                            <th scope="row">
                                {hull.pilots.length > 0 ?
                                    <button
                                        type="button"
                                        class="[ fleet-flew__toggle ]"
                                        x-on:click="open = !open"
                                        x-bind:aria-expanded="open"
                                        aria-expanded="false"
                                    >
                                        {hull.ship_name}
                                        <span aria-hidden="true" x-text="open ? '▾' : '▸'">▸</span>
                                    </button>
                                    :
                                    hull.ship_name
                                }
                            </th>
                            <td class="[ fleet-after__bar ]" aria-hidden="true"><span style={`inline-size: ${Math.round(hull.count / top * 100)}%`} /></td>
                            <td class="[ num ]"><b>{hull.count}</b></td>
                            <td>{fills_label[hull.ship_name] && <span class="[ fleet-after__fills ]">{fills_label[hull.ship_name]}</span>}</td>
                        </tr>
                        {hull.pilots.length > 0 &&
                            <tr class="[ fleet-flew__pilots ]" x-show="open" x-cloak>
                                <td />
                                <td colspan="4">
                                    <span class="[ fleet-flew__chips ]">
                                        {hull.pilots.slice(0, PILOTS_SHOWN).map(pilot =>
                                            <span class="[ fleet-after__chip ]"><img src={get_player_icon(pilot.character_id, 32)} alt="" width="24" height="24" loading="lazy" />{pilot.character_name}</span>
                                        )}
                                        {hull.pilots.length > PILOTS_SHOWN && <small>{t('fleets.after.more').replace('{count}', (hull.pilots.length - PILOTS_SHOWN).toString())}</small>}
                                        {hull.count > hull.pilots.length && <small>{t('fleets.after.unnamed').replace('{count}', (hull.count - hull.pilots.length).toString())}</small>}
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                )}
            </table>
        </div>
    }

    {(rest.length > 0 || (!engagement && participants.ended_in_pod > 0)) &&
        <div class="[ fleet-after__more ]">
            <span>
                {rest.length > 0 && t('fleets.after.others').replace('{pilots}', rest_pilots.toString()).replace('{hulls}', rest.length.toString())}
                {rest.length > 0 && !engagement && participants.ended_in_pod > 0 && ' · '}
                {!engagement && participants.ended_in_pod > 0 && t('fleets.after.pods').replace('{count}', participants.ended_in_pod.toString())}
            </span>
            {rest.length > 0 &&
                <button type="button" x-on:click="all = !all" x-text={`all ? ${JSON.stringify(t('fleets.after.show_fewer'))} : ${JSON.stringify(t('fleets.after.show_all'))}`}>
                    {t('fleets.after.show_all')}
                </button>
            }
        </div>
    }

    {participants.opsec_filtered && <small class="[ fleet-flew__opsec ]">{t('fleets.after.opsec')}</small>}
</section>

<style lang="scss">
    .fleet-flew {
        display: flex;
        flex-direction: column;
        gap: var(--space-s);
        max-width: var(--max-col-width);

        header {
            display: flex;
            flex-wrap: wrap;
            gap: var(--space-3xs) var(--space-m);
            align-items: baseline;
            justify-content: space-between;
        }
    }

    .fleet-flew__pills {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2xs);

        button {
            min-height: 2.75rem;
            padding: 0 var(--space-s);
            background: transparent;
            border: 1px solid var(--hairline-strong);
            color: var(--foreground);
            font: inherit;
            font-weight: 700;
            cursor: pointer;

            &:hover {
                border-color: var(--foreground);
            }

            &:focus-visible {
                outline: 2px solid var(--fleet-yellow);
                outline-offset: 2px;
            }

            &[aria-pressed='true'] {
                background-color: var(--highlight);
                border-color: var(--highlight);
                color: var(--background);
            }
        }
    }

    .fleet-flew__toggle {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2xs);
        min-height: 2.75rem;
        padding: 0;
        background: transparent;
        border: 0;
        color: var(--highlight);
        font: inherit;
        text-align: left;
        cursor: pointer;

        &:focus-visible {
            outline: 2px solid var(--fleet-yellow);
            outline-offset: 2px;
        }
    }

    .fleet-flew__chips {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3xs) var(--space-2xs);
        align-items: center;
    }

    .fleet-flew__opsec {
        color: var(--text-muted);
    }

    .fleet-after__scroll {
        overflow-x: auto;
        max-width: 100%;
    }

    .fleet-after__table {
        inline-size: 100%;
        min-inline-size: 36rem;
        border-collapse: separate;
        border-spacing: 0 3px;

        thead th {
            padding: 0 var(--space-s) var(--space-3xs);
            font-size: var(--step--2);
            font-weight: 700;
            letter-spacing: 0.1em;
            text-align: left;
            text-transform: uppercase;
            opacity: 0.8;
        }

        tbody td,
        tbody th {
            padding: var(--space-3xs) var(--space-s);
            background-color: var(--component-background);
            text-align: left;
            vertical-align: middle;
        }

        tbody th {
            font-weight: 400;
            color: var(--highlight);
        }

        td:first-child {
            inline-size: 40px;
        }

        img {
            display: block;
            max-inline-size: none;
        }

        .num {
            text-align: right;
            font-variant-numeric: tabular-nums;
        }

        b {
            color: var(--highlight);
        }
    }

    .fleet-after__bar {
        inline-size: 40%;

        span {
            display: block;
            block-size: 0.6rem;
            background-color: var(--fleet-yellow);
        }
    }

    .fleet-after__fills {
        padding: 2px var(--space-2xs);
        border: 1px solid var(--border-color-hover);
        font-size: var(--step--1);
        color: var(--highlight);
    }

    .fleet-after__more {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2xs) var(--space-m);
        align-items: center;
        justify-content: space-between;
        padding: var(--space-2xs) var(--space-s);
        border: 1px dashed var(--border-color-hover);

        button {
            min-height: 2.75rem;
            background: transparent;
            border: 0;
            color: var(--foreground);
            font: inherit;
            font-weight: 700;
            cursor: pointer;

            &:focus-visible {
                outline: 2px solid var(--fleet-yellow);
            }
        }
    }

    .fleet-after__chip {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3xs);
        padding: 2px var(--space-2xs) 2px 2px;
        border: 1px solid var(--border-color-hover);
        font-size: var(--step--1);
        color: var(--highlight);
    }
</style>
