---
export interface CampaignStat {
    label:  string;
    value:  string;
    title?: string;
}

interface Props {
    stats:              CampaignStat[];
    variant?:           'boxed' | 'inline';
    [propName: string]: any;
}

const {
    stats,
    variant = 'boxed',
    ...attributes
} = Astro.props

delete attributes.class

import Grid from '@components/compositions/Grid.astro'
import StatCard from '@components/blocks/StatCard.astro'
---

{variant === 'inline' ?
    <div
        class:list={['[ campaign-stat-bar campaign-stat-bar-inline ]', Astro.props.class]}
        {...attributes}
    >
        {stats.map(stat =>
            <StatCard variant="cell" label={stat.label} value={stat.value} title={stat.title} />
        )}
    </div>
    :
    <Grid
        min_item_width='7rem'
        row_gap='var(--space-3xs)'
        column_gap='var(--space-3xs)'
        class:list={['[ campaign-stat-bar campaign-stat-bar-boxed ][ light-transparency ]', Astro.props.class]}
        {...attributes}
    >
        {stats.map(stat =>
            <StatCard variant="cell" label={stat.label} value={stat.value} title={stat.title} />
        )}
    </Grid>
}

<style lang="scss">
    .campaign-stat-bar-boxed {
        border: solid 1px var(--border-color);
        padding: var(--space-2xs);
        width: 100%;
    }

    .campaign-stat-bar-inline {
        display: flex;
        flex-wrap: wrap;
        align-items: stretch;
        row-gap: var(--space-2xs);

        :global(.campaign-stat) {
            padding-block: 0;
            padding-inline: var(--space-s);
            border-left: solid 1px var(--border-color-hover);

            &:first-child {
                padding-inline-start: 0;
                border-left: none;
            }
        }
    }

    @media screen and (max-width: 767px) {
        .campaign-stat-bar-inline {
            display: grid;
            grid-template-columns: repeat(3, auto);
            justify-content: space-between;
            width: 100%;

            :global(.campaign-stat) {
                padding-inline: var(--space-xs);
            }

            :global(.campaign-stat-label) {
                font-size: var(--step--2);
            }
        }
    }
</style>
