---
import type { TribeAboutVital } from '@helpers/tribe_about'

interface Props {
    /** One plain-text line above the write-up. */
    lede?: string
    markdown?: string
    vitals: TribeAboutVital[]
}

const { lede, markdown, vitals } = Astro.props

import TextBox from '@components/layout/TextBox.astro'
import Markdown from '@components/blocks/Markdown.astro'
---

<section class="[ intro ]">
    <div class="[ words ]">
        {lede && <p class="[ lede ]">{lede}</p>}
        {markdown &&
            <TextBox max_width="100%">
                <Markdown markdown={markdown} />
            </TextBox>
        }
    </div>
    <dl class="[ vitals ]">
        {vitals.map((vital) => (
            <div class="[ vital ]">
                <dt class="[ vital-label ]">
                    {vital.label}
                    {vital.detail && <span class="[ vital-detail ]"> · {vital.detail}</span>}
                </dt>
                <dd class="[ vital-value ]">{vital.value}</dd>
            </div>
        ))}
    </dl>
</section>

<style lang="scss">
    .intro {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(22rem, 100%), 1fr));
        gap: var(--space-xl);
        align-items: center;
    }

    .words {
        display: flex;
        flex-direction: column;
        gap: var(--space-s);
        min-inline-size: 0;
    }

    .lede {
        margin: 0;
        max-inline-size: var(--max-text-width);
        font-size: var(--step-1);
        color: var(--highlight);
    }

    .vitals {
        margin: 0;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        grid-auto-rows: 1fr;
        gap: 1px;
        background: var(--border-color-hover);
        border: 1px solid var(--border-color-hover);
    }

    // Number above its label; the dt stays first in the source for screen readers.
    .vital {
        display: flex;
        flex-direction: column-reverse;
        justify-content: center;
        gap: var(--space-3xs);
        padding: var(--space-s) var(--space-m);
        background: var(--component-background);
    }

    .vital-value {
        margin: 0;
        font-family: var(--heading-font);
        font-size: var(--step-4);
        line-height: 1;
        color: var(--highlight);
        font-variant-numeric: tabular-nums;
    }

    .vital-label {
        font-size: var(--step--1);
    }

    .vital-detail {
        color: var(--faded);
    }
</style>
