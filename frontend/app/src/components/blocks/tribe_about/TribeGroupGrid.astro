---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { TribeAboutGroup } from '@dtypes/api.minmatar.org'
import { TRIBE_ABOUT_STAGES, order_groups } from '@helpers/tribe_about'

interface Props {
    groups: TribeAboutGroup[]
    tribe_id: number
    title: string
    caption?: string
    /** Codes in reading order; unknown groups follow by name. */
    order?: string[]
}

const {
    groups,
    tribe_id,
    title,
    caption,
    order = [],
} = Astro.props

const ordered = order_groups(groups, order)
// Groups with nothing to measure yet sit in one strip, so the grid stays full.
const measured = ordered.filter((group) => !group.manual)
const coming_soon = ordered.filter((group) => group.manual)

import TribeAboutSection from '@components/blocks/tribe_about/TribeAboutSection.astro'
import TribeGroupYearCard from '@components/blocks/tribe_about/TribeGroupYearCard.astro'
---

<TribeAboutSection title={title} caption={caption}>
    <div class="[ group-grid ]">
        {measured.map((group) => (
            <TribeGroupYearCard
                group={group}
                tribe_id={tribe_id}
                stage={TRIBE_ABOUT_STAGES[group.code]}
            />
        ))}
    </div>
    {coming_soon.length > 0 &&
        <ul class="[ coming-soon ]">
            {coming_soon.map((group) => {
                const stage = TRIBE_ABOUT_STAGES[group.code]
                return (
                    <li>
                        {stage && <span class="[ tribe-about-eyebrow ]">{t(stage.verb)}</span>}
                        <a href={translatePath(`/alliance/tribes/${tribe_id}/${group.id}/`)}>{group.name}</a>
                        <span class="[ coming-soon__note ]">{t('tribes.about.coming_soon_note')}</span>
                    </li>
                )
            })}
        </ul>
    }
</TribeAboutSection>

<style lang="scss">
    // Three across on wide screens so six groups fill two rows.
    .group-grid {
        display: grid;
        grid-template-columns: repeat(
            auto-fit,
            minmax(max(min(18rem, 100%), calc((100% - 2 * var(--space-s)) / 3)), 1fr)
        );
        gap: var(--space-s);
    }

    .coming-soon {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);

        li {
            display: flex;
            flex-wrap: wrap;
            align-items: baseline;
            gap: var(--space-2xs) var(--space-s);
            padding: var(--space-s) var(--space-m);
            box-shadow: inset 0 0 0 1px var(--border-color-hover);
        }

        a {
            font-family: var(--heading-font);
            font-size: var(--step-1);
            color: var(--highlight);
            text-decoration: none;

            &:focus-visible {
                outline: 2px solid var(--fleet-yellow);
                outline-offset: 2px;
            }
        }
    }

    @media (hover: hover) {
        .coming-soon a:hover {
            text-decoration: underline;
        }
    }

    .coming-soon__note {
        font-size: var(--step--1);
        color: var(--faded);
    }
</style>
