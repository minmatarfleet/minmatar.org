---
interface Row {
    label: string
    value: number
    display: string
}

interface Props {
    title: string
    rows: Row[]
    [propName: string]: any
}

const {
    title,
    rows,
    ...attributes
} = Astro.props

delete attributes.class

const peak = Math.max(1, ...rows.map((row) => row.value))
---

{rows.length > 0 &&
    <div class:list={['[ ranked-bars ]', Astro.props.class]} {...attributes}>
        <h3 class="[ tribe-about-eyebrow ]">{title}</h3>
        <ol>
            {rows.map((row) => (
                <li>
                    <span class="[ ranked-bars__label ]">{row.label}</span>
                    <span class="[ ranked-bars__value ]">{row.display}</span>
                    <span class="[ ranked-bars__track ]" aria-hidden="true">
                        <span class="[ ranked-bars__bar ]" style={`inline-size: ${(row.value / peak) * 100}%`}></span>
                    </span>
                </li>
            ))}
        </ol>
    </div>
}

<style lang="scss">
    .ranked-bars {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
    }

    ol {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
    }

    li {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: var(--space-3xs) var(--space-xs);
    }

    .ranked-bars__label {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--highlight);
    }

    .ranked-bars__value {
        font-family: var(--heading-font);
        color: var(--highlight);
        font-variant-numeric: tabular-nums;
        text-align: end;
    }

    .ranked-bars__track {
        grid-column: 1 / -1;
        block-size: var(--space-3xs);
        background: var(--border-color-hover);
    }

    .ranked-bars__bar {
        display: block;
        block-size: 100%;
        background: var(--fleet-yellow);
    }
</style>
