---
/**
 * The Pings tab of /intel/timers/manage/: the last 100 structure pings the
 * bot sent, and whether Discord took them. The Failed chip is the
 * "needs attention" view. structure_timers_manage_component (part=pings)
 * renders it again when a chip changes.
 */
import { i18n } from '@helpers/i18n'
const { t, translatePath, lang } = i18n(Astro.url)

import type { StructurePing } from '@dtypes/api.minmatar.org'
import type { ManageColumn } from '@dtypes/layout_components'
import { eve_short_day_time, notification_label } from '@helpers/manage_intel'
import { query_string } from '@helpers/string'

interface Props {
    pings:              StructurePing[];
    view?:              'all' | 'failed';
    [propName: string]: any;
}

const { pings, view = 'all' } = Astro.props

const failed = pings.filter((ping) => !ping.discord_success)
const rows = view === 'failed' ? failed : pings

const COLUMNS: ManageColumn[] = [
    { label: t('manage.timers.col_kind') },
    { label: t('manage.timers.col_sent'), align: 'num', sort: 'descending', phone: false },
    { label: t('manage.timers.col_discord'), align: 'num' },
]

import EmptyState from '@components/blocks/EmptyState.astro'
import ViewChips from '@components/blocks/manage/ViewChips.astro'
import ManageTable from '@components/blocks/manage/ManageTable.astro'
---

<div class="[ manage-list ]" id="pings-list-root">
    <ViewChips
        id="pings-filters"
        url={translatePath(`/partials/structure_timers_manage_component/?${query_string({ part: 'pings' })}`)}
        target="pings-list"
        selected={view}
        legend={t('manage.timers.pings_views')}
        views={[{ value: 'all', label: t('manage.timers.pings_all'), count: pings.length }]}
        attention={[{ value: 'failed', label: t('manage.timers.pings_failed'), count: failed.length, tone: 'warn' }]}
    >
        <p class="[ manage-muted ]">{t('manage.timers.pings_hint')}</p>
    </ViewChips>
    <div id="pings-list" class="[ manage-list ]" aria-live="polite">
        {rows.length === 0 ?
            <EmptyState title={view === 'failed' ? t('manage.timers.pings_empty_failed') : t('manage.timers.pings_empty')} />
            :
            <ManageTable caption={t('manage.timers.pings_caption')} columns={COLUMNS} expandable={false}>
                {rows.map((ping) =>
                    <tbody>
                        <tr class="[ manage-row ]">
                            <td class="[ pings__summary ]">
                                <span class="[ manage-who__text ]">
                                    <span class="[ manage-who__name ]">{notification_label(ping.notification_type)}</span>
                                    <span class="[ manage-who__sub pings__text ]" title={ping.summary}><span class="[ pings__phone-time ]">{eve_short_day_time(ping.created_at, lang)} · </span>{ping.summary}</span>
                                </span>
                            </td>
                            <td class="[ num is-wide pings__when ]">{eve_short_day_time(ping.created_at, lang)}</td>
                            <td class:list={['num', ping.discord_success ? 'manage-good' : 'manage-warn']}>
                                {ping.discord_success ? t('manage.timers.ping_sent') : t('manage.timers.ping_failed')}
                            </td>
                        </tr>
                    </tbody>
                )}
            </ManageTable>
        }
    </div>
</div>

<style lang="scss">
    // The summary takes what is left and truncates; hover shows it whole.
    .pings__summary {
        width: 100%;
        max-width: 0;
    }

    .pings__text {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .pings__phone-time {
        display: none;
        color: var(--highlight);

        @media (max-width: 48rem) {
            display: inline;
        }
    }

    .pings__when {
        color: var(--highlight);
    }
</style>
