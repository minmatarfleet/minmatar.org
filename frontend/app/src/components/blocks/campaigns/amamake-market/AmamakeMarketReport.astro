---
import { i18n } from '@helpers/i18n'
const { lang, t, translatePath } = i18n(Astro.url)

import {
    AMA_KILLS,
    CAP_CATS,
    CAP_ISK_B,
    CUTOFF_NOTE,
    DIED_CATS,
    DIED_LOST,
    DIED_SOLD,
    ESI_MARKETS,
    FOCUS_TITLE,
    FUZZWORK_STATION,
    HUB_HEALTH,
    IMPORT_ROWS,
    ISK_SOLD,
    ISK_SOLD_VS_JULY,
    KAMELA_AAR,
    LP_GUIDE_PATH,
    LP_OFFERS_PATH,
    LP_ROWS,
    PERIOD_LABEL,
    SELL_ORDERS_PATH,
    SOLD_CATS,
    SOLD_ISK_B,
    SUB_ISK_B,
    VOL_CATS,
    VOL_KILLS,
    WEEK_CATS,
    WEEK_ISK_B,
    ZKILL_AMA,
} from '@/data/amamake-market/2026-08'
import { formatIsk } from '@/data/campaigns/hek'

import type { CampaignTableRow } from '@/data/campaigns/etherium-reach'

import TextBox from '@components/layout/TextBox.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import Grid from '@components/compositions/Grid.astro'
import CampaignStat from '@components/blocks/campaigns/etherium-reach/CampaignStat.astro'
import CampaignDataTable from '@components/blocks/campaigns/etherium-reach/CampaignDataTable.astro'
import Button from '@components/blocks/Button.astro'
import AmamakeBarChart from '@components/blocks/campaigns/amamake-market/AmamakeBarChart.astro'
import CountUpAnimation from '@components/blocks/CountUpAnimation.astro'
import { number_name } from '@helpers/numbers'
import WalletEVEIcon from '@components/icons/WalletEVEIcon.astro'
import KillReportEVEIcon from '@components/icons/KillReportEVEIcon.astro'

const vs_july_pct = Math.round(ISK_SOLD_VS_JULY * 100)
const health_pct = Math.round(HUB_HEALTH * 100)

const import_headers = ['Type', 'Amamake', 'Jita', 'Freight in', 'Call']
const lp_headers = ['Offer', 'Militia', 'ISK/LP', '30d vol']
const import_rows: CampaignTableRow[] = IMPORT_ROWS
const lp_rows: CampaignTableRow[] = LP_ROWS
---

<TextBox>
    <Flexblock gap="var(--space-m)">
        <h2>The month</h2>
        <div class="amamake-report__prose">
            <p>
                Hello sales tax enjoyers. This structure is still sixth on Fuzzwork
                by sell orders, behind Jita, Amarr, Dodixie, Hek, and Rens. In March
                the open book was about 800 billion ISK. It closed August around
                1.89 trillion on the sell side, with 1.22 trillion of inferred fills.
                CCP does not publish structure transactions; we watch the order book
                move about every fifteen minutes and treat the total as a floor.
                Amarr dock here. Gallente and Caldari hulls sold here. This is a
                freeport on the warzone, not an alliance ledger.
            </p>
            <p>
                ISK through the book was up 15% from July. Units were down 56%.
                Tritanium still wins the unit tape. Money moved in modules (441B),
                ships (423B), injectors, nanite, and expensive restock. Charges were
                92 billion ISK and 75 million units — the plexing ammo. The
                warzone around the shop put 52,110 killmails on the board and
                destroyed 3.86 trillion ISK. Amamake was one in five of those mails.
            </p>
            <p>
                What made August different is not the shop. Kamela ate fifty
                capitals while this undock ate Typhoons, and the 15th was a local
                meat grinder, not a region-wide node. That is the focus of the
                month.
            </p>
        </div>
    </Flexblock>
</TextBox>

<TextBox>
    <Flexblock gap="var(--space-m)">
        <Flexblock gap="var(--space-3xs)">
            <h2>By the numbers</h2>
            <small>{PERIOD_LABEL} · inferred fills at the freeport</small>
        </Flexblock>
        <Grid min_item_width="12rem" class="[ w-full ]">
            <CampaignStat label="Inferred ISK sold" tone="success">
                <div slot="icon" class="amamake-report__stat-icon" aria-hidden="true">
                    <WalletEVEIcon />
                </div>
                <span data-tippy-content={number_name(ISK_SOLD, lang)}>{formatIsk(ISK_SOLD)}</span>
            </CampaignStat>
            <CampaignStat label="versus July ISK" tone="success">
                <span>+{vs_july_pct}%</span>
            </CampaignStat>
            <CampaignStat label="Killmails in Amamake">
                <div slot="icon" class="amamake-report__stat-icon" aria-hidden="true">
                    <KillReportEVEIcon />
                </div>
                <CountUpAnimation
                    element="span"
                    target={AMA_KILLS}
                    data-tippy-content={number_name(AMA_KILLS, lang)}
                />
            </CampaignStat>
            <CampaignStat label="Sells within markup of Jita">
                <span>{health_pct}%</span>
            </CampaignStat>
        </Grid>
    </Flexblock>
</TextBox>

<TextBox>
    <Flexblock gap="var(--space-m)">
        <h2>Through the book</h2>
        <div class="amamake-report__prose">
            <p>
                Quiet days still clear about 30 billion — ammo, paste, and people
                who live here. The loudest day this month was the 15th at 58.8
                billion. Inventory for the floor. Make margin on the spikes.
            </p>
        </div>
        <AmamakeBarChart
            chart_id="amamake-week-isk"
            aria_label="Inferred ISK sold at the freeport by week"
            categories={WEEK_CATS}
            series={[{ name: 'ISK sold (billion)', data: WEEK_ISK_B, color_token: '--alliance-blue' }]}
            y_label="ISK sold (billion)"
        />
        <small>
            Inferred ISK sold at the freeport, billions, by week. August 2026.
            Week of 15–21 is 305B; 2,081 of that week’s 3,203 Amamake mails
            landed on the 15th. Order-book diffs, ~15 minute snapshots.
        </small>
    </Flexblock>
</TextBox>

<TextBox>
    <Flexblock gap="var(--space-m)">
        <Flexblock gap="var(--space-3xs)">
            <h2>Focus of the month</h2>
            <p class="amamake-report__focus">{FOCUS_TITLE}</p>
        </Flexblock>
        <div class="amamake-report__prose">
            <p>
                On the 15th, Amamake logged 2,081 killmails. Next system that day:
                Eytjangard at 211. The structure’s 58.8 billion was the loudest
                market day of the month, and it was a Tuesday in Heimatar, not a
                nullsec CTA.
            </p>
            <p>
                If you only watch this undock you will think expensive ships die
                here. They do not, relatively. Kamela was sixth in warzone mails
                and second in ISK destroyed (489 billion). Fifty capitals left the
                field: 17 Revelations, 9 Zirnitras, 9 Phoenixes, 6 Apostles, 4
                Revelation Navy Issues, 3 Moros, 2 Naglfars, plus 51 Tempest Fleet
                Issues. Those fifty hulls are 272 billion of Kamela’s 489. Amamake
                lost 37 capitals, including a Nyx, and that is still only about a
                third of the 896 billion that died in system. Dal, the occupancy
                fight, is almost all subcaps.
            </p>
        </div>
        <AmamakeBarChart
            chart_id="amamake-cap-sub"
            aria_label="ISK destroyed, capitals versus subcaps"
            categories={CAP_CATS}
            series={[
                { name: 'Capital ISK (billion)', data: CAP_ISK_B, color_token: '--fleet-yellow' },
                { name: 'Subcap ISK (billion)', data: SUB_ISK_B, color_token: '--fleet-red' },
            ]}
            y_label="ISK destroyed (billion)"
        />
        <small>
            ISK destroyed, billions. Capitals (dreadnought, carrier,
            supercarrier, titan, FAX, capital industrial, jump freighter)
            versus everything else. August 2026, zKill totalValue.
        </small>
        <div class="amamake-report__prose">
            <p>
                There was a 350 billion afternoon in Kamela at the end of the
                month. Do not restock Amamake as if it happened on this undock.
                What died one jump off the shop was 165 Typhoons, 126 Abaddons, and
                72 Hyperions. Dropping a FAX in k-space is usually a statement —
                escalate, or die — and Kamela spent August doing that. This hub
                spent August selling destroyers.
            </p>
        </div>
        <FlexInline>
            <Button href={KAMELA_AAR} size="sm" new_tab={true} external={true}>
                AAR: 350B down in Kamela (29 Aug)
            </Button>
        </FlexInline>
    </Flexblock>
</TextBox>

<TextBox>
    <Flexblock gap="var(--space-m)">
        <h2>The catchment</h2>
        <div class="amamake-report__prose">
            <p>
                We watch 72 Amarr–Minmatar systems. Amamake is the shop and a pipe,
                so it will usually lead killmails. The Heimatar run — Amamake,
                Auga, Siseide, Dal, Vard, Lantorn — was 23,760 mails this month,
                46% of the warzone. Kourmonen is still the volume system in the
                Bleak Lands. About 4,500 unique characters showed up on Amamake
                mails. That is whoever flew the pipe, not a corporation.
            </p>
        </div>
        <AmamakeBarChart
            chart_id="amamake-kills-by-system"
            aria_label="Killmails by system in August"
            categories={VOL_CATS}
            series={[{ name: 'Killmails', data: VOL_KILLS, color_token: '--fleet-red' }]}
            y_label="Killmails"
            horizontal={true}
        />
        <small>
            Killmails, August 2026, 72 monitored systems. Heimatar 47% of
            mails, Metropolis 30%, Bleak Lands 21% of mails and 1.17T
            destroyed — more ISK than Metropolis on fewer mails.
        </small>
        <div class="amamake-report__prose">
            <p>
                Occupancy is a snapshot, not a monthly average (31 Aug 12:03 UTC;
                we only have about eight days of contested history). Amamake was
                Minmatar-held and 0.1% quiet — dock, buy, leave. The loud systems
                were Amarr-held and being taken: Hadozeko 73% Minmatar, Dal 56%,
                Eszur 53%, Vard and Ardar around 31%. Kamela was Minmatar-held,
                Amarr pushing at 25%. Huola was quiet Amarr. Shop in the quiet
                ones. Plex in the loud ones.
            </p>
        </div>
    </Flexblock>
</TextBox>

<TextBox>
    <Flexblock gap="var(--space-m)">
        <h2>What sold</h2>
        <div class="amamake-report__prose">
            <p>
                163,137 inferred fills, 2,842 types, 170 million units. Rank by
                ISK or Tritanium, Pyerite, and Hail always look like the story.
                Large skill injectors were 29.9 billion on 38 fills. Nanite was
                20.7 billion on 657,000 units. Then Hecates, T2 bulkheads, 600
                Thrasher Fleet Issues, 12.8 million helium isotopes, extractors,
                Navy cap booster 3200s, and Navy/Fleet cruisers around 8 billion
                each. Two 7.5 billion Rorqual BPC fills came out of the extract;
                omitted until a second month shows they were not a sellout.
            </p>
        </div>
        <AmamakeBarChart
            chart_id="amamake-top-sold"
            aria_label="Top types by inferred ISK"
            categories={SOLD_CATS}
            series={[{ name: 'ISK (billion)', data: SOLD_ISK_B, color_token: '--alliance-blue' }]}
            y_label="ISK (billion)"
            horizontal={true}
        />
        <small>
            Top types by inferred ISK, billions (quantity times fill price).
            LSI = Large Skill Injector. TFI = Thrasher Fleet Issue. Amamake
            structure, August 2026.
        </small>
    </Flexblock>
</TextBox>

<TextBox>
    <Flexblock gap="var(--space-m)">
        <h2>Import vs local</h2>
        <div class="amamake-report__prose">
            <p>
                Same goal as March: things that actually move, under 20% of Jita
                after freight. Jita to Amamake is 450 ISK/m³ packaged. Fleet Issue
                is already there. Typhoons are not. Hail and Republic Fleet EMP
                print Jita — pickup, not a jump freighter.
            </p>
        </div>
        <CampaignDataTable
            headers={import_headers}
            rows={import_rows}
            striped={true}
            success_marker={false}
        />
        <small>
            Lowest Amamake sell vs Jita average, 31 Aug, after 450 ISK/m³
            (destroyer 2,500 m³, tactical dest. 5,000, cruiser 10,000,
            battlecruiser 15,000, battleship 50,000). Skip = local already
            cheaper. Haul = Jita plus freight still wins.
        </small>
    </Flexblock>
</TextBox>

<TextBox>
    <Flexblock gap="var(--space-m)">
        <h2>Died vs sold</h2>
        <div class="amamake-report__prose">
            <p>
                Hulls lost in Amamake versus inferred sells of the same type.
                Capsules (1,468) and Ventures (330) omitted. Typhoon is 165 lost /
                35 sold — it blows the scale, so it is in the import table
                instead. Tackle sold faster than it died. Battleships did not.
                If you manufacture or import one hull next month, start there.
            </p>
        </div>
        <AmamakeBarChart
            chart_id="amamake-died-sold"
            aria_label="Hulls sold versus lost in Amamake"
            categories={DIED_CATS}
            series={[
                { name: 'Inferred sells', data: DIED_SOLD, color_token: '--alliance-blue' },
                { name: 'Lost in Amamake', data: DIED_LOST, color_token: '--fleet-red' },
            ]}
            y_label="Count"
        />
        <small>
            August counts. Sells: inferred fills. Losses: killmails in
            Amamake (30002537) only. Kamela lost 6 Typhoons and 50 capitals.
        </small>
    </Flexblock>
</TextBox>

<TextBox>
    <Flexblock gap="var(--space-m)">
        <h2>Build in Amamake</h2>
        <div class="amamake-report__prose">
            <p>
                Sotiyo and Tatara, faction warfare level 5, 0.75% facility tax.
                The system cost index is high because the system is busy; the
                −50% rebate is why you still job here. Month-end snapshot (31 Aug):
                Amamake manufacturing 0.135 / reaction 0.136, Jita 0.170, Auner
                0.103 / 0.150, Basgerin 0.051 / 0.074, Amo 0.041, Auga 0.002.
                Refine and T1 in Amo (120 ISK/m³ in). Keep reactions off Auner.
                Do not job in Auga — cheap index, no buyers.
            </p>
            <p>
                Thrasher Fleet Issue, Stabber / Exequror / Vexor Navy, and
                Hurricane Fleet Issue cleared at or under Jita. Typhoons did not.
                Build the first group. Import the second. Industry legs (Amo,
                Auner, Basgerin) are 120 ISK/m³. The 450 pipe is for the haul
                column. 152 jobs touched Amamake, 16.5 million m³, 15.3 billion
                in rewards. No character names.
            </p>
        </div>
    </Flexblock>
</TextBox>

<TextBox>
    <Flexblock gap="var(--space-m)">
        <h2>Loyalty points</h2>
        <div class="amamake-report__prose">
            <p>
                Public store math only. Convert TLIB or 24th Imperial into hulls
                this book already sells. Don’t chase paper ISK/LP on day one, and
                don’t haul the output in an Iteron. The offers tool works for any
                faction. Plex in the loud systems above; job and sell here.
            </p>
        </div>
        <CampaignDataTable
            headers={lp_headers}
            rows={lp_rows}
            striped={true}
            success_marker={false}
        />
        <small>
            Buy conversion, 31 Aug. Corps 1000182 and 1000179. Amarr plates
            lead on rate; TLIB painters and Fleet BPCs lead on volume into
            this hub.
        </small>
        <FlexInline>
            <Button href={translatePath(LP_GUIDE_PATH)} size="sm">
                {t('campaigns.amamake_market.lp_guide')}
            </Button>
            <Button href={translatePath(LP_OFFERS_PATH)} size="sm">
                {t('campaigns.amamake_market.lp_offers')}
            </Button>
        </FlexInline>
    </Flexblock>
</TextBox>

<TextBox>
    <Flexblock gap="var(--space-m)">
        <h2>The shelf</h2>
        <div class="amamake-report__prose">
            <p>
                99% of tracked types have a sell order. 72% of those sells are
                within markup of Jita. 77% doctrine contract coverage. About 1.89
                trillion on sells, 0.94 on contracts. Nanite 28,180 with hundreds
                of thousands on the shelf. Hail is a pickup. Thrasher Fleet Issue
                16.8 million. Typhoon 195 million and thin. We do not list which
                fittings are empty; the public page already shows what’s low.
            </p>
            <p>
                You can undock a fitted destroyer without a hauler alt. Travel to
                Amamake — 5 times nearly AT winners, buy the ship, pick a small
                complex off the Agency window. The book does not check your militia.
            </p>
        </div>
        <FlexInline>
            <Button href={translatePath(SELL_ORDERS_PATH)} size="sm">
                {t('campaigns.amamake_market.sell_orders')}
            </Button>
            <Button href={FUZZWORK_STATION} size="sm" new_tab={true} external={true}>
                Fuzzwork station book
            </Button>
            <Button href={ZKILL_AMA} size="sm" new_tab={true} external={true}>
                zKill Amamake
            </Button>
            <Button href={ESI_MARKETS} size="sm" new_tab={true} external={true}>
                How we run the markets (Mar YC128)
            </Button>
        </FlexInline>
        <small>
            Inferred fills from order-book diffs. Killmails: 72 monitored
            faction warfare systems. Occupancy: 31 Aug 12:03 UTC snapshot.
            No operator names, empty fittings, or live hull depth. {CUTOFF_NOTE}
        </small>
    </Flexblock>
</TextBox>

<style lang="scss">
    .amamake-report__prose {
        p {
            font-size: var(--step-0);
            line-height: 1.6;
            max-width: 70ch;
        }

        p + p {
            margin-block-start: var(--space-s);
        }
    }

    .amamake-report__focus {
        font-weight: 600;
        font-size: var(--step-0);
        margin: 0;
    }

    .amamake-report__stat-icon {
        width: var(--space-l);
        height: var(--space-l);
        flex-shrink: 0;
    }

    small {
        color: var(--highlight);
        max-width: 70ch;
    }
</style>
