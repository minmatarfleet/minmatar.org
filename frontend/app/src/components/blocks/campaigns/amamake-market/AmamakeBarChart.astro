---
interface ChartSeries {
    name: string
    data: number[]
    /** CSS custom property name, e.g. `--alliance-blue`. */
    color_token: string
}

interface Props {
    chart_id: string
    aria_label: string
    categories: string[]
    series: ChartSeries[]
    y_label: string
    horizontal?: boolean
    [propName: string]: any
}

const {
    chart_id,
    aria_label,
    categories,
    series,
    y_label,
    horizontal = false,
} = Astro.props

const chart_payload = JSON.stringify({
    chart_id,
    categories,
    series,
    y_label,
    horizontal,
})
---

<div
    class="[ amamake-bar-chart ]"
    x-data={`{
        payload: ${chart_payload},
        token_color(token) {
            return getComputedStyle(document.documentElement).getPropertyValue(token).trim()
        },
        init() {
            var ctx = document.getElementById(this.payload.chart_id).getContext('2d')
            var payload = this.payload
            Chart.defaults.borderColor = 'color-mix(in srgb, var(--foreground) 8%, transparent)'
            Chart.defaults.color = getComputedStyle(document.documentElement).getPropertyValue('--foreground').trim()
            Chart.defaults.font.family = getComputedStyle(document.documentElement).getPropertyValue('--default-font').trim()

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: payload.categories,
                    datasets: payload.series.map((s) => ({
                        label: s.name,
                        data: s.data,
                        backgroundColor: this.token_color(s.color_token),
                        borderWidth: 0,
                        borderRadius: 2,
                        barPercentage: payload.series.length > 1 ? 0.7 : 0.55,
                        categoryPercentage: 0.8,
                    })),
                },
                options: {
                    indexAxis: payload.horizontal ? 'y' : 'x',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: payload.series.length > 1,
                            position: 'top',
                            align: 'end',
                            labels: { boxWidth: 12, boxHeight: 12, padding: 16 },
                        },
                    },
                    scales: {
                        x: {
                            grid: { display: payload.horizontal },
                            ticks: { maxRotation: 0 },
                            title: payload.horizontal
                                ? { display: true, text: payload.y_label }
                                : { display: false },
                        },
                        y: {
                            beginAtZero: true,
                            title: payload.horizontal
                                ? { display: false }
                                : { display: true, text: payload.y_label },
                            grid: {
                                color: 'color-mix(in srgb, var(--foreground) 8%, transparent)',
                            },
                        },
                    },
                },
            })
        },
    }`}
>
    <canvas id={chart_id} aria-label={aria_label}></canvas>
</div>

<style lang="scss">
    .amamake-bar-chart {
        position: relative;
        width: 100%;
        height: min(20rem, 55vh);
    }

    canvas {
        display: block;
        width: 100%;
        height: 100%;
    }
</style>
