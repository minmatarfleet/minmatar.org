---
import type { CampaignTableRow } from '@/data/campaigns/etherium-reach'
import Button from '@components/blocks/Button.astro'
import DataTable from '@components/blocks/DataTable.astro'

interface Props {
    headers: string[]
    rows: CampaignTableRow[]
    striped?: boolean
    /** Green ▲ on success-tone first cells (campaign tables). Off for industry. */
    success_marker?: boolean
}

const { headers, rows, striped = false, success_marker = true } = Astro.props
const has_actions = rows.some((row) => !!row.action)
const columns = headers.map((label, index) => ({
    key: String(index),
    label,
    numeric: index > 0 && (!has_actions || index < headers.length - 1),
}))
---

<DataTable columns={columns} striped={striped} class:list={[!success_marker && 'er-table--no-markers']}>
    {
        rows.map((row) => (
            <tr
                class:list={[row.tone && `er-table__row--${row.tone}`]}
                data-search={row.search_text ?? row.cells.join(' ').toLowerCase()}
                data-corp={row.corp ?? ''}
                data-csv={JSON.stringify(row.cells)}
            >
                {
                    row.cells.map((cell, index) => {
                        const icon =
                            row.cell_icons?.[index]
                            ?? (index === 0 ? row.icon_url : undefined)
                        return (
                            <td class:list={[index > 0 && 'data-table__numeric']}>
                                {icon ? (
                                    <span class="er-table__name">
                                        <img
                                            class="er-table__icon"
                                            src={icon}
                                            alt=""
                                            width="24"
                                            height="24"
                                            loading="lazy"
                                        />
                                        <span>{cell}</span>
                                    </span>
                                ) : (
                                    cell
                                )}
                            </td>
                        )
                    })
                }
                {has_actions && (
                    <td class="data-table__actions">
                        {row.action ? (
                            <Button
                                size="sm"
                                type="button"
                                data-confirm-title={row.action.confirm_title}
                                data-confirm-content={row.action.confirm_content}
                                data-post-url={row.action.post_url}
                                data-target={row.action.target}
                                x-on:click.prevent="confirm_row_action($el)"
                            >
                                {row.action.label}
                            </Button>
                        ) : null}
                    </td>
                )}
            </tr>
        ))
    }
</DataTable>

<style lang="scss">
    .er-table__name {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2xs);
    }

    .er-table__icon {
        flex-shrink: 0;
        width: 24px;
        height: 24px;
        object-fit: contain;
        border-radius: 2px;
    }

    .er-table__row--info td {
        font-weight: 600;
    }

    .er-table__row--success td:first-child:after {
        content: '▲';
        color: var(--green);
    }

    :global(.er-table--no-markers) .er-table__row--success td:first-child:after {
        content: none;
    }

    .er-table__row--warning td:first-child {
        color: var(--fleet-yellow);
    }
</style>
