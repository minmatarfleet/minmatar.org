---
interface Props {
    percent:            number;
    marker_percent?:    number | null;
    /** Where the fill stood a period ago; the stretch between it and now is drawn as the change. */
    delta_from_percent?: number | null;
    color?:             string;
    track_color?:       string;
    height?:            string;
    label?:             string;
    marker_label?:      string;
    /** Hover text for the fill, the change stretch and the target tick. */
    fill_title?:        string;
    delta_title?:       string;
    marker_title?:      string;
    [propName: string]: any;
}

const {
    percent,
    marker_percent = null,
    delta_from_percent = null,
    color = 'var(--fleet-yellow)',
    track_color = 'var(--border-color)',
    height = 'var(--space-2xs)',
    label,
    marker_label,
    fill_title,
    delta_title,
    marker_title,
    ...attributes
} = Astro.props

delete attributes.class

const safe_percent = Math.min(100, Math.max(0, Number.isFinite(percent) ? percent : 0))
const safe_marker = marker_percent === null ? null : Math.min(100, Math.max(0, marker_percent))
const safe_from = delta_from_percent === null ? null : Math.min(100, Math.max(0, delta_from_percent))
const delta_start = safe_from === null ? 0 : Math.min(safe_from, safe_percent)
const delta_width = safe_from === null ? 0 : Math.abs(safe_percent - safe_from)
const delta_direction = safe_from === null || delta_width === 0 ? 'none' : safe_percent > safe_from ? 'up' : 'down'
---

<div
    class:list={['[ campaign-meter ]', Astro.props.class]}
    role="meter"
    aria-valuenow={Math.round(safe_percent)}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-label={label}
    {...attributes}
>
    <span class="[ campaign-meter-fill ]" title={fill_title} />
    {delta_direction !== 'none' &&
        <span class="[ campaign-meter-delta ]" data-direction={delta_direction} title={delta_title} aria-hidden="true" />
    }
    {safe_marker !== null &&
        <span class="[ campaign-meter-marker ]" title={marker_title ?? marker_label} />
    }
    {fill_title && <span class="[ campaign-meter-rest ]" title={fill_title} aria-hidden="true" />}
</div>

<style lang="scss" define:vars={{
    campaign_meter_percent: `${safe_percent}%`,
    campaign_meter_marker: `${safe_marker ?? 0}%`,
    campaign_meter_delta_start: `${delta_start}%`,
    campaign_meter_delta_width: `${delta_width}%`,
    campaign_meter_color: color,
    campaign_meter_track_color: track_color,
    campaign_meter_height: height,
}}>
    .campaign-meter {
        position: relative;
        display: block;
        width: 100%;
        height: var(--campaign_meter_height);
        background-color: var(--campaign_meter_track_color);
        overflow: hidden;
    }

    .campaign-meter-fill {
        position: absolute;
        inset-block: 0;
        inset-inline-start: 0;
        width: var(--campaign_meter_percent);
        background-color: var(--campaign_meter_color);
    }

    /* The last 24 hours: a hatched stretch from where the bar was to where it is. Up eats into the track, down shows what was given back. */
    .campaign-meter-delta {
        position: absolute;
        inset-block: 0;
        inset-inline-start: var(--campaign_meter_delta_start);
        width: var(--campaign_meter_delta_width);
        background-image: repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.55) 0 2px, transparent 2px 5px);
        opacity: 0.9;
    }

    .campaign-meter-delta[data-direction="down"] {
        background-image: repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.28) 0 2px, transparent 2px 5px);
    }

    .campaign-meter-marker {
        position: absolute;
        inset-block: 0;
        inset-inline-start: var(--campaign_meter_marker);
        width: 2px;
        background-color: var(--highlight);
        /* a 2px line is not a hover target; widen the hit area without widening the line */
        box-shadow: 0 0 0 4px transparent;
    }

    .campaign-meter-marker::after {
        content: '';
        position: absolute;
        inset-block: 0;
        inset-inline: -5px;
    }

    .campaign-meter-rest {
        position: absolute;
        inset-block: 0;
        inset-inline-start: var(--campaign_meter_percent);
        inset-inline-end: 0;
    }
</style>
