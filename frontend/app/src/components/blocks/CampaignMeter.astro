---
interface Props {
    percent:            number;
    marker_percent?:    number | null;
    color?:             string;
    track_color?:       string;
    height?:            string;
    label?:             string;
    marker_label?:      string;
    [propName: string]: any;
}

const {
    percent,
    marker_percent = null,
    color = 'var(--fleet-yellow)',
    track_color = 'rgba(255, 255, 255, 0.12)',
    height = 'var(--space-2xs)',
    label,
    marker_label,
    ...attributes
} = Astro.props

delete attributes.class

const safe_percent = Math.min(100, Math.max(0, Number.isFinite(percent) ? percent : 0))
const safe_marker = marker_percent === null ? null : Math.min(100, Math.max(0, marker_percent))
---

<div
    class:list={['[ campaign-meter ]', Astro.props.class]}
    role="meter"
    aria-valuenow={Math.round(safe_percent)}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-label={label}
    {...attributes}
>
    <span class="[ campaign-meter-fill ]" />
    {safe_marker !== null &&
        <span class="[ campaign-meter-marker ]" title={marker_label} />
    }
</div>

<style lang="scss" define:vars={{
    campaign_meter_percent: `${safe_percent}%`,
    campaign_meter_marker: `${safe_marker ?? 0}%`,
    campaign_meter_color: color,
    campaign_meter_track_color: track_color,
    campaign_meter_height: height,
}}>
    .campaign-meter {
        position: relative;
        display: block;
        width: 100%;
        height: var(--campaign_meter_height);
        background-color: var(--campaign_meter_track_color);
        overflow: hidden;
    }

    .campaign-meter-fill {
        position: absolute;
        inset-block: 0;
        inset-inline-start: 0;
        width: var(--campaign_meter_percent);
        background-color: var(--campaign_meter_color);
    }

    .campaign-meter-marker {
        position: absolute;
        inset-block: 0;
        inset-inline-start: var(--campaign_meter_marker);
        width: 2px;
        background-color: var(--highlight);
    }
</style>
