---
import { get_public_api_url } from '@helpers/env'
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { NotificationFeaturePreferences } from '@helpers/api.minmatar.org/notification_preferences'

interface Props {
    features: NotificationFeaturePreferences[]
    auth_token: string
}

const { features, auth_token } = Astro.props

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import RadioCheckInput from '@components/blocks/RadioCheckInput.astro'
import NotificationChannelCell from '@components/blocks/NotificationChannelCell.astro'

// One column per channel; a notification type that a channel never sends shows a dash there.
const channels = [
    { key: 'web', label: t('account.channel_web') },
    { key: 'discord', label: t('account.channel_discord') },
    { key: 'eve_mail', label: t('account.channel_eve_mail') },
]

const api_base = `${get_public_api_url()}/api/notifications`
const save_error = t('notification_preferences_save_error')
const features_json = JSON.stringify(features ?? [])
---

<Flexblock
    gap="0"
    class="[ notification-preferences ][ w-full ]"
    x-data={`notification_preferences(${features_json}, ${JSON.stringify(api_base)}, ${JSON.stringify(auth_token)}, ${JSON.stringify(save_error)})`}
>
    <FlexInline justification="space-between" gap="var(--space-s)" class="[ notification-preferences__head ][ items-baseline ]">
        <Flexblock gap="var(--space-3xs)">
            <h2>{t('account.what_we_send')}</h2>
            <small class="[ notification-preferences__muted ]">{t('notification_preferences_description')}</small>
        </Flexblock>
        <small
            class="[ notification-preferences__muted ]"
            aria-live="polite"
            x-text={`saved ? ${JSON.stringify(t('account.saved'))} : ${JSON.stringify(t('account.changes_save'))}`}
        >{t('account.changes_save')}</small>
    </FlexInline>
    <p x-show="error" x-text="error" class="[ text-red ]" role="alert"></p>

    <div class="[ notification-preferences__row notification-preferences__columns ]" aria-hidden="true">
        <span>{t('account.column_notification')}</span>
        {channels.map((channel) => <span>{channel.label}</span>)}
    </div>

    <template x-for="feature in features" :key="feature.feature">
        <div class="[ notification-preferences__feature ]">
            <h3 x-text="feature.feature" class="[ notification-preferences__feature-name ]"></h3>
            <template x-for="ntype in feature.types" :key="ntype.key">
                <div class="[ notification-preferences__row ]">
                    <Flexblock gap="var(--space-3xs)" class="[ min-w-0 ]">
                        <strong x-text="ntype.label"></strong>
                        <small class="[ notification-preferences__muted ]" x-text="ntype.description"></small>
                        <template x-if="ntype.supports_topic_subscription">
                            <RadioCheckInput
                                type="checkbox"
                                x-bind:checked="ntype.topic_subscribed"
                                x-on:change="setTopic(ntype.key, $event.target.checked)"
                                label={t('notification_topic_subscribe')}
                            />
                        </template>
                    </Flexblock>
                    <NotificationChannelCell channel_key={channels[0].key} label={channels[0].label} />
                    <NotificationChannelCell channel_key={channels[1].key} label={channels[1].label} />
                    <NotificationChannelCell channel_key={channels[2].key} label={channels[2].label} />
                </div>
            </template>
        </div>
    </template>

    <small class="[ notification-preferences__muted notification-preferences__foot ]">{t('account.channel_footnote')}</small>
</Flexblock>

<style lang="scss">
    .notification-preferences__head {
        padding-block-end: var(--space-s);
    }

    .notification-preferences__muted {
        color: var(--text-muted);
    }

    .notification-preferences__row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) repeat(3, 7rem);
        gap: var(--space-s);
        align-items: start;
        padding-block: var(--space-2xs) var(--space-s);
    }

    .notification-preferences__columns {
        align-items: center;
        padding-block: var(--space-2xs);
        border-block-start: 1px solid var(--border-color);
        font-family: var(--heading-font);
        font-size: var(--step--2);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);

        > span:not(:first-child) {
            text-align: center;
        }
    }

    .notification-preferences__feature {
        border-block-start: 1px solid var(--border-color);
        padding-block-start: var(--space-s);
    }

    .notification-preferences__feature-name {
        font-size: var(--step--1);
        text-transform: capitalize;
        color: var(--foreground);
    }

    .notification-preferences__foot {
        padding-block-start: var(--space-s);
        border-block-start: 1px solid var(--border-color);
    }

    // Phones: no column header; each channel sits under the description with its name.
    @media (max-width: 48rem) {
        .notification-preferences__row.notification-preferences__columns {
            display: none;
        }

        .notification-preferences__row {
            display: flex;
            flex-wrap: wrap;
            gap: var(--space-xs) var(--space-m);

            > :first-child {
                flex: 1 0 100%;
            }
        }
    }
</style>
