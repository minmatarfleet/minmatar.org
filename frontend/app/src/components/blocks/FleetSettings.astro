---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { FleetUI } from '@dtypes/layout_components'
import { query_string } from '@helpers/string'

/**
 * The Settings tab, for the fleet's FC and strategic FCs: who sees names,
 * edit the fleet, refresh the MOTD, cancel or restore.
 */
interface Props {
    fleet:                  FleetUI;
}

const {
    fleet,
} = Astro.props

const history = Boolean(fleet.tracking?.end_time)
const cancelled = fleet.status === 'cancelled'
const tracking_active = Boolean(fleet.tracking?.start_time) && !history
const editable = !history && !cancelled
const can_cancel = !history && !fleet.tracking

// The state partial reloads the page on success; errors surface as an alert
// and its fallback markup lands in the hidden sink below.
const STATE_URL = `${translatePath('/partials/fleet_state_button_component')}?${query_string({
    fleet_id: fleet.id,
    status: cancelled ? 'pending' : 'cancelled',
})}`
const HIDE_NAMES_URL = `${translatePath('/partials/fleet_hide_names_component')}?${query_string({ fleet_id: fleet.id })}`

import Button from '@components/blocks/Button.astro'
---

<div class="[ fleet-settings ]">
    <section class="[ fleet-settings__card ]" aria-labelledby="fleet-settings-title">
        <h2 id="fleet-settings-title">{t('fleets.command.this_fleet')}</h2>

        {editable &&
            <form
                class="[ fleet-settings__toggle ]"
                hx-post={HIDE_NAMES_URL}
                hx-trigger="change"
                hx-target="find .fleet-settings__saved"
                hx-swap="innerHTML"
            >
                <label>
                    <input type="checkbox" name="hide_volunteers" checked={fleet.hide_volunteers} />
                    <span>
                        <span class="[ fleet-settings__toggle-label ]">{t('fleets.command.hide_names')}</span>
                        <small>{t('fleets.command.hide_names_hint')}</small>
                    </span>
                </label>
                <span class="[ fleet-settings__saved ]" role="status"></span>
            </form>
        }

        {editable && <small>{t('fleets.command.edit_hint')}</small>}

        <div class="[ fleet-settings__actions ]">
            {editable &&
                <Button href={translatePath(`/fleets/upcoming/edit/${fleet.id}`)} size="sm" color="transparent">
                    {t('edit_fleet')}
                </Button>
            }
            {tracking_active &&
                <form method="post" action={translatePath(`/fleets/upcoming/${fleet.id}/refresh-motd`)}>
                    <Button type="submit" size="sm" color="transparent">{t('refresh_motd')}</Button>
                </form>
            }
            {can_cancel &&
                <Button
                    type="button"
                    size="sm"
                    color="transparent"
                    class="[ fleet-settings__cancel ]"
                    x-on:click={`show_confirm_dialog({
                        title: ${JSON.stringify(cancelled ? t('restore_fleet_dialog_title') : t('cancel_fleet_dialog_title'))},
                        content: ${JSON.stringify(cancelled ? t('restore_fleet_dialog_text') : t('cancel_fleet_dialog_text'))},
                        hx: {
                            method: 'patch',
                            url: ${JSON.stringify(STATE_URL)},
                            target: '#fleet-settings-sink',
                            swap: 'innerHTML'
                        }
                    })`}
                >
                    {cancelled ? t('restore_fleet') : t('cancel_fleet')}
                </Button>
            }
        </div>
        <div id="fleet-settings-sink" hidden></div>
    </section>
</div>

<style lang="scss">
    .fleet-settings {
        display: flex;
        flex-direction: column;
        gap: var(--space-l);
        max-width: var(--max-col-width);
    }

    .fleet-settings__card {
        display: flex;
        flex-direction: column;
        gap: var(--space-s);
        padding: var(--space-m);
        background-color: var(--component-background);
        border: 1px solid var(--border-color);

        h2 {
            font-size: var(--step-1);
        }
    }

    .fleet-settings__toggle {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2xs) var(--space-m);
        align-items: center;
        justify-content: space-between;

        label {
            display: flex;
            gap: var(--space-xs);
            align-items: flex-start;
            cursor: pointer;

            > span {
                display: flex;
                flex-direction: column;
            }
        }

        input {
            width: 1.25rem;
            height: 1.25rem;
            margin-top: 2px;
            accent-color: var(--fleet-red);
        }
    }

    .fleet-settings__toggle-label {
        color: var(--highlight);
    }

    .fleet-settings__actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs);
    }
</style>
