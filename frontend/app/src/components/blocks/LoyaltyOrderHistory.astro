---
import { i18n } from '@helpers/i18n'
import type { LoyaltyCurrency, LoyaltyMarketOrder } from '@dtypes/api.minmatar.org'
import { number_thousand_separator } from '@helpers/numbers'
import { query_string } from '@helpers/string'
import {
    LOYALTY_HISTORY_PAGE_SIZE,
    loyalty_history_partial_params,
    type LoyaltyHistoryFilters,
} from '@helpers/loyalty_order_history'
import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import LoyaltyOrderCard from '@components/blocks/LoyaltyOrderCard.astro'
import LoyaltyOrderList from '@components/blocks/LoyaltyOrderList.astro'
import Select from '@components/blocks/Select.astro'
import Button from '@components/blocks/Button.astro'

const { t, lang, translatePath } = i18n(Astro.url)

interface Props {
    /** Current page of history rows, already sorted by the API. */
    orders: LoyaltyMarketOrder[]
    currencies: LoyaltyCurrency[]
    total: number
    filters: LoyaltyHistoryFilters
}

const { orders, currencies, total, filters } = Astro.props

const SECTION_ID = 'loyalty-order-history'
const TARGET = `#${SECTION_ID}`
const PARTIAL = translatePath('/partials/loyalty_order_history_component')
const FILTER_INPUTS = `${TARGET} select`

const partial_url = (overrides: Partial<LoyaltyHistoryFilters>): string => {
    const qs = query_string(
        loyalty_history_partial_params({ ...filters, ...overrides }),
    )
    return qs ? `${PARTIAL}?${qs}` : PARTIAL
}

const page_size = LOYALTY_HISTORY_PAGE_SIZE
const total_pages = Math.max(1, Math.ceil(total / page_size))
const page = Math.min(filters.page, total_pages)
const range_from = total === 0 ? 0 : (page - 1) * page_size + 1
const range_to = Math.min(total, page * page_size)
const page_status = t('industry.loyalty.history.page_status')
    .replace('{from}', number_thousand_separator(range_from))
    .replace('{to}', number_thousand_separator(range_to))
    .replace('{total}', number_thousand_separator(total))

const sorted_currencies = [...currencies].sort((a, b) => a.name.localeCompare(b.name))
const status_options: { value: LoyaltyHistoryFilters['status'], label: string }[] = [
    { value: 'completed', label: t('industry.loyalty.history.filter.status_completed') },
    { value: 'cancelled', label: t('industry.loyalty.history.filter.status_cancelled') },
    { value: 'all', label: t('industry.loyalty.history.filter.status_all') },
]

const rows = orders
---

<section id={SECTION_ID} class="[ loyalty-history ]">
    <Flexblock gap="var(--space-s)">
        <FlexInline
            justification="space-between"
            class="[ loyalty-history__toolbar w-full ]"
            gap="var(--space-s)"
        >
            <h2>{t('industry.loyalty.history.title')}</h2>
            <FlexInline class="[ loyalty-history__filters ]" gap="var(--space-2xs)">
                    <Select
                        name="loyalty_point_id"
                        size="sm"
                        width="16rem"
                        aria-label={t('industry.loyalty.history.filter.currency')}
                        hx-get={PARTIAL}
                        hx-target={TARGET}
                        hx-swap="outerHTML"
                        hx-trigger="change"
                        hx-include={FILTER_INPUTS}
                    >
                        <option value="" selected={filters.loyalty_point_id == null}>
                            {t('industry.loyalty.history.filter.currency_all')}
                        </option>
                        {sorted_currencies.map((currency) => (
                            <option
                                value={currency.id}
                                selected={filters.loyalty_point_id === currency.id}
                            >
                                {currency.name}
                            </option>
                        ))}
                    </Select>
                    <Select
                        name="status"
                        size="sm"
                        width="16rem"
                        aria-label={t('industry.loyalty.history.filter.status')}
                        hx-get={PARTIAL}
                        hx-target={TARGET}
                        hx-swap="outerHTML"
                        hx-trigger="change"
                        hx-include={FILTER_INPUTS}
                    >
                        {status_options.map((option) => (
                            <option
                                value={option.value}
                                selected={filters.status === option.value}
                            >
                                {option.label}
                            </option>
                        ))}
                    </Select>
            </FlexInline>
        </FlexInline>

        {rows.length === 0 ? (
            <p class="[ loyalty-history__empty ]">{t('industry.loyalty.history.empty')}</p>
        ) : (
            <LoyaltyOrderList variant="history">
                {rows.map((order) => (
                    <LoyaltyOrderCard order={order} variant="history" />
                ))}
            </LoyaltyOrderList>
        )}

        {(total > page_size || filters.page > 1) && (
            <FlexInline
                justification="space-between"
                class="[ loyalty-history__pager w-full ]"
                gap="var(--space-s)"
            >
                <small class="[ loyalty-history__page-status ]">{page_status}</small>
                <FlexInline gap="var(--space-3xs)">
                    <Button
                        size="sm"
                        color="transparent"
                        disabled={page <= 1}
                        hx-get={partial_url({ page: page - 1 })}
                        hx-target={TARGET}
                        hx-swap="outerHTML"
                    >
                        {t('industry.loyalty.history.prev')}
                    </Button>
                    <Button
                        size="sm"
                        color="transparent"
                        disabled={page >= total_pages}
                        hx-get={partial_url({ page: page + 1 })}
                        hx-target={TARGET}
                        hx-swap="outerHTML"
                    >
                        {t('industry.loyalty.history.next')}
                    </Button>
                </FlexInline>
            </FlexInline>
        )}
    </Flexblock>
</section>

<style lang="scss">
    h2 {
        font-size: var(--step-1);
        margin: 0;
    }

    .loyalty-history__empty {
        margin: 0;
        font-size: var(--step--1);
        color: var(--highlight);
    }

    .loyalty-history__toolbar {
        align-items: center;
    }

    .loyalty-history__filters {
        align-items: center;
    }

    .loyalty-history__pager {
        align-items: center;
    }

    .loyalty-history__page-status {
        color: var(--foreground);
        font-variant-numeric: tabular-nums;
    }
</style>
