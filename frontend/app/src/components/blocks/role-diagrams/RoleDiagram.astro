---
/**
 * A teaching diagram in a Fleet Roles guide lesson: inline SVG drawn from the
 * same formulas the game uses, with a caption that says what to take from it.
 * Colours come from tokens through the .rd-* classes below.
 */
import type { RoleDiagramId } from '@/data/fleet-roles'
import FleetSnake from '@components/blocks/role-diagrams/FleetSnake.astro'
import PaintWebTorpedoes from '@components/blocks/role-diagrams/PaintWebTorpedoes.astro'
import BooshLogi from '@components/blocks/role-diagrams/BooshLogi.astro'

interface Props {
    diagram: RoleDiagramId
}

const { diagram } = Astro.props
---

<figure class="[ role-diagram ]">
    {diagram === 'fleet-snake' && <FleetSnake />}
    {diagram === 'paint-web-torpedoes' && <PaintWebTorpedoes />}
    {diagram === 'boosh-logi' && <BooshLogi />}
</figure>

<style lang="scss" is:global>
    .role-diagram {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
        margin: 0;
        padding: var(--space-s);
        border: 1px solid var(--hairline-medium);
        background: var(--surface-sunken);

        svg {
            display: block;
            width: 100%;
            height: auto;
            font-family: var(--default-font);
        }

        // Phones: keep the drawing readable and let it scroll sideways.
        @media (max-width: 48rem) {
            svg {
                min-width: 34rem;
            }
        }

        figcaption {
            max-width: var(--max-text-width);
            font-size: var(--step--1);
            color: var(--text-muted);

            strong {
                color: var(--highlight);
            }
        }

        .rd-text { fill: var(--foreground); }
        .rd-strong { fill: var(--highlight); font-weight: 600; }
        .rd-muted { fill: var(--text-muted); }
        .rd-grid { stroke: var(--hairline-strong); fill: none; }
        .rd-faint { stroke: var(--hairline); fill: none; }
        .rd-track { fill: var(--hairline); }
        .rd-yellow { fill: var(--fleet-yellow); }
        .rd-yellow-stroke { stroke: var(--fleet-yellow); fill: none; }
        .rd-red { fill: var(--fleet-red); }
        .rd-red-stroke { stroke: var(--fleet-red); fill: none; }
        .rd-green { fill: var(--green); }
        .rd-green-stroke { stroke: var(--green); fill: none; }
        .rd-blue { fill: var(--alliance-blue); }
        .rd-blue-stroke { stroke: var(--alliance-blue); fill: none; }
        .rd-zone { fill: color-mix(in srgb, var(--fleet-yellow) 10%, transparent); }
        .rd-zone-red { fill: color-mix(in srgb, var(--fleet-red) 12%, transparent); }
        .rd-zone-green { fill: color-mix(in srgb, var(--green) 12%, transparent); }
    }
</style>
