---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { TrainingOverview } from '@dtypes/api.minmatar.org'
import { TRAINING_MOVE_PARTIAL, training_url } from '@helpers/training'

import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import EmptyState from '@components/blocks/EmptyState.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import TrainingBring from '@components/blocks/TrainingBring.astro'
import TrainingCharacterRow from '@components/blocks/TrainingCharacterRow.astro'

/**
 * The Training tab: doctrines and the roles you can fill in them, then each
 * character with the one ship it trains for.
 */
interface Props {
    overview:           TrainingOverview;
    [propName: string]: any;
}

const {
    overview,
    ...attributes
} = Astro.props

delete attributes.class

const move_picker = (account:number) =>
    `show_modal({ partial: '${translatePath(training_url(TRAINING_MOVE_PARTIAL, { account }))}' })`

const character_count = overview.accounts.reduce((total, account) => total + account.characters.length, 0) + overview.unplaced.length
---

<Flexblock gap="var(--space-l)" class:list={['[ training-overview ]', Astro.props.class]} {...attributes}>
    <section class="[ training-section ]" aria-labelledby="training-bring">
        <h2 id="training-bring">{t('training.bring_title')}</h2>
        <TrainingBring bring={overview.bring} />
    </section>

    <section class="[ training-section ]" aria-labelledby="training-characters">
        <h2 id="training-characters">{t('training.characters_title')}</h2>
        <ComponentBlock padding_block="0" padding_inline="0">
            {character_count === 0 ?
                <EmptyState title={t('training.empty')} hint={t('training.empty_hint')} />
                :
                <div class="[ training-list ]">
                    <div class="[ training-list__head ]" aria-hidden="true">
                        <span>{t('training.col_character')}</span>
                        <span>{t('training.col_training')}</span>
                        <span>{t('training.col_ready')}</span>
                        <span></span>
                    </div>
                    {overview.accounts.map(account =>
                        <div class="[ training-list__account ]">
                            <div class="[ training-list__account-head ]">
                                <h3>{t('training.account').replace('{number}', account.number.toString())}</h3>
                                <button type="button" class="[ training-link ]" x-on:click={move_picker(account.number)}>
                                    {t('training.move_a_character')}
                                </button>
                            </div>
                            {account.characters.map(character =>
                                <TrainingCharacterRow character={character} />
                            )}
                        </div>
                    )}
                    {overview.accounts.length === 0 &&
                        <div class="[ training-list__account ]">
                            {overview.unplaced.map(character =>
                                <TrainingCharacterRow character={character} />
                            )}
                        </div>
                    }
                    {overview.accounts.length > 0 && overview.unplaced.length > 0 &&
                        <div class="[ training-list__account ]" x-data="{ open: false }">
                            <div class="[ training-list__unplaced ]">
                                <h3>
                                    {t('training.not_on_account')} · {t('training.characters_count').replace('{count}', overview.unplaced.length.toString())}
                                </h3>
                                <button
                                    type="button"
                                    class="[ training-link ]"
                                    x-on:click="open = !open"
                                    x-bind:aria-expanded="open.toString()"
                                    x-text={`open ? '${t('training.hide')}' : '${t('training.show')}'`}
                                >
                                    {t('training.show')}
                                </button>
                            </div>
                            <div x-show="open" x-cloak>
                                {overview.unplaced.map(character =>
                                    <TrainingCharacterRow character={character} />
                                )}
                            </div>
                        </div>
                    }
                </div>
            }
        </ComponentBlock>
    </section>
</Flexblock>

<style lang="scss">
    .training-overview {
        --training-columns: minmax(11rem, 15rem) minmax(0, 1fr) 17rem 7rem;
    }

    h2 {
        margin-block-end: var(--space-xs);
        font-family: var(--heading-font);
        font-size: var(--step-1);
        color: var(--fleet-yellow);
    }

    h3 {
        font-family: var(--heading-font);
        font-size: var(--step--1);
        letter-spacing: 0.06em;
        color: var(--text-muted);
    }

    .training-list__head {
        display: grid;
        grid-template-columns: var(--training-columns);
        gap: var(--space-m);
        padding: var(--space-xs) var(--space-s);
        border-bottom: 1px solid var(--hairline);
        font-size: var(--step--2);
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-muted);
    }

    .training-list__account {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        padding: var(--space-xs) var(--space-s);

        & + & {
            border-top: 1px solid var(--hairline);
        }
    }

    .training-list__account-head,
    .training-list__unplaced {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-s);
    }

    .training-link {
        padding: var(--space-3xs);
        background: none;
        border: 0;
        color: var(--fleet-yellow);
        font-size: var(--step--1);
        font-weight: 600;
        text-decoration: underline;
        text-underline-offset: 0.2em;
        cursor: pointer;
    }

    @media (max-width: 48rem) {
        .training-list__head {
            display: none;
        }

    }
</style>
