---
import { i18n } from '@helpers/i18n'

const { t } = i18n(Astro.url)

interface Props {
    is_contract_page?: boolean
    discord_thread_url?: string
}

const {
    is_contract_page = false,
    discord_thread_url = '',
} = Astro.props

const discord_url = (discord_thread_url || '').trim()
const pay_faq = discord_url
    ? t('buyback.faq.2_text').replace('{discord_url}', discord_url)
    : t('buyback.faq.2_text_plain')

import Flexblock from '@components/compositions/Flexblock.astro'
import FixedFluid from '@components/compositions/FixedFluid.astro'
import Markdown from '@components/blocks/Markdown.astro'
import TutorialIcon from '@components/icons/TutorialIcon.astro'
---

<Flexblock gap='var(--space-l)'>
    <FixedFluid width="48" class="[ items-center ]">
        <TutorialIcon />
        <h2>{t('buyback.faq.title')}</h2>
    </FixedFluid>
    <div class="[ prose ]">
        {!is_contract_page &&
            <h4>{t('buyback.faq.1_title')}</h4>
            <Markdown
                markdown={t('buyback.faq.1_text')}
                inline={true}
            />
        }
        {is_contract_page &&
            <h4>{t('buyback.faq.contract_title')}</h4>
            <p>{t('buyback.faq.contract_text')}</p>
        }
        <h4>{t('buyback.faq.2_title')}</h4>
        <Markdown markdown={pay_faq} inline={true} />
        <h4>{t('buyback.faq.3_title')}</h4>
        <p>{t('buyback.faq.3_text')}</p>
    </div>
</Flexblock>

<style lang="scss">
    h4 {
        font-size: 1rem;
    }
</style>
