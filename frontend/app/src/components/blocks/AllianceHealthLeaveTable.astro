---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { AllianceHealthLeavePilot } from '@dtypes/api.minmatar.org'
import type {
    AllianceHealthOrderOption,
    AllianceHealthPilotListRow,
} from '@helpers/alliance_health_pilot_list'
import { health_confidence_label } from '@helpers/alliance_health_pilot_list'

import AllianceHealthPilotList from '@components/blocks/AllianceHealthPilotList.astro'

interface Props {
    pilots: AllianceHealthLeavePilot[]
    initial_corp?: string
    bucket?: string
    [propName: string]: any
}

const { pilots, initial_corp = 'all', bucket = 'current', ...attributes } = Astro.props
delete attributes.class

const order_by_options: AllianceHealthOrderOption[] = [
    { id: 'fleets', label: t('alliance.health.col.fleets'), kind: 'number' },
    { id: 'kills', label: t('alliance.health.col.kills'), kind: 'number' },
    { id: 'voice', label: t('alliance.health.col.voice'), kind: 'number' },
    { id: 'tz', label: t('alliance.health.col.tz'), kind: 'text' },
]

const rows: AllianceHealthPilotListRow[] = pilots.map((pilot) => {
    const conf_label = health_confidence_label(pilot.conf, t)
    return {
    name: pilot.pilot,
    corp: pilot.corp,
    character_id: pilot.character_id,
    corporation_id: pilot.corporation_id,
    search_text: `${pilot.pilot} ${pilot.username} ${pilot.corp} ${pilot.reason} ${pilot.timezone ?? ''} ${conf_label ?? ''}`.toLowerCase(),
    timezone: pilot.timezone,
    note: pilot.reason,
    tags: [pilot.story, conf_label]
        .filter((text): text is string => !!text && text !== '—')
        .map((text) => ({ text })),
    metrics: [
        {
            id: 'fleets',
            label: t('alliance.health.col.fleets'),
            value: String(pilot.fleets),
            sort: pilot.fleets,
        },
        {
            id: 'kills',
            label: t('alliance.health.col.kills'),
            value: String(pilot.kills),
            sort: pilot.kills,
        },
        {
            id: 'voice',
            label: t('alliance.health.col.voice'),
            value: `${pilot.voice_hours}h`,
            sort: pilot.voice_hours,
        },
    ],
    }
})
---

<div class:list={['[ alliance-health-leave ]', Astro.props.class]} {...attributes}>
    <AllianceHealthPilotList
        rows={rows}
        empty_label={t('alliance.health.leave.empty')}
        order_by_options={order_by_options}
        default_order_by="fleets"
        initial_corp={initial_corp}
        csv_filename={`health-leave-${bucket}.csv`}
        url_section="leave"
    />
</div>
