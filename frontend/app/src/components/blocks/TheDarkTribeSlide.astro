---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { CorporationObject } from '@dtypes/layout_components'

import { query_string } from '@helpers/string';

interface Props {
    corporation:            CorporationObject;
    is_user_corporation?:   boolean;
    picture_placement?:     'left' | 'right';
    
}

const {
    corporation,
    is_user_corporation = false,
    picture_placement = 'left',
} = Astro.props

const MULA_SOLDATS_ID = 2122950343
const DIGITAL_BLINK_ID = 2121171605

import { marked } from 'marked';
import { renderer } from '@helpers/marked';

import Flexblock from '@components/compositions/Flexblock.astro';

import CorporationSlide from '@components/blocks/CorporationSlide.astro';
import StylessButton from '@components/blocks/StylessButton.astro';
---

<CorporationSlide
    id="darktribe-slide"
    ceo_image='/images/corporations/darktribe/ceo.webp'
    ceo_character_id={DIGITAL_BLINK_ID}
    corporation={corporation}
    is_user_corporation={is_user_corporation}
    picture_placement='left'
    mirror_slide={picture_placement === 'right'}
>
    <StylessButton
        class="[ co-ceo ]"
        slot="coceo"
        x-data={`{
            show_character_modal() {
                show_modal({
                    partial: '${translatePath('/partials/character_modal_component/')}?${query_string({
                        character_id: MULA_SOLDATS_ID.toString(),
                    })}',
                })
            }
        }`}
        x-on:click="show_character_modal()"
    >
        <img src="/images/corporations/darktribe/co-ceo.webp" />
    </StylessButton>
    
    <img slot="ships" class="[ vargur ]" src="/images/corporations/darktribe/vargur.webp" />
    <img slot="ships" class="[ hurricane_2 ]" src="/images/corporations/darktribe/hurricane.webp" />
    <img slot="ships" class="[ vindicator ]" src="/images/corporations/darktribe/vindicator.webp" />

    <Flexblock set:html={marked.parse(corporation.introduction ? corporation.introduction : t('darktribe_description_fallback'), { renderer })} />
</CorporationSlide>

<style lang="scss">
    .co-ceo {
        z-index: 11;
        position: absolute;
        cursor: pointer;
        transform: scale(0.5);
        opacity: 0;
        height: 99%;
        left: 3%;
        top: 0;
        filter: drop-shadow(0px 0px 0 black) drop-shadow(0px 0px 0 black) drop-shadow(0px 0px 0 black);

        img {
            mask-image: linear-gradient(to bottom, black 70%, transparent 95%);
            width: auto;
            height: 100%;
        }

        &:focus-visible {
            outline: none;
        }

        &:focus-visible,
        &:hover {
            img {
                filter: drop-shadow(0px 0px 3px rgba(255, 255, 255, 0.75));
            }
        }
    }

    .vargur {
        position: absolute;
        top: 14%;
        left: -39%;
        height: auto;
        width: 64%;
        z-index: 0;
        transform: scale(0);
    }

    .hurricane_2 {
        position: absolute;
        top: 41%;
        left: -20%;
        width: 74%;
        height: auto;
        z-index: 2;
        transform: scale(0);
    }

    .vindicator {
        position: absolute;
        top: 39%;
        left: -12%;
        width: 57%;
        height: auto;
        z-index: 2;
        transform: scale(0);
    }

    @keyframes vargur {
        0% {
            transform: scale(0);
            top: 13%;
            left: -34%;
        }

        30% {
            transform: scale(1);
            top: 1%;
            left: 34%;
        }

        100% {
            transform: scale(1.03);
            top: -2%;
            left: 38%;
        }
    }

    @keyframes hurricane_2 {
        0% {
            transform: scale(0);
            top: 30%;
            left: -10%;
        }

        33% {
            transform: scale(1);
            top: 23%;
            left: 26%;
        }

        100% {
            transform: scale(1.05);
            top: 23%;
            left: 32%;
        }
    }

    @keyframes vindicator {
        0% {
            transform: scale(0);
            left: -12%;
            top: 7%;
        }

        36% {
            transform: scale(1);
            top: 33%;
            left: 36%;
        }

        100% {
            transform: scale(1.03);
            top: 36%;
            left: 43%;
        }
    }

    @keyframes coceo {
        0% {
            transform: scale(0.9);
            opacity: 0;
        }

        20% {
            opacity: 1;
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>

<style lang="scss" is:global>
    #darktribe-slide .ceo {
        left: -10%;
    }

    .swiper-slide-active {
        .vargur {
            animation: vargur cubic-bezier(0.390, 0.575, 0.565, 1.000) both 2.7s;
            animation-delay: 1.2s;
            animation-iteration-count: 1;
            transform-origin: center;
            animation-fill-mode: forwards;
        }
        
        .hurricane_2 {
            animation: hurricane_2 cubic-bezier(0.390, 0.575, 0.565, 1.000) both 2.6s;
            animation-delay: 1.3s;
            animation-iteration-count: 1;
            transform-origin: center;
            animation-fill-mode: forwards;
        }
        
        .vindicator {
            animation: vindicator cubic-bezier(0.390, 0.575, 0.565, 1.000) both 2.5s;
            animation-delay: 1.4s;
            animation-iteration-count: 1;
            transform-origin: center;
            animation-fill-mode: forwards;
        }

        #darktribe-slide .co-ceo {
            animation: coceo ease-out 3.2s;
            animation-delay: 0.25s;
            animation-iteration-count: 1;
            transform-origin: bottom;
            animation-fill-mode: forwards;
        }
    }
</style>