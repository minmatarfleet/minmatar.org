---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { Contract } from '@dtypes/api.minmatar.org'
import type { FleetItem, DoctrineType, HeroFittings } from '@dtypes/layout_components'

interface Props {
    fleet:                  FleetItem;
    doctrine?:              DoctrineType | null;
    init_tooltips:          boolean;
    supply_contracts?:      Contract[];
    /** Render the scrolling fittings/contracts strip under the hero. */
    show_fittings?:         boolean;
}

const {
    fleet,
    doctrine,
    init_tooltips,
    supply_contracts = [],
    show_fittings = true,
} = Astro.props

const [ system, station ] = fleet?.location?.split(' - ') ?? []

let hero_fittings:HeroFittings[] = [
    ...doctrine?.primary_fittings ?? [],
    ...doctrine?.support_fittings ?? [],
    ...doctrine?.secondary_fittings ?? []
]

hero_fittings = hero_fittings.map(fitting => {
    return {
        ...fitting,
        contracts_count: supply_contracts.find(contract => contract.fitting_id === fitting.id)?.current_quantity ?? 0
    }
})

const supply_contracts_copy = hero_fittings.map(fitting => `${fitting.fitting_name}: ${fitting.contracts_count} on contracts`).join('\n')

import Flexblock from '@components/compositions/Flexblock.astro';
import Wrapper from '@components/compositions/Wrapper.astro';
import FlexInline from '@components/compositions/FlexInline.astro';
import FixedFluid from '@components/compositions/FixedFluid.astro';

import StylessButton from '@components/blocks/StylessButton.astro';
import VerticalCenter from '@components/blocks/VerticalCenter.astro';
import CharacterPicture from '@components/blocks/CharacterPicture.astro';
import CorporationBadge from '@components/blocks/CorporationBadge.astro';
import Markdown from '@components/blocks/Markdown.astro';
import Marquee from '@components/blocks/Marquee.astro';
import Square from '@components/blocks/Square.astro';

import FleetIcon from '@components/icons/FleetIcon.astro';
import MemberIcon from '@components/icons/MemberIcon.astro';
import ItemBadge from './ItemBadge.astro';
import ClipboardButton from './ClipboardButton.astro';
import FlexInlineSiblings from '@components/compositions/FlexInlineSiblings.astro';
---

<FixedFluid
    width='50rem'
    gap='var(--space-xl)'
    breakpoint='34%'
>
    <VerticalCenter class="[ content-section ][ max-w-[50rem] ]">
        <Wrapper
            max_width='100%'
            padding_inline='0'
            padding_block='0'
            class="[ w-full ]"
        >
            <Flexblock gap='var(--space-l)'>
                <FixedFluid width='256px' gap='var(--space-xl)' class="[ items-center! ]">
                    <div class="[ animate-slide-up-fade animate-delay-100 ]">
                        <CharacterPicture
                            character_id={fleet.fleet_commander_id}
                            character_name={fleet.fleet_commander_name}
                            size={256}
                            icon_quality={512}
                        />
                    </div>
                    <Flexblock gap='var(--space-xs)'>
                        <h2 class="[ animate-slide-up-fade animate-delay-250 ]">{fleet.fleet_commander_name}</h2>
                        <FlexInline class="[ animate-fade-in animate-duration-250 animate-delay-400 ]">
                            <CorporationBadge
                                corporation={{
                                    id: fleet.corporation_id as number,
                                    name: fleet.corporation_name as string,
                                    size: 'sm',
                                }}
                                show_modal={true}
                            />
                            {fleet.fleet_commander_fleet_count &&
                                <FlexInline gap='var(--space-3xs)' class="[ items-center! ]">
                                    <div
                                        class="[ text-highlight h-[16px] ]"
                                        data-tippy-content={t('fleet_commander_fleets')}
                                        x-init={init_tooltips ? 'tippy($el, tippy_options)' : undefined}
                                    >
                                        <FleetIcon size={16} />
                                    </div>
                                    <span>{fleet.fleet_commander_fleet_count}</span>
                                </FlexInline>
                            }
                        </FlexInline>

                        <div class="[ fleet-facts animate-fade-in animate-duration-250 animate-delay-550 ]">
                            <div class="[ fleet-facts__row ]">
                                <div class="[ fleet-fact ]">
                                    <small class="[ fleet-fact__label ]">{t('staging')}</small>
                                    <b class="[ fleet-fact__value text-highlight ]">{system}</b>
                                    {station && <small class="[ fleet-fact__hint ]">{station}</small>}
                                </div>

                                {doctrine &&
                                    <div class="[ fleet-fact ]">
                                        <small class="[ fleet-fact__label ]">{t('doctrine')}</small>
                                        <StylessButton href={translatePath(`/ships/doctrines/${doctrine.id}`)}>
                                            <ItemBadge
                                                type_id={doctrine.primary_fittings[0].ship_id}
                                                item_name={doctrine.name}
                                                size={32}
                                            />
                                        </StylessButton>
                                    </div>
                                }
                            </div>

                            <div class="[ fleet-facts__row ]">
                                <slot />
                            </div>
                        </div>
                    </Flexblock>
                </FixedFluid>

                <Flexblock gap='var(--space-xs)'>
                    {fleet.objective !== undefined &&
                        <h4 class="[ animate-fade-in animate-duration-250 animate-delay-550 ]">
                            {fleet.objective as string}
                        </h4>
                    }

                    {fleet.description &&
                        <div class="[ component wrap-break-word max-w-full pr-1.5 max-h-[130px] overflow-y-auto animate-fade-in animate-duration-250 animate-delay-550 ]">
                            <Markdown markdown={fleet.description as string} />
                        </div>
                    }
                </Flexblock>
            </Flexblock>
        </Wrapper>
    </VerticalCenter>
    {doctrine && show_fittings &&
        <div
            class="[ !flex !items-end hidden! animate-slide-up-fade animate-delay-1000 ]"
            x-on:marquee-started="$el.classList.remove('hidden!')"
        >
            <FlexInlineSiblings
                class="[ w-full ]"
                min-shink-width='250px'
                shrinkable-sibbling='first'
            >
                <Marquee separator_width='200px'>
                    {hero_fittings.map((fitting) => (
                        <StylessButton href={translatePath(`/ships/fittings/${fitting.id}/`)}>
                            <ItemBadge
                                type_id={fitting.ship_id}
                                item_name={fitting.fitting_name}
                                size={32}
                            >
                                {supply_contracts.length > 0 ?
                                    <FlexInline gap='var(--space-3xs)'>
                                        <Square color={!fitting.contracts_count ? 'fleet-red' : 'green'} />
                                        <small class="[ text-foreground ]">
                                            {t('in_contracts_template').replace('{count}', (fitting.contracts_count ?? 0).toString())}
                                        </small>
                                    </FlexInline> :
                                    <small class="[ text-foreground ]">{t('primary_fitting')}</small>
                                }
                            </ItemBadge>
                        </StylessButton>
                    ))}
                </Marquee>
                {supply_contracts.length > 0 &&
                    <ClipboardButton id="supply-contracts">{supply_contracts_copy}</ClipboardButton>
                }
            </FlexInlineSiblings>
        </div>
    }
</FixedFluid>

<style lang="scss">
    h2 {
        font-size: var(--step-5);
    }

    // Under the FC name: staging (and doctrine) on one row, EVE and local
    // time side by side on the next. The column beside the portrait is too
    // narrow for all of them on one line.
    .fleet-facts {
        display: flex;
        flex-direction: column;
        gap: var(--space-s);
        padding-top: var(--space-2xs);
    }

    .fleet-facts__row {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-s) var(--space-l);
        align-items: flex-start;
    }

    .fleet-fact,
    .fleet-facts__row > :global(*) {
        flex: 0 0 auto;
        display: flex;
        flex-direction: column;
        gap: 2px;
        max-width: 100%;
    }

    .fleet-fact__hint {
        max-width: 200px;
    }

    // Same treatment as TextGroup elsewhere on the site: Montserrat,
    // regular weight, sentence case. Only the size steps down.
    .fleet-fact__label,
    .fleet-facts :global(h4) {
        font-size: var(--step--1);
        font-weight: 400;
        color: var(--foreground);
        margin: 0;
    }

    .fleet-fact__value,
    .fleet-facts :global(p) {
        font-size: var(--step-0);
        font-weight: 400;
        margin: 0;
        white-space: nowrap;
    }

    .fleet-fact__hint {
        color: var(--fleet-yellow);
    }

    h4 {
        font-size: var(--step-0);
    }
</style>