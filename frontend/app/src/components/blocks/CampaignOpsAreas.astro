---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { CampaignArea } from '@dtypes/api.minmatar.org'

interface Props {
    areas:              CampaignArea[];
    [propName: string]: any;
}

const {
    areas,
    ...attributes
} = Astro.props

delete attributes.class

const scope_label = (scope:string) =>
    scope === 'region'
        ? t('campaigns.theater.scope_region')
        : t('campaigns.theater.scope_constellation')
---

{areas.length > 0 &&
    <div class:list={['[ campaign-ops-areas ]', Astro.props.class]} {...attributes}>
        <h4>{t('campaigns.theater.areas_title')}</h4>
        <small>{t('campaigns.theater.areas_hint')}</small>
        <ul class="[ campaign-ops-areas-list ]">
            {areas.map(area =>
                <li>
                    <span class="[ campaign-ops-area-name ]">{area.name}</span>
                    <small>{scope_label(area.scope)}</small>
                </li>
            )}
        </ul>
    </div>
}

<style lang="scss">
    .campaign-ops-areas {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
    }

    .campaign-ops-areas-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
    }

    .campaign-ops-areas-list li {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--space-s);
        padding-block: var(--space-2xs);
        border-top: solid 1px var(--border-color);
    }

    .campaign-ops-area-name {
        color: var(--highlight);
    }
</style>
