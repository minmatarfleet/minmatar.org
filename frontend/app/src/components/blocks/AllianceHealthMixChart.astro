---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { AllianceHealthSignals30 } from '@dtypes/api.minmatar.org'

interface Props {
    signals: AllianceHealthSignals30
    [propName: string]: any
}

const { signals, ...attributes } = Astro.props
delete attributes.class

const chart_id = 'alliance-health-mix-chart'
const labels = [
    t('alliance.health.mix.fleets'),
    t('alliance.health.mix.small_gang'),
    t('alliance.health.mix.solo'),
    t('alliance.health.mix.supply'),
]
const data = [signals.fleets, signals.small_gang, signals.solo, signals.supply]
---

<section
    class:list={['[ alliance-health-mix ]', Astro.props.class]}
    aria-label={t('alliance.health.mix.aria')}
    x-data={`{
        init() {
            const root = getComputedStyle(document.documentElement)
            const blue = root.getPropertyValue('--alliance-blue').trim() || '#2051B5'
            const fg = root.getPropertyValue('--foreground').trim() || '#ccc'
            const canvas = document.getElementById('${chart_id}')
            if (!canvas || typeof Chart === 'undefined') return
            Chart.defaults.color = fg
            Chart.defaults.borderColor = 'rgb(255, 255, 255, 0.08)'
            new Chart(canvas.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: ${JSON.stringify(labels)},
                    datasets: [{
                        label: ${JSON.stringify(t('alliance.health.mix.people'))},
                        data: ${JSON.stringify(data)},
                        backgroundColor: blue,
                    }],
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: { x: { beginAtZero: true } },
                    plugins: { legend: { display: false } },
                },
            })
        }
    }`}
>
    <div class="[ alliance-health-mix__frame ]">
        <canvas id={chart_id}></canvas>
    </div>
</section>

<style lang="scss">
    .alliance-health-mix__frame {
        position: relative;
        height: min(28rem, 70vh);
        width: 100%;
    }
</style>
