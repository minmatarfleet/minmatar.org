---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { CorporationObject } from '@dtypes/layout_components'

interface Props {
    corporation:            CorporationObject;
    is_user_corporation?:   boolean;
    picture_placement?:     'left' | 'right';
    
}

const {
    corporation,
    is_user_corporation = false,
    picture_placement = 'left',
} = Astro.props

const XAVI_ESTEMAIRE_ID = 95063349

import CorporationSlide from '@components/blocks/CorporationSlide.astro';
---

<CorporationSlide
    id="solaris-slide"
    ceo_image='/images/corporations/solaris/ceo.webp'
    ceo_character_id={XAVI_ESTEMAIRE_ID}
    corporation={corporation}
    is_user_corporation={is_user_corporation}
    picture_placement='left'
    mirror_slide={picture_placement === 'right'}
>
    <img slot="ships" class="[ brutix ]" src="/images/corporations/solaris/brutix.webp" />
    <img slot="ships" class="[ typhoon ]" src="/images/corporations/solaris/typhoon.webp" />
    <img slot="ships" class="[ jackdaw ]" src="/images/corporations/solaris/jackdaw.webp" />

    <p>{corporation.introduction ? corporation.introduction : t('solaris_description_fallback') }</p>
</CorporationSlide>

<style lang="scss">
    .brutix {
        position: absolute;
        top: 40%;
        left: 5%;
        height: auto;
        width: 80%;
        z-index: 2;
        transform: scale(0);
    }

    .typhoon {
        position: absolute;
        top: 48%;
        left: -40%;
        width: 73%;
        height: auto;
        z-index: 1;
        transform: scale(0);
    }

    .jackdaw {
        position: absolute;
        left: -25%;
        top: 34%;
        width: 62%;
        height: auto;
        z-index: 2;
        transform: scale(0);
    }

    @keyframes brutix {
        0% {
            transform: scale(0);
            top: 20%;
            left: -15%;
        }

        30% {
            transform: scale(1);
            top: 14%;
            left: 28%;
        }

        100% {
            transform: scale(1.04);
            top: 14%;
            left: 31%;
        }
    }

    @keyframes typhoon {
        0% {
            transform: scale(0);
            top: 21%;
            left: -15%;
        }

        33% {
            transform: scale(1);
            top: 2%;
            left: 27%;
        }

        100% {
            transform: scale(1.03);
            top: 0%;
            left: 30%;
        }
    }

    @keyframes jackdaw {
        0% {
            transform: scale(0);
            left: -15%;
            top: 10%;
        }

        33% {
            transform: scale(1);
            top: 46%;
            left: 40%;
        }

        100% {
            transform: scale(1.03);
            top: 43%;
            left: 43%;
        }
    }
</style>

<style lang="scss" is:global>
    #solaris-slide .ceo {
        left: -10%;
    }

    .swiper-slide-active {
        .brutix {
            animation: brutix cubic-bezier(0.390, 0.575, 0.565, 1.000) both 2.7s;
            animation-delay: 1.3s;
            animation-iteration-count: 1;
            transform-origin: center;
            animation-fill-mode: forwards;
        }
        
        .typhoon {
            animation: typhoon cubic-bezier(0.390, 0.575, 0.565, 1.000) both 2.6s;
            animation-delay: 1.4s;
            animation-iteration-count: 1;
            transform-origin: center;
            animation-fill-mode: forwards;
        }
        
        .jackdaw {
            animation: jackdaw cubic-bezier(0.390, 0.575, 0.565, 1.000) both 2.5s;
            animation-delay: 1.6s;
            animation-iteration-count: 1;
            transform-origin: center;
            animation-fill-mode: forwards;
        }
    }
</style>