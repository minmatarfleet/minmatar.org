---
import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

/**
 * Opens a page in the page's ContentViewer. Wrap any card or link in it: it
 * renders a real link to the full page (`href`), so a new tab, a ctrl/cmd/middle
 * click or no JavaScript still lands on the page, and a plain click opens the
 * viewer and loads the content with htmx.
 *
 * Any `href` the viewer can show opens in it: a post, a guide, a Warzone or
 * Amamake Market report, a newsletter, Our values or a chapter of Our story
 * (the list is `@helpers/content_viewer_sources`). Anything else is a plain
 * link. `post` (a post id) and `guide` (a guide slug) name the content directly.
 */
import { ui } from '@i18n/ui'
import { resolve_viewer_path, viewer_query } from '@helpers/content_viewer_sources'
import type { ViewerTarget } from '@helpers/content_viewer_sources'

interface Props {
    href:               string;
    post?:              number;
    guide?:             string;
    /** Shown in the viewer's header while the content loads. */
    title?:             string;
    [propName: string]: any;
}

const { href, post, guide, title = '', ...attributes } = Astro.props

delete attributes.class

const target: ViewerTarget | null = post !== undefined
    ? { source: 'post', id: String(post) }
    : guide
        ? { source: 'guide', id: guide }
        : resolve_viewer_path(href, Object.keys(ui))
const partial = target ? `${translatePath('/partials/content_viewer_component/')}?${viewer_query(target)}` : ''

// A plain click opens the viewer; with a modifier key (new tab, new window)
// or a middle click (auxclick, never click) the link does what links do.
// htmx listens for its own event rather than click: on a click trigger it
// cancels the link before checking any filter, which ate ctrl-clicks.
const PLAIN = '!$event.ctrlKey && !$event.metaKey && !$event.shiftKey && !$event.altKey'
const open = `if (${PLAIN}) { $event.preventDefault(); $dispatch('content-viewer-open', ${JSON.stringify({ title, href })}); htmx.trigger($el, 'content-viewer-load') }`
---

{partial ?
    <a
        href={href}
        class:list={['[ content-viewer-link ]', Astro.props.class]}
        hx-get={partial}
        hx-target="#content-viewer-body"
        hx-swap="innerHTML"
        hx-trigger="content-viewer-load"
        hx-indicator="#content-viewer-body"
        x-data
        x-on:click={open}
        {...attributes}
    >
        <slot />
    </a>
:
    <a href={href} class:list={['[ content-viewer-link ]', Astro.props.class]} {...attributes}>
        <slot />
    </a>
}
