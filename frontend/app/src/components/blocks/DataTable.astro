---
import EmptyState from '@components/blocks/EmptyState.astro'
import StylessButton from '@components/blocks/StylessButton.astro'
import XFadeScroll from '@components/compositions/XFadeScroll.astro'

interface DataTableColumn {
    key: string
    label: string
    numeric?: boolean
    sortable?: boolean
    /** A token (`var(--space-3xl)`) or a percentage. */
    width?: string
    /** Hide the label visually; it stays the column's accessible name (action columns). */
    hidden_label?: boolean
}

/**
 * Semantic tabular data: a real `<table>` in an edge-fading scroller. The
 * caller writes the `<tr><td>` rows in the default slot; cells use
 * `data-table__numeric` (right-aligned, tabular figures) and
 * `data-table__actions` (right-aligned, shrink-wrapped).
 *
 * Sortable columns sort the rows already on the page (Alpine, by the cell's
 * `data-sort-<key>` attribute, else its text). Server-side paging and
 * sorting stay htmx (HtmxPager / hx-get); this component never fetches.
 */
interface Props {
    columns: DataTableColumn[]
    /** Visually hidden `<caption>`; also names the scroll region. */
    caption?: string
    density?: 'default' | 'dense'
    /** `rows` (default) boxes every cell; `grid` joins the lines; `none` has no lines. */
    borders?: 'rows' | 'grid' | 'none'
    striped?: boolean
    /** Header stays in view while the body scrolls (the table scrolls inside a capped height). */
    sticky_header?: boolean
    /** Shown in one full-width row when `is_empty` is set. */
    empty_title?: string
    is_empty?: boolean
    [propName: string]: any
}

const {
    columns,
    caption,
    density = 'default',
    borders = 'rows',
    striped = false,
    sticky_header = false,
    empty_title,
    is_empty = false,
    ...attributes
} = Astro.props

delete attributes.class

const sortable = columns.some((column) => column.sortable)
const show_empty = is_empty && Boolean(empty_title)

// Alpine over the already-rendered rows; the server owns the data.
const sort_state = `{
    column: null,
    direction: 'none',
    init() {
        this.rows().forEach((row, index) => { row.dataset.dataTableOrder = index })
    },
    rows() {
        return Array.from(this.$refs.body.children).filter((row) => !row.hasAttribute('data-table-static'))
    },
    value(row, index, key, numeric) {
        const cell = row.children[index]
        if (!cell) return ''
        const raw = cell.getAttribute('data-sort-' + key) ?? cell.textContent.trim()
        return numeric ? parseFloat(raw.replace(/[^0-9.\\-]/g, '')) : raw
    },
    sort(index, key, numeric) {
        if (this.column !== key) { this.column = key; this.direction = 'asc' }
        else if (this.direction === 'asc') this.direction = 'desc'
        else { this.column = null; this.direction = 'none' }
        const factor = this.direction === 'desc' ? -1 : 1
        const body = this.$refs.body
        const sorted = this.rows().sort((a, b) => {
            if (this.column === null) return a.dataset.dataTableOrder - b.dataset.dataTableOrder
            const left = this.value(a, index, key, numeric)
            const right = this.value(b, index, key, numeric)
            if (numeric) {
                const delta = (Number.isNaN(left) ? -Infinity : left) - (Number.isNaN(right) ? -Infinity : right)
                return (Number.isNaN(delta) ? 0 : delta) * factor
            }
            return String(left).localeCompare(String(right), undefined, { numeric: true, sensitivity: 'base' }) * factor
        })
        sorted.forEach((row) => body.appendChild(row))
    },
    aria(key) {
        return this.column === key ? (this.direction === 'asc' ? 'ascending' : 'descending') : 'none'
    },
}`
---

<XFadeScroll
    class:list={['[ data-table-wrap ]', { 'data-table-wrap--sticky': sticky_header }]}
    tabindex="0"
    role="region"
    aria-label={caption}
>
    <table
        {...attributes}
        class:list={[
            '[ data-table ]',
            `data-table--${density}`,
            `data-table--${borders}`,
            { 'data-table--striped': striped },
            Astro.props.class,
        ]}
        x-data={sortable ? sort_state : undefined}
    >
        {caption && <caption class="[ visually-hidden ]">{caption}</caption>}
        <thead>
            <tr>
                {columns.map((column, index) => {
                    const label = column.hidden_label
                        ? <span class="[ visually-hidden ]">{column.label}</span>
                        : column.label
                    return (
                        <th
                            scope="col"
                            class:list={[{ 'data-table__numeric': column.numeric }]}
                            style={column.width ? `width: ${column.width}` : undefined}
                            aria-sort={column.sortable ? 'none' : undefined}
                            x-bind:aria-sort={column.sortable ? `aria(${JSON.stringify(column.key)})` : undefined}
                        >
                            {column.sortable ?
                                <StylessButton
                                    type="button"
                                    class="[ data-table__sort ]"
                                    x-on:click={`sort(${index}, ${JSON.stringify(column.key)}, ${Boolean(column.numeric)})`}
                                >{label}</StylessButton>
                                : label
                            }
                        </th>
                    )
                })}
            </tr>
        </thead>
        <tbody x-ref={sortable ? 'body' : undefined}>
            {show_empty ?
                <tr data-table-static>
                    <td colspan={columns.length}><EmptyState title={empty_title} /></td>
                </tr>
                :
                <slot />
            }
        </tbody>
    </table>
</XFadeScroll>

<style lang="scss">
    :global(.data-table-wrap) {
        min-width: 0;
    }

    // The scroller is capped so the header has something to stick against.
    :global(.data-table-wrap--sticky) {
        max-height: var(--data-table-max-height, 70vh);
        overflow-y: auto;
    }

    .data-table {
        width: 100%;
        border-spacing: var(--space-3xs);
        font-size: var(--step--1);

        :global(th),
        :global(td) {
            padding: var(--space-s);
            border: 1px solid color-mix(in srgb, var(--border-color) 80%, transparent);
            text-align: left;
            vertical-align: top;
        }

        :global(th) {
            background: color-mix(in srgb, var(--component-background) 90%, transparent);
            font-weight: 600;
            color: var(--highlight);
            background-color: var(--light-transparency-background-mobile);

            @media screen and (min-width: 980px) {
                background-color: var(--light-transparency-background);
                backdrop-filter: blur(var(--transparency-backdrop-blur-heavier));
            }
        }

        :global(td) {
            color: var(--foreground);
            background-color: var(--light-transparency-background);
            backdrop-filter: blur(var(--transparency-backdrop-blur));
        }

        :global(.data-table__numeric) {
            text-align: right;
            font-variant-numeric: tabular-nums;
        }

        :global(.data-table__actions) {
            text-align: right;
            white-space: nowrap;
            width: 1%;
        }
    }

    .data-table--dense {
        :global(th),
        :global(td) {
            padding: var(--space-3xs) var(--space-2xs);
        }
    }

    .data-table--grid {
        border-spacing: 0;
        border-collapse: collapse;
    }

    .data-table--none {
        :global(th),
        :global(td) {
            border-color: transparent;
        }
    }

    .data-table--striped :global(tbody tr:nth-child(even) td) {
        background-color: color-mix(in srgb, var(--highlight) 4%, var(--light-transparency-background));
    }

    :global(.data-table-wrap--sticky) .data-table :global(thead th) {
        position: sticky;
        top: 0;
        z-index: 1;
        background-color: var(--component-background);
    }

    .data-table :global(.data-table__sort) {
        appearance: none;
        font: inherit;
        display: inline-flex;
        align-items: center;
        gap: var(--space-3xs);

        &:focus-visible {
            outline: solid 2px var(--fleet-yellow);
            outline-offset: 2px;
        }

        &::after {
            content: '';
            font-size: var(--step--2);
            opacity: 0.5;
        }
    }

    th[aria-sort='ascending'] :global(.data-table__sort)::after {
        content: '▲';
        opacity: 1;
    }

    th[aria-sort='descending'] :global(.data-table__sort)::after {
        content: '▼';
        opacity: 1;
    }
</style>
