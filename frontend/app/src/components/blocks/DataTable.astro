---
import EmptyState from '@components/blocks/EmptyState.astro'
import StylessButton from '@components/blocks/StylessButton.astro'
import XFadeScroll from '@components/compositions/XFadeScroll.astro'

interface DataTableColumn {
    key: string
    label: string
    numeric?: boolean
    sortable?: boolean
    /** A token (`var(--space-3xl)`) or a percentage. */
    width?: string
    /** Hide the label visually; it stays the column's accessible name (action columns). */
    hidden_label?: boolean
    /** Hide the whole column below this width (`48rem`): header and cells (cells need no class). */
    hide_below?: string
    /** Extra class on the header cell (a `bar` column gets `data-table__bar`). */
    class?: string
    /** Trusted markup for the label (an inline icon next to the text); `label` is then its plain-text name. */
    label_html?: string
    /** `center` centres the header; cells take `data-table__center`. */
    align?: 'center'
    /** Tooltip on the header cell. */
    title?: string
}

/**
 * Semantic tabular data: a real `<table>` in an edge-fading scroller. The
 * caller writes the `<tr><td>` rows in the default slot; cells use
 * `data-table__numeric` (right-aligned, tabular figures) and
 * `data-table__actions` (right-aligned, shrink-wrapped).
 *
 * Row headers: a row may start with `<th scope="row">`; it is styled like a
 * first cell. `bodies` is for callers that write their own `<tbody>` elements
 * (several row groups): the slot is then not wrapped in a tbody (no sorting,
 * no empty row). The `footer` slot becomes a `<tfoot>`.
 *
 * `variant="report"` is the editorial report look (collapsed hairline rows,
 * small uppercase muted headers, hover wash; the rule colour comes from
 * `--data-table-rule`). Bar cells take `data-table__bar` and a `--bar` custom
 * property for the fill width. `variant="cards"` turns rows into stacked
 * cards below 48rem: cells carry `data-label`, the header hides, and
 * `data-table__card-title` spans the card.
 *
 * `visually_hidden` renders the table for screen readers only (chart data
 * tables); `caption_visible` shows the caption.
 *
 * Sortable columns sort the rows already on the page (Alpine, by the cell's
 * `data-sort-<key>` attribute, else its text). Server-side paging and
 * sorting stay htmx (HtmxPager / hx-get); this component never fetches.
 */
interface Props {
    columns: DataTableColumn[]
    /** Visually hidden `<caption>`; also names the scroll region. */
    caption?: string
    density?: 'default' | 'dense'
    /** `rows` (default) boxes every cell; `grid` joins the lines; `none` has no lines. */
    borders?: 'rows' | 'grid' | 'none'
    striped?: boolean
    /** Header stays in view while the body scrolls (the table scrolls inside a capped height). */
    sticky_header?: boolean
    /** Shown in one full-width row when `is_empty` is set. */
    empty_title?: string
    is_empty?: boolean
    /** `report`: editorial report look; `cards`: stacked cards below 48rem. */
    variant?: 'default' | 'report' | 'cards'
    /** Cards below 48rem on top of any variant (`variant="cards"` is the plain look plus this). */
    cards?: boolean
    /** The caller writes its own `<tbody>` elements; the slot is not wrapped. */
    bodies?: boolean
    /** Show the caption instead of hiding it visually. */
    caption_visible?: boolean
    /** Screen-reader-only table (no scroller, nothing painted). */
    visually_hidden?: boolean
    [propName: string]: any
}

const {
    columns,
    caption,
    density = 'default',
    borders = 'rows',
    striped = false,
    sticky_header = false,
    empty_title,
    is_empty = false,
    variant = 'default',
    bodies = false,
    cards = false,
    caption_visible = false,
    visually_hidden = false,
    ...attributes
} = Astro.props

delete attributes.class

const sortable = columns.some((column) => column.sortable)
const show_empty = is_empty && Boolean(empty_title) && !bodies
const has_footer = Astro.slots.has('footer')
const hide_id = `data-table-h${[...JSON.stringify(columns)].reduce((hash, ch) => (hash * 31 + ch.charCodeAt(0)) >>> 0, 7)}`
const hide_below = [...new Set(columns.map((column) => column.hide_below).filter(Boolean))]
const hide_css = hide_below
    .map((width) => {
        const indexes = columns.map((column, index) => (column.hide_below === width ? index + 1 : 0)).filter(Boolean)
        const selectors = indexes
            .flatMap((n) => [`.${hide_id} :is(th, td):nth-child(${n})`])
            .join(', ')
        return `@media (max-width: ${width}) { ${selectors} { display: none; } }`
    })
    .join('\n')

// Alpine over the already-rendered rows; the server owns the data.
const sort_state = `{
    column: null,
    direction: 'none',
    init() {
        this.rows().forEach((row, index) => { row.dataset.dataTableOrder = index })
    },
    rows() {
        return Array.from(this.$refs.body.children).filter((row) => !row.hasAttribute('data-table-static'))
    },
    value(row, index, key, numeric) {
        const cell = row.children[index]
        if (!cell) return ''
        const raw = cell.getAttribute('data-sort-' + key) ?? cell.textContent.trim()
        return numeric ? parseFloat(raw.replace(/[^0-9.\\-]/g, '')) : raw
    },
    sort(index, key, numeric) {
        if (this.column !== key) { this.column = key; this.direction = 'asc' }
        else if (this.direction === 'asc') this.direction = 'desc'
        else { this.column = null; this.direction = 'none' }
        const factor = this.direction === 'desc' ? -1 : 1
        const body = this.$refs.body
        const sorted = this.rows().sort((a, b) => {
            if (this.column === null) return a.dataset.dataTableOrder - b.dataset.dataTableOrder
            const left = this.value(a, index, key, numeric)
            const right = this.value(b, index, key, numeric)
            if (numeric) {
                const delta = (Number.isNaN(left) ? -Infinity : left) - (Number.isNaN(right) ? -Infinity : right)
                return (Number.isNaN(delta) ? 0 : delta) * factor
            }
            return String(left).localeCompare(String(right), undefined, { numeric: true, sensitivity: 'base' }) * factor
        })
        sorted.forEach((row) => body.appendChild(row))
    },
    aria(key) {
        return this.column === key ? (this.direction === 'asc' ? 'ascending' : 'descending') : 'none'
    },
}`
---

{hide_css && <style is:inline set:html={hide_css} />}

{visually_hidden ?
    <div class="[ visually-hidden ]">
    <table {...attributes} class:list={[Astro.props.class]}>
        {caption && <caption>{caption}</caption>}
        <thead>
            <tr>{columns.map((column) => <th scope="col">{column.label}</th>)}</tr>
        </thead>
        {bodies ? <slot /> : <tbody><slot /></tbody>}
        {has_footer && <tfoot><slot name="footer" /></tfoot>}
    </table>
    </div>
    :
<XFadeScroll
    class:list={['[ data-table-wrap ]', `data-table-wrap--${variant}`, { 'data-table-wrap--sticky': sticky_header }]}
    tabindex="0"
    role={caption ? 'region' : undefined}
    aria-label={caption}
>
    <table
        aria-label={caption && !caption_visible ? caption : undefined}
        {...attributes}
        class:list={[
            '[ data-table ]',
            `data-table--${density}`,
            `data-table--${borders}`,
            `data-table--${variant}`,
            { 'data-table--cards': cards && variant !== 'cards' },
            hide_below.length ? hide_id : undefined,
            { 'data-table--striped': striped },
            Astro.props.class,
        ]}
        x-data={sortable && !bodies ? sort_state : undefined}
    >
        {caption && caption_visible && <caption class="data-table__caption">{caption}</caption>}
        <thead>
            <tr>
                {columns.map((column, index) => {
                    const label = column.hidden_label
                        ? <span class="[ visually-hidden ]">{column.label}</span>
                        : column.label_html ? <Fragment set:html={column.label_html} /> : column.label
                    return (
                        <th
                            scope="col"
                            title={column.title}
                            class:list={[column.class, { 'data-table__numeric': column.numeric, 'data-table__center': column.align === 'center' }]}
                            style={column.width ? `width: ${column.width}` : undefined}
                            aria-sort={column.sortable ? 'none' : undefined}
                            x-bind:aria-sort={column.sortable ? `aria(${JSON.stringify(column.key)})` : undefined}
                        >
                            {column.sortable ?
                                <StylessButton
                                    type="button"
                                    class="[ data-table__sort ]"
                                    x-on:click={`sort(${index}, ${JSON.stringify(column.key)}, ${Boolean(column.numeric)})`}
                                >{label}</StylessButton>
                                : label
                            }
                        </th>
                    )
                })}
            </tr>
        </thead>
        {bodies ?
            <slot />
            :
            <tbody x-ref={sortable ? 'body' : undefined}>
                {show_empty ?
                    <tr data-table-static>
                        <td colspan={columns.length}><EmptyState title={empty_title} /></td>
                    </tr>
                    :
                    <slot />
                }
            </tbody>
        }
        {has_footer && <tfoot><slot name="footer" /></tfoot>}
    </table>
</XFadeScroll>
}

<style lang="scss">
    :global(.data-table-wrap) {
        min-width: 0;
    }

    // The scroller is capped so the header has something to stick against.
    :global(.data-table-wrap--sticky) {
        max-height: var(--data-table-max-height, 70vh);
        overflow-y: auto;
    }

    .data-table {
        width: 100%;
        border-spacing: var(--space-3xs);
        font-size: var(--step--1);

        :global(th),
        :global(td) {
            padding: var(--space-s);
            border: 1px solid color-mix(in srgb, var(--border-color) var(--tint-heavy), transparent);
            text-align: left;
            vertical-align: top;
        }

        :global(th) {
            background: color-mix(in srgb, var(--component-background) var(--tint-dense), transparent);
            font-weight: 600;
            color: var(--highlight);
            background-color: var(--light-transparency-background-mobile);

            @media screen and (min-width: 980px) {
                background-color: var(--light-transparency-background);
                backdrop-filter: blur(var(--transparency-backdrop-blur-heavier));
            }
        }

        :global(td) {
            color: var(--foreground);
            background-color: var(--light-transparency-background);
            backdrop-filter: blur(var(--transparency-backdrop-blur));
        }

        :global(.data-table__numeric) {
            text-align: right;
            font-variant-numeric: tabular-nums;
        }

        :global(.data-table__center) {
            text-align: center;
        }

        :global(tbody th[scope='row']) {
            color: var(--foreground);
            font-weight: inherit;
            background-color: var(--light-transparency-background);
            backdrop-filter: blur(var(--transparency-backdrop-blur));
        }

        :global(tfoot td),
        :global(tfoot th) {
            font-weight: 600;
        }

        :global(.data-table__actions) {
            text-align: right;
            white-space: nowrap;
            width: 1%;
        }
    }

    .data-table--dense {
        :global(th),
        :global(td) {
            padding: var(--space-3xs) var(--space-2xs);
        }
    }

    .data-table--grid {
        border-spacing: 0;
        border-collapse: collapse;
    }

    .data-table--none {
        :global(th),
        :global(td) {
            border-color: transparent;
        }
    }

    .data-table--striped :global(tbody tr:nth-child(even) td) {
        background-color: color-mix(in srgb, var(--highlight) 4%, var(--light-transparency-background));
    }

    :global(.data-table-wrap--sticky) .data-table :global(thead th) {
        position: sticky;
        top: 0;
        z-index: 1;
        background-color: var(--component-background);
    }

    .data-table :global(.data-table__sort) {
        appearance: none;
        font: inherit;
        display: inline-flex;
        align-items: center;
        gap: var(--space-3xs);

        &:focus-visible {
            outline: solid 2px var(--fleet-yellow);
            outline-offset: 2px;
        }

        &::after {
            content: '';
            font-size: var(--step--2);
            opacity: 0.5;
        }
    }

    th[aria-sort='ascending'] :global(.data-table__sort)::after {
        content: '▲';
        opacity: 1;
    }

    th[aria-sort='descending'] :global(.data-table__sort)::after {
        content: '▼';
        opacity: 1;
    }

    :global(.data-table__caption) {
        caption-side: top;
        text-align: left;
        padding: var(--space-xs) var(--space-s);
        color: var(--faded);
    }

    // Report look: the editorial board tables (Amamake market, warzone).
    .data-table--report {
        border-spacing: 0;
        border-collapse: collapse;

        :global(th),
        :global(td) {
            padding: var(--space-xs) var(--space-s);
            vertical-align: middle;
            border: none;
            border-bottom: solid 1px var(--data-table-rule, var(--mk-rule, var(--wz-rule, var(--border-color))));

            @media screen and (max-width: 720px) {
                padding: var(--space-xs) var(--space-2xs);
            }
        }

        :global(th) {
            font-weight: 600;
            color: var(--faded);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-size: var(--step--2);
            white-space: nowrap;
        }

        :global(tbody th[scope='row']) {
            color: inherit;
            font-weight: inherit;
            text-transform: none;
            letter-spacing: normal;
            font-size: inherit;
            white-space: nowrap;
        }

        :global(tbody tr:hover td) {
            background: color-mix(in srgb, var(--highlight) var(--tint-subtle), transparent);
        }

        :global(td:first-child) {
            white-space: nowrap;
        }

        :global(.data-table__numeric) {
            white-space: nowrap;
        }

        :global(.data-table__bar) {
            width: 34%;
            min-width: 12rem;

            @media screen and (max-width: 720px) {
                min-width: 8rem;
            }

            > :global(b) {
                display: block;
                margin-top: 0.3em;
                font-size: var(--step-0);
                color: var(--highlight);
            }
        }

        :global(th.data-table__bar) {
            width: auto;
            min-width: 12rem;

            @media screen and (max-width: 720px) {
                min-width: 8rem;
            }
        }
    }

    // Cards: below 48rem each row stacks as a card; cells label themselves with data-label.
    @media (max-width: 48rem) {
        .data-table--cards {
            display: block;
            border-spacing: 0;

            :global(thead) {
                display: none;
            }

            :global(tbody),
            :global(tfoot) {
                display: block;
            }

            :global(tr) {
                display: grid;
                grid-template-columns: repeat(var(--data-table-card-columns, 2), minmax(0, 1fr));
                gap: var(--space-2xs) var(--space-s);
                padding-block: var(--space-s);
                border-bottom: solid 1px var(--data-table-rule, var(--mk-rule, var(--wz-rule, var(--border-color))));
            }

            :global(tbody tr:hover td) {
                background: none;
            }

            :global(th),
            :global(td) {
                padding: 0;
                border: none;
                background: none;
                backdrop-filter: none;
                white-space: normal;
                min-width: 0;
                width: auto;
            }

            :global(.data-table__numeric) {
                text-align: left;
            }

            :global(.data-table__card-title) {
                grid-column: 1 / -1;
            }

            :global(td[data-label]::before) {
                content: attr(data-label);
                display: block;
                font-size: var(--step--2);
                color: var(--faded);
                text-transform: uppercase;
                letter-spacing: 0.06em;
                margin-bottom: 0.15em;
            }
        }
    }
</style>
