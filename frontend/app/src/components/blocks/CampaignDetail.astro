---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type {
    CampaignDetail as CampaignDetailType,
    CampaignWeek,
    CampaignFleet,
    CampaignLeaderboardRow,
    CampaignKillmail,
    CampaignSite,
    CampaignRoster,
    CampaignReadiness,
} from '@dtypes/api.minmatar.org'
import { campaign_totals_stats, sort_systems_by_contest, fw_objective_systems, ops_theater_systems } from '@helpers/fetching/campaigns'
import { format_isk } from '@helpers/numbers'

interface Props {
    campaign:           CampaignDetailType;
    week:               CampaignWeek | null;
    fleets:             CampaignFleet[];
    leaderboard:        CampaignLeaderboardRow[];
    killmails:          { rows:CampaignKillmail[]; has_more:boolean };
    sites:              { rows:CampaignSite[]; has_more:boolean };
    roster:             CampaignRoster | null;
    readiness:          CampaignReadiness | null;
    [propName: string]: any;
}

const {
    campaign,
    week,
    fleets,
    leaderboard,
    killmails,
    sites,
    roster,
    readiness,
    ...attributes
} = Astro.props

delete attributes.class
delete attributes.now
delete attributes.orders
delete attributes.timeline

const systems = sort_systems_by_contest(campaign.systems)
const fw_systems = fw_objective_systems(systems)
const ops_systems = ops_theater_systems(systems)
const areas = campaign.areas ?? []
/** The two zero-heavy figures (advantage generated, active today) stay on their own boards. */
const is_strategic = campaign.kind === 'strategic'
const stats = campaign_totals_stats(campaign.totals, t, format_isk, campaign.kind).slice(0, 5)
const structures = campaign.structures ?? []
const structures_destroyed = campaign.totals.structures_destroyed
const structures_remaining = campaign.totals.structures_remaining
const structures_tracking = t('campaigns.structures.tracking')
    .replace('{destroyed}', String(structures_destroyed))
    .replace('{remaining}', String(structures_remaining))
const has_systems = systems.length > 0 || areas.length > 0
/** Structures lead strategic; FW systems (and any theater systems) show when attached. */
const TABS:( 'structures' | 'systems' | 'fleets' | 'activity' | 'pilots' | 'you' )[] = [
    ...(is_strategic ? ['structures'] as const : []),
    ...(has_systems || !is_strategic ? ['systems'] as const : []),
    'fleets',
    'activity',
    'pilots',
    'you',
]
const tab_label = (tab:string) => t(`campaigns.tabs.${tab}` as 'campaigns.tabs.systems')
const default_tab = TABS[0]
const show_systems_tab = TABS.includes('systems')
const show_structures_tab = TABS.includes('structures')

const SCHEDULE_FLEET_URL = translatePath(`/fleets/add/?campaign_id=${campaign.id}`)

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import Grid from '@components/compositions/Grid.astro'

import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import Button from '@components/blocks/Button.astro'
import CampaignOrdersHero from '@components/blocks/CampaignOrdersHero.astro'
import CampaignStatBar from '@components/blocks/CampaignStatBar.astro'
import CampaignSystemCard from '@components/blocks/CampaignSystemCard.astro'
import CampaignTheaterList from '@components/blocks/CampaignTheaterList.astro'
import CampaignStructuresTable from '@components/blocks/CampaignStructuresTable.astro'
import CampaignFleetsTable from '@components/blocks/CampaignFleetsTable.astro'
import CampaignSites from '@components/blocks/CampaignSites.astro'
import CampaignLeaderboard from '@components/blocks/CampaignLeaderboard.astro'
import CampaignKillfeed from '@components/blocks/CampaignKillfeed.astro'
import CampaignRosterTable from '@components/blocks/CampaignRosterTable.astro'
import CampaignCoverageChart from '@components/blocks/CampaignCoverageChart.astro'
import CampaignYouPanel from '@components/blocks/CampaignYouPanel.astro'
---

<Flexblock gap='var(--space-l)' class:list={['[ campaign-detail ]', Astro.props.class]} {...attributes}>
    <CampaignOrdersHero campaign={campaign} week={week} />

    <div
        class="[ campaign-tabs ]"
        x-data={`{
            tabs: ${JSON.stringify(TABS)},
            tab: '${default_tab}',
            init() {
                const hash = window.location.hash.replace('#', '')
                if (this.tabs.includes(hash)) this.tab = hash
                else if (hash.startsWith('campaign-system-')) this.tab = 'systems'
            },
            select(tab) {
                this.tab = tab
                history.replaceState(null, '', '#' + tab)
                this.$nextTick(() => this.$refs['tab-' + tab]?.focus())
            },
            step(offset) {
                const index = this.tabs.indexOf(this.tab)
                this.select(this.tabs[(index + offset + this.tabs.length) % this.tabs.length])
            },
        }`}
    >
        <div class="[ campaign-tabs-list ]" role="tablist" aria-label={t('campaigns.tabs.label')}>
            {TABS.map((tab, index) =>
                <button
                    type="button"
                    role="tab"
                    id={`campaign-tab-${tab}`}
                    class:list={['[ campaign-tab ]', { 'is-active': index === 0 }]}
                    aria-controls={`campaign-panel-${tab}`}
                    aria-selected={index === 0 ? 'true' : 'false'}
                    tabindex={index === 0 ? 0 : -1}
                    x-ref={`tab-${tab}`}
                    x-bind:class={`{ 'is-active': tab === '${tab}' }`}
                    x-bind:aria-selected={`tab === '${tab}' ? 'true' : 'false'`}
                    x-bind:tabindex={`tab === '${tab}' ? 0 : -1`}
                    x-on:click={`select('${tab}')`}
                    x-on:keydown.arrow-right.prevent="step(1)"
                    x-on:keydown.arrow-left.prevent="step(-1)"
                    x-on:keydown.home.prevent="select(tabs[0])"
                    x-on:keydown.end.prevent="select(tabs[tabs.length - 1])"
                >
                    {tab_label(tab)}
                </button>
            )}
        </div>

        {show_systems_tab &&
            <section
                id="campaign-panel-systems"
                role="tabpanel"
                aria-labelledby="campaign-tab-systems"
                class="[ campaign-panel ]"
                x-bind:hidden="tab !== 'systems'"
                hidden={default_tab !== 'systems'}
            >
                {systems.length === 0 && areas.length === 0 ?
                    <small>{t('campaigns.systems.none')}</small>
                    :
                    <Flexblock gap='var(--space-m)'>
                        {fw_systems.length > 0 &&
                            <Flexblock gap='var(--space-s)'>
                                <h3>{t('campaigns.theater.fw_objectives')}</h3>
                                <small>{t('campaigns.theater.fw_hint')}</small>
                                {fw_systems.map(system =>
                                    <div id={`campaign-system-${system.id}`}>
                                        <CampaignSystemCard system={system} slug={campaign.slug} can_report={campaign.is_enlisted} />
                                    </div>
                                )}
                            </Flexblock>
                        }
                        {(ops_systems.length > 0 || areas.length > 0) &&
                            <ComponentBlock padding_inline='var(--space-m)' padding_block='var(--space-m)'>
                                <Flexblock gap='var(--space-s)'>
                                    <Flexblock gap='var(--space-3xs)'>
                                        <h3>{
                                            fw_systems.length > 0
                                                ? t('campaigns.theater.ops_theaters')
                                                : t('campaigns.theater.title')
                                        }</h3>
                                        <small>{
                                            fw_systems.length > 0
                                                ? t('campaigns.theater.ops_hint')
                                                : t('campaigns.theater.hint')
                                        }</small>
                                    </Flexblock>
                                    <CampaignTheaterList
                                        systems={ops_systems}
                                        areas={areas}
                                    />
                                </Flexblock>
                            </ComponentBlock>
                        }
                        {!is_strategic && structures.length > 0 &&
                            <ComponentBlock padding_inline='var(--space-m)' padding_block='var(--space-m)'>
                                <CampaignStructuresTable
                                    structures={structures}
                                    slug={campaign.slug}
                                    show_add_timer={true}
                                />
                            </ComponentBlock>
                        }
                    </Flexblock>
                }
            </section>
        }

        {show_structures_tab &&
            <section
                id="campaign-panel-structures"
                role="tabpanel"
                aria-labelledby="campaign-tab-structures"
                class="[ campaign-panel ]"
                hidden={default_tab !== 'structures'}
                x-bind:hidden="tab !== 'structures'"
            >
                <ComponentBlock padding_inline='var(--space-m)' padding_block='var(--space-m)'>
                    <CampaignStructuresTable
                        structures={structures}
                        slug={campaign.slug}
                        show_add_timer={true}
                        tracking={structures_tracking}
                    />
                </ComponentBlock>
            </section>
        }

        <section
            id="campaign-panel-fleets"
            role="tabpanel"
            aria-labelledby="campaign-tab-fleets"
            class="[ campaign-panel ]"
            hidden
            x-bind:hidden="tab !== 'fleets'"
        >
            <ComponentBlock padding_inline='var(--space-m)' padding_block='var(--space-m)'>
                <Flexblock gap='var(--space-s)'>
                    <FlexInline gap='var(--space-s)' justification='space-between' class="[ items-center ]">
                        <Flexblock gap='var(--space-3xs)'>
                            <h3>{t('campaigns.fleets.title')}</h3>
                            <small>{t('campaigns.fleets.hint')}</small>
                        </Flexblock>
                        <Button size='sm' href={SCHEDULE_FLEET_URL}>
                            {t('campaigns.fleets.schedule')}
                        </Button>
                    </FlexInline>
                    <CampaignFleetsTable fleets={fleets} />
                </Flexblock>
            </ComponentBlock>
        </section>

        <section
            id="campaign-panel-activity"
            role="tabpanel"
            aria-labelledby="campaign-tab-activity"
            class="[ campaign-panel ]"
            hidden
            x-bind:hidden="tab !== 'activity'"
        >
            <Flexblock gap='var(--space-m)'>

                <ComponentBlock padding_inline='var(--space-m)' padding_block='var(--space-m)'>
                    <Flexblock gap='var(--space-s)'>
                        <h3>{t('campaigns.killfeed.title')}</h3>
                        <CampaignKillfeed
                            slug={campaign.slug}
                            killmails={killmails.rows}
                            has_more={killmails.has_more}
                            outcome=''
                            systems={campaign.systems}
                        />
                    </Flexblock>
                </ComponentBlock>

                {!is_strategic &&
                    <ComponentBlock padding_inline='var(--space-m)' padding_block='var(--space-m)'>
                        <Flexblock gap='var(--space-s)'>
                            <h3>{t('campaigns.sites.title')}</h3>
                            <CampaignSites slug={campaign.slug} sites={sites.rows} has_more={sites.has_more} />
                        </Flexblock>
                    </ComponentBlock>
                }
            </Flexblock>
        </section>

        <section
            id="campaign-panel-pilots"
            role="tabpanel"
            aria-labelledby="campaign-tab-pilots"
            class="[ campaign-panel ]"
            hidden
            x-bind:hidden="tab !== 'pilots'"
        >
            <Flexblock gap='var(--space-m)'>
                <Flexblock gap='var(--space-2xs)'>
                    <small class="[ campaign-panel-label ]">{t('campaigns.totals.title')}</small>
                    <CampaignStatBar id='campaign-stat-bar' stats={stats} />
                </Flexblock>

                <Grid min_item_width='26rem' row_gap='var(--space-m)' column_gap='var(--space-m)'>
                    <ComponentBlock padding_inline='var(--space-m)' padding_block='var(--space-m)'>
                        <Flexblock gap='var(--space-s)'>
                            <h3>{t('campaigns.leaderboard.title')}</h3>
                            <CampaignLeaderboard
                                slug={campaign.slug}
                                rows={leaderboard}
                                metric='points'
                                period='week'
                            />
                        </Flexblock>
                    </ComponentBlock>

                    <ComponentBlock padding_inline='var(--space-m)' padding_block='var(--space-m)'>
                        <Flexblock gap='var(--space-s)'>
                            <FlexInline gap='var(--space-s)' justification='space-between' class="[ items-center ]">
                                <h3>{t('campaigns.roster.title')}</h3>
                                <Button size='sm' color='transparent' href={translatePath(`/campaigns/${campaign.slug}/roster/`)}>
                                    {t('campaigns.roster.view_full')}
                                </Button>
                            </FlexInline>
                            <CampaignRosterTable pilots={roster?.pilots ?? []} limit={10} />
                        </Flexblock>
                    </ComponentBlock>
                </Grid>

                <ComponentBlock padding_inline='var(--space-m)' padding_block='var(--space-m)'>
                    <CampaignCoverageChart coverage={roster?.coverage ?? []} />
                </ComponentBlock>
            </Flexblock>
        </section>

        <section
            id="campaign-panel-you"
            role="tabpanel"
            aria-labelledby="campaign-tab-you"
            class="[ campaign-panel ]"
            hidden
            x-bind:hidden="tab !== 'you'"
        >
            <CampaignYouPanel campaign={campaign} readiness={readiness} />
        </section>
    </div>
</Flexblock>

<style lang="scss">
    h3 {
        font-family: var(--heading-font);
        font-size: var(--step-1);
        color: var(--highlight);
    }

    .campaign-tabs {
        display: flex;
        flex-direction: column;
        gap: var(--space-m);
    }

    .campaign-tabs-list {
        display: flex;
        gap: var(--space-2xs);
        border-bottom: solid 1px var(--border-color-hover);
    }

    .campaign-tab {
        appearance: none;
        background: transparent;
        border: 0;
        border-bottom: 3px solid transparent;
        margin-block-end: -1px;
        padding: var(--space-2xs) var(--space-s);
        font-family: var(--heading-font);
        font-size: var(--step-1);
        text-transform: uppercase;
        letter-spacing: 0.02em;
        color: var(--foreground);
        cursor: pointer;

        &.is-active {
            color: var(--highlight);
            border-bottom-color: var(--fleet-red);
        }

        &:focus-visible {
            outline: solid 2px var(--fleet-yellow);
            outline-offset: -2px;
        }
    }

    @media (hover: hover) {
        .campaign-tab:hover {
            color: var(--highlight);
        }
    }

    .campaign-panel[hidden] {
        display: none;
    }

    .campaign-panel-label {
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--foreground);
    }



    @media screen and (max-width: 767px) {
        .campaign-tabs-list {
            gap: 0;
        }

        .campaign-tab {
            flex: 1 1 0;
            text-align: center;
            padding-inline: var(--space-2xs);
            font-size: var(--step-0);
        }
    }
</style>
