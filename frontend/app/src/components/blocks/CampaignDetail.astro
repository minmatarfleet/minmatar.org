---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type {
    CampaignDetail as CampaignDetailType,
    CampaignWeek,
    CampaignFleet,
    CampaignLeaderboardRow,
    CampaignCorporationLeaderboardRow,
    CampaignKillmail,
    CampaignSite,
    CampaignRoster,
    CampaignReadiness,
} from '@dtypes/api.minmatar.org'
import { campaign_totals_stats, sort_systems_by_contest, fw_objective_systems, ops_theater_systems } from '@helpers/fetching/campaigns'
import { format_isk } from '@helpers/numbers'
import { campaign_tabs } from '@helpers/campaign_features'

interface Props {
    campaign:           CampaignDetailType;
    week:               CampaignWeek | null;
    fleets:             CampaignFleet[];
    leaderboard:        CampaignLeaderboardRow[];
    corporation_board:  CampaignCorporationLeaderboardRow[];
    killmails:          { rows:CampaignKillmail[]; has_more:boolean };
    sites:              { rows:CampaignSite[]; has_more:boolean };
    roster:             CampaignRoster | null;
    readiness:          CampaignReadiness | null;
    token_error?:       string | false;
    /** Managers get the Settings tab. */
    can_manage?:        boolean;
    /** Nothing counts yet: the hero is the checklist (managers) or the fittings. */
    before_start?:      boolean;
    [propName: string]: any;
}

const {
    campaign,
    week,
    fleets,
    leaderboard,
    corporation_board,
    killmails,
    sites,
    roster,
    readiness,
    token_error = false,
    can_manage = false,
    before_start = false,
    ...attributes
} = Astro.props

delete attributes.class
delete attributes.now
delete attributes.orders
delete attributes.timeline

const systems = sort_systems_by_contest(campaign.systems)
const fw_systems = fw_objective_systems(systems)
const ops_systems = ops_theater_systems(systems)
const areas = campaign.areas ?? []
/** The two zero-heavy figures (advantage generated, active today) stay on their own boards. */
const is_strategic = campaign.kind === 'strategic'
const stats = campaign_totals_stats(campaign.totals, t, format_isk, campaign.kind).slice(0, 5)
const structures = campaign.structures ?? []
const structures_destroyed = campaign.totals.structures_destroyed
const structures_tracking = t('campaigns.structures.tracking_states')
    .replace('{destroyed}', String(structures_destroyed))
    .replace('{reinforced}', String(structures.filter((row) => row.status === 'reinforced').length))
    .replace('{anchored}', String(structures.filter((row) => row.status === 'anchored').length))
const has_systems = systems.length > 0 || areas.length > 0
const features = campaign.features
/** Each feature switch shows or hides its tab (helpers/campaign_features). */
const is_coordinator = campaign.viewer_role === 'coordinator'
const TABS = campaign_tabs({
    kind: campaign.kind || 'strategic',
    features,
    has_systems,
    can_manage,
    before_start,
    coordinator_scopes: is_coordinator ? campaign.coordinator_scopes : null,
    has_roles: (campaign.viewer_roles ?? []).length > 0,
    can_link_discord: (campaign.can_edit ?? []).includes('discord'),
})
const tab_label = (tab:string) => tab === 'settings'
    ? t('campaigns.manage.tab')
    : tab === 'discord'
        ? t('campaigns.discord.your_servers')
        : tab === 'roles'
        ? t('campaigns.roles.tab')
        : t(`campaigns.tabs.${tab}` as 'campaigns.tabs.systems')
const default_tab = TABS[0]
const show_systems_tab = TABS.includes('systems')
const show_structures_tab = TABS.includes('structures')

// Corporation projects directors put toward the campaign; loaded when the tab opens.
const PROJECTS_PARTIAL_URL = translatePath(`/partials/campaign_projects_component?slug=${encodeURIComponent(campaign.slug)}`)
const TIMERS_PARTIAL_URL = translatePath(`/partials/campaign_timers_component?slug=${encodeURIComponent(campaign.slug)}`)
const ROLES_PARTIAL_URL = translatePath(`/partials/campaign_roles_component?slug=${encodeURIComponent(campaign.slug)}`)
const DISCORD_PARTIAL_URL = translatePath(`/partials/campaign_discord_component?slug=${encodeURIComponent(campaign.slug)}`)
const DESTRUCTION_PARTIAL_URL = translatePath(`/partials/campaign_destruction_component?slug=${encodeURIComponent(campaign.slug)}`)
const FLEETS_PARTIAL_URL = translatePath(`/partials/campaign_fleets_component?campaign_id=${campaign.id}`)
/** Fleets still to run (or running) sit above the history, which only lists finished ones. */
const upcoming_fleets = fleets.filter((fleet) => fleet.is_live || fleet.status === 'pending')
const SCHEDULE_FLEET_URL = translatePath(`/fleets/add/?campaign_id=${campaign.id}`)

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import Grid from '@components/compositions/Grid.astro'

import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import Button from '@components/blocks/Button.astro'
import CampaignOrdersHero from '@components/blocks/CampaignOrdersHero.astro'
import CampaignPausedBanner from '@components/blocks/CampaignPausedBanner.astro'
import CampaignStatBar from '@components/blocks/CampaignStatBar.astro'
import CampaignSystemCard from '@components/blocks/CampaignSystemCard.astro'
import CampaignTheaterList from '@components/blocks/CampaignTheaterList.astro'
import CampaignStructuresTable from '@components/blocks/CampaignStructuresTable.astro'
import CampaignFleetsTable from '@components/blocks/CampaignFleetsTable.astro'
import CampaignSites from '@components/blocks/CampaignSites.astro'
import CampaignLeaderboard from '@components/blocks/CampaignLeaderboard.astro'
import CampaignKillfeed from '@components/blocks/CampaignKillfeed.astro'
import CampaignCorporationBoard from '@components/blocks/CampaignCorporationBoard.astro'
import CampaignCoverageChart from '@components/blocks/CampaignCoverageChart.astro'
import CampaignYouPanel from '@components/blocks/CampaignYouPanel.astro'
import SectionTabs from '@components/blocks/SectionTabs.astro'
import LazyPartial from '@components/blocks/LazyPartial.astro'
import SectionTabPanel from '@components/blocks/SectionTabPanel.astro'
import CampaignSettingsPanel from '@components/blocks/CampaignSettingsPanel.astro'
import CampaignReadyChecklist from '@components/blocks/CampaignReadyChecklist.astro'
import CampaignFittings from '@components/blocks/CampaignFittings.astro'
import { get_gates, can } from '@helpers/gates'

const can_coordinate = can_manage && can(await get_gates(Astro), 'campaigns.coordination')
---

<Flexblock
    gap='var(--space-l)'
    class:list={['[ campaign-detail ]', Astro.props.class]}
    x-data="{ tab: location.hash.slice(1) }"
    {...{ 'x-on:section-tabs:change': 'tab = $event.detail.tab' }}
    {...attributes}
>
    {campaign.status === 'paused' && <CampaignPausedBanner campaign={campaign} can_manage={can_manage} />}

    {/* Settings is a page of its own: the week's progress steps aside so the tabs sit under the title. */}
    <div x-show="tab !== 'settings'">
        {!before_start ?
            <CampaignOrdersHero campaign={campaign} week={week} />
            : can_manage ?
                <CampaignReadyChecklist campaign={campaign} />
                : (campaign.fittings?.length ?? 0) > 0 &&
                    <CampaignFittings fittings={campaign.fittings} />
        }
    </div>

    <SectionTabs
        tabs={TABS.map((tab) => ({ id: tab, label: tab_label(tab) }))}
        aria_label={t('campaigns.tabs.label')}
        id_prefix="campaign"
        hash_aliases={{ 'campaign-system-': 'systems' }}
    >
        {show_systems_tab &&
            <SectionTabPanel id="systems" id_prefix="campaign" is_default={default_tab === 'systems'}>
                {systems.length === 0 && areas.length === 0 ?
                    <small>{t('campaigns.systems.none')}</small>
                    :
                    <Flexblock gap='var(--space-m)'>
                        {fw_systems.length > 0 &&
                            <Flexblock gap='var(--space-s)'>
                                {fw_systems.map(system =>
                                    <div id={`campaign-system-${system.id}`}>
                                        <CampaignSystemCard system={system} slug={campaign.slug} can_report={campaign.is_enlisted} />
                                    </div>
                                )}
                            </Flexblock>
                        }
                        {(ops_systems.length > 0 || areas.length > 0) &&
                            <ComponentBlock padding_inline='var(--space-m)' padding_block='var(--space-m)'>
                                <Flexblock gap='var(--space-s)'>
                                    <Flexblock gap='var(--space-3xs)'>
                                        <h3>{
                                            fw_systems.length > 0
                                                ? t('campaigns.theater.ops_theaters')
                                                : t('campaigns.theater.title')
                                        }</h3>
                                        <small>{
                                            fw_systems.length > 0
                                                ? t('campaigns.theater.ops_hint')
                                                : t('campaigns.theater.hint')
                                        }</small>
                                    </Flexblock>
                                    <CampaignTheaterList
                                        systems={ops_systems}
                                        areas={areas}
                                    />
                                </Flexblock>
                            </ComponentBlock>
                        }
                        {!show_structures_tab && structures.length > 0 &&
                            <ComponentBlock padding_inline='var(--space-m)' padding_block='var(--space-m)'>
                                <CampaignStructuresTable
                                    structures={structures}
                                    slug={campaign.slug}
                                    show_add_timer={true}
                                />
                            </ComponentBlock>
                        }
                    </Flexblock>
                }
            </SectionTabPanel>
        }

        {show_structures_tab &&
            <SectionTabPanel id="structures" id_prefix="campaign" is_default={default_tab === 'structures'}>
                <ComponentBlock padding_inline='var(--space-m)' padding_block='var(--space-m)'>
                    <CampaignStructuresTable
                        structures={structures}
                        slug={campaign.slug}
                        show_add_timer={true}
                        tracking={structures_tracking}
                    />
                </ComponentBlock>
            </SectionTabPanel>
        }

        {TABS.includes('timers') &&
            <SectionTabPanel id="timers" id_prefix="campaign" is_default={default_tab === 'timers'}>
                <ComponentBlock padding_inline='var(--space-m)' padding_block='var(--space-m)'>
                    <LazyPartial url={TIMERS_PARTIAL_URL} trigger="reveal">
                        <p class="[ campaign-panel-label ]">{t('campaigns.timers.loading')}</p>
                    </LazyPartial>
                </ComponentBlock>
            </SectionTabPanel>
        }

        {TABS.includes('fleets') &&
        <SectionTabPanel id="fleets" id_prefix="campaign" is_default={default_tab === 'fleets'}>
            <ComponentBlock padding_inline='var(--space-m)' padding_block='var(--space-m)'>
                <Flexblock gap='var(--space-s)'>
                    <FlexInline gap='var(--space-s)' justification='space-between' class="[ items-center ]">
                        <Flexblock gap='var(--space-3xs)'>
                            <h3>{t('campaigns.fleets.title')}</h3>
                            <small>{t('campaigns.fleets.hint')}</small>
                        </Flexblock>
                        <Button size='sm' href={SCHEDULE_FLEET_URL}>
                            {t('campaigns.fleets.schedule')}
                        </Button>
                    </FlexInline>
                    {upcoming_fleets.length > 0 && <CampaignFleetsTable fleets={upcoming_fleets} />}
                    <LazyPartial url={FLEETS_PARTIAL_URL} trigger="reveal">
                        <p class="[ campaign-panel-label ]">{t('campaigns.fleets.loading')}</p>
                    </LazyPartial>
                </Flexblock>
            </ComponentBlock>
        </SectionTabPanel>
        }

        {TABS.includes('destruction') &&
            <SectionTabPanel id="destruction" id_prefix="campaign" is_default={default_tab === 'destruction'}>
                <ComponentBlock padding_inline='var(--space-m)' padding_block='var(--space-m)'>
                    <LazyPartial url={DESTRUCTION_PARTIAL_URL} trigger="reveal">
                        <p class="[ campaign-panel-label ]">{t('campaigns.destruction.loading')}</p>
                    </LazyPartial>
                </ComponentBlock>
            </SectionTabPanel>
        }

        {TABS.includes('activity') &&
        <SectionTabPanel id="activity" id_prefix="campaign" is_default={default_tab === 'activity'}>
            <Flexblock gap='var(--space-m)'>

                <ComponentBlock padding_inline='var(--space-m)' padding_block='var(--space-m)'>
                    <Flexblock gap='var(--space-s)'>
                        <h3>{t('campaigns.killfeed.title')}</h3>
                        <CampaignKillfeed
                            slug={campaign.slug}
                            killmails={killmails.rows}
                            has_more={killmails.has_more}
                            outcome=''
                            systems={campaign.systems}
                        />
                    </Flexblock>
                </ComponentBlock>

                {!is_strategic &&
                    <ComponentBlock padding_inline='var(--space-m)' padding_block='var(--space-m)'>
                        <Flexblock gap='var(--space-s)'>
                            <h3>{t('campaigns.sites.title')}</h3>
                            <CampaignSites slug={campaign.slug} sites={sites.rows} has_more={sites.has_more} />
                        </Flexblock>
                    </ComponentBlock>
                }
            </Flexblock>
        </SectionTabPanel>
        }

        {TABS.includes('pilots') &&
        <SectionTabPanel id="pilots" id_prefix="campaign" is_default={default_tab === 'pilots'}>
            <Flexblock gap='var(--space-m)'>
                <Flexblock gap='var(--space-2xs)'>
                    <small class="[ campaign-panel-label ]">{t('campaigns.totals.title')}</small>
                    <CampaignStatBar id='campaign-stat-bar' stats={stats} />
                </Flexblock>

                <Grid min_item_width='26rem' row_gap='var(--space-m)' column_gap='var(--space-m)'>
                    <ComponentBlock padding_inline='var(--space-m)' padding_block='var(--space-m)'>
                        <Flexblock gap='var(--space-s)'>
                            <h3>{t('campaigns.leaderboard.title')}</h3>
                            <CampaignLeaderboard
                                slug={campaign.slug}
                                rows={leaderboard}
                                metric='kills'
                                period='week'
                            />
                        </Flexblock>
                    </ComponentBlock>

                    <ComponentBlock padding_inline='var(--space-m)' padding_block='var(--space-m)'>
                        <Flexblock gap='var(--space-s)'>
                            <FlexInline gap='var(--space-s)' justification='space-between' class="[ items-center ]">
                                <h3>{t('campaigns.corporations.title')}</h3>
                                <Button size='sm' color='transparent' href={translatePath(`/campaigns/${campaign.slug}/roster/`)}>
                                    {t('campaigns.corporations.view_full')}
                                </Button>
                            </FlexInline>
                            <CampaignCorporationBoard
                                slug={campaign.slug}
                                rows={corporation_board}
                                metric='kills'
                                period='week'
                            />
                        </Flexblock>
                    </ComponentBlock>
                </Grid>

                <ComponentBlock padding_inline='var(--space-m)' padding_block='var(--space-m)'>
                    <CampaignCoverageChart coverage={roster?.coverage ?? []} />
                </ComponentBlock>
            </Flexblock>
        </SectionTabPanel>
        }

        {TABS.includes('projects') &&
        <SectionTabPanel id="projects" id_prefix="campaign" is_default={default_tab === 'projects'}>
            <div
                hx-get={PROJECTS_PARTIAL_URL}
                hx-trigger="intersect once"
                hx-swap="outerHTML"
            >
                <p class="[ campaign-panel-label ]">{t('campaigns.projects.loading')}</p>
            </div>
        </SectionTabPanel>
        }

        {TABS.includes('you') &&
        <SectionTabPanel id="you" id_prefix="campaign" is_default={default_tab === 'you'}>
            <CampaignYouPanel campaign={campaign} readiness={readiness} flash={token_error} />
        </SectionTabPanel>
        }

        {TABS.includes('discord') &&
        <SectionTabPanel id="discord" id_prefix="campaign" is_default={default_tab === 'discord'}>
            <LazyPartial url={DISCORD_PARTIAL_URL} />
        </SectionTabPanel>
        }

        {TABS.includes('roles') &&
        <SectionTabPanel id="roles" id_prefix="campaign" is_default={default_tab === 'roles'}>
            <LazyPartial url={ROLES_PARTIAL_URL} trigger="reveal" />
        </SectionTabPanel>
        }

        {can_manage &&
            <SectionTabPanel id="settings" id_prefix="campaign" is_default={false}>
                <CampaignSettingsPanel campaign={campaign} week={week} has_structures_tab={show_structures_tab} can_coordinate={can_coordinate} />
            </SectionTabPanel>
        }
    </SectionTabs>
</Flexblock>

<style lang="scss">
    h3 {
        font-family: var(--heading-font);
        font-size: var(--step-1);
        color: var(--highlight);
    }

    .campaign-panel-label {
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--foreground);
    }
</style>
