---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { FreightContract } from '@dtypes/api.minmatar.org'

interface Props {
    contracts:      FreightContract[];
    init_tooltips:  boolean;
    is_history?:    boolean;
}

const {
    contracts,
    init_tooltips,
    is_history = false,
} = Astro.props

import Flexblock from '@components/compositions/Flexblock.astro';
import FlexInline from '@components/compositions/FlexInline.astro';

import FreightContractItem from '@components/blocks/FreightContractItem.astro';
import Button from '@components/blocks/Button.astro';
---

<Flexblock class="[ freight-contracts-table ]" gap='var(--space-l)'>
    <div class="[ freight-contracts-table__scroll ]">
        <div class="[ freight-contracts-table__grid ]" role="table">
            <div class="[ freight-contracts-table__header ]" role="row">
                <div role="columnheader">{t('date_created')}</div>
                <div role="columnheader">{t('creator')}</div>
                <div role="columnheader">{t('route')}</div>
                <div role="columnheader">{t('status')}</div>
                <div role="columnheader">{t('size_m3')}</div>
                <div role="columnheader">{t('collateral')}</div>
                <div role="columnheader">{t('reward')}</div>
                <div role="columnheader">{t('servicing')}</div>
            </div>

            {contracts.map(contract =>
                <div x-show="show_item($el)">
                    <FreightContractItem contract={contract} init_tooltips={init_tooltips} />
                </div>
            )}

            <p class="[ no-result-text ]">{t('no_results')}</p>
        </div>
    </div>

    {!is_history &&
        <FlexInline justification='center' class="[ w-full pt-[var(--space-s)] pb-[64px] ]">
            <Button
                href={translatePath('/market/freight/contracts/history/')}
                size='sm'
            >
                {t('view_all_historical_contracts')}
            </Button>
        </FlexInline>
    }
</Flexblock>

<style lang="scss">
    .freight-contracts-table__scroll {
        overflow-x: auto;
        mask-image: linear-gradient(to right, black 90%, transparent);
    }

    .freight-contracts-table__grid {
        min-width: 70rem;
    }

    .freight-contracts-table__header {
        display: grid;
        grid-template-columns: minmax(6.5rem, 0.8fr) minmax(10rem, 1.4fr) minmax(8rem, 1fr) minmax(7rem, 0.9fr) minmax(6rem, 0.8fr) minmax(7rem, 1fr) minmax(7rem, 1fr) minmax(7rem, 1fr);
        gap: var(--space-s);
        align-items: end;
        padding-block: var(--space-2xs);
        padding-inline: var(--space-2xs);
        border-bottom: solid 1px var(--border-color);
        color: var(--highlight);
        font-size: var(--step--1);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.02em;
    }

    :not([style="display: none;"]) ~ .no-result-text {
        display: none;
    }

    .no-result-text {
        padding: var(--space-m) var(--space-2xs);
    }
</style>
