---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { FreightContract } from '@dtypes/api.minmatar.org'

interface Props {
    contracts:      FreightContract[];
    is_history?:    boolean;
}

const {
    contracts,
    is_history = false,
} = Astro.props

import Flexblock from '@components/compositions/Flexblock.astro';
import FlexInline from '@components/compositions/FlexInline.astro';
import DataGrid from '@components/blocks/DataGrid.astro';
import FreightContractItem from '@components/blocks/FreightContractItem.astro';
import Button from '@components/blocks/Button.astro';
---

<Flexblock class="[ freight-contracts-table ]" gap='var(--space-l)'>
    <DataGrid
        variant="ledger"
        stack={true}
        min_width="70rem"
        template="minmax(6.5rem, 0.8fr) minmax(10rem, 1.4fr) minmax(8rem, 1fr) minmax(7rem, 0.9fr) minmax(6rem, 0.8fr) minmax(7rem, 1fr) minmax(7rem, 1fr) minmax(7rem, 1fr)"
        columns={[
            t('date_created'),
            t('creator'),
            t('route'),
            t('status'),
            t('size_m3'),
            t('collateral'),
            t('reward'),
            t('servicing'),
        ]}
    >
        {contracts.map(contract =>
            <FreightContractItem contract={contract} />
        )}
    </DataGrid>

    {!is_history &&
        <FlexInline justification='center' class="[ w-full pt-[var(--space-s)] pb-[64px] ]">
            <Button
                href={translatePath('/market/freight/contracts/history/')}
                size='sm'
            >
                {t('view_all_historical_contracts')}
            </Button>
        </FlexInline>
    }
</Flexblock>
