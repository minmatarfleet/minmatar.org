---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

interface Props {
    eve_time:   Date;
}

const {
    eve_time,
} = Astro.props

import TextGroup from '@components/blocks/TextGroup.astro';
import LocalTime from '@components/blocks/LocalTime.astro';
---

<TextGroup title={t('local_time')}>
    <LocalTime eve_time={eve_time} />
</TextGroup>
