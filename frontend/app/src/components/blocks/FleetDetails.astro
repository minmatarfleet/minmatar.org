---
import { i18n } from '@helpers/i18n'
const { lang, t, translatePath } = i18n(Astro.url)

import type { FleetUI, FleetCompositionUI, FleetRadarUI } from '@dtypes/layout_components'

import type { SummaryCharacter, FleetMetrics, FleetCommanderMetrics } from '@dtypes/api.minmatar.org'
import type { FleetRoleCoverage, FleetShipVolunteer, FleetRefit, FleetCompositionEntry, FleetSupply, FleetKills as FleetKillsData, FleetSrpLoss, FleetFights as FleetFightsData } from '@helpers/api.minmatar.org/fleets'

interface Props {
    fleet:                      FleetUI;
    history?:                   boolean;
    can_remove_fleet:           boolean;
    is_fleet_commander?:        boolean;
    /** Ships, refits, and cyno assignment. Strategic FCs manage fleets they did not create. */
    can_manage?:                boolean;
    fleet_composition?:         FleetCompositionUI[];
    fleet_radar?:               FleetRadarUI[];
    /** Fleet roles from ships; null on a completed fleet. */
    roles?:                     FleetRoleCoverage | null,
    pilots:                     SummaryCharacter[],
    update_cover:               boolean;
    fleet_metrics:              FleetMetrics | undefined;
    fleet_commander_metrics:    FleetCommanderMetrics | undefined;
    ship_volunteers?:           FleetShipVolunteer[];
    refits?:                    FleetRefit[];
    composition?:               FleetCompositionEntry[];
    supply?:                    FleetSupply;
    /** A completed fleet's killmails, fetched by the page; null loads them through the partial. */
    fleet_kills?:               FleetKillsData | null;
    srp_losses?:                FleetSrpLoss[] | null;
    /** The Fights tab; null when the viewer may not see it (a live fleet they are not in). */
    fights?:                    FleetFightsData | null;
}

const {
    fleet,
    history = false,
    can_remove_fleet = false,
    is_fleet_commander = false,
    can_manage = is_fleet_commander,
    fleet_composition,
    fleet_radar,
    roles = null,
    pilots,
    update_cover,
    fleet_metrics,
    fleet_commander_metrics,
    ship_volunteers = [],
    refits = [],
    composition = [],
    supply,
    fleet_kills = null,
    srp_losses = null,
    fights = null,
} = Astro.props

const FLEET_COMPOSITION_PARTIAL_URL = `${translatePath('/partials/fleet_composition')}?id=${fleet.id}`
const FLEET_KILLS_PARTIAL_URL = `${translatePath('/partials/fleet_kills_component')}?fleet_id=${fleet.id}`

import { minutes_to } from '@helpers/date';

const diff_time = minutes_to(fleet.start_time)
const minutes_to_fleet = diff_time < 0 ? Math.abs(diff_time) : 0
const pre_pingable = minutes_to_fleet >= 30

import { get_fleet_tracking_texts } from '@helpers/fetching/fleets'
const fleet_tracking_texts = get_fleet_tracking_texts(lang, fleet.tracking)

import Flexblock from '@components/compositions/Flexblock.astro';
import Wrapper from '@components/compositions/Wrapper.astro';
import BlockList from '@components/compositions/BlockList.astro';

import FleetCompositionBlock from '@components/blocks/FleetCompositionBlock.astro';
// import RemoveFleetButton from '@components/blocks/RemoveFleetButton.astro';
import FleetStatus from '@components/blocks/FleetStatus.astro';
import FleetFacts from '@components/blocks/FleetFacts.astro';
import FleetMyPilots from '@components/blocks/FleetMyPilots.astro';
import SectionTabs from '@components/blocks/SectionTabs.astro';
import SectionTabPanel from '@components/blocks/SectionTabPanel.astro';
import FleetMissingSignups from '@components/blocks/FleetMissingSignups.astro';
import Markdown from '@components/blocks/Markdown.astro';
import AARLinkButton from '@components/blocks/AARLinkButton.astro';
import FleetRoles from '@components/blocks/FleetRoles.astro';
import FleetShips from '@components/blocks/FleetShips.astro';
import FleetKills from '@components/blocks/FleetKills.astro';
import FleetFights from '@components/blocks/FleetFights.astro';

// A finished fleet with no kills or losses has no Fights tab.
const show_fights = Boolean(fights && (fights.status === 'building' || fights.live || fights.rounds.length > 0))

// Pilots pick ships from the doctrine; a cancelled fleet takes no more picks.
const fleet_tabs = [
    { id: 'overview', label: t('fleets.tabs.overview') },
    ...(!history && fleet.status !== 'cancelled' && composition.length > 0 && pilots.length > 0 ? [{ id: 'your-pilots', label: t('fleets.tabs.your_pilots') }] : []),
    ...(show_fights ? [{ id: 'fights', label: t('fleets.tabs.fights') }] : []),
    ...(is_fleet_commander ? [{ id: 'fleet', label: t('fleets.tabs.fleet') }] : []),
]

const history_tabs = [
    { id: 'overview', label: t('fleets.tabs.overview') },
    ...(show_fights ? [{ id: 'fights', label: t('fleets.tabs.fights') }] : []),
]

import { query_string } from '@helpers/string'
const PICK_SHIPS_URL = `${translatePath('/partials/fleet_pick_ships_modal_component/')}?${query_string({
    fleet_id: fleet.id,
    ...(can_manage && { can_manage: true }),
})}`

const show_my_pilots = !history && fleet.status !== 'cancelled' && composition.length > 0 && pilots.length > 0

---

<BlockList
    gap="var(--space-xl)"
    x-data={`{
        tracking_started: false,
    }`}
    @tracking_started="tracking_started = true"
    @is_fleet_time="document.getElementById('preping-button')?.remove()"
>
    <Flexblock gap='var(--space-l)'>
        <FleetFacts
            fleet={fleet}
            history={history}
            corporation_id={fleet_commander_metrics?.corporation_id ?? 0}
            corporation_name={fleet_commander_metrics?.corporation_name ?? ''}
            fleet_count={fleet_commander_metrics?.fleet_count}
            members_count={fleet_metrics?.members}
        />

    </Flexblock>

    {!history &&
        <div class="[ animate-fade-in animate-duration-250 animate-delay-1000 ]">
            <FleetStatus
                fleet_id={fleet.id}
                start_time={fleet.start_time}
                fleet_tracking={fleet.tracking}
                fleet_status={fleet.status}
                is_fleet_commander={is_fleet_commander}
                fleet_tracking_texts={fleet_tracking_texts}
                disable_motd={fleet.disable_motd}
            />
        </div>
    }

    {!history && can_manage && fleet.tracking && !fleet.tracking.end_time &&
        <FleetMissingSignups fleet_id={fleet.id} />
    }

    {history &&
        <SectionTabs
            aria_label={t('fleets.tabs.label')}
            id_prefix="fleet"
            tabs={history_tabs}
        >
            <SectionTabPanel id="overview" id_prefix="fleet" is_default={true}>
                <BlockList gap="var(--space-xl)">
                    {fleet.description &&
                        <section class="[ fleet-briefing ]" aria-labelledby="fleet-briefing-title">
                            <h2 id="fleet-briefing-title">{t('fleets.briefing')}</h2>
                            <Markdown markdown={fleet.description as string} />
                        </section>
                    }

                    <Wrapper
                        class="[ animate-fade-in animate-duration-250 animate-delay-1000 ]"
                        padding_block='0'
                        padding_inline='0'
                        max_width='var(--max-col-width)'
                    >
                        <AARLinkButton
                            aarlink={fleet.aar_link ? fleet.aar_link : undefined}
                            fleet_id={fleet.id}
                            can_edit={can_remove_fleet}
                        />
                    </Wrapper>

                    {fleet.tracking &&
                        <Wrapper
                            class="[ animate-fade-in animate-duration-250 animate-delay-1000 ]"
                            padding_block='0'
                            padding_inline='0'
                            max_width='var(--max-col-width)'
                        >
                            {fleet_kills ?
                                <FleetKills fleet_kills={fleet_kills} fleet_id={fleet.id} srp_losses={srp_losses} />
                                :
                                <div
                                    id="fleet-kills"
                                    hx-get={FLEET_KILLS_PARTIAL_URL}
                                    hx-trigger="load"
                                    hx-swap="outerHTML transition:true"
                                >
                                    <p class="[ loading ]">{t('fleets.kills.loading')}</p>
                                </div>
                            }
                        </Wrapper>
                    }
                </BlockList>
            </SectionTabPanel>

            {show_fights && fights &&
                <SectionTabPanel id="fights" id_prefix="fleet">
                    <Wrapper
                        padding_block='0'
                        padding_inline='0'
                        max_width='var(--max-col-width)'
                    >
                        <FleetFights fights={fights} fleet_id={fleet.id} />
                    </Wrapper>
                </SectionTabPanel>
            }
        </SectionTabs>
    }
    
    {!history &&
        <SectionTabs
            aria_label={t('fleets.tabs.label')}
            id_prefix="fleet"
            tabs={fleet_tabs}
        >
            <SectionTabPanel id="overview" id_prefix="fleet" is_default={true}>
                <BlockList gap="var(--space-xl)">
                {fleet.description &&
                    <section class="[ fleet-briefing ]" aria-labelledby="fleet-briefing-title">
                        <h2 id="fleet-briefing-title">{t('fleets.briefing')}</h2>
                        <Markdown markdown={fleet.description as string} />
                    </section>
                }

                    {roles &&
                    <Wrapper
                        padding_block='0'
                        padding_inline='0'
                        max_width='var(--max-col-width)'
                        class="[ animate-fade-in animate-duration-250 animate-delay-1000 ]"
                    >
                        <FleetRoles
                            roles={roles}
                            composition={composition}
                            pilots={pilots}
                            fleet_id={fleet.id}
                            readonly={fleet.status === 'cancelled'}
                            is_fleet_commander={can_manage}
                        />
                    </Wrapper>
                    }

                    {(composition.length > 0 || can_manage) &&
                        <Wrapper
                            padding_block='0'
                            padding_inline='0'
                            max_width='var(--max-col-width)'
                            class="[ animate-fade-in animate-duration-250 animate-delay-1000 ]"
                        >
                            <FleetShips
                                fleet_id={fleet.id}
                                composition={composition}
                                volunteers={ship_volunteers}
                                refits={refits}
                                pilots={pilots}
                                supply={supply}
                                readonly={fleet.status === 'cancelled'}
                                can_manage={can_manage}
                                doctrine_name={fleet?.doctrine?.name ?? null}
                            />
                        </Wrapper>
                    }
                </BlockList>
            </SectionTabPanel>

            {show_my_pilots &&
                <SectionTabPanel id="your-pilots" id_prefix="fleet">
                    <Wrapper
                        padding_block='0'
                        padding_inline='0'
                        max_width='var(--max-col-width)'
                    >
                        <Flexblock gap="var(--space-l)">
                            <FleetMyPilots
                                pilots={pilots}
                                volunteers={ship_volunteers}
                            />

                            <div
                                hx-get={PICK_SHIPS_URL}
                                hx-trigger="load"
                                hx-swap="innerHTML"
                            >
                                <p class="[ loading ]">{t('fleets.tabs.loading_picker')}</p>
                            </div>
                        </Flexblock>
                    </Wrapper>
                </SectionTabPanel>
            }

            {show_fights && fights &&
                <SectionTabPanel id="fights" id_prefix="fleet">
                    <Wrapper
                        padding_block='0'
                        padding_inline='0'
                        max_width='var(--max-col-width)'
                    >
                        <FleetFights fights={fights} fleet_id={fleet.id} />
                    </Wrapper>
                </SectionTabPanel>
            }

            {is_fleet_commander &&
                <SectionTabPanel id="fleet" id_prefix="fleet">
                    <Wrapper
                        padding_block='0'
                        padding_inline='0'
                        max_width='var(--max-col-width)'
                        class="[ animate-fade-in animate-duration-250 animate-delay-1000 ]"
                        x-data={`{
                            global_collapse: $persist(false),
                        }`}
                    >
                        {fleet?.tracking &&
                            <FleetCompositionBlock
                                composition={fleet_composition ?? []}
                                fleet_radar={fleet_radar ?? []}
                                fleet_id={fleet.id}
                            />
                        }

                        {!fleet?.tracking &&
                            <p x-show="!tracking_started">{t('fleets.tabs.fleet_pending')}</p>
                        }

                        {!fleet?.tracking &&
                            <template
                                x-if="tracking_started"
                            >
                                <div
                                    x-data={`{
                                        init() {
                                            htmx.process($el)
                                        }
                                    }`}
                                    hx-get={FLEET_COMPOSITION_PARTIAL_URL}
                                    hx-trigger="load delay:30s once"
                                    hx-indicator=".loader"
                                    hx-swap="innerHTML transition:true"
                                >
                                    <p class="[ loading ]">{t('loading_fleet_composition')}</p>
                                </div>
                            </template>
                        }
                    </Wrapper>
                </SectionTabPanel>
            }
        </SectionTabs>
    }

</BlockList>
<style lang="scss">
    .fleet-briefing {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        max-width: var(--max-text-width, 70ch);
    }

    /* "Your pilots" carries the pick-ships button; one is enough. */
    :global(body:has(#fleet-my-pilots) .fleet-ships-pick) {
        display: none;
    }

</style>
