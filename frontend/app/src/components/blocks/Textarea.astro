---
interface Props {
    variant?: 'default' | 'bare';
    [propName: string]: any;
}

const {
    variant = 'default',
    ...attributes
} = Astro.props

const TextareaElement = 'textarea';
---

<TextareaElement {...attributes} data-variant={variant === 'bare' ? 'bare' : undefined}><slot /></TextareaElement>

<style lang="scss">
    textarea:not([data-variant='bare']) {
        --flex-inline--gap: var(--space-xs);

        resize: vertical;
        padding: var(--space-s) var(--space-s-m);
        border: none;
        color: var(--form-color);
        background-color: transparent;
        border: solid 1px var(--border-color);
        background-color: rgba(85, 85, 85, 0.1);
        transition: var(--fast-transition);
        width: 100%;
        backdrop-filter: blur(var(--input-backdrop-blur));

        &:hover {
            border-color: var(--border-color-hover);
        }

        &:focus-visible {
            /* Keyboard focus ring, as on links (_global.scss). */
            outline-color: var(--highlight);
            outline-style: double;
            background-color: rgba(85, 85, 85, 0.2);
        }

        &.collapsible {
            width: var(--space-l);
            padding: var(--space-s) var(--space-3xs);

            &:focus {
                width: auto;
                padding: var(--space-s) var(--space-s-l);
            }
        }
    }

    /* variant="bare": no border or padding, grows with its content; the container supplies the chrome. */
    textarea[data-variant='bare'] {
        --flex-inline--gap: var(--space-xs);

        field-sizing: content;
        resize: none;
        min-height: 20px;
        max-height: 132px;
        border: none;
        color: var(--form-color);
        background-color: transparent;
        transition: var(--fast-transition);
        width: 100%;

        &:focus-visible {
            /* Keyboard focus ring, as on links (_global.scss). */
            outline-color: var(--highlight);
            outline-style: double;
        }

        &.collapsible {
            width: var(--space-l);
            padding: var(--space-s) var(--space-3xs);

            &:focus {
                width: auto;
                padding: var(--space-s) var(--space-s-l);
            }
        }
    }
</style>