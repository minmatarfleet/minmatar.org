---
interface Props {
    show_prop:  string;
    error_prop: string;
}

const {
    show_prop,
    error_prop,
} = Astro.props
---

<div class="[ relative ]">
    <slot />
    <span
        x-show={show_prop}
        x-bind:data-tippy-content={error_prop}
    >
        ⚠️
    </span>
</div>

<style lang="scss">
    span {
        position: absolute;
        right: var(--space-s-m);
        top: 50%;
        transform: translateY(-50%);
    }
</style>