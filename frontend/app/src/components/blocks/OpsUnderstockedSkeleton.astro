---
import Grid from '@components/compositions/Grid.astro'
import Flexblock from '@components/compositions/Flexblock.astro'

interface Props {
    tiles?: number;
}

const { tiles = 6 } = Astro.props
---

<div
    class="[ ops-understocked-skeleton ]"
    aria-busy="true"
    aria-live="polite"
>
    <Grid
        min_item_width="140px"
        row_gap="var(--space-s)"
        column_gap="var(--space-s)"
    >
        {Array.from({ length: tiles }).map(() =>
            <Flexblock gap="var(--space-2xs)" class="[ ops-understocked-skeleton__tile ]">
                <div class="[ skel skel-ring ]"></div>
                <div class="[ skel skel-name ]"></div>
                <div class="[ skel skel-qty ]"></div>
            </Flexblock>
        )}
    </Grid>
</div>

<style lang="scss">
    .ops-understocked-skeleton .skel {
        border-radius: 2px;
        background: linear-gradient(
            90deg,
            color-mix(in srgb, var(--foreground) 6%, transparent) 0%,
            color-mix(in srgb, var(--foreground) 12%, transparent) 50%,
            color-mix(in srgb, var(--foreground) 6%, transparent) 100%
        );
        background-size: 200% 100%;
        animation: ops-understocked-skel-shine 1.2s linear infinite;
    }

    .ops-understocked-skeleton__tile {
        align-items: center;
        min-width: 0;
    }

    .skel-ring {
        width: 118px;
        height: 118px;
        border-radius: 50%;
        margin-inline: auto;
    }

    .skel-name {
        height: var(--space-m);
        width: 80%;
        margin-inline: auto;
    }

    .skel-qty {
        height: var(--space-s);
        width: 40%;
        margin-inline: auto;
    }

    @keyframes ops-understocked-skel-shine {
        0% { background-position: 100% 0; }
        100% { background-position: -100% 0; }
    }
</style>
