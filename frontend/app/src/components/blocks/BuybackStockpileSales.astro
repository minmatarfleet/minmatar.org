---
import { i18n } from '@helpers/i18n'
import type { BuybackLedgerEntry } from '@dtypes/api.minmatar.org'
import { aggregate_stockpile_sales } from '@helpers/buyback_stockpile_sales'

import Flexblock from '@components/compositions/Flexblock.astro'
import EmptyState from '@components/blocks/EmptyState.astro'
import DataGrid from '@components/blocks/DataGrid.astro'
import BuybackStockpileSaleItem from '@components/blocks/BuybackStockpileSaleItem.astro'

interface Props {
    ledger_entries: BuybackLedgerEntry[]
    fetch_failed?: boolean
}

const { t } = i18n(Astro.url)
const { ledger_entries, fetch_failed = false } = Astro.props

const sale_rows = aggregate_stockpile_sales(ledger_entries)

function reason_label(reason: string): string {
    if (reason === 'sold_order') return t('buyback.ledger.reason.sold_order')
    if (reason === 'sold_contract') return t('buyback.ledger.reason.sold_contract')
    return reason
}
---

<section class="[ buyback-stockpile-sales ]">
    <Flexblock gap="var(--space-s)">
        <Flexblock gap="var(--space-3xs)">
            <h2>{t('buyback.ledger.title')}</h2>
            <p class="[ buyback-stockpile-sales__lead ]">{t('buyback.ledger.lead')}</p>
        </Flexblock>

        {fetch_failed ? (
            <p class="[ buyback-stockpile-sales__error ]">{t('buyback.ledger.fetch_error')}</p>
        ) : sale_rows.length === 0 ? (
            <EmptyState title={t('buyback.ledger.empty')} />
        ) : (
            <DataGrid
                variant="ledger"
                stack={true}
                min_width="70rem"
                aria-label={t('buyback.ledger.title')}
                template="minmax(6.5rem, 0.8fr) minmax(12rem, 1.5fr) minmax(6rem, 0.8fr) minmax(7rem, 1fr) minmax(6rem, 0.8fr) minmax(7rem, 1fr)"
                columns={[
                    t('buyback.ledger.col.date'),
                    t('buyback.ledger.col.item'),
                    t('buyback.ledger.col.quantity'),
                    t('buyback.ledger.col.total'),
                    t('buyback.ledger.col.via'),
                    t('buyback.ledger.col.buyers'),
                ]}
            >
                {sale_rows.map((row) =>
                    <BuybackStockpileSaleItem
                        row={row}
                        reason_label={reason_label(row.reason)}
                    />
                )}
            </DataGrid>
        )}
    </Flexblock>
</section>

<style lang="scss">
    h2 {
        font-size: var(--step-1);
        margin: 0;
    }

    .buyback-stockpile-sales__lead {
        margin: 0;
        color: var(--faded);
        font-size: var(--step--1);
    }

    .buyback-stockpile-sales__error {
        margin: 0;
        font-size: var(--step--1);
        color: var(--highlight);
    }
</style>
