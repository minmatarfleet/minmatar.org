---
import type { BaseOptions } from "flatpickr/dist/types/options"

interface Props {
    width?:         string;
    options:        BaseOptions;
    [propName: string]: any;
}

const {
    width = '100%',
    options,
    ...attributes
} = Astro.props
---

<div class="[ input-group ]">
    <slot name="icon" />
    <input
        type="text"
        {...attributes}
        x-data={`{
            fp: null,
            init() {
                this.fp = flatpickr($el, ${JSON.stringify(options)});
            }
        }`}
    />
</div>

<style lang="scss" define:vars={{ width }}>
    input {
        max-width: var(--width);
    }
</style>

<style lang="scss">
    @use '../../styles/mixins/input_field';
    @include input_field.field;
</style>