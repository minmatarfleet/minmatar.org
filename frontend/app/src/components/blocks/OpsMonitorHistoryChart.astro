---
import { i18n } from '@helpers/i18n'
const { lang, t } = i18n(Astro.url)

import type { OpsMonitorHistoryPoint } from '@dtypes/api.minmatar.org'
import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'

interface ChartSeries {
    key: string
    label: string
    color: string
    dashed: boolean
    values: (number | null)[]
}

interface Props {
    history: OpsMonitorHistoryPoint[]
    [propName: string]: any
}

const { history, ...attributes } = Astro.props
delete attributes.class

const points = [...history].reverse()
const timestamps = points.map((point) => point.captured_at)

const include_contracts_viability = points.some(
    (point) => point.contracts_viability_pct != null,
)

const series: ChartSeries[] = [
    {
        key: 'contracts_health_pct',
        label: t('ops_history_series_contracts_coverage'),
        color: 'var(--fleet-yellow)',
        dashed: false,
        values: points.map((point) => point.contracts_health_pct),
    },
    {
        key: 'sell_orders_health_pct',
        label: t('ops_history_series_sell_coverage'),
        color: 'var(--alliance-blue)',
        dashed: false,
        values: points.map((point) => point.sell_orders_health_pct),
    },
    {
        key: 'sell_orders_viability_pct',
        label: t('ops_history_series_sell_viability'),
        color: 'var(--green)',
        dashed: false,
        values: points.map((point) => point.sell_orders_viability_pct),
    },
]

if (include_contracts_viability) {
    series.splice(1, 0, {
        key: 'contracts_viability_pct',
        label: t('ops_history_series_contracts_viability'),
        color: 'var(--fleet-yellow)',
        dashed: true,
        values: points.map((point) => point.contracts_viability_pct),
    })
}

const width = 960
const height = 260
const pad = { l: 44, r: 16, t: 16, b: 36 }
const plot_w = width - pad.l - pad.r
const plot_h = height - pad.t - pad.b
const plot_bottom = pad.t + plot_h
const y_max = 100
const y_ticks = 4

const x_pos = (index: number) => {
    if (timestamps.length <= 1)
        return pad.l + plot_w / 2
    return pad.l + (index / (timestamps.length - 1)) * plot_w
}

const y_pos = (value: number) => pad.t + plot_h - (value / y_max) * plot_h

function format_tick(iso: string): string {
    return new Date(iso).toLocaleString(lang, {
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
    })
}

function tick_indices(count: number): number[] {
    if (count <= 1)
        return count === 1 ? [0] : []
    if (count <= 4)
        return Array.from({ length: count }, (_, index) => index)
    const mid = Math.floor((count - 1) / 2)
    return [0, mid, count - 1]
}

function polyline_segments(values: (number | null)[]): string[] {
    const segments: string[] = []
    let current: string[] = []

    values.forEach((value, index) => {
        if (value == null) {
            if (current.length > 1)
                segments.push(current.join(' '))
            current = []
            return
        }
        current.push(`${x_pos(index)},${y_pos(Math.min(Math.max(value, 0), 100))}`)
    })

    if (current.length > 1)
        segments.push(current.join(' '))

    return segments
}

const x_ticks = tick_indices(timestamps.length)
const has_plottable = series.some((entry) =>
    entry.values.some((value) => value != null),
)
---

<section
    class:list={['[ ops-history-chart ]', Astro.props.class]}
    {...attributes}
>
    <Flexblock gap="var(--space-s)">
        <FlexInline justification="space-between" gap="var(--space-s)">
            <h2 class="[ ops-history-chart__title ]">{t('ops_history_chart_title')}</h2>
            {points.length > 0 &&
                <p class="[ ops-history-chart__meta ]">
                    {t('ops_history_chart_points').replace('{count}', String(points.length))}
                </p>
            }
        </FlexInline>

        {points.length === 0 || !has_plottable ?
            <p class="[ ops-history-chart__empty ]">{t('ops_history_chart_empty')}</p>
            :
            <Flexblock gap="var(--space-xs)">
                <svg
                    class="[ ops-history-chart__svg ]"
                    viewBox={`0 0 ${width} ${height}`}
                    width="100%"
                    role="img"
                    aria-label={t('ops_history_chart_aria')}
                >
                    {Array.from({ length: y_ticks + 1 }, (_, index) => {
                        const value = (y_max / y_ticks) * index
                        const y = y_pos(value)
                        return (
                            <g>
                                <line
                                    x1={pad.l}
                                    x2={width - pad.r}
                                    y1={y}
                                    y2={y}
                                    class="[ ops-history-chart__grid ]"
                                />
                                <text
                                    x={pad.l - 8}
                                    y={y + 4}
                                    text-anchor="end"
                                    class="[ ops-history-chart__axis-label ]"
                                >
                                    {value}%
                                </text>
                            </g>
                        )
                    })}
                    <line
                        x1={pad.l}
                        x2={width - pad.r}
                        y1={plot_bottom}
                        y2={plot_bottom}
                        class="[ ops-history-chart__axis-line ]"
                    />
                    {x_ticks.map((index) => (
                        <g>
                            <line
                                x1={x_pos(index)}
                                x2={x_pos(index)}
                                y1={plot_bottom}
                                y2={plot_bottom + 5}
                                class="[ ops-history-chart__tick ]"
                            />
                            <text
                                x={x_pos(index)}
                                y={height - 8}
                                text-anchor={index === 0 ? 'start' : index === timestamps.length - 1 ? 'end' : 'middle'}
                                class="[ ops-history-chart__axis-label ]"
                            >
                                {format_tick(timestamps[index])}
                            </text>
                        </g>
                    ))}
                    {series.map((entry) => (
                        <g>
                            {polyline_segments(entry.values).map((points_str) => (
                                <polyline
                                    points={points_str}
                                    fill="none"
                                    stroke={entry.color}
                                    stroke-width={entry.dashed ? 2 : 2.5}
                                    stroke-dasharray={entry.dashed ? '6 4' : undefined}
                                    stroke-linejoin="round"
                                    stroke-linecap="round"
                                />
                            ))}
                        </g>
                    ))}
                </svg>
                <FlexInline gap="var(--space-m)" class="[ ops-history-chart__legend ]">
                    {series.map((entry) => (
                        <span class="[ ops-history-chart__legend-item ]">
                            <span
                                class:list={[
                                    'ops-history-chart__swatch',
                                    { 'ops-history-chart__swatch--dashed': entry.dashed },
                                ]}
                                style={`--swatch-color: ${entry.color}`}
                                aria-hidden="true"
                            ></span>
                            {entry.label}
                        </span>
                    ))}
                </FlexInline>
            </Flexblock>
        }
    </Flexblock>
</section>

<style lang="scss">
    .ops-history-chart {
        padding: var(--space-m);
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(0, 0, 0, 0.22);
    }

    .ops-history-chart__title {
        margin: 0;
        font-size: var(--step--1);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--fleet-yellow);
    }

    .ops-history-chart__meta,
    .ops-history-chart__empty {
        margin: 0;
        color: color-mix(in srgb, var(--highlight) 70%, var(--faded));
        font-size: var(--step--1);
    }

    .ops-history-chart__svg {
        display: block;
        width: 100%;
        height: auto;
        min-width: 0;
    }

    .ops-history-chart__grid {
        stroke: color-mix(in srgb, var(--border-color) 55%, white 8%);
        stroke-width: 1;
    }

    .ops-history-chart__tick,
    .ops-history-chart__axis-line {
        stroke: color-mix(in srgb, var(--border-color) 75%, white 8%);
        stroke-width: 1;
    }

    .ops-history-chart__axis-label {
        fill: color-mix(in srgb, var(--highlight) 70%, var(--faded));
        font-size: var(--step--2);
        font-variant-numeric: tabular-nums;
    }

    .ops-history-chart__legend {
        row-gap: var(--space-2xs);
    }

    .ops-history-chart__legend-item {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3xs);
        color: color-mix(in srgb, var(--highlight) 85%, var(--faded));
        font-size: var(--step--1);
    }

    .ops-history-chart__swatch {
        display: inline-block;
        width: var(--space-m);
        height: 3px;
        background: var(--swatch-color);
    }

    .ops-history-chart__swatch--dashed {
        background: repeating-linear-gradient(
            90deg,
            var(--swatch-color) 0,
            var(--swatch-color) 6px,
            transparent 6px,
            transparent 10px
        );
    }
</style>
