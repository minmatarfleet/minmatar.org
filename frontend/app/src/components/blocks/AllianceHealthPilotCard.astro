---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type {
    AllianceHealthPilotListRow,
} from '@helpers/alliance_health_pilot_list'
import { csv_record_from_pilot, sort_value_attr } from '@helpers/alliance_health_pilot_list'

import FlexInline from '@components/compositions/FlexInline.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import FixedFluid from '@components/compositions/FixedFluid.astro'
import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import CharacterPicture from '@components/blocks/CharacterPicture.astro'
import CorporationPicture from '@components/blocks/CorporationPicture.astro'
import Tag from '@components/blocks/Tag.astro'
import Button from '@components/blocks/Button.astro'

interface Props {
    row: AllianceHealthPilotListRow
    [propName: string]: any
}

const { row, ...attributes } = Astro.props
delete attributes.class

const sorts: Record<string, string> = {
    name: row.name.toLowerCase(),
    corp: row.corp.toLowerCase(),
}
for (const metric of row.metrics) {
    sorts[metric.id] = sort_value_attr(metric.sort)
}
if (row.timezone) sorts.tz = row.timezone.toLowerCase()
---

<div
    class:list={['[ alliance-health-pilot-card ]', Astro.props.class]}
    id={row.row_id}
    data-health-card
    data-search={row.search_text}
    data-corp={row.corp}
    data-sorts={JSON.stringify(sorts)}
    data-csv={JSON.stringify(csv_record_from_pilot(row))}
    {...attributes}
>
    <ComponentBlock
        class="[ alliance-health-pilot-card__main ]"
        padding_block="var(--space-2xs)"
        padding_inline="var(--space-s)"
    >
        <FlexInline
            gap="var(--space-s)"
            justification="space-between"
            class="[ w-full alliance-health-pilot-card__row ]"
        >
            <FlexInline gap="var(--space-s)" class="[ alliance-health-pilot-card__who ]">
                {row.character_id ? (
                    <CharacterPicture
                        character_id={row.character_id}
                        character_name={row.name}
                        size={32}
                        icon_quality={64}
                    />
                ) : null}
                <Flexblock gap="var(--space-3xs)" class="[ alliance-health-pilot-card__id ]">
                    <FlexInline gap="var(--space-xs)" class="[ alliance-health-pilot-card__name ]">
                        <strong>{row.name}</strong>
                        {row.timezone ? (
                            <span class="[ alliance-health-pilot-card__tz ]">{row.timezone}</span>
                        ) : null}
                    </FlexInline>
                    {row.corporation_id ? (
                        <FixedFluid
                            width="16px"
                            gap="var(--space-3xs)"
                            class="[ alliance-health-pilot-card__corp ]"
                        >
                            <CorporationPicture
                                corporation_id={row.corporation_id}
                                corporation_name={row.corp}
                                size={16}
                                icon_quality={32}
                            />
                            <small>{row.corp}</small>
                        </FixedFluid>
                    ) : (
                        <small>{row.corp}</small>
                    )}
                    {row.metrics.length > 0 ? (
                        <div
                            class="[ alliance-health-pilot-card__metrics ]"
                            aria-label={t('alliance.health.pilot_metrics')}
                        >
                            {row.metrics.map((metric, index) => (
                                <>
                                    {index > 0 ? (
                                        <span class="[ alliance-health-pilot-card__sep ]" aria-hidden="true">·</span>
                                    ) : null}
                                    <span class="[ alliance-health-pilot-card__metric ]">
                                        <span class="[ alliance-health-pilot-card__metric-label ]">{metric.label}</span>
                                        <span
                                            class:list={[
                                                'alliance-health-pilot-card__metric-value',
                                                metric.tone && `alliance-health-pilot-card__metric-value--${metric.tone}`,
                                            ]}
                                            data-tippy-content={
                                                metric.typical
                                                    ? t('alliance.health.metric_typical').replace(
                                                          '{value}',
                                                          metric.typical,
                                                      )
                                                    : undefined
                                            }
                                            x-init={metric.typical ? 'tippy($el, tippy_options)' : undefined}
                                        >{metric.value}</span>
                                    </span>
                                </>
                            ))}
                        </div>
                    ) : null}
                    {row.tags && row.tags.length > 0 ? (
                        <FlexInline gap="var(--space-3xs)">
                            {row.tags.map((tag) => (
                                <Tag
                                    text={tag.text}
                                    color={tag.color ?? 'fleet-yellow'}
                                    narrow={true}
                                />
                            ))}
                        </FlexInline>
                    ) : null}
                    {row.note ? (
                        <p class="[ alliance-health-pilot-card__note ]">{row.note}</p>
                    ) : null}
                </Flexblock>
            </FlexInline>
            {row.action ? (
                <Button
                    size="sm"
                    narrow={true}
                    color="transparent"
                    type="button"
                    class="[ alliance-health-pilot-card__action ]"
                    data-confirm-title={row.action.confirm_title}
                    data-confirm-content={row.action.confirm_content}
                    data-post-url={row.action.post_url}
                    data-target={row.action.target}
                    data-swap={row.action.swap ?? 'delete'}
                    x-on:click.prevent="confirm_row_action($el)"
                >
                    {row.action.label}
                </Button>
            ) : null}
        </FlexInline>
    </ComponentBlock>
</div>

<style lang="scss">
    .alliance-health-pilot-card {
        display: flex;
        flex-direction: column;
    }

    .alliance-health-pilot-card__row {
        flex-wrap: nowrap;
        align-items: center;
        width: 100%;
    }

    .alliance-health-pilot-card__who {
        min-width: 0;
        flex: 1;
        flex-wrap: nowrap;
        align-items: center;
    }

    .alliance-health-pilot-card__id {
        min-width: 0;
        flex: 1;
    }

    .alliance-health-pilot-card__name {
        align-items: baseline;
        flex-wrap: wrap;
        min-width: 0;
    }

    .alliance-health-pilot-card__name strong {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .alliance-health-pilot-card__tz {
        flex-shrink: 0;
        font-family: var(--button-font);
        font-size: var(--step--2);
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--fleet-yellow);
    }

    .alliance-health-pilot-card__corp {
        align-items: center;
        min-width: 0;
    }

    .alliance-health-pilot-card__metrics {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--space-3xs) var(--space-xs);
        line-height: 1.2;
    }

    .alliance-health-pilot-card__metric {
        display: inline-flex;
        align-items: baseline;
        gap: var(--space-3xs);
        min-width: 0;
        white-space: nowrap;
    }

    .alliance-health-pilot-card__sep {
        color: var(--faded);
        font-size: var(--step--2);
        user-select: none;
    }

    .alliance-health-pilot-card__metric-label {
        font-family: var(--button-font);
        font-size: var(--step--2);
        font-weight: 400;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--faded);
    }

    .alliance-health-pilot-card__metric-value {
        font-size: var(--step--2);
        font-variant-numeric: tabular-nums;
        color: var(--highlight);
    }

    .alliance-health-pilot-card__metric-value--good {
        color: var(--green);
    }

    .alliance-health-pilot-card__metric-value--bad {
        color: var(--fleet-red);
    }

    .alliance-health-pilot-card__note {
        margin: 0;
        font-size: var(--step--2);
        color: var(--faded);
    }

    .alliance-health-pilot-card__action {
        flex-shrink: 0;
        align-self: center;
    }

    :global(button.alliance-health-pilot-card__action) {
        border-color: var(--fleet-red);
        color: var(--highlight);
    }

    small {
        color: var(--faded);
    }
</style>
