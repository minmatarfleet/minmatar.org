---
import Grid from '@components/compositions/Grid.astro'
---

<section class="[ freight-contracts-metrics-skeleton ]" aria-hidden="true">
    <Grid
        class="[ freight-contracts-metrics-skeleton__grid ]"
        min_item_width="220px"
        row_gap="var(--space-s)"
        column_gap="var(--space-s)"
    >
        {Array.from({ length: 3 }).map(() =>
            <div class="[ freight-contracts-metrics-skeleton__card ]">
                <div class="[ skel skel-label ]"></div>
                <div class="[ skel skel-value ]"></div>
                <div class="[ skel skel-meta ]"></div>
            </div>
        )}
    </Grid>
</section>

<style lang="scss">
    .freight-contracts-metrics-skeleton .skel {
        border-radius: 2px;
        background: linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.06) 0%,
            rgba(255, 255, 255, 0.12) 50%,
            rgba(255, 255, 255, 0.06) 100%
        );
        background-size: 200% 100%;
        animation: freight-contracts-metrics-skel 1.1s ease-in-out infinite;
    }

    .freight-contracts-metrics-skeleton__card {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        padding: var(--space-m);
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(0, 0, 0, 0.22);
    }

    .skel-label {
        width: 8rem;
        height: 0.75rem;
    }

    .skel-value {
        width: 5rem;
        height: clamp(2rem, 4.5vw, 3rem);
        max-width: 70%;
    }

    .skel-meta {
        width: 6rem;
        height: 0.75rem;
    }

    @keyframes freight-contracts-metrics-skel {
        0% {
            background-position: 100% 0;
        }
        100% {
            background-position: -100% 0;
        }
    }
</style>
