---
import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

import type { ButtonColors, ButtonSizes } from '@dtypes/layout_components';

interface Props {
    fitting_id: number;
    /** Names the URL (`/ships/fittings/normal/<id>-<name>/`); without it the page redirects there. */
    fitting_name?: string | null;
    is_button?: boolean;
    size?:      ButtonSizes;
    color?:     ButtonColors;
    narrow?:    boolean;
    [propName: string]: any;
}

const {
    fitting_id,
    fitting_name,
    is_button = false,
    size = 'sm',
    color = 'fleet-red',
    narrow = true,
    ...attributes
} = Astro.props

const DOM_ELEMENT = is_button ? Button : 'a'

import { fitting_path, fitting_render_path } from '@helpers/ship_paths'

const render_view = translatePath(fitting_render_path(fitting_id, fitting_name))
const normal_view = translatePath(fitting_path(fitting_id, fitting_name))

import { is_disabled_ccpwgl } from '@helpers/env';

const DISABLED_CCPWGL = is_disabled_ccpwgl()

import Button from '@components/blocks/Button.astro';
---

<DOM_ELEMENT
    href={normal_view}
    size={is_button ? size : undefined}
    color={is_button ? color : undefined}
    narrow={is_button ? narrow : undefined}
    x-bind:href={DISABLED_CCPWGL ? 'link' : undefined}
    x-data={DISABLED_CCPWGL ? `{
        // Read Alpine Persist's key without $persist — soft nav can init
        // before the persist plugin registers (MINMATAR-FRONTEND-EN / EP).
        render_enabled: (() => {
            try {
                const raw = localStorage.getItem('_x_render_enabled')
                return raw === null ? true : JSON.parse(raw)
            } catch (e) {
                return true
            }
        })(),
        link: '${render_view}',
        init() {
            if (window.innerWidth > 1820 && this.render_enabled === true)
                this.link = '${render_view}'
            else
                this.link = '${normal_view}'
        }
    }` : undefined}
    {...attributes}
>
    <slot />
</DOM_ELEMENT>