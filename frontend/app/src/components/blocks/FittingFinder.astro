---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

// Results load from a partial as the pilot types: every page renders this
// finder, and inlining the fitting library made each page ~640 KB heavier.
const FITTINGS_FINDER_LIST_PARTIAL_URL = translatePath('/partials/fittings_finder_list_component')

interface Props {
    [propName: string]: any;

}

import Flexblock from '@components/compositions/Flexblock.astro';
import FlexInline from '@components/compositions/FlexInline.astro';

import Dialog from '@components/blocks/Dialog.astro';
import Kbd from '@components/blocks/Kbd.astro';
import Input from '@components/blocks/Input.astro';

import MagnifierIcon from '@components/icons/buttons/MagnifierIcon.astro';
---

<div
    class="[ fittings-finder ]"    
    x-data={`{
        fittings_finder_open: false,
        search: '',
        async ctrl_shift_g(e) {
            if (e.ctrlKey && e.shiftKey && e.code === 'KeyG') {
                e.preventDefault()
                show_fittings_finder()
            }
        },
        init() {
            document.addEventListener('keydown', this.ctrl_shift_g, false);
        }
    }`}
>
    <Dialog
        breakout={true}
        non_centered={true}
        class="[ w-full ]"
        x-data={`{
            close_dialog() {
                if (!fittings_finder_open)
                    return

                search = ''

                var clickEvent = new MouseEvent("click", {
                    "view": window,
                    "bubbles": true,
                    "cancelable": false
                });

                document.querySelector('.fittings-finder-backdrop').dispatchEvent(clickEvent);
            }
        }`}
        @keyup.escape.window="close_dialog()"
        x-bind:class="(fittings_finder_open ? 'open' : '')"
        x-bind:aria-hidden="fittings_finder_open == false"
        thin={true}
        x-trap="fittings_finder_open"
        x-bind:inert="!fittings_finder_open"
        style="--dialog-max-width: 500px"
        close_button={false}
    >
        <Flexblock gap="0">
            <Input
                placeholder={t('find_fitting_placeholder')}
                autocomplete="off"
                name="search"
                x-model="search"
                hx-get={FITTINGS_FINDER_LIST_PARTIAL_URL}
                hx-trigger="keyup changed delay:0.2s"
                hx-target="#fittings-finder-list"
                hx-sync="this:replace"
                hx-indicator=".loader"
                class="[ relative z-10 ]"
            >
                <MagnifierIcon slot="icon" />
            </Input>

            <div class="[ relative ]">
                <Flexblock gap='var(--space-3xs)'>
                    <div
                        id="fittings-finder-list"
                        class="[ fitting-finder-list ][ light-transparency w-full ]"
                        x-show="(search !== '')"
                    />

                    <FlexInline justification='center'>
                        <FlexInline gap="var(--space-3xs)">
                            <span class="[ text-[var(--highlight)] ]">(</span>
                            <Kbd>Shift</Kbd>
                            <span class="[ text-[var(--highlight)] ]">+</span>
                            <span class="[ text-[var(--highlight)] ]">)</span>
                            <Kbd>Tab</Kbd>
                            <small>to navigate</small>
                        </FlexInline>
                        <FlexInline gap="var(--space-3xs)">
                            <Kbd>Enter</Kbd>
                            <small>to select</small>
                        </FlexInline>
                        <FlexInline gap="var(--space-3xs)">
                            <Kbd>Esc</Kbd>
                            <small>to close</small>
                        </FlexInline>
                    </FlexInline>
                </Flexblock>
            </div>
        </Flexblock>
    </Dialog>

    <div
        class="fittings-finder-backdrop"
        x-bind:class="(fittings_finder_open ? 'open' : '')"
        fitting-finder-action="close"
        x-on:click="(filter = '')"
    />
</div>

<style lang="scss">
    :global([fitting-finder-action] *) {
        pointer-events: none !important;
    }

    :global(.fitting-finder-list [style="display: none;"] ~ button) {
        margin-block-start: 0 !important;
    }

    :global(.fitting-finder-list :not([style="display: none;"]) ~ button) {
        margin-block-start: var(--space-3xs) !important;
    }

    .dialog {
        top: 12%;
    }
    
    .fitting-finder-list {
        overflow-y: auto;
        max-height: 320px;
        background-color: #171616;
        border: solid 1px var(--border-color);
        border-top: none;
        height: calc(100% - 20px);
    }

    [fitting-finder-action="close"] {
        position: fixed;
        inset: 0;
        z-index: var(--backdrop-z-index);
        display: none;

        &.open {
            display: block;
        }
    }

    /* Results are swapped in from a partial, so these can't be scoped. */
    :global(.fittings-finder [fitting-finder-action="accept"]) {
        background-color: transparent;
        cursor: pointer;
        border: none;
        padding: 0;
    }

    :global(.fittings-finder [fitting-finder-action="accept"]:focus-within) {
        outline: none;
        background-color: var(--component-background);
    }

    :global(.fittings-finder [fitting-finder-action="accept"]:hover) {
        background-color: var(--component-background);
    }
</style>