---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { MarketOperatorStatistics } from '@dtypes/api.minmatar.org'

interface Props {
    market_operators:     MarketOperatorStatistics[];
}

const {
    market_operators,
} = Astro.props

const MARKET_TRIBE_GROUP_PATH = '/alliance/tribes/2/10'

import Wrapper from '@components/compositions/Wrapper.astro';
import FixedFluid from '@components/compositions/FixedFluid.astro';
import FlexInlineSiblings from '@components/compositions/FlexInlineSiblings.astro';
import FlexInline from '@components/compositions/FlexInline.astro';

import Marquee from '@components/blocks/Marquee.astro';
import MarketOperatorBadge from '@components/blocks/MarketOperatorBadge.astro';
import Button from '@components/blocks/Button.astro';
import TextBadge from '@components/blocks/TextBadge.astro';
---

<div
    class="[ bottom-bar ][ card component light-transparency hidden! animate-slide-in-bottom ]"
    x-on:marquee-started="$el.classList.add('lg:block!')"
>
    <Wrapper
        class="[ market-operators-reel ]"
        neocom={true}
        max_width='var(--max-content-width)'
        centered={true}
        padding_block='var(--space-2xs)'
    >
        <FixedFluid width='170px' class="[ items-center! ]">
            <TextBadge title={t('market_operator_ranking')}>
                <small>{t('currently_on_market')}</small>
            </TextBadge>
            
            <FlexInlineSiblings
                min-shink-width='250px'
                shrinkable-sibbling='first'
            >
                {market_operators.length >= 4 ?
                    <Marquee>
                        {market_operators.map((operator, index) =>
                            <MarketOperatorBadge place={index + 1} operator={operator} />
                        )}
                    </Marquee> :
                    <FlexInline gap='var(--space-l)' x-init="$dispatch('marquee-started')">
                        {market_operators.map((operator, index) =>
                            <MarketOperatorBadge place={index + 1} operator={operator} />
                        )}
                    </FlexInline>
                }

                <Button
                    href={translatePath(MARKET_TRIBE_GROUP_PATH)}
                    size='sm'
                >
                    {t('join_market')}
                </Button>
            </FlexInlineSiblings>
        </FixedFluid>
    </Wrapper>
</div>

<style lang="scss">
    .bottom-bar {
        position: fixed;
        left: 0;
        bottom: 0;
        width: 100%;
        z-index: var(--sticky-z-index);
    }

    .market-operators-reel {
        position: relative;
    }
</style>
