---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { CorporationObject } from '@dtypes/layout_components'

import { query_string } from '@helpers/string';

interface Props {
    corporation:            CorporationObject;
    picture_placement?:     'left' | 'right';
    
}

const {
    corporation,
    picture_placement = 'left',
} = Astro.props

const WARLOCK_INDUSTRIES_ID = 2123136158
const CRACKERC_ID = 909008587

import { marked } from 'marked';
import { renderer } from '@helpers/marked';

import Flexblock from '@components/compositions/Flexblock.astro';

import CorporationSlide from '@components/blocks/CorporationSlide.astro';
import StylessButton from '@components/blocks/StylessButton.astro';
---

<CorporationSlide
    id="soltech-slide"
    ceo_image='/images/corporations/wandw/ceo.webp'
    ceo_character_id={WARLOCK_INDUSTRIES_ID}
    corporation={corporation}
    picture_placement='left'
    mirror_slide={picture_placement === 'right'}
>
    <StylessButton
        class="[ co-ceo ]"
        slot="coceo"
        x-data={`{
            show_character_modal() {
                show_modal({
                    partial: '${translatePath('/partials/character_modal_component/')}?${query_string({
                        character_id: CRACKERC_ID.toString(),
                    })}',
                })
            }
        }`}
        x-on:click="show_character_modal()"
    >
        <img src="/images/corporations/wandw/co-ceo.webp" />
    </StylessButton>
    
    <img slot="ships" class="[ avatar ]" src="/images/corporations/wandw/avatar.webp" />
    <img slot="ships" class="[ sarathiel ]" src="/images/corporations/wandw/sarathiel.webp" />
    <img slot="ships" class="[ moros ]" src="/images/corporations/wandw/moros.webp" />

    <Flexblock set:html={marked.parse(corporation.introduction ? corporation.introduction : t('soltech_armada_description_fallback'), { renderer })} />
</CorporationSlide>

<style lang="scss">
    .co-ceo {
        z-index: 11;
        position: absolute;
        cursor: pointer;
        transform: scale(0.5);
        opacity: 0;
        height: 99%;
        left: 5%;
        top: 0;
        filter: drop-shadow(0px 0px 0 black) drop-shadow(0px 0px 0 black) drop-shadow(0px 0px 0 black);

        img {
            mask-image: linear-gradient(to bottom, black 70%, transparent 95%);
            width: auto;
            height: 100%;
        }

        &:focus-visible {
            outline: none;
        }

        &:focus-visible,
        &:hover {
            img {
                filter: drop-shadow(0px 0px 3px var(--glow));
            }
        }
    }

    .avatar {
        position: absolute;
        top: 14%;
        left: -39%;
        height: auto;
        width: 57%;
        z-index: 0;
        transform: scale(0);
    }

    .sarathiel {
        position: absolute;
        top: 41%;
        left: -20%;
        width: 34%;
        height: auto;
        z-index: 2;
        transform: scale(0);
    }

    .moros {
        position: absolute;
        top: 39%;
        left: -12%;
        width: 48%;
        height: auto;
        z-index: 1;
        transform: scale(0);
    }

    @keyframes avatar {
        0% {
            transform: scale(0);
            top: 36%;
            left: -23%;
        }

        30% {
            transform: scale(1);
            top: 4%;
            left: 46%;
        }

        100% {
            transform: scale(1.03);
            top: 1%;
            left: 49%;
        }
    }

    @keyframes sarathiel {
        0% {
            transform: scale(0);
            top: 9%;
            left: -20%;
        }

        33% {
            transform: scale(1);
            top: 10%;
            left: 55%;
        }

        100% {
            transform: scale(1.04);
            top: 9%;
            left: 58%;
        }
    }

    @keyframes moros {
        0% {
            transform: scale(0);
            left: -10%;
            top: 20%;
        }

        36% {
            transform: scale(1);
            top: 50%;
            left: 51%;
        }

        100% {
            transform: scale(1.03);
            top: 52%;
            left: 53%;
        }
    }

    @keyframes coceo {
        0% {
            transform: scale(0.9);
            opacity: 0;
        }

        20% {
            opacity: 1;
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>

<style lang="scss" is:global>
    #soltech-slide .ceo {
        left: -10%;
    }

    .swiper-slide-active {
        .avatar {
            animation: avatar cubic-bezier(0.390, 0.575, 0.565, 1.000) both 2.7s;
            animation-delay: 1.2s;
            animation-iteration-count: 1;
            transform-origin: center;
            animation-fill-mode: forwards;
        }
        
        .sarathiel {
            animation: sarathiel cubic-bezier(0.390, 0.575, 0.565, 1.000) both 2.6s;
            animation-delay: 1.3s;
            animation-iteration-count: 1;
            transform-origin: center;
            animation-fill-mode: forwards;
        }
        
        .moros {
            animation: moros cubic-bezier(0.390, 0.575, 0.565, 1.000) both 2.5s;
            animation-delay: 1.4s;
            animation-iteration-count: 1;
            transform-origin: center;
            animation-fill-mode: forwards;
        }

        #soltech-slide .co-ceo {
            animation: coceo ease-out 3.2s;
            animation-delay: 0.25s;
            animation-iteration-count: 1;
            transform-origin: bottom;
            animation-fill-mode: forwards;
        }
    }
</style>