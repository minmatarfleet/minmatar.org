---
import { i18n } from '@helpers/i18n'
const { lang, t, translatePath } = i18n(Astro.url)

import type { CampaignListItem } from '@dtypes/api.minmatar.org'
import type { TagColors } from '@dtypes/layout_components'
import { format_date_short } from '@helpers/date'
import { number_thousand_separator, number_name } from '@helpers/numbers'

interface Props {
    campaign:           CampaignListItem;
    index?:             number;
    [propName: string]: any;
}

const {
    campaign,
    ...attributes
} = Astro.props

delete attributes.class
delete attributes.index

const is_upcoming = campaign.status === 'scheduled' || campaign.status === 'draft'
const is_strategic = campaign.kind === 'strategic'
const href = translatePath(`/campaigns/${campaign.slug}/`)
const cover = campaign.cover_image_url || (
    is_strategic ? '/images/home-auga-cover.jpg' : '/images/warzone-card.jpg'
)

const start_label = format_date_short(lang, campaign.start_at)
const end_label = format_date_short(lang, campaign.end_at)
const period = is_upcoming
    ? `${t('campaigns.starts_in')} ${start_label}`
    : `${start_label} – ${end_label}`

const kind_label = t(`campaigns.kind.${campaign.kind}` as any)
const kind_color: TagColors = is_strategic ? 'fleet-red' : 'alliance-blue'
const isk_label = t('destroyed')
const opponent_names = (campaign.opponents ?? [])
    .map(opponent => {
        const ticker = (opponent.ticker || '').trim()
        if (ticker && /^[A-Za-z0-9._-]{2,6}$/.test(ticker))
            return ticker
        return opponent.name
    })
    .filter(Boolean)
    .slice(0, 3)
const opponents_label = opponent_names.length
    ? `${t('campaigns.opponents.label')} ${opponent_names.join(', ')}`
    : ''

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import PictureCard from '@components/blocks/PictureCard.astro'
import Button from '@components/blocks/Button.astro'
import Tag from '@components/blocks/Tag.astro'
---

<PictureCard
    class:list={['[ campaign-post-card ]', Astro.props.class]}
    src={cover}
    alt={campaign.name}
    narrow={true}
    thumbnail={true}
    {...attributes}
>
    <FlexInline slot="header" gap='var(--space-3xs)' class="[ items-center ]">
        <Tag text={kind_label} color={kind_color} />
        {campaign.is_enlisted && <Tag text={t('campaigns.enlisted_already')} color='green' />}
    </FlexInline>

    <Flexblock gap='var(--space-2xs)'>
        <small>{period}</small>
        <a href={href}>
            <h3>{campaign.name}</h3>
        </a>
        {campaign.tagline &&
            <p class="[ campaign-card-tagline ]">{campaign.tagline}</p>
        }
        {opponents_label &&
            <small class="[ campaign-card-opponents ]">{opponents_label}</small>
        }
        <Flexblock gap='0'>
            <small>{isk_label}</small>
            <p
                class="[ isk-stat ]"
                data-tippy-content={number_name(campaign.isk_destroyed, lang)}
            >
                {number_thousand_separator(campaign.isk_destroyed)}&nbsp;ISK
            </p>
        </Flexblock>
        <FlexInline>
            <Button href={href} size='sm'>
                {t('campaigns.view_campaign')}
            </Button>
        </FlexInline>
    </Flexblock>
</PictureCard>

<style lang="scss">
    h3 {
        font-size: var(--step-1);
        font-family: var(--heading-font);
        line-height: 1.15;
    }

    .campaign-card-tagline {
        margin: 0;
        font-size: var(--step--1);
        line-height: 1.35;
        color: var(--foreground);
    }

    .campaign-card-opponents {
        color: var(--fleet-red);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        font-size: var(--step--2);
    }

    .isk-stat {
        font-size: var(--step-0);
        font-weight: 600;
        color: var(--highlight);
        margin: 0;
    }

    :global(.campaign-post-card) {
        position: relative;

        &::after {
            content: '';
            position: absolute;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            background: linear-gradient(
                to top,
                rgb(0 0 0 / 88%) 0%,
                rgb(0 0 0 / 55%) 42%,
                rgb(0 0 0 / 25%) 68%,
                rgb(0 0 0 / 12%) 100%
            );
        }

        :global(.card-body),
        :global(.card-header),
        :global(.card-actions),
        :global(.visible-actions) {
            z-index: 2;
        }
    }
</style>
