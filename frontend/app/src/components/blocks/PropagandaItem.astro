---
import type { PostListUI } from '@dtypes/layout_components'

interface Props {
    posts:      PostListUI[];
    small?:     boolean;
    swiper_id?: string;
    is_video?:  boolean;
    editor_id?: number;
    is_editing: boolean;
    has_cover?: boolean;
}

const {
    posts,
    small = false,
    swiper_id = 'posters-reel-swiper',
    is_video = false,
    editor_id,
    is_editing,
    has_cover = false,
} = Astro.props

import Wrapper from '@components/compositions/Wrapper.astro';

import LandingSwiper from '@components/blocks/LandingSwiper.astro';
import PropagandaPostCardOrg from '@components/blocks/PropagandaPostCardOrg.astro';
import PropagandaVideoPost from '@components/blocks/PropagandaVideoPost.astro';
---

{posts.map(post =>
    <>{!is_video ?
        <PropagandaPostCardOrg
            post={post}
            editor_id={editor_id}
            is_editing={is_editing}
        /> :
        <PropagandaVideoPost
            post={post}
            editor_id={editor_id}
            is_editing={is_editing}
        />
    }</>
)}

<style lang="scss">
    :global([data-desature="full"] img) {
        filter: saturate(0%);
    }

    :global([data-desature="mild"] img) {
        filter: saturate(35%);
    }

    :global(.medium-zoom-image--opened) {
        z-index: var(--dialog-z-index);
    }
    
    :global(.medium-zoom-overlay) {
        z-index: var(--backdrop-z-index);
    }
</style>
