---
interface Props {
    show_history_cta?: boolean;
    show_metrics?: boolean;
}

const {
    show_history_cta = true,
    show_metrics = true,
} = Astro.props

import Flexblock from '@components/compositions/Flexblock.astro'
---

<div
    class="[ buyback-contracts-skeleton ]"
    aria-busy="true"
    aria-live="polite"
>
    <Flexblock gap="var(--space-l)">
        {show_metrics &&
            <div class="[ buyback-contracts-skeleton__metrics ]">
                {Array.from({ length: 3 }).map(() =>
                    <div class="[ skel skel-metric ]"></div>
                )}
            </div>
        }

        <div class="[ buyback-contracts-skeleton__header ]">
            {Array.from({ length: 8 }).map(() =>
                <div class="[ skel skel-col ]"></div>
            )}
        </div>

        <Flexblock gap="var(--space-2xs)">
            {Array.from({ length: 8 }).map(() =>
                <div class="[ buyback-contracts-skeleton__row ]">
                    <div class="[ skel skel-line ]" style="width: 5.5rem"></div>
                    <div class="[ skel skel-line ]" style="width: 9rem"></div>
                    <div class="[ skel skel-line ]" style="width: 5rem"></div>
                    <div class="[ skel skel-line ]" style="width: 6rem"></div>
                    <div class="[ skel skel-line ]" style="width: 5rem"></div>
                    <div class="[ skel skel-line ]" style="width: 6rem"></div>
                    <div class="[ skel skel-line ]" style="width: 4rem"></div>
                    <div class="[ skel skel-line ]" style="width: 6.5rem"></div>
                </div>
            )}
        </Flexblock>

        {show_history_cta &&
            <div class="[ skel skel-cta ]"></div>
        }
    </Flexblock>
</div>

<style lang="scss">
    .buyback-contracts-skeleton .skel {
        border-radius: 2px;
        background: linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.06) 0%,
            rgba(255, 255, 255, 0.12) 50%,
            rgba(255, 255, 255, 0.06) 100%
        );
        background-size: 200% 100%;
        animation: buyback-contracts-skel 1.1s ease-in-out infinite;
    }

    .buyback-contracts-skeleton__metrics {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: var(--space-s);
    }

    .skel-metric {
        height: 6rem;
    }

    .buyback-contracts-skeleton__header,
    .buyback-contracts-skeleton__row {
        display: grid;
        grid-template-columns: minmax(6.5rem, 0.8fr) minmax(10rem, 1.4fr) minmax(7rem, 0.9fr) minmax(7rem, 0.9fr) minmax(6rem, 0.8fr) minmax(7rem, 1fr) minmax(6rem, 0.9fr) minmax(7rem, 1fr);
        gap: var(--space-s);
        padding-block: var(--space-2xs);
        min-width: 70rem;
    }

    .skel-col {
        height: 0.85rem;
        width: 70%;
    }

    .skel-line {
        height: 0.85rem;
        max-width: 100%;
    }

    .skel-cta {
        width: min(24rem, 100%);
        height: 2rem;
        margin-inline: auto;
        margin-block-start: var(--space-s);
    }

    @keyframes buyback-contracts-skel {
        0% { background-position: 100% 0; }
        100% { background-position: -100% 0; }
    }
</style>
