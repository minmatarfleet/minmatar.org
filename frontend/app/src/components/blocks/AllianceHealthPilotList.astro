---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type {
    AllianceHealthOrderDir,
    AllianceHealthOrderKind,
    AllianceHealthOrderOption,
    AllianceHealthPilotListRow,
} from '@helpers/alliance_health_pilot_list'
import { apply_list_metric_tones, csv_headers_from_pilot, default_health_order_dir } from '@helpers/alliance_health_pilot_list'
import {
    read_alliance_health_list_state,
    type AllianceHealthUrlSection,
} from '@helpers/alliance_health_url'

import FlexInline from '@components/compositions/FlexInline.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import Input from '@components/blocks/Input.astro'
import Select from '@components/blocks/Select.astro'
import Button from '@components/blocks/Button.astro'
import AllianceHealthPilotCard from '@components/blocks/AllianceHealthPilotCard.astro'

interface Props {
    rows: AllianceHealthPilotListRow[]
    empty_label: string
    order_by_options: AllianceHealthOrderOption[]
    default_order_by?: string
    enable_corp_filter?: boolean
    initial_corp?: string
    page_size?: number
    csv_filename?: string
    url_section?: AllianceHealthUrlSection
    [propName: string]: any
}

const {
    rows,
    empty_label,
    order_by_options,
    default_order_by,
    enable_corp_filter = true,
    initial_corp = 'all',
    page_size = 5,
    csv_filename = 'alliance-health.csv',
    url_section,
    ...attributes
} = Astro.props
delete attributes.class

const corps = Array.from(
    new Set(rows.map((row) => row.corp).filter((name): name is string => !!name && name !== '—')),
).sort((a, b) => a.localeCompare(b))

const initial = corps.includes(initial_corp) ? initial_corp : 'all'

const chips: AllianceHealthOrderOption[] = [
    { id: 'name', label: t('alliance.health.order.name'), kind: 'text' },
    ...order_by_options.filter((opt) => opt.id !== 'name'),
]

const default_by = default_order_by && chips.some((chip) => chip.id === default_order_by)
    ? default_order_by
    : chips[0]?.id ?? 'name'
const default_dir: AllianceHealthOrderDir = default_health_order_dir(
    chips.find((chip) => chip.id === default_by)?.kind ?? 'text',
)

const page_query =
    url_section && !Astro.url.pathname.includes('/partials/')
        ? read_alliance_health_list_state(Astro.url.searchParams, url_section, {
            corp: initial,
            by: default_by,
            dir: default_dir,
            page: 1,
        })
        : null

const order_by =
    page_query?.by && chips.some((chip) => chip.id === page_query.by)
        ? page_query.by
        : default_by
const order_dir: AllianceHealthOrderDir = page_query?.dir ?? default_dir
const initial_search = page_query?.q ?? ''
const initial_page = page_query?.page ?? 1
const list_corp =
    page_query?.corp && (page_query.corp === 'all' || corps.includes(page_query.corp))
        ? page_query.corp
        : initial

const order_kinds: Record<string, AllianceHealthOrderKind> = Object.fromEntries(
    chips.map((chip) => [chip.id, chip.kind]),
)
const colored_rows = apply_list_metric_tones(rows)
const csv_headers = csv_headers_from_pilot(colored_rows[0], {
    pilot: t('alliance.health.col.pilot'),
    corp: t('alliance.health.col.corp'),
    tz: t('alliance.health.col.tz'),
    note: t('alliance.health.col.reason'),
})
---

<div
    class:list={['[ alliance-health-pilot-list ]', Astro.props.class]}
    {...attributes}
    x-data={`allianceHealthList(${JSON.stringify({
        search: initial_search,
        corp: list_corp,
        page: initial_page,
        page_size,
        match_count: rows.length,
        total_pages: 1,
        order_by,
        order_dir,
        order_kinds,
        csv_headers,
        csv_filename,
        url_section: url_section ?? '',
        url_defaults: {
            corp: 'all',
            by: default_by,
            dir: default_dir,
            page: 1,
        },
        row_selector: '[data-health-card]',
        sort: true,
    })})`}
>
    <Flexblock gap="var(--space-s)">
        <FlexInline
            gap="var(--space-xs)"
            justification="space-between"
            class="[ alliance-health-pilot-list__tools ]"
        >
            {enable_corp_filter && (
                <Select size="sm" width="18rem" x-model="corp">
                    <option value="all" selected={list_corp === 'all'}>
                        {t('alliance.health.filter.all_corps')}
                    </option>
                    {corps.map((name) => (
                        <option value={name} selected={name === list_corp}>{name}</option>
                    ))}
                </Select>
            )}
            <Input
                type="search"
                size="sm"
                placeholder={t('alliance.health.search_placeholder')}
                x-model="search"
                value={initial_search}
                autocomplete="off"
            />
            <Button
                size="sm"
                color="transparent"
                type="button"
                x-on:click="download_csv()"
                x-bind:disabled="match_count === 0"
                data-tippy-content={t('alliance.health.download_csv_tip')}
            >
                {t('alliance.health.download_csv')}
            </Button>
        </FlexInline>

        {chips.length > 0 && (
            <div class="[ alliance-health-pilot-list__order ]">
                <span class="[ alliance-health-pilot-list__order-label ]">{t('alliance.health.order_by')}</span>
                <div class="[ alliance-health-pilot-list__chips ]">
                    {chips.map((opt) => (
                        <button
                            type="button"
                            class="[ alliance-health-pilot-list__chip ]"
                            x-bind:class={`order_by === '${opt.id}' && 'is-active'`}
                            x-on:click={`setOrderBy('${opt.id}')`}
                        >{opt.label}<span x-text={`order_by === '${opt.id}' ? (order_dir === 'asc' ? ' ↑' : ' ↓') : ''`}></span></button>
                    ))}
                </div>
            </div>
        )}

        <div
            class="[ alliance-health-pilot-list__body ]"
            x-ref="body"
            x-init="$nextTick(() => refresh())"
        >
            {colored_rows.map((row) => (
                <AllianceHealthPilotCard row={row} />
            ))}
        </div>

        {rows.length === 0 ? (
            <p class="[ alliance-health-pilot-list__empty ]">{empty_label}</p>
        ) : (
            <FlexInline gap="var(--space-xs)" class="[ alliance-health-pilot-list__pager ]">
                <small>
                    {t('alliance.health.showing')}
                    <span x-text="match_count"></span>
                </small>
                <Button size="sm" color="transparent" x-on:click="prev()" x-bind:disabled="page <= 1">
                    {t('alliance.health.prev')}
                </Button>
                <small>
                    {t('alliance.health.page')}
                    <span x-text="page"></span>
                    /
                    <span x-text="total_pages"></span>
                </small>
                <Button size="sm" color="transparent" x-on:click="next()" x-bind:disabled="page >= total_pages">
                    {t('alliance.health.next')}
                </Button>
            </FlexInline>
        )}
    </Flexblock>
</div>

<style lang="scss">
    .alliance-health-pilot-list__tools {
        align-items: center;
        width: 100%;
        flex-wrap: wrap;
    }

    .alliance-health-pilot-list__tools :global(.input-group) {
        flex: 1 1 16rem;
        min-width: 12rem;
        max-width: none;
        width: auto;
    }

    .alliance-health-pilot-list__order {
        display: grid;
        grid-template-columns: auto 1fr;
        align-items: baseline;
        gap: var(--space-2xs) var(--space-s);
    }

    .alliance-health-pilot-list__order-label {
        font-family: var(--heading-font);
        font-size: var(--step--1);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--fleet-yellow);
    }

    .alliance-health-pilot-list__chips {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3xs);
    }

    .alliance-health-pilot-list__chip {
        appearance: none;
        margin: 0;
        padding: var(--space-3xs) var(--space-xs);
        border: 1px solid color-mix(in srgb, var(--fleet-yellow) 40%, transparent);
        background: transparent;
        color: var(--fleet-yellow);
        font-family: var(--button-font);
        font-size: var(--step--2);
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        cursor: pointer;
        transition: var(--fast-transition);

        @media (hover: hover) {
            &:hover {
                border-color: var(--fleet-yellow);
                background: color-mix(in srgb, var(--fleet-yellow) 12%, transparent);
            }
        }

        &.is-active {
            border-color: var(--fleet-yellow);
            background: var(--fleet-yellow);
            color: var(--background);
        }
    }

    .alliance-health-pilot-list__body {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
    }

    .alliance-health-pilot-list__body :global(.alliance-health-pilot-card.is-hidden),
    .alliance-health-pilot-list__body :global(.alliance-health-pilot-card[hidden]) {
        display: none !important;
    }

    .alliance-health-pilot-list__empty,
    .alliance-health-pilot-list__pager {
        color: var(--faded);
        font-size: var(--step--1);
    }

    .alliance-health-pilot-list__pager {
        justify-content: flex-end;
    }

    @media (max-width: 540px) {
        .alliance-health-pilot-list__order {
            grid-template-columns: 1fr;
        }

        .alliance-health-pilot-list__tools {
            flex-wrap: wrap;
        }
    }
</style>
