---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { ButtonSizes } from '@dtypes/layout_components';

import Button from '@components/blocks/Button.astro';
import ClipboardIcon from '@components/icons/buttons/ClipboardIcon.astro';

interface Props {
    id:                 string;
    alert_prefix?:      string;
    narrow?:            boolean;
    size?:              ButtonSizes;
    text?:              string;
    copied_text?:       string;
    iconed?:            boolean;
    x_value?:           string;
    source?:            string;
    [propName: string]: any;
}

const {
    id,
    alert_prefix,
    narrow = false,
    size = 'sm',
    text = t('copy'),
    copied_text = t('copied'),
    iconed = true,
    x_value,
    source,
    ...attributes
} = Astro.props

const COPIED_LABEL_TIME_MS = 2000

// `source` tags the copy for analytics (fitting_copied). Untagged buttons keep
// the exact call they always had.
const copy_args = [`'${id}'`]
if (alert_prefix || source) copy_args.push(alert_prefix ? `'${alert_prefix}'` : 'null')
if (source) copy_args.push(`'${source}'`)

const Textarea = 'textarea';
---

<Button
    narrow={narrow}
    x-on:click.stop.prevent={`copyFitToClipboard(${copy_args.join(', ')})`}
    size={size}
    {...attributes}
    x-data={`{
        button_text: '${text}',
    }`}
    x-on:click.throttle.750ms={`button_text = '${copied_text}'; setTimeout(() => button_text = '${text}', ${COPIED_LABEL_TIME_MS})`}
>
    {iconed && <ClipboardIcon slot="icon" />}
    <span x-text="button_text">{text}</span>
</Button>

<Textarea class="[ hidden ]" id={id} readonly x-text={x_value ? x_value : undefined}><slot /></Textarea>