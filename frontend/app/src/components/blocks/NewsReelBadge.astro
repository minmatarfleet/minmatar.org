---
import { i18n } from '@helpers/i18n'
const { lang, translatePath } = i18n(Astro.url)

import type { PostListUI } from '@dtypes/layout_components'

interface Props {
    post:      PostListUI;
}

const {
    post,
} = Astro.props

const MEDIA_ICON: Record<string, string> = {
    'Metropolis': '/images/icons/Metropilis.png',
    'Frontlines': '/images/icons/Frontlines.png',
    'Metro Daily News': '/images/icons/Metro-Daily-News.png',
    'The Cope': '/images/icons/The-Cope.png',
    'Rust and Blood': '/images/icons/Rust-and-Blood.png',
    'Waifu Wars': '/images/icons/Waifu-Wars.png',
}

const SERIES_LABEL: Record<string, string> = {
    'Metropolis': 'Metropolis Daily News',
    'Frontlines': 'Frontlines',
    'Propaganda': 'Propaganda Poster',
    'Metro Daily News': 'Metro Daily News',
    'The Cope': 'The COPE',
    'Videos': 'Videos',
    'Rust and Blood': 'Rust and Blood',
    'Waifu Wars': 'Waifu Wars',
}

const tag = post.tags?.[0]
const series = (tag && SERIES_LABEL[tag]) ? SERIES_LABEL[tag] : (tag || 'Post')
const short_title = `${series} #${post.post_id}`

import { format_date } from '@helpers/date'

import Badge from '@components/blocks/Badge.astro'
import CharacterPicture from '@components/blocks/CharacterPicture.astro'
import StylessButton from '@components/blocks/StylessButton.astro'
---

<StylessButton
    class="[ news-reel-badge ]"
    href={translatePath(`/alliance/propaganda/${post.post_id}`)}
    title={post.title}
>
    <Badge
        class="[ items-center! ]"
        title={short_title}
        size={32}
    >
        <picture slot="picture">
            {(tag && MEDIA_ICON[tag]) ?
                <img
                    class="[ w-auto ]"
                    src={MEDIA_ICON[tag]}
                    loading='lazy'
                    height={32}
                    width={32}
                    alt={tag}
                /> :
                post.author.character_id > 0 ?
                    <CharacterPicture
                        character_id={post.author.character_id}
                        character_name={post.author.character_name}
                        size={32}
                    /> :
                    <img
                        class="[ w-auto ]"
                        src="/images/fleet-logo-square.svg"
                        loading="lazy"
                        height={32}
                        width={32}
                        alt={post.author.character_name}
                    />
            }
        </picture>
        <small class="[ text-foreground ]">{format_date(lang, post.date_posted)}</small>
    </Badge>
</StylessButton>

<style lang="scss">
    .news-reel-badge :global(.title) {
        white-space: nowrap;
        text-wrap: nowrap;
    }
</style>
