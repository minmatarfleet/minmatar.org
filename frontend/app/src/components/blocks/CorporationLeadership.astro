---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { CorporationLeadershipMember } from '@dtypes/api.minmatar.org'

interface Props {
    leadership: CorporationLeadershipMember[]
    show_heading?: boolean
}

const { leadership, show_heading = true } = Astro.props

import { get_player_icon } from '@helpers/eve_image_server'

import Flexblock from '@components/compositions/Flexblock.astro'

const role_order = ['ceo', 'director', 'recruiter', 'steward'] as const
type LeadershipRole = (typeof role_order)[number]
const seen = new Set<number>()
const people: CorporationLeadershipMember[] = []

for (const role of role_order) {
    for (const person of leadership) {
        if (person.role !== role || seen.has(person.character_id))
            continue
        seen.add(person.character_id)
        people.push(person)
    }
}

const groups = role_order
    .map((role) => ({
        role,
        people: people.filter((person) => person.role === role),
    }))
    .filter((group) => group.people.length > 0)

function role_label(role: LeadershipRole) {
    switch (role) {
        case 'ceo':
            return t('corporations.detail.role_ceo')
        case 'director':
            return t('corporations.detail.role_director')
        case 'recruiter':
            return t('corporations.detail.role_recruiter')
        case 'steward':
            return t('corporations.detail.role_steward')
        default: {
            const unexpected: never = role
            return unexpected
        }
    }
}

function prime_label(code: string | null) {
    if (!code)
        return ''
    switch (code) {
        case 'US': return t('US')
        case 'US_AP': return t('US_AP')
        case 'AP': return t('AP')
        case 'AP_EU': return t('AP_EU')
        case 'EU': return t('EU')
        case 'EU_US': return t('EU_US')
        default: return code
    }
}
---

{groups.length > 0 &&
    <Flexblock gap="var(--space-m)">
        {show_heading &&
            <h2>{t('corporations.detail.leadership')}</h2>
        }
        {groups.map((group) => (
            <section class="[ lead-card ]" aria-labelledby={`leadership-${group.role}`}>
                <header class="[ lead-card__header ]">
                    <h3 id={`leadership-${group.role}`}>{role_label(group.role)}</h3>
                    <span class="[ lead-card__count ]">{group.people.length}</span>
                </header>
                <ul class="[ lead-card__people ]">
                    {group.people.map((person) => (
                        <li class="[ lead-person ]">
                            <img
                                class="[ lead-person__portrait ]"
                                src={get_player_icon(person.character_id, 64)}
                                alt=""
                                width="40"
                                height="40"
                                loading="lazy"
                            />
                            <span class="[ lead-person__text ]">
                                <span class="[ lead-person__name ]">{person.character_name}</span>
                                <span class="[ lead-person__zones ]">
                                    {person.observed_prime_times.length > 0
                                        ? person.observed_prime_times.map((code) => (
                                            <span class="[ lead-tz ]">{prime_label(code)}</span>
                                        ))
                                        : <span class="[ lead-tz lead-tz--leave ]">{t('corporations.detail.fleet_inactive')}</span>
                                    }
                                </span>
                            </span>
                        </li>
                    ))}
                </ul>
            </section>
        ))}
    </Flexblock>
}

<style lang="scss">
    .lead-card {
        border: solid 1px var(--border-color-hover);
        min-width: 0;
    }

    .lead-card__header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--space-xs);
        padding: var(--space-xs) var(--space-s);
        border-bottom: solid 1px var(--border-color-hover);
        background-color: var(--light-transparency-background-mobile);

        @media screen and (min-width: 980px) {
            background-color: var(--light-transparency-background);
        }
    }

    h3 {
        margin: 0;
        font-family: var(--heading-font);
        font-size: var(--step-0);
        font-weight: normal;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--fleet-yellow);
    }

    .lead-card__count {
        color: var(--faded);
        font-size: var(--step--1);
        font-variant-numeric: tabular-nums;
    }

    .lead-card__people {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
        gap: var(--space-2xs);
        margin: 0;
        padding: var(--space-s);
        list-style: none;
    }

    .lead-person {
        display: flex;
        align-items: center;
        gap: var(--space-xs);
        min-width: 0;
        padding: var(--space-xs) var(--space-s);
        border: solid 1px var(--border-color);
        background: color-mix(in srgb, var(--highlight) 2%, transparent);
        transition: border-color var(--fast-transition), background-color var(--fast-transition);

        @media (hover: hover) {
            &:hover {
                border-color: var(--border-color-hover);
                background: color-mix(in srgb, var(--highlight) 5%, transparent);
            }
        }
    }

    .lead-person__portrait {
        display: block;
        flex: 0 0 auto;
        width: var(--space-l);
        height: var(--space-l);
        border: solid 1px var(--border-color);
    }

    .lead-person__text {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        min-width: 0;
    }

    .lead-person__name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: var(--step-0);
        font-weight: 500;
        color: var(--highlight);
    }

    .lead-person__zones {
        display: flex;
        flex-wrap: nowrap;
        gap: var(--space-3xs);
    }

    .lead-tz {
        padding: 0.1em var(--space-3xs);
        border: solid 1px color-mix(in srgb, var(--fleet-yellow) 35%, transparent);
        background: color-mix(in srgb, var(--fleet-yellow) 14%, transparent);
        color: var(--fleet-yellow);
        font-family: var(--default-font);
        font-size: var(--step--2);
        font-weight: 600;
        letter-spacing: 0.03em;
        line-height: 1.4;
        white-space: nowrap;
    }

    .lead-tz--leave {
        border-color: color-mix(in srgb, var(--fleet-red) 80%, transparent);
        background: color-mix(in srgb, var(--fleet-red) 45%, transparent);
        color: var(--highlight);
    }
</style>
