---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import ActionMenu from '@components/blocks/ActionMenu.astro'
import ActionMenuItem from '@components/blocks/ActionMenuItem.astro'

interface Props {
    is_owner: boolean
    show: boolean
    partial_base: string
    can_complete?: boolean
    [propName: string]: any
}

const {
    is_owner,
    show,
    partial_base,
    can_complete = false,
    ...attributes
} = Astro.props

delete attributes.class
---

<div
    id="fitting-buy-order-actions"
    class:list={['[ fitting-buy-order-actions ]', Astro.props.class]}
    hx-swap-oob="true"
    {...attributes}
>
    {show && is_owner && (
        <ActionMenu class="[ fitting-buy-actions-menu ]">
            {can_complete && (
                <ActionMenuItem
                    variant="primary"
                    hx-post={partial_base}
                    hx-vals={JSON.stringify({ action: 'complete_order' })}
                    hx-target="#fitting-buy-order"
                    hx-swap="outerHTML"
                    hx-indicator=".loader"
                    x-on:click.stop
                >
                    {t('fitting_buy.complete_order')}
                </ActionMenuItem>
            )}
            <ActionMenuItem
                variant="danger"
                confirm_label={t('fitting_buy.confirm_delete_order')}
                hx-post={partial_base}
                hx-vals={JSON.stringify({ action: 'delete_order' })}
                hx-target="#fitting-buy-order"
                hx-swap="outerHTML"
                hx-indicator=".loader"
                x-on:click.stop
            >
                {t('fitting_buy.delete_order')}
            </ActionMenuItem>
        </ActionMenu>
    )}
</div>
