---
// A heading over a short block of text. A thin wrapper over TextGroup (the
// library component): same tight stack, with the `badge` line height and the
// body slotted as is (no <p>). Kept for its callers; new code uses TextGroup.
import TextGroup from '@components/blocks/TextGroup.astro';

interface Props {
    title:      string;
}

const {
    title,
} = Astro.props
---
<TextGroup title={title} full root_class="badge">
    <slot slot="outside" />
</TextGroup>
