---
import { i18n } from '@helpers/i18n'
import type { BuybackOnHandItem } from '@dtypes/api.minmatar.org'
import {
    BUYBACK_STOCK_CATEGORIES,
    group_stock_items,
    janice_tsv_from_stock_groups,
} from '@helpers/buyback_ore'
import { format_isk } from '@helpers/numbers'

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import ItemPicture from '@components/blocks/ItemPicture.astro'
import BuybackRateBadge from '@components/blocks/BuybackRateBadge.astro'
import ClipboardButton from '@components/blocks/ClipboardButton.astro'

interface Props {
    stock_items: BuybackOnHandItem[]
}

const { t } = i18n(Astro.url)
const { stock_items } = Astro.props

const STOCK_CATEGORY_LABELS: Record<(typeof BUYBACK_STOCK_CATEGORIES)[number], string> = {
    ore: t('buyback.info.group.ore'),
    p1: t('buyback.info.group.p1'),
    p2: t('buyback.info.group.p2'),
    p3: t('buyback.info.group.p3'),
    p4: t('buyback.info.group.p4'),
}

const stock_groups = group_stock_items(stock_items)
const janice_tsv = janice_tsv_from_stock_groups(stock_groups)
const categorized_sections = BUYBACK_STOCK_CATEGORIES
    .map((category) => ({
        category,
        label: STOCK_CATEGORY_LABELS[category],
        groups: stock_groups.filter((group) => group.category === category),
    }))
    .filter((section) => section.groups.length > 0)
const other_groups = stock_groups.filter((group) => group.category === 'other')
const stock_sections = other_groups.length > 0
    ? [...categorized_sections, { category: 'other' as const, label: '', groups: other_groups }]
    : categorized_sections

function format_qty(qty: number): string {
    return qty.toLocaleString()
}

function format_value(isk: number | null | undefined): string {
    if (isk == null) return '—'
    return `${format_isk(isk)} ISK`
}

function escape_html(value: string): string {
    return value
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
}

function variants_tip_html(variants: Array<{ name: string; quantity: number; isk_value?: number | null }>): string {
    const lines = [
        `<strong>${t('buyback.info.ore_variants')}</strong>`,
        ...variants.map((variant) => {
            const qty = format_qty(variant.quantity)
            const isk = format_value(variant.isk_value)
            return `${escape_html(variant.name)}: ${qty} · ${isk}`
        }),
    ]
    return lines.join('<br>')
}
---

<section class="[ buyback-stock-ledger ]">
    <ComponentBlock
        class="[ buyback-stock-ledger__card ]"
        padding_block="var(--space-m)"
        padding_inline="var(--space-m)"
    >
        <Flexblock gap='var(--space-m)'>
            <FlexInline
                justification='space-between'
                gap='var(--space-s)'
                class="[ w-full flex-wrap items-center ]"
            >
                <h3>{t('buyback.stock.title')}</h3>
                {janice_tsv &&
                    <ClipboardButton
                        id="buyback-stock-janice"
                        text={t('buyback.purchase.copy_janice')}
                    >{janice_tsv}</ClipboardButton>
                }
            </FlexInline>

            {stock_groups.length === 0 ?
                <p>{t('buyback.stock.empty')}</p>
                :
                <Flexblock gap='var(--space-s)'>
                    {stock_sections.map((section) =>
                        <Flexblock gap='var(--space-3xs)'>
                            {section.label &&
                                <h4 class="[ buyback-stock-ledger__group-title ]">{section.label}</h4>
                            }
                            <ul class="[ buyback-stock-ledger__stock-list ]">
                                {section.groups.map((group) => {
                                    const show_variants = group.variants.length > 1
                                    return (
                                        <li>
                                            <FlexInline
                                                gap='var(--space-3xs)'
                                                class="[ buyback-stock-ledger__stock-row ]"
                                            >
                                                <ItemPicture
                                                    item_id={group.type_id}
                                                    item_name={group.label}
                                                    size={24}
                                                    icon_quality={32}
                                                />
                                                <FlexInline
                                                    gap='var(--space-3xs)'
                                                    class="[ buyback-stock-ledger__name-group ]"
                                                >
                                                    <span class="[ buyback-stock-ledger__name ]">{group.label}</span>
                                                    {show_variants &&
                                                        <button
                                                            type="button"
                                                            class="[ buyback-stock-ledger__variants ]"
                                                            aria-label={t('buyback.info.ore_variants')}
                                                            x-init={`tippy($el, {
                                                                content: ${JSON.stringify(variants_tip_html(group.variants))},
                                                                allowHTML: true,
                                                                delay: [100, 200],
                                                                arrow: true,
                                                            })`}
                                                        >
                                                            <span aria-hidden="true">i</span>
                                                            <span class="[ buyback-stock-ledger__variants-count ]">
                                                                {t('buyback.info.ore_variants_count').replace(
                                                                    '{count}',
                                                                    String(group.variants.length),
                                                                )}
                                                            </span>
                                                        </button>
                                                    }
                                                    <BuybackRateBadge in_demand={group.in_demand} />
                                                </FlexInline>
                                                <span class="[ buyback-stock-ledger__qty ]">{format_qty(group.quantity)}</span>
                                                <span class="[ buyback-stock-ledger__isk ]">{format_value(group.isk_value)}</span>
                                            </FlexInline>
                                        </li>
                                    )
                                })}
                            </ul>
                        </Flexblock>
                    )}
                </Flexblock>
            }
        </Flexblock>
    </ComponentBlock>
</section>

<style lang="scss">
    .buyback-stock-ledger__group-title {
        margin: 0;
        font-size: var(--step--2);
        font-weight: 600;
        line-height: 1.3;
        color: var(--faded);
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .buyback-stock-ledger__stock-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
    }

    .buyback-stock-ledger__name-group {
        flex: 1;
        min-width: 0;
    }

    .buyback-stock-ledger__name {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .buyback-stock-ledger__qty,
    .buyback-stock-ledger__isk {
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .buyback-stock-ledger__qty {
        color: var(--highlight);
    }

    .buyback-stock-ledger__isk {
        color: var(--faded);
        min-width: 4.5rem;
        text-align: end;
    }

    .buyback-stock-ledger__variants {
        display: inline-flex;
        align-items: center;
        gap: 0.35em;
        flex-shrink: 0;
        margin: 0;
        padding: 0;
        border: none;
        background: transparent;
        color: var(--faded);
        cursor: help;
        font: inherit;
        line-height: 1;

        > span[aria-hidden="true"] {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 1.1em;
            height: 1.1em;
            border: solid 1px currentColor;
            border-radius: 50%;
            font-size: 0.7em;
            font-weight: 700;
            font-style: italic;
            line-height: 1;
        }
    }

    .buyback-stock-ledger__variants:hover,
    .buyback-stock-ledger__variants:focus-visible {
        color: var(--fleet-yellow);
        outline: none;
    }

    .buyback-stock-ledger__variants-count {
        font-size: var(--step--2);
        white-space: nowrap;
    }
</style>
