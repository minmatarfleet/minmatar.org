---
// Placeholder for the decision strip (buyback / deep offers / capital).
---

<section class="[ loyalty-offers-metrics-skeleton ]" aria-hidden="true">
    <div class="[ loyalty-offers-metrics-skeleton__strip ]">
        {Array.from({ length: 3 }).map(() => (
            <div class="[ loyalty-offers-metrics-skeleton__cell ]">
                <div class="[ skel skel-label ]"></div>
                <div class="[ skel skel-value ]"></div>
                <div class="[ skel skel-note ]"></div>
            </div>
        ))}
    </div>
    <div class="[ skel skel-summary ]"></div>
</section>

<style lang="scss">
    .loyalty-offers-metrics-skeleton {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
    }

    .loyalty-offers-metrics-skeleton__strip {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
        gap: 1px;
        border: solid 1px var(--border-color);
        background-color: var(--border-color);
    }

    .loyalty-offers-metrics-skeleton__cell {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        padding-block: var(--space-s);
        padding-inline: var(--space-m);
        background-color: var(--component-background);
    }

    .loyalty-offers-metrics-skeleton .skel {
        border-radius: 2px;
        background: color-mix(in srgb, var(--component-background) 70%, var(--foreground));
        animation: loyalty-offers-metrics-skel 1.2s ease-in-out infinite;
    }

    .skel-label {
        width: 10rem;
        max-width: 80%;
        height: var(--step--1);
    }

    .skel-value {
        width: 7rem;
        max-width: 70%;
        height: var(--step-3);
    }

    .skel-note {
        width: 12rem;
        max-width: 90%;
        height: var(--step--1);
    }

    .skel-summary {
        width: min(100%, 32rem);
        height: var(--step--2);
    }

    @keyframes loyalty-offers-metrics-skel {
        0%,
        100% {
            opacity: 0.45;
        }
        50% {
            opacity: 0.85;
        }
    }
</style>
