---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { Product } from '@dtypes/api.minmatar.org'

interface Props {
    product:            Product;
    view:               'overview' | 'build';
    [propName: string]: any;
}

const {
    product,
    view,
    ...attributes
} = Astro.props

delete attributes.class

import { get_bpc_icon, get_item_icon } from '@helpers/eve_image_server'
import { query_string } from '@helpers/string'
import { format_volume_m3 } from '@helpers/numbers'

const overview_path = translatePath(`/industry/products/${product.id}/`)
const build_path = translatePath(`/industry/products/${product.id}/build/`)
const has_blueprint = !!product.blueprint_or_reaction_type_id

const views = [
    { id: 'overview', label: t('industry.product.view_overview'), href: overview_path },
    ...(has_blueprint ? [{ id: 'build', label: t('industry.product.view_build'), href: build_path }] : []),
]

import FlexInline from '@components/compositions/FlexInline.astro'
import Flexblock from '@components/compositions/Flexblock.astro'

import Button from '@components/blocks/Button.astro'
import Picture from '@components/blocks/Picture.astro'
import Tag from '@components/blocks/Tag.astro'

import IndustryIcon from '@components/icons/IndustryIcon.astro'
---

<header class:list={['[ product-header ]', Astro.props.class]} {...attributes}>
    <FlexInline justification="space-between" gap="var(--space-m)" class="[ product-header-top ]">
        <FlexInline gap="var(--space-s)" class="[ items-center min-w-0 ]">
            <img
                class="[ product-icon ]"
                src={get_item_icon(product.type_id, 128)}
                width="64"
                height="64"
                alt=""
            />
            <Flexblock gap="var(--space-2xs)" class="[ min-w-0 ]">
                <h1 class="[ product-name ]">{product.name}</h1>
                <FlexInline gap="var(--space-3xs) var(--space-s)" class="[ product-meta ]">
                    <Tag
                        color={product.strategy === 'imported' ? 'fleet-red' : product.strategy === 'harvested' ? 'fleet-yellow' : 'alliance-blue'}
                        text={t(`industry.product.strategy_${product.strategy}` as any) ?? product.strategy}
                    />
                    {product.volume &&
                        <span>{format_volume_m3(product.volume)} m³</span>
                    }
                    {has_blueprint &&
                        <FlexInline gap="var(--space-3xs)" class="[ items-center ]">
                            <Picture
                                src={get_bpc_icon(product.blueprint_or_reaction_type_id as number, false, 32)}
                                alt=""
                                size={16}
                            />
                            <span>{t('industry.product.has_blueprint')}</span>
                        </FlexInline>
                    }
                </FlexInline>
            </Flexblock>
        </FlexInline>

        <FlexInline gap="var(--space-xs)" class="[ flex-wrap ]">
            {has_blueprint &&
                <Button
                    size="sm"
                    color="fleet-red"
                    href={translatePath(`/industry/orders/planner?${query_string({ type_id: product.type_id })}`)}
                >
                    <IndustryIcon slot="icon" size={24} />
                    {t('industry.product.plan_build')}
                </Button>
            }
            <Button
                size="sm"
                color="transparent"
                href={translatePath(`/industry/orders/create?${query_string({ type_id: product.type_id })}`)}
            >
                {t('industry.product.order_this')}
            </Button>
        </FlexInline>
    </FlexInline>

    {views.length > 1 &&
        <nav class="[ product-views ]" aria-label={t('industry.product.views_label')}>
            {views.map(item =>
                <a
                    href={item.href}
                    aria-current={item.id === view ? 'page' : undefined}
                    class:list={['[ product-view ]', { 'is-active': item.id === view }]}
                >
                    {item.label}
                </a>
            )}
        </nav>
    }
</header>

<style lang="scss">
    .product-header {
        display: flex;
        flex-direction: column;
        gap: var(--space-s);
        width: 100%;
    }

    .product-header-top {
        align-items: center;
        flex-wrap: wrap;
    }

    .product-icon {
        width: var(--space-2xl);
        height: var(--space-2xl);
        flex-shrink: 0;
    }

    .product-name {
        font-size: var(--step-4);
        line-height: 1;
        overflow-wrap: anywhere;
    }

    .product-meta {
        align-items: center;
        flex-wrap: wrap;
        font-size: var(--step--1);
        color: var(--foreground);
    }

    .product-views {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3xs);
        border-bottom: solid 1px var(--border-color);
    }

    .product-view {
        display: inline-flex;
        align-items: center;
        min-height: var(--space-xl);
        padding-inline: var(--space-s);
        font-family: var(--button-font);
        font-size: var(--step--1);
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--foreground);
        text-decoration: none;
        border-bottom: solid 2px transparent;
        margin-bottom: -1px;
        transition: color var(--fast-transition), border-color var(--fast-transition);

        @media (hover: hover) {
            &:hover {
                color: var(--highlight);
            }
        }

        &.is-active {
            color: var(--highlight);
            border-bottom-color: var(--fleet-yellow);
        }
    }
</style>
