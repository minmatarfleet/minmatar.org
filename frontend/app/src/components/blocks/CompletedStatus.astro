---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { FleetTrackingTexts } from '@dtypes/layout_components'

interface Props {
    fleet_tracking_texts:   FleetTrackingTexts | false;
}

const {
    fleet_tracking_texts,
} = Astro.props

import Flexblock from '@components/compositions/Flexblock.astro';
import StatusText from '@components/blocks/StatusText.astro';
---

<Flexblock gap='var(--space-2xs)'>
    <StatusText>{t('completed')}</StatusText>
    {fleet_tracking_texts &&
        <small class="[ text-highlight ]">
            {fleet_tracking_texts.fleet_end_eve_time_text} (<span data-tippy-content={fleet_tracking_texts.fleet_tracking_hint}>{fleet_tracking_texts.fleet_duration_text}</span>)
        </small>
    }
</Flexblock>
