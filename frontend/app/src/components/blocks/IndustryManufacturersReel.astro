---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { IndustryOrderCharacterStatistics } from '@dtypes/api.minmatar.org'

interface Props {
    manufacturers:     IndustryOrderCharacterStatistics[];
}

const {
    manufacturers,
} = Astro.props

import Wrapper from '@components/compositions/Wrapper.astro';
import FixedFluid from '@components/compositions/FixedFluid.astro';
import FlexInlineSiblings from '@components/compositions/FlexInlineSiblings.astro';
import FlexInline from '@components/compositions/FlexInline.astro';

import Marquee from '@components/blocks/Marquee.astro';
import IndustryManufacturerBadge from '@components/blocks/IndustryManufacturerBadge.astro';
import Button from '@components/blocks/Button.astro';
import TextBadge from '@components/blocks/TextBadge.astro';
---

<div
    class="[ bottom-bar ][ card component light-transparency hidden! animate-slide-in-bottom ]"
    x-on:marquee-started="$el.classList.add('lg:block!')"
>
    <Wrapper
        class="[ industry-manufacturers-reel ]"
        neocom={true}
        max_width='var(--max-content-width)'
        centered={true}
        padding_block='var(--space-2xs)'
    >
        <FixedFluid width='170px' class="[ items-center! ]">
            <TextBadge title={t('industry_manufacturer_ranking')}>
                <small>{t('last_30_days')}</small>
            </TextBadge>

            <FlexInlineSiblings
                min-shink-width='250px'
                shrinkable-sibbling='first'
            >
                {manufacturers.length >= 4 ?
                    <Marquee>
                        {manufacturers.map((manufacturer, index) =>
                            <IndustryManufacturerBadge place={index + 1} manufacturer={manufacturer} />
                        )}
                    </Marquee> :
                    <FlexInline gap='var(--space-l)' x-init="$dispatch('marquee-started')">
                        {manufacturers.map((manufacturer, index) =>
                            <IndustryManufacturerBadge place={index + 1} manufacturer={manufacturer} />
                        )}
                    </FlexInline>
                }

                <Button
                    href={translatePath('/alliance/tribes/2')}
                    size='sm'
                >
                    {t('become_a_supplier')}
                </Button>
            </FlexInlineSiblings>
        </FixedFluid>
    </Wrapper>
</div>

<style lang="scss">
    .bottom-bar {
        position: fixed;
        left: 0;
        bottom: 0;
        width: 100%;
        z-index: var(--sticky-z-index);
    }

    .industry-manufacturers-reel {
        position: relative;
    }
</style>
