---
/** One fitting in the doctrine editor's add search. Styles: DoctrineEditorRow. */
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import { alpine_string, ship_icon, type EditorFitting } from '@helpers/doctrine_editor'

interface Props {
    fitting: EditorFitting;
    [propName: string]: any;
}

const { fitting } = Astro.props
---

<li data-search={fitting.search} data-filters={fitting.filters} x-show="matches($el)">
    <button
        type="button"
        role="option"
        class="[ doctrine-result ]"
        x-on:click={`add(${fitting.id})`}
        x-bind:disabled={`anywhere(${fitting.id})`}
    >
        <img src={ship_icon(fitting.ship_id)} alt="" width="32" height="32" loading="lazy" />
        <span class="[ doctrine-row__text ]">
            <span>{fitting.name}</span>
            <small>{fitting.hull}</small>
        </span>
        <small
            class="[ doctrine-result__end ]"
            x-text={`anywhere(${fitting.id}) ? '${alpine_string(t('doctrine_changes.in_role'))}'.replace('{role}', in_role(${fitting.id})) : '${alpine_string(t('doctrine_changes.add'))}'`}
        ></small>
    </button>
</li>
