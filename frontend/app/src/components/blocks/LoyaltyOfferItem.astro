---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { LoyaltyOffer } from '@dtypes/api.minmatar.org'
import {
    conversion_for_side,
    market_price_for_side,
    offer_is_low_weekly_lp_volume,
    offer_lp_for_volume,
} from '@helpers/loyalty_offers_metrics'
import {
    format_isk_per_lp_rate,
    loyalty_conversion_breakdown,
    loyalty_conversion_tip_lines,
} from '@helpers/loyalty_conversion_breakdown'
import { number_thousand_separator } from '@helpers/numbers'

import Tag from '@components/blocks/Tag.astro'

interface Props {
    offer: LoyaltyOffer
    side?: 'sell' | 'buy' | 'avg_7d'
    [propName: string]: any
}

const { offer, side = 'buy' } = Astro.props

function format_int(value: number | null | undefined): string {
    if (value == null)
        return '—'
    return number_thousand_separator(value)
}

function volume_lp_tooltip(volume: number | null | undefined): string | undefined {
    if (volume == null)
        return undefined
    return t('industry.loyalty.offers.volume_lp_tooltip').replace(
        '{lp}',
        number_thousand_separator(offer_lp_for_volume(offer, volume)),
    )
}

function escape_html(value: string): string {
    return value
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
}

function parse_required_item_line(part: string): string {
    const trimmed = part.trim()
    if (!trimmed)
        return ''
    const match = trimmed.match(/^(.*)\s+x(\d+)\s*$/i)
    if (!match)
        return escape_html(trimmed)
    const name = match[1].trim()
    const qty = Number.parseInt(match[2], 10)
    return escape_html(
        t('industry.loyalty.offers.other_cost_tip.item')
            .replace('{name}', name)
            .replace('{qty}', number_thousand_separator(qty)),
    )
}

const is_blueprint = offer.kind === 'blueprint'

function other_cost_tooltip(): string {
    const summary = (offer.required_items_summary || '').trim()
    const lines: string[] = []
    const has_other = offer.other_cost != null && offer.other_cost > 0

    if (summary) {
        lines.push(escape_html(t('industry.loyalty.offers.other_cost_tip.required')))
        for (const part of summary.split(',')) {
            const line = parse_required_item_line(part)
            if (line)
                lines.push(line)
        }
    }

    if (is_blueprint && has_other) {
        lines.push(escape_html(t('industry.loyalty.offers.other_cost_tip.manufacturing')))
    }

    if (!lines.length && !has_other) {
        return escape_html(t('industry.loyalty.offers.other_cost_tip.empty'))
    }

    if (offer.other_cost != null) {
        lines.push(
            escape_html(
                t('industry.loyalty.offers.other_cost_tip.total').replace(
                    '{value}',
                    number_thousand_separator(offer.other_cost),
                ),
            ),
        )
    }

    return lines.join('<br>')
}

const icon_type = is_blueprint ? 'bp' : 'icon'
const conversion = conversion_for_side(offer, side)
const is_low_volume = offer_is_low_weekly_lp_volume(offer)
const other_cost_tippy = other_cost_tooltip()
const breakdown = loyalty_conversion_breakdown({
    lp_cost: offer.lp_cost,
    quantity: offer.quantity,
    market_price: market_price_for_side(offer, side),
    input_cost_isk: offer.input_cost_isk,
    input_freight_isk: offer.input_freight_isk,
    isk_cost: offer.isk_cost,
    other_cost: offer.other_cost,
    net_isk_per_lp: conversion,
})
const conversion_tippy = loyalty_conversion_tip_lines(breakdown, {
    finished_goods: t('industry.loyalty.offers.conversion_tip.finished_goods'),
    other_cost: t('industry.loyalty.offers.conversion_tip.other_cost'),
    input_freight: t('industry.loyalty.offers.conversion_tip.input_freight'),
    sales_tax: t('industry.loyalty.offers.conversion_tip.sales_tax'),
    output_freight: t('industry.loyalty.offers.conversion_tip.output_freight'),
    net: t('industry.loyalty.offers.conversion_tip.net'),
}).map(escape_html).join('<br>')
---

<div
    class:list={[
        '[ loyalty-offer-item ]',
        { 'loyalty-offer-item--low-volume': is_low_volume },
    ]}
    role="row"
>
    <div class="[ loyalty-offer-item__item ]" role="cell">
        <span class="[ loyalty-offer-item__item-inner ]">
            <img
                class="[ loyalty-offer-item__icon ]"
                src={`https://images.evetech.net/types/${offer.type_id}/${icon_type}?size=32`}
                width="32"
                height="32"
                alt=""
                loading="lazy"
                onerror="this.hidden=true"
            />
            <span class="[ loyalty-offer-item__name text-highlight ]">{offer.type_name}</span>
            {is_low_volume && (
                <span
                    class="[ loyalty-offer-item__low-volume ]"
                    data-tippy-content={t('industry.loyalty.offers.low_volume_warning')}
                >
                    <Tag
                        text={t('industry.loyalty.offers.low_volume_tag')}
                        color="fleet-red"
                        narrow
                    />
                </span>
            )}
        </span>
    </div>
    <div class="[ loyalty-offer-item__num ]" role="cell">{format_int(offer.quantity)}</div>
    <div
        class="[ loyalty-offer-item__num ]"
        role="cell"
        data-tippy-content={other_cost_tippy}
    >{format_int(offer.other_cost)}</div>
    <div
        class="[ loyalty-offer-item__num ]"
        role="cell"
        data-tippy-content={conversion_tippy}
    >{format_isk_per_lp_rate(conversion)}</div>
    <div
        class="[ loyalty-offer-item__num ]"
        role="cell"
        data-tippy-content={volume_lp_tooltip(offer.volume_7d)}
    >{format_int(offer.volume_7d)}</div>
    <div
        class="[ loyalty-offer-item__num ]"
        role="cell"
        data-tippy-content={volume_lp_tooltip(offer.volume_30d)}
    >{format_int(offer.volume_30d)}</div>
</div>

<style lang="scss">
    .loyalty-offer-item {
        display: grid;
        grid-template-columns:
            minmax(14rem, 2fr)
            minmax(3.5rem, 0.45fr)
            minmax(5.5rem, 0.75fr)
            minmax(5.5rem, 0.75fr)
            minmax(4rem, 0.55fr)
            minmax(4.5rem, 0.6fr);
        gap: var(--space-s);
        align-items: center;
        padding-block: var(--space-2xs);
        padding-inline: var(--space-2xs);
        border-bottom: solid 1px var(--border-color);
        font-size: var(--step--1);
        min-width: 40rem;

        @media (hover: hover) {
            &:hover {
                background: color-mix(in srgb, var(--highlight) 6%, transparent);
            }
        }

        &--low-volume {
            background: color-mix(in srgb, var(--fleet-red) 6%, transparent);
        }
    }

    .loyalty-offer-item__item-inner {
        display: flex;
        align-items: center;
        gap: var(--space-2xs);
        min-width: 0;
    }

    .loyalty-offer-item__icon {
        flex-shrink: 0;
        width: 2rem;
        height: 2rem;
        border-radius: 2px;
        background: color-mix(in srgb, var(--background) 80%, var(--foreground));
    }

    .loyalty-offer-item__name {
        font-weight: 600;
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .loyalty-offer-item__low-volume {
        flex-shrink: 0;
        cursor: help;
    }

    .loyalty-offer-item__num {
        font-variant-numeric: tabular-nums;
        text-align: right;
        white-space: nowrap;

        &[data-tippy-content] {
            cursor: help;
            text-decoration: underline dotted color-mix(in srgb, currentColor 35%, transparent);
            text-underline-offset: 0.2em;
            transition: var(--fast-transition);

            @media (hover: hover) {
                &:hover {
                    color: var(--fleet-yellow);
                    text-decoration-color: currentColor;
                }
            }
        }
    }
</style>
