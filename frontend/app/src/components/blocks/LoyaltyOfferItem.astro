---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { LoyaltyOffer } from '@dtypes/api.minmatar.org'
import { number_thousand_separator } from '@helpers/numbers'

interface Props {
    offer: LoyaltyOffer
    side?: 'sell' | 'buy' | 'avg_7d'
    [propName: string]: any
}

const { offer, side = 'buy' } = Astro.props

function format_int(value: number | null | undefined): string {
    if (value == null)
        return '—'
    return number_thousand_separator(value)
}

function format_rate(value: number | null | undefined): string {
    if (value == null)
        return '—'
    return value.toLocaleString('en-US', {
        minimumFractionDigits: 1,
        maximumFractionDigits: 1,
    })
}

function volume_lp_tooltip(volume: number | null | undefined): string | undefined {
    if (volume == null)
        return undefined
    const qty = Math.max(offer.quantity || 1, 1)
    const packs = Math.ceil(volume / qty)
    const total_lp = packs * offer.lp_cost
    return t('industry.loyalty.offers.volume_lp_tooltip').replace(
        '{lp}',
        number_thousand_separator(total_lp),
    )
}

const is_blueprint = offer.kind === 'blueprint'
const icon_type = is_blueprint ? 'bp' : 'icon'
const conversion = side === 'buy'
    ? offer.conversion_isk_per_lp_buy
    : side === 'avg_7d'
        ? offer.conversion_isk_per_lp_avg_7d
        : offer.conversion_isk_per_lp_sell

const volume_cells = [
    { volume: offer.volume_7d },
    { volume: offer.volume_30d },
]
---

<div class="[ loyalty-offer-item ]" role="row">
    <div class="[ loyalty-offer-item__item ]" role="cell">
        <span class="[ loyalty-offer-item__item-inner ]">
            <img
                class="[ loyalty-offer-item__icon ]"
                src={`https://images.evetech.net/types/${offer.type_id}/${icon_type}?size=32`}
                width="32"
                height="32"
                alt=""
                loading="lazy"
                onerror="this.hidden=true"
            />
            <span class="[ loyalty-offer-item__name text-highlight ]">{offer.type_name}</span>
        </span>
    </div>
    <div class="[ loyalty-offer-item__num ]" role="cell">{format_int(offer.quantity)}</div>
    <div class="[ loyalty-offer-item__num ]" role="cell">{format_int(offer.other_cost)}</div>
    <div class="[ loyalty-offer-item__num ]" role="cell">{format_rate(conversion)}</div>
    {volume_cells.map(({ volume }) => (
        <div
            class="[ loyalty-offer-item__num ]"
            role="cell"
            data-tippy-content={volume_lp_tooltip(volume)}
        >{format_int(volume)}</div>
    ))}
</div>

<style lang="scss">
    .loyalty-offer-item {
        display: grid;
        grid-template-columns:
            minmax(14rem, 2fr)
            minmax(3.5rem, 0.45fr)
            minmax(5.5rem, 0.75fr)
            minmax(5.5rem, 0.75fr)
            minmax(4rem, 0.55fr)
            minmax(4.5rem, 0.6fr);
        gap: var(--space-s);
        align-items: center;
        padding-block: var(--space-2xs);
        padding-inline: var(--space-2xs);
        border-bottom: solid 1px var(--border-color);
        font-size: var(--step--1);
        min-width: 40rem;

        @media (hover: hover) {
            &:hover {
                background: color-mix(in srgb, var(--highlight) 6%, transparent);
            }
        }
    }

    .loyalty-offer-item__item-inner {
        display: flex;
        align-items: center;
        gap: var(--space-2xs);
        min-width: 0;
    }

    .loyalty-offer-item__icon {
        flex-shrink: 0;
        width: 2rem;
        height: 2rem;
        border-radius: 2px;
        background: color-mix(in srgb, var(--background) 80%, var(--foreground));
    }

    .loyalty-offer-item__name {
        font-weight: 600;
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .loyalty-offer-item__num {
        font-variant-numeric: tabular-nums;
        text-align: right;
        white-space: nowrap;

        &[data-tippy-content] {
            cursor: help;
        }
    }
</style>
