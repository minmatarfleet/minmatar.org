---
import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

import type { ButtonColors, ButtonSizes } from '@dtypes/layout_components';

interface Props {
    color?:         ButtonColors;
    size?:          ButtonSizes;
    narrow?:        boolean;
    [propName: string]: any;
}

const {
    color = 'fleet-red',
    size = 'lg',
    narrow = false,
    dialog_title: _dialog_title,
    ...attributes
} = Astro.props;

const AUTH_REDIRECT_URL = `${translatePath('/redirects/auth_init')}?redirect_url=${encodeURIComponent(Astro.url.toString())}`

import Button from '@components/blocks/Button.astro';
---

<Button
    type="button"
    color={color}
    size={size}
    narrow={narrow}
    x-on:click={`window.location.href = ${JSON.stringify(AUTH_REDIRECT_URL)}`}
    {...attributes}
>
    <slot />
</Button>
