---
import DialogBase from '@components/blocks/DialogBase.astro';

interface Props {
    /** Backdrop clicks do nothing; Escape and the corner button still close. Opened with `show_persistent_modal()`. */
    persistent?:        boolean;
    [propName: string]: any;
}

const { persistent = false } = Astro.props
---

<DialogBase
    name={persistent ? 'persistent_modal' : 'modal'}
    persistent={persistent}
    partial_once={true}
    partial_params={true}
    thin={true}
    class={persistent ? '[ w-full max-w-[770px] ]' : '[ w-full ]'}
    max_width={persistent ? undefined : '750px'}
/>
