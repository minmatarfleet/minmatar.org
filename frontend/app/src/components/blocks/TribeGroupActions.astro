---
import { i18n } from '@helpers/i18n'
import { login_url } from '@helpers/http_responses'
const { t, translatePath } = i18n(Astro.url)

import type {
    TribeGroup,
    SummaryCharacter,
    TribeMembership,
    TribeAvailableCharacter,
} from '@dtypes/api.minmatar.org'
import { tribe_group_apply_ui_state } from '@helpers/tribe_group_apply_ui'
import { tribe_group_can_manage } from '@helpers/tribe_group_viewer'
import { query_string } from '@helpers/string'

interface Props {
    group: TribeGroup
    tribe_id: number
    group_id: number
    is_auth: boolean
    is_leader: boolean
    user_characters: SummaryCharacter[]
    available_characters?: TribeAvailableCharacter[]
    membership_by_group: Map<number, TribeMembership | null>
    user_on_trial?: boolean
    [propName: string]: any
}

const {
    group,
    tribe_id,
    group_id,
    is_auth,
    is_leader,
    user_characters,
    available_characters,
    membership_by_group,
    user_on_trial = false,
    ...attributes
} = Astro.props

delete attributes.class

const apply_ui = tribe_group_apply_ui_state({
    group,
    membership: membership_by_group.get(group.id) ?? null,
    is_auth,
    is_leader,
    user_on_trial,
})
const {
    membership,
    is_approved,
    is_pending,
    has_open_membership,
    can_apply,
    blocked_by_trial,
} = apply_ui
const status_id = `tribe-group-status-${group.tribe_id}-${group.id}`
const members_href = translatePath(`/alliance/tribes/${tribe_id}/${group_id}/members`)
const status_partial = translatePath(
    `/partials/tribe_group_status_component?tribe_id=${tribe_id}&group_id=${group_id}&ui=actions`,
)
const auth_redirect = login_url(Astro)
const can_manage = tribe_group_can_manage({
    group,
    is_leader,
})

const show_membership_action =
    !is_leader && (!is_auth || can_apply || has_open_membership)
const show_actions = show_membership_action || can_manage

import ActionMenu from '@components/blocks/ActionMenu.astro'
import ActionMenuItem from '@components/blocks/ActionMenuItem.astro'
import ButtonApplyTribe from '@components/blocks/ButtonApplyTribe.astro'
import ButtonTribeMembership from '@components/blocks/ButtonTribeMembership.astro'
---

{show_actions &&
    <div
        id={status_id}
        class:list={['[ tribe-group-actions ]', Astro.props.class]}
        {...attributes}
    >
        <ActionMenu
            class="[ tribe-group-actions-menu ]"
            variant="button"
            color="fleet-red"
            size="sm"
        >
            {show_membership_action &&
                <>
                    {!is_auth ?
                        <ActionMenuItem
                            x-on:click={`window.location.href = ${JSON.stringify(auth_redirect)}`}
                        >
                            {t('tribes.detail.login_to_apply')}
                        </ActionMenuItem>
                        : !can_apply && !has_open_membership ?
                            null
                        : is_pending && membership ?
                            <ActionMenuItem
                                variant="danger"
                                confirm_label={t('confirm')}
                                hx-delete={`${status_partial}?${query_string({
                                    tribe_id: tribe_id,
                                    group_id: group_id,
                                    membership_id: membership.id,
                                })}`}
                                hx-target={`#${status_id}`}
                                hx-indicator=".loader"
                                hx-swap="outerHTML transition:true"
                                x-on:click="$el.setAttribute('disabled','')"
                            >
                                {t('tribes.detail.withdraw')}
                            </ActionMenuItem>
                            : !is_pending && !is_approved ?
                                (blocked_by_trial ?
                                    <ActionMenuItem variant="muted" text_only={true}>
                                        {t('tribes.detail.off_trial_apply_blocked')}
                                    </ActionMenuItem>
                                    :
                                    <div class="[ action-menu-item-host ]">
                                        <ButtonApplyTribe
                                            styless={true}
                                            actions_ui={true}
                                            target_id={status_id}
                                            title={group.name}
                                            tribe_id={tribe_id}
                                            group_id={group_id}
                                            pilots={user_characters}
                                            available_characters={available_characters}
                                            required_token_type={group.required_token_type}
                                        />
                                    </div>
                                )
                                : is_approved && membership ?
                                    <div class="[ action-menu-item-host ]">
                                        <ButtonTribeMembership
                                            styless={true}
                                            actions_ui={true}
                                            target_id={status_id}
                                            title={group.name}
                                            tribe_id={tribe_id}
                                            group_id={group_id}
                                            membership_id={membership.id}
                                            pilots={user_characters}
                                            membership={membership}
                                            available_characters={available_characters}
                                            required_token_type={group.required_token_type}
                                        />
                                    </div>
                                    : null
                    }
                </>
            }

            {can_manage &&
                <ActionMenuItem href={members_href} x-on:click="close()">
                    {t('manage_membership')}
                </ActionMenuItem>
            }
        </ActionMenu>
    </div>
}
