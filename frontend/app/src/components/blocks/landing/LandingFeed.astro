---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { LandingEvent } from '@dtypes/api.minmatar.org'
import { character_portrait, eve_clock, event_who } from '@helpers/landing'

import EmptyState from '@components/blocks/EmptyState.astro'

interface Props {
    events:         LandingEvent[];
    visible?:       number;
    [propName: string]: any;
}

const { events, visible = 8, ...attributes } = Astro.props

delete attributes.class

// Start a few rows back and let the newer ones arrive one at a time,
// the way the hour plays back.
const start = Math.max(0, Math.min(visible, events.length - visible))
const others = t('landing_new.and_others')
---

<div
    class:list={['[ landing-feed ]', Astro.props.class]}
    x-data={`{
        start: ${start},
        visible: ${visible},
        init() {
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { this.start = 0; return }
            const timer = setInterval(() => {
                if (this.start <= 0) { clearInterval(timer); return }
                this.start -= 1
            }, 3500)
        },
    }`}
    {...attributes}
>
    <div class="landing-feed__header">
        <h3>{t('landing_new.feed_heading')}</h3>
        <span class="landing-feed__playing">
            <span class="landing-feed__dot" aria-hidden="true"></span>
            {t('landing_new.feed_playing')}
        </span>
    </div>

    {events.length === 0 && <EmptyState title={t('landing_new.feed_empty')} />}

    <ol class="landing-feed__list">
        {events.map((event, index) =>
            <li
                class="landing-feed__row"
                x-show={`${index} >= start && ${index} < start + visible`}
                x-bind:class={`{ 'is-new': ${index} === start && start < ${start} }`}
                style={index >= start && index < start + visible ? undefined : 'display: none;'}
            >
                <time datetime={event.occurred_at}>{eve_clock(event.occurred_at)}</time>
                <img src={character_portrait(event.character_id, 64)} alt="" width="40" height="40" loading="lazy" />
                <span class="landing-feed__text">
                    <strong>{event_who(event, others)}</strong>{' '}{event.action}
                </span>
                <span class="landing-feed__region">{event.region}</span>
            </li>
        )}
    </ol>
</div>

<style lang="scss">
    .landing-feed {
        display: flex;
        flex-direction: column;
        background: var(--component-background);
        border: 1px solid var(--border-color);
    }

    .landing-feed__header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--space-s);
        padding: var(--space-s) var(--space-m);
        border-bottom: 1px solid var(--border-color);

        h3 {
            margin: 0;
            font-family: var(--heading-font);
            font-weight: normal;
            font-size: var(--step-1);
            color: var(--highlight);
        }
    }

    .landing-feed__playing {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2xs);
        font-size: var(--step--2);
        color: var(--text-muted);
    }

    .landing-feed__dot {
        width: var(--space-2xs);
        height: var(--space-2xs);
        border-radius: 50%;
        background: var(--green);
    }

    .landing-feed__list {
        margin: 0;
        padding: 0;
        list-style: none;
        overflow: hidden;
    }

    .landing-feed__row {
        display: grid;
        grid-template-columns: 3.5rem 2.5rem minmax(0, 1fr) auto;
        gap: var(--space-s);
        align-items: center;
        padding: var(--space-xs) var(--space-m);
        border-bottom: 1px solid var(--border-color);
        font-size: var(--step--1);

        time {
            color: var(--text-muted);
            font-variant-numeric: tabular-nums;
        }

        img {
            width: 2.5rem;
            height: 2.5rem;
            object-fit: cover;
        }

        &.is-new {
            animation: landing-row-in 1.4s ease-out both;
        }
    }

    .landing-feed__text {
        color: var(--text-muted);

        strong {
            color: var(--highlight);
            font-weight: 600;
        }
    }

    .landing-feed__region {
        font-size: var(--step--2);
        color: var(--text-muted);
    }

    @keyframes landing-row-in {
        0% {
            opacity: 0;
            transform: translateY(calc(-1 * var(--space-s)));
            background: color-mix(in srgb, var(--fleet-yellow) 22%, transparent);
        }
        35% { opacity: 1; transform: none; }
        100% { background: transparent; }
    }

    @media (prefers-reduced-motion: reduce) {
        .landing-feed__row.is-new { animation: none; }
    }

    @media (max-width: 48rem) {
        .landing-feed__header {
            flex-direction: column;
            align-items: flex-start;
            padding-inline: var(--space-s);
        }

        .landing-feed__row {
            grid-template-columns: 2.5rem minmax(0, 1fr);
            column-gap: var(--space-xs);
            row-gap: var(--space-3xs);
            padding-inline: var(--space-s);

            img { grid-column: 1; grid-row: 1 / span 2; }
            time { grid-column: 2; grid-row: 2; font-size: var(--step--2); }
        }

        .landing-feed__text { grid-column: 2; grid-row: 1; }
        .landing-feed__region { display: none; }
    }
</style>
