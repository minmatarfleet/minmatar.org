---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { LandingEvent } from '@dtypes/api.minmatar.org'
import { eve_clock } from '@helpers/landing'

import EmptyState from '@components/blocks/EmptyState.astro'
import LandingLine from '@components/blocks/landing/LandingLine.astro'

/**
 * The hero's Live band: the newest pilot lines pop in at the top one at a
 * time and the oldest fades out, five on show, across the full width. Every
 * line is rendered here; Alpine only moves `head` along them.
 */
interface Props {
    events:         LandingEvent[];
    view_all_href:  string;
    [propName: string]: any;
}

const { events, view_all_href, ...attributes } = Astro.props

delete attributes.class

const VISIBLE = 5
// Oldest first, so playback runs forward to the newest line and stops there.
const played = events.slice(0, 12).reverse()
const start = Math.min(VISIBLE - 1, Math.max(played.length - 1, 0))
const last = Math.max(played.length - 1, 0)
---

<div
    class:list={['[ landing-live ]', Astro.props.class]}
    x-data={`{
        head: ${start},
        start: ${start},
        last: ${last},
        init() {
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { this.head = this.last; return }
            const timer = setInterval(() => {
                if (this.head >= this.last) { clearInterval(timer); return }
                this.head += 1
            }, 3000)
        },
    }`}
    {...attributes}
>
    <div class="[ landing-live__feed ]">
        <p class="[ landing-live__label ]">
            <span class="[ landing-live__dot ]" aria-hidden="true"></span>
            <span>{t('landing_new.ticker_label')}</span>
            <span class="[ landing-live__hint ]">{t('landing_new.live_hint')}</span>
            <a class="[ landing-live__all ]" href={view_all_href}>{t('landing_new.view_all')}</a>
        </p>
        {played.length === 0 && <EmptyState title={t('landing_new.feed_empty')} />}
        <ol class="[ landing-live__list ]" aria-live="off" style={`--live_rows: ${VISIBLE}`}>
            {played.map((event, index) => ({ event, index })).reverse().map(({ event, index }) =>
                <li
                    class="[ landing-live__row ]"
                    x-show={`${index} <= head && ${index} >= head - ${VISIBLE}`}
                    x-bind:class={`{ 'is-new': ${index} === head && head > start, 'is-older': ${index} <= head - 2, 'is-oldest': ${index} === head - ${VISIBLE - 1}, 'is-out': ${index} === head - ${VISIBLE} }`}
                    style={index <= start && index > start - VISIBLE ? undefined : 'display: none;'}
                >
                    <LandingLine event={event} />
                    <span class="[ landing-live__region ]">{event.region}</span>
                    <time datetime={event.occurred_at}>{eve_clock(event.occurred_at)}</time>
                </li>
            )}
        </ol>
    </div>
</div>

<style lang="scss">
    .landing-live {
        padding-top: var(--space-m);
        border-top: 1px solid var(--hairline-medium);
    }

    .landing-live__label {
        display: flex;
        align-items: center;
        gap: var(--space-xs);
        margin: 0 0 var(--space-s);
        font-size: var(--step--2);
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--highlight);
    }

    .landing-live__hint {
        font-weight: normal;
        letter-spacing: normal;
        text-transform: none;
        color: var(--text-muted);
    }

    .landing-live__all {
        margin-inline-start: auto;
        font-size: var(--step--1);
        letter-spacing: normal;
        text-transform: none;
        color: var(--fleet-yellow);
    }

    .landing-live__dot {
        width: var(--space-2xs);
        height: var(--space-2xs);
        border-radius: 50%;
        background: var(--green);
        animation: landing-live-beat 1.6s ease-in-out infinite;
    }

    // Always exactly VISIBLE rows tall: a new line pops in while the oldest
    // collapses, and that would otherwise push the whole page down and back
    // every few seconds.
    .landing-live__list {
        display: flex;
        flex-direction: column;
        block-size: calc(var(--space-xl) * var(--live_rows));
        overflow: hidden;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .landing-live__row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto auto;
        gap: var(--space-s);
        align-items: center;
        flex: none;
        block-size: var(--space-xl);
        max-height: var(--space-xl);
        box-sizing: border-box;
        padding: var(--space-2xs) 0;
        overflow: hidden;
        border-bottom: 1px solid var(--hairline);
        transform-origin: left center;
        font-size: var(--step--1);
        color: var(--text-muted);

        time {
            font-variant-numeric: tabular-nums;
        }

        &.is-older { opacity: 0.8; }
        &.is-oldest { opacity: 0.6; }

        &.is-new { animation: landing-live-pop 900ms cubic-bezier(0.2, 0.9, 0.3, 1.3) both; }
        &.is-out { animation: landing-live-out 800ms ease-in both; }
    }

    .landing-live__region {
        white-space: nowrap;
    }

    @keyframes landing-live-pop {
        0% { opacity: 0; transform: scale(0.86); }
        35% { opacity: 1; transform: scale(1.04); background: color-mix(in srgb, var(--fleet-yellow) 16%, transparent); }
        60% { transform: scale(1); }
        100% { transform: scale(1); background: transparent; }
    }

    @keyframes landing-live-out {
        0% { opacity: 0.6; }
        60% { opacity: 0; max-height: var(--space-xl); }
        100% { opacity: 0; max-height: 0; padding-block: 0; border-bottom-width: 0; }
    }

    @keyframes landing-live-beat {
        50% { opacity: 0.35; }
    }

    @media (prefers-reduced-motion: reduce) {
        .landing-live__row,
        .landing-live__dot {
            animation: none !important;
        }
    }

    @media (max-width: 48rem) {
        .landing-live__region {
            display: none;
        }
    }
</style>
