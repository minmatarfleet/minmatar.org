---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { LandingEvent } from '@dtypes/api.minmatar.org'
import { character_portrait, event_who, subject_icon } from '@helpers/landing'

/**
 * One feed line on one row: portrait, "<pilot> <verb> [icon] <subject> <tail>".
 * The icon is the ship or ore, or the logo of the side we fought (round).
 * A subject with `detail` ("4 ores") shows it on hover or focus.
 * Mining names the pilot's main: a line mined on an alt says so on hover over
 * the name, and one outside high sec is undisclosed (no name, EVE's default
 * portrait).
 */
interface Props {
    event:          LandingEvent;
    size?:          'sm' | 'md';
    /** Let the line wrap instead of cutting it off (the week table). */
    wrap?:          boolean;
    [propName: string]: any;
}

const { event, size = 'sm', wrap = false, ...attributes } = Astro.props

delete attributes.class

// The image server's portrait for a character that doesn't exist is EVE's
// default silhouette.
const DEFAULT_PORTRAIT_ID = 1

const icon = subject_icon(event, 32)
const who = event.undisclosed
    ? t('landing_new.undisclosed_character')
    : event_who(event, t('landing_new.and_others'), t('landing_new.and_other'))
---

<span class:list={['[ landing-line ]', `landing-line--${size}`, { 'landing-line--wrap': wrap }, Astro.props.class]} {...attributes}>
    <img
        class="[ landing-line__portrait ]"
        src={character_portrait(event.undisclosed ? DEFAULT_PORTRAIT_ID : event.character_id, 64)}
        alt=""
        loading="lazy"
    />
    <span class="[ landing-line__text ]">
        {event.on_alt
            ? <strong class="[ landing-line__more ]" data-tippy-content={t('landing_new.mined_on_alt')} tabindex="0">{who}</strong>
            : <strong>{who}</strong>
        }{' '}{event.verb || event.action}
        {event.subject &&
            <>
                {' '}
                {icon &&
                    <img
                        class:list={['[ landing-line__icon ]', { 'landing-line__icon--round': event.subject_type !== 'type' }]}
                        src={icon}
                        alt=""
                        loading="lazy"
                    />
                }
                {event.detail
                    ? <strong class="[ landing-line__more ]" data-tippy-content={event.detail} tabindex="0">{event.subject}</strong>
                    : <strong>{event.subject}</strong>
                }
            </>
        }
        {event.tail && <>{' '}<span class="[ landing-line__tail ]">{event.tail}</span></>}
    </span>
</span>

<style lang="scss">
    .landing-line {
        display: flex;
        align-items: center;
        gap: var(--space-xs);
        min-width: 0;
        white-space: nowrap;
        color: var(--faded);

        strong {
            font-weight: 600;
            color: var(--highlight);
        }
    }

    .landing-line--sm {
        font-size: var(--step--1);

        .landing-line__portrait {
            width: var(--space-m);
            height: var(--space-m);
        }
    }

    .landing-line--md {
        font-size: var(--step-0);

        .landing-line__portrait {
            width: var(--space-l);
            height: var(--space-l);
        }
    }

    .landing-line__portrait {
        flex-shrink: 0;
        object-fit: cover;
        background: var(--surface-sunken);
    }

    .landing-line__text {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .landing-line__more {
        cursor: help;
        text-decoration: underline dotted var(--faded);
        text-underline-offset: 0.2em;
    }

    .landing-line--wrap {
        align-items: flex-start;
        white-space: normal;

        // Each line as tall as the portrait, so the first one sits level
        // with it (and with the table's other cells).
        .landing-line__text {
            line-height: var(--space-m);
        }

        // When the line wraps, "· 14.6M ISK destroyed" moves as one piece.
        .landing-line__tail {
            white-space: nowrap;
        }

        .landing-line__text {
            overflow: visible;
        }
    }

    // Tailwind's preflight makes every img a block, which put the icon on a
    // line of its own between the verb and the subject.
    .landing-line__icon {
        display: inline-block;
        width: 1.5em;
        height: 1.5em;
        margin-inline-end: var(--space-3xs);
        vertical-align: -0.4em;
        object-fit: cover;
        border-radius: 2px;
    }

    .landing-line__icon--round {
        border-radius: 50%;
    }
</style>
