---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { LandingPulse } from '@dtypes/api.minmatar.org'
import { eve_clock, eve_day, format_number } from '@helpers/landing'

interface Props {
    week:           LandingPulse['week'];
    [propName: string]: any;
}

const { week, ...attributes } = Astro.props

delete attributes.class

const rows = [
    { label: t('landing_new.week.ships_destroyed'), value: week.ships_destroyed },
    { label: t('landing_new.week.warzone_sites'), value: week.warzone_sites },
    { label: t('landing_new.week.fleets'), value: week.fleets },
    { label: t('landing_new.week.peak_comms'), value: week.peak_comms, comms: true },
    { label: t('landing_new.week.freight'), value: week.freight_contracts },
    { label: t('landing_new.week.industry'), value: week.industry_jobs },
]

const peak_when = week.peak_comms_at ? `${eve_day(week.peak_comms_at)}, ${eve_clock(week.peak_comms_at)}` : ''
---

<div class:list={['[ landing-week ]', Astro.props.class]} {...attributes}>
    <h3>{t('landing_new.week_heading')}</h3>
    <dl>
        {rows.map((row) =>
            <div class:list={['landing-week__row', { 'landing-week__row--comms': row.comms }]} tabindex={row.comms ? 0 : undefined}>
                <dt>{row.label}</dt>
                <dd>{format_number(row.value)}</dd>
                {row.comms &&
                    <div class="landing-week__tooltip" role="tooltip">
                        <span class="landing-week__tooltip-title">
                            {t('landing_new.comms.at_once').replace('{count}', String(week.peak_comms))}{peak_when && ` · ${peak_when}`}
                        </span>
                        <span><span>{t('landing_new.comms.alliance')}</span><span>{format_number(week.peak_comms)}</span></span>
                        <span><span>{t('landing_new.comms.corporations')}</span><span>{t('landing_new.comms.not_tracked')}</span></span>
                        <span><span>{t('landing_new.comms.militia')}</span><span>{t('landing_new.comms.not_tracked')}</span></span>
                    </div>
                }
            </div>
        )}
    </dl>
</div>

<style lang="scss">
    .landing-week {
        position: relative;
        display: flex;
        flex-direction: column;
        background: var(--component-background);
        border: 1px solid var(--border-color);

        h3 {
            margin: 0;
            padding: var(--space-s) var(--space-m);
            border-bottom: 1px solid var(--border-color);
            font-family: var(--heading-font);
            font-weight: normal;
            font-size: var(--step-1);
            color: var(--highlight);
        }

        dl {
            margin: 0;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }
    }

    .landing-week__row {
        position: relative;
        flex-grow: 1;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--space-s);
        padding: var(--space-xs) var(--space-m);
        border-bottom: 1px solid var(--border-color);

        dt {
            font-size: var(--step--1);
            color: var(--text-muted);
        }

        dd {
            margin: 0;
            font-family: var(--heading-font);
            font-size: var(--step-2);
            color: var(--highlight);
            font-variant-numeric: tabular-nums;
        }
    }

    .landing-week__row--comms {
        cursor: help;

        &:hover .landing-week__tooltip,
        &:focus-visible .landing-week__tooltip {
            display: flex;
        }
    }

    .landing-week__tooltip {
        position: absolute;
        inset-inline-end: var(--space-s);
        top: 100%;
        z-index: 2;
        display: none;
        flex-direction: column;
        gap: var(--space-2xs);
        min-width: 18rem;
        padding: var(--space-xs) var(--space-s);
        background: var(--background);
        border: 1px solid var(--hairline-strong);
        font-size: var(--step--1);
        color: var(--text-muted);

        > span:not(.landing-week__tooltip-title) {
            display: flex;
            justify-content: space-between;
            gap: var(--space-s);

            span:last-child {
                color: var(--highlight);
            }
        }
    }

    .landing-week__tooltip-title {
        font-size: var(--step--2);
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--fleet-yellow);
    }
</style>
