---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { AllianceHealthTrialPilot } from '@dtypes/api.minmatar.org'
import type {
    AllianceHealthOrderOption,
    AllianceHealthPilotListRow,
} from '@helpers/alliance_health_pilot_list'
import { health_confidence_label, health_pilot_card_id } from '@helpers/alliance_health_pilot_list'

import {
    alliance_health_table_params,
    can_promote_alliance_health_trial,
} from '@helpers/api.minmatar.org/alliance_health'
import { query_string } from '@helpers/string'
import AllianceHealthPilotList from '@components/blocks/AllianceHealthPilotList.astro'

interface Props {
    pilots: AllianceHealthTrialPilot[]
    can_promote?: boolean
    officer_corp_ids?: number[]
    alliance_wide?: boolean
    initial_corp?: string
    corp_options?: string[]
    bucket?: string
    partial_url?: string
    [propName: string]: any
}

const {
    pilots,
    can_promote = false,
    officer_corp_ids = [],
    alliance_wide = false,
    initial_corp = 'all',
    corp_options = [],
    bucket = 'current',
    partial_url = translatePath('/partials/alliance_health_trials_component'),
    ...attributes
} = Astro.props
delete attributes.class

const extra_query = alliance_health_table_params({
    bucket,
    corp: initial_corp,
    can_mutate: can_promote,
    alliance_wide,
    officer_corp_ids,
})

const can_act = (pilot: AllianceHealthTrialPilot) =>
    can_promote_alliance_health_trial({
        can_mutate: can_promote,
        bucket,
        alliance_wide,
        officer_corp_ids,
        corporation_id: pilot.corporation_id,
        decision: pilot.decision,
        alliance_days: pilot.alliance_days,
    })

const order_by_options: AllianceHealthOrderOption[] = [
    { id: 'fleets', label: t('alliance.health.col.fleets'), kind: 'number' },
    { id: 'kills', label: t('alliance.health.col.kills'), kind: 'number' },
    { id: 'small', label: t('alliance.health.col.small'), kind: 'number' },
    { id: 'voice', label: t('alliance.health.col.voice'), kind: 'number' },
    { id: 'days', label: t('alliance.health.col.in_alliance'), kind: 'number' },
    { id: 'last', label: t('alliance.health.col.last'), kind: 'number' },
    { id: 'tz', label: t('alliance.health.col.tz'), kind: 'text' },
]

const rows: AllianceHealthPilotListRow[] = pilots.map((pilot) => {
    const conf_label = health_confidence_label(pilot.conf, t)
    return {
    row_id: health_pilot_card_id('trials', pilot.user_id),
    name: pilot.pilot,
    corp: pilot.corp,
    character_id: pilot.character_id,
    corporation_id: pilot.corporation_id,
    search_text: `${pilot.pilot} ${pilot.username} ${pilot.corp} ${pilot.reason} ${pilot.timezone ?? ''} ${conf_label ?? ''}`.toLowerCase(),
    timezone: pilot.timezone,
    note: pilot.reason,
    tags: [pilot.path, conf_label, pilot.slice_30d]
        .filter((text): text is string => !!text && text !== '—')
        .map((text) => ({ text })),
    metrics: [
        {
            id: 'fleets',
            label: t('alliance.health.col.fleets'),
            value: String(pilot.fleets),
            sort: pilot.fleets,
        },
        {
            id: 'kills',
            label: t('alliance.health.col.kills'),
            value: String(pilot.kills),
            sort: pilot.kills,
        },
        {
            id: 'small',
            label: t('alliance.health.col.small'),
            value: String(pilot.kills_small),
            sort: pilot.kills_small,
        },
        {
            id: 'voice',
            label: t('alliance.health.col.voice'),
            value: `${pilot.voice_hours}h`,
            sort: pilot.voice_hours,
        },
        {
            id: 'days',
            label: t('alliance.health.col.in_alliance'),
            value: pilot.alliance_days == null ? '—' : `${pilot.alliance_days}d`,
            sort: pilot.alliance_days ?? '',
            scale: 'none',
        },
        {
            id: 'last',
            label: t('alliance.health.col.last'),
            value:
                pilot.days_since_activity == null
                    ? '—'
                    : `${pilot.days_since_activity}d`,
            sort: pilot.days_since_activity ?? '',
            scale: 'lower',
        },
    ],
    action: can_act(pilot)
        ? {
              label: t('alliance.health.promote'),
              confirm_title: t('alliance.health.promote_confirm_title'),
              confirm_content: `${t('alliance.health.promote_confirm')} ${pilot.pilot}`,
              post_url: `${partial_url}?${query_string({
                  user_id: String(pilot.user_id),
                  action: 'promote',
              })}&${extra_query}`,
              target: `#${health_pilot_card_id('trials', pilot.user_id)}`,
              swap: 'delete',
          }
        : undefined,
    }
})
---

<div class:list={['[ alliance-health-trials ]', Astro.props.class]} {...attributes}>
    <AllianceHealthPilotList
        rows={rows}
        empty_label={t('alliance.health.trials.empty')}
        order_by_options={order_by_options}
        default_order_by="fleets"
        initial_corp={initial_corp}
        corp_options={corp_options}
        csv_filename={`health-trials-${bucket}.csv`}
        url_section="trials"
    />
</div>
