---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { TribeCharacterRef, TribeGroup, SummaryCharacter, TribeMembership, TribeAvailableCharacter } from '@dtypes/api.minmatar.org'
interface Props {
    chief:                  TribeCharacterRef | null;
    elders:                 TribeCharacterRef[];
    user_characters:        SummaryCharacter[];
    tribe_group:            TribeGroup;
    chief_membership:       TribeMembership | null;
    /** The chief shown only stands in: the seat is open (Help wanted). */
    chief_is_interim?:      boolean;
}

const {
    chief,
    elders,
    user_characters,
    tribe_group,
    chief_membership,
    chief_is_interim = false,
} = Astro.props

const membership_character_ids = chief_membership ? chief_membership.characters.map(character => character.character_id) : []
const available_characters = membership_character_ids.length > 0 ?
    user_characters.filter(character => !membership_character_ids?.includes(character.character_id)) :
    user_characters

import Flexblock from '@components/compositions/Flexblock.astro';
import FlexInline from '@components/compositions/FlexInline.astro';

import PilotBadge from '@components/blocks/PilotBadge.astro';
import ButtonAddTribeCharacter from '@components/blocks/ButtonAddTribeCharacter.astro';
import Tag from '@components/blocks/Tag.astro';
---

{chief &&
    <Flexblock gap='var(--space-l)'>
        <FlexInline justification="space-between">
            <h4 class="[ group-title ]">{t('group_leadership')}</h4>
            {chief_is_interim &&
                <Tag text={t('tribes.chief.help_wanted')} color="attention" variant="outline" />
            }
        </FlexInline>

        <FlexInline>
            <PilotBadge
                class="[ pr-(--space-l) ]"
                character_id={chief?.character_id}
                character_name={chief?.character_name}
                size={32}
                centered={true}
            >
                {chief_is_interim ?
                    <small class="[ group-leadership__interim ]">{t('tribes.chief.interim')}</small>
                    :
                    <small>{t('group_chief')}</small>
                }
            </PilotBadge>
            {!chief_is_interim && available_characters.length > 0 &&
                <ButtonAddTribeCharacter
                    id='leader-add-character'
                    title={tribe_group.name}
                    tribe_id={tribe_group.tribe_id}
                    group_id={tribe_group.id}
                    membership_id={chief_membership?.id || null}
                    pilots={available_characters}
                />
            }
        </FlexInline>
    </Flexblock>
}

<style lang="scss">
    .group-leadership__interim {
        color: var(--attention);
    }

    :not([style="display: none;"]) ~ .no-result-text {
        display: none;
    }
</style>