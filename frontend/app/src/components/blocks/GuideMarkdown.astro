---
/**
 * Renders markdown guide HTML with cruiser-guide panel chrome.
 * Pass HTML from `wrapMarkdownSectionsInPanels(pageProgressFromMarkdown(...).html)`.
 *
 * Optional `slot_marker`: when present in `html` and a default slot is provided,
 * the slot is injected between the split HTML parts (for Astro embeds in guides).
 */
import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

import './GuideMarkdown.scss'

interface Props {
    html: string
    slot_marker?: string
    class?: string
    [propName: string]: any
}

const {
    html,
    slot_marker,
    class: class_name,
    ...attributes
} = Astro.props

delete attributes.class

const has_slot = Astro.slots.has('default')
const parts = slot_marker && html.includes(slot_marker)
    ? html.split(slot_marker)
    : null
const html_before = parts?.[0] ?? html
const html_after = parts?.[1] ?? ''

const character_modal_partial = translatePath('/partials/character_modal_component/')
---

<div
    {...attributes}
    class:list={['guide-md', class_name]}
    x-data={`{
        init_guide_md() {
            mediumZoom('.guide-md img', {
                background: 'var(--solid-transparency-background)',
                scrollOffset: 0,
                margin: 24,
                metaClick: false,
            })
        },
        open_character_link(event) {
            const anchor = event.target.closest('a[href]')
            if (!anchor) return

            const href = anchor.getAttribute('href') || ''
            const match = href.match(/\\/characters\\/(\\d+)\\/?/)
            if (!match) return

            event.preventDefault()
            event.stopPropagation()
            show_modal({
                partial: '${character_modal_partial}?character_id=' + match[1],
            })
        },
    }`}
    x-init="init_guide_md()"
    x-on:click="open_character_link($event)"
>
    <Fragment set:html={html_before} />
    {has_slot && parts && <slot />}
    {html_after && <Fragment set:html={html_after} />}
</div>
