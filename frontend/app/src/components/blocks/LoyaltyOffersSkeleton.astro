---
import Flexblock from '@components/compositions/Flexblock.astro'
import FixedFluid from '@components/compositions/FixedFluid.astro'
import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import LoyaltyOffersMetricsSkeleton from '@components/blocks/LoyaltyOffersMetricsSkeleton.astro'
---

<div class="[ loyalty-offers-skeleton ]" aria-hidden="true">
    <Flexblock gap="var(--space-l)">
        <LoyaltyOffersMetricsSkeleton />
        <ComponentBlock
            class="[ loyalty-offers-skeleton__body ]"
            padding_block="var(--space-s)"
            padding_inline="var(--space-s)"
        >
            <FixedFluid width="16rem" breakpoint="65%" gap="var(--space-m)">
                <div class="[ loyalty-offers-skeleton__rail ]">
                    {Array.from({ length: 4 }).map(() => (
                        <div class="[ loyalty-offers-skeleton__group ]">
                            <div class="[ skel loyalty-offers-skeleton__legend ]"></div>
                            <div class="[ skel loyalty-offers-skeleton__control ]"></div>
                        </div>
                    ))}
                </div>
                <div class="[ loyalty-offers-skeleton__table ]">
                    <div class="[ skel loyalty-offers-skeleton__header ]"></div>
                    {Array.from({ length: 8 }).map(() => (
                        <div class="[ skel loyalty-offers-skeleton__row ]"></div>
                    ))}
                </div>
            </FixedFluid>
        </ComponentBlock>
    </Flexblock>
</div>

<style lang="scss">
    @use '../../styles/mixins/skeleton';

    .skel {
        border-radius: 2px;
        @include skeleton.pulse(color-mix(in srgb, var(--component-background) 70%, var(--foreground)));
    }

    .loyalty-offers-skeleton__rail {
        display: flex;
        flex-direction: column;
        gap: var(--space-m);
        padding: var(--space-s);
        border: solid 1px var(--border-color);
    }

    .loyalty-offers-skeleton__group {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
    }

    .loyalty-offers-skeleton__legend {
        width: 6rem;
        height: var(--step--2);
    }

    .loyalty-offers-skeleton__control {
        width: 100%;
        height: var(--space-l);
    }

    .loyalty-offers-skeleton__table {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
    }

    .loyalty-offers-skeleton__header {
        height: var(--space-m);
        width: 100%;
    }

    .loyalty-offers-skeleton__row {
        height: var(--space-xl);
        width: 100%;
    }
</style>
