---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { TrainingBring, TrainingBringDoctrine } from '@dtypes/api.minmatar.org'
import { TRAINING_DOCTRINE_PARTIAL, time_label, training_url } from '@helpers/training'

import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import EmptyState from '@components/blocks/EmptyState.astro'
import XFadeScroll from '@components/compositions/XFadeScroll.astro'

/**
 * "What you can bring": one row per doctrine, one cell per role. A pilot with
 * two or more seats (accounts, or characters on no account) sees how many
 * ships they can bring at once (×2); a pilot with one sees ✓. A role nobody
 * flies yet shows how soon someone will. Cells open the role by account.
 */
interface Props {
    bring:              TrainingBring;
    [propName: string]: any;
}

const {
    bring,
    ...attributes
} = Astro.props

delete attributes.class

type Cell = TrainingBringDoctrine['cells'][number]

const multi = bring.seats > 1

const groups = [
    { title: t('training.strategic'), doctrines: bring.doctrines.filter(doctrine => doctrine.strategic) },
    { title: t('training.other_doctrines'), doctrines: bring.doctrines.filter(doctrine => !doctrine.strategic) },
].filter(group => group.doctrines.length > 0)

const open_cell = (doctrine:TrainingBringDoctrine, column:string) =>
    `show_modal({ partial: '${translatePath(training_url(TRAINING_DOCTRINE_PARTIAL, { doctrine_id: doctrine.doctrine_id, column }))}' })`

const fill = (text:string, values:Record<string, string | number>) =>
    Object.entries(values).reduce((out, [key, value]) => out.replace(`{${key}}`, value.toString()), text)

const roles = (doctrine:TrainingBringDoctrine) => doctrine.cells.filter(cell => cell.state !== 'none')

const subtitle = (doctrine:TrainingBringDoctrine) => {
    if (multi)
        return doctrine.seats > 0 ? fill(t('training.bring_at_once'), { count: doctrine.seats }) : t('training.bring_none')

    const total = roles(doctrine).length
    const ready = roles(doctrine).filter(cell => cell.seats > 0).length
    return ready === total ? t('training.every_role_ready') : fill(t('training.roles_ready'), { ready, total })
}

const cell_text = (cell:Cell) =>
    cell.seats > 0 ? (multi ? `×${cell.seats}` : '✓')
    : cell.days !== null ? time_label(t, cell.days)
    : t('training.nobody_close')

const cell_label = (doctrine:TrainingBringDoctrine, cell:Cell) => {
    const values = {
        doctrine: doctrine.name,
        role: cell.column,
        count: cell.seats,
        time: cell.days !== null ? time_label(t, cell.days) : '',
    }
    if (cell.seats > 0)
        return fill(t(multi ? 'training.cell_count' : 'training.cell_ready_one'), values)
    return fill(t(cell.days !== null ? 'training.cell_wait' : 'training.cell_nobody'), values)
}
---

<ComponentBlock padding_block="0" padding_inline="0" class:list={['[ training-bring ]', Astro.props.class]} {...attributes}>
    {bring.doctrines.length === 0 ?
        <EmptyState title={t('training.no_doctrines')} />
        :
        <>
            <XFadeScroll class="[ training-bring__wide ]">
                <table style={`--bring-columns: ${bring.columns.length}`}>
                    <thead>
                        <tr>
                            <th scope="col">{t('training.col_doctrine')}</th>
                            {bring.columns.map(column => <th scope="col">{column}</th>)}
                        </tr>
                    </thead>
                    {groups.map(group =>
                        <tbody>
                            <tr class="[ training-bring__group ]">
                                <th scope="colgroup" colspan={bring.columns.length + 1}>{group.title}</th>
                            </tr>
                            {group.doctrines.map(doctrine =>
                                <tr class="[ training-bring__row ]">
                                    <th scope="row">
                                        <span class="[ training-bring__doctrine ]">
                                            <strong>{doctrine.name}</strong>
                                            <small>{subtitle(doctrine)}</small>
                                        </span>
                                    </th>
                                    {doctrine.cells.map(cell =>
                                        <td>
                                            {cell.state === 'none' ?
                                                <span class="[ training-bring__none ]" aria-label={t('training.cell_none')}>—</span>
                                                :
                                                <button
                                                    type="button"
                                                    class:list={['[ training-bring__cell ]', { wait: cell.seats === 0 }]}
                                                    aria-label={cell_label(doctrine, cell)}
                                                    title={cell_label(doctrine, cell)}
                                                    x-on:click={open_cell(doctrine, cell.column)}
                                                >
                                                    {cell_text(cell)}
                                                </button>
                                            }
                                        </td>
                                    )}
                                </tr>
                            )}
                        </tbody>
                    )}
                </table>
            </XFadeScroll>

            <div class="[ training-bring__narrow ]">
                {groups.map(group =>
                    <section>
                        <h3>{group.title}</h3>
                        {group.doctrines.map(doctrine =>
                            <details>
                                <summary>
                                    <span class="[ training-bring__doctrine ]">
                                        <strong>{doctrine.name}</strong>
                                        <small>{subtitle(doctrine)}</small>
                                    </span>
                                </summary>
                                <ul role="list">
                                    {roles(doctrine).map(cell =>
                                        <li>
                                            <button
                                                type="button"
                                                aria-label={cell_label(doctrine, cell)}
                                                x-on:click={open_cell(doctrine, cell.column)}
                                            >
                                                <span>{cell.column}</span>
                                                <span class:list={['[ training-bring__cell ]', { wait: cell.seats === 0 }]}>{cell_text(cell)}</span>
                                            </button>
                                        </li>
                                    )}
                                </ul>
                            </details>
                        )}
                    </section>
                )}
            </div>
        </>
    }
</ComponentBlock>

<style lang="scss">
    table {
        width: 100%;
        min-width: calc(16rem + var(--bring-columns) * 7.5rem);
        border-collapse: collapse;
        table-layout: fixed;
    }

    thead th:first-child {
        width: 16rem;
    }

    thead th {
        padding: var(--space-xs) var(--space-s);
        font-size: var(--step--2);
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-muted);
        text-align: center;

        &:first-child {
            text-align: start;
        }
    }

    .training-bring__group th {
        padding: var(--space-s) var(--space-s) var(--space-2xs);
        border-top: 1px solid var(--hairline);
        font-family: var(--heading-font);
        font-size: var(--step--1);
        font-weight: normal;
        letter-spacing: 0.06em;
        color: var(--text-muted);
        text-align: start;
    }

    .training-bring__row {
        border-top: 1px solid var(--hairline);
        transition: var(--fast-transition);

        &:hover {
            background: var(--surface-sunken);
        }
    }

    tbody th[scope="row"],
    td {
        padding: var(--space-2xs) var(--space-s);
    }

    td {
        text-align: center;
    }

    .training-bring__doctrine {
        display: flex;
        flex-direction: column;
        color: var(--highlight);
        text-align: start;

        strong {
            font-weight: 600;
        }

        small {
            font-size: var(--step--2);
            font-weight: normal;
            color: var(--text-muted);
        }
    }

    /* One flat green for any count: a number is a number, not a grade. */
    .training-bring__cell {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 4rem;
        min-height: 2.5rem;
        padding-inline: var(--space-2xs);
        border: 1px solid transparent;
        border-radius: var(--space-3xs);
        background: color-mix(in srgb, var(--green) 30%, transparent);
        color: var(--highlight);
        font-size: var(--step-0);
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;

        &.wait {
            border-color: color-mix(in srgb, var(--fleet-yellow) 35%, transparent);
            background: none;
            color: var(--fleet-yellow);
            font-size: var(--step--1);
            font-weight: 600;
        }
    }

    button.training-bring__cell {
        cursor: pointer;
        transition: var(--fast-transition);

        &:hover {
            outline: 2px solid var(--hairline-strong);
            outline-offset: 1px;
        }
    }

    .training-bring__none {
        color: var(--text-muted);
    }

    .training-bring__narrow {
        display: none;

        h3 {
            padding: var(--space-s) var(--space-s) var(--space-3xs);
            font-family: var(--heading-font);
            font-size: var(--step--1);
            letter-spacing: 0.06em;
            color: var(--text-muted);
        }

        details {
            border-top: 1px solid var(--hairline);
        }

        summary {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: var(--space-xs);
            min-height: 3.5rem;
            padding: var(--space-3xs) var(--space-s);
            cursor: pointer;
            list-style: none;

            &::-webkit-details-marker {
                display: none;
            }

            &::after {
                content: '›';
                font-size: var(--step-1);
                color: var(--text-muted);
                transition: var(--fast-transition);
            }
        }

        details[open] summary::after {
            transform: rotate(90deg);
        }

        ul {
            margin: 0;
            padding: 0 var(--space-s) var(--space-xs);
            list-style: none;
        }

        li button {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            min-height: 3rem;
            padding: 0;
            border: 0;
            background: none;
            color: var(--highlight);
            text-align: start;
            cursor: pointer;
        }
    }

    @media (max-width: 48rem) {
        .training-bring__wide {
            display: none;
        }

        .training-bring__narrow {
            display: block;
        }
    }
</style>
