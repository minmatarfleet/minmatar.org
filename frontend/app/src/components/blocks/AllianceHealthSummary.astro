---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { AllianceHealthOverview } from '@dtypes/api.minmatar.org'

import Flexblock from '@components/compositions/Flexblock.astro'
import CampaignStat from '@components/blocks/campaigns/etherium-reach/CampaignStat.astro'
import CountUpAnimation from '@components/blocks/CountUpAnimation.astro'

interface Props {
    overview: AllianceHealthOverview
    [propName: string]: any
}

const { overview, ...attributes } = Astro.props
delete attributes.class

const at_risk = overview.quiet.fading + overview.quiet.dark
const hygiene = overview.hygiene ?? {
    trial: { approve: 0, too_early: 0, fail: 0, nudge: 0, hold: 0 },
    leave: { recommended: 0, kept: 0, exempt: 0 },
}
---

<section
    class:list={['[ alliance-health-summary ]', Astro.props.class]}
    aria-label={t('alliance.health.summary.aria')}
>
    <Flexblock gap="var(--space-m)">
        <Flexblock gap="var(--space-3xs)">
            <h2>{t('alliance.health.summary.title')}</h2>
            <small>{t('alliance.health.summary.caption')}</small>
        </Flexblock>

        <div class="[ alliance-health-summary__stats ]">
            <CampaignStat label={t('alliance.health.total_pilots')}>
                <CountUpAnimation element="span" target={overview.roster_people} />
            </CampaignStat>
            <CampaignStat label={t('alliance.health.active_pilots')} tone="success">
                <CountUpAnimation element="span" target={overview.map_30d} />
            </CampaignStat>
            <CampaignStat
                label={t('alliance.health.at_risk')}
                tone={at_risk > 0 ? 'danger' : 'success'}
            >
                <CountUpAnimation element="span" target={at_risk} />
            </CampaignStat>
            <CampaignStat
                label={t('alliance.health.come_off_trial')}
                tone={hygiene.trial.approve > 0 ? 'success' : undefined}
            >
                <CountUpAnimation element="span" target={hygiene.trial.approve} />
            </CampaignStat>
            <CampaignStat label={t('alliance.health.too_early')}>
                <CountUpAnimation element="span" target={hygiene.trial.too_early} />
            </CampaignStat>
            <CampaignStat
                label={t('alliance.health.fail_trial')}
                tone={hygiene.trial.fail > 0 ? 'danger' : undefined}
            >
                <CountUpAnimation element="span" target={hygiene.trial.fail} />
            </CampaignStat>
            <CampaignStat
                label={t('alliance.health.ceo_nudge')}
                tone={hygiene.trial.nudge > 0 ? 'info' : undefined}
            >
                <CountUpAnimation element="span" target={hygiene.trial.nudge} />
            </CampaignStat>
            <CampaignStat
                label={t('alliance.health.put_on_leave')}
                tone={hygiene.leave.recommended > 0 ? 'danger' : undefined}
            >
                <CountUpAnimation
                    element="span"
                    target={hygiene.leave.recommended}
                />
            </CampaignStat>
        </div>
    </Flexblock>
</section>

<style lang="scss">
    h2 {
        margin: 0;
    }

    small {
        color: var(--faded);
    }

    .alliance-health-summary__stats {
        display: grid;
        width: 100%;
        gap: var(--space-3xs);
        grid-template-columns: repeat(4, minmax(0, 1fr));

        :global(.card),
        :global(.wrapper) {
            min-width: 0;
            width: 100%;
            max-width: none;
        }
    }

    @media (max-width: 1100px) {
        .alliance-health-summary__stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 600px) {
        .alliance-health-summary__stats {
            grid-template-columns: 1fr;
        }
    }
</style>
