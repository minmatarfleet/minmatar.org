---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { query_string } from '@helpers/string'

interface Props {
    is_history?: boolean;
}

const {
    is_history = false,
} = Astro.props

const BUYBACK_CONTRACTS_PARTIAL_URL = translatePath(`/partials/buyback_contracts_component?${query_string({
    is_history,
})}`)

import Viewport from '@layouts/Viewport.astro'
import PageWide from '@components/page/PageWide.astro'
import PageTitle from '@components/page/PageTitle.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import BuybackContractsSkeleton from '@components/blocks/BuybackContractsSkeleton.astro'
import LazyPartial from '@components/blocks/LazyPartial.astro'

const page_title = is_history
    ? t('buyback_contracts.history.page_title')
    : t('buyback_contracts.page_title')

const meta_description = is_history
    ? t('buyback_contracts.history.meta_description')
    : t('buyback_contracts.meta_description')

const breadcrumbs = is_history
    ? [
        { page_title: t('buyback.page_title'), accumulated_path: '/market/buyback/' },
        { page_title: t('buyback_contracts.page_title'), accumulated_path: '/market/buyback/contracts/' },
        { page_title: page_title, accumulated_path: Astro.url.pathname },
    ]
    : [
        { page_title: t('buyback.page_title'), accumulated_path: '/market/buyback/' },
        { page_title: page_title, accumulated_path: Astro.url.pathname },
    ]
---

<Viewport
    title={page_title}
    meta_description={meta_description}
    components={{
        tippy: true,
    }}
>
    <PageWide
        cover={{
            image: '/images/buyback-cover.jpg',
            image_990: '/images/buyback-cover.jpg',
            animated: false,
            scrollable: true,
            overlay: true,
        }}
        sticky={true}
        breadcrumbs={breadcrumbs}
        x-data={`{
            contracts_count: 0,
            last_updated_text: '',
            contracts_plural: '${t('showing_contracts_plural')}',
            contracts_singular: '${t('showing_contracts_singular')}',
        }`}
    >
        <FlexInline slot="header" justification='space-between' class="[ w-full ]">
            <Flexblock gap="var(--space-s)">
                <Flexblock gap="var(--space-3xs)">
                    <PageTitle>
                        {page_title}
                    </PageTitle>
                    <small
                        x-show="contracts_count > 0"
                        x-text="(contracts_count != 1 ? contracts_plural : contracts_singular).replace('{count}', String(contracts_count))"
                        style="display: none;"
                    ></small>
                    <small x-show="last_updated_text" x-text="last_updated_text" style="display: none;"></small>
                </Flexblock>
            </Flexblock>
        </FlexInline>

        <LazyPartial
            id="buyback-contracts-slot"
            data-buyback-contracts-deferred="1"
            url={BUYBACK_CONTRACTS_PARTIAL_URL}
        >
            <BuybackContractsSkeleton
                show_metrics={!is_history}
                show_history_cta={!is_history}
            />
        </LazyPartial>
    </PageWide>
</Viewport>

