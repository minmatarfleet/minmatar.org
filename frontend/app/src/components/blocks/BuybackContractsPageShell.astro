---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { query_string } from '@helpers/string'

interface Props {
    is_history?: boolean;
}

const {
    is_history = false,
} = Astro.props

const BUYBACK_CONTRACTS_PARTIAL_URL = translatePath(`/partials/buyback_contracts_component?${query_string({
    is_history,
})}`)

import Viewport from '@layouts/Viewport.astro'
import PageWide from '@components/page/PageWide.astro'
import PageTitle from '@components/page/PageTitle.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import Breadcrumb from '@components/blocks/Breadcrumb.astro'
import BuybackContractsSkeleton from '@components/blocks/BuybackContractsSkeleton.astro'

const page_title = is_history
    ? t('buyback_contracts.history.page_title')
    : t('buyback_contracts.page_title')

const meta_description = is_history
    ? t('buyback_contracts.history.meta_description')
    : t('buyback_contracts.meta_description')

const breadcrumb_items = is_history
    ? [
        { label: t('buyback.page_title'), href: translatePath('/market/buyback/') },
        { label: t('buyback_contracts.page_title'), href: translatePath('/market/buyback/contracts/') },
    ]
    : [
        { label: t('buyback.page_title'), href: translatePath('/market/buyback/') },
    ]
---

<Viewport
    title={page_title}
    meta_description={meta_description}
    components={{
        tippy: true,
    }}
>
    <PageWide
        cover={{
            image: '/images/mining-cover.webp',
            image_990: '/images/mining-cover.jpg',
            animated: false,
            scrollable: true,
            overlay: true,
        }}
        sticky={true}
        x-data={`{
            contracts_count: 0,
            last_updated_text: '',
            contracts_plural: '${t('showing_contracts_plural')}',
            contracts_singular: '${t('showing_contracts_singular')}',
        }`}
    >
        <FlexInline slot="header" justification='space-between' class="[ w-full ]">
            <Flexblock gap="var(--space-s)">
                <Breadcrumb items={breadcrumb_items} />
                <Flexblock gap="var(--space-3xs)">
                    <PageTitle>
                        {page_title}
                    </PageTitle>
                    <small
                        x-show="contracts_count > 0"
                        x-text="(contracts_count != 1 ? contracts_plural : contracts_singular).replace('{count}', String(contracts_count))"
                        style="display: none;"
                    ></small>
                    <small x-show="last_updated_text" x-text="last_updated_text" style="display: none;"></small>
                </Flexblock>
            </Flexblock>
        </FlexInline>

        <div
            id="buyback-contracts-slot"
            data-buyback-contracts-deferred="1"
            hx-get={BUYBACK_CONTRACTS_PARTIAL_URL}
            hx-trigger="load"
            hx-swap="innerHTML"
            hx-indicator=".loader"
            aria-busy="true"
            aria-live="polite"
        >
            <BuybackContractsSkeleton
                show_metrics={!is_history}
                show_history_cta={!is_history}
            />
        </div>
    </PageWide>
</Viewport>

<script>
    function refreshBuybackContractsSlot() {
        const slot = document.getElementById('buyback-contracts-slot')
        if (!slot)
            return

        slot.setAttribute('aria-busy', 'false')
        if (typeof htmx !== 'undefined')
            htmx.process(slot)
        if (typeof Alpine !== 'undefined')
            Alpine.initTree(slot)
        if (typeof tippy === 'function') {
            tippy('#buyback-contracts-slot [data-tippy-content]', {
                delay: [100, 200],
                arrow: true,
            })
        }
    }

    function isBuybackContractsRequest(event: any): boolean {
        const path = String(
            event.detail?.pathInfo?.requestPath
                || event.detail?.xhr?.responseURL
                || event.detail?.elt?.getAttribute?.('hx-get')
                || '',
        )
        return path.includes('buyback_contracts_component')
    }

    function bindBuybackContractsDeferred() {
        const slot = document.getElementById('buyback-contracts-slot')
        if (!slot || slot.dataset.bound === '1')
            return
        slot.dataset.bound = '1'

        document.body.addEventListener('htmx:afterSwap', (event: any) => {
            if (!isBuybackContractsRequest(event))
                return
            refreshBuybackContractsSlot()
        })

        document.body.addEventListener('htmx:afterRequest', (event: any) => {
            if (!isBuybackContractsRequest(event))
                return
            if (!event.detail?.successful) {
                document.getElementById('buyback-contracts-slot')?.setAttribute('aria-busy', 'false')
            }
        })
    }

    bindBuybackContractsDeferred()
    document.addEventListener('astro:page-load', bindBuybackContractsDeferred)
</script>
