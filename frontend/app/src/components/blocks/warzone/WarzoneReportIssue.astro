        </header>

        <Grid min_item_width="16rem" row_gap="var(--space-m)" column_gap="var(--space-m)" class="[ wz-equal wz-steps ]">
            {issue.get_involved.steps.map((step, index) => (
                <ComponentBlock padding_inline="var(--space-m)" padding_block="var(--space-m)" class="[ wz-step ]">
                    <Flexblock gap="var(--space-m)" class="[ h-full ]">
                        <div class="[ wz-step__head ]">
                            <span class="[ wz-step__number ]" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
