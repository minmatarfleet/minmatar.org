---
import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

import type { WarzoneIssue, WarzoneMilitiaId } from '@/data/warzone/types'

import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import Button from '@components/blocks/Button.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import Grid from '@components/compositions/Grid.astro'
import MinmatarLogo from '@components/logos/MinmatarLogo.astro'
import AmarrLogo from '@components/logos/AmarrLogo.astro'
import CharacterPicture from '@components/blocks/CharacterPicture.astro'
import ItemPicture from '@components/blocks/ItemPicture.astro'
import GuidePostCard from '@components/blocks/GuidePostCard.astro'
import { getPublishedGuides } from '@/data/guides'
import { get_alliance_logo, get_corporation_logo } from '@helpers/eve_image_server'
import { existsSync } from 'node:fs'
import { fileURLToPath } from 'node:url'
import { LEARNING_HUB_PATH } from '@/data/guides/urls'
import { number_thousand_separator } from '@helpers/numbers'

interface Props {
    issue: WarzoneIssue
}

const { issue } = Astro.props

function militia_label(id: WarzoneMilitiaId): string {
    return id === 'minmatar' ? 'Minmatar' : 'Amarr'
}

function format_signed(value: number): string {
    if (value > 0) return `+${number_thousand_separator(value)}`
    if (value < 0) return `−${number_thousand_separator(Math.abs(value))}`
    return '0'
}

function format_isk(value: number): string {
    if (value >= 1_000_000_000_000) return `${(value / 1_000_000_000_000).toFixed(2)}T`
    if (value >= 100_000_000_000) return `${Math.round(value / 1_000_000_000)}B`
    if (value >= 1_000_000_000) return `${(value / 1_000_000_000).toFixed(2)}B`
    return `${(value / 1_000_000).toFixed(0)}M`
}

function percent(part: number, total: number): number {
    return total === 0 ? 0 : Math.round((part / total) * 1000) / 10
}

function is_external(href: string): boolean {
    return href.startsWith('http://') || href.startsWith('https://')
}

function resolve_href(href: string): string {
    return is_external(href) ? href : translatePath(href)
}

const vs_label = `vs ${issue.previous_period_label}`

const MONTHS = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec']
function date_sort_key(label: string): number {
    const match = label.match(/(\d{1,2})\s+([A-Za-z]{3})/)
    if (!match) return 0
    const day = Number(match[1])
    const month = MONTHS.indexOf(match[2].toLowerCase())
    return (month < 0 ? 0 : month) * 100 + day
}
const occupancy_sorted = [...issue.occupancy].sort((a, b) => date_sort_key(a.date_label) - date_sort_key(b.date_label))

const minmatar = issue.scoreboard.find((side) => side.militia === 'minmatar')!
const amarr = issue.scoreboard.find((side) => side.militia === 'amarr')!
const total_systems = minmatar.systems_held + amarr.systems_held
const minmatar_share = percent(minmatar.systems_held, total_systems)
const amarr_share = 100 - minmatar_share

const compare_rows = [
    {
        label: 'Enlisted pilots',
        minmatar: minmatar.enlisted_pilots,
        amarr: amarr.enlisted_pilots,
        minmatar_label: minmatar.enlisted_pilots_label,
        amarr_label: amarr.enlisted_pilots_label,
    },
    {
        label: 'Active pilots',
        minmatar: minmatar.active_pilots,
        amarr: amarr.active_pilots,
        minmatar_label: minmatar.active_pilots_label,
        amarr_label: amarr.active_pilots_label,
    },
    {
        label: 'Kills',
        minmatar: minmatar.kills_last_week,
        amarr: amarr.kills_last_week,
        minmatar_label: number_thousand_separator(minmatar.kills_last_week),
        amarr_label: number_thousand_separator(amarr.kills_last_week),
    },
].map((row) => {
    const max = Math.max(row.minmatar, row.amarr)
    return {
        ...row,
        minmatar_pct: percent(row.minmatar, max),
        amarr_pct: percent(row.amarr, max),
        leader: row.minmatar === row.amarr ? null : row.minmatar > row.amarr ? 'minmatar' : 'amarr',
    }
})

const max_traffic = Math.max(...issue.traffic.map((row) => row.ships))

const front_total = issue.fronts.reduce((sum, front) => sum + front.ships, 0)

const focus = issue.focus
const focus_loss_max = Math.max(focus.minmatar_ships, focus.amarr_ships, focus.other_ships)
const engagement_total = focus.engagement_mix.reduce((sum, slice) => sum + slice.value, 0)
const engagement_colors = ['rgba(255, 255, 255, 0.85)', 'rgba(255, 255, 255, 0.45)', 'rgba(255, 255, 255, 0.2)']

/** Custom alliance logos for groups CCP/zKill has no logo for yet. Transparent PNGs. */
/** Pirate factions have no SVG emblem in-repo; fall back to their NPC corp logo. */
const PIRATE_LOGO_CORP: Record<number, number> = {
    500011: 1_000_138, // Angel Cartel
    500010: 1_000_127, // Guristas
}

const GROUP_LOGO_OVERRIDES: Record<number, string> = {
    99_015_016: '/images/warzone/logos/slide-on-contact.png', // Slide On Contact
    99_014_920: '/images/warzone/logos/spaghetti-n-meatballs.png', // Spaghetti N' Meatballs
}

// Only use an override once the transparent PNG is actually in /public.
const group_logo_override = (id: number): string | undefined => {
    const relative = GROUP_LOGO_OVERRIDES[id]
    if (!relative) return undefined
    const on_disk = fileURLToPath(new URL(`../../../../public${relative}`, import.meta.url))
    return existsSync(on_disk) ? relative : undefined
}

const published_guides = getPublishedGuides()
const featured_guides = issue.get_involved.featured_guides
    .map((slug) => published_guides.find((guide) => guide.slug === slug))
    .filter((guide): guide is NonNullable<typeof guide> => Boolean(guide))

---

<div class="[ warzone-report ]">
    <div class="[ wz-lede ]">
        <div class="[ wz-hero-stats ]">
            <div class="[ wz-hero-stat ]">
                <span class="[ wz-hero-stat__icon ]" aria-hidden="true">
                    <img src="/images/icons/64px-Sovereignty.png" alt="" width="64" height="64" loading="lazy" />
                </span>
                <div>
                    <span class="[ wz-hero-stat__label ]">Systems flipped</span>
                    <b class="[ wz-hero-stat__value ]">{issue.occupancy_changes}</b></span>
                </div>
            </div>
            <div class="[ wz-hero-stat ]">
                <span class="[ wz-hero-stat__icon ]" aria-hidden="true">
                    <img src="/images/icons/64px-Killreport.png" alt="" width="64" height="64" loading="lazy" />
                </span>
                <div>
                    <span class="[ wz-hero-stat__label ]">Ships destroyed</span>
                    <b class="[ wz-hero-stat__value ]">{number_thousand_separator(issue.sampled_ships)}</b>
                </div>
            </div>
            <div class="[ wz-hero-stat ]">
                <span class="[ wz-hero-stat__icon ]" aria-hidden="true">
                    <img src="/images/icons/64px-Wallet.png" alt="" width="64" height="64" loading="lazy" />
                </span>
                <div>
                    <span class="[ wz-hero-stat__label ]">ISK destroyed</span>
                    <b class="[ wz-hero-stat__value ]">{format_isk(issue.sampled_isk)}</b>
                </div>
            </div>
            <div class="[ wz-hero-stat ]">
                <span class="[ wz-hero-stat__icon ]" aria-hidden="true">
                    <img src="/images/icons/64px-Warreport.png" alt="" width="64" height="64" loading="lazy" />
                </span>
                <div>
                    <span class="[ wz-hero-stat__label ]">Focus story</span>
                    <b class="[ wz-hero-stat__value ]">{issue.focus_name}</b>
                </div>
            </div>
        </div>

    </div>

    <section id="scoreboard" class="[ wz-section ]">
        <header class="[ wz-section__head ]">
            <h2>Scoreboard</h2>
            <p class="[ wz-dek ]">
                Who holds the map, and how hard each militia fought in the most
                recent week of public data.
            </p>
        </header>

        <ComponentBlock>
            <div class="[ wz-versus ]">
                <div class="[ wz-versus__side wz-versus__side--minmatar ]">
                    <span class="[ wz-versus__logo ]" aria-hidden="true"><MinmatarLogo /></span>
                    <div>
                        <h3>Minmatar</h3>
                    </div>
                </div>
                <div class="[ wz-versus__side wz-versus__side--amarr ]">
                    <span class="[ wz-versus__logo ]" aria-hidden="true"><AmarrLogo /></span>
                    <div>
                        <h3>Amarr</h3>
                        <span class="[ wz-versus__net ]">{format_signed(amarr.occupancy_net)} systems this month</span>
                    </div>
                </div>
            </div>

            <div class="[ wz-split ]" role="img" aria-label={`Minmatar hold ${minmatar.systems_held} systems, Amarr hold ${amarr.systems_held}, of ${total_systems}`}>
                <b class="[ wz-split__value wz-minmatar-text ]">{minmatar.systems_held}</b>
                <div class="[ wz-split__bar ]">
                    <span class="[ wz-split__fill wz-split__fill--minmatar ]" style={`width: ${minmatar_share}%`}></span>
                    <span class="[ wz-split__fill wz-split__fill--amarr ]" style={`width: ${amarr_share}%`}></span>
                </div>
                <b class="[ wz-split__value wz-amarr-text ]">{amarr.systems_held}</b>
            </div>

            <div class="[ wz-compare ]">
                {compare_rows.map((row) => (
                    <div class="[ wz-compare__row ]">
                        <b class:list={['wz-compare__value wz-compare__value--minmatar', row.leader === 'minmatar' && 'is-leader']}>{row.minmatar_label}</b>
                        <span class="[ wz-compare__label ]">{row.label}</span>
                        <b class:list={['wz-compare__value wz-compare__value--amarr', row.leader === 'amarr' && 'is-leader']}>{row.amarr_label}</b>
                    </div>
                ))}
            </div>
        </ComponentBlock>
    </section>

    <section id="systems" class="[ wz-section ]">
        <header class="[ wz-section__head ]">
            <h2>Systems</h2>
        </header>

        <Flexblock gap="var(--space-m)">
            <div class="[ wz-subhead ]">
                <h3>Occupancy changes</h3>
            </div>

            <div class="[ wz-table-wrap ]" tabindex="0" role="region" aria-label="Systems that changed hands">
                <table class="[ wz-table wz-table--flips ]">
                    <thead>
                        <tr>
                            <th scope="col">When</th>
                            <th scope="col">System</th>
                            <th scope="col">Previous owner</th>
                            <th scope="col">New owner</th>
                            <th scope="col" class="[ wz-table__num ]">Ships</th>
                            <th scope="col" class="[ wz-table__num ]">{vs_label}</th>
                            <th scope="col" class="[ wz-table__num ]">ISK</th>
                        </tr>
                    </thead>
                    <tbody>
                        {occupancy_sorted.map((change) => {
                            const previous_owner = change.taken_by === 'amarr' ? 'minmatar' : 'amarr'
                            return (
                                <tr>
                                    <td class="[ wz-table__when ]">{change.date_label}</td>
                                    <td class="[ wz-table__flip-system ]">
                                        <span class="[ wz-table__system ]">{change.system}</span>
                                    </td>
                                    <td data-label="Previous owner">
                                        <span class="[ wz-owner ]">
                                            <span class:list={['wz-faction-mark', `wz-faction-mark--${previous_owner}`]} aria-hidden="true">
                                                {previous_owner === 'minmatar' ? <MinmatarLogo /> : <AmarrLogo />}
                                            </span>
                                            <span>{militia_label(previous_owner)}</span>
                                        </span>
                                    </td>
                                    <td data-label="New owner">
                                        <span class="[ wz-owner ]">
                                            <span class:list={['wz-faction-mark', `wz-faction-mark--${change.taken_by}`]} aria-hidden="true">
                                                {change.taken_by === 'minmatar' ? <MinmatarLogo /> : <AmarrLogo />}
                                            </span>
                                            <span>{militia_label(change.taken_by)}</span>
                                        </span>
                                    </td>
                                    <td class="[ wz-table__num ]" data-label="Ships"><b>{number_thousand_separator(change.ships)}</b></td>
                                    <td class="[ wz-table__num ]" data-label={vs_label}>
                                        <span class:list={['wz-delta', change.vs_last_month >= 0 ? 'wz-delta--up' : 'wz-delta--down']}>
                                            <span class="[ wz-delta__arrow ]">{change.vs_last_month >= 0 ? '▲' : '▼'}</span>
                                            <span class="[ wz-delta__num ]">{number_thousand_separator(Math.abs(change.vs_last_month))}</span>
                                        </span>
                                    </td>
                                    <td class="[ wz-table__num ]" data-label="ISK">{change.isk_label}</td>
                                </tr>
                            )
                        })}
                    </tbody>
                </table>
            </div>
        </Flexblock>

        <Flexblock gap="var(--space-m)">
            <div class="[ wz-subhead ]">
                <h3>Where the ships died</h3>
                <p>Ships destroyed per system this month.</p>
            </div>
            <div class="[ wz-table-wrap ]" tabindex="0" role="region" aria-label="Ships destroyed by system">
                <table class="[ wz-table wz-table--traffic ]">
                    <thead>
                        <tr>
                            <th scope="col">System</th>
                            <th scope="col" class="[ wz-table__bar-head ]">Ships destroyed</th>
                            <th scope="col" class="[ wz-table__num ]">{vs_label}</th>
                            <th scope="col" class="[ wz-table__num ]">ISK</th>
                        </tr>
                    </thead>
                    <tbody>
                        {issue.traffic.map((row) => (
                            <tr>
                                <td>
                                    <span class="[ wz-table__owner ]">
                                        <span class:list={['wz-faction-mark', `wz-faction-mark--${row.holds_today}`]} title={`Held by ${militia_label(row.holds_today)}`} aria-label={`Held by ${militia_label(row.holds_today)}`} role="img">
                                            {row.holds_today === 'minmatar' ? <MinmatarLogo /> : <AmarrLogo />}
                                        </span>
                                        <span>
                                            <span class="[ wz-table__system ]">
                                                {row.href ? (
                                                    <a href={row.href} target="_blank" rel="nofollow noopener noreferrer">{row.system}</a>
                                                ) : (
                                                    row.system
                                                )}
                                            </span>
                                            <span class="[ wz-table__front ]">{row.front}</span>
                                        </span>
                                    </span>
                                </td>
                                <td class="[ wz-table__bar ]">
                                    <div class="[ wz-bar ]">
                                        <span class:list={['wz-bar__fill', `wz-bar__fill--${row.holds_today}`]} style={`width: ${percent(row.ships, max_traffic)}%`}></span>
                                    </div>
                                    <b>{number_thousand_separator(row.ships)}</b>
                                </td>
                                <td class="[ wz-table__num ]">
                                    <span class:list={['wz-delta', row.vs_last_month >= 0 ? 'wz-delta--up' : 'wz-delta--down']}>
                                        <span class="[ wz-delta__arrow ]">{row.vs_last_month >= 0 ? '▲' : '▼'}</span>
                                        <span class="[ wz-delta__num ]">{number_thousand_separator(Math.abs(row.vs_last_month))}</span>
                                    </span>
                                </td>
                                <td class="[ wz-table__num ]">{row.isk_label}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </Flexblock>
    </section>

    <section id="fronts" class="[ wz-section ]">
        <header class="[ wz-section__head ]">
            <h2>Two fronts</h2>
            <p class="[ wz-dek ]">
                The warzone has two halves. This month almost all of the fighting was on one of them.
            </p>
        </header>
        <ComponentBlock>
            <Flexblock gap="var(--space-m)">
                <div class="[ wz-share ]" role="img" aria-label={issue.fronts.map((front) => `${front.name}: ${front.ships_label} ships`).join('; ')}>
                    <div class="[ wz-share__bar ]">
                        {issue.fronts.map((front, index) => (
                            <span
                                class:list={['wz-share__fill', index === 0 ? 'wz-share__fill--minmatar' : 'wz-share__fill--amarr']}
                                style={`width: ${percent(front.ships, front_total)}%`}
                            >
                                <span class="[ wz-share__pct ]">{Math.round(percent(front.ships, front_total))}%</span>
                            </span>
                        ))}
                    </div>
                    <p class="[ wz-split__caption ]">Share of ships destroyed in the monthly sample, by front</p>
                </div>
                <div class="[ wz-fronts ]">
                    {issue.fronts.map((front, index) => (
                        <div class:list={['wz-front', index === 0 ? 'wz-front--minmatar' : 'wz-front--amarr']}>
                            <div class="[ wz-front__head ]">
                                <div>
                                    <h3>{front.name}</h3>
                                    <span class="[ wz-front__regions ]">{front.regions}</span>
                                </div>
                            </div>
                            <dl class="[ wz-statline ]">
                                <div>
                                    <dt>Ships destroyed</dt>
                                    <dd>{front.ships_label}</dd>
                                </div>
                                <div>
                                    <dt>Hottest system</dt>
                                    <dd>{front.hottest_system}</dd>
                                </div>
                            </dl>
                            <p>{front.dek}</p>
                        </div>
                    ))}
                </div>
            </Flexblock>
        </ComponentBlock>
    </section>

    <section id="focus" class="[ wz-section ]">
        <header class="[ wz-section__head ]">
            <h2>Focus of the month</h2>
            <p class="[ wz-dek ]">One story that would not fit a normal issue: a week-long siege in {issue.focus_name}.</p>
        </header>

        <ComponentBlock class="[ wz-focus ]">
            <Flexblock gap="var(--space-l)">
                <FlexInline justification="space-between" class="[ w-full ]">
                    <h3 class="[ wz-focus__title ]">{focus.title}</h3>
                    <span class="[ wz-date ]">{focus.window_label}</span>
                </FlexInline>

                <div class="[ wz-focus-stats ]">
                    <div class="[ wz-stat ]">
                        <span class="[ wz-stat__label ]">Ships destroyed</span>
                        <b class="[ wz-stat__value ]">{number_thousand_separator(focus.ships)}</b>
                        <span class="[ wz-stat__note ]">pods not counted</span>
                    </div>
                    <div class="[ wz-stat ]">
                        <span class="[ wz-stat__label ]">ISK destroyed</span>
                        <b class="[ wz-stat__value ]">{format_isk(focus.isk)}</b>
                    </div>
                    <div class="[ wz-stat ]">
                        <span class="[ wz-stat__label ]">Pilots who fought</span>
                        <b class="[ wz-stat__value ]">{number_thousand_separator(focus.unique_pilots)}</b>
                    </div>
                </div>

                <div class="[ wz-focus-charts ]">
                    <div class="[ wz-chart ]">
                        <h4>Ships lost by side</h4>
                        <ul class="[ wz-losses ]">
                            <li>
                                <span class="[ wz-losses__logo ]" aria-hidden="true"><MinmatarLogo /></span>
                                <div class="[ wz-losses__body ]">
                                    <div class="[ wz-losses__meta ]">
                                        <b class="[ wz-minmatar-text ]">Minmatar</b>
                                        <span>{number_thousand_separator(focus.minmatar_ships)} ships · {format_isk(focus.minmatar_isk)} · {focus.minmatar_pilots} pilots</span>
                                    </div>
                                    <div class="[ wz-bar ]"><span class="[ wz-bar__fill wz-bar__fill--minmatar ]" style={`width: ${percent(focus.minmatar_ships, focus_loss_max)}%`}></span></div>
                                </div>
                            </li>
                            <li>
                                <span class="[ wz-losses__logo ]" aria-hidden="true"><AmarrLogo /></span>
                                <div class="[ wz-losses__body ]">
                                    <div class="[ wz-losses__meta ]">
                                        <b class="[ wz-amarr-text ]">Amarr</b>
                                        <span>{number_thousand_separator(focus.amarr_ships)} ships · {format_isk(focus.amarr_isk)} · {focus.amarr_pilots} pilots</span>
                                    </div>
                                    <div class="[ wz-bar ]"><span class="[ wz-bar__fill wz-bar__fill--amarr ]" style={`width: ${percent(focus.amarr_ships, focus_loss_max)}%`}></span></div>
                                </div>
                            </li>
                            <li>
                                <span class="[ wz-losses__logo wz-losses__logo--other ]" aria-hidden="true">✦</span>
                                <div class="[ wz-losses__body ]">
                                    <div class="[ wz-losses__meta ]">
                                        <b>Third parties</b>
                                        <span>{number_thousand_separator(focus.other_ships)} ships · {format_isk(focus.other_isk)}</span>
                                    </div>
                                    <div class="[ wz-bar ]"><span class="[ wz-bar__fill wz-bar__fill--other ]" style={`width: ${percent(focus.other_ships, focus_loss_max)}%`}></span></div>
                                </div>
                            </li>
                        </ul>
                    </div>
                    <div class="[ wz-chart ]">
                        <h4>How the week was fought</h4>
                        <div class="[ wz-share__bar wz-share__bar--thin ]" role="img" aria-label={focus.engagement_mix.map((slice) => `${slice.label}: ${slice.value} kills`).join('; ')}>
                            {focus.engagement_mix.map((slice, index) => (
                                <span class="[ wz-share__fill ]" style={`width: ${percent(slice.value, engagement_total)}%; background: ${engagement_colors[index % engagement_colors.length]}`}></span>
                            ))}
                        </div>
                        <ul class="[ wz-legend-list ]">
                            {focus.engagement_mix.map((slice, index) => (
                                <li>
                                    <span class="[ wz-swatch ]" style={`background: ${engagement_colors[index % engagement_colors.length]}`} aria-hidden="true"></span>
                                    <span>{slice.label}</span>
                                    <b>{number_thousand_separator(slice.value)}</b>
                                    <span class="[ wz-legend-list__pct ]">{Math.round(percent(slice.value, engagement_total))}%</span>
                                </li>
                            ))}
                        </ul>
                    </div>
                </div>

                <FlexInline gap="var(--space-2xs)">
                    <Button href={translatePath(focus.campaign_path)} size="sm">
                        Read the full siege report
                    </Button>
                </FlexInline>
            </Flexblock>
        </ComponentBlock>
    </section>

    <section id="pilots" class="[ wz-section ]">
        <header class="[ wz-section__head ]">
            <h2>Pilots of the month</h2>
            <p class="[ wz-dek ]">The names that kept showing up on the killmails: solo, small gang, and fleet.</p>
        </header>
        <Grid min_item_width="18rem" class="[ wz-equal ]">
            {issue.pilots.boards.map((board) => (
                <ComponentBlock padding_inline="var(--space-m)" class="[ wz-board ]">
                    <Flexblock gap="var(--space-m)" class="[ h-full ]">
                        <h3>{board.title}</h3>
                        {[
                            { id: 'minmatar' as const, label: 'Minmatar', pilots: board.minmatar },
                            { id: 'amarr' as const, label: 'Amarr', pilots: board.amarr },
                        ].map((side) => (
                            <div class="[ wz-board__side ]">
                                <div class:list={['wz-board__faction', `wz-board__faction--${side.id}`]}>
                                    <span class="[ wz-board__logo ]" aria-hidden="true">
                                        {side.id === 'minmatar' ? <MinmatarLogo /> : <AmarrLogo />}
