                            <tr>
                                <td class="[ wz-table__rank ]">{index + 1}</td>
                                <td class="[ wz-table__group ]">
                                    <span class="[ wz-table__owner ]">
                                        <img
                                            class="[ wz-table__logo ]"
                                            src={group_logo_override(group.id) ?? (group.kind === 'alliance' ? get_alliance_logo(group.id, 64) : get_corporation_logo(group.id, 64))}
                                            width="32"
                                            height="32"
                                            alt=""
                                            loading="lazy"
                                        />
                                        <span>
                                            <span class="[ wz-table__system ]">
                                                <a
                                                    href={`https://zkillboard.com/${group.kind}/${group.id}/`}
                                                    target="_blank"
