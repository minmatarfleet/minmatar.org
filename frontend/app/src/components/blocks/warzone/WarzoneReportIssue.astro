                                                </span>
                                                <b class="[ wz-board__kills ]">{number_thousand_separator(pilot.killmails)}</b>
                                            </li>
                                        ))}
                                    </ol>
                                ) : (
                                    <p class="[ wz-board__empty ]">Not in this month’s extract.</p>
                                )}
                            </div>
                        ))}
                    </Flexblock>
                </ComponentBlock>
            ))}
        </Grid>
        <p class="[ wz-footnote ]">{issue.pilots.scope}</p>
