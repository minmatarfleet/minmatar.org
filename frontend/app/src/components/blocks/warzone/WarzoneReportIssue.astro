            {issue.top_ships.boards.map((board) => {
                const top_count = Math.max(...board.ships.map((ship) => ship.count), 1)
                return (
                    <ComponentBlock padding_inline="var(--space-m)" class="[ wz-board ]">
                        <Flexblock gap="var(--space-m)" class="[ h-full ]">
