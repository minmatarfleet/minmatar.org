            <div class="[ wz-table-wrap ]" tabindex="0" role="region" aria-label="Groups of the month">
                <table class="[ wz-table wz-table--groups ]">
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Group</th>
