                                                <div class="[ wz-bar ]">
                                                    <span class="[ wz-bar__fill wz-bar__fill--ship ]" style={`width: ${percent(ship.count, top_count)}%`}></span>
                                                </div>
                                            </div>
                                        </li>
                                    ))}
                                </ol>
                            ) : (
                                <p class="[ wz-board__empty ]">Not in this month’s extract.</p>
                            )}
                        </Flexblock>
                    </ComponentBlock>
                )
            })}
        </Grid>
    </section>

    <section id="groups" class="[ wz-section ]">
        <header class="[ wz-section__head ]">
            <h2>Groups of the month</h2>
            <p class="[ wz-dek ]">The alliances and corporations that actually live in the warzone, ranked by killmails.</p>
        </header>
