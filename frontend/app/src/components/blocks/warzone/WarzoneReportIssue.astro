                                                ) : group.faction_id === 500003 ? (
                                                    <span class="[ wz-group-faction__logo ]" aria-hidden="true"><AmarrLogo /></span>
                                                ) : group.faction_id && PIRATE_LOGO_CORP[group.faction_id] ? (
                                                    <img
                                                        class="[ wz-group-faction__logo ]"
                                                        src={get_corporation_logo(PIRATE_LOGO_CORP[group.faction_id], 32)}
                                                        width="16"
                                                        height="16"
                                                        alt=""
                                                        loading="lazy"
                                                    />
                                                ) : null}
                                                <span>{group.faction}</span>
                                            </span>
                                        </span>
