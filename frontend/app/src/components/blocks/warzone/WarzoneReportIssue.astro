                        </div>
                        <p class="[ wz-step__text push-bottom ]">{step.text}</p>
                        <a class="[ wz-step__link ]" href={translatePath(step.href)}>{step.label} →</a>
                    </Flexblock>
                </ComponentBlock>
            ))}
        </Grid>

        <ComponentBlock class="[ wz-cta ]" padding_inline="var(--space-m)" padding_block="var(--space-m)">
