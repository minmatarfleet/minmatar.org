---
import Grid from '@components/compositions/Grid.astro'
---

<div
    class="[ market-health-skeleton ]"
    aria-busy="true"
    aria-live="polite"
>
    <section class="[ market-health-skeleton__health ]">
        <Grid
            class="[ market-health-skeleton__split ]"
            min_item_width="280px"
            row_gap="var(--space-s)"
            column_gap="var(--space-s)"
        >
            <div class="[ market-health-skeleton__card ]">
                <div class="[ skel skel-eyebrow ]"></div>
                <div class="[ market-health-skeleton__dual ]">
                    <div class="[ market-health-skeleton__metric ]">
                        <div class="[ skel skel-line skel-line--short ]"></div>
                        <div class="[ skel skel-card-pct ]"></div>
                        <div class="[ skel skel-bar ]"></div>
                        <div class="[ skel skel-line ]"></div>
                    </div>
                    <div class="[ market-health-skeleton__metric ]">
                        <div class="[ skel skel-line skel-line--short ]"></div>
                        <div class="[ skel skel-card-pct ]"></div>
                        <div class="[ skel skel-bar ]"></div>
                        <div class="[ skel skel-line ]"></div>
                    </div>
                </div>
                <div class="[ skel skel-line skel-line--med ]"></div>
                <div class="[ skel skel-line skel-line--short ]"></div>
                <div class="[ skel skel-button ]"></div>
            </div>
            <div class="[ market-health-skeleton__card ]">
                <div class="[ skel skel-eyebrow ]"></div>
                <div class="[ market-health-skeleton__dual ]">
                    <div class="[ market-health-skeleton__metric ]">
                        <div class="[ skel skel-line skel-line--short ]"></div>
                        <div class="[ skel skel-card-pct ]"></div>
                        <div class="[ skel skel-bar ]"></div>
                        <div class="[ skel skel-line ]"></div>
                    </div>
                    <div class="[ market-health-skeleton__metric ]">
                        <div class="[ skel skel-line skel-line--short ]"></div>
                        <div class="[ skel skel-card-pct ]"></div>
                        <div class="[ skel skel-bar ]"></div>
                        <div class="[ skel skel-line ]"></div>
                    </div>
                </div>
                <div class="[ skel skel-line skel-line--med ]"></div>
                <div class="[ skel skel-line skel-line--short ]"></div>
                <div class="[ skel skel-button ]"></div>
            </div>
        </Grid>
        <div class="[ market-health-skeleton__chart ]">
            <div class="[ skel skel-eyebrow ]"></div>
            <div class="[ skel skel-chart ]"></div>
            <div class="[ skel skel-line skel-line--med ]"></div>
        </div>
    </section>
</div>

<style lang="scss">
    .market-health-skeleton .skel {
        border-radius: 2px;
        background: linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.06) 0%,
            rgba(255, 255, 255, 0.12) 50%,
            rgba(255, 255, 255, 0.06) 100%
        );
        background-size: 200% 100%;
        animation: market-health-skel 1.1s ease-in-out infinite;
    }

    .market-health-skeleton__health {
        display: flex;
        flex-direction: column;
        gap: var(--space-s);
    }

    .market-health-skeleton__card {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        padding: var(--space-m);
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(0, 0, 0, 0.22);
    }

    .market-health-skeleton__chart {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
        padding: var(--space-m);
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(0, 0, 0, 0.22);
    }

    .skel-chart {
        width: 100%;
        height: clamp(8rem, 18vw, 12rem);
    }

    .market-health-skeleton__dual {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-s);
    }

    .market-health-skeleton__metric {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        min-width: 0;
    }

    .skel-eyebrow {
        width: 8rem;
        height: 0.75rem;
    }

    .skel-card-pct {
        width: 6.5rem;
        height: clamp(2rem, 4vw, 3rem);
    }

    .skel-bar {
        width: 100%;
        height: var(--space-2xs);
        margin-block: var(--space-3xs);
    }

    .skel-line {
        width: 14rem;
        max-width: 100%;
        height: 0.85rem;
    }

    .skel-line--med {
        width: 11rem;
    }

    .skel-line--short {
        width: 7.5rem;
    }

    .skel-button {
        width: 9rem;
        height: 2rem;
        margin-block-start: var(--space-2xs);
    }

    @keyframes market-health-skel {
        0% {
            background-position: 100% 0;
        }
        100% {
            background-position: -100% 0;
        }
    }
</style>
