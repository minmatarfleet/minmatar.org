---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { StagingType } from '@dtypes/layout_components'
import { stagings } from '@dtypes/layout_components'

interface Props {
    selected?:  StagingType;
}

const {
    selected
} = Astro.props

const current_staging = selected && stagings.includes(selected) ? selected : null

import { STAGING_SWITCHER_OPTIONS } from '@/data/stagings'

// List every option except the current staging; with no staging picked, "Random" is the current one.
const staging_list = STAGING_SWITCHER_OPTIONS.filter(staging => staging.slug !== (current_staging ?? 'random'))

import { get_item_icon } from '@helpers/eve_image_server'

import Flexblock from '@components/compositions/Flexblock.astro';
import Badge from '@components/blocks/Badge.astro';
import StylessButton from '@components/blocks/StylessButton.astro';
---

<Flexblock gap='var(--space-3xs)'>
    {staging_list.map(staging =>
        <StylessButton
            href={`${translatePath('/redirects/set_staging')}?tag=${staging.slug}`}
            class="[ min-w-[350px] ]"
            x-on:click="close()"
        >
            <Badge
                title={staging.title}
                subtitle={t(staging.description_key)}
                image={get_item_icon(staging.type_id)}
            />
        </StylessButton>
    )}
</Flexblock>