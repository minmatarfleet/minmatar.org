---
/**
 * The line over a paused faction warfare campaign: since when, what stops
 * while it is paused, and (for managers) Resume.
 */
import { i18n } from '@helpers/i18n'
const { lang, t, translatePath } = i18n(Astro.url)

import type { CampaignDetail } from '@dtypes/api.minmatar.org'
import { format_date_short } from '@helpers/date'

interface Props {
    campaign:       CampaignDetail;
    can_manage?:    boolean;
    [propName: string]: any;
}

const {
    campaign,
    can_manage = false,
    ...attributes
} = Astro.props

delete attributes.class

const since = campaign.paused_at ? format_date_short(lang, new Date(campaign.paused_at)) : ''
const RESUME_URL = translatePath(`/partials/campaign_resume_component?slug=${encodeURIComponent(campaign.slug)}`)

import Button from '@components/blocks/Button.astro'
---

<section
    id="campaign-paused-banner"
    class:list={['[ campaign-paused ]', Astro.props.class]}
    role="note"
    {...attributes}
>
    <p>
        {since && <b>{t('campaigns.paused.title').replace('~DATE', since)}</b>}
        {' '}{t('campaigns.paused.body')}
    </p>
    {can_manage &&
        <Button
            type="button"
            size="sm"
            color="transparent"
            hx-post={RESUME_URL}
            hx-target="#campaign-paused-banner"
            hx-swap="outerHTML"
            hx-disabled-elt="this"
        >
            {t('campaigns.paused.resume')}
        </Button>
    }
</section>

<style lang="scss">
    .campaign-paused {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-xs) var(--space-m);
        padding: var(--space-s) var(--space-m);
        background-color: color-mix(in srgb, var(--fleet-red) var(--tint-subtle), transparent);
        border: 1px solid color-mix(in srgb, var(--fleet-red) var(--tint-strong), transparent);

        p {
            flex: 1 1 24rem;
            margin: 0;
            color: var(--highlight);
        }

        b {
            color: var(--fleet-yellow);
        }
    }
</style>
