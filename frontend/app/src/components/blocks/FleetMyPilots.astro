---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { SummaryCharacter } from '@dtypes/api.minmatar.org'
import type { FleetShipVolunteer } from '@helpers/api.minmatar.org/fleets'
import { get_item_icon } from '@helpers/eve_image_server'
import { query_string } from '@helpers/string'

/**
 * Which ship each of the viewer's characters is bringing. Picking or
 * changing opens the same ship picker as the ships section, which handles
 * one ship per character. Re-rendered out of band when picks are saved.
 */
interface Props {
    fleet_id:       number;
    pilots:         SummaryCharacter[];
    volunteers:     FleetShipVolunteer[];
    readonly?:      boolean;
    can_manage?:    boolean;
    [propName: string]: any;
}

const {
    fleet_id,
    pilots,
    volunteers,
    readonly = false,
    can_manage = false,
    ...attributes
} = Astro.props

delete attributes.class

const my_character_ids = new Set(pilots.map(pilot => pilot.character_id))
const flying = volunteers.filter(volunteer => my_character_ids.has(volunteer.character_id))
const not_flying = pilots.length - new Set(flying.map(volunteer => volunteer.character_id)).size

const PICK_SHIPS_MODAL_URL = `${translatePath('/partials/fleet_pick_ships_modal_component/')}?${query_string({
    fleet_id: fleet_id,
    ...(can_manage && { can_manage: true }),
})}`

import Button from '@components/blocks/Button.astro'
---

<section
    id="fleet-my-pilots"
    class:list={['[ fleet-my-pilots ][ component ]', Astro.props.class]}
    aria-labelledby="fleet-my-pilots-title"
    {...attributes}
>
    <header>
        <h2 id="fleet-my-pilots-title">{t('fleets.my_pilots.title')}</h2>
        {flying.length > 0 &&
            <small>{t('fleets.my_pilots.flying').replace('{count}', flying.length.toString())}</small>
        }
    </header>

    {flying.length > 0 ?
        <ul>
            {flying.map(volunteer =>
                <li>
                    <img src={get_item_icon(volunteer.ship_id, 64)} alt="" width="40" height="40" loading="lazy" />
                    <span>
                        <b>{volunteer.character_name}</b>
                        <small>{volunteer.fitting_name}</small>
                    </span>
                </li>
            )}
        </ul>
        :
        <p>{t('fleets.my_pilots.none')}</p>
    }

    {flying.length > 0 && not_flying > 0 &&
        <small>{t('fleets.my_pilots.not_flying').replace('{count}', not_flying.toString())}</small>
    }

    {!readonly && pilots.length > 0 &&
        <Button
            type="button"
            color={flying.length > 0 ? 'transparent' : 'green'}
            x-on:click={`show_modal({ partial: '${PICK_SHIPS_MODAL_URL}' })`}
        >
            {flying.length > 0 ? t('fleets.spotlight.change_ships') : t('fleets.spotlight.pick_ships')}
        </Button>
    }
</section>

<style lang="scss">
    .fleet-my-pilots {
        display: flex;
        flex-direction: column;
        gap: var(--space-s);
        padding: var(--space-m);
        border: 1px solid var(--border-color);

        header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: var(--space-s);
        }

        h2 {
            font-size: var(--step-1);
        }

        ul {
            display: flex;
            flex-direction: column;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        li {
            display: flex;
            align-items: center;
            gap: var(--space-s);
            padding: var(--space-2xs) 0;
            border-top: 1px solid var(--border-color);

            span {
                display: flex;
                flex-direction: column;
                min-width: 0;
            }

            b {
                color: var(--highlight);
            }

            small {
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }
        }

        :global(button) {
            width: 100%;
        }
    }

    /* Below xl the page actions bar at the bottom carries "Pick ships". */
    @media (max-width: 79.99rem) {
        .fleet-my-pilots :global(button) {
            display: none;
        }
    }
</style>
