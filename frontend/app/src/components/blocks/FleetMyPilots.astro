---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { SummaryCharacter } from '@dtypes/api.minmatar.org'
import type { FleetShipVolunteer } from '@helpers/api.minmatar.org/fleets'
import { get_item_icon } from '@helpers/eve_image_server'

/**
 * Which ship each of the viewer's characters is bringing, above the ship
 * picker in the Your pilots tab. Re-rendered out of band when picks are saved.
 */
interface Props {
    pilots:         SummaryCharacter[];
    volunteers:     FleetShipVolunteer[];
    [propName: string]: any;
}

const {
    pilots,
    volunteers,
    ...attributes
} = Astro.props

delete attributes.class

const my_character_ids = new Set(pilots.map(pilot => pilot.character_id))
const flying = volunteers.filter(volunteer => my_character_ids.has(volunteer.character_id))
const not_flying = pilots.length - new Set(flying.map(volunteer => volunteer.character_id)).size
---

<section
    id="fleet-my-pilots"
    class:list={['[ fleet-my-pilots ][ component ]', Astro.props.class]}
    aria-labelledby="fleet-my-pilots-title"
    {...attributes}
>
    <header>
        <h2 id="fleet-my-pilots-title" class="[ visually-hidden ]">{t('fleets.my_pilots.title')}</h2>
        {flying.length > 0 &&
            <small>{t('fleets.my_pilots.flying').replace('{count}', flying.length.toString())}</small>
        }
        {flying.length > 0 && not_flying > 0 &&
            <small>{t('fleets.my_pilots.not_flying').replace('{count}', not_flying.toString())}</small>
        }
    </header>

    {flying.length > 0 ?
        <ul>
            {flying.map(volunteer =>
                <li>
                    <img src={get_item_icon(volunteer.ship_id, 64)} alt="" width="40" height="40" loading="lazy" />
                    <span>
                        <b>{volunteer.character_name}</b>
                        <small>{volunteer.fitting_name}</small>
                    </span>
                </li>
            )}
        </ul>
        :
        <p>{t('fleets.my_pilots.none')}</p>
    }

</section>

<style lang="scss">
    /* Who you are bringing, at the top of the Your pilots tab. */
    .fleet-my-pilots {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-s) var(--space-l);
        padding: var(--space-s) var(--space-m);
        border: 1px solid var(--border-color);

        header {
            flex: 0 0 auto;
            display: flex;
            flex-direction: column;
            gap: var(--space-3xs);
        }

        h2 {
            font-size: var(--step-1);
        }

        > p {
            flex: 1 1 16rem;
            margin: 0;
        }


        ul {
            flex: 999 1 20rem;
            display: flex;
            flex-wrap: wrap;
            gap: var(--space-2xs);
            margin: 0;
            padding: 0;
            list-style: none;
        }

        li {
            display: flex;
            align-items: center;
            gap: var(--space-xs);
            padding: var(--space-3xs) var(--space-s) var(--space-3xs) var(--space-3xs);
            border: 1px solid var(--border-color);

            span {
                display: flex;
                flex-direction: column;
                min-width: 0;
            }

            b {
                color: var(--highlight);
            }

            small {
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }
        }
    }

</style>
