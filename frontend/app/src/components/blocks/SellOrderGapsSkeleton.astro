---
import Flexblock from '@components/compositions/Flexblock.astro'

interface Props {
    rows?: number;
}

const { rows = 6 } = Astro.props
---

<div
    class="[ ops-sell-gaps-skeleton ]"
    aria-busy="true"
    aria-live="polite"
>
    <Flexblock gap="var(--space-2xs)">
        {Array.from({ length: rows }).map(() =>
            <div class="[ ops-sell-gaps-skeleton__card ]">
                <div class="[ ops-sell-gaps-skeleton__main ]">
                    <div class="[ skel skel-icon ]"></div>
                    <div class="[ ops-sell-gaps-skeleton__copy ]">
                        <div class="[ skel skel-name ]"></div>
                        <div class="[ skel skel-ships ]"></div>
                    </div>
                    <div class="[ skel skel-status ]"></div>
                </div>
                <div class="[ skel skel-metrics ]"></div>
            </div>
        )}
    </Flexblock>
</div>

<style lang="scss">
    @use '../../styles/mixins/skeleton';

    .ops-sell-gaps-skeleton .skel {
        border-radius: 2px;
        @include skeleton.shimmer;
    }

    .ops-sell-gaps-skeleton__card {
        display: flex;
        flex-direction: column;
    }

    .ops-sell-gaps-skeleton__main {
        display: flex;
        align-items: center;
        gap: var(--space-s);
        padding: var(--space-2xs) var(--space-s);
        border: 1px solid var(--hairline-medium);
        background: rgba(0, 0, 0, 0.16);
    }

    .ops-sell-gaps-skeleton__copy {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
    }

    .skel-icon {
        flex-shrink: 0;
        width: 48px;
        height: 48px;
    }

    .skel-name {
        width: min(16rem, 55%);
        height: 1rem;
    }

    .skel-ships {
        width: min(10rem, 40%);
        height: 0.75rem;
    }

    .skel-status {
        flex-shrink: 0;
        width: 7rem;
        height: 1.1rem;
        margin-left: auto;
    }

    .skel-metrics {
        width: 100%;
        height: 1.4rem;
        border: 1px solid var(--hairline);
        border-top: none;
    }
</style>
