---
import type { ChronicleBlock } from '@/data/rat-chronicle'
import { formatChronicleText } from '@/data/rat-chronicle'
import CharacterPicture from '@components/blocks/CharacterPicture.astro'
import RatChroniclePieceLink from '@components/blocks/RatChroniclePieceLink.astro'

interface Props {
    blocks: ChronicleBlock[]
    drop_cap?: boolean
}

const { blocks, drop_cap = false } = Astro.props

const first_paragraph_index = drop_cap
    ? blocks.findIndex((block) => block.type === 'paragraph')
    : -1
---

{
    blocks.map((block, index) => {
        if (block.type === 'paragraph') {
            return (
                <p
                    class:list={['chronicle__paragraph', { 'chronicle__paragraph--drop-cap': index === first_paragraph_index }]}
                    set:html={formatChronicleText(block.text)}
                />
            )
        }

        if (block.type === 'beat') {
            return <p class="chronicle__beat" set:html={formatChronicleText(block.text)} />
        }

        if (block.type === 'quote') {
            return (
                <blockquote class="chronicle__quote">
                    <p set:html={formatChronicleText(block.text)} />
                    {(block.character_id || block.attribution || block.source) && (
                        <footer class="chronicle__quote-attribution">
                            {block.character_id && (
                                <CharacterPicture
                                    character_id={block.character_id}
                                    character_name={block.character_name}
                                    size={64}
                                    icon_quality={128}
                                    inert={true}
                                />
                            )}
                            <span class="chronicle__quote-attribution-text">
                                {block.character_name && (
                                    <cite class="chronicle__quote-author">{block.character_name}</cite>
                                )}
                                {block.attribution && !block.source && (
                                    <span class="chronicle__quote-attribution-detail">{block.attribution}</span>
                                )}
                                {block.source && (
                                    <RatChroniclePieceLink piece={block.source} class="chronicle__quote-source">
                                        {block.attribution ?? block.source.title}
                                    </RatChroniclePieceLink>
                                )}
                            </span>
                        </footer>
                    )}
                </blockquote>
            )
        }

        if (block.type === 'pieces') {
            return (
                <aside class="chronicle__pieces" aria-label={block.label ?? 'From the archive'}>
                    <p class="chronicle__pieces-label">{block.label ?? 'From the archive'}</p>
                    <ul class="chronicle__pieces-list">
                        {block.items.map((piece) => (
                            <li class="chronicle__piece">
                                <RatChroniclePieceLink piece={piece} class="chronicle__piece-link">
                                    {piece.kind && <span class="chronicle__piece-kind">{piece.kind}</span>}
                                    <span class="chronicle__piece-title">{piece.title}</span>
                                </RatChroniclePieceLink>
                            </li>
                        ))}
                    </ul>
                </aside>
            )
        }

        return null
    })
}

<style lang="scss">
    .chronicle__paragraph {
        margin: 0 0 1.35em;
        font-size: var(--step-0);
        line-height: 1.75;
        color: var(--foreground);
        text-wrap: pretty;
    }

    @media (min-width: 56rem) {
        .chronicle__paragraph {
            font-size: var(--step-1);
            line-height: 1.7;
        }

        .chronicle__beat {
            font-size: var(--step-1);
        }
    }

    .chronicle__paragraph--drop-cap::first-letter {
        float: left;
        margin: 0.08em 0.12em 0 0;
        font-family: var(--heading-font);
        font-size: 3.4em;
        line-height: 0.82;
        color: var(--highlight);
        text-transform: uppercase;
    }

    .chronicle__beat {
        margin: 0.25em 0 1.1em;
        padding-inline-start: var(--space-l);
        border-inline-start: 1px solid color-mix(in srgb, var(--fleet-yellow) var(--tint-medium), transparent);
        font-family: var(--chronicle-font);
        font-size: var(--step-0);
        font-style: italic;
        line-height: 1.5;
        color: color-mix(in srgb, var(--foreground) 88%, white);
    }

    .chronicle__quote {
        margin: var(--space-l) 0 var(--space-xl);
        padding: var(--space-m) var(--space-l);
        border-inline-start: 2px solid var(--fleet-red);
        background: color-mix(in srgb, var(--component-background) var(--tint-heavy), transparent);

        p {
            margin: 0;
            font-family: var(--chronicle-font);
            font-size: var(--step-1);
            font-style: italic;
            line-height: 1.55;
            color: var(--highlight);
        }
    }

    .chronicle__quote-attribution {
        display: flex;
        align-items: center;
        gap: var(--space-m);
        margin-top: var(--space-m);
        font-style: normal;
    }

    .chronicle__quote-attribution :global(picture) {
        flex-shrink: 0;
    }

    .chronicle__quote-attribution :global(img) {
        border: 1px solid color-mix(in srgb, var(--fleet-yellow) var(--tint-medium), transparent);
    }

    .chronicle__quote-attribution-text {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
    }

    .chronicle__quote-author {
        font-family: var(--heading-font);
        font-size: var(--step-0);
        font-style: normal;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--highlight);
    }

    .chronicle__quote-attribution-detail,
    .chronicle__quote-attribution :global(.chronicle__quote-source) {
        font-size: var(--step--1);
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--text-color-secondary, var(--faded));
    }

    // A quote whose source can be opened: the attribution is the link.
    .chronicle__quote-attribution :global(a.chronicle__quote-source) {
        text-decoration: underline;
        text-decoration-color: color-mix(in srgb, var(--fleet-yellow) var(--tint-medium), transparent);
        text-underline-offset: 0.2em;

        @media (hover: hover) {
            &:hover {
                color: var(--highlight);
            }
        }
    }

    // A row of things the passage draws on: papers, comics, videos, battle reports.
    .chronicle__pieces {
        margin: var(--space-l) 0 var(--space-xl);
        padding-block: var(--space-m);
        border-block: 1px solid color-mix(in srgb, var(--fleet-yellow) var(--tint-soft), transparent);
    }

    .chronicle__pieces-label {
        margin: 0 0 var(--space-s);
        font-family: var(--heading-font);
        font-size: var(--step--1);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--fleet-red);
    }

    .chronicle__pieces-list {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .chronicle__piece :global(.chronicle__piece-link) {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        max-width: 22rem;
        padding: var(--space-xs) var(--space-s);
        border: 1px solid color-mix(in srgb, var(--border-color) var(--tint-heavy), transparent);
        background: color-mix(in srgb, var(--component-background) var(--tint-strong), transparent);
        color: inherit;
        text-decoration: none;
        transition: border-color var(--fast-transition);
    }

    @media (hover: hover) {
        .chronicle__piece :global(a.chronicle__piece-link:hover) {
            border-color: color-mix(in srgb, var(--fleet-yellow) var(--tint-strong), transparent);
        }
    }

    .chronicle__piece-kind {
        font-size: var(--step--2);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-color-secondary, var(--faded));
    }

    .chronicle__piece-title {
        font-family: var(--chronicle-font);
        font-size: var(--step--1);
        line-height: 1.3;
        color: var(--highlight);
    }
</style>
