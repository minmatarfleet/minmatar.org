---
/**
 * How to copy a structure from the EVE client: one tab per kind of paste,
 * each with a sketch of the client window and three numbered steps.
 */
import { i18n, t_key } from '@helpers/i18n'
const { t } = i18n(Astro.url)

const TABS = ['name', 'scan', 'dscan', 'reinforce'] as const
---

<div class="[ paste-guide ]" x-data="{ tab: 'name' }">
    <span class="[ manage-field__label ]">{t('structures.guide.title')}</span>
    <div class="[ manage-chips ]" role="tablist" aria-label={t('structures.guide.title')}>
        {TABS.map((tab) => (
            <button type="button" role="tab" class="[ manage-chip ]"
                x-bind:aria-selected={`tab === '${tab}'`}
                x-bind:class={`{ 'is-on': tab === '${tab}' }`}
                x-on:click={`tab = '${tab}'`}>
                {t(t_key('structures.guide.tab_', tab))}
            </button>
        ))}
    </div>

    {TABS.map((tab) => (
        <div class="[ paste-guide__panel ]" role="tabpanel" x-show={`tab === '${tab}'`} x-cloak={tab !== 'name' ? '' : undefined}>
            <div class="[ paste-guide__win ]" role="img" aria-label={t(t_key('structures.guide.diagram_', tab))}>
                <div class="[ paste-guide__bar ]">{t(t_key('structures.guide.window_', tab))}</div>
                {tab === 'name' &&
                    <div class="[ paste-guide__sel ]">
                        <span class="[ paste-guide__name ]">Amamake - Police Weapons Facility</span>
                        <ul class="[ paste-guide__menu ]">
                            <li>Show Info</li>
                            <li class="[ on ]">Copy</li>
                            <li>Set Destination</li>
                        </ul>
                    </div>
                }
                {tab === 'scan' &&
                    <ul class="[ paste-guide__rows ]">
                        <li class="[ on ]">Standup XL-Set Ship Manufacturing Efficiency I</li>
                        <li class="[ on ]">Standup XL-Set Laboratory Optimization I</li>
                        <li class="[ on ]">Standup Manufacturing Plant I</li>
                        <li class="[ on ]">Standup Cloning Center I</li>
                    </ul>
                }
                {tab === 'dscan' &&
                    <ul class="[ paste-guide__rows ]">
                        <li>Astrahus · Hydra Freeport · 4.2 AU</li>
                        <li class="[ on ]">Sotiyo · Amamake - Police Weapons Facility · 12 km</li>
                        <li>Tatara · Reactions &amp; Reprocessing · 1.1 AU</li>
                    </ul>
                }
                {tab === 'reinforce' &&
                    <div class="[ paste-guide__sel ]">
                        <span class="[ paste-guide__name ]">Reinforces 20:00</span>
                    </div>
                }
                {(tab === 'scan' || tab === 'dscan') &&
                    <span class="[ paste-guide__keys ]" aria-hidden="true">
                        {tab === 'scan' && <><kbd>Ctrl</kbd><kbd>A</kbd></>}
                        <kbd>Ctrl</kbd><kbd>C</kbd>
                    </span>
                }
            </div>
            <ol class="[ paste-guide__how ]">
                {[1, 2, 3].map((n) => <li>{t(t_key("structures.guide.", `${tab}_${n}`))}</li>)}
            </ol>
        </div>
    ))}
</div>

<style lang="scss" is:global>
    .paste-guide {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);

        .manage-chip.is-on {
            color: var(--background);
            background-color: var(--fleet-yellow);
            border-color: var(--fleet-yellow);
        }
    }

    .paste-guide__panel {
        display: grid;
        grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
        align-items: center;
        gap: var(--space-s);
        padding: var(--space-s);
        background-color: var(--surface-sunken);
        border: 1px solid var(--hairline-medium);

        @media (max-width: 40rem) {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    .paste-guide__win {
        position: relative;
        min-height: 11rem;
        overflow: hidden;
        font-size: var(--step--2);
        color: var(--highlight);
        background-color: color-mix(in srgb, var(--alliance-blue) 10%, var(--background));
        border: 1px solid color-mix(in srgb, var(--alliance-blue) 35%, transparent);
    }

    .paste-guide__bar {
        padding: var(--space-3xs) var(--space-2xs);
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        background-color: color-mix(in srgb, var(--alliance-blue) 18%, var(--background));
        border-bottom: 1px solid color-mix(in srgb, var(--alliance-blue) 35%, transparent);
    }

    .paste-guide__sel {
        position: relative;
        padding: var(--space-xs);
    }

    .paste-guide__name {
        display: inline-block;
        padding: 0.15em 0.35em;
        font-weight: 600;
        outline: 1px dashed var(--fleet-yellow);
    }

    .paste-guide__menu,
    .paste-guide__rows {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .paste-guide__menu {
        position: absolute;
        top: 3rem;
        left: 7rem;
        width: 9rem;
        background-color: var(--background);
        border: 1px solid var(--hairline-strong);

        li {
            padding: 0.3em 0.7em;
        }
    }

    .paste-guide__rows li {
        overflow: hidden;
        padding: 0.35em var(--space-2xs);
        text-overflow: ellipsis;
        white-space: nowrap;
        border-bottom: 1px solid var(--hairline);
    }

    .paste-guide__menu li.on,
    .paste-guide__rows li.on {
        background-color: color-mix(in srgb, var(--fleet-yellow) 22%, transparent);
    }

    .paste-guide__keys {
        position: absolute;
        right: var(--space-2xs);
        bottom: var(--space-2xs);
        display: flex;
        gap: var(--space-3xs);

        kbd {
            padding: 0.15em 0.45em;
            font: inherit;
            background-color: var(--background);
            border: 1px solid var(--hairline-strong);
            border-bottom-width: 3px;
        }
    }

    .paste-guide__how {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        margin: 0;
        padding-left: 1.4em;
        font-size: var(--step--1);
        color: var(--highlight);
    }
</style>
