---
/**
 * Status tags the site sets: Home, Deployment, Form-up, Freight, Market and
 * open Industry orders. Home and Deployment are filled; the rest are quiet
 * with an icon.
 */
import { i18n, t_key } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { StructureFlag } from '@helpers/structure_locations'

interface Props {
    flags:          { kind: StructureFlag, count?: number }[];
    [propName: string]: any;
}

const { flags, ...attributes } = Astro.props
delete attributes.class

const ICONS: Record<StructureFlag, string> = {
    home: 'M5 21V4h11l-2 4 2 4H5',
    deployment: 'M5 21V4h11l-2 4 2 4H5',
    fleets: 'M4 17 12 5l8 12M8 17h8',
    freight: 'M3 7h11v9H3zM14 10h4l3 3v3h-7M7 19a1.6 1.6 0 1 0 0-.01M17 19a1.6 1.6 0 1 0 0-.01',
    market: 'M4 20h16M7 16v-5M12 16V7M17 16v-3',
    orders: 'M6 3h12v18H6zM9 8h6M9 12h6M9 16h3',
}
---

{flags.length > 0 &&
    <ul class:list={['[ structure-flags ]', Astro.props.class]} {...attributes}>
        {flags.map((flag) => (
            <li class:list={['[ structure-flag ]', { key: flag.kind === 'home', deployment: flag.kind === 'deployment' }]}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONS[flag.kind]} /></svg>
                {t(t_key('structures.flag.', flag.kind))}
                {flag.count !== undefined && <span class="[ structure-flag__n ]">{flag.count}</span>}
            </li>
        ))}
    </ul>
}

<style lang="scss" is:global>
    .structure-flags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3xs);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .structure-flag {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3xs);
        padding: 0.25em 0.6em;
        font-size: var(--step--2);
        font-weight: 700;
        letter-spacing: 0.04em;
        line-height: 1.2;
        white-space: nowrap;
        color: var(--highlight);
        background-color: color-mix(in srgb, var(--background) 78%, transparent);
        border: 1px solid var(--hairline-strong);

        svg {
            width: 1.1em;
            height: 1.1em;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        &.key {
            color: var(--background);
            background-color: var(--fleet-yellow);
            border-color: var(--fleet-yellow);
        }

        &.deployment {
            color: var(--highlight);
            background-color: var(--fleet-red);
            border-color: var(--fleet-red);
        }
    }

    .structure-flag__n {
        font-weight: 600;
        opacity: 0.75;
    }
</style>
