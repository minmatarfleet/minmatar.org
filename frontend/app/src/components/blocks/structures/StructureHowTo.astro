---
/**
 * How to get a structure's details out of the EVE client, for the fields on
 * the current step of a structure dialog. One chip per topic; each shows a
 * short clip recorded in the client and three numbered steps. Shared by Add
 * a structure, Report a structure and Add a timer.
 */
import { i18n, t_key } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { StructureHowToTopic } from '@dtypes/layout_components'
import SectionTabs from '@components/blocks/SectionTabs.astro'
import SectionTabPanel from '@components/blocks/SectionTabPanel.astro'

interface Props {
    topics:             StructureHowToTopic[];
    [propName: string]: any;
}

const { topics, ...attributes } = Astro.props

delete attributes.class

// One guide can sit on a page next to others (each dialog step has its own).
const id_prefix = `structure-howto-${Math.random().toString(36).slice(2, 8)}`

// Clips cut from a recording of the client; width and height match the file.
const CLIPS: Partial<Record<StructureHowToTopic, { src: string, width: number, height: number }>> = {
    name:       { src: '/images/structure-guide/copy-name.gif', width: 360, height: 160 },
    owner:      { src: '/images/structure-guide/show-info.gif', width: 400, height: 329 },
    reinforce:  { src: '/images/structure-guide/hack-reinforce.gif', width: 400, height: 292 },
    fitting:    { src: '/images/structure-guide/ship-scan-copy.gif', width: 276, height: 420 },
    selected_item:  { src: '/images/structure-guide/selected-item.gif', width: 400, height: 110 },
    timer_owner:    { src: '/images/structure-guide/timer-owner.gif', width: 420, height: 248 },
}
---

{topics.length > 0 &&
    <div class:list={['[ structure-howto ]', { 'structure-howto--single': topics.length === 1 }, Astro.props.class]} {...attributes}>
        <span class="[ manage-field__label ]">{t('structures.guide.title')}</span>
        {/* A single topic needs no tab (and no tab role) to pick it. */}
        {topics.length === 1
            ? <Fragment>{topics.map((topic) => {
                const clip = CLIPS[topic]
                return (
                    <div class:list={['[ structure-howto__panel ]', { 'no-clip': !clip }]}>
                        {clip &&
                            <figure class="[ structure-howto__clip ]">
                                <img src={clip.src} width={clip.width} height={clip.height} loading="lazy" alt={t(t_key('structures.guide.clip_', topic))} />
                            </figure>
                        }
                        <ol class="[ structure-howto__how ]">
                            {[1, 2, 3].map((n) => <li>{t(t_key('structures.guide.', `${topic}_${n}`))}</li>)}
                        </ol>
                    </div>
                )
            })}</Fragment>
            : <SectionTabs
            variant="pills"
            sync_hash={false}
            aria_label={t('structures.guide.title')}
            id_prefix={id_prefix}
            tabs={topics.map((topic) => ({ id: topic, label: t(t_key('structures.guide.tab_', topic)) }))}
        >
            {topics.map((topic) => {
                const clip = CLIPS[topic]
                return (
                    <SectionTabPanel id={topic} id_prefix={id_prefix} is_default={topic === topics[0]}>
                        <div class:list={['[ structure-howto__panel ]', { 'no-clip': !clip }]}>
                            {clip &&
                                <figure class="[ structure-howto__clip ]">
                                    <img src={clip.src} width={clip.width} height={clip.height} loading="lazy" alt={t(t_key('structures.guide.clip_', topic))} />
                                </figure>
                            }
                            <ol class="[ structure-howto__how ]">
                                {[1, 2, 3].map((n) => <li>{t(t_key('structures.guide.', `${topic}_${n}`))}</li>)}
                            </ol>
                        </div>
                    </SectionTabPanel>
                )
            })}
        </SectionTabs>}
    </div>
}

<style lang="scss" is:global>
    .structure-howto {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
    }

    .structure-howto__panel {
        display: grid;
        grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
        align-items: center;
        gap: var(--space-s);
        padding: var(--space-s);
        background-color: var(--surface-sunken);
        border: 1px solid var(--border-color);

        &.no-clip {
            grid-template-columns: minmax(0, 1fr);
        }

        @media (max-width: 40rem) {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    .structure-howto__clip {
        display: flex;
        justify-content: center;
        margin: 0;

        img {
            display: block;
            max-width: 100%;
            max-height: 18rem;
            width: auto;
            height: auto;
            border: 1px solid var(--border-color-hover);
        }
    }

    .structure-howto__how {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        margin: 0;
        padding-left: 1.4em;
        font-size: var(--step--1);
        color: var(--highlight);
    }
</style>
