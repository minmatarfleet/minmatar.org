---
/**
 * The body of the Add a structure dialog, one piece at a time, in the order
 * the client gives it: Selected Item (paste, then match) → Fitting (ship
 * scan) → Reinforcement (hacking) → Details → Approval. Each step shows the
 * one clip for its piece, inside the shared StructureSteps shell. Each step
 * posts to structures_add_component, which renders the next one. What the
 * pilot pasted and what we found travel along as hidden fields.
 */
import { i18n, t_key } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { StructureLocationDocked, StructureLocationModule } from '@dtypes/api.minmatar.org'
import { get_item_icon } from '@helpers/eve_image'

export interface StructureAddState {
    text:               string;
    /** The ship scan, pasted on the Fitting step. */
    fit_text:           string;
    name:               string;
    solar_system_name:  string;
    location_id:        number | null;
    id_source:          string;
    found_with:         string;
    type_id:            number | null;
    type_name:          string;
    match_status:       string;
    reinforce_hour:     number | null;
    modules:            StructureLocationModule[];
    parts:              string[];
}

interface Props {
    step:           'paste' | 'docked' | 'match' | 'fitting' | 'reinforce' | 'details' | 'sent';
    state?:         Partial<StructureAddState>;
    docked?:        StructureLocationDocked[];
    error?:         string | null;
}

const { step, docked = [], error = null } = Astro.props
const state: StructureAddState = {
    text: '', fit_text: '', name: '', solar_system_name: '', location_id: null, id_source: '', found_with: '',
    type_id: null, type_name: '', match_status: '', reinforce_hour: null, modules: [], parts: [],
    ...(Astro.props.state ?? {}),
}

const URL = translatePath('/partials/structures_add_component/')
const STEPS = ['paste', 'fitting', 'reinforce', 'details', 'sent'] as const
const current = step === 'docked' || step === 'match' ? 0 : STEPS.indexOf(step as typeof STEPS[number])

const rigs = state.modules.filter((m) => m.slot === 'rig')
const services = state.modules.filter((m) => m.slot === 'service')
const defenses = state.modules.filter((m) => m.slot === 'defense')
const step_summary = [
    state.name.split(' - ').slice(1).join(' - ') || state.name,
    state.modules.length ? t('structures.add.fit_summary').replace('~RIGS', String(rigs.length)).replace('~SERVICES', String(services.length)) : t('structures.add.no_scan'),
    state.reinforce_hour === null ? t('structures.add.not_known') : `${String(state.reinforce_hour).padStart(2, '0')}:00 EVE`,
    '',
    '',
]
const steps = STEPS.map((name, index) => ({
    label: t(t_key('structures.add.step_', name)),
    note: index < current ? step_summary[index] : index === current ? t(t_key('structures.add.step_now_', step === 'match' ? 'match' : name)) : '',
}))
const short_default = state.name.length <= 32 ? state.name : (state.name.split(' - ')[0] + ' - ' + (state.name.split(' - ')[1] ?? '')).slice(0, 32)
const hour = (value: number | null) => value === null ? '' : String(value)
const go = (value: string) => JSON.stringify({ go: value })

import Button from '@components/blocks/Button.astro'
import ChipGroup from '@components/blocks/ChipGroup.astro'
import FilterChip from '@components/blocks/FilterChip.astro'
import Input from '@components/blocks/Input.astro'
import Select from '@components/blocks/Select.astro'
import Textarea from '@components/blocks/Textarea.astro'
import ManageField from '@components/blocks/manage/ManageField.astro'
import StructureFit from '@components/blocks/structures/StructureFit.astro'
import StructureSteps from '@components/blocks/structures/StructureSteps.astro'
import StructureHowTo from '@components/blocks/structures/StructureHowTo.astro'
import StylessButton from '@components/blocks/StylessButton.astro'
---

<StructureSteps title={t('structures.add.title')} steps_label={t('structures.add.steps')} steps={steps} current={current}>
    {/* What travels between steps. */}
    <input type="hidden" name="text" value={state.text} />
    <input type="hidden" name="name" value={state.name} />
    <input type="hidden" name="solar_system_name" value={state.solar_system_name} />
    <input type="hidden" name="location_id" value={state.location_id ?? ''} />
    <input type="hidden" name="id_source" value={state.id_source} />
    <input type="hidden" name="found_with" value={state.found_with} />
    <input type="hidden" name="type_id" value={state.type_id ?? ''} />
    <input type="hidden" name="type_name" value={state.type_name} />
    <input type="hidden" name="match_status" value={state.match_status} />
    <input type="hidden" name="modules" value={JSON.stringify(state.modules)} />
    <input type="hidden" name="parts" value={state.parts.join(',')} />
    {step !== 'fitting' && <input type="hidden" name="fit_text" value={state.fit_text} />}
    {step !== 'reinforce' && <input type="hidden" name="reinforce_hour" value={hour(state.reinforce_hour)} />}

    {error && <p class="[ manage-field__error ]" role="alert">{error}</p>}

    {step === 'paste' &&
        <div class="[ structure-add__body ]">
            <StructureHowTo topics={['name']} />
            <ManageField label={t('structures.add.paste_label')} for="structure-add-text">
                <Textarea id="structure-add-text" name="text_input" rows="5" placeholder={t('structures.add.paste_placeholder')} x-ref="paste">{state.text}</Textarea>
            </ManageField>
            <StylessButton type="button" class="[ structure-add__link ]" hx-post={URL} hx-vals={go('docked')} hx-target="#structure-add" hx-swap="innerHTML">
                {t('structures.add.use_docked')}
            </StylessButton>
            <div class="[ manage-actions ]">
                <Button type="button" size="sm" color="fleet-red" hx-post={URL} hx-vals={go('match')} hx-target="#structure-add" hx-swap="innerHTML" hx-disabled-elt="this">{t('structures.add.next')}</Button>
                <Button type="button" size="sm" color="transparent" x-on:click="close_dialog()">{t('cancel')}</Button>
            </div>
        </div>
    }

    {step === 'docked' &&
        <div class="[ structure-add__body ]">
            {docked.length === 0
                ? <p>{t('structures.add.not_docked')}</p>
                : (
                    <ul class="[ structure-add__docked ]">
                        {docked.map((row) => (
                            <li>
                                <span><b>{row.character_name}</b> · {row.name || t('structures.add.unknown_name')}</span>
                                <Button type="button" size="sm" color="fleet-red" hx-post={URL} hx-target="#structure-add" hx-swap="innerHTML"
                                    hx-vals={JSON.stringify({ go: 'match', docked_location_id: row.location_id, docked_name: row.name, docked_character: row.character_name })}>
                                    {t('structures.add.use_this')}
                                </Button>
                            </li>
                        ))}
                    </ul>
                )
            }
            <div class="[ manage-actions ]">
                <Button type="button" size="sm" color="transparent" hx-post={URL} hx-vals={go('paste')} hx-target="#structure-add" hx-swap="innerHTML">{t('structures.add.back')}</Button>
            </div>
        </div>
    }

    {step === 'match' &&
        <div class="[ structure-add__body ]">
            <span class="[ manage-field__label ]">{t('structures.add.is_this_it')}</span>
            <div class="[ structure-add__result ]">
                {state.type_id ? <img src={get_item_icon(state.type_id, 64)} alt="" width="56" height="56" /> : <span class="[ structure-add__glyph ]" aria-hidden="true"></span>}
                <div>
                    <b>{state.name.split(' - ').slice(1).join(' - ') || state.name || t('structures.add.unknown_name')}</b>
                    <small>{[state.type_name, state.solar_system_name, state.location_id ? `ID ${state.location_id}` : ''].filter(Boolean).join(' · ')}</small>
                </div>
                <span class:list={['[ structure-add__status ]', state.match_status]}>{t(t_key('structures.add.match_', state.match_status || 'none'))}</span>
            </div>
            <small class="[ manage-muted ]">
                {t(t_key('structures.add.source_', state.match_status === 'found' ? state.id_source : state.match_status || 'none')).replace('~CHARACTER', state.found_with)}
            </small>
            <div class="[ manage-actions ]">
                {(state.match_status === 'found' || state.match_status === 'none') &&
                    <Button type="button" size="sm" color="fleet-red" hx-post={URL} hx-vals={go('fitting')} hx-target="#structure-add" hx-swap="innerHTML">
                        {state.match_status === 'none' ? t('structures.add.next_pending') : t('structures.add.next')}
                    </Button>
                }
                {state.match_status === 'listed' && state.location_id &&
                    <Button size="sm" color="fleet-red" href={translatePath(`/structures/${state.location_id}/`)}>{t('structures.add.open_it')}</Button>
                }
                <Button type="button" size="sm" color="transparent" hx-post={URL} hx-vals={go('paste')} hx-target="#structure-add" hx-swap="innerHTML">{t('structures.add.back')}</Button>
            </div>
        </div>
    }

    {step === 'fitting' &&
        <div class="[ structure-add__body ]">
            <StructureHowTo topics={['fitting']} />
            <ManageField label={t('structures.add.fit_label')} for="structure-add-fit">
                <Textarea id="structure-add-fit" name="fit_text" rows="5" placeholder={t('structures.add.fit_placeholder')}>{state.fit_text}</Textarea>
            </ManageField>
            {state.modules.length > 0 &&
                <Fragment>
                    <span class="[ manage-field__label ]">{t('structures.add.fit_from_scan')}</span>
                    <div class="[ structure-add__mods ]">
                        {[['rigs', rigs], ['services', services], ['defenses', defenses]].filter(([, list]) => (list as StructureLocationModule[]).length > 0).map(([group, list]) => (
                            <div>
                                <p class="[ structure-add__group ]"><span>{t(t_key('structures.add.group_', group as string))}</span><span>{(list as StructureLocationModule[]).length}</span></p>
                                <ul>
                                    {(list as StructureLocationModule[]).map((module) => <li>{module.name}</li>)}
                                </ul>
                            </div>
                        ))}
                    </div>
                    <StructureFit rigs={rigs} services={services.map((s) => s.label)} is_structure={true} scanned={true} />
                </Fragment>
            }
            <div class="[ manage-actions ]">
                {state.modules.length > 0
                    ? <Button type="button" size="sm" color="fleet-red" hx-post={URL} hx-vals={go('reinforce')} hx-target="#structure-add" hx-swap="innerHTML">{t('structures.add.next')}</Button>
                    : <Button type="button" size="sm" color="fleet-red" hx-post={URL} hx-vals={go('fitting_read')} hx-target="#structure-add" hx-swap="innerHTML" hx-disabled-elt="this">{t('structures.add.read_scan')}</Button>
                }
                {state.modules.length > 0
                    ? <Button type="button" size="sm" color="transparent" hx-post={URL} hx-vals={go('fitting_read')} hx-target="#structure-add" hx-swap="innerHTML">{t('structures.add.read_again')}</Button>
                    : <Button type="button" size="sm" color="transparent" hx-post={URL} hx-vals={go('reinforce_skip')} hx-target="#structure-add" hx-swap="innerHTML">{t('structures.add.skip_scan')}</Button>
                }
                <Button type="button" size="sm" color="transparent" hx-post={URL} hx-vals={go('match_back')} hx-target="#structure-add" hx-swap="innerHTML">{t('structures.add.back')}</Button>
            </div>
        </div>
    }

    {step === 'reinforce' &&
        <div class="[ structure-add__body ]">
            <StructureHowTo topics={['reinforce']} />
            <ManageField label={t('structures.add.reinforce')} for="structure-add-hour" hint={t('structures.add.reinforce_hint')}>
                <Select id="structure-add-hour" name="reinforce_hour" size="sm">
                    <option value="">{t('structures.add.not_known')}</option>
                    {Array.from({ length: 24 }, (_, h) => (
                        <option value={h} selected={state.reinforce_hour === h}>{String(h).padStart(2, '0')}:00 EVE</option>
                    ))}
                </Select>
            </ManageField>
            <div class="[ manage-actions ]">
                <Button type="button" size="sm" color="fleet-red" hx-post={URL} hx-vals={go('details')} hx-target="#structure-add" hx-swap="innerHTML">{t('structures.add.next')}</Button>
                <Button type="button" size="sm" color="transparent" hx-post={URL} hx-vals={go('fitting')} hx-target="#structure-add" hx-swap="innerHTML">{t('structures.add.back')}</Button>
            </div>
        </div>
    }

    {step === 'details' &&
        <div class="[ structure-add__body ]">
            <ManageField label={t('structures.add.short_name')} for="structure-add-short" hint={t('structures.add.short_name_hint')}>
                <Input id="structure-add-short" name="short_name" maxlength="32" value={short_default} required />
            </ManageField>
            <ManageField label={t('structures.add.audience')} for="structure-add-aud" hint={t('structures.add.audience_hint')}>
                <Select id="structure-add-aud" name="audience" size="sm">
                    <option value="public" selected>{t('structures.audience.public')}</option>
                    <option value="alliance">{t('structures.audience.alliance')}</option>
                </Select>
            </ManageField>
            <fieldset class="[ manage-fieldset ]">
                <legend class="[ manage-field__label ]">{t('structures.add.good_for')}</legend>
                <ChipGroup wrap={true}>
                    {['industry', 'clones', 'logistics'].map((value) => (
                        <FilterChip type="checkbox" name="good_for" value={value} checked={value === 'industry' && rigs.length > 0}>
                            {t(t_key('structures.good_for.', value))}
                        </FilterChip>
                    ))}
                </ChipGroup>
            </fieldset>
            <ManageField label={t('structures.add.about')} for="structure-add-about">
                <Textarea id="structure-add-about" name="description" rows="3" maxlength="4000" />
            </ManageField>
            <div class="[ manage-actions ]">
                <Button type="button" size="sm" color="fleet-red" hx-post={URL} hx-vals={go('submit')} hx-target="#structure-add" hx-swap="innerHTML" hx-disabled-elt="this">{t('structures.add.send')}</Button>
                <Button type="button" size="sm" color="transparent" hx-post={URL} hx-vals={go('reinforce')} hx-target="#structure-add" hx-swap="innerHTML">{t('structures.add.back')}</Button>
            </div>
        </div>
    }

    {step === 'sent' &&
        <div class="[ structure-add__body ]">
            <div class="[ structure-add__sent ]">
                <h3>{t('structures.add.sent_title')}</h3>
                <p>{t('structures.add.sent_body')}</p>
            </div>
            <div class="[ manage-actions ]">
                <Button type="button" size="sm" color="fleet-red" x-on:click="close_dialog()">{t('structures.add.done')}</Button>
                <Button type="button" size="sm" color="transparent" hx-post={URL} hx-vals={go('paste_new')} hx-target="#structure-add" hx-swap="innerHTML">{t('structures.add.another')}</Button>
            </div>
        </div>
    }
</StructureSteps>

<style lang="scss" is:global>

    .structure-add__status {
        font-size: var(--step--1);
        font-weight: 600;
        color: var(--fleet-yellow);

        &.found {
            color: var(--green);
        }
    }

    .structure-add__mods {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        padding: var(--space-xs) var(--space-s);
        background-color: var(--surface-sunken);
        border: 1px solid var(--border-color);

        ul {
            margin: 0;
            padding: 0;
            list-style: none;
            font-size: var(--step--1);
            color: var(--highlight);
        }
    }

    .structure-add__group {
        display: flex;
        justify-content: space-between;
        margin: 0;
        font-family: var(--heading-font);
        font-size: var(--step--1);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--faded);
    }

    .structure-add__docked {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        margin: 0;
        padding: 0;
        list-style: none;

        li {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: var(--space-s);
        }
    }
</style>
