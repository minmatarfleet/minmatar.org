---
/**
 * A structure on the browse page. Every card has the same rows, so cards in
 * a row line up: a banner slot (Home or Deployment, empty otherwise), the
 * type and status tags on one line, then name, system, fitting (two lines at
 * most) and a View location button. The render fills the card behind them.
 */
import { i18n, t_key } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { StructureLocationCard } from '@dtypes/api.minmatar.org'
import { get_item_icon } from '@helpers/eve_image_server'
import { structure_flags, structure_banner, security_colour, security_label } from '@helpers/structure_locations'

interface Props {
    card:           StructureLocationCard;
    [propName: string]: any;
}

const { card, ...attributes } = Astro.props
delete attributes.class

const href = translatePath(`/structures/${card.location_id}/`)
const art = card.type_id ? get_item_icon(card.type_id, 512) : null
const scanned = card.fitting_scanned_at !== null
const banner = structure_banner(card)

import Button from '@components/blocks/Button.astro'
import StructureFlags from '@components/blocks/structures/StructureFlags.astro'
import StructureFit from '@components/blocks/structures/StructureFit.astro'
---

<article class:list={['[ structure-card ]', { 'no-art': !art }, banner && `is-${banner}`, Astro.props.class]} {...attributes}>
    {art && <img class="[ structure-card__art ]" src={art} alt="" loading="lazy" width="512" height="512" />}
    <span class="[ structure-card__shade ]" aria-hidden="true"></span>

    <div class="[ structure-card__banner ]">
        {banner &&
            <p class="[ structure-card__banner-bar ]">
                <b>{t(t_key('structures.banner.', banner))}</b>
                <span>{t('structures.banner.staging')}</span>
            </p>
        }
    </div>

    <div class="[ structure-card__meta ]">
        <span class="[ structure-card__kind ]">{card.type_name}</span>
        <StructureFlags flags={structure_flags(card, { banner: false })} />
    </div>

    <div class="[ structure-card__body ]">
        <h3 class="[ structure-card__name ]" title={card.short_name}>{card.short_name}</h3>
        <p class="[ structure-card__sys ]">
            {card.security !== null && <b style={`color: ${security_colour(card.security)}`}>{security_label(card.security)}</b>}
            <span>{card.solar_system_name}</span>
            {card.audience === 'groups' && card.audience_groups.length > 0 &&
                <span class="[ structure-card__aud ]">{card.audience_groups.join(', ')}</span>
            }
        </p>
        <StructureFit class="[ structure-card__fit ]" rigs={card.rigs} services={card.services} is_structure={card.is_structure} scanned={scanned} />
        <Button class="[ structure-card__go ]" href={href} color="transparent" size="sm" narrow={true}>
            {t('structures.card.view_location')}
            <span class="[ visually-hidden ]">{card.short_name}</span>
        </Button>
    </div>
</article>

<style lang="scss">
    .structure-card {
        position: relative;
        isolation: isolate;
        display: flex;
        flex-direction: column;
        height: 30rem;
        overflow: hidden;
        background-color: var(--component-background);

        &.no-art {
            background:
                radial-gradient(circle at 70% 25%, color-mix(in srgb, var(--alliance-blue) 35%, transparent), transparent 60%),
                var(--component-background);
        }

        &.is-home {
            --banner-color: var(--fleet-yellow);
            --banner-text: var(--background);
        }

        &.is-deployment {
            --banner-color: var(--fleet-red);
            --banner-text: var(--highlight);
        }

        &.is-home,
        &.is-deployment {
            outline: 2px solid var(--banner-color);
            outline-offset: -2px;
        }
    }

    .structure-card__art {
        position: absolute;
        inset: 0;
        z-index: -2;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 35%;
        transition: transform var(--slow-transition);
    }

    @media (hover: hover) {
        .structure-card:hover .structure-card__art {
            transform: scale(1.04);
        }
    }

    .structure-card__shade {
        position: absolute;
        inset: 0;
        z-index: -1;
        background: linear-gradient(
            180deg,
            color-mix(in srgb, var(--background) 60%, transparent) 0%,
            transparent 24%,
            transparent 38%,
            color-mix(in srgb, var(--background) 88%, transparent) 58%,
            color-mix(in srgb, var(--background) 97%, transparent) 100%
        );
    }

    /* Same height on every card, empty unless Home or Deployment. */
    .structure-card__banner {
        flex: none;
        block-size: var(--space-xl);
    }

    .structure-card__banner-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-s);
        block-size: 100%;
        margin: 0;
        padding-inline: var(--space-s);
        color: var(--banner-text);
        background-color: var(--banner-color);

        b {
            font-family: var(--heading-font);
            font-size: var(--step-2);
            font-weight: normal;
            line-height: 1;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        span {
            font-size: var(--step--1);
            font-weight: 600;
        }
    }

    /* Type and status tags on one line; extra tags are clipped, not wrapped. */
    .structure-card__meta {
        display: flex;
        flex: none;
        flex-wrap: nowrap;
        align-items: stretch;
        gap: var(--space-3xs);
        margin: var(--space-xs) var(--space-s) 0;
        overflow: hidden;

        :global(.structure-flags) {
            flex-wrap: nowrap;
        }
    }

    .structure-card__kind {
        display: inline-flex;
        flex: none;
        align-items: center;
        padding: 0.3em 0.6em;
        font-family: var(--heading-font);
        font-size: var(--step--1);
        letter-spacing: 0.08em;
        line-height: 1;
        text-transform: uppercase;
        color: var(--highlight);
        background-color: color-mix(in srgb, var(--background) 70%, transparent);
    }

    .structure-card__body {
        display: flex;
        flex-direction: column;
        margin-top: auto;
        padding: 0 var(--space-s) var(--space-s);
    }

    .structure-card__name {
        margin: 0;
        overflow: hidden;
        font-size: var(--step-1);
        line-height: 1.2;
        white-space: nowrap;
        text-overflow: ellipsis;
        color: var(--highlight);
    }

    .structure-card__sys {
        display: flex;
        gap: var(--space-2xs);
        margin: var(--space-3xs) 0 0;
        overflow: hidden;
        font-size: var(--step--1);
        white-space: nowrap;

        b {
            font-weight: 700;
        }
    }

    .structure-card__aud {
        overflow: hidden;
        text-overflow: ellipsis;
        color: var(--highlight);
    }

    /* Fitting box: two tag lines tall on every card. */
    .structure-card__body :global(.structure-card__fit) {
        --fit-row: 1.9em;

        align-content: flex-start;
        block-size: calc(2 * var(--fit-row) + var(--space-3xs));
        margin-top: var(--space-xs);
        overflow: hidden;
        font-size: var(--step--2);
    }

    .structure-card__body :global(.structure-card__fit > li) {
        box-sizing: border-box;
        block-size: var(--fit-row);
        line-height: 1;
    }

    .structure-card__body :global(.structure-card__fit .structure-rig > *) {
        display: inline-flex;
        align-items: center;
    }

    .structure-card__body :global(.structure-card__go) {
        width: 100%;
        margin-top: var(--space-s);
        background-color: color-mix(in srgb, var(--background) 60%, transparent);
        border: 1px solid var(--hairline-strong);
    }
</style>
