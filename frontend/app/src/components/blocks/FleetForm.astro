---
import { i18n, dynamic_key } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { Audience, Location, CampaignListItem, PublishableGroup } from '@dtypes/api.minmatar.org'
import type { DoctrineType, SelectOptions, FleetUI, CharacterBasic, HostOptionUI } from '@dtypes/layout_components'
import { fleet_types } from '@dtypes/api.minmatar.org'
import { get_player_icon } from '@helpers/eve_image_server'
import { AMAMAKE_LOCATION_ID } from '@helpers/market_ops_redirect'
import { ALLIANCE_HOST } from '@helpers/fleet_hosts'
import { tribe_group_cover } from '@helpers/tribe_covers'
import type { FleetPingPreviewUI } from '@helpers/fetching/fleet_ping_preview'

interface Props {
    fleet?:                         FleetUI | null;
    audiences:                      Audience[];
    locations:                      Location[];
    doctrines:                      DoctrineType[];
    campaigns?:                     CampaignListItem[];
    default_campaign_id?:           number | null;
    fleet_commander:                CharacterBasic | null;
    eve_date:                       string;
    eve_time:                       string;
    disable_motd:                   boolean;
    hide_volunteers?:               boolean;
    lang:                           string;
    /**
     * Tribe groups the FC can schedule for. Empty (the default) leaves the
     * form exactly as it was: no Host row, no switches, no ping preview.
     */
    host_groups?:                   PublishableGroup[];
    /** `alliance` or a group id: the host the form opens on. */
    selected_host?:                 string;
    /** False for a group publisher who can't schedule alliance fleets. */
    allow_alliance_host?:           boolean;
    open_to_alliance?:              boolean;
    on_schedule?:                   boolean;
    cancel_href?:                   string | null;
    ping_preview?:                  FleetPingPreviewUI | null;
}

const {
    fleet = null,
    audiences: audiences_prop,
    locations: locations_prop,
    doctrines: doctrines_prop,
    campaigns: campaigns_prop = [],
    default_campaign_id = null,
    fleet_commander,
    eve_date,
    eve_time,
    disable_motd,
    hide_volunteers = false,
    lang,
    host_groups: host_groups_prop = [],
    selected_host: selected_host_prop = ALLIANCE_HOST,
    allow_alliance_host = true,
    open_to_alliance = false,
    on_schedule = false,
    cancel_href = null,
    ping_preview = null,
} = Astro.props

const audiences = Array.isArray(audiences_prop) ? audiences_prop : []
const host_groups = Array.isArray(host_groups_prop) ? host_groups_prop : []

// Tribe group fleets: a Host row (Alliance + each group) only for FCs who can
// schedule for a group. Everything below keyed on show_host_row is absent otherwise.
const show_host_row = host_groups.length > 0
const host_options:HostOptionUI[] = !show_host_row ? [] : [
    ...(allow_alliance_host ? [{
        value: ALLIANCE_HOST,
        label: t('fleets.host.alliance'),
        sub: t('fleets.host.alliance_sub'),
        image_url: '/images/fleet-logo.png',
    }] : []),
    ...host_groups.map((group):HostOptionUI => ({
        value: String(group.id),
        label: group.name,
        sub: t('fleets.host.group_sub')
            .replace('{tribe}', group.tribe_name)
            .replace('{count}', group.member_count.toString()),
        image_url: tribe_group_cover(group.id),
    })),
]
const selected_host = host_options.some((option) => option.value === selected_host_prop) ?
    selected_host_prop :
    host_options[0]?.value ?? ALLIANCE_HOST
const initial_is_group = show_host_row && selected_host !== ALLIANCE_HOST
const initial_group = initial_is_group ? host_groups.find((group) => String(group.id) === selected_host) ?? null : null
const HOST_GROUPS = Object.fromEntries(host_groups.map((group) => [ String(group.id), {
    name: group.name,
    tribe_id: group.tribe_id,
    allow_open: group.allow_open_fleets,
    audience: t('fleets.host.audience_group').replace('{group}', group.name),
} ]))
const initial_open = Boolean(initial_group?.allow_open_fleets) && open_to_alliance
// "Post on #schedule" is on by default once the fleet is open.
const initial_schedule = initial_open ? on_schedule : true
// Spread on the audience controls: hidden and not submitted for a group fleet.
const audience_host_attributes = show_host_row ? { 'x-show': '!is_group', style: initial_is_group ? 'display: none' : undefined } : {}
const audience_input_attributes = show_host_row ? { 'x-bind:disabled': 'is_group', disabled: initial_is_group ? true : undefined } : {}
const strategic_option_attributes = show_host_row ? {
    'x-bind:disabled': 'is_group',
    'x-bind:hidden': 'is_group',
    disabled: initial_is_group ? true : undefined,
    hidden: initial_is_group ? true : undefined,
} : {}
const PING_PREVIEW_PARTIAL_URL = translatePath('/partials/discord_preview_component/')
const locations = Array.isArray(locations_prop) ? locations_prop : []
const doctrines = Array.isArray(doctrines_prop) ? doctrines_prop : []
const campaigns = Array.isArray(campaigns_prop) ? campaigns_prop : []

const no_doctrine_option = {
    label: t('no_doctrine'),
    value: '-1'
} as SelectOptions

const doctrines_select_options = [  no_doctrine_option  ].concat(
    doctrines.map( (i):SelectOptions => { return { label: i.name, value: i.id } } )
)

// An alliance with nothing running gets no dropdown at all, and the page
// then posts no `campaign_id`, which leaves the fleet's campaign untouched.
const show_campaign_picker = campaigns.length > 0 || (
    fleet?.campaign_id !== undefined && fleet?.campaign_id !== null
)

const no_campaign_option = {
    label: t('no_campaign'),
    value: '-1'
} as SelectOptions

// A fleet can be attached to a campaign that has since ended, and that
// campaign is not in the running list. Offer it anyway, or re-saving the
// fleet would silently detach it.
const current_campaign_missing = (
    fleet?.campaign_id !== undefined &&
    fleet?.campaign_id !== null &&
    !campaigns.some((campaign) => campaign.id === fleet.campaign_id)
)

const finished_campaign_option = current_campaign_missing ? [ {
    label: fleet?.campaign_name ?? fleet?.campaign_slug ?? String(fleet?.campaign_id),
    value: fleet?.campaign_id as number,
} as SelectOptions ] : []

const campaigns_select_options = [  no_campaign_option  ].concat(
    campaigns.map( (i):SelectOptions => { return { label: i.name, value: i.id } } ),
    finished_campaign_option
)

let FLEET_TYPES_LABELS = {}
const fleet_types_select_options = fleet_types.map( (i):SelectOptions => {
    FLEET_TYPES_LABELS[i] = t(dynamic_key(i)) ?? i
    return {value: i, label: t(dynamic_key(i)) ?? i}
} )

const no_location_option = {
    label: t('select_starting_station'),
    value: '',
} as SelectOptions

const locations_select_options = [no_location_option].concat(
    locations.map((location): SelectOptions => ({
        label: location.location_name,
        value: location.location_id,
    }))
)

let fleet_location_id: number | null = null
if (fleet?.location) {
    const fleet_location = locations.find(
        (location) => location.location_name === fleet.location
    )
    fleet_location_id = fleet_location?.location_id ?? null
}

// Keep the fleet's own location when editing; otherwise always Amamake.
const amamake_location = locations.find((location) => location.location_id === AMAMAKE_LOCATION_ID)
const default_location_id = fleet_location_id ?? amamake_location?.location_id ?? null
const default_location_value = default_location_id !== null ? String(default_location_id) : ''

const show_audience_picker = audiences.length > 1

const no_audience_option = {
    label: t('select_audience'),
    value: ''
} as SelectOptions

let AUDIENCES = {}
const audiences_select_options = [  no_audience_option  ].concat(
    audiences.map( (i):SelectOptions => {
        AUDIENCES[i.id] = i.display_name
        return { label: i.display_name, value: i.id }
    } )
)

let fleet_audience_id
if (fleet) {
    const fleet_audience = audiences_select_options.find((option) => option.label === fleet.audience)
    fleet_audience_id = fleet_audience !== undefined ? fleet_audience?.value : null
}

// A group fleet can't be Strategic, so a new one opens on Non-strategic.
const default_fleet_type = fleet?.type ?? (initial_is_group ? 'non_strategic' : fleet_types_select_options[0].value)
const default_doctrine = fleet?.doctrine?.id ?? doctrines_select_options[0].value
// The fleet's own campaign wins; a new fleet takes the one the page asked for.
const wanted_campaign_id = fleet?.campaign_id ?? default_campaign_id
const default_campaign = campaigns_select_options.find(
    (option) => option.value === wanted_campaign_id
)?.value ?? campaigns_select_options[0].value
const default_audience = fleet_audience_id ?? (
    audiences.length === 1
        ? audiences[0].id
        : (audiences_select_options.length !== 2 ? audiences_select_options[0].value : audiences_select_options[1].value)
)

// Alpine state holds the audience as a string so it matches the `<select>` value
const default_audience_value = String(default_audience ?? '')

// AUDIENCE_ICONS is deprecated - use audience.image_url instead

import Context from '@components/layout/Context.astro';

import Flexblock from '@components/compositions/Flexblock.astro';
import FlexInline from '@components/compositions/FlexInline.astro';
import FixedFluid from '@components/compositions/FixedFluid.astro';
import Wrapper from '@components/compositions/Wrapper.astro';
import Grid from '@components/compositions/Grid.astro';

import Button from '@components/blocks/Button.astro';
import TextGroup from '@components/blocks/TextGroup.astro';
import ComponentBlock from '@components/blocks/ComponentBlock.astro';
import Select from '@components/blocks/Select.astro';
import FlatPicker from '@components/blocks/FlatPicker.astro';
import SwitchSquare from '@components/blocks/SwitchSquare.astro';
import StylessButton from '@components/blocks/StylessButton.astro';
import CountdownConverter from '@components/blocks/CountdownConverter.astro';
import Input from '@components/blocks/Input.astro'
import MarkdownTextArea from '@components/blocks/MarkdownTextArea.astro'
import DoctrineBadge from '@components/blocks/DoctrineBadge.astro'
import PilotBadge from '@components/blocks/PilotBadge.astro'
import HostPicker from '@components/blocks/HostPicker.astro'
import FleetPingPreview from '@components/blocks/FleetPingPreview.astro'

import FlagIcon from '@components/icons/FlagIcon.astro';
import TimerIcon from '@components/icons/buttons/TimerIcon.astro';
---

<div>
    <CountdownConverter
        hidden={true}
        flatpcker_date_id='fleet_date'
        flatpcker_time_id='fleet_time'
        utc={true}
    />

    <form
        id={show_host_row ? 'fleet-form' : undefined}
        method="POST"
        x-data={`{
            submitted: false,${show_host_row ? `
            host: ${JSON.stringify(selected_host)},
            open: ${JSON.stringify(initial_open)},
            sched: ${JSON.stringify(initial_schedule)},
            host_groups: ${JSON.stringify(HOST_GROUPS)},
            members_only_note: ${JSON.stringify(t('fleets.host.members_only_note'))},
            get is_group() { return this.host !== ${JSON.stringify(ALLIANCE_HOST)} },
            get group() { return this.host_groups[this.host] ?? null },
            pick_host() {
                this.open = false
                this.sched = true
                if (this.is_group && this.fleet_type === 'strategic') this.fleet_type = 'non_strategic'
            },` : ''}
            fleet_type: ${JSON.stringify(String(default_fleet_type))},
            eve_date: ${JSON.stringify(eve_date)},
            eve_time: ${JSON.stringify(eve_time)},
            audience: ${JSON.stringify(default_audience_value)},
            location_id: ${JSON.stringify(default_location_value)},
            doctrine_id: ${JSON.stringify(String(default_doctrine))},
            campaign_id: ${JSON.stringify(String(default_campaign))},
            objective: ${JSON.stringify(fleet?.objective ?? '')},
            local_datetime: '',
            audiences: ${JSON.stringify(AUDIENCES)},
            fleet_types: ${JSON.stringify(FLEET_TYPES_LABELS)},
            get_images() {
                let images = [{
                    src: ${JSON.stringify(get_player_icon(fleet_commander?.character_id ?? 0))},
                    width: 64,
                    height: 64,
                }];

                document.querySelectorAll('#doctrine-badge picture img').forEach((img) => {
                    images.push({
                        src: img.getAttribute('src'),
                        width: 64,
                        height: 64,
                    })
                })
                
                return images
            },
            fleet_datetime(utc) {
                const date_time = this.eve_date+' '+this.eve_time
                const date_string = new Date(date_time+(utc ? ' UTC' : '')).toLocaleDateString(
                    ${JSON.stringify(lang)},
                    ${import.meta.env.DATETIME_FORMAT || '{}'}
                )

                return (date_string != 'Invalid Date' ? date_string : ${JSON.stringify(t('waiting_fleet_time'))})
            },
        }`}
        x-on:submit="launch_confetti(get_images()); submitted = true;"
    >
        <Wrapper max_width="var(--max-col-width)" padding_inline="0" padding_block="0">
            <Flexblock gap='var(--space-3xs)'>
                <ComponentBlock width='narrow'>
                    <Flexblock class="[ w-full ]" gap='var(--space-m)'>
                        <h2>{t('fleet_information')} (1/3)</h2>

                        <p>{t('fleets.add.form_info')}</p>

                        {show_host_row && <>
                            <HostPicker
                                name="host"
                                hosts={host_options}
                                selected={selected_host}
                                legend={t('fleets.host.legend')}
                                input_attributes={{ 'x-model': 'host', 'x-on:change': 'pick_host()' }}
                            />
                            <input type="hidden" name="host_tribe_id" value={initial_group?.tribe_id ?? ''} x-bind:value="group?.tribe_id ?? ''" />
                        </>}

                        <Flexblock>
                            {show_audience_picker ?
                                <FixedFluid class="[ w-full items-center ]" gap='0' width="250px" breakpoint="60%" {...audience_host_attributes}>
                                    <label>{t('select_audience')}</label>
                                    <FlexInline class="[ audiences !justify-center ]">
                                        {audiences.map((option) =>
                                            <StylessButton
                                                x-on:click={`audience = ${JSON.stringify(String(option.id))}`}
                                                type="button"
                                                data-tippy-content={option.display_name}
                                            >
                                                <img
                                                    class:list={{ selected: String(option.id) === default_audience_value }}
                                                    x-bind:class={`{ 'selected': audience === ${JSON.stringify(String(option.id))} }`}
                                                    src={option.image_url ?? '/images/fleet-logo.svg'}
                                                    height="256"
                                                    width="256"
                                                    alt={option.display_name}
                                                />
                                            </StylessButton>
                                        )}
                                        <div class="[ visually-hidden ]">
                                            <Select
                                                class="[ pointer-events-none ]"
                                                id="audience"
                                                name="audience_id"
                                                x-model="audience"
                                                tabindex="-1"
                                                required
                                                {...audience_input_attributes}
                                            >
                                                {audiences_select_options.map((option) => 
                                                    <option value={option.value} selected={String(option.value) === default_audience_value}>
                                                        {option.label}
                                                    </option>
                                                )}
                                            </Select>
                                        </div>
                                    </FlexInline>
                                </FixedFluid>
                                :
                                <input type="hidden" name="audience_id" value={default_audience_value} {...audience_input_attributes} />
                            }

                            <FixedFluid class="[ w-full items-center ]" gap="var(--space-3xs)" width="250px" breakpoint="60%">
                                <label for="location_id">{t('location')}</label>
                                <Select
                                    id="location_id"
                                    name="location_id"
                                    x-model="location_id"
                                    required
                                    hx-get={translatePath('/partials/fleet_cover')}
                                    hx-target="#viewport-cover-oob"
                                    hx-trigger="change"
                                    hx-swap="outerHTML transition:true"
                                    hx-indicator=".loader"
                                    hx-vals="js:{location_name: document.querySelector('#location_id option:checked')?.textContent?.trim() ?? ''}"
                                >
                                    {locations_select_options.map((option) =>
                                        <option
                                            value={option.value}
                                            selected={String(option.value) === default_location_value}
                                        >
                                            {option.label}
                                        </option>
                                    )}
                                </Select>
                            </FixedFluid>

                            <FixedFluid class="[ w-full items-center ]" gap="var(--space-3xs)" width="250px" breakpoint="60%">
                                <label for="doctrine">{t('doctrine')}</label>
                                <Select
                                    id="doctrine"
                                    name="doctrine_id"
                                    x-model="doctrine_id"
                                    hx-validate="true"
                                    hx-get={translatePath('/partials/doctrine_badge_component')}
                                    hx-target="#doctrine-badge"
                                    hx-on--after-request="this.removeAttribute('disabled')"
                                    hx-trigger="load, change"
                                    hx-swap="outerHTML transition:true"
                                    hx-indicator=".loader"
                                >
                                    {doctrines_select_options.map((option) => 
                                        option.value === default_doctrine ?
                                        <option value={option.value} selected>{option.label}</option> :
                                        <option value={option.value}>{option.label}</option>
                                    )}
                                </Select>
                            </FixedFluid>

                            {show_campaign_picker &&
                                <FixedFluid class="[ w-full items-center ]" gap="var(--space-3xs)" width="250px" breakpoint="60%">
                                    <label for="campaign">{t('campaign')}</label>
                                    <Select
                                        id="campaign"
                                        name="campaign_id"
                                        x-model="campaign_id"
                                    >
                                        {campaigns_select_options.map((option) =>
                                            <option
                                                value={option.value}
                                                selected={String(option.value) === String(default_campaign)}
                                            >
                                                {option.label}
                                            </option>
                                        )}
                                    </Select>
                                </FixedFluid>
                            }

                            <FixedFluid class="[ w-full items-center ]" gap="var(--space-3xs)" width="250px" breakpoint="60%">
                                <FlexInline class="[ !items-center ]" gap='var(--space-3xs)'>
                                    <label for="timfleet_dateer_date">{t('fleet_date_and_time')}</label>
                                    <StylessButton
                                        class="[ flex ]"
                                        type="button"
                                        data-tippy-content={t('set_fleet_in')}
                                        x-on:click="document.getElementById('countdown-converter-button').click()"
                                    >
                                        <TimerIcon />
                                    </StylessButton>
                                </FlexInline>
                                <Grid>
                                    <FlatPicker
                                        id="fleet_date"
                                        type="date"
                                        x-model="eve_date"
                                        name="eve_date"
                                        required
                                        value={eve_date}
                                        options={{
                                            minDate: "today",
                                        } as any}
                                    />
                                    <FlatPicker
                                        id="fleet_time"
                                        x-model="eve_time"
                                        name="eve_time"
                                        value={eve_time}
                                        required
                                        options={{
                                            enableTime: true,
                                            noCalendar: true,
                                            dateFormat: "H:i",
                                            time_24hr: true,
                                        } as any}
                                    />
                                </Grid>
                            </FixedFluid>

                            <FixedFluid class="[ w-full items-center ]" gap="var(--space-3xs)" width="250px" breakpoint="60%">
                                <label for="type">{t('type')}</label>
                                <Select id="type" x-model="fleet_type" name="fleet_type">
                                    {fleet_types_select_options.map((option) => 
                                        <option
                                            value={option.value}
                                            selected={option.value === default_fleet_type}
                                            {...(option.value === 'strategic' ? strategic_option_attributes : {})}
                                        >{option.label}</option>
                                    )}
                                </Select>
                            </FixedFluid>
                            {show_host_row &&
                                <small x-show="is_group" style={initial_is_group ? undefined : 'display: none'}>{t('fleets.host.strategic_note')}</small>
                            }

                            <FixedFluid class="[ w-full items-center ]" gap="var(--space-3xs)" width="250px" breakpoint="60%">
                                <label for="objective">{t('objective')}</label>
                                <Input
                                    id="objective"
                                    name="objective"
                                    rows="5"
                                    value={fleet?.objective ? fleet?.objective : undefined}
                                    required
                                    x-model="objective"
                                />
                            </FixedFluid>

                            <Context>
                                <Flexblock class="[ w-full ]" gap="var(--space-3xs)">
                                    <label for="description">{t('description')}</label>
                                    <MarkdownTextArea
                                        id="description"
                                        name="description"
                                        rows="5"
                                        required
                                        placeholder={t('fleet_description_placeholder')}
                                    >{fleet?.description}</MarkdownTextArea>
                                </Flexblock>
                            </Context>

                            {show_host_row &&
                                <Flexblock
                                    class="[ fleet-host-switches ]"
                                    gap="var(--space-s)"
                                    x-show="is_group"
                                    style={initial_is_group ? undefined : 'display: none'}
                                >
                                    <Flexblock gap="var(--space-s)" x-show="group?.allow_open" style={initial_group?.allow_open_fleets ? undefined : 'display: none'}>
                                        <SwitchSquare
                                            class="[ w-full ]"
                                            name="open_to_alliance"
                                            label={t('fleets.host.open_label')}
                                            description={t('fleets.host.open_description')}
                                            checked={initial_open}
                                            x-bind:checked="open"
                                            x-on:change="open = $event.target.checked; if (open) sched = true"
                                        />
                                        <SwitchSquare
                                            class="[ w-full ]"
                                            name="on_schedule"
                                            label={t('fleets.host.schedule_label')}
                                            description={t('fleets.host.schedule_description')}
                                            checked={initial_open && initial_schedule}
                                            disabled={!initial_open}
                                            x-bind:checked="open && sched"
                                            x-bind:disabled="!open"
                                            x-on:change="sched = $event.target.checked"
                                        />
                                        <small x-show="!open" style={initial_open ? 'display: none' : undefined}>{t('fleets.host.schedule_disabled')}</small>
                                    </Flexblock>
                                    <small
                                        x-show="!group?.allow_open"
                                        style={initial_group && !initial_group.allow_open_fleets ? undefined : 'display: none'}
                                        x-text="members_only_note.replace('{group}', group?.name ?? '')"
                                    >{t('fleets.host.members_only_note').replace('{group}', initial_group?.name ?? '')}</small>
                                </Flexblock>
                            }
                        </Flexblock>
                    </Flexblock>
                </ComponentBlock>

                <ComponentBlock width='narrow'>
                    <Flexblock gap='var(--space-m)'>
                        <h2>{t('confirm')} (2/3)</h2>

                        <FlexInline class="[ items-center! ]" gap='var(--space-l)'>
                            <PilotBadge
                                character_id={fleet_commander?.character_id ?? 0}
                                character_name={fleet_commander?.character_name ?? t('unknown_character')}
                                centered={true}
                                size={32}
                            >
                                <small>{t('fleet_commander')}</small>
                            </PilotBadge>

                            {fleet?.doctrine ?
                                <DoctrineBadge doctrine={fleet?.doctrine} />
                                :
                                <div id="doctrine-badge" style="display: none;" />
                            }

                            <template x-if="fleet_type === 'strategic'">
                                <p>{t('strategic_fleet')}</p>
                            </template>
                            <template x-if="fleet_type === 'non_strategic'">
                                <p>{t('non_strategic_fleet')}</p>
                            </template>
                            <template x-if="fleet_type === 'training'">
                                <p>{t('training_fleet')}</p>
                            </template>
                            <template x-if="fleet_type === 'npsi'">
                                <FlexInline class="[ items-center! ]" gap="var(--space-3xs)">
                                    <FlagIcon size={16} />
                                    <p>{t('npsi_fleet')}</p>
                                </FlexInline>
                            </template>
                        </FlexInline>
                        
                        <FlexInline gap='var(--space-l)'>
                            <TextGroup
                                title={t('eve_time')}
                                class="[ sentence-cap ]"
                                x-text="fleet_datetime()"
                            >    
                                {t('waiting_fleet_time')}
                            </TextGroup>

                            <TextGroup
                                title={t('local_time')}
                                class="[ sentence-cap ]"
                                x-text="fleet_datetime(true)"
                            >
                                {t('waiting_fleet_time')}
                            </TextGroup>

                            {show_host_row ?
                                <TextGroup
                                    class:list={{ 'text-red': !initial_is_group && !default_audience_value }}
                                    x-bind:class="{ 'text-red': !is_group && !audience }"
                                    title={t('audience')}
                                    x-text={`is_group ? (group?.audience ?? '') : (audience ? audiences[audience] : ${JSON.stringify(t('no_audience_selected'))})`}
                                >
                                    {initial_group ? HOST_GROUPS[String(initial_group.id)].audience : default_audience_value ? AUDIENCES[default_audience_value] : t('no_audience_selected')}
                                </TextGroup>
                                :
                                <TextGroup
                                    class:list={{ 'text-red': !default_audience_value }}
                                    x-bind:class="{ 'text-red': !audience }"
                                    title={t('audience')}
                                    x-text={`audience ? audiences[audience] : ${JSON.stringify(t('no_audience_selected'))}`}
                                >
                                    {default_audience_value ? AUDIENCES[default_audience_value] : t('no_audience_selected')}
                                </TextGroup>
                            }

                            <TextGroup
                                title={t('location')}
                                x-text={`[...document.getElementById('location_id')?.options ?? []].find(o => o.value === location_id)?.textContent?.trim() || ${JSON.stringify(t('select_location'))}`}
                            >
                                {locations.find((location) => String(location.location_id) === default_location_value)?.location_name ?? t('select_location')}
                            </TextGroup>
                        </FlexInline>
                    </Flexblock>
                </ComponentBlock>

                {show_host_row &&
                    <ComponentBlock width='narrow'>
                        <div
                            class="[ fleet-ping-preview ]"
                            aria-live="polite"
                            hx-post={PING_PREVIEW_PARTIAL_URL}
                            hx-trigger="change from:#fleet-form delay:400ms"
                            hx-swap="innerHTML"
                            hx-sync="this:replace"
                        >
                            <FleetPingPreview preview={ping_preview ?? { channel_name: null, payload: null, role_name: null, error: true }} />
                        </div>
                    </ComponentBlock>
                }

                <ComponentBlock width='narrow'>
                    <Flexblock
                        class="[ w-full ]"
                        gap='var(--space-m)'
                        x-data={`{
                            show: false,
                            is_last_minute_fleet() {
                                const fleet_time = new Date(\`\${eve_date}T\${eve_time}Z\`).getTime()
                                const now = new Date().getTime();
                                const distance = fleet_time - now;
                                const DISTANCE_30_MINUTES = 30*60*1000

                                this.show = (distance <= DISTANCE_30_MINUTES && distance > 0)
                            }
                        }`}
                        x-effect="eve_date && eve_time && is_last_minute_fleet()"
                    >
                        <h2>{t('fleet_submit')} (3/3)</h2>

                        <Flexblock
                            x-show="show"
                            style="display: none"
                        >
                            <p>{t('fleet_starting_soon')}</p>
                            <SwitchSquare
                                class="[ w-full ]"
                                name="start_tracking"
                                label={t('ping_fleet')}
                                description={t('start_fleet_tracking_description')}
                            />
                        </Flexblock>

                        {/*!fleet?.id &&
                            <div x-show="!show">
                                <SwitchSquare
                                    class="[ w-full ]"
                                    name="immediate_ping"
                                    label={t('preping')}
                                    description={t('preping_description')}
                                    x-bind:checked="audience > 2"
                                    x-bind:disabled="audience > 2"
                                />
                            </div>
                        */}

                        <SwitchSquare
                            class="[ w-full ]"
                            name="disable_motd"
                            label={t('disable_motd')}
                            description={t('disable_motd_description')}
                            checked={disable_motd}
                        />

                        <SwitchSquare
                            class="[ w-full ]"
                            name="hide_volunteers"
                            label={t('hide_volunteers')}
                            description={t('hide_volunteers_description')}
                            checked={hide_volunteers}
                        />
                        
                        <Button x-bind:disabled="submitted" type="submit" color={'green'} class="[ w-full ]">{t('push_button')}</Button>
                        {cancel_href &&
                            <Button href={cancel_href} color="transparent" class="[ w-full ]">{t('fleets.host.cancel')}</Button>
                        }
                    </Flexblock>
                </ComponentBlock>
            </Flexblock>
        </Wrapper>
    </form>
</div>

<style lang="scss">
    .audiences{
        button:focus-visible {
            outline: none;
            img {
                transform: scale(0.8);
                filter: saturate(0.5);
            }
        }

        img {
            filter: saturate(0);
            transform: scale(0.6);
            transition: var(--fast-transition);

            &:hover {
                filter: saturate(0.5);
            }

            @media (hover: hover) {
                &:hover {
                    transform: scale(0.8);
                }
            }

            &.selected {
                filter: saturate(1) !important;
                transform: scale(1) !important;
            }
        }
    }
</style>