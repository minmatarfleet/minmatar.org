---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { TribeAffiliationRef } from '@dtypes/api.minmatar.org'

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import Tag from '@components/blocks/Tag.astro'

interface Props {
    require_off_trial?: boolean
    allowed_affiliations?: TribeAffiliationRef[]
    show_top_separator?: boolean
    [propName: string]: any
}

const {
    require_off_trial = false,
    allowed_affiliations = [],
    show_top_separator = false,
    ...attributes
} = Astro.props

delete attributes.class

const show_affiliations = allowed_affiliations.length > 0
const show_trial = Boolean(require_off_trial)
const show = show_affiliations || show_trial
---

{show &&
    <Flexblock
        class:list={['[ tribe-group-membership-requirements ]', Astro.props.class]}
        {...attributes}
    >
        {show_top_separator &&
            <hr class="[ border-bottom w-full ]" />
        }

        {show_affiliations &&
            <>
                <h4>{t('tribes.detail.required_affiliations')}</h4>

                <FlexInline gap="var(--space-3xs)">
                    {allowed_affiliations.map((affiliation) =>
                        <Tag
                            text={affiliation.name}
                            color="fleet-yellow"
                            text_color="var(--background)"
                        />
                    )}
                </FlexInline>
            </>
        }

        {show_affiliations && show_trial &&
            <hr class="[ border-bottom w-full ]" />
        }

        {show_trial &&
            <>
                <h4>{t('tribes.detail.required_membership_status')}</h4>
                <p class="[ requirement-detail ]">
                    {t('tribes.detail.off_trial_required_short')}
                </p>
            </>
        }
    </Flexblock>
}

<style lang="scss">
    .tribe-group-membership-requirements {
        width: 100%;
    }

    .requirement-detail {
        margin: 0;
        color: var(--fleet-yellow);
        font-size: var(--small-font-font);
    }
</style>
