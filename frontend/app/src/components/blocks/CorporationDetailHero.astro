---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { CorporationInfo } from '@dtypes/api.minmatar.org'
import { get_corporation_logo } from '@helpers/eve_image_server'

interface Props {
    corporation: CorporationInfo
}

const { corporation } = Astro.props

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import PageTitle from '@components/page/PageTitle.astro'
import Tag from '@components/blocks/Tag.astro'
import Button from '@components/blocks/Button.astro'

const alliance_name = corporation.alliance_name || corporation.faction_name
const character_count = corporation.member_count != null
    ? t('corporations.detail.characters_count').replace('COUNT', String(corporation.member_count))
    : ''
const human_count = corporation.human_count != null
    ? t('corporations.detail.humans_count').replace('COUNT', String(corporation.human_count))
    : ''
const population = [character_count, human_count].filter(Boolean).join(' · ')
---

<div class="corp-masthead">
    <Flexblock class="masthead-copy" gap="var(--space-s)">
        <Flexblock class="title-stack" gap="var(--space-3xs)">
            <FlexInline class="name-row items-center" gap="var(--space-s)">
                <img
                    class="corp-logo"
                    src={get_corporation_logo(corporation.corporation_id, 128)}
                    width="128"
                    height="128"
                    alt=""
                />
                <PageTitle is_landing={true}>{corporation.corporation_name}</PageTitle>
            </FlexInline>
            <FlexInline class="items-center" gap="var(--space-2xs)">
                {corporation.ticker &&
                    <Tag color="alliance-blue" text={corporation.ticker} />
                }
                <small>
                    {alliance_name}
                    {population && ` · ${population}`}
                </small>
            </FlexInline>
        </Flexblock>
        {corporation.introduction &&
            <p class="intro">{corporation.introduction}</p>
        }
        {corporation.discord_invite_url &&
            <FlexInline class="items-center" gap="var(--space-s)">
                <Button
                    href={corporation.discord_invite_url}
                    external={true}
                    new_tab={true}
                    size="sm"
                >
                    {t('corporations.detail.join_discord')}
                </Button>
            </FlexInline>
        }
    </Flexblock>
</div>

<style lang="scss">
    .corp-masthead {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: var(--space-xl);
        width: 100%;
    }

    .masthead-copy {
        flex: 1 1 auto;
        min-width: 0;
    }

    .title-stack :global(.page-title h1.is-landing) {
        line-height: 1;
    }

    .name-row {
        align-items: center;
    }

    .corp-logo {
        height: var(--step-5);
        width: auto;
        object-fit: contain;
        flex: 0 0 auto;
    }

    .intro {
        max-width: var(--max-text-width);
        margin: 0;
    }

    @media (max-width: 48rem) {
        .corp-masthead {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>
