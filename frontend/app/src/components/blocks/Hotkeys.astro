---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import Flexblock from '@components/compositions/Flexblock.astro';
import FlexInline from '@components/compositions/FlexInline.astro';

import Kbd from '@components/blocks/Kbd.astro';
import StylessButton from '@components/blocks/StylessButton.astro';
---

<Flexblock id="hotkeys">
    <h2>{t('hotkeys')}</h2>

    <Flexblock>
        <FlexInline justification='space-between'>
            <Flexblock gap='var(--space-3xs)'>
                <StylessButton x-on:click="close_dialog(); show_pages_finder()">
                    <h4>{t('quick_navigation')}</h4>
                </StylessButton>
                <small>{t('quick_navigation_tip')}</small>
            </Flexblock>
            <FlexInline gap="var(--space-3xs)">
                <Kbd>Ctrl</Kbd>
                <span class="[ text-[var(--highlight)] ]">+</span>
                <Kbd>Shift</Kbd>
                <span class="[ text-[var(--highlight)] ]">+</span>
                <Kbd>Q</Kbd>
            </FlexInline>
        </FlexInline>

        <FlexInline justification='space-between'>
            <Flexblock gap='var(--space-3xs)'>
                <StylessButton x-on:click="close_dialog(); show_characters_finder()">
                    <h4>{t('character_finder')}</h4>
                </StylessButton>
                <small>{t('character_finder_tip')}</small>
            </Flexblock>
            <FlexInline gap="var(--space-3xs)">
                <Kbd>Ctrl</Kbd>
                <span class="[ text-[var(--highlight)] ]">+</span>
                <Kbd>Shift</Kbd>
                <span class="[ text-[var(--highlight)] ]">+</span>
                <Kbd>F</Kbd>
            </FlexInline>
        </FlexInline>

        <FlexInline justification='space-between'>
            <Flexblock gap='var(--space-3xs)'>
                <StylessButton x-on:click="close_dialog(); show_fittings_finder()">
                    <h4>{t('fitting_finder')}</h4>
                </StylessButton>
                <small>{t('fitting_finder_tip')}</small>
            </Flexblock>
            <FlexInline gap="var(--space-3xs)">
                <Kbd>Ctrl</Kbd>
                <span class="[ text-[var(--highlight)] ]">+</span>
                <Kbd>Shift</Kbd>
                <span class="[ text-[var(--highlight)] ]">+</span>
                <Kbd>G</Kbd>
            </FlexInline>
        </FlexInline>

        <FlexInline justification='space-between'>
            <small>{t('close_dialogs')}</small>
            <FlexInline gap="var(--space-3xs)">
                <Kbd>Esc</Kbd>
            </FlexInline>
        </FlexInline>
    </Flexblock>
</Flexblock>