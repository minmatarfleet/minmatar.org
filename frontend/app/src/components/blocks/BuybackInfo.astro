---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { BuybackAcceptedItem, BuybackSettings } from '@dtypes/api.minmatar.org'
import type { DisplayItem } from '@dtypes/layout_components'
import {
    BUYBACK_ORE_BASES,
    compressed_buyback_ore_base,
} from '@helpers/buyback_ore'

interface Props {
    settings: BuybackSettings;
}

const { settings } = Astro.props

const USED_IN_TOOLTIP_LIMIT = 12

function merge_used_in(
    items: BuybackAcceptedItem[],
): { type_id: number; name: string }[] {
    const by_id = new Map<number, string>()
    for (const item of items) {
        for (const entry of item.used_in ?? []) {
            by_id.set(entry.type_id, entry.name)
        }
    }
    return [...by_id.entries()]
        .map(([type_id, name]) => ({ type_id, name }))
        .sort((a, b) => a.name.localeCompare(b.name))
}

function used_in_tip_html(
    used_in: { type_id: number; name: string }[],
    ore_note = false,
): string {
    if (used_in.length === 0) return ''
    const shown = used_in.slice(0, USED_IN_TOOLTIP_LIMIT)
    const extra = used_in.length - shown.length
    const lines = [
        `<strong>${t('buyback.info.used_in')}</strong>`,
        ...(ore_note ? [`<em>${t('buyback.info.used_in_ore_note')}</em>`] : []),
        ...shown.map((entry) => entry.name),
    ]
    if (extra > 0) {
        lines.push(
            t('buyback.info.used_in_more').replace('{count}', String(extra)),
        )
    }
    return lines.join('<br>')
}

const CATEGORY_ORDER = ['ore', 'p1', 'p2', 'p3', 'p4'] as const
const CATEGORY_LABELS: Record<(typeof CATEGORY_ORDER)[number], string> = {
    ore: t('buyback.info.group.ore'),
    p1: t('buyback.info.group.p1'),
    p2: t('buyback.info.group.p2'),
    p3: t('buyback.info.group.p3'),
    p4: t('buyback.info.group.p4'),
}

const accepted_items = settings.accepted_items ?? []

function sort_display_items(items: DisplayItem[]): DisplayItem[] {
    return items.slice().sort((a, b) => {
        const demand_delta = Number(Boolean(b.in_demand)) - Number(Boolean(a.in_demand))
        if (demand_delta !== 0) return demand_delta
        return a.name.localeCompare(b.name)
    })
}

function display_items_for_category(category: (typeof CATEGORY_ORDER)[number]): DisplayItem[] {
    const items = accepted_items.filter((item) => item.category === category)
    if (category !== 'ore') {
        return sort_display_items(
            items.map((item) => ({
                type_id: item.type_id,
                name: item.name,
                used_in: item.used_in ?? [],
                in_demand: Boolean(item.in_demand),
            })),
        )
    }

    const by_base = new Map<string, BuybackAcceptedItem[]>()
    const leftover: BuybackAcceptedItem[] = []

    for (const item of items) {
        const base = compressed_buyback_ore_base(item.name)
        if (!base) {
            leftover.push(item)
            continue
        }
        const group = by_base.get(base) ?? []
        group.push(item)
        by_base.set(base, group)
    }

    const grouped: DisplayItem[] = BUYBACK_ORE_BASES
        .filter((base) => by_base.has(base))
        .map((base) => {
            const variants = (by_base.get(base) ?? [])
                .slice()
                .sort((a, b) => a.name.localeCompare(b.name))
            const preferred = variants.find((v) => v.name === `Compressed ${base}`) ?? variants[0]
            return {
                type_id: preferred.type_id,
                name: base,
                variants,
                used_in: merge_used_in(variants),
                used_in_is_ore: true,
                in_demand: variants.some((variant) => Boolean(variant.in_demand)),
            }
        })

    const extras = leftover.map((item) => ({
        type_id: item.type_id,
        name: item.name,
        used_in: item.used_in ?? [],
        used_in_is_ore: true,
        in_demand: Boolean(item.in_demand),
    }))

    return sort_display_items([...grouped, ...extras])
}

const grouped_items = CATEGORY_ORDER
    .map((category) => {
        return {
            category,
            label: CATEGORY_LABELS[category],
            items: display_items_for_category(category),
        }})
    .filter((group) => group.items.length > 0)

import TextBox from '@components/layout/TextBox.astro'

import Flexblock from '@components/compositions/Flexblock.astro'
import Grid from '@components/compositions/Grid.astro'
import FlexInlineSiblings from '@components/compositions/FlexInlineSiblings.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import Wrapper from '@components/compositions/Wrapper.astro'

import BuybackItem from '@components/blocks/BuybackItem.astro';
import BuybackVariants from '@components/blocks/BuybackVariants.astro';
import ComponentBlock from './ComponentBlock.astro'
import CollapsableButton from './CollapsableButton.astro'
import FixedFluid from '@components/compositions/FixedFluid.astro'
import TextBadge from './TextBadge.astro'
---

<Flexblock gap='var(--space-xl)'>
    <Flexblock>
        <FlexInline justification='space-between'>
            <span>{t('click_items_in_demand_tooltip')}</span>

            <FlexInline gap='var(--space-l)'>
                <FixedFluid class="[ items-center! ]" width='10px' gap='var(--space-2xs)'>
                    <span class="[ text-green green-glow ]">▲</span>
                    <TextBadge title={t('buyback.info.in_demand')}>
                        <small>{t('buyback.info.in_demand_tip')}</small>
                    </TextBadge>
                </FixedFluid>

                <FixedFluid class="[ items-center! ]" width='10px' gap='var(--space-2xs)'>
                    <span class="[ text-muted ]">▼</span>
                    <TextBadge title={t('buyback.info.surplus')}>
                        <small>{t('buyback.info.surplus_tip')}</small>
                    </TextBadge>
                </FixedFluid>
            </FlexInline>
        </FlexInline>

        <ComponentBlock 
            padding_block='var(--space-s)'
            padding_inline='var(--space-s)'
        >
            <Grid
                row_gap='var(--space-xs)'
                column_gap='var(--space-3xs)'
                min_item_width='310px'
                class="grid-fill"
            >
                {grouped_items.length > 0 ?
                    <>{grouped_items.map(group =>
                        <Flexblock gap='var(--space-xs)'>
                            <h4>{group.label}</h4>

                            <hr class="[ border-bottom ]" />

                            {group.items.length > 0 &&
                                <Flexblock gap='0'>
                                    {group.items.map(item =>
                                        <Wrapper
                                            class:list={["[ w-full self-start ]", item.in_demand ? 'demand' : 'surplus' ]}
                                            padding_block='0'
                                            padding_inline='0'
                                            x-data={`{
                                                expanded: false,
                                                toggle_collapse() {
                                                    this.expanded = !this.expanded
                                                }
                                            }`}
                                        >
                                            {item.variants && item.variants?.length > 0 ?
                                                <FlexInlineSiblings
                                                    min-shink-width='250px'
                                                    shrinkable-sibbling='first'
                                                    gap='0'
                                                >
                                                    <BuybackItem item={item} />
                                                    <CollapsableButton
                                                        class="[ px-[12px]! py-[19px]! ]"
                                                        x-on:click="toggle_collapse()"
                                                    />
                                                </FlexInlineSiblings>
                                                <div
                                                    x-show="expanded"
                                                    x-collapse.duration.0ms
                                                    style="display: none"
                                                >
                                                    <BuybackVariants item={item} />
                                                </div> :
                                                <BuybackItem item={item} />
                                            }
                                        </Wrapper>
                                )}</Flexblock>
                            }
                        </Flexblock>
                    )}</>
                    :
                    <p>{t('buyback.info.no_items')}</p>
                }
            </Grid>
        </ComponentBlock>
    </Flexblock>
</Flexblock>

<style lang="scss">
    .demand + .surplus {
        border-top: solid 1px var(--border-color);
    }
</style>