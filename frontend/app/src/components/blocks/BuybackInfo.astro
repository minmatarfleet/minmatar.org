---
import { i18n } from '@helpers/i18n'
import type { BuybackAcceptedItem, BuybackSettings } from '@dtypes/api.minmatar.org'

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import ItemPicture from '@components/blocks/ItemPicture.astro'

const { t } = i18n(Astro.url)

interface Props {
    settings: BuybackSettings;
}

const { settings } = Astro.props

const BUYBACK_ORE_BASES = [
    'Veldspar',
    'Scordite',
    'Pyroxeres',
    'Plagioclase',
    'Omber',
    'Kernite',
    'Zeolites',
    'Sylvite',
    'Bitumens',
    'Coesite',
    'Hedbergite',
    'Hemorphite',
    'Jaspet',
    'Gneiss',
    'Crokite',
    'Dark Ochre',
    'Mordunium',
    'Ytirium',
    'Eifyrium',
    'Ducinium',
    'Griemeer',
] as const

const BUYBACK_ORE_BASE_SET = new Set<string>(BUYBACK_ORE_BASES)
const GRADE_SUFFIX_RE = /\s+(II|III|IV)-Grade$/
const MOON_PREFIX_RE = /^(Brimful|Glistening)\s+/

function compressed_buyback_ore_base(name: string): string | null {
    if (!name.startsWith('Compressed ')) return null
    let rest = name.slice('Compressed '.length)
    rest = rest.replace(GRADE_SUFFIX_RE, '')
    rest = rest.replace(MOON_PREFIX_RE, '')
    return BUYBACK_ORE_BASE_SET.has(rest) ? rest : null
}

interface DisplayItem {
    type_id: number
    name: string
    variants?: BuybackAcceptedItem[]
}

const CATEGORY_ORDER = ['ore', 'p1', 'p2', 'p3', 'p4'] as const
const CATEGORY_LABELS: Record<(typeof CATEGORY_ORDER)[number], string> = {
    ore: t('buyback.info.group.ore'),
    p1: t('buyback.info.group.p1'),
    p2: t('buyback.info.group.p2'),
    p3: t('buyback.info.group.p3'),
    p4: t('buyback.info.group.p4'),
}

const accepted_items = settings.accepted_items ?? []

function display_items_for_category(category: (typeof CATEGORY_ORDER)[number]): DisplayItem[] {
    const items = accepted_items.filter((item) => item.category === category)
    if (category !== 'ore') {
        return items
            .slice()
            .sort((a, b) => a.name.localeCompare(b.name))
            .map((item) => ({ type_id: item.type_id, name: item.name }))
    }

    const by_base = new Map<string, BuybackAcceptedItem[]>()
    const leftover: BuybackAcceptedItem[] = []

    for (const item of items) {
        const base = compressed_buyback_ore_base(item.name)
        if (!base) {
            leftover.push(item)
            continue
        }
        const group = by_base.get(base) ?? []
        group.push(item)
        by_base.set(base, group)
    }

    const grouped: DisplayItem[] = BUYBACK_ORE_BASES
        .filter((base) => by_base.has(base))
        .map((base) => {
            const variants = (by_base.get(base) ?? [])
                .slice()
                .sort((a, b) => a.name.localeCompare(b.name))
            const preferred = variants.find((v) => v.name === `Compressed ${base}`) ?? variants[0]
            return {
                type_id: preferred.type_id,
                name: base,
                variants,
            }
        })

    const extras = leftover
        .slice()
        .sort((a, b) => a.name.localeCompare(b.name))
        .map((item) => ({ type_id: item.type_id, name: item.name }))

    return [...grouped, ...extras]
}

const grouped_items = CATEGORY_ORDER
    .map((category) => ({
        category,
        label: CATEGORY_LABELS[category],
        items: display_items_for_category(category),
    }))
    .filter((group) => group.items.length > 0)
---

<section class="[ buyback-info ]">
    <ComponentBlock
        class="[ buyback-info__card ]"
        padding_block="var(--space-m)"
        padding_inline="var(--space-m)"
    >
        <Flexblock gap='var(--space-xs)' class="[ buyback-info__content ]">
            <h3>{t('buyback.info.buying')}</h3>
            {grouped_items.length > 0 ?
                <div class="[ buyback-info__items ]">
                    {grouped_items.map((group) =>
                        <Flexblock gap='var(--space-3xs)' class="[ buyback-info__group ]">
                            <h4 class="[ buyback-info__group-title ]">{group.label}</h4>
                            <ul class="[ buyback-info__item-list ]">
                                {group.items.map((item) => {
                                    const variants = item.variants ?? []
                                    const show_variants = variants.length > 1
                                    const tip_html = show_variants
                                        ? `<strong>${t('buyback.info.ore_variants')}</strong><br>${variants
                                            .map((v) => v.name)
                                            .join('<br>')}`
                                        : ''
                                    return (
                                        <li>
                                            <FlexInline
                                                gap='var(--space-3xs)'
                                                class="[ buyback-info__item ]"
                                            >
                                                <ItemPicture
                                                    item_id={item.type_id}
                                                    item_name={item.name}
                                                    size={24}
                                                    icon_quality={32}
                                                />
                                                <span>{item.name}</span>
                                                {show_variants && (
                                                    <button
                                                        type="button"
                                                        class="[ buyback-info__variants ]"
                                                        aria-label={t('buyback.info.ore_variants')}
                                                        x-init={`tippy($el, {
                                                            content: ${JSON.stringify(tip_html)},
                                                            allowHTML: true,
                                                            delay: [100, 200],
                                                            arrow: true,
                                                        })`}
                                                    >
                                                        <span aria-hidden="true">i</span>
                                                        <span class="[ buyback-info__variants-count ]">
                                                            {t('buyback.info.ore_variants_count').replace(
                                                                '{count}',
                                                                String(variants.length),
                                                            )}
                                                        </span>
                                                    </button>
                                                )}
                                            </FlexInline>
                                        </li>
                                    )
                                })}
                            </ul>
                        </Flexblock>
                    )}
                </div>
                :
                <p class="[ buyback-info__empty ]">{t('buyback.info.no_items')}</p>
            }
        </Flexblock>
    </ComponentBlock>
</section>

<style lang="scss">
    .buyback-info {
        h3 {
            margin: 0;
            font-size: var(--step--1);
            font-weight: 700;
            line-height: 1.25;
            color: var(--fleet-yellow);
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        p {
            margin: 0;
        }

        :global(.buyback-info__card) {
            box-sizing: border-box;
            border-color: var(--border-color-hover);
        }

        :global(.buyback-info__content) {
            min-width: 0;
            width: 100%;
        }

        .buyback-info__empty {
            font-size: var(--step--1);
            font-weight: 400;
            line-height: 1.45;
            color: var(--highlight);
        }

        .buyback-info__items {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
            gap: var(--space-m);
            max-height: 22rem;
            overflow: auto;
            padding-inline-end: var(--space-2xs);
        }

        .buyback-info__group-title {
            margin: 0;
            font-size: var(--step--2);
            font-weight: 600;
            line-height: 1.3;
            color: var(--faded);
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

        .buyback-info__item-list {
            margin: 0;
            padding: 0;
            list-style: none;
            font-size: var(--step--1);
            font-weight: 400;
            line-height: 1.35;
            color: var(--highlight);
        }

        .buyback-info__item-list li + li {
            margin-block-start: 0.25em;
        }

        .buyback-info__item {
            align-items: center;
            min-width: 0;
        }

        .buyback-info__item > span:first-of-type {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .buyback-info__variants {
            display: inline-flex;
            align-items: center;
            gap: 0.35em;
            flex-shrink: 0;
            margin: 0;
            padding: 0;
            border: none;
            background: transparent;
            color: var(--faded);
            cursor: help;
            font: inherit;
            line-height: 1;

            > span[aria-hidden="true"] {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 1.1em;
                height: 1.1em;
                border: solid 1px currentColor;
                border-radius: 50%;
                font-size: 0.7em;
                font-weight: 700;
                font-style: italic;
                line-height: 1;
            }
        }

        .buyback-info__variants:hover,
        .buyback-info__variants:focus-visible {
            color: var(--fleet-yellow);
            outline: none;
        }

        .buyback-info__variants-count {
            font-size: var(--step--2);
            white-space: nowrap;
        }
    }
</style>
