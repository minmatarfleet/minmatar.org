---
interface Props {
    width?: string;
    size?:  'lg' | 'sm';
    [propName: string]: any;
}

const {
    width = '100%',
    size = 'lg',
    ...attributes
} = Astro.props
---

<div class="[ input-group ]">
    <slot name="icon" />
    <input {...attributes} data-size={size}/>
</div>

<style lang="scss" define:vars={{ width }}>
    input {
        max-width: var(--width);
        width: 100%;
    }
</style>

<style lang="scss">
    @use '../../styles/mixins/input_field';
    @include input_field.field;
</style>