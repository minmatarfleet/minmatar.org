---
import { i18n } from '@helpers/i18n'
import type { LoyaltyCurrency, LoyaltyMarketOrder } from '@dtypes/api.minmatar.org'
import { number_thousand_separator } from '@helpers/numbers'
import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import Button from '@components/blocks/Button.astro'
import Dialog from '@components/blocks/Dialog.astro'
import LoyaltyOrderActions from '@components/blocks/LoyaltyOrderActions.astro'
import LoyaltyOrderCard from '@components/blocks/LoyaltyOrderCard.astro'
import LoyaltyDeskLanes from '@components/blocks/LoyaltyDeskLanes.astro'
import LoyaltyOrderList from '@components/blocks/LoyaltyOrderList.astro'
import Input from '@components/blocks/Input.astro'
import Select from '@components/blocks/Select.astro'
import { EXPRESS_SLA_HOURS, format_close_time } from '@helpers/loyalty_order_stats'
import { SEND_LP_HOURS, initially_expanded } from '@helpers/loyalty_desk'

const { t, translatePath } = i18n(Astro.url)

interface Props {
    orders: LoyaltyMarketOrder[]
    /** Tribal Liberation Force: the only LP the book trades. */
    currency: LoyaltyCurrency | null
    is_logged_in: boolean
    current_user_id?: number
    can_manage_buyback?: boolean
    highlight_order_id: string | null
    claim_characters?: {
        character_name: string
        corp_name: string
        is_primary: boolean
    }[]
    claim_corporations?: string[]
    default_claim_character?: string
    default_claim_corporation?: string
    /** 'lanes' groups orders by the owed step (the Conversion desk). */
    layout?: 'list' | 'lanes'
    show_title?: boolean
    /** Median posted -> paid this week, shown when reviewing a sell order. */
    week_median_seconds?: number | null
}

const {
    orders,
    currency,
    is_logged_in,
    current_user_id = 0,
    can_manage_buyback = false,
    highlight_order_id,
    claim_characters = [],
    claim_corporations = [],
    default_claim_character = '',
    default_claim_corporation = '',
    layout = 'list',
    show_title = true,
    week_median_seconds = null,
} = Astro.props

const tier_rates = {
    standard: currency?.default_isk_per_lp ?? 0,
    express: currency?.express_isk_per_lp ?? null,
}
const express_hint = t('industry.loyalty.tier.express_description')
    .replace('{hours}', String(EXPRESS_SLA_HOURS))

const default_lp_destination = default_claim_corporation
    || claim_corporations[0]
    || ''
const default_isk_destination = default_claim_character
    || default_lp_destination
const CLAIM_DESTINATION_OTHER = '__other__'
const claim_character_names = claim_characters.map((c) => c.character_name)

// Long books show the first rows; the rest are a click away (or open
// straight away when the linked ?order= row is further down).
const VISIBLE_ROWS = 20
const rows_expanded = initially_expanded(orders, VISIBLE_ROWS, (order) => String(order.id) === highlight_order_id)

---

<section
    class="[ loyalty-orders ]"
    x-on:loyalty-open-sell.window="open_sell($event.detail)"
    x-on:loyalty-open-buy.window="open_buy()"
    x-data={`{
        busy: false,
        show_all_rows: ${rows_expanded},
        post_dialog_open: false,
        claim_dialog_open: false,
        await_lp_dialog_open: false,
        claim_order_id: null,
        await_lp_order_id: null,
        claim_side: 'sell',
        claim_remaining: 0,
        claim_amount: '',
        claim_isk_per_lp: 0,
        claim_destination_choice: '',
        claim_destination_other: '',
        claim_destination_other_value: ${JSON.stringify(CLAIM_DESTINATION_OTHER)},
        form_side: 'buy',
        form_step: 'edit',
        form_tier: 'standard',
        form_quantity: '',
        form_notes: '',
        form_destination_choice: ${JSON.stringify(default_lp_destination)},
        form_destination_other: '',
        max_sell_lp: 2500000,
        sell_lp_increment: 100000,
        currency: ${JSON.stringify(currency)},
        tier_rates: ${JSON.stringify(tier_rates)},
        is_logged_in: ${JSON.stringify(is_logged_in)},
        current_user_id: ${JSON.stringify(current_user_id)},
        can_manage_buyback: ${JSON.stringify(can_manage_buyback)},
        format_thousands(val) {
            const n = Number(String(val).replace(/,/g, '')) || 0
            return n.toLocaleString('en-US', {
                minimumFractionDigits: 0,
                maximumFractionDigits: 0,
            })
        },
        parse_int(val) {
            const n = parseInt(String(val ?? '').replace(/,/g, ''), 10)
            return Number.isFinite(n) ? n : 0
        },
        claim_amount_value() {
            return this.parse_int(this.claim_amount)
        },
        form_quantity_value() {
            return this.parse_int(this.form_quantity)
        },
        form_side_allowed() {
            if (!this.currency) return false
            return this.form_side === 'sell'
                ? this.currency.allow_sell
                : this.currency.allow_buy
        },
        express_available() {
            return Boolean(this.tier_rates.express)
        },
        form_isk_per_lp_value() {
            return Number(this.tier_rates[this.form_tier]) || 0
        },
        form_quantity_over_max() {
            return this.form_side === 'sell' && this.form_quantity_value() > this.max_sell_lp
        },
        form_quantity_off_increment() {
            if (this.form_side !== 'sell') return false
            const quantity = this.form_quantity_value()
            return quantity > 0 && quantity % this.sell_lp_increment !== 0
        },
        form_quantity_invalid() {
            return this.form_quantity_over_max() || this.form_quantity_off_increment()
        },
        clamp_sell_quantity() {
            if (this.form_side === 'sell' && this.form_quantity_value() > this.max_sell_lp) {
                this.form_quantity = this.format_thousands(this.max_sell_lp)
            }
        },
        form_isk_total() {
            return this.form_quantity_value() * this.form_isk_per_lp_value()
        },
        form_destination_is_other() {
            return this.form_destination_choice === this.claim_destination_other_value
        },
        form_destination_value() {
            if (this.form_destination_is_other()) {
                return String(this.form_destination_other || '').trim()
            }
            return String(this.form_destination_choice || '').trim()
        },
        form_can_submit() {
            if (!(this.form_quantity_value() > 0
                && this.form_isk_per_lp_value() > 0
                && !this.form_quantity_invalid())) {
                return false
            }
            if (this.form_side === 'buy' && !this.form_destination_value()) {
                return false
            }
            return true
        },
        post_title() {
            return this.form_side === 'sell'
                ? ${JSON.stringify(t('industry.loyalty.post_sell'))}
                : ${JSON.stringify(t('industry.loyalty.post_buy'))}
        },
        claim_isk_total() {
            return this.claim_amount_value() * (Number(this.claim_isk_per_lp) || 0)
        },
        claim_remaining_text() {
            return ${JSON.stringify(t('industry.loyalty.claim.remaining'))}.replace(
                '{amount}',
                this.format_thousands(this.claim_remaining),
            )
        },
        claim_destination_is_other() {
            return this.claim_destination_choice === this.claim_destination_other_value
        },
        claim_destination_value() {
            if (this.claim_destination_is_other()) {
                return String(this.claim_destination_other || '').trim()
            }
            return String(this.claim_destination_choice || '').trim()
        },
        claim_destination_label() {
            return this.claim_side === 'buy'
                ? ${JSON.stringify(t('industry.loyalty.claim.destination_isk'))}
                : ${JSON.stringify(t('industry.loyalty.claim.destination_lp'))}
        },
        claim_destination_other_label() {
            return this.claim_side === 'buy'
                ? ${JSON.stringify(t('industry.loyalty.claim.destination_other_isk_label'))}
                : ${JSON.stringify(t('industry.loyalty.claim.destination_other_label'))}
        },
        claim_destination_other_placeholder() {
            return this.claim_side === 'buy'
                ? ${JSON.stringify(t('industry.loyalty.claim.destination_other_isk_placeholder'))}
                : ${JSON.stringify(t('industry.loyalty.claim.destination_other_placeholder'))}
        },
        claim_select_placeholder() {
            return this.claim_side === 'buy'
                ? ${JSON.stringify(t('industry.loyalty.claim.select_destination'))}
                : ${JSON.stringify(t('industry.loyalty.claim.select_corporation'))}
        },
        async show_response_error(response, fallback) {
            let detail = fallback
            try {
                const data = await response.json()
                if (typeof data.detail === 'string') detail = data.detail
            } catch (e) {}
            const normalized = String(detail).toLowerCase()
            if (normalized === 'feature_denied') {
                detail = this.form_side === 'buy'
                    ? ${JSON.stringify(t('industry.loyalty.feature_denied_buy'))}
                    : ${JSON.stringify(t('industry.loyalty.feature_denied'))}
            }
            await show_alert_dialog({ title: detail })
        },
        async post_order() {
            if (!this.is_logged_in) {
                await show_alert_dialog({ title: ${JSON.stringify(t('industry.loyalty.login_required'))} })
                return
            }
            const quantity = this.form_quantity_value()
            if (!this.currency || !quantity || quantity <= 0) {
                await show_alert_dialog({ title: ${JSON.stringify(t('industry.loyalty.form.invalid'))} })
                return
            }
            if (this.form_side === 'sell' && quantity > this.max_sell_lp) {
                await show_alert_dialog({ title: ${JSON.stringify(t('industry.loyalty.form.quantity_sell_max'))} })
                return
            }
            if (this.form_side === 'sell' && quantity % this.sell_lp_increment !== 0) {
                await show_alert_dialog({ title: ${JSON.stringify(t('industry.loyalty.form.quantity_sell_increment'))} })
                return
            }
            const destination = this.form_destination_value()
            if (this.form_side === 'buy' && !destination) {
                await show_alert_dialog({ title: ${JSON.stringify(t('industry.loyalty.destination_required'))} })
                return
            }
            this.busy = true
            try {
                const body = {
                    loyalty_point_id: this.currency.id,
                    side: this.form_side,
                    quantity,
                    tier: this.form_tier,
                    notes: this.form_notes || '',
                }
                if (this.form_side === 'buy') {
                    body.destination_character_name = destination
                }
                const response = await fetch(${JSON.stringify(translatePath('/api/industry/loyalty/orders'))}, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body),
                })
                if (!response.ok) {
                    await this.show_response_error(response, ${JSON.stringify(t('industry.loyalty.form.error'))})
                    return
                }
                const created = await response.json().catch(() => null)
                if (created && created.id) {
                    window.location.href = ${JSON.stringify(translatePath('/industry/loyalty/orders/'))} + created.id + '/?posted=1'
                    return
                }
                window.location.reload()
            } finally {
                this.busy = false
            }
        },
        open_claim(orderId, remaining, iskPerLp, side) {
            this.claim_order_id = orderId
            this.claim_side = side === 'buy' ? 'buy' : 'sell'
            this.claim_remaining = Number(remaining) || 0
            this.claim_isk_per_lp = Number(iskPerLp) || 0
            this.claim_amount = this.format_thousands(this.claim_remaining)
            // Require an explicit destination pick — do not default to primary corp.
            this.claim_destination_choice = ''
            this.claim_destination_other = ''
            this.post_dialog_open = false
            this.await_lp_dialog_open = false
            this.claim_dialog_open = true
            this.$nextTick(() => document.getElementById('loyalty-claim-amount')?.focus())
        },
        claim_destination_hint() {
            return this.claim_side === 'buy'
                ? ${JSON.stringify(t('industry.loyalty.claim.destination_buy_hint'))}
                : ${JSON.stringify(t('industry.loyalty.claim.destination_sell_hint'))}
        },
        reset_form_destination() {
            const primary = ${JSON.stringify(default_lp_destination)}
            this.form_destination_choice = primary || this.claim_destination_other_value
            this.form_destination_other = ''
        },
        close_claim_dialog() {
            this.close_dialog()
        },
        async submit_claim() {
            if (!this.claim_order_id) return
            const amount = this.claim_amount_value()
            if (!amount || amount <= 0 || amount > this.claim_remaining) {
                await show_alert_dialog({ title: ${JSON.stringify(t('industry.loyalty.claim.invalid'))} })
                return
            }
            const destination = this.claim_destination_value()
            if (!destination) {
                await show_alert_dialog({ title: ${JSON.stringify(t('industry.loyalty.destination_required'))} })
                return
            }
            const knownCharacters = ${JSON.stringify(claim_character_names)}
            const knownCorporations = ${JSON.stringify(claim_corporations)}
            let destination_character_name = ''
            let destination_corporation_name = ''
            if (this.claim_side === 'buy') {
                if (knownCharacters.includes(destination)) {
                    destination_character_name = destination
                } else if (knownCorporations.includes(destination)) {
                    destination_corporation_name = destination
                } else {
                    destination_character_name = destination
                }
            } else {
                destination_corporation_name = destination
            }
            this.busy = true
            try {
                const response = await fetch(${JSON.stringify(translatePath('/api/industry/loyalty/orders/'))} + this.claim_order_id + '/claim', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        amount,
                        destination_character_name,
                        destination_corporation_name,
                    }),
                })
                if (!response.ok) {
                    await this.show_response_error(response, ${JSON.stringify(t('industry.loyalty.action.error'))})
                    return
                }
                window.location.reload()
            } finally {
                this.busy = false
            }
        },
        async set_status(orderId, status, destination) {
            const body = { status }
            if (status === 'awaiting_lp') {
                const dest = String(destination || '').trim()
                if (!dest) {
                    await show_alert_dialog({ title: ${JSON.stringify(t('industry.loyalty.destination_required'))} })
                    return
                }
                body.destination_character_name = dest
            }
            this.busy = true
            try {
                const response = await fetch(${JSON.stringify(translatePath('/api/industry/loyalty/orders/'))} + orderId, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body),
                })
                if (!response.ok) {
                    await this.show_response_error(response, ${JSON.stringify(t('industry.loyalty.action.error'))})
                    return
                }
                window.location.reload()
            } finally {
                this.busy = false
            }
        },
        async release_claim(orderId) {
            this.busy = true
            try {
                const response = await fetch(
                    ${JSON.stringify(translatePath('/api/industry/loyalty/orders/'))} + orderId + '/claim',
                    { method: 'DELETE' },
                )
                if (!response.ok) {
                    await this.show_response_error(response, ${JSON.stringify(t('industry.loyalty.action.error'))})
                    return
                }
                window.location.reload()
            } finally {
                this.busy = false
            }
        },
        open_await_lp(orderId, orderDestination) {
            this.await_lp_order_id = orderId
            const existing = String(orderDestination || '').trim()
            const primary = ${JSON.stringify(default_lp_destination)}
            const knownNames = ${JSON.stringify(claim_corporations)}
            const known = Boolean(existing && knownNames.includes(existing))
            if (existing) {
                this.claim_destination_choice = known
                    ? existing
                    : this.claim_destination_other_value
                this.claim_destination_other = known ? '' : existing
            } else {
                this.claim_destination_choice = primary || this.claim_destination_other_value
                this.claim_destination_other = ''
            }
            this.post_dialog_open = false
            this.claim_dialog_open = false
            this.await_lp_dialog_open = true
            this.$nextTick(() => document.getElementById('loyalty-await-lp-destination')?.focus())
        },
        async submit_await_lp() {
            if (!this.await_lp_order_id) return
            const destination = this.claim_destination_value()
            if (!destination) {
                await show_alert_dialog({ title: ${JSON.stringify(t('industry.loyalty.destination_required'))} })
                return
            }
            await this.set_status(this.await_lp_order_id, 'awaiting_lp', destination)
        },
        async open_sell(detail) {
            this.form_side = 'sell'
            if (!this.form_side_allowed()) {
                await show_alert_dialog({ title: ${JSON.stringify(t('industry.loyalty.form.no_sell_currency'))} })
                return
            }
            this.claim_dialog_open = false
            this.await_lp_dialog_open = false
            this.form_step = 'edit'
            const preset = detail && typeof detail === 'object' ? detail : {}
            this.form_tier = preset.tier === 'express' && this.express_available() ? 'express' : 'standard'
            this.form_quantity = preset.quantity ? this.format_thousands(preset.quantity) : ''
            this.form_notes = ''
            this.reset_form_destination()
            this.post_dialog_open = true
            this.$nextTick(() => document.getElementById('loyalty-post-quantity')?.focus())
        },
        async open_buy() {
            if (!this.can_manage_buyback) {
                await show_alert_dialog({
                    title: ${JSON.stringify(t('industry.loyalty.feature_denied_buy'))},
                })
                return
            }
            this.form_side = 'buy'
            this.form_step = 'edit'
            if (!this.form_side_allowed()) {
                await show_alert_dialog({ title: ${JSON.stringify(t('industry.loyalty.form.no_buy_currency'))} })
                return
            }
            this.claim_dialog_open = false
            this.await_lp_dialog_open = false
            this.form_tier = 'standard'
            this.form_quantity = ''
            this.form_notes = ''
            this.reset_form_destination()
            this.post_dialog_open = true
            this.$nextTick(() => document.getElementById('loyalty-post-quantity')?.focus())
        },
        close_dialog() {
            this.post_dialog_open = false
            this.claim_dialog_open = false
            this.await_lp_dialog_open = false
            this.claim_order_id = null
            this.await_lp_order_id = null
        },
    }`}
    x-bind:aria-busy="busy"
>
    {layout === 'lanes' ? (
        <LoyaltyDeskLanes
            orders={orders}
            is_logged_in={is_logged_in}
            current_user_id={current_user_id}
            can_manage_buyback={can_manage_buyback}
        />
    ) : (
        <Flexblock gap="var(--space-s)">
            {show_title && <h2>{t('industry.loyalty.orders.title')}</h2>}

            {orders.length === 0 ? (
                <p class="[ loyalty-orders__empty ]">{t('industry.loyalty.orders.empty')}</p>
            ) : (
                <LoyaltyOrderList variant="book">
                    {orders.map((order, index) => (
                        <LoyaltyOrderCard
                            order={order}
                            highlighted={highlight_order_id === String(order.id)}
                            collapsed={index >= VISIBLE_ROWS}
                            cloaked={!rows_expanded}
                        >
                            <LoyaltyOrderActions
                                slot="actions"
                                class="[ loyalty-orders__menu ]"
                                order={order}
                                is_logged_in={is_logged_in}
                                current_user_id={current_user_id}
                                can_manage_buyback={can_manage_buyback}
                            />
                        </LoyaltyOrderCard>
                    ))}
                </LoyaltyOrderList>
            )}
            {orders.length > VISIBLE_ROWS && (
                <button
                    type="button"
                    class="[ loyalty-orders__more ]"
                    x-show="!show_all_rows"
                    x-on:click="show_all_rows = true"
                >
                    {t('industry.loyalty.book.show_all').replace('{count}', String(orders.length))}
                </button>
            )}
        </Flexblock>
    )}
    <template x-teleport="body">
        <Dialog
            breakout={true}
            non_centered={true}
            close_button={true}
            class="[ loyalty-orders__post-dialog w-full component overflow-y-auto ]"
            x-bind:class="post_dialog_open ? 'open' : ''"
            x-bind:aria-hidden="post_dialog_open == false"
            x-trap="post_dialog_open"
            x-bind:inert="!post_dialog_open"
            x-on:keyup.escape.window="post_dialog_open && close_dialog()"
            x-on:mousedown.outside="post_dialog_open && close_dialog()"
            style="--dialog-max-width: 520px"
            tabindex="-1"
        >
            <Flexblock gap="var(--space-l)" class="[ loyalty-orders__form ]">
                <Flexblock gap="var(--space-s)">
                    <h3 x-text="post_title()"></h3>
                    <Flexblock gap="var(--space-xs)" x-show="form_step === 'edit'">
                        <fieldset class="[ loyalty-orders__tiers ]">
                            <legend>{t('industry.loyalty.form.tier')}</legend>
                            <label class="[ loyalty-orders__tier ]">
                                <input
                                    type="radio"
                                    name="loyalty-post-tier"
                                    value="standard"
                                    x-model="form_tier"
                                />
                                <span class="[ loyalty-orders__tier-text ]">
                                    <span class="[ loyalty-orders__tier-head ]">
                                        <b>{t('industry.loyalty.tier.standard')}</b>
                                        <span class="[ tabular ]">
                                            {number_thousand_separator(tier_rates.standard)} {t('industry.loyalty.rates.isk_per_lp')}
                                        </span>
                                    </span>
                                    <small>{t('industry.loyalty.tier.standard_description')}</small>
                                </span>
                            </label>
                            <label
                                class="[ loyalty-orders__tier ]"
                                x-bind:class="!express_available() && 'is-disabled'"
                            >
                                <input
                                    type="radio"
                                    name="loyalty-post-tier"
                                    value="express"
                                    x-model="form_tier"
                                    disabled={!tier_rates.express}
                                />
                                <span class="[ loyalty-orders__tier-text ]">
                                    <span class="[ loyalty-orders__tier-head ]">
                                        <b>{t('industry.loyalty.tier.express')}</b>
                                        <span class="[ tabular ]">
                                            {tier_rates.express
                                                ? `${number_thousand_separator(tier_rates.express)} ${t('industry.loyalty.rates.isk_per_lp')}`
                                                : t('industry.loyalty.tier.express_unavailable')}
                                        </span>
                                    </span>
                                    <small>{express_hint}</small>
                                </span>
                            </label>
                        </fieldset>
                        <Flexblock class="[ w-full ]" gap="var(--space-3xs)">
                            <label for="loyalty-post-quantity">{t('industry.loyalty.form.quantity')}</label>
                            <Input
                                id="loyalty-post-quantity"
                                type="text"
                                inputmode="numeric"
                                autocomplete="off"
                                autofocus
                                x-mask:dynamic="$money($input, '.', ',', 0)"
                                x-model="form_quantity"
                                x-on:input="clamp_sell_quantity()"
                                x-on:change="clamp_sell_quantity()"
                                x-bind:aria-invalid="form_quantity_invalid()"
                            />
                            <small
                                x-show="form_side === 'sell'"
                                x-cloak
                                x-bind:class="form_quantity_invalid() && 'loyalty-orders__field-error'"
                                x-text={`form_quantity_off_increment()
                                    ? ${JSON.stringify(t('industry.loyalty.form.quantity_sell_increment'))}
                                    : ${JSON.stringify(t('industry.loyalty.form.quantity_sell_hint'))}`}
                            >
                                {t('industry.loyalty.form.quantity_sell_hint')}
                            </small>
                        </Flexblock>
                        <Flexblock
                            class="[ w-full ]"
                            gap="var(--space-3xs)"
                            x-show="form_side === 'buy'"
                            x-cloak
                        >
                            <label for="loyalty-post-destination">{t('industry.loyalty.form.destination_corporation')}</label>
                            <small>{t('industry.loyalty.form.destination_buy_hint')}</small>
                            <Select
                                id="loyalty-post-destination"
                                x-model="form_destination_choice"
                            >
                                <option value="">{t('industry.loyalty.claim.select_corporation')}</option>
                                {claim_corporations.map((corporation) =>
                                    <option value={corporation}>
                                        {corporation}
                                    </option>
                                )}
                                <option value={CLAIM_DESTINATION_OTHER}>
                                    {t('industry.loyalty.claim.destination_other')}
                                </option>
                            </Select>
                        </Flexblock>
                        <Flexblock
                            class="[ w-full ]"
                            gap="var(--space-3xs)"
                            x-show="form_side === 'buy' && form_destination_is_other()"
                            x-cloak
                        >
                            <label for="loyalty-post-destination-other">{t('industry.loyalty.claim.destination_other_label')}</label>
                            <Input
                                id="loyalty-post-destination-other"
                                type="text"
                                x-model="form_destination_other"
                                placeholder={t('industry.loyalty.claim.destination_other_placeholder')}
                            />
                        </Flexblock>
                        <Flexblock class="[ w-full ]" gap="var(--space-3xs)">
                            <label for="loyalty-post-notes">{t('industry.loyalty.form.notes')}</label>
                            <Input
                                id="loyalty-post-notes"
                                type="text"
                                x-model="form_notes"
                            />
                        </Flexblock>
                        <Flexblock gap="var(--space-3xs)" class="[ loyalty-orders__form-summary ]">
                            <FlexInline justification="flex-end">
                                <small>{t('industry.loyalty.claim.rate')}</small>
                                <small
                                    class="[ basis-[160px] text-right tabular ]"
                                    x-text="format_thousands(form_isk_per_lp_value()) + ' ISK/LP'"
                                ></small>
                            </FlexInline>
                            <FlexInline justification="flex-end">
                                <p class="[ basis-[160px] text-green text-right ]">
                                    <b x-text="format_thousands(form_isk_total()) + ' ISK'">0 ISK</b>
                                </p>
                            </FlexInline>
                        </Flexblock>
                    </Flexblock>
                    <Flexblock gap="var(--space-s)" x-show="form_step === 'review'" x-cloak>
                        <dl class="[ loyalty-orders__review tabular-nums ]">
                            <div>
                                <dt>{t('industry.loyalty.form.you_sell')}</dt>
                                <dd x-text="format_thousands(form_quantity_value()) + ' LP'"></dd>
                            </div>
                            <div>
                                <dt>{t('industry.loyalty.form.tier')}</dt>
                                <dd x-text={`(form_tier === 'express' ? ${JSON.stringify(t('industry.loyalty.tier.express'))} : ${JSON.stringify(t('industry.loyalty.tier.standard'))}) + ' · ' + format_thousands(form_isk_per_lp_value()) + ' ISK/LP'`}></dd>
                            </div>
                            <div>
                                <dt x-text={`form_tier === 'express' ? ${JSON.stringify(t('industry.loyalty.form.paid_within'))} : ${JSON.stringify(t('industry.loyalty.form.typical_wait'))}`}></dt>
                                <dd x-text={`form_tier === 'express' ? ${JSON.stringify(`${EXPRESS_SLA_HOURS}h`)} : ${JSON.stringify(week_median_seconds ? format_close_time(week_median_seconds) : '—')}`}></dd>
                            </div>
                            <div class="[ is-total ]">
                                <dt>{t('industry.loyalty.form.you_receive')}</dt>
                                <dd x-text="format_thousands(form_isk_total()) + ' ISK'"></dd>
                            </div>
                        </dl>
                        <Flexblock gap="var(--space-3xs)">
                            <h4>{t('industry.loyalty.form.after_title')}</h4>
                            <ul class="[ loyalty-orders__after ]">
                                <li>{t('industry.loyalty.form.after_thread')}</li>
                                <li>{t('industry.loyalty.form.after_claim')}</li>
                                <li>{t('industry.loyalty.form.after_send').replace('{hours}', String(SEND_LP_HOURS))}</li>
                            </ul>
                        </Flexblock>
                    </Flexblock>
                </Flexblock>
                <FlexInline justification="flex-end">
                    <Button
                        size="sm"
                        x-show="form_side === 'sell' && form_step === 'edit'"
                        color="fleet-red"
                        off_disable={true}
                        x-bind:disabled="busy || !form_can_submit()"
                        x-on:click="form_step = 'review'"
                    >
                        {t('industry.loyalty.form.review')}
                    </Button>
                    <Button
                        size="sm"
                        x-show="form_side === 'buy' || form_step === 'review'"
                        x-cloak
                        color="green"
                        off_disable={true}
                        x-bind:disabled="busy || !form_can_submit()"
                        x-on:click="post_order()"
                    >
                        <span x-text="post_title()"></span>
                    </Button>
                    <Button
                        size="sm"
                        x-on:click="form_step === 'review' ? (form_step = 'edit') : close_dialog()"
                    >
                        <span x-text={`form_step === 'review' ? ${JSON.stringify(t('industry.loyalty.form.back'))} : ${JSON.stringify(t('cancel'))}`}>{t('cancel')}</span>
                    </Button>
                </FlexInline>
            </Flexblock>
        </Dialog>
    </template>

    <template x-teleport="body">
        <Dialog
            breakout={true}
            non_centered={true}
            close_button={true}
            class="[ loyalty-orders__claim-dialog w-full component overflow-y-auto ]"
            x-bind:class="claim_dialog_open ? 'open' : ''"
            x-bind:aria-hidden="claim_dialog_open == false"
            x-trap="claim_dialog_open"
            x-bind:inert="!claim_dialog_open"
            x-on:keyup.escape.window="claim_dialog_open && close_dialog()"
            x-on:mousedown.outside="claim_dialog_open && close_dialog()"
            style="--dialog-max-width: 520px"
            tabindex="-1"
        >
            <Flexblock gap="var(--space-l)" class="[ loyalty-orders__form ]">
                <Flexblock gap="var(--space-s)">
                    <h3>{t('industry.loyalty.claim.title')}</h3>
                    <p x-text="claim_remaining_text()"></p>
                    <Flexblock gap="var(--space-xs)">
                        <Flexblock class="[ w-full ]" gap="var(--space-3xs)">
                            <label for="loyalty-claim-amount">{t('industry.loyalty.claim.amount')}</label>
                            <Input
                                id="loyalty-claim-amount"
                                type="text"
                                inputmode="numeric"
                                autocomplete="off"
                                autofocus
                                x-mask:dynamic="$money($input, '.', ',', 0)"
                                x-model="claim_amount"
                            />
                        </Flexblock>
                        <Flexblock class="[ w-full ]" gap="var(--space-3xs)">
                            <label for="loyalty-claim-destination" x-text="claim_destination_label()"></label>
                            <small x-text="claim_destination_hint()"></small>
                            <Select
                                id="loyalty-claim-destination"
                                x-model="claim_destination_choice"
                            >
                                <option value="" x-text="claim_select_placeholder()"></option>
                                <optgroup
                                    label={t('industry.loyalty.claim.destination_characters')}
                                    x-bind:hidden="claim_side !== 'buy'"
                                >
                                    {claim_characters.map((character) =>
                                        <option
                                            value={character.character_name}
                                            x-bind:disabled="claim_side !== 'buy'"
                                        >
                                            {character.character_name}
                                        </option>
                                    )}
                                </optgroup>
                                <optgroup label={t('industry.loyalty.claim.destination_corporations')}>
                                    {claim_corporations.map((corporation) =>
                                        <option value={corporation}>
                                            {corporation}
                                        </option>
                                    )}
                                </optgroup>
                                <option value={CLAIM_DESTINATION_OTHER}>
                                    {t('industry.loyalty.claim.destination_other')}
                                </option>
                            </Select>
                        </Flexblock>
                        <Flexblock
                            class="[ w-full ]"
                            gap="var(--space-3xs)"
                            x-show="claim_destination_is_other()"
                            x-cloak
                        >
                            <label for="loyalty-claim-destination-other" x-text="claim_destination_other_label()"></label>
                            <Input
                                id="loyalty-claim-destination-other"
                                type="text"
                                x-model="claim_destination_other"
                                x-bind:placeholder="claim_destination_other_placeholder()"
                            />
                        </Flexblock>
                        <Flexblock gap="var(--space-3xs)" class="[ loyalty-orders__form-summary ]">
                            <FlexInline justification="flex-end">
                                <small>{t('industry.loyalty.claim.rate')}</small>
                                <small
                                    class="[ basis-[160px] text-right tabular ]"
                                    x-text="format_thousands(claim_isk_per_lp) + ' ISK/LP'"
                                ></small>
                            </FlexInline>
                            <FlexInline justification="flex-end">
                                <p class="[ basis-[160px] text-green text-right ]">
                                    <b x-text="format_thousands(claim_isk_total()) + ' ISK'">0 ISK</b>
                                </p>
                            </FlexInline>
                        </Flexblock>
                    </Flexblock>
                </Flexblock>
                <FlexInline justification="flex-end">
                    <Button
                        size="sm"
                        color="green"
                        off_disable={true}
                        x-bind:disabled="busy || claim_amount_value() <= 0 || claim_amount_value() > claim_remaining || !claim_destination_value()"
                        x-on:click="submit_claim()"
                    >
                        {t('industry.loyalty.claim.submit')}
                    </Button>
                    <Button size="sm" x-on:click="close_dialog()">
                        {t('cancel')}
                    </Button>
                </FlexInline>
            </Flexblock>
        </Dialog>
    </template>

    <template x-teleport="body">
        <Dialog
            breakout={true}
            non_centered={true}
            close_button={true}
            class="[ loyalty-orders__await-lp-dialog w-full component overflow-y-auto ]"
            x-bind:class="await_lp_dialog_open ? 'open' : ''"
            x-bind:aria-hidden="await_lp_dialog_open == false"
            x-trap="await_lp_dialog_open"
            x-bind:inert="!await_lp_dialog_open"
            x-on:keyup.escape.window="await_lp_dialog_open && close_dialog()"
            x-on:mousedown.outside="await_lp_dialog_open && close_dialog()"
            style="--dialog-max-width: 520px"
            tabindex="-1"
        >
            <Flexblock gap="var(--space-l)" class="[ loyalty-orders__form ]">
                <Flexblock gap="var(--space-s)">
                    <h3>{t('industry.loyalty.await_lp.title')}</h3>
                    <Flexblock gap="var(--space-xs)">
                        <Flexblock class="[ w-full ]" gap="var(--space-3xs)">
                            <label for="loyalty-await-lp-destination">{t('industry.loyalty.claim.destination_corporation')}</label>
                            <small>{t('industry.loyalty.await_lp.hint')}</small>
                            <Select
                                id="loyalty-await-lp-destination"
                                x-model="claim_destination_choice"
                            >
                                <option value="">{t('industry.loyalty.claim.select_corporation')}</option>
                                {claim_corporations.map((corporation) =>
                                    <option value={corporation}>
                                        {corporation}
                                    </option>
                                )}
                                <option value={CLAIM_DESTINATION_OTHER}>
                                    {t('industry.loyalty.claim.destination_other')}
                                </option>
                            </Select>
                        </Flexblock>
                        <Flexblock
                            class="[ w-full ]"
                            gap="var(--space-3xs)"
                            x-show="claim_destination_is_other()"
                            x-cloak
                        >
                            <label for="loyalty-await-lp-destination-other">{t('industry.loyalty.claim.destination_other_label')}</label>
                            <Input
                                id="loyalty-await-lp-destination-other"
                                type="text"
                                x-model="claim_destination_other"
                                placeholder={t('industry.loyalty.claim.destination_other_placeholder')}
                            />
                        </Flexblock>
                    </Flexblock>
                </Flexblock>
                <FlexInline justification="flex-end">
                    <Button
                        size="sm"
                        color="green"
                        off_disable={true}
                        x-bind:disabled="busy || !claim_destination_value()"
                        x-on:click="submit_await_lp()"
                    >
                        {t('industry.loyalty.await_lp.submit')}
                    </Button>
                    <Button size="sm" x-on:click="close_dialog()">
                        {t('cancel')}
                    </Button>
                </FlexInline>
            </Flexblock>
        </Dialog>
    </template>
</section>

<style lang="scss">
    h2 {
        font-size: var(--step-1);
        margin: 0;
    }

    h3 {
        font-size: var(--step-1);
        margin: 0;
    }

    .loyalty-orders__more {
        align-self: flex-start;
        min-height: var(--space-l);
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--fleet-yellow);
        font-family: var(--button-font);
        font-size: var(--step--1);
        font-weight: 700;
        cursor: pointer;

        @media (hover: hover) {
            &:hover {
                text-decoration: underline;
            }
        }
    }

    .loyalty-orders__empty {
        margin: 0;
        font-size: var(--step--1);
        color: var(--highlight);
    }

    .loyalty-orders__review {
        display: flex;
        flex-direction: column;
        margin: 0;
        border: 1px solid var(--border-color-hover);

        div {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: var(--space-s);
            padding: var(--space-2xs) var(--space-xs);
        }

        div + div {
            border-block-start: 1px solid var(--border-color);
        }

        dt {
            color: var(--faded);
        }

        dd {
            margin: 0;
            font-weight: 700;
            color: var(--highlight);
        }

        .is-total {
            background-color: color-mix(in srgb, var(--fleet-yellow) 6%, transparent);

            dt {
                color: var(--highlight);
            }

            dd {
                font-size: var(--step-1);
                color: var(--fleet-yellow);
            }
        }
    }

    h4 {
        margin: 0;
        font-family: var(--default-font);
        font-size: var(--step-0);
        text-transform: none;
    }

    .loyalty-orders__after {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        margin: 0;
        padding-inline-start: var(--space-s);
        font-size: var(--step--1);
        line-height: 1.5;
        color: var(--foreground);
    }

    .loyalty-orders__form-summary {
        margin-block-start: var(--space-2xs);
        padding-block-start: var(--space-2xs);
        border-top: solid 1px var(--border-color);
    }

    .loyalty-orders__tiers {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        margin: 0;
        padding: 0;
        border: 0;

        legend {
            padding: 0;
            margin-block-end: var(--space-3xs);
        }
    }

    .loyalty-orders__tier {
        display: flex;
        align-items: flex-start;
        gap: var(--space-xs);
        padding: var(--space-2xs) var(--space-xs);
        border: solid 1px var(--border-color);
        cursor: pointer;
        transition: var(--fast-transition);

        input {
            margin-block-start: var(--space-3xs);
            accent-color: var(--fleet-yellow);
        }

        &:has(input:checked) {
            border-color: var(--fleet-yellow);
            background: color-mix(in srgb, var(--fleet-yellow) 8%, transparent);
        }

        &:has(input:focus-visible) {
            outline: 2px solid var(--highlight);
            outline-offset: 2px;
        }

        &.is-disabled {
            cursor: not-allowed;
            opacity: 0.55;
        }
    }

    .loyalty-orders__tier-text {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        flex: 1;
        min-width: 0;

        small {
            color: var(--foreground);
        }
    }

    .loyalty-orders__tier-head {
        display: flex;
        justify-content: space-between;
        gap: var(--space-xs);
        color: var(--highlight);
    }

    :global(.loyalty-orders__field-error) {
        color: var(--fleet-red);
    }

    :global(.loyalty-orders__form input:disabled),
    :global(.loyalty-orders__form input[readonly]) {
        opacity: 0.65;
        cursor: not-allowed;
        color: var(--faded);
        border-color: var(--border-color);
    }

    :global(.loyalty-orders__post-dialog),
    :global(.loyalty-orders__claim-dialog),
    :global(.loyalty-orders__await-lp-dialog) {
        max-height: 88vh;

        h3 {
            font-size: var(--step-1);
            margin: 0;
        }
    }

    [x-cloak] {
        display: none !important;
    }
</style>
