---
interface Props {
    show_history_cta?: boolean;
    show_metrics?: boolean;
}

const {
    show_history_cta = true,
    show_metrics = true,
} = Astro.props

import Flexblock from '@components/compositions/Flexblock.astro'
import FreightContractsMetricsSkeleton from '@components/blocks/FreightContractsMetricsSkeleton.astro'
---

<div
    class="[ freight-contracts-skeleton ]"
    aria-busy="true"
    aria-live="polite"
>
    <Flexblock gap="var(--space-l)">
        {show_metrics &&
            <FreightContractsMetricsSkeleton />
        }

        <div class="[ freight-contracts-skeleton__header ]">
            {Array.from({ length: 8 }).map(() =>
                <div class="[ skel skel-col ]"></div>
            )}
        </div>

        <Flexblock gap="var(--space-2xs)">
            {Array.from({ length: 8 }).map(() =>
                <div class="[ freight-contracts-skeleton__row ]">
                    <div class="[ skel skel-line skel-line--date ]"></div>
                    <div class="[ skel skel-line skel-line--name ]"></div>
                    <div class="[ skel skel-line skel-line--route ]"></div>
                    <div class="[ skel skel-line skel-line--status ]"></div>
                    <div class="[ skel skel-line skel-line--num ]"></div>
                    <div class="[ skel skel-line skel-line--num ]"></div>
                    <div class="[ skel skel-line skel-line--num ]"></div>
                    <div class="[ skel skel-line skel-line--servicing ]"></div>
                </div>
            )}
        </Flexblock>

        {show_history_cta &&
            <div class="[ skel skel-cta ]"></div>
        }
    </Flexblock>
</div>

<style lang="scss">
    .freight-contracts-skeleton .skel {
        border-radius: 2px;
        background: linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.06) 0%,
            rgba(255, 255, 255, 0.12) 50%,
            rgba(255, 255, 255, 0.06) 100%
        );
        background-size: 200% 100%;
        animation: freight-contracts-skel 1.1s ease-in-out infinite;
    }

    .freight-contracts-skeleton__header {
        display: grid;
        grid-template-columns: minmax(6.5rem, 0.8fr) minmax(10rem, 1.4fr) minmax(8rem, 1fr) minmax(7rem, 0.9fr) minmax(6rem, 0.8fr) minmax(7rem, 1fr) minmax(7rem, 1fr) minmax(7rem, 1fr);
        gap: var(--space-s);
        padding-block: var(--space-2xs);
    }

    .skel-col {
        height: 0.85rem;
        width: 70%;
    }

    .freight-contracts-skeleton__row {
        display: grid;
        grid-template-columns: minmax(6.5rem, 0.8fr) minmax(10rem, 1.4fr) minmax(8rem, 1fr) minmax(7rem, 0.9fr) minmax(6rem, 0.8fr) minmax(7rem, 1fr) minmax(7rem, 1fr) minmax(7rem, 1fr);
        gap: var(--space-s);
        align-items: center;
        min-height: 3.25rem;
        padding-block: var(--space-2xs);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .skel-line {
        height: 0.85rem;
        max-width: 100%;
    }

    .skel-line--date {
        width: 5.5rem;
    }

    .skel-line--name {
        width: 9rem;
    }

    .skel-line--route {
        width: 9rem;
    }

    .skel-line--status {
        width: 6rem;
    }

    .skel-line--num {
        width: 5rem;
    }

    .skel-line--servicing {
        width: 6.5rem;
    }

    .skel-cta {
        width: min(24rem, 100%);
        height: 2rem;
        margin-inline: auto;
        margin-block-start: var(--space-s);
    }

    @keyframes freight-contracts-skel {
        0% {
            background-position: 100% 0;
        }
        100% {
            background-position: -100% 0;
        }
    }
</style>
