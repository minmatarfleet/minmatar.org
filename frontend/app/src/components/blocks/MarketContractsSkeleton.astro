---
import Flexblock from '@components/compositions/Flexblock.astro'

interface Props {
    rows?: number;
}

const { rows = 8 } = Astro.props
---

<div
    class="[ market-contracts-skeleton ]"
    aria-busy="true"
    aria-live="polite"
>
    <Flexblock gap="var(--space-2xs)">
        {Array.from({ length: rows }).map(() =>
            <div class="[ market-contracts-skeleton__row ]">
                <div class="[ skel skel-icon ]"></div>
                <div class="[ skel skel-name ]"></div>
                <div class="[ skel skel-sellers ]"></div>
                <div class="[ skel skel-progress ]"></div>
            </div>
        )}
    </Flexblock>
</div>

<style lang="scss">
    @use '../../styles/mixins/skeleton';

    .market-contracts-skeleton .skel {
        border-radius: 2px;
        @include skeleton.shimmer;
    }

    .market-contracts-skeleton__row {
        display: grid;
        grid-template-columns: 32px minmax(8rem, 14rem) minmax(6rem, 1fr) minmax(8rem, 11rem);
        gap: var(--space-s);
        align-items: center;
        padding-block: var(--space-2xs);
    }

    .skel-icon {
        width: 32px;
        height: 32px;
        border-radius: 50%;
    }

    .skel-name {
        height: 2rem;
    }

    .skel-sellers {
        height: 2rem;
        max-width: 10rem;
    }

    .skel-progress {
        height: 0.75rem;
    }
</style>
