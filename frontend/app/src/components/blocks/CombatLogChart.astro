---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

interface Props {
    timeline_time:  string[];
    damage_in:      number[];
    damage_out:     number[];
    reps_out:       number[];
}

const {
    timeline_time,
    damage_in,
    damage_out,
    reps_out,
} = Astro.props

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'

import Button from '@components/blocks/Button.astro'
import Chart from '@components/blocks/Chart.astro'
import MultiRangeInput from '@components/blocks/MultiRangeInput.astro';

// Each series is plotted per second, so a tenth of the tick's total.
const per_second = (values: number[]) => values.map((value) => value / 10)

const dots = (values: number[]) => values.map((value) => value === 0 ? 0 : 2)

const series = (label: string, values: number[], tone: 'fleet-red' | 'alliance-blue' | 'green') => ({
    label,
    data: per_second(values),
    tone,
    fill: false,
    pointStyle: 'rect',
    borderWidth: 0,
    pointRadius: dots(values),
})

const datasets = [
    series(t('damage_taken'), damage_in, 'fleet-red'),
    series(t('damage_done'), damage_out, 'alliance-blue'),
    series(t('reps_done'), reps_out, 'green'),
]

const options = {
    scales: {
        x: { title: { display: true, text: t('ticks_axis') }, grid: { display: false }, ticks: { maxTicksLimit: 10 } },
        y: { title: { display: true, text: t('damage_reps_per_second') }, grid: { display: false } },
    },
}
---

<Flexblock
    x-data={`{
        min: 0,
        max: 0,
        set_x_axis() {
            const chart = Chart.getChart(this.$el.querySelector('canvas'))
            if (!chart) return
            chart.options.scales.x.min = this.min
            chart.options.scales.x.max = this.max
            chart.update()
        },
    }`}
>
    <Chart
        type='line'
        labels={timeline_time}
        datasets={datasets}
        options={options}
        plugins={[{ id: 'stems' }]}
        legend={true}
        height='70vh'
        aria_label={t('damage_reps_per_second')}
    />
    <FlexInline>
        <Button size='sm' narrow={true} x-on:click='set_x_axis()'>
            {t('set')}
        </Button>
        <div class="[ grow ]">
            <MultiRangeInput values={timeline_time} />
            <input type="hidden" x-model="min" />
            <input type="hidden" x-model="max" />
        </div>
    </FlexInline>
</Flexblock>
