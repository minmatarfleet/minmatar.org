---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

/**
 * Big-number stat card: an uppercase label, the value, and an optional hint
 * line. `value` and `hint` also come as named slots for markup such as
 * tooltip spans.
 */
interface Props {
    label: string
    value?: string | number
    hint?: string
    coming_soon?: boolean
    /** `compact` is a smaller card for dense rows of stats; `bar` adds a progress bar under the value (see `bar_value`). */
    variant?: 'default' | 'compact' | 'bar'
    /** Fill of the bar for `variant="bar"`, from 0 to 1. */
    bar_value?: number
    /** Colours the value and the bar; the highlight colour when unset. */
    tone?: 'fleet-red' | 'green' | 'alliance-blue' | 'fleet-yellow'
    /** Text of the "coming soon" placeholder; defaults to the translated `tribes.activity.coming_soon`. */
    coming_soon_label?: string
    /** Makes the whole card a link to where the number is worked on. */
    href?: string
    [propName: string]: any
}

const {
    label,
    value,
    hint,
    coming_soon = false,
    variant = 'default',
    bar_value = 0,
    tone,
    coming_soon_label,
    href,
    ...attributes
} = Astro.props

delete attributes.class

const bar_percent = Math.round(Math.min(1, Math.max(0, Number(bar_value) || 0)) * 100)
const style = [tone ? `--stat-tone: var(--${tone})` : '', attributes.style ?? ''].filter(Boolean).join('; ')
delete attributes.style

const Element = href ? 'a' : 'article'
const has_hint = Boolean(hint) || Astro.slots.has('hint')
---

<Element
    href={href}
    class:list={['[ stat-card ]', variant !== 'default' && `stat-card--${variant}`, { 'stat-card--soon': coming_soon, 'stat-card--link': Boolean(href) }, Astro.props.class]}
    style={style || undefined}
    {...attributes}
>
    <p class="[ stat-card__label ]">{label}</p>
    {coming_soon ?
        <p class="[ stat-card__soon ]">{coming_soon_label ?? t('tribes.activity.coming_soon')}</p>
        :
        <p class="[ stat-card__value ]"><slot name="value">{value}</slot></p>
    }
    {variant === 'bar' && !coming_soon &&
        <div
            class="[ stat-card__bar ]"
            role="meter"
            aria-label={label}
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow={bar_percent}
            style={`--stat-bar: ${bar_percent}%`}
        ></div>
    }
    {has_hint && <p class="[ stat-card__hint ]"><slot name="hint">{hint}</slot></p>}
</Element>

<style lang="scss">
    .stat-card {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        padding: var(--space-m);
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: var(--surface-sunken);
    }

    .stat-card--link {
        color: inherit;
        text-decoration: none;
        transition: background-color var(--fast-transition);

        @media (hover: hover) {
            &:hover {
                background: color-mix(in srgb, var(--highlight) var(--tint-subtle), var(--surface-sunken));
            }
        }
    }

    .stat-card--soon {
        border-style: dashed;
        border-color: rgba(255, 255, 255, 0.22);
        background: none;

        .stat-card__label {
            color: var(--faded);
        }
    }

    .stat-card__label {
        margin: 0;
        font-size: var(--step--1);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--fleet-yellow);
    }

    .stat-card__value {
        margin: 0;
        font-family: var(--heading-font);
        font-size: clamp(2rem, 4.5vw, 3rem);
        line-height: 0.95;
        letter-spacing: -0.02em;
        text-transform: uppercase;
        color: var(--stat-tone, var(--highlight));
    }

    .stat-card--compact {
        padding: var(--space-xs) var(--space-s);

        .stat-card__value {
            font-size: var(--step-2);
        }
    }

    .stat-card__bar {
        block-size: var(--space-3xs);
        background: color-mix(in srgb, var(--foreground) var(--tint-soft), transparent);

        &::after {
            content: '';
            display: block;
            block-size: 100%;
            inline-size: var(--stat-bar, 0%);
            background: var(--stat-tone, var(--highlight));
        }
    }

    /* A tooltip on the big number reads as help, not as a dotted link. */
    .stat-card__value :global(span[data-tippy-content]:not([data-tippy-content=""])) {
        border-bottom: none;
        cursor: help;
    }

    .stat-card__soon {
        margin: 0;
        font-family: var(--heading-font);
        font-size: var(--step-1);
        text-transform: uppercase;
        color: var(--faded);
    }

    .stat-card__hint {
        margin: 0;
        font-size: var(--step--1);
        color: var(--faded);
    }
</style>
