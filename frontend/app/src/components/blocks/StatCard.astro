---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

/**
 * Big-number stat card: an uppercase label, the value, and an optional hint
 * line. `value` and `hint` also come as named slots for markup such as
 * tooltip spans.
 */
interface Props {
    label: string
    value?: string | number
    hint?: string
    coming_soon?: boolean
    [propName: string]: any
}

const {
    label,
    value,
    hint,
    coming_soon = false,
    ...attributes
} = Astro.props

delete attributes.class

const has_hint = Boolean(hint) || Astro.slots.has('hint')
---

<article
    class:list={['[ stat-card ]', { 'stat-card--soon': coming_soon }, Astro.props.class]}
    {...attributes}
>
    <p class="[ stat-card__label ]">{label}</p>
    {coming_soon ?
        <p class="[ stat-card__soon ]">{t('tribes.activity.coming_soon')}</p>
        :
        <p class="[ stat-card__value ]"><slot name="value">{value}</slot></p>
    }
    {has_hint && <p class="[ stat-card__hint ]"><slot name="hint">{hint}</slot></p>}
</article>

<style lang="scss">
    .stat-card {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        padding: var(--space-m);
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(0, 0, 0, 0.22);
    }

    .stat-card--soon {
        border-style: dashed;
        border-color: rgba(255, 255, 255, 0.22);
        background: none;

        .stat-card__label {
            color: var(--faded);
        }
    }

    .stat-card__label {
        margin: 0;
        font-size: var(--step--1);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--fleet-yellow);
    }

    .stat-card__value {
        margin: 0;
        font-family: var(--heading-font);
        font-size: clamp(2rem, 4.5vw, 3rem);
        line-height: 0.95;
        letter-spacing: -0.02em;
        text-transform: uppercase;
        color: var(--highlight);
    }

    /* A tooltip on the big number reads as help, not as a dotted link. */
    .stat-card__value :global(span[data-tippy-content]:not([data-tippy-content=""])) {
        border-bottom: none;
        cursor: help;
    }

    .stat-card__soon {
        margin: 0;
        font-family: var(--heading-font);
        font-size: var(--step-1);
        text-transform: uppercase;
        color: var(--faded);
    }

    .stat-card__hint {
        margin: 0;
        font-size: var(--step--1);
        color: var(--faded);
    }
</style>
