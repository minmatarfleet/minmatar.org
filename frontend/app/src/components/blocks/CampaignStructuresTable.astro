---
import { i18n, dynamic_key, t_key } from '@helpers/i18n'
const { lang, t } = i18n(Astro.url)

import type { CampaignStructure } from '@dtypes/api.minmatar.org'
import { get_item_icon } from '@helpers/eve_image_server'
import { get_structure_id } from '@helpers/eve'
import { sort_campaign_structures } from '@helpers/campaign_features'
import { eve_date_time } from '@helpers/campaign_manage'

interface Props {
    structures:         CampaignStructure[];
    slug:               string;
    show_add_timer?:    boolean;
    tracking?:          string;
    [propName: string]: any;
}

const {
    structures,
    slug,
    show_add_timer = false,
    tracking = '',
    ...attributes
} = Astro.props

delete attributes.class


const status_color = (status:string) => {
    if (status === 'destroyed') return 'green'
    if (status === 'reinforced') return 'fleet-yellow'
    return 'alliance-blue'
}

const format_reinforce_hour = (hour:number | null) => {
    if (hour === null || hour === undefined) return ''
    return `${String(hour).padStart(2, '0')}:00`
}

const structure_icon = (structure:CampaignStructure) => {
    const type_id = structure.type_id || get_structure_id(structure.structure_type)
    return type_id ? get_item_icon(type_id, 64) : ''
}

const type_label = (structure:CampaignStructure) => t(dynamic_key(structure.structure_type)) ?? structure.structure_type
const now = Date.now()
const upcoming = (structure:CampaignStructure) => structure.timer_at !== null && new Date(structure.timer_at).getTime() > now
const rows = sort_campaign_structures(structures)

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import TimerAddDialog from '@components/blocks/structures/TimerAddDialog.astro'
import StructureReportDialog from '@components/blocks/structures/StructureReportDialog.astro'
import Tag from '@components/blocks/Tag.astro'
import Countdown from '@components/blocks/Countdown.astro'
---

<Flexblock gap='var(--space-s)' class:list={['[ campaign-structures ]', Astro.props.class]} {...attributes}>
    <FlexInline gap='var(--space-s)' justification='space-between' class="[ items-center ]">
        <Flexblock gap='var(--space-3xs)'>
            <h3>{t('campaigns.structures.title')}</h3>
            <small>{t('campaigns.structures.hint')}</small>
            {tracking && <small class="[ campaign-structures-tracking ]">{tracking}</small>}
        </Flexblock>
        {show_add_timer &&
            <FlexInline gap='var(--space-3xs)'>
                <StructureReportDialog campaign_slug={slug} label={t('campaigns.structures.report')} />
                <TimerAddDialog campaign_slug={slug} color="green" label={t('campaigns.structures.add_timer')} />
            </FlexInline>
        }
    </FlexInline>

    {structures.length === 0 ?
        <small>{t('campaigns.structures.none')}</small>
        :
        <div class="[ campaign-structures-table ]" role="table" aria-label={t('campaigns.structures.title')}>
            <div class="[ campaign-structures-head ]" role="row">
                <span role="columnheader"><span class="[ visually-hidden ]">{t('campaigns.structures.col.name')}</span></span>
                <span role="columnheader">{t('campaigns.structures.col.system')}</span>
                <span role="columnheader">{t('campaigns.structures.col.owner')}</span>
                <span role="columnheader">{t('campaigns.structures.col.status')}</span>
                <span role="columnheader">{t('campaigns.structures.col.rh')}</span>
                <span role="columnheader">{t('campaigns.structures.next_timer')}</span>
                <span role="columnheader">{t('campaigns.structures.has_fit')}</span>
            </div>
            {rows.map(structure => {
                const icon = structure_icon(structure)
                const destroyed = structure.status === 'destroyed'
                return (
                <div class:list={['[ campaign-structures-row ]', { 'is-destroyed': destroyed }]} role="row">
                    <span role="cell">
                        <button
                            type="button"
                            class="[ campaign-structures-copy ]"
                            data-name={structure.name}
                            data-tippy-content={t('campaigns.structures.copy_tip').replace('~NAME', structure.name).replace('~TYPE', type_label(structure))}
                            aria-label={`${structure.name} · ${type_label(structure)}`}
                            x-data="{ copied: false }"
                            x-on:click="navigator.clipboard.writeText($el.dataset.name).then(() => { copied = true; setTimeout(() => copied = false, 1500) })"
                            x-bind:class="{ 'is-copied': copied }"
                        >
                            {icon ?
                                <img class="[ structure-icon ]" loading="lazy" height="32" width="32" src={icon} alt="" />
                                :
                                <span>{structure.name}</span>
                            }
                        </button>
                    </span>
                    <span role="cell">{structure.system_name}</span>
                    <span role="cell">{structure.owner_alliance_ticker || '—'}</span>
                    <span role="cell">
                        <Tag
                            text={t(t_key('campaigns.structures.status.', structure.status))}
                            color={status_color(structure.status)}
                            class="w-fit"
                        />
                    </span>
                    <span role="cell">
                        {structure.reinforce_hour !== null && structure.reinforce_hour !== undefined ?
                            format_reinforce_hour(structure.reinforce_hour)
                            : '—'}
                    </span>
                    <span role="cell" class="[ campaign-structures-timer ]">
                        {upcoming(structure) && structure.timer_at ?
                            <Fragment>
                                <Countdown id={structure.id} tag="campaign-structure" date={structure.timer_at} />
                                <span class="[ campaign-structures-muted ]">{eve_date_time(lang, structure.timer_at)}</span>
                            </Fragment>
                            : destroyed && structure.destroyed_at ?
                                <span class="[ campaign-structures-muted ]">{t('campaigns.structures.killed_at').replace('~DATE', eve_date_time(lang, structure.destroyed_at))}</span>
                                : <span class="[ campaign-structures-muted ]">—</span>
                        }
                    </span>
                    <span role="cell">
                        {structure.fitting &&
                            <Tag
                                text={t('campaigns.structures.has_fit')}
                                variant="outline"
                                color="highlight"
                                narrow={true}
                                class="w-fit"
                                data-tippy-content={structure.fitting}
                            />
                        }
                    </span>
                </div>
                )
            })}
        </div>
    }
</Flexblock>

<style lang="scss">
    .campaign-structures-tracking {
        color: var(--highlight);
        font-variant-numeric: tabular-nums;
    }

    .structure-icon {
        display: block;
        flex-shrink: 0;
    }

    .campaign-structures-copy {
        display: block;
        padding: 0;
        background: none;
        border: 0;
        cursor: copy;
        color: var(--highlight);

        &.is-copied {
            outline: 1px solid var(--green);
        }
    }

    .campaign-structures-head,
    .campaign-structures-row {
        display: grid;
        grid-template-columns: 3rem minmax(0, 1fr) minmax(0, 0.8fr) minmax(0, 1fr) 4rem minmax(0, 2.4fr) 3rem;
        gap: var(--space-xs);
        align-items: center;
        white-space: nowrap;
    }

    .campaign-structures-head {
        font-size: var(--step--1);
        color: var(--highlight);
        border-bottom: solid 1px var(--border-color);
        padding-block-end: var(--space-3xs);
    }

    .campaign-structures-row {
        font-size: var(--step--1);
        padding-block: var(--space-3xs);

        > * {
            overflow: hidden;
            text-overflow: ellipsis;
        }

        &.is-destroyed {
            opacity: 0.5;
        }
    }

    .campaign-structures-timer {
        display: flex;
        align-items: baseline;
        gap: var(--space-2xs);

        :global(.countdown) {
            font-size: var(--step-1);
            letter-spacing: 2px;
            text-indent: 0;
            color: var(--highlight);
        }
    }

    .campaign-structures-muted {
        color: var(--text-muted);
    }

    @media (max-width: 720px) {
        .campaign-structures-head {
            display: none;
        }

        .campaign-structures-row {
            grid-template-columns: 3rem 1fr 1fr;
            gap: var(--space-3xs);
        }
    }
</style>
