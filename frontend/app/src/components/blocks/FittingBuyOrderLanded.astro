---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { FittingBuyOrderDetail } from '@helpers/api.minmatar.org/fitting_buy_orders'

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import Button from '@components/blocks/Button.astro'

interface Props {
    order: FittingBuyOrderDetail
    partial_base: string
    shopping_landed_complete: boolean
    saved_count?: number | null
    unresolved_names?: string[]
    paste_value?: string
    [propName: string]: any
}

const {
    order,
    partial_base,
    shopping_landed_complete,
    saved_count = null,
    unresolved_names = [],
    paste_value = '',
    ...attributes
} = Astro.props

delete attributes.class

const missing_names = order.items
    .filter((item) => item.buy_qty > 0 && !item.unit_price)
    .map((item) => item.type_name)

function name_list(names: string[]): string {
    const shown = names.slice(0, 12)
    const list = shown.join(', ')
    const extra = names.length - shown.length
    if (extra <= 0)
        return list
    return t('fitting_buy.landed_more')
        .replace('{names}', list)
        .replace('{count}', String(extra))
}
import Textarea from '@components/blocks/Textarea.astro'
---

<ComponentBlock
    class:list={['[ fitting-buy-section ]', Astro.props.class]}
    heavier={true}
    {...attributes}
>
    <Flexblock gap="var(--space-s)">
        <Flexblock gap="var(--space-3xs)">
            <h2>{t('fitting_buy.landed_prices')}</h2>
            <p class="[ fitting-buy-hint ]">{t('fitting_buy.landed_prices_tip')}</p>
        </Flexblock>
        <form
            id={`fitting-buy-landed-${order.id}`}
            hx-post={partial_base}
            hx-target="#fitting-buy-order"
            hx-swap="outerHTML"
        >
            <input type="hidden" name="action" value="landed_prices" />
            <Flexblock gap="var(--space-xs)">
                <Textarea
                    name="paste"
                    rows="4"
                    class="[ fitting-buy-textarea ]"
                    placeholder={t('fitting_buy.landed_placeholder')}
                    aria-label={t('fitting_buy.landed_prices')}
                >{paste_value}</Textarea>
                <FlexInline gap="var(--space-xs)" class="[ flex-wrap items-center ]">
                    <Button type="submit" size="sm">
                        {shopping_landed_complete
                            ? t('fitting_buy.apply_prices')
                            : t('fitting_buy.landed_continue')}
                    </Button>
                </FlexInline>
            </Flexblock>
        </form>
        {saved_count === 0 && (
            <p class="[ text-[var(--fleet-red)] text-[var(--step--1)] ]">{t('fitting_buy.landed_none')}</p>
        )}
        {saved_count !== null && saved_count > 0 && (
            <p class="[ fitting-buy-hint ]">
                {t('fitting_buy.landed_saved').replace('{count}', String(saved_count))}
            </p>
        )}
        {unresolved_names.length > 0 && (
            <p class="[ text-[var(--fleet-red)] text-[var(--step--1)] ]">
                {t('fitting_buy.landed_unresolved').replace('{names}', name_list(unresolved_names))}
            </p>
        )}
        {saved_count !== null && saved_count > 0 && missing_names.length > 0 && (
            <p class="[ fitting-buy-hint ]">
                {t('fitting_buy.landed_missing').replace('{names}', name_list(missing_names))}
            </p>
        )}
        {shopping_landed_complete ? (
            <p class="[ fitting-buy-hint ]">{t('fitting_buy.landed_ready')}</p>
        ) : (
            <p class="[ fitting-buy-hint ]">{t('fitting_buy.landed_needed')}</p>
        )}
    </Flexblock>
</ComponentBlock>

<style lang="scss">
    h2 {
        margin: 0;
        font-size: var(--step-1);
    }

    .fitting-buy-hint {
        margin: 0;
        color: var(--highlight);
        font-size: var(--step--1);
    }

    .fitting-buy-textarea {
        width: 100%;
        background: transparent;
        color: var(--foreground);
        border: 1px solid var(--border-color);
        padding: var(--space-2xs);
        font-family: var(--default-font);
        font-size: var(--step--1);
        resize: vertical;
    }
</style>
