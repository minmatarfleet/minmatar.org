---
import { i18n, t_key } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { ProductBuild } from '@dtypes/api.minmatar.org'

interface Props {
    build:              ProductBuild;
    [propName: string]: any;
}

const {
    build,
    ...attributes
} = Astro.props

delete attributes.class

import DataTable from '@components/blocks/DataTable.astro'
import { format_isk, number_thousand_separator } from '@helpers/numbers'

const n = (value: number) => number_thousand_separator(value)
const isk = (value: number | null) => format_isk(value)
// Minerals cost a few ISK each; keep the cents so they don't all round to 4.
const unit_price = (value: number | null) => value === null ? '—' : value < 1000 ? value.toFixed(2) : format_isk(value)

const tracked = build.materials.filter(material => material.strategy).length
const strategy_color = (strategy: string) =>
    strategy === 'imported' ? 'fleet-red' : strategy === 'harvested' ? 'fleet-yellow' : 'alliance-blue'

import Flexblock from '@components/compositions/Flexblock.astro'

import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import ItemPicture from '@components/blocks/ItemPicture.astro'
import Tag from '@components/blocks/Tag.astro'
---

<div class:list={['[ build-materials ]', Astro.props.class]} {...attributes}>
    <ComponentBlock padding_inline="var(--space-m)" padding_block="var(--space-m)">
        <Flexblock gap="var(--space-s)">
            <header class="[ panel-header ]">
                <h3>{t('industry.product.bill_of_materials')}</h3>
                <small>
                    {t('industry.product.bom_hint')
                        .replace('{n}', n(build.materials.length))
                        .replace('{tracked}', n(tracked))}
                </small>
            </header>

            {build.materials.length === 0 ?
                <p class="[ empty ]">{t('industry.product.no_materials')}</p>
                :
                <DataTable
                    class="bom"
                    density="dense"
                    borders="none"
                    columns={[
                        { key: 'material', label: t('industry.product.material') },
                        { key: 'per_run', label: t('industry.product.per_run'), numeric: true },
                        { key: 'unit_price', label: t('industry.product.unit_price_col'), numeric: true, hide_below: '48rem' },
                        { key: 'line_cost', label: t('industry.product.line_cost'), numeric: true },
                        { key: 'source', label: t('industry.product.source'), hide_below: '48rem' },
                    ]}
                >
                        {build.materials.map(material =>
                            <tr>
                                <th scope="row">
                                    <span class="[ material ]">
                                        <ItemPicture item_id={material.type_id} size={32} icon_quality={64} />
                                        {material.industry_product_id ?
                                            <a href={translatePath(`/industry/products/${material.industry_product_id}/`)}>{material.name}</a>
                                            :
                                            <span>{material.name}</span>
                                        }
                                    </span>
                                </th>
                                <td class="[ num data-table__numeric ]">{n(material.quantity)}</td>
                                <td class="[ num data-table__numeric ]">{unit_price(material.unit_price)}</td>
                                <td class="[ num data-table__numeric ]">{isk(material.line_cost)}</td>
                                <td>
                                    {material.strategy ?
                                        <Tag
                                            color={strategy_color(material.strategy)}
                                            text={t(t_key('industry.product.strategy_', material.strategy)) ?? material.strategy}
                                        />
                                        :
                                        <small class="[ muted ]">{t('industry.product.not_tracked')}</small>
                                    }
                                </td>
                            </tr>
                        )}
                    <Fragment slot="footer">
                    <tr>
                        <th scope="row">{t('industry.product.total_per_run')}</th>
                        <td class="[ num data-table__numeric ]"></td>
                        <td class="[ num data-table__numeric ]"></td>
                        <td class="[ num data-table__numeric ]">{isk(build.material_cost)}</td>
                        <td></td>
                    </tr>
                    </Fragment>
                </DataTable>
            }
        </Flexblock>
    </ComponentBlock>
</div>

<style lang="scss">
    h3 {
        font-size: var(--step-1);
    }

    .panel-header {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);

        small {
            color: var(--foreground);
        }
    }

    .muted,
    .empty {
        color: var(--foreground);
    }

    /* Doubled class: the roomier cells and small-caps header of the old table have to beat DataTable's dense cells. */
    :global(table.bom.bom) {
        border-collapse: collapse;
        border-spacing: 0;
    }

    :global(table.bom.bom th),
    :global(table.bom.bom td) {
        padding: var(--space-2xs) var(--space-xs);
        vertical-align: middle;
    }

    :global(table.bom.bom thead th) {
        font-size: var(--step--2);
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .num {
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        color: var(--highlight);
    }

    .material {
        display: flex;
        align-items: center;
        gap: var(--space-xs);
        min-width: 0;

        > :global(:first-child) {
            flex-shrink: 0;
        }

        a,
        span {
            color: var(--highlight);
        }
    }
</style>
