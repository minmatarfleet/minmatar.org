---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { CampaignReadiness } from '@dtypes/api.minmatar.org'
import type { TagColors } from '@dtypes/layout_components'
import { get_public_api_url, get_app_url } from '@helpers/env'
import { account_user_id_query } from '@helpers/account_user_query'
import { get_player_icon, get_corporation_logo } from '@helpers/eve_image_server'

interface Props {
    readiness:          CampaignReadiness;
    campaign_slug?:     string | false;
    /** Where the ESI sign-in round trip lands afterwards; the account page by default. */
    return_url?:        string | false;
    /**
     * account: the full table with the include/exclude toggle.
     * campaign: one "Add to campaign" action per character that sorts the
     * token and the inclusion in one go; nothing can be excluded here.
     */
    mode?:              'account' | 'campaign';
    flash?:             string | false;
    [propName: string]: any;
}

const {
    readiness,
    campaign_slug = false,
    return_url = false,
    mode = 'account',
    flash = false,
    ...attributes
} = Astro.props

delete attributes.class

const account_query = account_user_id_query(Astro.cookies.get('auth_token')?.value)
const RETURN_URL = get_app_url(return_url || translatePath('/account/campaigns/'))
const show_inclusion = mode === 'account'

/** After the token sign-in the campaign page includes the character itself, so the return trip carries its id. */
const include_on_return = (character_id:number) => {
    const [ path, hash ] = RETURN_URL.split('#')
    const joiner = path.includes('?') ? '&' : '?'
    return `${path}${joiner}include=${character_id}${hash ? `#${hash}` : ''}`
}

const build_action_url = (action_url:string, redirect_to:string) => {
    const url = new URL(action_url, get_public_api_url())
    url.searchParams.set('redirect_url', redirect_to)

    return `${url.toString()}${account_query}`
}

const pending = readiness.characters.filter(character => character.action_url)

/** Chain every pending character so one sign-in hands over to the next. */
let update_all_url = RETURN_URL
for (const character of [ ...pending ].reverse())
    update_all_url = build_action_url(character.action_url, update_all_url)

const status_for = (character:CampaignReadiness['characters'][number]) => {
    if (character.state !== 'ready')
        return {
            label: t('campaigns.readiness.state.missing_scopes'),
            color: 'fleet-yellow' as TagColors,
        }
    if (mode === 'campaign' && character.included)
        return {
            label: t('campaigns.readiness.state.enlisted'),
            color: 'green' as TagColors,
        }
    return {
        label: t('campaigns.readiness.state.good_to_go'),
        color: 'green' as TagColors,
    }
}

const CHARACTER_PARTIAL_URL = campaign_slug
    ? translatePath(`/partials/campaign_character_component?slug=${campaign_slug}&mode=${mode}`)
    : ''

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import Button from '@components/blocks/Button.astro'
import Tag from '@components/blocks/Tag.astro'
import CampaignTable from '@components/blocks/CampaignTable.astro'
---

<Flexblock
    id='campaign-readiness'
    gap='var(--space-s)'
    class:list={['[ campaign-readiness ]', Astro.props.class]}
    {...attributes}
>
    <FlexInline gap='var(--space-s)' justification='space-between' class="[ items-center ]">
        <small>
            {t('campaigns.readiness.tracked_count')
                .replace('{tracked}', String(readiness.tracked))
                .replace('{total}', String(readiness.total))}
        </small>
        {pending.length > 0 && (mode === 'campaign' ?
            <Button size='sm' color='transparent' narrow={true} href={update_all_url} external={false} title={t('campaigns.readiness.update_all_hint')}>
                {t('campaigns.readiness.update_all')}
            </Button>
            :
            <Flexblock gap='var(--space-3xs)' class="[ items-end ]">
                <FlexInline gap='var(--space-2xs)'>
                    <Button size='sm' color='green' href={update_all_url} external={false}>
                        {t('campaigns.readiness.update_all')}
                    </Button>
                </FlexInline>
                <small>{t('campaigns.readiness.update_all_hint')}</small>
            </Flexblock>
        )}
    </FlexInline>

    {flash && <small class="[ text-[var(--highlight)] ]">{flash}</small>}
    {!campaign_slug && <small>{t('campaigns.readiness.no_campaign_hint')}</small>}

    {readiness.characters.length === 0 ?
        <small>{t('campaigns.readiness.none')}</small>
        :
        <CampaignTable
            min_width={show_inclusion ? '42rem' : '36rem'}
            template={show_inclusion
                ? 'minmax(12rem, 1fr) 7rem 9rem 8rem 8rem'
                : 'minmax(12rem, 1fr) 7.5rem 9rem 10rem'}
            columns={[
                t('campaigns.readiness.character'),
                t('campaigns.readiness.corporation'),
                t('campaigns.readiness.state'),
                ...(show_inclusion ? [ t('campaigns.readiness.in_campaign') ] : []),
                t('campaigns.readiness.action'),
            ]}
        >
            {readiness.characters.map(character => {
                const status = status_for(character)
                return (
                <div class="[ campaign-table-row ]" role="row">
                    <div class="[ campaign-cell-media ]" role="cell">
                        <img
                            loading='lazy'
                            width='32'
                            height='32'
                            src={get_player_icon(character.character_id, 32)}
                            alt={character.character_name}
                        />
                        <Flexblock gap='0' class="[ min-w-0 ]">
                            <span>{character.character_name}</span>
                            {character.is_primary && <small class="[ campaign-table-muted ]">{t('campaigns.readiness.primary')}</small>}
                        </Flexblock>
                    </div>
                    {character.corporation_id ?
                        <span role="cell" class="[ campaign-cell ]">
                            <img
                                loading='lazy'
                                width='32'
                                height='32'
                                src={get_corporation_logo(character.corporation_id, 32)}
                                alt={t('campaigns.readiness.corporation')}
                            />
                        </span>
                        :
                        <span role="cell" class="[ campaign-table-muted ]">—</span>
                    }
                    <Tag
                        role="cell"
                        text={status.label}
                        color={status.color}
                        narrow={true}
                    />
                    {show_inclusion && (campaign_slug ?
                        <span role="cell" class="[ campaign-cell ]" data-label={t('campaigns.readiness.in_campaign')}>
                            <Button
                                size='sm'
                                color={character.included ? 'transparent' : 'green'}
                                hx-post={`${CHARACTER_PARTIAL_URL}&character_id=${character.character_id}&included=${character.included ? 'false' : 'true'}`}
                                hx-target='#campaign-readiness'
                                hx-swap='outerHTML'
                                hx-indicator='.loader'
                            >
                                {character.included ? t('campaigns.readiness.included') : t('campaigns.readiness.excluded')}
                            </Button>
                        </span>
                        :
                        <span role="cell" class="[ campaign-table-muted ]" data-label={t('campaigns.readiness.in_campaign')}>{character.included ? t('campaigns.readiness.included') : '—'}</span>
                    )}
                    {mode === 'campaign' ? (
                        character.action_url ?
                            <span role="cell" class="[ campaign-cell campaign-cell-action ]">
                                <Button size='sm' color='green' narrow={true} href={build_action_url(character.action_url, include_on_return(character.character_id))}>
                                    {t('campaigns.readiness.add_to_campaign')}
                                </Button>
                            </span>
                        : !character.included && campaign_slug ?
                            <span role="cell" class="[ campaign-cell campaign-cell-action ]">
                                <Button
                                    size='sm'
                                    color='green'
                                    narrow={true}
                                    hx-post={`${CHARACTER_PARTIAL_URL}&character_id=${character.character_id}&included=true`}
                                    hx-target='#campaign-readiness'
                                    hx-swap='outerHTML'
                                    hx-indicator='.loader'
                                >
                                    {t('campaigns.readiness.add_to_campaign')}
                                </Button>
                            </span>
                        :
                            <small role="cell" class="[ campaign-table-muted ]">{t('campaigns.readiness.in_campaign_ok')}</small>
                    ) : (
                        character.action_url ?
                            <span role="cell" class="[ campaign-cell ]">
                                <Button size='sm' color='fleet-red' href={build_action_url(character.action_url, RETURN_URL)}>
                                    {t('campaigns.readiness.update')}
                                </Button>
                            </span>
                        :
                            <small role="cell" class="[ campaign-table-muted ]">{t('campaigns.readiness.nothing_to_do')}</small>
                    )}
                </div>
                )
            })}
        </CampaignTable>
    }
</Flexblock>

<style lang="scss">
    img {
        width: var(--space-m);
        height: var(--space-m);
    }

    .campaign-cell-action :global(.button) {
        white-space: nowrap;
        padding-block: var(--space-3xs);
        font-size: var(--step--1);
    }

    /* Phones: one card per character instead of a sideways-scrolling row. */
    @media (max-width: 48rem) {
        :global(.campaign-readiness .campaign-table) {
            min-width: 0 !important;
        }

        :global(.campaign-readiness .campaign-table-head) {
            display: none;
        }

        .campaign-table-row {
            grid-template-columns: minmax(0, 1fr) auto;
            gap: var(--space-2xs) var(--space-s);
            padding-inline: 0;
            padding-block: var(--space-xs);
        }

        .campaign-table-row > :nth-child(2) {
            justify-self: end;
        }

        /* Status and the in-campaign toggle share the second line. */
        .campaign-table-row > :nth-child(3) {
            grid-row: 2;
            grid-column: 1;
            justify-self: start;
        }

        .campaign-table-row > [data-label] {
            grid-row: 2;
            grid-column: 1 / -1;
            display: flex;
            align-items: center;
            justify-self: end;
            gap: var(--space-2xs);
        }

        .campaign-table-row > [data-label]::before {
            content: attr(data-label);
            font-family: var(--heading-font);
            font-size: var(--step--2);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--faded);
            white-space: nowrap;
        }

        .campaign-table-row > :last-child {
            grid-column: 1 / -1;
        }

        /* Without the in-campaign column a plain status note fits beside the tag. */
        .campaign-table-row > small:last-child:nth-child(4) {
            grid-row: 2;
            justify-self: end;
        }

        .campaign-table-row > .campaign-cell:last-child :global(.button) {
            display: flex;
            justify-content: center;
            align-items: center;
            box-sizing: border-box;
            width: 100%;
            min-height: 44px;
        }
    }
</style>
