---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { ButtonColors } from '@dtypes/layout_components';

interface Props {
    tone:           ButtonColors | "fleet-yellow";
    percentage:     number | null;
    delta:          number | null;
}

const {
    tone,
    percentage,
    delta,
} = Astro.props
console.log(delta)
import FlexInline from '@components/compositions/FlexInline.astro'

import Square from '@components/blocks/Square.astro';
import CountUpAnimationFloat from './CountUpAnimationFloat.astro';
---

<FlexInline gap='var(--space-xs)'>
    <Square color={tone} />

    <FlexInline class="[ items-baseline! ]" gap='var(--space-2xs)'>
        <div class="[ market-total text-step-4 ]">
            <CountUpAnimationFloat
                target={percentage ?? 0}
                duration={2000}
                fixed={1}
            />%
        </div>
        {delta !== null &&
            <FlexInline gap='var(--space-3xs)'>
                {delta !== 0 &&
                    <span class:list={[ delta > 0 ? 'text-green' : 'text-red' ]}>
                        {delta > 0 ? '▲' : '▼'}
                    </span>
                }
                <span
                    data-tippy-content={t('last_day_delta')}
                    x-init='tippy($el, tippy_options)'
                >{Math.abs(delta).toFixed(1)}%</span>
            </FlexInline>
        }
    </FlexInline>
</FlexInline>

<style lang="scss">
    .market-total {
        font-family: var(--heading-font);
        color: var(--highlight);
    }
</style>