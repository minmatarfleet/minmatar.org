---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { SummaryCharacter } from '@dtypes/api.minmatar.org'

interface Props {
    pilots:     SummaryCharacter[];
}

const {
    pilots,
} = Astro.props

import Flexblock from '@components/compositions/Flexblock.astro'
import Grid from '@components/compositions/Grid.astro'

import CharacterCard from '@components/blocks/CharacterCard.astro'
import CorporationBadge from '@components/blocks/CorporationBadge.astro'
import StylessButton from '@components/blocks/StylessButton.astro'
import Button from '@components/blocks/Button.astro'

const FLET_START_PARTIAL_URL = translatePath('/partials/fleet_start_component/')
---

<form
    method="post"
    action={FLET_START_PARTIAL_URL}
    hx-post={FLET_START_PARTIAL_URL}
    hx-trigger="submit"
    hx-target="#fleet-start"
    hx-swap="innerHTML"
    hx-indicator=".loader"
    class="block w-full"
    x-on:submit="$nextTick(() => {
        submitted = true
    })"
    x-data={`{
        submitted: false,
    }`}
>
    <Flexblock gap='var(--space-s)'>
    <Flexblock gap='var(--space-3xs)'>
        <Button
            color='green'
            class="[ w-fit ]"
            type="submit"
            x-bind:disabled="submitted"
        >
            {t('start_fleet_now')}
        </Button>
        <small class="[ start-fleet__hint ]">{t('start_fleet_now_hint')}</small>
    </Flexblock>

    <details class="[ start-fleet__pick ]">
    <summary>{t('start_on_another_character')}</summary>
    <Grid
        role="list"
        class="[ w-full grid-fill ]"
        min_item_width='240px'
        row_gap='var(--space-3xs)'
        column_gap='var(--space-3xs)'
    >
        {pilots.map((pilot) => (
            <StylessButton
                type="submit"
                name="fc_character_id"
                value={pilot.character_id}
                x-bind:disabled="submitted"
            >
                <CharacterCard
                    character_id={pilot.character_id}
                    character_name={pilot.character_name}
                    inert={true}
                >
                    <Flexblock gap='var(--space-3xs)'>
                        <h3>{pilot.character_name}</h3>
                        {pilot.corp_id !== null &&
                            <CorporationBadge
                                corporation={{
                                    id: pilot.corp_id,
                                    name: pilot.corp_name ?? undefined,
                                    size: 'xs',
                                }}
                                highlight={false}
                            />
                        }
                    </Flexblock>
                </CharacterCard>
            </StylessButton>
        ))}
    </Grid>
    </details>
    </Flexblock>
</form>

<style lang="scss">
    @use './_phone_media_card.scss' as *;

    .start-fleet__hint {
        color: var(--text-muted);
    }

    .start-fleet__pick summary {
        cursor: pointer;
        margin-block-end: var(--space-2xs);
        color: var(--highlight);
    }

    // Phones: compact character picker rows instead of one portrait per screen.
    form :global(button > .card) {
        @include phone_character_card;
    }
</style>
