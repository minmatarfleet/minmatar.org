---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { Skillset, CharacterBasic } from '@dtypes/layout_components'
import {
    get_skillset_category,
    skillset_filter_ids,
} from '@helpers/skillset_categories'

interface Props {
    skillsets: Skillset[]
    character: CharacterBasic
    'x-data'?: string
}

const {
    skillsets,
    character,
    ...x_data
} = Astro.props

import TextBox from '@components/layout/TextBox.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import Grid from '@components/compositions/Grid.astro'
import ChipGroup from '@components/blocks/ChipGroup.astro'
import FilterChip from '@components/blocks/FilterChip.astro'
import SkillsetItem from '@components/blocks/SkillsetItem.astro'

const filter_labels: Record<(typeof skillset_filter_ids)[number], string> = {
    new_player: t('learning_center.skillsets.filter_new_player'),
    subcapitals: t('learning_center.skillsets.filter_subcapitals'),
    capitals: t('learning_center.skillsets.filter_capitals'),
}

const category_counts = Object.fromEntries(
    skillset_filter_ids.map((id) => [
        id,
        skillsets.filter((skillset) => get_skillset_category(skillset.name) === id).length,
    ]),
) as Record<(typeof skillset_filter_ids)[number], number>

const filters = [
    { id: 'all', label: t('all_categories'), count: skillsets.length },
    ...skillset_filter_ids
        .filter((id) => category_counts[id] > 0)
        .map((id) => ({
            id,
            label: filter_labels[id],
            count: category_counts[id],
        })),
]
---
<Flexblock
    class="[ skillsets-catalog ]"
    gap="var(--space-s)"
    x-data={`{
        category: 'all',
        set_category(id) {
            this.category = id
        },
        matches(el) {
            return this.category === 'all' || el.dataset.category === this.category
        },
    }`}
>
    <ChipGroup>
        {filters.map((filter) => (
            <FilterChip
                x-bind:class={`category === ${JSON.stringify(filter.id)} && 'is-active'`}
                x-on:click={`set_category(${JSON.stringify(filter.id)})`}
                x-bind:aria-pressed={`category === ${JSON.stringify(filter.id)} ? 'true' : 'false'`}
            >
                {filter.label}
            </FilterChip>
        ))}
    </ChipGroup>

    <Grid
        id="skillset-list"
        min_item_width="290px"
        row_gap="var(--space-s)"
        column_gap="var(--space-s)"
        class="[ grid-fill ]"
        {...x_data}
    >
        {skillsets.map((skillset) => (
            <div
                class="[ skillsets-catalog__item ]"
                data-category={get_skillset_category(skillset.name) ?? ''}
                x-show="matches($el)"
            >
                <SkillsetItem
                    character={character}
                    skillset={skillset}
                />
            </div>
        ))}
        {skillsets.length == 0 &&
            <slot>
                <TextBox>
                    <p>{t('no_skillsets')}</p>
                </TextBox>
            </slot>
        }
    </Grid>
</Flexblock>

<svg class="[ skillset-clip-defs ]" version="1.2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 11 142" width="11" height="142" aria-hidden="true">
    <defs>
        <clipPath id="before-clip-path">
            <polygon points="11.000 0.000, 9.400 0.000, 0.000 8.200, 0.000 61.200, 4.700 65.900, 4.700 78.800, 0.000 82.300, 0.000 142.000, 11.000 142.000" />
        </clipPath>
    </defs>
</svg>

<svg class="[ skillset-clip-defs ]" version="1.2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 142" width="10" height="142" aria-hidden="true">
    <defs>
        <clipPath id="after-clip-path">
            <polygon points="0.000 97.000, 0.000 142.000, 1.000 142.000, 10.000 134.000, 10.000 97.000" />
            <polygon points="10.000 92.000, 10.000 44.000, 5.000 39.000, 5.000 26.000, 10.000 22.000, 10.000 -0.100, 0.000 -0.000, 0.000 92.000" />
        </clipPath>
    </defs>
</svg>

<style lang="scss">
    .skillset-clip-defs {
        position: absolute;
        width: 0;
        height: 0;
        overflow: hidden;
        pointer-events: none;
    }

    .skillsets-catalog__item {
        width: 100%;
        min-width: 0;
        height: 100%;

        :global(.skillset-item) {
            display: block;
            width: 100%;
            height: 100%;
        }
    }
</style>
