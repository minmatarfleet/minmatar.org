---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { RootSingleItem } from '@dtypes/api.minmatar.org'
import type { Alert } from '@dtypes/layout_components'

interface Props {
    order_id:                   number;
    primary_character_id?:      number | null;
    claim_disabled_reason?:     string | null;
    order_breakdown:            RootSingleItem[];
    location_name:              string | undefined;
    /** HTMX swap target for claim/delivery. Detail page uses the breakdown root. */
    swap_target_id?:            string;
    /** After claim/delivery, render breakdown-only HTML instead of the list OrderItem card. */
    claim_render?:              'order_item' | 'breakdown';
    alert?:                     Alert | null;
}

const {
    order_id,
    primary_character_id,
    claim_disabled_reason = null,
    order_breakdown,
    location_name,
    swap_target_id,
    claim_render = 'order_item',
    alert = null,
} = Astro.props

import { query_string } from '@helpers/string';

const ORDER_ITEM_PARTIAL_URL = translatePath(`/partials/order_item_component`)

const ORDER_BREAKDOWN_PARTIAL_URL = `${translatePath('/partials/order_breakdown_component')}?${query_string({
    order_id: order_id,
    ...(location_name && { location_name }),
})}`

const id = `order-breakdown-${order_id}-inner`
const hx_swap_target = swap_target_id ?? `order-item-${order_id}`
const claim_query = claim_render === 'breakdown' ? { render: 'breakdown' } : {}

import { number_thousand_separator } from '@helpers/numbers'

import FlexInline from '@components/compositions/FlexInline.astro';
import FixedFluid from '@components/compositions/FixedFluid.astro';
import Flexblock from '@components/compositions/Flexblock.astro';

import ItemBadge from '@components/blocks/ItemBadge.astro';
import Tag from '@components/blocks/Tag.astro';
import CharacterPicture from '@components/blocks/CharacterPicture.astro';
import TippyDelivery from '@components/blocks/TippyDelivery.astro';
import Progress from '@components/blocks/Progress.astro';
import ButtonClaimOrder from '@components/blocks/ButtonClaimOrder.astro';
import ButtonFindBlueprint from '@components/blocks/ButtonFindBlueprint.astro';
import ActionMenu from '@components/blocks/ActionMenu.astro';
import ActionMenuItem from '@components/blocks/ActionMenuItem.astro';
import StylessButton from '@components/blocks/StylessButton.astro';

import IndustrialistIcon from '@components/icons/IndustrialistIcon.astro';
import RefreshIcon from '@components/icons/buttons/RefreshIcon.astro';
---

<Flexblock
    id={id}
    x-init={alert ? `show_alert_dialog(${JSON.stringify(alert)})` : undefined}
>
    <hr class="border-bottom">
    <StylessButton
        hx-get={ORDER_BREAKDOWN_PARTIAL_URL}
        hx-target={`#${id}`}
        hx-swap="outerHTML transition:true"
        hx-indicator=".loader"
        hx-disabled-elt="this"
    >
        <FlexInline
            gap='var(--space-2xs)'
            class="[ items-center! w-fit ]"
            data-tippy-content={t('click_to_reload')}
        >
            <h4>{t('assignments_breakdown')}</h4>
            <RefreshIcon small_size={true} />
        </FlexInline>
    </StylessButton>
    {order_breakdown.map(item => {
        const items_delivered = item.assignments.reduce(
            (c, assignment) => c + (assignment.delivered_at ? assignment.quantity : 0)
        , 0)

        const user_assignment = item.assignments.find(assignment => assignment.character_id === primary_character_id)

        const completion = item.quantity > 0 ? items_delivered / item.quantity * 100 : 0
        const progress_color = completion >= 50 ? '--security-status-point-6' :
                       completion >= 10 && completion < 50 ? '--security-status-point-4':
                       '--fleet-red'
        return (
            <FixedFluid
                width='350px'
                class="[ production-drilldown-item ][ w-full items-center! ]"
            >
                <div>
                    <ItemBadge
                        item_name={item.eve_type_name}
                        type_id={item.eve_type_id}
                        size={32}
                        centered={true}
                    >
                        <small>{t('claimed')} <span class="[ text-highlight ]">{number_thousand_separator(item.quantity - item.unassigned_quantity)}</span> / {number_thousand_separator(item.quantity)}</small>
                    </ItemBadge>
                </div>

                <FlexInline
                    gap='var(--space-s)'
                    justification='space-between'
                    class="[ w-full flex-nowrap! items-center! ]"
                >
                    <div class="[ min-w-0 grow ]">
                        <FixedFluid width='32px' breakpoint='30%' gap='var(--space-2xs)' class="[  items-center! text-highlight ]">
                            <div
                                class="[ text-highlight h-[32px] ]"
                                data-tippy-content={t('industrialists')}
                            >
                                <IndustrialistIcon size={32} />
                            </div>

                            <FlexInline gap='var(--space-3xs)'>
                                {item.assignments.map(assignment => {
                                    const items = []
                                    const undelivered_quantity = assignment.quantity - assignment.delivered_quantity

                                    if (undelivered_quantity > 0) {
                                        items.push(
                                            <TippyDelivery
                                                producer_name={assignment.character_name}
                                                delivery={null}
                                                contract_value={item?.target_unit_price ? parseInt(item?.target_unit_price) * undelivered_quantity : undefined}
                                                earnings={item?.estimated_profit_per_unit ? item.estimated_profit_per_unit * undelivered_quantity : undefined}
                                                has_blueprints={assignment.has_blueprints}
                                            >
                                                <CharacterPicture
                                                    character_id={assignment.character_id}
                                                    character_name={assignment.character_name}
                                                    quantity={undelivered_quantity}
                                                    tag_color={'fleet-red'}
                                                    size={32}
                                                />
                                                <div class="[ sr-only ]">{assignment.character_name}</div>
                                            </TippyDelivery>
                                        )
                                    }

                                    if (assignment.delivered_quantity > 0) {
                                        items.push(
                                            <TippyDelivery
                                                producer_name={assignment.character_name}
                                                delivery={assignment.delivered_at}
                                                contract_value={item?.target_unit_price ? parseInt(item?.target_unit_price) * assignment.delivered_quantity : undefined}
                                                earnings={item?.estimated_profit_per_unit ? item.estimated_profit_per_unit * assignment.delivered_quantity : undefined}
                                                has_blueprints={assignment.has_blueprints}
                                            >
                                                <CharacterPicture
                                                    character_id={assignment.character_id}
                                                    character_name={assignment.character_name}
                                                    quantity={assignment.delivered_quantity}
                                                    tag_color={'green'}
                                                    size={32}
                                                />
                                                <div class="[ sr-only ]">{assignment.character_name}</div>
                                            </TippyDelivery>
                                        )
                                    }

                                    return items
                                })}
                                {item.assignments.length === 0 &&
                                    <Tag text={t('no_producers')} />
                                }
                            </FlexInline>
                        </FixedFluid>
                    </div>

                    <FlexInline
                        class="[ basis-[180px] min-w-[180px] shrink-0 flex-nowrap! items-center! ]"
                        gap='var(--space-2xs)'
                    >
                        <div class="[ grow min-w-0 ]">
                            <Progress
                                class:list={[ 'w-full' ]}
                                max="100"
                                value={completion > 0 ? completion : 0.1}
                                data-tippy-content={item.quantity > 0 ? `${completion.toFixed(0)}%` : t('no_data')}
                                style={`--progress-color: var(${progress_color}); --progress-glow-color: var(${progress_color});`}
                            >
                                {completion.toFixed(2)}%
                            </Progress>
                        </div>

                        <div class="[ basis-[4ch] shrink-0 text-right ]">
                            {item.quantity > 0 &&
                                <small>
                                    {completion.toFixed(0)}%
                                </small>
                            }
                        </div>
                    </FlexInline>

                    <div class="[ shrink-0 ml-[var(--space-s)] ]">
                        <ActionMenu variant="button" color="fleet-red" size="sm">
                            {(item.unassigned_quantity > 0 || user_assignment) &&
                                <>{claim_disabled_reason ?
                                    <span
                                        class="[ block w-full ]"
                                        data-tippy-content={claim_disabled_reason}
                                    >
                                        <ActionMenuItem variant="success" disabled>
                                            {t('claim')}
                                        </ActionMenuItem>
                                    </span>
                                    :
                                    <div class:list={['[ action-menu-item-host ]', { 'action-menu-item-host--success': !user_assignment }]}>
                                        <ButtonClaimOrder
                                            styless={true}
                                            target_id={hx_swap_target}
                                            reclaim={Boolean(user_assignment)}
                                            order_id={order_id}
                                            claimed={user_assignment?.quantity ?? 0}
                                            item={item}
                                            character_id={primary_character_id as number}
                                            has_blueprints={user_assignment?.has_blueprints ?? false}
                                            render={claim_render}
                                        />
                                    </div>
                                }</>
                            }

                            {user_assignment &&
                                <>{!user_assignment.delivered_at ?
                                    <ActionMenuItem
                                        variant="success"
                                        href={translatePath(`/industry/orders/contract?${query_string({
                                            order_id: order_id,
                                            item_id: item.id,
                                            assignment_id: user_assignment.id,
                                        })}`)}
                                    >
                                        {t('delivery_contract')}
                                    </ActionMenuItem> :
                                    <ActionMenuItem
                                        confirm_label={t('confirm')}
                                        hx-patch={`${ORDER_ITEM_PARTIAL_URL}?${query_string({
                                            order_id: order_id,
                                            item_id: item.id,
                                            assignment_id: user_assignment.id,
                                            delivery: false,
                                            ...claim_query,
                                        })}`}
                                        hx-target={`#${hx_swap_target}`}
                                        hx-indicator=".loader"
                                        hx-swap="outerHTML transition:true"
                                        x-on:click="$el.setAttribute('disabled','')"
                                    >
                                        {t('revert_delivery')}
                                    </ActionMenuItem>
                                }</>
                            }

                            <div class="[ action-menu-item-host ]">
                                <ButtonFindBlueprint styless={true} item_name={item.eve_type_name} />
                            </div>

                            <ActionMenuItem
                                href={translatePath(`/industry/orders/planner?${query_string({
                                    order_id: order_id,
                                    item_id: item.id,
                                })}`)}
                            >
                                {t('planner')}
                            </ActionMenuItem>
                        </ActionMenu>
                    </div>
                </FlexInline>
            </FixedFluid>
        )
    })}
</Flexblock>

<style lang="scss">
    .order-breakdown-assign-footer {
        margin-top: var(--space-m);
    }

    /* Phones: claimers get a full-width row (icon + portraits side by side),
       progress / % / Actions sit on the row below. */
    @media (max-width: 48rem) {
        :global(.production-drilldown-item) > :global(.flex-inline:last-child) {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: var(--space-2xs) var(--space-s);
        }

        :global(.production-drilldown-item) > :global(.flex-inline:last-child) > :global(:first-child) {
            grid-column: 1 / -1;
        }

        :global(.production-drilldown-item) > :global(.flex-inline:last-child) > :global(:last-child) {
            margin-inline-start: 0;
        }

        :global(.production-drilldown-item) + :global(.production-drilldown-item) {
            padding-block-start: var(--space-s);
            border-block-start: 1px solid var(--border-color);
        }

        :global(.production-drilldown-item) :global(.tag) {
            white-space: nowrap;
        }
    }
</style>
