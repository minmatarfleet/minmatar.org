---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import DialogBase from '@components/blocks/DialogBase.astro';
import Button from '@components/blocks/Button.astro';

interface Props {
    [propName: string]: any;
}
---

<DialogBase
    name="confirm_dialog"
    titled={true}
    class="[ w-full max-h-[80vh] overflow-y-auto ]"
    max_width="500px"
>
    <Button
        size='sm'
        confirm-dialog-action="accept"
        x-bind:hx-get="confirm_dialog_hx?.method == 'get' ? (confirm_dialog_hx?.url ?? false) : false"
        x-bind:hx-post="confirm_dialog_hx?.method == 'post' ? (confirm_dialog_hx?.url ?? false) : false"
        x-bind:hx-put="confirm_dialog_hx?.method == 'put' ? (confirm_dialog_hx?.url ?? false) : false"
        x-bind:hx-patch="confirm_dialog_hx?.method == 'patch' ? (confirm_dialog_hx?.url ?? false) : false"
        x-bind:hx-delete="confirm_dialog_hx?.method == 'delete' ? (confirm_dialog_hx?.url ?? false) : false"
        x-bind:hx-target="confirm_dialog_hx?.target ?? false"
        x-bind:hx-swap="confirm_dialog_hx?.swap ?? 'none'"
        x-bind:hx-vals="confirm_dialog_hx?.vals ? JSON.stringify({ data: JSON.stringify(confirm_dialog_hx?.vals) }) : false"
        hx-indicator=".loader"
        x-bind:disabled="confirm_dialog_accept_disabled"
    >
        {t('yes')}
    </Button>
    <Button size='sm' confirm-dialog-action="cancel">{t('no')}</Button>
</DialogBase>
