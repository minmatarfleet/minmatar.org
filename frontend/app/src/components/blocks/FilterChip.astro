---
/**
 * A filter toggle chip. As a button (client-side filters) it reports its
 * state with aria-pressed: pass `active` for the server-rendered state and
 * bind `x-bind:class` / `x-bind:aria-pressed` for an Alpine filter. With
 * `href` it is a link to a filtered view and marks the current one with
 * aria-current.
 *
 * With `type="radio"` or `type="checkbox"` it is a real (visually hidden)
 * input in a label, for filters that submit with a form or reload a list on
 * `change` (htmx): `name`, `value` and `checked` go to the input, any other
 * attribute to the label, and `input_attributes` carries `x-model`, `hx-*`
 * and the like for the input. The checked chip takes the active look.
 */
interface Props {
    active?:            boolean;
    href?:              string;
    type?:              'radio' | 'checkbox';
    name?:              string;
    value?:             string;
    checked?:           boolean;
    input_attributes?:  Record<string, any>;
    [propName: string]: any;
}

const {
    active = false,
    href,
    type,
    name,
    value,
    checked = false,
    input_attributes = {},
    ...attributes
} = Astro.props

delete attributes.class

const chip_class = ['[ filter-chip ]', { 'is-active': active }, Astro.props.class]
---

{type ?
    <label
        class:list={[...chip_class, 'filter-chip--input']}
        {...attributes}
    >
        <input type={type} name={name} value={value} checked={checked} {...input_attributes} />
        <slot />
    </label>
    : href ?
    <a
        href={href}
        class:list={chip_class}
        aria-current={active ? 'page' : undefined}
        {...attributes}
    ><slot /></a>
    :
    <button
        type="button"
        class:list={chip_class}
        aria-pressed={active ? 'true' : 'false'}
        {...attributes}
    ><slot /></button>
}

<style lang="scss">
    .filter-chip {
        appearance: none;
        display: inline-flex;
        align-items: center;
        flex-shrink: 0;
        margin: 0;
        padding: var(--space-3xs) var(--space-xs);
        border: 1px solid color-mix(in srgb, var(--fleet-yellow) var(--tint-strong), transparent);
        background: transparent;
        color: var(--fleet-yellow);
        font-family: var(--button-font);
        font-size: var(--step--2);
        font-weight: 600;
        letter-spacing: 0.06em;
        text-decoration: none;
        text-transform: uppercase;
        white-space: nowrap;
        cursor: pointer;
        transition:
            border-color var(--fast-transition),
            background-color var(--fast-transition),
            color var(--fast-transition);

        @media (hover: hover) {
            &:hover {
                border-color: var(--fleet-yellow);
                background: color-mix(in srgb, var(--fleet-yellow) var(--tint-soft), transparent);
                color: var(--fleet-yellow);
            }

            &.is-active:hover,
            &:has(> input:checked):hover {
                background: var(--fleet-yellow);
                color: var(--background);
            }
        }

        &:focus-visible {
            outline: 1px solid var(--highlight);
            outline-offset: 2px;
        }

        &.is-active,
        &:has(> input:checked) {
            border-color: var(--fleet-yellow);
            background: var(--fleet-yellow);
            color: var(--background);
        }

        &:has(> input:focus-visible) {
            outline: 1px solid var(--highlight);
            outline-offset: 2px;
        }
    }

    /* The input is real but hidden; the label is the chip. */
    .filter-chip--input {
        position: relative;

        input {
            position: absolute;
            opacity: 0;
            width: 1px;
            height: 1px;
            margin: 0;
        }
    }
</style>
