---
import { i18n } from '@helpers/i18n'
import type { LoyaltyOrderStats, LoyaltyOrderStatsTier } from '@dtypes/api.minmatar.org'
import { number_thousand_separator } from '@helpers/numbers'
import { format_close_time } from '@helpers/loyalty_order_stats'
import Flexblock from '@components/compositions/Flexblock.astro'
import Grid from '@components/compositions/Grid.astro'
import ComponentBlock from '@components/blocks/ComponentBlock.astro'

const { t } = i18n(Astro.url)

interface Props {
    stats: LoyaltyOrderStats
    [propName: string]: any
}

const { stats } = Astro.props

const isk_per_lp = (value: number | null) => value == null
    ? '—'
    : value.toLocaleString('en-US', { maximumFractionDigits: 1 })

type StatCard = {
    label: string
    info: string
    value: string
    split: (tier: LoyaltyOrderStatsTier) => string
}

const cards: StatCard[] = [
    {
        label: t('industry.loyalty.stats.orders'),
        info: t('industry.loyalty.stats.orders_info'),
        value: number_thousand_separator(stats.orders),
        split: (tier) => number_thousand_separator(tier.orders),
    },
    {
        label: t('industry.loyalty.stats.close_time'),
        info: t('industry.loyalty.stats.close_time_info'),
        value: format_close_time(stats.avg_close_seconds),
        split: (tier) => format_close_time(tier.avg_close_seconds),
    },
    {
        label: t('industry.loyalty.stats.isk_per_lp'),
        info: t('industry.loyalty.stats.isk_per_lp_info'),
        value: isk_per_lp(stats.avg_isk_per_lp),
        split: (tier) => isk_per_lp(tier.avg_isk_per_lp),
    },
]

const title = t('industry.loyalty.stats.title').replace('{days}', String(stats.days))
const info_aria = t('industry.loyalty.offers.metrics.info_aria')
---

<section class="[ loyalty-order-stats ]" aria-label={title}>
    <Flexblock gap="var(--space-xs)">
        <h2>{title}</h2>
        <Grid
            class="[ w-full ]"
            min_item_width="14rem"
            row_gap="var(--space-3xs)"
            column_gap="var(--space-3xs)"
        >
            {cards.map((card) => (
                <ComponentBlock
                    class="[ loyalty-order-stats__card ]"
                    padding_block="var(--space-s)"
                    padding_inline="var(--space-m)"
                >
                    <div class="[ loyalty-order-stats__header ]">
                        <p class="[ loyalty-order-stats__label ]">{card.label}</p>
                        <button
                            type="button"
                            class="[ loyalty-order-stats__info ]"
                            data-tippy-content={card.info}
                            aria-label={info_aria}
                        >
                            <span aria-hidden="true">i</span>
                        </button>
                    </div>
                    <p class="[ loyalty-order-stats__value ]">{card.value}</p>
                    <dl class="[ loyalty-order-stats__split ]">
                        <div>
                            <dt>{t('industry.loyalty.tier.standard')}</dt>
                            <dd>{card.split(stats.standard)}</dd>
                        </div>
                        <div>
                            <dt>{t('industry.loyalty.tier.express')}</dt>
                            <dd>{card.split(stats.express)}</dd>
                        </div>
                    </dl>
                </ComponentBlock>
            ))}
        </Grid>
    </Flexblock>
</section>

<style lang="scss">
    h2 {
        font-size: var(--step-1);
        margin: 0;
    }

    .loyalty-order-stats :global(.loyalty-order-stats__card) {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        height: 100%;
        box-sizing: border-box;
    }

    .loyalty-order-stats__header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: var(--space-2xs);
    }

    .loyalty-order-stats__label {
        margin: 0;
        font-size: var(--step--1);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--fleet-yellow);
    }

    .loyalty-order-stats__info {
        flex-shrink: 0;
        display: inline-grid;
        place-items: center;
        width: var(--space-s);
        height: var(--space-s);
        margin: 0;
        padding: 0;
        border: 1px solid color-mix(in srgb, var(--faded) 70%, transparent);
        border-radius: 50%;
        background: transparent;
        color: var(--faded);
        font-family: var(--default-font);
        font-size: var(--step--2);
        font-weight: 600;
        line-height: 1;
        text-transform: lowercase;
        cursor: help;

        @media (hover: hover) {
            &:hover {
                color: var(--highlight);
                border-color: var(--highlight);
            }
        }

        &:focus-visible {
            color: var(--highlight);
            border-color: var(--highlight);
            outline: 2px solid var(--highlight);
            outline-offset: 2px;
        }
    }

    .loyalty-order-stats__value {
        margin: 0;
        font-family: var(--heading-font);
        font-size: var(--step-3);
        line-height: 0.95;
        letter-spacing: -0.02em;
        font-variant-numeric: tabular-nums;
        text-transform: uppercase;
        color: var(--highlight);
    }

    .loyalty-order-stats__split {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-s);
        margin: 0;
        margin-block-start: auto;
        padding-block-start: var(--space-2xs);
        border-top: solid 1px var(--border-color);
        font-size: var(--step--1);
        font-variant-numeric: tabular-nums;

        div {
            display: flex;
            gap: var(--space-3xs);
            align-items: baseline;
        }

        dt {
            color: var(--faded);
        }

        dd {
            margin: 0;
            color: var(--foreground);
        }
    }
</style>
