---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import { also_posted_to_line, type FleetPingPreviewUI } from '@helpers/fetching/fleet_ping_preview'

/**
 * The fleet form's Discord start ping preview. The form page renders it once
 * (so DiscordEmbedPreview's styles are bundled; htmx 1.9 drops a partial's
 * CSS) and partials/discord_preview_component re-renders it as fields change.
 */
interface Props {
    preview:        FleetPingPreviewUI;
}

const { preview } = Astro.props
const also_posted = also_posted_to_line(preview.also_posted_to, t('fleets.host.preview_also_posted'))

import DiscordEmbedPreview from '@components/blocks/DiscordEmbedPreview.astro'
---

{preview.warning &&
    <p class="[ fleet-ping-preview__warning ]" role="status">{t(`fleets.host.preview_${preview.warning}`)}</p>
}
<DiscordEmbedPreview
    kind="fleet_ping"
    channel_name={preview.channel_name}
    role_name={preview.role_name}
    payload={preview.payload}
/>
{also_posted &&
    <small class="[ fleet-ping-preview__also ]">{also_posted}</small>
}
{preview.error &&
    <small class="[ fleet-ping-preview__error ]">{t('fleets.host.preview_error')}</small>
}

<style lang="scss">
    .fleet-ping-preview__warning {
        margin-block-end: var(--space-2xs);
        color: var(--fleet-red);
    }

    .fleet-ping-preview__also {
        display: block;
        margin-block-start: var(--space-3xs);
        color: var(--faded);
    }

    .fleet-ping-preview__error {
        display: block;
        margin-top: var(--space-2xs);
        color: var(--faded);
    }
</style>
