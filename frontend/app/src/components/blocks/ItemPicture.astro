---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { EvEImageServiceSize, ImageSize } from '@dtypes/layout_components'

interface BlueprintParam {
    is_copy:    boolean;
}

interface Props {
    item_id:        number;
    item_name?:     string;
    size?:          ImageSize;
    narrow?:        boolean;
    icon_quality?:  EvEImageServiceSize;
    mask?:          boolean;
    quantity?:      number;
    blueprint?:     BlueprintParam;
    [propName: string]: any;
}

const {
    item_id,
    item_name,
    size = 64,
    narrow = false,
    icon_quality = 64,
    mask = false,
    quantity,
    blueprint,
    ...attributes
} = Astro.props

import { get_item_icon, get_bpc_icon } from '@helpers/eve_image';

import Picture from '@components/blocks/Picture.astro';

const extra_class = attributes.class
delete attributes.class
---

<Picture
    src={blueprint ? get_bpc_icon(item_id, blueprint.is_copy, icon_quality ?? size) : get_item_icon(item_id, icon_quality ?? size)}
    alt={item_name ?? t('item_picture')}
    size={size}
    narrow={narrow}
    mask={mask}
    quantity={quantity}
    class={extra_class}
    {...attributes}
/>
