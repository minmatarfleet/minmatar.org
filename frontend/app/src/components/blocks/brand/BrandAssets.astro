---
import type { BrandAssetColumn, BrandAssetRow } from '@/data/brand/assets'
import { logoAssetColumns } from '@/data/brand/assets'
import DataTable from '@components/blocks/DataTable.astro'

interface Props {
    title: string
    rows: BrandAssetRow[]
    columns?: BrandAssetColumn[]
}

const { title, rows, columns = logoAssetColumns } = Astro.props

const table_columns = [...columns, { key: 'description', label: 'Description' }]
---

<section class="[ brand-section ]">
    <h2>{title}</h2>
    <slot name="note" />
    <p class="[ brand-hint ]">Right-click an image and choose “Save image as…” to download it.</p>

    <DataTable columns={table_columns}>
        {rows.map((row) => (
            <tr>
                {columns.map(({ key }) => (
                    <td>
                        {row[key] ? (
                            <a href={row[key] as string} download>
                                <img src={row[key] as string} alt={row.name} width="64" loading="lazy" />
                            </a>
                        ) : (
                            <span class="[ na ]">N/A</span>
                        )}
                    </td>
                ))}
                <td>{row.description}</td>
            </tr>
        ))}
    </DataTable>
</section>

<style lang="scss">
    .brand-section {
        display: flex;
        flex-direction: column;
        gap: var(--space-m);
    }

    .brand-hint {
        color: inherit;
        margin: 0;
    }

    img {
        display: block;
        margin-inline: auto;
        max-width: 64px;
        height: auto;
    }

    a {
        display: inline-flex;
        justify-content: center;
        align-items: center;
    }

    .na {
        color: inherit;
    }
</style>
