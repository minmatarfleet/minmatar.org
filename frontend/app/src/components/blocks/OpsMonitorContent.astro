---
import { i18n } from '@helpers/i18n'
const { lang, t, translatePath } = i18n(Astro.url)

import type { OpsMonitor, OpsMonitorHistoryPoint } from '@dtypes/api.minmatar.org'
import { from_now_diff } from '@helpers/date'
import { format_isk } from '@helpers/numbers'
import { ops_redirect_path } from '@helpers/market_ops_redirect'

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import Grid from '@components/compositions/Grid.astro'
import Button from '@components/blocks/Button.astro'
import Progress from '@components/blocks/Progress.astro'
import OpsMonitorHistoryChart from '@components/blocks/OpsMonitorHistoryChart.astro'

interface Props {
    monitor: OpsMonitor
    history?: OpsMonitorHistoryPoint[]
}

const { monitor, history = [] } = Astro.props
const summary = monitor.summary

const contracts_href = ops_redirect_path(translatePath, 'contracts')
const sell_orders_href = ops_redirect_path(translatePath, 'sell_orders')

function health_tone(pct: number | null | undefined): 'good' | 'warn' | 'bad' | 'none' {
    if (pct == null)
        return 'none'
    if (pct >= 80)
        return 'good'
    if (pct >= 40)
        return 'warn'
    return 'bad'
}

function progress_classes(tone: ReturnType<typeof health_tone>) {
    return {
        success: tone === 'good',
        warning: tone === 'warn',
        danger: tone === 'bad',
        disabled: tone === 'none',
    }
}

function format_pct(pct: number | null | undefined): string {
    if (pct == null)
        return '—'
    return `${pct % 1 === 0 ? pct.toFixed(0) : pct.toFixed(1)}%`
}

function term_parts(
    template_key: string,
    placeholder: string,
    word_key: string,
    fulfilled: number,
    targets: number,
): { before: string; word: string; after: string } {
    const word = t(word_key)
    const label = t(template_key)
        .replace('{fulfilled}', String(fulfilled))
        .replace('{targets}', String(targets))
    const [before, after = ''] = label.split(placeholder)
    return { before, word, after }
}

function on_target_parts(fulfilled: number, targets: number) {
    return term_parts(
        'ops_health_fulfilled',
        '{target}',
        'ops_health_target_word',
        fulfilled,
        targets,
    )
}

function listed_viable_parts(fulfilled: number, listed: number) {
    return term_parts(
        'ops_health_viable_fulfilled',
        '{viable}',
        'ops_health_viable_word',
        fulfilled,
        listed,
    )
}

function isk_label(template_key: string, isk: number): string {
    return t(template_key).replace('{isk}', format_isk(isk))
}

function sync_age_label(iso: string | null | undefined): string {
    if (!iso)
        return '—'
    return from_now_diff(lang, new Date(iso))
}

const contracts_tone = health_tone(summary.contracts_health_pct)
const contracts_viability_tone = health_tone(summary.contracts_viability_pct)
const sell_tone = health_tone(summary.sell_orders_health_pct)
const sell_viability_tone = health_tone(summary.sell_orders_viability_pct)

const contracts_on_target = summary.contract_targets > 0
    ? on_target_parts(summary.contract_fulfilled, summary.contract_targets)
    : null
const contracts_listed = summary.contract_listed_targets ?? 0
const contracts_viable = contracts_listed > 0
    ? listed_viable_parts(
        summary.contract_viable_fulfilled ?? 0,
        contracts_listed,
    )
    : null
const sell_on_target = summary.sell_order_targets > 0
    ? on_target_parts(summary.sell_order_fulfilled, summary.sell_order_targets)
    : null
const sell_listed = summary.sell_order_listed_targets ?? 0
const sell_viable = sell_listed > 0
    ? listed_viable_parts(
        summary.sell_order_viable_fulfilled,
        sell_listed,
    )
    : null
---

<Flexblock gap="var(--space-xl)" class="[ ops-monitor-content ]">
    <section class="[ ops-health ]">
        <Grid
            class="[ ops-health__split ]"
            min_item_width="280px"
            row_gap="var(--space-s)"
            column_gap="var(--space-s)"
        >
            <article class="[ ops-health__card ]">
                <p class="[ ops-health__card-label ]">{t('ops_health_contracts')}</p>
                <p
                    class="[ ops-health__card-meta ops-health__sync-age ]"
                    title={monitor.contracts_synced_at || undefined}
                >
                    {t('ops_sync_age_contracts')
                        .replace('{age}', sync_age_label(monitor.contracts_synced_at))}
                </p>
                <div class="[ ops-health__dual ]">
                    <div
                        class:list={['ops-health__metric', `ops-health__metric--${contracts_tone}`]}
                    >
                        <p class="[ ops-health__metric-label ]">{t('ops_health_coverage')}</p>
                        <p class="[ ops-health__card-pct ]">{format_pct(summary.contracts_health_pct)}</p>
                        <Progress
                            class:list={['ops-health__bar', progress_classes(contracts_tone)]}
                            max="100"
                            value={summary.contracts_health_pct != null ? Math.max(summary.contracts_health_pct, 0.1) : 0.1}
                        />
                        <p class="[ ops-health__card-meta ]">
                            {contracts_on_target ?
                                <>
                                    {contracts_on_target.before}
                                    <span
                                        class="[ ops-health__term ]"
                                        data-tippy-content={t('ops_health_contracts_target_hint')}
                                    >{contracts_on_target.word}</span>
                                    {contracts_on_target.after}
                                </>
                                : t('ops_health_no_targets')
                            }
                        </p>
                    </div>
                    <div
                        class:list={['ops-health__metric', `ops-health__metric--${contracts_viability_tone}`]}
                    >
                        <p class="[ ops-health__metric-label ]">{t('ops_health_viability')}</p>
                        <p class="[ ops-health__card-pct ]">{format_pct(summary.contracts_viability_pct)}</p>
                        <Progress
                            class:list={['ops-health__bar', progress_classes(contracts_viability_tone)]}
                            max="100"
                            value={summary.contracts_viability_pct != null ? Math.max(summary.contracts_viability_pct, 0.1) : 0.1}
                        />
                        <p class="[ ops-health__card-meta ]">
                            {contracts_viable ?
                                <>
                                    {contracts_viable.before}
                                    <span
                                        class="[ ops-health__term ]"
                                        data-tippy-content={t('ops_health_contracts_viability_hint')}
                                    >{contracts_viable.word}</span>
                                    {contracts_viable.after}
                                </>
                                :
                                summary.contract_targets > 0
                                    ? t('ops_health_no_listed')
                                    : t('ops_health_no_targets')
                            }
                        </p>
                    </div>
                </div>
                <FlexInline
                    class="[ ops-health__card-footer ]"
                    justification="space-between"
                >
                    <Button href={contracts_href} size="sm" color="transparent">
                        {t('view_ops_contracts')}
                    </Button>
                    <p class="[ ops-health__card-meta ops-health__card-meta--isk ]">
                        {isk_label('ops_health_isk_in_contracts', summary.contracts_isk)}
                    </p>
                </FlexInline>
            </article>

            <article class="[ ops-health__card ]">
                <p class="[ ops-health__card-label ]">{t('ops_health_sell_orders')}</p>
                <p
                    class="[ ops-health__card-meta ops-health__sync-age ]"
                    title={monitor.orders_synced_at || undefined}
                >
                    {t('ops_sync_age_orders')
                        .replace('{age}', sync_age_label(monitor.orders_synced_at))}
                </p>
                <div class="[ ops-health__dual ]">
                    <div
                        class:list={['ops-health__metric', `ops-health__metric--${sell_tone}`]}
                    >
                        <p class="[ ops-health__metric-label ]">{t('ops_health_coverage')}</p>
                        <p class="[ ops-health__card-pct ]">{format_pct(summary.sell_orders_health_pct)}</p>
                        <Progress
                            class:list={['ops-health__bar', progress_classes(sell_tone)]}
                            max="100"
                            value={summary.sell_orders_health_pct != null ? Math.max(summary.sell_orders_health_pct, 0.1) : 0.1}
                        />
                        <p class="[ ops-health__card-meta ]">
                            {sell_on_target ?
                                <>
                                    {sell_on_target.before}
                                    <span
                                        class="[ ops-health__term ]"
                                        data-tippy-content={t('ops_health_coverage_hint')}
                                    >{sell_on_target.word}</span>
                                    {sell_on_target.after}
                                </>
                                : t('ops_health_no_targets')
                            }
                        </p>
                    </div>
                    <div
                        class:list={['ops-health__metric', `ops-health__metric--${sell_viability_tone}`]}
                    >
                        <p class="[ ops-health__metric-label ]">{t('ops_health_viability')}</p>
                        <p class="[ ops-health__card-pct ]">{format_pct(summary.sell_orders_viability_pct)}</p>
                        <Progress
                            class:list={['ops-health__bar', progress_classes(sell_viability_tone)]}
                            max="100"
                            value={summary.sell_orders_viability_pct != null ? Math.max(summary.sell_orders_viability_pct, 0.1) : 0.1}
                        />
                        <p class="[ ops-health__card-meta ]">
                            {sell_viable ?
                                <>
                                    {sell_viable.before}
                                    <span
                                        class="[ ops-health__term ]"
                                        data-tippy-content={t('ops_health_viability_hint')}
                                    >{sell_viable.word}</span>
                                    {sell_viable.after}
                                </>
                                :
                                summary.sell_order_targets > 0
                                    ? t('ops_health_no_listed')
                                    : t('ops_health_no_targets')
                            }
                        </p>
                    </div>
                </div>
                <FlexInline
                    class="[ ops-health__card-footer ]"
                    justification="space-between"
                >
                    <Button href={sell_orders_href} size="sm" color="transparent">
                        {t('view_ops_sell_orders')}
                    </Button>
                    <p class="[ ops-health__card-meta ops-health__card-meta--isk ]">
                        {isk_label('ops_health_isk_in_sell_orders', summary.sell_orders_isk)}
                    </p>
                </FlexInline>
            </article>
        </Grid>
        <OpsMonitorHistoryChart history={history} />
    </section>
</Flexblock>

<style lang="scss">
    .ops-health {
        display: flex;
        flex-direction: column;
        gap: var(--space-s);
        padding: 0;
    }

    .ops-health__card-label {
        margin: 0;
        font-family: var(--heading-font);
        font-size: var(--step-1);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.85);
    }

    .ops-health__bar {
        --progress-height: var(--space-2xs);
        width: 100%;
        margin-block: var(--space-3xs);
    }

    .ops-health__card-meta {
        margin: 0;
        color: rgba(255, 255, 255, 0.55);
        font-size: var(--step--1);
    }

    .ops-health__sync-age {
        margin-block-end: var(--space-2xs);
        font-size: var(--step--2);
        color: rgba(255, 255, 255, 0.45);
    }

    .ops-health__term {
        color: rgba(255, 255, 255, 0.85);
        cursor: help;
        border-bottom: 1px dotted color-mix(in srgb, var(--highlight) 40%, transparent);
    }

    .ops-health__card-meta--isk {
        margin: 0;
        line-height: 1;
        font-size: var(--step--1);
        letter-spacing: 0.04em;
        text-align: end;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.5);
    }

    .ops-health__card-footer {
        margin-block-start: auto;
        padding-block-start: var(--space-xs);
        width: 100%;
        align-items: center;
    }

    .ops-health__card {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        padding: var(--space-m);
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(0, 0, 0, 0.22);
    }

    .ops-health__card-pct {
        margin: 0;
        font-family: var(--heading-font);
        font-size: clamp(2.25rem, 5vw, 3.5rem);
        line-height: 0.95;
        letter-spacing: -0.02em;
        text-transform: uppercase;
        color: var(--highlight);
        min-height: 1em;
    }

    .ops-health__dual {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-s);
        align-items: start;
    }

    .ops-health__metric {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        min-width: 0;
    }

    .ops-health__metric-label {
        margin: 0;
        font-size: var(--step--1);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.55);
        min-height: 1.2em;
    }

    .ops-health__card--good .ops-health__card-pct,
    .ops-health__metric--good .ops-health__card-pct {
        color: var(--green);
    }

    .ops-health__card--warn .ops-health__card-pct,
    .ops-health__metric--warn .ops-health__card-pct {
        color: var(--fleet-yellow);
    }

    .ops-health__card--bad .ops-health__card-pct,
    .ops-health__metric--bad .ops-health__card-pct {
        color: var(--fleet-red);
    }
</style>
