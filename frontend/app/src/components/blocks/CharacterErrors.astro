---
import { i18n, t_key } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { SummaryCharacter } from '@dtypes/api.minmatar.org'
import type { CharacterErrorUI } from '@dtypes/layout_components'

interface Props {
    character_errors:   CharacterErrorUI[];
}

const {
    character_errors
} = Astro.props

import FlexInline from '@components/compositions/FlexInline.astro';
import ComponentBlock from '@components/blocks/ComponentBlock.astro';
import Flexblock from '@components/compositions/Flexblock.astro';
import FixedFluid from '@components/compositions/FixedFluid.astro';
import FluidFixed from '@components/compositions/FluidFixed.astro';

import Markdown from '@components/blocks/Markdown.astro';
import CharacterPicture from '@components/blocks/CharacterPicture.astro';
import ButtonAddPrimary from '@components/blocks/ButtonAddPrimary.astro';
import Button from '@components/blocks/Button.astro';
import FixESITokenButton from '@components/blocks/FixESITokenButton.astro';
---

<ComponentBlock id="character_errors" class="[ character-errors ]">
    <Flexblock gap='0'>
        <FlexInline gap='var(--space-xs)' class="[ character-errors__head ][ items-baseline ]">
            <h2>{character_errors.length === 1 ? t('account.attention_title_one') : t('account.attention_title').replace('{count}', character_errors.length.toString())}</h2>
            <small class="[ character-errors__hint ]">{t('account.attention_hint')}</small>
        </FlexInline>

        {character_errors.map(character_error =>
            <FluidFixed width='200px' class="[ character-errors__row ][ items-center ]">
                <FixedFluid width="32px" gap="var(--space-2xs)">
                    <CharacterPicture
                        character_id={character_error?.character?.character_id ?? 0}
                        character_name={character_error?.character?.character_name ?? ''}
                        size={32}
                    />
                    <Flexblock gap="var(--space-3xs)">
                        <h4>
                            {character_error?.character?.character_name ?
                                ((t(t_key('', character_error.error, '_title')) ?? t('DATA_ERROR_title')).replace('CHARACTER_NAME', character_error.character.character_name as string)) :
                                (t(t_key('', character_error.error, '_title')) ?? t('DATA_ERROR_title'))
                            }
                        </h4>
                        <Markdown
                            markdown={t(t_key('', character_error.error, '_description')) ?? t('DATA_ERROR_description')}
                            inline={true}
                            inline_element='small'
                        />
                    </Flexblock>
                </FixedFluid>
                    
                <div class="[ flex justify-end items-center ]">{
                    character_error.error === 'MAIN_NOT_IN_FL33T' ?
                        <ButtonAddPrimary
                            size='sm'
                            dialog_title={t('add_primary_pilot_dialog_title')}
                        >
                            {t('add_primary_pilot')}
                        </ButtonAddPrimary> :
                    character_error.error === 'NO_TOKEN_LEVEL' ?
                        <FixESITokenButton
                            character={character_error.character as SummaryCharacter}
                            fix={true}
                        /> :
                    character_error.error === 'ESI_SUSPENDED' ?
                        <FixESITokenButton
                            character={character_error.character as SummaryCharacter}
                            fix={true}
                        /> :
                    character_error.error === 'NO_MAIN_SET' ?
                        <ButtonAddPrimary
                            size='sm'
                            dialog_title={t('add_primary_pilot_dialog_title')}
                        >
                            {t('add_primary_pilot')}
                        </ButtonAddPrimary> :
                    character_error.error === 'NO_TAGS' ?
                        <Button
                            href={translatePath(`/account/tags/${character_error.character?.character_id ?? ''}`)}
                            size='sm'
                        >
                            {t('set_character_roles')}
                        </Button>  :
                        null
                }</div>
            </FluidFixed>
        )}
    </Flexblock>
</ComponentBlock>

<style lang="scss">
    .character-errors__head {
        padding-block-end: var(--space-s);

        h2 {
            color: var(--security-status-point-4);
        }
    }

    .character-errors__hint {
        color: var(--text-muted);
    }

    .character-errors__row {
        padding-block: var(--space-s);
        border-block-start: 1px solid var(--border-color);
    }
</style>