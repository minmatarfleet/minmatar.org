---
import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import ItemPicture from '@components/blocks/ItemPicture.astro'
import Tag from '@components/blocks/Tag.astro'
import FixedFluid from '@components/compositions/FixedFluid.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import type { MatchupEntry, MatchupVerdict, ResolvedOpponentShip } from '@/data/ship-guide/types'
import type { TagColors } from '@dtypes/layout_components'

interface Props {
    entry:          MatchupEntry;
    verdict_labels: Record<MatchupVerdict, string>;
    /** Hull for the opponent icon, resolved by the guide's own ship table. */
    opponent_ship:  ResolvedOpponentShip | null;
}

const { entry, verdict_labels, opponent_ship } = Astro.props

const verdict_tag_colors: Record<MatchupVerdict, TagColors> = {
    favoured: 'green',
    unfavoured: 'fleet-red',
    even: 'alliance-blue',
    bail: 'fleet-red',
    skill: 'fleet-yellow',
    unknown: 'security-status-null',
}

---

<li class="guide-matchup-card">
    <ComponentBlock
        class="guide-matchup-card__panel"
        padding_block="var(--space-s)"
        padding_inline="var(--space-s)"
    >
        <FixedFluid class="[ items-start ]" width="64px" breakpoint="0">
            {
                opponent_ship ? (
                    <ItemPicture
                        item_id={opponent_ship.shipId}
                        item_name={opponent_ship.shipName}
                        size={64}
                    />
                ) : (
                    <div class="guide-matchup-card__icon-placeholder" aria-hidden="true" />
                )
            }
            <Flexblock class="[ guide-matchup-card__content ]" gap="var(--space-3xs)">
                <FlexInline class="[ w-full guide-matchup-card__head ]" justification="space-between">
                    <span class="[ opponent ]">{entry.opponent}</span>
                    {
                        entry.verdict && (
                            <Tag
                                text={verdict_labels[entry.verdict]}
                                color={verdict_tag_colors[entry.verdict]}
                                narrow={true}
                            />
                        )
                    }
                </FlexInline>
                <p class="[ load ]" aria-hidden={!entry.load}>
                    {
                        entry.load ? (
                            <>
                                <span>Load</span> {entry.load}
                            </>
                        ) : (
                            '\u00a0'
                        )
                    }
                </p>
                <p class="[ advice ]">{entry.advice}</p>
            </Flexblock>
        </FixedFluid>
    </ComponentBlock>
</li>

<style lang="scss">
    .guide-matchup-card {
        display: flex;
        min-height: 100%;
        list-style: none;
    }

    .guide-matchup-card__panel {
        flex: 1;
        width: 100%;
        display: flex;
        flex-direction: column;
    }

    .guide-matchup-card__panel :global(> .wrapper) {
        flex: 1;
        display: flex;
        flex-direction: column;
        height: 100%;
        max-width: none;
    }

    .guide-matchup-card__content {
        flex: 1;
        min-width: 0;
    }

    .guide-matchup-card__icon-placeholder {
        flex: 0 0 64px;
        width: 64px;
        height: 64px;
        background: color-mix(in srgb, var(--component-background) 70%, transparent);
        border: 1px solid color-mix(in srgb, var(--border-color) 55%, transparent);
    }

    .guide-matchup-card__head {
        gap: var(--space-2xs);
        align-items: flex-start;
    }

    .opponent {
        min-width: 0;
        flex: 1 1 8rem;
        font-weight: 600;
        font-size: var(--step--1);
        line-height: 1.25;
        color: var(--foreground);
        overflow-wrap: anywhere;
    }

    .load {
        margin: 0;
        min-height: 1.4em;
        font-family: var(--mono-font, ui-monospace, monospace);
        font-size: var(--step--2);
        line-height: 1.4;

        span {
            margin-right: var(--space-2xs);
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--text-color-secondary, var(--faded));
        }
    }

    .advice {
        margin: 0;
        flex: 1;
        font-size: var(--step--1);
        line-height: 1.55;
        color: var(--text-color-secondary, var(--faded));
    }

    /* Phones: thumbnail beside the name + load, advice below at full card width. */
    @media (max-width: 48rem) {
        .guide-matchup-card__panel :global(.fixed-fluid) {
            display: grid;
            grid-template-columns: 64px minmax(0, 1fr);
            gap: var(--space-3xs) var(--space-xs);
            align-items: start;
        }

        .guide-matchup-card__panel :global(.fixed-fluid > picture),
        .guide-matchup-card__icon-placeholder {
            grid-column: 1;
            grid-row: 1 / span 2;
            width: 64px;
        }

        .guide-matchup-card__content {
            display: contents;
        }

        .guide-matchup-card__head,
        .load {
            grid-column: 2;
        }

        .advice {
            grid-column: 1 / -1;
            margin-top: var(--space-3xs);
        }
    }
</style>
