---
import { countdown, next_countdown_serial } from '@helpers/countdown';

interface Props {
    id:             number;
    tag?:           string;
    date:           Date | string;
    expired_text?:  string;
    expired_class?: boolean;
    big_font?:      boolean;
    [propName: string]: any;
}

const {
    id,
    tag = 'countdown',
    date,
    expired_text,
    expired_class = true,
    big_font = false,
    ...attributes
} = Astro.props;

delete attributes.class

const element_id = `${tag}-${id}-${next_countdown_serial()}`

const {
    text,
    expired,
} = countdown(date, expired_text)

const date_iso = date instanceof Date ? date.toISOString() : String(date)
const show_expired_text = expired && !!expired_text
const initial_text = show_expired_text ? expired_text : text
---

<p
    {...attributes}
    x-data={`{
        countdown_text: ${JSON.stringify(initial_text)},
        pad(num) {
            if (num < 10)
                return \`0\${num}\`;
            
            return num;
        },
        init() {
            const date = ${JSON.stringify(date_iso)}
            const expired_text = ${JSON.stringify(expired_text ?? '')}
            const count_down_date = new Date(date).getTime()
            const el = $el
            
            const interval = setInterval(() => {
                const now = new Date().getTime()
                
                const distance = count_down_date - now

                if (!document.getElementById(${JSON.stringify(element_id)})) {
                    clearInterval(interval)
                    return
                }

                if (distance < 0 && expired_text) {
                    this.update_countdown_text(expired_text)
                    el.classList.add('expired-text')
                    ${expired_class ? "el.classList.add('expired')" : ''}
                    clearInterval(interval)
                    return
                }

                let days = distance / (1000 * 60 * 60 * 24)
                days = (days > 0 ? Math.floor(days) : Math.ceil(days))
                let hours = (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)
                hours = (hours > 0 ? Math.floor(hours) : Math.ceil(hours))
                let minutes = (distance % (1000 * 60 * 60)) / (1000 * 60)
                minutes = (minutes > 0 ? Math.floor(minutes) : Math.ceil(minutes))
                let seconds = (distance % (1000 * 60)) / 1000
                seconds = (seconds > 0 ? Math.floor(seconds) : Math.ceil(seconds))

                this.update_countdown_text(
                    this.pad(Math.abs(days * 24 +  hours)) + " : " + this.pad(Math.abs(minutes)) + " : " + this.pad(Math.abs(seconds))
                )
                
                ${expired_class ? `
                if (distance < 0)
                    el.classList.add('expired')
                ` : ''}
            }, 1000);
        },
        update_countdown_text(new_text) {
            this.countdown_text = new_text
        }
    }`}
    class:list={[
        'countdown',
        {
            expired: expired && expired_class,
            'expired-text': expired && expired_text,
            'big-font': big_font
        },
        Astro.props.class,
    ]}
    id={element_id}
    x-text="countdown_text"
>
    {initial_text}
</p>

<style lang="scss">
	p {
        font-family: var(--countdown-font);
		font-size: var(--step-2);
		letter-spacing: 12px;
        text-indent: 12px;
		line-height: 1;
        white-space: nowrap;
        text-transform: uppercase;

        &.big-font {
            font-size: var(--step-4);
        }
	}

    .expired:not(.expired-text) {
        color: var(--fleet-red);
    }

    .expired-text {
        font-family: var(--heading-font) !important;
        font-size: var(--step-0);
        color: var(--highlight);
    }
</style>