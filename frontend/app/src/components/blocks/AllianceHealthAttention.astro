---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type {
    AllianceHealthAttentionBucket,
    AllianceHealthQuietCounts,
} from '@dtypes/api.minmatar.org'
import { alliance_health_table_params } from '@helpers/api.minmatar.org/alliance_health'
import { ALLIANCE_HEALTH_DEFAULT_BUCKETS } from '@helpers/alliance_health_url'

import AllianceHealthBucketTabs from '@components/blocks/AllianceHealthBucketTabs.astro'

interface Props {
    quiet: AllianceHealthQuietCounts
    bucket: AllianceHealthAttentionBucket
    partial_url: string
    initial_corp?: string
    counts_by_corp?: Record<string, AllianceHealthQuietCounts>
    can_mutate?: boolean
    alliance_wide?: boolean
    officer_corp_ids?: number[]
    can_leave_any?: boolean
    ceo_corp_ids?: number[]
    [propName: string]: any
}

const {
    quiet,
    bucket,
    partial_url,
    initial_corp = 'all',
    counts_by_corp = {},
    can_mutate = false,
    alliance_wide = false,
    officer_corp_ids = [],
    can_leave_any = false,
    ceo_corp_ids = [],
    ...attributes
} = Astro.props
delete attributes.class

const default_bucket = ALLIANCE_HEALTH_DEFAULT_BUCKETS.attention
const tab_query = (id: AllianceHealthAttentionBucket) =>
    alliance_health_table_params({
        bucket: id,
        include_corp: false,
        can_mutate,
        alliance_wide,
        officer_corp_ids,
        can_leave_any,
        ceo_corp_ids,
    })

const counts = {
    fading: quiet.fading,
    dark: quiet.dark,
    seasonal: quiet.seasonal,
}

const tabs = [
    { id: 'fading', count: quiet.fading, label: t('alliance.health.bucket.fading') },
    { id: 'dark', count: quiet.dark, label: t('alliance.health.bucket.dark') },
    { id: 'seasonal', count: quiet.seasonal, label: t('alliance.health.bucket.seasonal') },
].map((tab) => ({
    ...tab,
    href: `${partial_url}?${tab_query(tab.id as AllianceHealthAttentionBucket)}`,
}))
---

<AllianceHealthBucketTabs
    class={Astro.props.class}
    {...attributes}
    section_id="health-attention"
    aria_label={t('alliance.health.attention.aria')}
    bucket={bucket}
    url_section="attention"
    default_bucket={default_bucket}
    table_id="alliance-health-attention-table"
    tabs={tabs}
    initial_corp={initial_corp}
    counts={counts}
    counts_by_corp={counts_by_corp}
>
    <slot />
</AllianceHealthBucketTabs>
