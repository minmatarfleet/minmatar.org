---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type {
    AllianceHealthAttentionBucket,
    AllianceHealthQuietCounts,
} from '@dtypes/api.minmatar.org'

import FlexInline from '@components/compositions/FlexInline.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import Button from '@components/blocks/Button.astro'
import ComponentBlock from '@components/blocks/ComponentBlock.astro'

interface Props {
    quiet: AllianceHealthQuietCounts
    bucket: AllianceHealthAttentionBucket
    partial_url: string
    [propName: string]: any
}

const { quiet, bucket, partial_url, ...attributes } = Astro.props
delete attributes.class

const tabs: {
    id: AllianceHealthAttentionBucket
    count: number
    label: string
}[] = [
    {
        id: 'fading',
        count: quiet.fading,
        label: t('alliance.health.bucket.fading'),
    },
    {
        id: 'dark',
        count: quiet.dark,
        label: t('alliance.health.bucket.dark'),
    },
    {
        id: 'seasonal',
        count: quiet.seasonal,
        label: t('alliance.health.bucket.seasonal'),
    },
]
---

<section
    class:list={['[ alliance-health-attention ]', Astro.props.class]}
    aria-label={t('alliance.health.attention.aria')}
    x-data={`{ attention_bucket: '${bucket}' }`}
>
    <Flexblock gap="var(--space-m)">
        <FlexInline gap="var(--space-2xs)">
            {tabs.map((tab) => (
                <Button
                    size="sm"
                    x-bind:class={`attention_bucket === '${tab.id}' ? 'active' : ''`}
                    color="transparent"
                    x-on:click={`attention_bucket = '${tab.id}'`}
                    hx-get={`${partial_url}?bucket=${tab.id}`}
                    hx-target="#alliance-health-attention-table"
                    hx-swap="innerHTML"
                    hx-indicator=".loader"
                >
                    {tab.label} ({tab.count})
                </Button>
            ))}
        </FlexInline>

        <ComponentBlock padding_inline="var(--space-m)">
            <div id="alliance-health-attention-table">
                <slot />
            </div>
        </ComponentBlock>
    </Flexblock>
</section>

<style lang="scss">
    .alliance-health-attention :global(.button.active) {
        border-color: var(--alliance-blue);
        color: var(--highlight);
    }
</style>
