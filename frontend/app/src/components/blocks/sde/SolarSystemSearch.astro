---
/**
 * Search solar systems by name: a Combobox preset. The field asks the server
 * (`/partials/sde_system_search_component`) as the pilot types and the
 * partial answers with `<li role="option" data-value data-label>` rows (a
 * SolarSystemTag inside each). Filters (`region_ids`, `security`,
 * `wormholes`, `limit`) travel in the request URL; `security` bands use the
 * displayed value (0.45 is high-sec, 0.03 is low-sec).
 *
 * Picking a system fills the hidden input `name` with the system id and
 * dispatches `combobox:select` with `{ name, value, label }`.
 */
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { SdeSolarSystem } from '@dtypes/sde'
import type { SystemSecurityFilter } from '@helpers/sde/search'

interface Props {
    /** Hidden input name for the picked system id. */
    name:               string;
    label?:             string;
    placeholder?:       string;
    region_ids?:        number[];
    security?:          SystemSecurityFilter;
    /** Include J-space when `security` is `any`. */
    wormholes?:         boolean;
    limit?:             number;
    selected?:          Pick<SdeSolarSystem, 'system_id' | 'system_name'> | null;
    allow_clear?:       boolean;
    [propName: string]: any;
}

const {
    name,
    label = t('sde.system_search.label'),
    placeholder = t('sde.system_search.placeholder'),
    region_ids = [],
    security = 'any',
    wormholes = true,
    limit,
    selected = null,
    allow_clear = true,
    ...attributes
} = Astro.props

const params: Record<string, string> = {}
if (region_ids.length > 0) params.region_ids = region_ids.join(',')
if (security !== 'any') params.security = security
if (!wormholes) params.wormholes = '0'
if (limit) params.limit = String(limit)

const base = translatePath('/partials/sde_system_search_component')
const search_url = Object.keys(params).length > 0 ? `${base}?${new URLSearchParams(params)}` : base

import Combobox from '@components/blocks/Combobox.astro'
---

<Combobox
    name={name}
    label={label}
    placeholder={placeholder}
    search_url={search_url}
    value={selected ? String(selected.system_id) : ''}
    value_label={selected?.system_name ?? ''}
    allow_clear={allow_clear}
    {...attributes}
/>
