---
/**
 * Search inventory types by name: a Combobox preset. The field asks the
 * server (`/partials/sde_type_search_component`) as the pilot types and the
 * partial answers with `<li role="option" data-value data-label>` rows (a
 * TypeRow inside each). Filters (`category_ids`, `group_ids`, `published`,
 * `limit`, `slots`) travel in the request URL.
 *
 * Picking a type fills the hidden input `name` with the type id and dispatches
 * `combobox:select` with `{ name, value, label }`.
 */
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { SdeType } from '@dtypes/sde'

interface Props {
    /** Hidden input name for the picked type id. */
    name:               string;
    label?:             string;
    placeholder?:       string;
    /** Only these categories (6 ships, 7 modules, 8 charges...). */
    category_ids?:      number[];
    /** Only these groups (59 Gyrostabilizer, 25 Frigate...). */
    group_ids?:         number[];
    published?:         boolean;
    limit?:             number;
    /** Slot layout under each ship result. */
    show_slots?:        boolean;
    /** Already picked (an edit form). */
    selected?:          Pick<SdeType, 'type_id' | 'type_name'> | null;
    allow_clear?:       boolean;
    [propName: string]: any;
}

const {
    name,
    label = t('sde.type_search.label'),
    placeholder = t('sde.type_search.placeholder'),
    category_ids = [],
    group_ids = [],
    published = true,
    limit,
    show_slots = false,
    selected = null,
    allow_clear = true,
    ...attributes
} = Astro.props

const params: Record<string, string> = {}
if (category_ids.length > 0) params.category_ids = category_ids.join(',')
if (group_ids.length > 0) params.group_ids = group_ids.join(',')
if (!published) params.published = '0'
if (limit) params.limit = String(limit)
if (show_slots) params.slots = '1'

const base = translatePath('/partials/sde_type_search_component')
const search_url = Object.keys(params).length > 0 ? `${base}?${new URLSearchParams(params)}` : base

import Combobox from '@components/blocks/Combobox.astro'
---

<Combobox
    name={name}
    label={label}
    placeholder={placeholder}
    search_url={search_url}
    value={selected ? String(selected.type_id) : ''}
    value_label={selected?.type_name ?? ''}
    allow_clear={allow_clear}
    {...attributes}
/>
