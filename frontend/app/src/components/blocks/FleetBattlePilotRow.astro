---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { BattlePilotRow } from '@dtypes/layout_components'
import { get_item_icon, get_corporation_logo, get_alliance_logo } from '@helpers/eve_image_server'

/**
 * One pilot on a battle report side: the hull (the one they lost, if any)
 * linking to its killmail, name and ship, then damage with its share of the
 * team's, kills, ISK lost, and corporation and alliance logos. Other hulls
 * they flew sit as small icons after the ship name. Below 460px of column
 * the row folds to two lines: name and loss, then ship and damage · kills.
 */
interface Props {
    row:                BattlePilotRow;
    [propName: string]: any;
}

const { row, ...attributes } = Astro.props

delete attributes.class

const zkill = (id: number) => `https://zkillboard.com/kill/${id}/`
const pilot_href = `https://zkillboard.com/character/${row.character_id}/`
---

<div class:list={['[ br-pilot ]', { 'br-pilot--lost': row.lost }, Astro.props.class]} {...attributes}>
    {row.icon_type_id ?
        (row.killmail_id ?
            <a class="[ br-pilot__icon ]" href={zkill(row.killmail_id)} target="_blank" rel="noopener noreferrer" aria-label={t('fleets.report.killmail_of').replace('{ship}', row.ship).replace('{pilot}', row.name)}>
                <img src={get_item_icon(row.icon_type_id, 64)} alt="" width="36" height="36" loading="lazy" />
            </a> :
            <img class="[ br-pilot__icon ]" src={get_item_icon(row.icon_type_id, 64)} alt="" width="36" height="36" loading="lazy" />) :
        <span class="[ br-pilot__icon ]" />
    }
    <div class="[ br-pilot__body ]">
        <div class="[ br-pilot__line ]">
            <a class="[ br-pilot__name ]" href={pilot_href} target="_blank" rel="noopener noreferrer">{row.name}</a>
            <span class="[ br-pilot__loss br-pilot__narrow ]">{row.loss}</span>
        </div>
        <div class="[ br-pilot__line ]">
            <span class="[ br-pilot__ship ]">
                <span class="[ br-pilot__ship-name ]">{row.ship}</span>
                {row.extras.map(extra =>
                    extra.killmail_id ?
                        <a class="[ br-pilot__extra br-pilot__extra--lost ]" href={zkill(extra.killmail_id)} target="_blank" rel="noopener noreferrer" aria-label={extra.title} data-tippy-content={extra.title}>
                            <img src={get_item_icon(extra.type_id, 32)} alt="" width="18" height="18" loading="lazy" />
                        </a> :
                        <img class="[ br-pilot__extra ]" src={get_item_icon(extra.type_id, 32)} alt={extra.title} data-tippy-content={extra.title} width="18" height="18" loading="lazy" />
                )}
                {row.pod_killmail_id &&
                    <a class="[ br-pilot__pod ]" href={zkill(row.pod_killmail_id)} target="_blank" rel="noopener noreferrer" data-tippy-content={row.pod_title}>{t('fleets.report.pod')}</a>
                }
            </span>
            <span class="[ br-pilot__brief br-pilot__narrow ]">
                <span class:list={[{ 'br-pilot__top': row.damage_top }]}>{row.damage}</span>
                {' · '}
                <span class:list={[{ 'br-pilot__top': row.kills_top }]}>{row.kills}</span>
            </span>
        </div>
    </div>
    <span class:list={['[ br-pilot__num br-pilot__wide ]', { 'br-pilot__top': row.damage_top }]}>
        {row.damage}<small>{row.share}</small>
    </span>
    <span class:list={['[ br-pilot__num br-pilot__wide ]', { 'br-pilot__top': row.kills_top }]}>{row.kills}</span>
    <span class="[ br-pilot__loss br-pilot__wide ]">{row.loss}<small>{row.loss_note}</small></span>
    <span class="[ br-pilot__logos ]">
        {row.corporation_id &&
            <img src={get_corporation_logo(row.corporation_id, 64)} alt={row.corporation_name} data-tippy-content={row.corporation_name || undefined} width="24" height="24" loading="lazy" />
        }
        {row.alliance_id &&
            <img src={get_alliance_logo(row.alliance_id, 64)} alt={row.alliance_name} data-tippy-content={row.alliance_name || undefined} width="24" height="24" loading="lazy" />
        }
    </span>
</div>

<style lang="scss">
    .br-pilot {
        display: grid;
        grid-template-columns: 2.25rem minmax(0, 1fr) 4.5rem 2.25rem 4rem 3.25rem;
        align-items: center;
        column-gap: var(--space-2xs);
        min-height: 3rem;
        padding: var(--space-3xs) var(--space-2xs);
        border-bottom: 1px solid var(--hairline);
    }

    .br-pilot--lost {
        background-color: color-mix(in srgb, var(--fleet-red) 22%, var(--component-background));
    }

    .br-pilot__icon,
    .br-pilot__icon img {
        display: block;
        width: 2.25rem;
        height: 2.25rem;
    }

    .br-pilot__body {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

    .br-pilot__line {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: var(--space-2xs);
        min-width: 0;
    }

    .br-pilot__name {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-weight: 700;
        color: var(--foreground);
        text-decoration: none;

        &:hover,
        &:focus-visible {
            text-decoration: underline;
        }
    }

    .br-pilot__ship {
        display: flex;
        align-items: center;
        gap: var(--space-3xs);
        min-width: 0;
        font-size: var(--step--1);
        color: var(--text-muted);
    }

    .br-pilot__ship-name {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .br-pilot__extra {
        flex: none;
        display: block;
        width: 18px;
        height: 18px;
        outline: 1px solid var(--hairline-strong);

        img {
            display: block;
        }
    }

    .br-pilot__extra--lost {
        outline-color: color-mix(in srgb, var(--fleet-red) 60%, white);
    }

    .br-pilot__pod {
        flex: none;
        font-size: var(--step--2);
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: color-mix(in srgb, var(--fleet-red) 60%, white);
        text-decoration: none;
    }

    .br-pilot__num {
        color: var(--highlight);
        text-align: right;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;

        small {
            display: block;
            font-size: var(--step--2);
            color: var(--text-muted);
        }
    }

    .br-pilot__loss {
        color: color-mix(in srgb, var(--fleet-red) 60%, white);
        font-weight: 700;
        text-align: right;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;

        small {
            display: block;
            font-size: var(--step--2);
            font-weight: 500;
        }
    }

    .br-pilot__brief {
        font-size: var(--step--1);
        color: var(--text-muted);
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    .br-pilot__top {
        color: color-mix(in srgb, var(--green) 55%, white) !important;
        font-weight: 700;
    }

    .br-pilot__logos {
        display: flex;
        justify-content: flex-end;
        gap: var(--space-3xs);

        img {
            display: block;
            width: 24px;
            height: 24px;
        }
    }

    .br-pilot__narrow {
        display: none;
    }

    @container (max-width: 28.75rem) {
        .br-pilot {
            grid-template-columns: 2.25rem minmax(0, 1fr) 3.25rem;
        }

        .br-pilot__wide {
            display: none;
        }

        .br-pilot__narrow {
            display: inline;
        }
    }
</style>
