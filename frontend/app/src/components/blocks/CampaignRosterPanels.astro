---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { CampaignRoster } from '@dtypes/api.minmatar.org'
import { timezone_description } from '@helpers/timezones'

interface Props {
    roster:             CampaignRoster;
    [propName: string]: any;
}

const {
    roster,
    ...attributes
} = Astro.props

delete attributes.class

const by_timezone = roster.by_timezone ?? []
const corporations = roster.corporations ?? []

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'

import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import Tag from '@components/blocks/Tag.astro'

import CampaignCorporationStats from '@components/blocks/CampaignCorporationStats.astro'
import CampaignCoverageChart from '@components/blocks/CampaignCoverageChart.astro'
---

<Flexblock gap='var(--space-l)' class:list={['[ campaign-roster-panels ]', Astro.props.class]} {...attributes}>
    <ComponentBlock padding_inline='var(--space-m)' padding_block='var(--space-m)'>
        <Flexblock gap='var(--space-s)'>
            <FlexInline gap='var(--space-s)' justification='space-between' class="[ items-center ]">
                <h2>{t('campaigns.corporations.title')}</h2>
                <small>
                    {t('campaigns.corporations.summary')
                        .replace('{pilots}', String(roster.pilots.length))
                        .replace('{corporations}', String(corporations.length))}
                </small>
            </FlexInline>
            <CampaignCorporationStats corporations={corporations} />
        </Flexblock>
    </ComponentBlock>

    <ComponentBlock padding_inline='var(--space-m)' padding_block='var(--space-m)'>
        <Flexblock gap='var(--space-s)'>
            <h2>{t('campaigns.coverage.title')}</h2>
            <CampaignCoverageChart coverage={roster.coverage} />
        </Flexblock>
    </ComponentBlock>

    {by_timezone.length > 0 &&
        <ComponentBlock padding_inline='var(--space-m)' padding_block='var(--space-m)'>
            <Flexblock gap='var(--space-s)'>
                <h2>{t('campaigns.roster.by_timezone')}</h2>
                <FlexInline gap='var(--space-2xs)'>
                    {by_timezone.map(({ bracket, pilots }) =>
                        <Tag
                            text={`${bracket ?? t('timezones.no_tz_yet')}: ${pilots}`}
                            title={bracket ? timezone_description(bracket, t) : t('timezones.no_tz_yet_hint')}
                            color='alliance-blue'
                        />
                    )}
                </FlexInline>
            </Flexblock>
        </ComponentBlock>
    }
</Flexblock>

<style lang="scss">
    h2 {
        font-family: var(--heading-font);
        font-size: var(--step-1);
        color: var(--highlight);
        text-transform: uppercase;
    }
</style>
