---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import Wrapper from '@components/compositions/Wrapper.astro'
import Grid from '@components/compositions/Grid.astro'

import Button from '@components/blocks/Button.astro'
import Tile from '@components/blocks/Tile.astro'

import FitsEvEIcon from '@components/icons/FitsEvEIcon.astro'
---

<Wrapper
    class="[ market-reel ]"
    padding_block='0'
    padding_inline='0'
    max_width='100%'
>
    <Grid
        class="[ w-full grid-fill ]"
        row_gap="var(--space-3xs)"
        column_gap="var(--space-3xs)"
        min_item_width="580px"
    >
        <Tile
            title={t('services.page_title')}
            description={t('services.leading_text')}
            cover='/images/freight-tile-background.webp'
        >
            <Button size='sm' href={translatePath('/market/freight/calculator/')}>
                {t('freight_service')}
            </Button>

            <Button size='sm' href={translatePath('/market/buyback/')}>
                {t('buyback_service')}
            </Button>

            <Button size='sm' href={translatePath('/industry/loyalty/')}>
                {t('loyalty_point_service')}
            </Button>
        </Tile>

        <Tile
            title={t('staging_supply.ops.tile_title')}
            description={t('staging_supply.ops.tile_description')}
            cover='/images/sellorders-tile-background.webp'
        >
            <Button size='sm' href={translatePath('/market/ops/')}>
                {t('staging_supply.ops.tile_browse')}
            </Button>
        </Tile>

        <Tile
            title={t('fitting_buy.page_title')}
            description={t('fitting_buy.leading_text')}
            cover='/images/fittings-tile-background.webp'
        >
            <FitsEvEIcon class="[ ml-[-6px] ]" slot="icon" />

            <Button size='sm' href={translatePath('/market/fitting_orders/')}>
                {t('enter')}
            </Button>
        </Tile>
    </Grid>
</Wrapper>
