---
import { i18n } from '@helpers/i18n'
const { lang, t, translatePath } = i18n(Astro.url)

import type { MarketHealth, MarketHealthChartPoint } from '@dtypes/api.minmatar.org'
import { from_now_diff } from '@helpers/date'
import { format_isk } from '@helpers/numbers'
import { query_string } from '@helpers/string'

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import Grid from '@components/compositions/Grid.astro'
import Button from '@components/blocks/Button.astro'
import Progress from '@components/blocks/Progress.astro'
import MarketHealthHistoryChart from '@components/blocks/MarketHealthHistoryChart.astro'

interface Props {
    health: MarketHealth
    history?: MarketHealthChartPoint[]
    location_id?: number
}

const { health, history = [], location_id } = Astro.props
const contracts = health.contracts.latest
const sell_orders = health.sell_orders.latest

const contracts_synced_at = contracts?.synced_at ?? null
const orders_synced_at = sell_orders?.synced_at ?? null

const contracts_health_pct = contracts?.health_pct ?? null
const contracts_viability_pct = contracts?.viability_pct ?? null
const sell_orders_health_pct = sell_orders?.health_pct ?? null
const sell_orders_viability_pct = sell_orders?.viability_pct ?? null

const contract_targets = contracts?.targets ?? 0
const contract_fulfilled = contracts?.fulfilled ?? 0
const contract_viable_fulfilled = contracts?.viable_fulfilled ?? 0
const sell_order_targets = sell_orders?.targets ?? 0
const sell_order_fulfilled = sell_orders?.fulfilled ?? 0
const sell_order_viable_fulfilled = sell_orders?.viable_fulfilled ?? 0
const contracts_isk = contracts?.isk ?? 0
const sell_orders_isk = sell_orders?.isk ?? 0

const contracts_href = location_id != null
    ? translatePath(`/market/ops/contracts/?${query_string({ location_id })}`)
    : translatePath('/market/ops/contracts/')
const sell_orders_href = location_id != null
    ? translatePath(`/market/ops/sell_orders/?${query_string({ location_id })}`)
    : translatePath('/market/ops/sell_orders/')

function health_tone(pct: number | null | undefined): 'good' | 'warn' | 'bad' | 'none' {
    if (pct == null)
        return 'none'
    if (pct >= 80)
        return 'good'
    if (pct >= 40)
        return 'warn'
    return 'bad'
}

function format_pct(pct: number | null | undefined): string {
    if (pct == null)
        return '—'
    return `${pct % 1 === 0 ? pct.toFixed(0) : pct.toFixed(1)}%`
}

function term_parts(
    template_key: string,
    placeholder: string,
    word_key: string,
    fulfilled: number,
    targets: number,
): { before: string; word: string; after: string } {
    const word = t(word_key)
    const label = t(template_key)
        .replace('{fulfilled}', String(fulfilled))
        .replace('{targets}', String(targets))
    const [before, after = ''] = label.split(placeholder)
    return { before, word, after }
}

function on_target_parts(fulfilled: number, targets: number) {
    return term_parts(
        'ops_health_fulfilled',
        '{target}',
        'ops_health_target_word',
        fulfilled,
        targets,
    )
}

function viable_fulfilled_parts(fulfilled: number, targets: number) {
    return term_parts(
        'ops_health_viable_fulfilled',
        '{viable}',
        'ops_health_viable_word',
        fulfilled,
        targets,
    )
}

function isk_label(template_key: string, isk: number): string {
    return t(template_key).replace('{isk}', format_isk(isk))
}

function sync_age_label(iso: string | null | undefined): string {
    if (!iso)
        return '—'
    return from_now_diff(lang, new Date(iso))
}

const contracts_tone = health_tone(contracts_health_pct)
const contracts_viability_tone = health_tone(contracts_viability_pct)
const sell_tone = health_tone(sell_orders_health_pct)
const sell_viability_tone = health_tone(sell_orders_viability_pct)

const contracts_on_target = contract_targets > 0
    ? on_target_parts(contract_fulfilled, contract_targets)
    : null
const contracts_viable = contract_targets > 0
    ? viable_fulfilled_parts(
        contract_viable_fulfilled ?? 0,
        contract_targets,
    )
    : null
const sell_on_target = sell_order_targets > 0
    ? on_target_parts(sell_order_fulfilled, sell_order_targets)
    : null
const sell_viable = sell_order_targets > 0
    ? viable_fulfilled_parts(
        sell_order_viable_fulfilled,
        sell_order_targets,
    )
    : null
---

<Flexblock gap="var(--space-xl)" class="[ market-health-content ]">
    <section class="[ market-health ]">
        <Grid
            class="[ market-health__split ]"
            min_item_width="280px"
            row_gap="var(--space-s)"
            column_gap="var(--space-s)"
        >
            <article class="[ market-health__card ]">
                <p class="[ market-health__card-label ]">{t('ops_health_contracts')}</p>
                <div class="[ market-health__dual ]">
                    <div
                        class:list={['market-health__metric', `market-health__metric--${contracts_tone}`]}
                    >
                        <p class="[ market-health__metric-label ]">{t('ops_health_coverage')}</p>
                        <p class="[ market-health__card-pct ]">{format_pct(contracts_health_pct)}</p>
                        <Progress
                            class:list={[
                                'market-health__bar',
                                {
                                    success: contracts_tone === 'good',
                                    danger: contracts_tone === 'bad',
                                    disabled: contracts_tone === 'none',
                                },
                            ]}
                            max="100"
                            value={contracts_health_pct != null ? Math.max(contracts_health_pct, 0.1) : 0.1}
                        />
                        <p class="[ market-health__card-meta ]">
                            {contracts_on_target ?
                                <>
                                    {contracts_on_target.before}
                                    <span
                                        class="[ market-health__term ]"
                                        data-tippy-content={t('ops_health_contracts_target_hint')}
                                    >{contracts_on_target.word}</span>
                                    {contracts_on_target.after}
                                </>
                                : t('ops_health_no_targets')
                            }
                        </p>
                    </div>
                    <div
                        class:list={['market-health__metric', `market-health__metric--${contracts_viability_tone}`]}
                    >
                        <p class="[ market-health__metric-label ]">{t('ops_health_viability')}</p>
                        <p class="[ market-health__card-pct ]">{format_pct(contracts_viability_pct)}</p>
                        <Progress
                            class:list={[
                                'market-health__bar',
                                {
                                    success: contracts_viability_tone === 'good',
                                    danger: contracts_viability_tone === 'bad',
                                    disabled: contracts_viability_tone === 'none',
                                },
                            ]}
                            max="100"
                            value={contracts_viability_pct != null ? Math.max(contracts_viability_pct, 0.1) : 0.1}
                        />
                        <p class="[ market-health__card-meta ]">
                            {contracts_viable ?
                                <>
                                    {contracts_viable.before}
                                    <span
                                        class="[ market-health__term ]"
                                        data-tippy-content={t('ops_health_contracts_viability_hint')}
                                    >{contracts_viable.word}</span>
                                    {contracts_viable.after}
                                </>
                                : t('ops_health_no_targets')
                            }
                        </p>
                    </div>
                </div>
                <p
                    class="[ market-health__card-meta market-health__sync-age ]"
                    title={contracts_synced_at || undefined}
                >
                    {t('ops_sync_age_contracts')
                        .replace('{age}', sync_age_label(contracts_synced_at))}
                </p>
                <p class="[ market-health__card-meta market-health__card-meta--isk ]">
                    {isk_label('ops_health_isk_in_contracts', contracts_isk)}
                </p>
                <FlexInline class="[ market-health__card-actions ]">
                    <Button href={contracts_href} size="sm">
                        {t('view_ops_contracts')}
                    </Button>
                </FlexInline>
            </article>

            <article class="[ market-health__card ]">
                <p class="[ market-health__card-label ]">{t('ops_health_sell_orders')}</p>
                <div class="[ market-health__dual ]">
                    <div
                        class:list={['market-health__metric', `market-health__metric--${sell_tone}`]}
                    >
                        <p class="[ market-health__metric-label ]">{t('ops_health_coverage')}</p>
                        <p class="[ market-health__card-pct ]">{format_pct(sell_orders_health_pct)}</p>
                        <Progress
                            class:list={[
                                'market-health__bar',
                                {
                                    success: sell_tone === 'good',
                                    danger: sell_tone === 'bad',
                                    disabled: sell_tone === 'none',
                                },
                            ]}
                            max="100"
                            value={sell_orders_health_pct != null ? Math.max(sell_orders_health_pct, 0.1) : 0.1}
                        />
                        <p class="[ market-health__card-meta ]">
                            {sell_on_target ?
                                <>
                                    {sell_on_target.before}
                                    <span
                                        class="[ market-health__term ]"
                                        data-tippy-content={t('ops_health_coverage_hint')}
                                    >{sell_on_target.word}</span>
                                    {sell_on_target.after}
                                </>
                                : t('ops_health_no_targets')
                            }
                        </p>
                    </div>
                    <div
                        class:list={['market-health__metric', `market-health__metric--${sell_viability_tone}`]}
                    >
                        <p class="[ market-health__metric-label ]">{t('ops_health_viability')}</p>
                        <p class="[ market-health__card-pct ]">{format_pct(sell_orders_viability_pct)}</p>
                        <Progress
                            class:list={[
                                'market-health__bar',
                                {
                                    success: sell_viability_tone === 'good',
                                    danger: sell_viability_tone === 'bad',
                                    disabled: sell_viability_tone === 'none',
                                },
                            ]}
                            max="100"
                            value={sell_orders_viability_pct != null ? Math.max(sell_orders_viability_pct, 0.1) : 0.1}
                        />
                        <p class="[ market-health__card-meta ]">
                            {sell_viable ?
                                <>
                                    {sell_viable.before}
                                    <span
                                        class="[ market-health__term ]"
                                        data-tippy-content={t('ops_health_viability_hint')}
                                    >{sell_viable.word}</span>
                                    {sell_viable.after}
                                </>
                                : t('ops_health_no_targets')
                            }
                        </p>
                    </div>
                </div>
                <p
                    class="[ market-health__card-meta market-health__sync-age ]"
                    title={orders_synced_at || undefined}
                >
                    {t('ops_sync_age_orders')
                        .replace('{age}', sync_age_label(orders_synced_at))}
                </p>
                <p class="[ market-health__card-meta market-health__card-meta--isk ]">
                    {isk_label('ops_health_isk_in_sell_orders', sell_orders_isk)}
                </p>
                <FlexInline class="[ market-health__card-actions ]">
                    <Button href={sell_orders_href} size="sm">
                        {t('view_ops_sell_orders')}
                    </Button>
                </FlexInline>
            </article>
        </Grid>
        <MarketHealthHistoryChart history={history} />
    </section>
</Flexblock>

<style lang="scss">
    .market-health {
        display: flex;
        flex-direction: column;
        gap: var(--space-s);
        padding: 0;
    }

    .market-health__card-label {
        margin: 0;
        font-size: var(--step--1);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--fleet-yellow);
    }

    .market-health__bar {
        --progress-height: var(--space-2xs);
        width: 100%;
        margin-block: var(--space-3xs);
    }

    .market-health__card-meta {
        margin: 0;
        color: rgba(255, 255, 255, 0.65);
        font-size: var(--step--1);
    }

    .market-health__sync-age {
        margin-block-start: auto;
        padding-block-start: var(--space-xs);
        font-size: var(--step--2);
        color: var(--fleet-yellow);
        opacity: 0.85;
    }

    .market-health__term {
        color: var(--highlight);
        cursor: help;
        border-bottom: 1px dotted color-mix(in srgb, var(--highlight) 55%, transparent);
    }

    .market-health__card-meta--isk {
        margin: 0;
        padding-block-start: var(--space-3xs);
        font-family: var(--heading-font);
        font-size: var(--step-0);
        letter-spacing: 0.02em;
        text-transform: uppercase;
        color: var(--highlight);
    }

    .market-health__card-actions {
        padding-block-start: var(--space-xs);
    }

    .market-health__card {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        padding: var(--space-m);
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(0, 0, 0, 0.22);
    }

    .market-health__card-pct {
        margin: 0;
        font-family: var(--heading-font);
        font-size: clamp(2.25rem, 5vw, 3.5rem);
        line-height: 0.95;
        letter-spacing: -0.02em;
        text-transform: uppercase;
        color: var(--highlight);
    }

    .market-health__dual {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-s);
    }

    .market-health__metric {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        min-width: 0;
    }

    .market-health__metric-label {
        margin: 0;
        font-size: var(--step--1);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.7);
    }

    .market-health__card--good .market-health__card-pct,
    .market-health__metric--good .market-health__card-pct {
        color: var(--green);
    }

    .market-health__card--warn .market-health__card-pct,
    .market-health__metric--warn .market-health__card-pct {
        color: var(--fleet-yellow);
    }

    .market-health__card--bad .market-health__card-pct,
    .market-health__metric--bad .market-health__card-pct {
        color: var(--fleet-red);
    }
</style>
