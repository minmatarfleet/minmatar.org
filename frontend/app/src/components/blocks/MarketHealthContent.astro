---
import { i18n } from '@helpers/i18n'
const { lang, t, translatePath } = i18n(Astro.url)

import type { ButtonColors } from '@dtypes/layout_components';
import type { MarketHealth, MarketHealthChartPoint } from '@dtypes/api.minmatar.org'
import { from_now_diff } from '@helpers/date'
import { format_isk } from '@helpers/numbers'
import { ops_redirect_path } from '@helpers/market_ops_redirect'

interface Props {
    health: MarketHealth
    history?: MarketHealthChartPoint[]
    location_id?: number
}

const { health, history = [] } = Astro.props
const contracts = health.contracts.latest
const sell_orders = health.sell_orders.latest

const contracts_synced_at = contracts?.synced_at ?? null
const orders_synced_at = sell_orders?.synced_at ?? null

const contracts_health_pct = contracts?.health_pct ?? null
const contracts_viability_pct = contracts?.viability_pct ?? null
const sell_orders_health_pct = sell_orders?.health_pct ?? null
const sell_orders_viability_pct = sell_orders?.viability_pct ?? null

const contract_targets = contracts?.targets ?? 0
const contract_fulfilled = contracts?.fulfilled ?? 0
const contract_viable_fulfilled = contracts?.viable_fulfilled ?? 0
const contract_listed = contracts?.listed_targets ?? 0
const sell_order_targets = sell_orders?.targets ?? 0
const sell_order_fulfilled = sell_orders?.fulfilled ?? 0
const sell_order_viable_fulfilled = sell_orders?.viable_fulfilled ?? 0
const sell_listed = sell_orders?.listed_targets ?? 0
const contracts_isk = contracts?.isk ?? 0
const sell_orders_isk = sell_orders?.isk ?? 0

const contracts_href = ops_redirect_path(translatePath, 'contracts')
const sell_orders_href = ops_redirect_path(translatePath, 'sell_orders')

function health_tone(pct: number | null | undefined): 'good' | 'warn' | 'bad' | 'none' {
    if (pct == null)
        return 'none'
    if (pct >= 80)
        return 'good'
    if (pct >= 40)
        return 'warn'
    return 'bad'
}

function progress_classes(tone: ReturnType<typeof health_tone>) {
    return {
        success: tone === 'good',
        warning: tone === 'warn',
        danger: tone === 'bad',
        disabled: tone === 'none',
    }
}

function format_pct(pct: number | null | undefined): string {
    if (pct == null)
        return '—'
    return `${pct % 1 === 0 ? pct.toFixed(0) : pct.toFixed(1)}%`
}

function term_parts(
    template_key: string,
    placeholder: string,
    word_key: string,
    fulfilled: number,
    targets: number,
): { before: string; word: string; after: string } {
    const word = t(word_key as any)
    const label = t(template_key as any)
        .replace('{fulfilled}', String(fulfilled))
        .replace('{targets}', String(targets))
    const [before, after = ''] = label.split(placeholder)
    return { before, word, after }
}

function on_target_parts(fulfilled: number, targets: number) {
    return term_parts(
        'ops_health_fulfilled',
        '{target}',
        'ops_health_target_word',
        fulfilled,
        targets,
    )
}

function listed_viable_parts(fulfilled: number, listed: number) {
    return term_parts(
        'ops_health_viable_fulfilled',
        '{viable}',
        'ops_health_viable_word',
        fulfilled,
        listed,
    )
}

function isk_label(template_key: string, isk: number): string {
    return (t(template_key as any)  ?? template_key).replace('{isk}', format_isk(isk))
}

function sync_age_label(iso: string | null | undefined): string {
    if (!iso)
        return '—'
    return from_now_diff(lang, new Date(iso))
}

function get_days_indexes(history:MarketHealthChartPoint[]) {
    let first_day_index:string | null = null
    let second_day_index:string | null = null

    if (history.length === 0)
        return {
            first_day_index: first_day_index,
            second_day_index: second_day_index,
        }

    const first_day = history[0].captured_at.split('T')[0]
    let second_day:string = ''

    for (let i in history) {
        if (!second_day && history[i].captured_at.startsWith(first_day))
            continue
        else if (!second_day)
            second_day = history[i].captured_at.split('T')[0]
        else if (second_day && history[i].captured_at.startsWith(second_day))
            second_day_index = i
        else
            break
    }

    return {
        first_day_index: 0,
        second_day_index: second_day_index,
    }
}

function get_deltas(history:MarketHealthChartPoint[]) {
    const indexes = get_days_indexes(history)

    if (indexes?.first_day_index === null || indexes?.second_day_index === null)
        return null

    return {
        contracts_coverage_delta: (history[indexes.first_day_index].contracts_health_pct ?? 0) - (history[indexes.second_day_index].contracts_health_pct ?? 0),
        contracts_viability_delta: (history[indexes.first_day_index].contracts_viability_pct ?? 0) - (history[indexes.second_day_index].contracts_viability_pct ?? 0),
        sell_orders_coverage_delta: (history[indexes.first_day_index].sell_orders_health_pct ?? 0) - (history[indexes.second_day_index].sell_orders_health_pct ?? 0),
        sell_orders_viability_delta: (history[indexes.first_day_index].sell_orders_viability_pct ?? 0) - (history[indexes.second_day_index].sell_orders_viability_pct ?? 0),
    } as {
        contracts_coverage_delta:           number;
        contracts_viability_delta:          number;
        sell_orders_coverage_delta:         number;
        sell_orders_viability_delta:        number;
    }
}

const contracts_tone = health_tone(contracts_health_pct)
const contracts_viability_tone = health_tone(contracts_viability_pct)
const sell_tone = health_tone(sell_orders_health_pct)
const sell_viability_tone = health_tone(sell_orders_viability_pct)
const deltas = get_deltas(history)

const TONE_TRANSLATION: Record<string, ButtonColors | "fleet-yellow"> = {
    good: 'green',
    warn: 'fleet-yellow',
    bad: 'fleet-red',
    none: 'fleet-red'
}

import { number_thousand_separator, number_name } from '@helpers/numbers'

import Flexblock from '@components/compositions/Flexblock.astro'
import Wrapper from '@components/compositions/Wrapper.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import Grid from '@components/compositions/Grid.astro'

import Button from '@components/blocks/Button.astro'
import ButtonViewHealthChartData from '@components/blocks/ButtonViewHealthChartData.astro'
import Progress from '@components/blocks/Progress.astro'
import MarketHealthChart from '@components/blocks/MarketHealthChart.astro'
import Tile from '@components/blocks/Tile.astro';
import MarketHealthPercentage from './MarketHealthPercentage.astro'

const contracts_on_target = contract_targets > 0
    ? on_target_parts(contract_fulfilled, contract_targets)
    : null
const contracts_viable = contract_listed > 0
    ? listed_viable_parts(contract_viable_fulfilled ?? 0, contract_listed)
    : null
const sell_on_target = sell_order_targets > 0
    ? on_target_parts(sell_order_fulfilled, sell_order_targets)
    : null
const sell_viable = sell_listed > 0
    ? listed_viable_parts(sell_order_viable_fulfilled, sell_listed)
    : null
---

<Grid
    class="[ w-full grid-fill ]"
    row_gap="var(--space-3xs)"
    column_gap="var(--space-3xs)"
    min_item_width="580px"
>
    <Flexblock class=" [ card component ][ border light-transparency ]" gap='0'>
        <Progress
            class:list={[
                'w-full ',
                {
                    success: contracts_tone === 'good',
                    warning: contracts_tone === 'warn',
                    danger: contracts_tone === 'bad',
                    disabled: contracts_tone === 'none',
                },
            ]}
            max="100"
            value={contracts_health_pct != null ? Math.max(contracts_health_pct, 0.1) : 0.1}
            data-tippy-content={t('coverage_percent').replace('{percent}', String(contracts_health_pct))}
            x-init="tippy($el, tippy_options)"
        />
        <Progress
            class:list={[
                'w-full ',
                {
                    success: contracts_viability_tone === 'good',
                    warning: contracts_viability_tone === 'warn',
                    danger: contracts_viability_tone === 'bad',
                    disabled: contracts_viability_tone === 'none',
                },
            ]}
            max="100"
            value={contracts_viability_pct != null ? Math.max(contracts_viability_pct, 0.1) : 0.1}
            data-tippy-content={t('viability_percent').replace('{percent}', String(contracts_viability_pct))}
            x-init="tippy($el, tippy_options)"
        />

        <Tile
            title={t('ops_health_contracts')}
            cover='/images/orders-tile-background.webp'
            transparent={true}
            gap='var(--space-3xs)'
        >
            <div class="[ chart-cover ]" slot="cover">
                <FlexInline justification='flex-end'>
                    <ButtonViewHealthChartData
                        history={history}
                        type='contracts'
                        coverage_tone={contracts_tone}
                        viability_tone={contracts_viability_tone}
                    />
                </FlexInline>
                <MarketHealthChart type='contracts' history={history} />
            </div>

            <small>
                {t('ops_sync_age_contracts')
                    .replace('{age}', sync_age_label(contracts_synced_at))}
            </small>
        </Tile>

        <Wrapper
            class="[ pb-(--component-padding-block)! grow ]"
            padding_inline='var(--component-padding-block)'
            padding_block='0'
            max_width='100%'
        >
            <Flexblock
                class="[ justify-between! h-full ]"
                gap='var(--space-xl)'
            >
                <Flexblock>
                    <FlexInline>
                        <Flexblock gap='0' class="[ basis-[300px] ]">
                            <MarketHealthPercentage
                                tone={TONE_TRANSLATION[contracts_tone]}
                                percentage={contracts_health_pct}
                                delta={deltas?.contracts_coverage_delta ?? null}
                            />
                            <span class="[ ml-(--space-m) ]">
                                {contracts_on_target ?
                                    <>
                                        {contracts_on_target.before}
                                        <span
                                            data-tippy-content={t('ops_health_contracts_target_hint')}
                                            x-init="tippy($el, tippy_options)"
                                        >{contracts_on_target.word}</span>
                                        {contracts_on_target.after}
                                    </>
                                    : t('ops_health_no_targets')
                                }
                            </span>
                        </Flexblock>

                        <Flexblock gap='0' class="[ basis-[300px] ]">
                            <MarketHealthPercentage
                                tone={TONE_TRANSLATION[contracts_viability_tone]}
                                percentage={contracts_viability_pct}
                                delta={deltas?.contracts_viability_delta ?? null}
                            />
                            <span class="[ ml-(--space-m) ]">{contracts_viable ?
                                <>
                                    {contracts_viable.before}
                                    <span
                                        data-tippy-content={t('ops_health_contracts_viability_hint')}
                                        x-init="tippy($el, tippy_options)"
                                    >{contracts_viable.word}</span>
                                    {contracts_viable.after}
                                </>
                                :
                                contract_targets > 0
                                    ? t('ops_health_no_listed')
                                    : t('ops_health_no_targets')
                            }
                            </span>
                        </Flexblock>
                    </FlexInline>

                    <Flexblock gap='var(--space-3xs)' class="[ pl-(--space-m) ]">
                        <span
                            class="[ market-total text-step-1 w-fit ]"
                            data-tippy-content={number_name(contracts_isk, lang)}
                            x-init="tippy($el, tippy_options)"
                        >{number_thousand_separator(contracts_isk)}</span>
                        <span>{t('isk_listed')}</span>
                    </Flexblock>
                </Flexblock>

                <FlexInline>
                    <Button href={contracts_href}>
                        {t('view_ops_contracts')}
                    </Button>
                </FlexInline>
            </Flexblock>
        </Wrapper>
    </Flexblock>
    
    <Flexblock class=" [ card component ][ border light-transparency ]" gap='0'>
        <Progress
            class:list={[
                'w-full ',
                {
                    success: sell_tone === 'good',
                    warning: sell_tone === 'warn',
                    danger: sell_tone === 'bad',
                    disabled: sell_tone === 'none',
                },
            ]}
            max="100"
            value={sell_orders_health_pct != null ? Math.max(sell_orders_health_pct, 0.1) : 0.1}
            data-tippy-content={t('coverage_percent').replace('{percent}', String(sell_orders_health_pct))}
            x-init="tippy($el, tippy_options)"
        />
        <Progress
            class:list={[
                'w-full ',
                {
                    success: sell_viability_tone === 'good',
                    warning: sell_viability_tone === 'warn',
                    danger: sell_viability_tone === 'bad',
                    disabled: sell_viability_tone === 'none',
                },
            ]}
            max="100"
            value={sell_orders_viability_pct != null ? Math.max(sell_orders_viability_pct, 0.1) : 0.1}
            data-tippy-content={t('viability_percent').replace('{percent}', String(sell_orders_viability_pct))}
            x-init="tippy($el, tippy_options)"
        />

        <Tile
            title={t('ops_health_sell_orders')}
            cover='/images/orders-tile-background.webp'
            transparent={true}
            gap='var(--space-3xs)'
        >
            <div class="[ chart-cover ]" slot="cover">
                <FlexInline justification='flex-end'>
                    <ButtonViewHealthChartData
                        history={history}
                        type='sell orders'
                        coverage_tone={sell_tone}
                        viability_tone={sell_viability_tone}
                    />
                </FlexInline>
                <MarketHealthChart type='sell orders' history={history} />
            </div>
            
            <small>
                {t('ops_sync_age_orders')
                    .replace('{age}', sync_age_label(orders_synced_at))}
            </small>
        </Tile>

        <Wrapper
            class="[ pb-(--component-padding-block)! grow ]"
            padding_inline='var(--component-padding-block)'
            padding_block='0'
            max_width='100%'
        >
            <Flexblock
                class="[ justify-between! h-full ]"
                gap='var(--space-xl)'
            >
                <Flexblock>
                    <FlexInline>
                        <Flexblock gap='0' class="[ basis-[300px] ]">
                            <MarketHealthPercentage
                                tone={TONE_TRANSLATION[sell_tone]}
                                percentage={sell_orders_health_pct}
                                delta={deltas?.sell_orders_coverage_delta ?? null}
                            />
                            <span class="[ ml-(--space-m) ]">{sell_on_target ?
                                <>
                                    {sell_on_target.before}
                                    <span
                                        data-tippy-content={t('ops_health_coverage_hint')}
                                        x-init="tippy($el, tippy_options)"
                                    >{sell_on_target.word}</span>
                                    {sell_on_target.after}
                                </>
                                : t('ops_health_no_targets')
                            }
                            </span>
                        </Flexblock>

                        <Flexblock gap='0' class="[ basis-[300px] ]">
                            <MarketHealthPercentage
                                tone={TONE_TRANSLATION[sell_viability_tone]}
                                percentage={sell_orders_viability_pct}
                                delta={deltas?.sell_orders_viability_delta ?? null}
                            />
                            <span class="[ ml-(--space-m) ]">{sell_viable ?
                                <>
                                    {sell_viable.before}
                                    <span
                                        data-tippy-content={t('ops_health_viability_hint')}
                                        x-init="tippy($el, tippy_options)"
                                    >{sell_viable.word}</span>
                                    {sell_viable.after}
                                </>
                                :
                                sell_order_targets > 0
                                    ? t('ops_health_no_listed')
                                    : t('ops_health_no_targets')
                            }</span>
                        </Flexblock>
                    </FlexInline>

                    <Flexblock gap='var(--space-3xs)' class="[ pl-(--space-m) ]">
                        <span
                            class="[ market-total text-step-1 w-fit ]"
                            data-tippy-content={number_name(sell_orders_isk, lang)}
                            x-init="tippy($el, tippy_options)"
                        >{number_thousand_separator(sell_orders_isk)}</span>
                        <span>{t('isk_listed')}</span>
                    </Flexblock>
                </Flexblock>

                <FlexInline>
                    <Button href={sell_orders_href}>
                        {t('view_ops_sell_orders')}
                    </Button>
                </FlexInline>
            </Flexblock>
        </Wrapper>
    </Flexblock>
</Grid>

<style lang="scss">
    .market-overlay {
        &:after {
            content: ' ';
            position: absolute;
            inset: 0;
            z-index: -1;
        }

        &.market-overlay-green:after {
            background-image: linear-gradient(
                to top,
                hsla(152, 69%, 31%, 0) 80%,
                hsla(152, 69%, 31%, 0.554) 100%
            );
        }

        &.market-overlay-fleet-red:after {
            background-image: linear-gradient(
                to top,
                hsla(9, 70%, 42%, 0) 30%,
                hsla(9, 70%, 42%, 0.7) 100%
            );
        }
    }

    .market-total {
        font-family: var(--heading-font);
        color: var(--highlight);
    }

    .chart-cover {
        object-fit: contain;
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        width: 100%;
        z-index: 20;
    }
</style>