---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)
import { external_link_attributes } from '@helpers/external_link'

interface Props {
    href:               string;
    [propName: string]: any;
}

const {
    href,
    ...attributes
} = Astro.props

const external_link = external_link_attributes({
    href,
    title: t('leaving_website'),
    partial: translatePath('/partials/external_link_disclaimer_dialog/'),
})
---

<a
    href={href}
    target="_blank"
    rel="nofollow noopener noreferrer"
    x-data={external_link.x_data}
    x-on:click.prevent={external_link.x_on_click_prevent}
    {...attributes}
>
    <slot />
</a>