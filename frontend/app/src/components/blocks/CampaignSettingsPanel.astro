---
/**
 * The campaign page's Settings tab (managers only), on the settings
 * standard (SettingsLayout): the sections grouped on the left, one part of
 * `campaign_settings_component` on the right. `?section=<part>` opens a
 * part; the list flags parts that need doing from the campaign the page
 * already loaded.
 */
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { CampaignDetail, CampaignWeek } from '@dtypes/api.minmatar.org'
import { query_string } from '@helpers/string'

interface Props {
    campaign:               CampaignDetail;
    week:                   CampaignWeek | null;
    has_structures_tab:     boolean;
    can_coordinate?:        boolean;
    [propName: string]: any;
}

const {
    campaign,
    week,
    has_structures_tab,
    can_coordinate = false,
    ...attributes
} = Astro.props

delete attributes.class

const part_url = (part: string) => translatePath(`/partials/campaign_settings_component/?${query_string({
    slug: campaign.slug,
    part,
    ...(has_structures_tab ? { tab: '1' } : {}),
})}`)

const section_href = (part: string) => `?section=${part}#settings`
const item = (part: string, label: string, extra: Partial<SettingsNavItem> = {}): SettingsNavItem =>
    ({ id: part, label, href: section_href(part), url: part_url(part), ...extra })

const features = campaign.features
const none_yet = t('campaigns.manage.none_yet')
const proposed = (week?.targets ?? []).filter((row) => row.proposed).length

const groups: SettingsNavGroup[] = [
    {
        label: t('campaigns.settings.group_campaign'),
        items: [
            item('basics', t('campaigns.settings.general')),
            item('features', t('campaigns.manage.features')),
        ],
    },
    {
        label: t('campaigns.settings.group_theater'),
        items: [
            ...(features.theater ? [item('systems', t('campaigns.manage.systems'))] : []),
            item('sides', t('campaigns.manage.sides'), { flag: (campaign.parties ?? []).length === 0 ? none_yet : undefined }),
            ...(features.structures ? [item('structures', t('campaigns.manage.structures'))] : []),
        ],
    },
    {
        label: t('campaigns.settings.group_people'),
        items: [
            item('coordinators', t('campaigns.coordinators.title')),
            item('fittings', t('campaigns.settings.doctrines'), { flag: (campaign.fittings ?? []).length === 0 ? none_yet : undefined }),
        ],
    },
    ...(features.weekly_progress ? [{
        label: t('campaigns.settings.group_week'),
        items: [
            item('targets', t('campaigns.manage.targets'), { count: proposed }),
            item('order', t('campaigns.settings.order'), {
                flag: !campaign.commander_order_text
                    ? none_yet
                    : campaign.commander_order_is_draft ? t('campaigns.settings.order_draft') : undefined,
            }),
        ],
    }] : []),
    ...(can_coordinate ? [{
        label: t('campaigns.settings.group_connections'),
        items: [item('coordination', t('campaigns.settings.discord'))],
    }] : []),
]

import SettingsLayout from '@components/blocks/SettingsLayout.astro'
import type { SettingsNavGroup, SettingsNavItem } from '@components/blocks/SettingsLayout.astro'
---

<SettingsLayout
    id="campaign-settings"
    aria_label={t('campaigns.settings.nav_label')}
    active={Astro.url.searchParams.get('section') ?? 'basics'}
    groups={groups}
    class:list={['[ campaign-settings-panel ]', Astro.props.class]}
    {...attributes}
/>
