---
/**
 * The Timers tab of /intel/timers/manage/: Upcoming and Past 7 days chips,
 * a search across system, structure and owner, and a table whose rows open
 * in place to correct or delete a timer. structure_timers_manage_component
 * renders it again for every chip, search and page.
 */
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { StructureTimer } from '@dtypes/api.minmatar.org'
import type { ManageColumn } from '@dtypes/layout_components'
import type { TimerView } from '@helpers/manage_intel'
import { sort_timers, timer_in_view, timer_matches } from '@helpers/manage_intel'
import { query_string } from '@helpers/string'

interface Props {
    timers:             StructureTimer[];
    view?:              TimerView;
    query?:             string;
    page?:              number;
    [propName: string]: any;
}

const { timers, view = 'upcoming', query = '', page = 1 } = Astro.props

const PAGE_SIZE = 50
const now = new Date()
const list_url = (values: Record<string, string> = {}) =>
    translatePath(`/partials/structure_timers_manage_component/?${query_string({ part: 'list', ...values })}`)

const searched = timers.filter((timer) => timer_matches(timer, query))
const upcoming = searched.filter((timer) => timer_in_view(timer, 'upcoming', now))
const past = searched.filter((timer) => timer_in_view(timer, 'past', now))
const rows = sort_timers(view === 'past' ? past : upcoming, view)
const total_pages = Math.max(1, Math.ceil(rows.length / PAGE_SIZE))
const current_page = Math.min(Math.max(1, page), total_pages)
const page_rows = rows.slice((current_page - 1) * PAGE_SIZE, current_page * PAGE_SIZE)

const COLUMNS: ManageColumn[] = [
    { label: t('manage.timers.col_structure') },
    { label: t('manage.timers.col_owner'), phone: false },
    { label: t('manage.timers.col_state'), phone: false },
    { label: t('manage.timers.col_timer'), align: 'num', phone: false, sort: view === 'past' ? 'descending' : 'ascending' },
]

const empty_title = query ? t('manage.timers.empty_search') :
    view === 'past' ? t('manage.timers.empty_past') : t('manage.timers.empty_upcoming')

import EmptyState from '@components/blocks/EmptyState.astro'
import HtmxPager from '@components/blocks/HtmxPager.astro'
import ViewChips from '@components/blocks/manage/ViewChips.astro'
import ManageSearch from '@components/blocks/manage/ManageSearch.astro'
import ManageTable from '@components/blocks/manage/ManageTable.astro'
import StructureTimerRow from '@components/blocks/manage_intel/StructureTimerRow.astro'
---

<div class="[ manage-list ]" id="timers-list-root">
    <ViewChips
        id="timers-filters"
        url={list_url()}
        target="timers-list"
        selected={view}
        search_id="timers-search"
        legend={t('manage.timers.views')}
        views={[
            { value: 'upcoming', label: t('manage.timers.upcoming'), count: upcoming.length },
            { value: 'past', label: t('manage.timers.past_week'), count: past.length },
        ]}
    >
        <div class="[ manage-toolbar ]">
            <ManageSearch
                id="timers-search"
                value={query}
                label={t('manage.timers.search')}
                placeholder={t('manage.timers.search_placeholder')}
            />
        </div>
    </ViewChips>
    <div id="timers-list" class="[ manage-list ]" aria-live="polite">
        {page_rows.length === 0 ?
            <EmptyState title={empty_title} />
            :
            <ManageTable caption={t('manage.timers.caption')} columns={COLUMNS}>
                {page_rows.map((timer) => <StructureTimerRow timer={timer} colspan={COLUMNS.length + 1} />)}
            </ManageTable>
        }
        {total_pages > 1 && <HtmxPager
            page={current_page}
            total_pages={total_pages}
            url_for={(to) => list_url({ page: String(to) })}
            request={{ 'hx-target': '#timers-list', 'hx-select': '#timers-list', 'hx-swap': 'outerHTML', 'hx-include': '#timers-filters' }}
        />}
    </div>
</div>
