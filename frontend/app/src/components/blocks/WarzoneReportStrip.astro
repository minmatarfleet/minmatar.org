---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import { getWarzoneReports } from '@/data/campaigns'
import ReportStrip from '@components/blocks/ReportStrip.astro'
---

<ReportStrip
    reports={getWarzoneReports()}
    title={t('warzone.reports.section_title')}
    leading_text={t('warzone.reports.section_leading_text')}
    anchor_id="WarzoneReports"
    swiper_id="warzone-reports-reel-swiper"
    show_isk={true}
/>
