---
import { i18n } from '@helpers/i18n'
const { lang, t, translatePath } = i18n(Astro.url)

import type { CampaignMeta } from '@/data/campaigns'
import type { TagColors } from '@dtypes/layout_components'

interface Props {
    campaign: CampaignMeta;
}

const {
    campaign,
} = Astro.props

const href = translatePath(campaign.path)
const name = t(campaign.nameKey as any)
const period = t(campaign.periodKey as any)
const view_label = t('campaigns.view_report')

let kind_label: string
let kind_color: TagColors
switch (campaign.kind) {
    case 'siege':
        kind_label = t('content.kind.siege')
        kind_color = 'fleet-red'
        break
    case 'campaign':
        kind_label = t('content.kind.campaign')
        kind_color = 'fleet-yellow'
        break
    case 'warzone':
        kind_label = t('content.kind.warzone')
        kind_color = 'alliance-blue'
        break
    default: {
        const _exhaustive: never = campaign.kind
        throw new Error(`Unhandled campaign kind: ${_exhaustive}`)
    }
}

import { number_thousand_separator, number_name } from '@helpers/numbers'

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'

import PictureCard from '@components/blocks/PictureCard.astro'
import Button from '@components/blocks/Button.astro'
import Tag from '@components/blocks/Tag.astro'
---

<PictureCard
    class="[ campaign-post-card ]"
    src={campaign.coverImage}
    alt={name}
    narrow={true}
    thumbnail={true}
>
    <Tag
        slot="header"
        text={kind_label}
        color={kind_color}
    />

    <Flexblock gap='var(--space-2xs)'>
        <small>{period}</small>
        <a href={href}>
            <h3>{name}</h3>
        </a>
        <Flexblock gap='0'>
            <small>{t('destroyed')}</small>
            <p
                class="[ isk-stat ]"
                data-tippy-content={number_name(campaign.iskDestroyed, lang)}
            >
                {number_thousand_separator(campaign.iskDestroyed)}&nbsp;ISK
            </p>
        </Flexblock>
        <FlexInline>
            <Button href={href} size='sm'>
                {view_label}
            </Button>
        </FlexInline>
    </Flexblock>
</PictureCard>

<style lang="scss">
    h3 {
        font-size: var(--step-1);
        font-family: var(--heading-font);
        line-height: 1.15;
    }

    .isk-stat {
        font-size: var(--step-0);
        font-weight: 600;
        color: var(--highlight);
        margin: 0;
    }

    :global(.campaign-post-card) {
        position: relative;

        &::after {
            content: '';
            position: absolute;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            background: linear-gradient(
                to top,
                rgb(0 0 0 / 88%) 0%,
                rgb(0 0 0 / 55%) 42%,
                rgb(0 0 0 / 25%) 68%,
                rgb(0 0 0 / 12%) 100%
            );
        }

        :global(.card-body),
        :global(.card-header),
        :global(.card-actions),
        :global(.visible-actions) {
            z-index: 2;
        }
    }
</style>
