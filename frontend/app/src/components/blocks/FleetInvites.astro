---
import { i18n } from '@helpers/i18n'
const { t, translatePath, lang } = i18n(Astro.url)

import type { FleetInvites, FleetInvitePilot } from '@helpers/api.minmatar.org/fleets'
import { query_string } from '@helpers/string'
import { eve_clock, eve_day_short } from '@helpers/date'

/**
 * A private fleet's Invites tab, for its FC and Strategic FCs: totals,
 * progress against the ship targets, the New wave form and every wave's
 * answers. The leak trace column shows only to Strategic FCs.
 * Rendered and refreshed by partials/fleet_invites_component.
 * See docs/fleets/private-fleets.md.
 */
interface Props {
    fleet_id:       number;
    data:           FleetInvites;
    notice?:        string | false;
    error?:         string | false;
}

const {
    fleet_id,
    data,
    notice = false,
    error = false,
} = Astro.props

const PARTIAL_URL = `${translatePath('/partials/fleet_invites_component')}?${query_string({ fleet_id })}`
const CANDIDATES_URL = `${translatePath('/partials/fleet_invite_candidates_component')}?${query_string({ fleet_id })}`
const RESOLVE_URL = `${translatePath('/partials/fleet_invite_resolve_component')}?${query_string({ fleet_id })}`

const when = (value:string | null | undefined) =>
    value ? `${eve_day_short(lang, value, { weekday: true })} ${eve_clock(value)}` : ''

const totals = data.totals
const pending_delivered = data.invites.filter(invite => invite.answer === 'pending' && invite.dm_delivered).length
const reping_at = data.reping_available_at ? new Date(data.reping_available_at) : null
const reping_waiting = Boolean(reping_at && reping_at > new Date())
const sending_wave = data.waves.find(wave => !wave.finished_at)
const next_wave = (data.waves.at(-1)?.number ?? 0) + 1
const waves = [...data.waves].reverse()
const invites_by_wave = (number:number) => data.invites.filter(invite => invite.wave === number)

const answer_label = (invite:FleetInvitePilot) =>
    invite.answer === 'in' ? t('fleets.private.answer_in') :
    invite.answer === 'out' ? t('fleets.private.answer_out') :
    t('fleets.private.answer_pending')

const dm_label = (invite:FleetInvitePilot) =>
    invite.dm_delivered === true ? t('fleets.private.dm_delivered') :
    invite.dm_delivered === false ? t('fleets.private.dm_failed') :
    t('fleets.private.dm_queued')

const fleet_link = new URL(translatePath(`/fleets/upcoming/${fleet_id}`), Astro.url).toString()

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import XFadeScroll from '@components/compositions/XFadeScroll.astro'

import Button from '@components/blocks/Button.astro'
import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import EmptyState from '@components/blocks/EmptyState.astro'
import Input from '@components/blocks/Input.astro'
import Tag from '@components/blocks/Tag.astro'
import Textarea from '@components/blocks/Textarea.astro'
---

<div
    id="fleet-invites"
    class="[ fleet-invites ]"
    hx-get={sending_wave ? PARTIAL_URL : undefined}
    hx-trigger={sending_wave ? 'every 5s' : undefined}
    hx-swap="outerHTML"
    x-data="{ wave_open: false }"
>
    <Flexblock gap="var(--space-m)">
        <section class="[ fleet-invites__totals ]" aria-label={t('fleets.tabs.invites')}>
            <FlexInline justification="space-between" gap="var(--space-s)" class="[ items-start ]">
                <dl class="[ fleet-invites__stats ]">
                    <div>
                        <dt>{t('fleets.private.invited')}</dt>
                        <dd>{totals.invited}</dd>
                    </div>
                    <div class="[ is-in ]">
                        <dt>{t('fleets.private.in').replace('{count}', totals.characters_in.toString())}</dt>
                        <dd>{totals.answered_in}</dd>
                    </div>
                    <div class="[ is-out ]">
                        <dt>{t('fleets.private.out')}</dt>
                        <dd>{totals.answered_out}</dd>
                    </div>
                    <div class="[ is-pending ]">
                        <dt>{t('fleets.private.pending')}</dt>
                        <dd>{totals.pending}</dd>
                    </div>
                </dl>
                <FlexInline gap="var(--space-2xs)" class="[ fleet-invites__actions ]">
                    {reping_waiting ?
                        <small class="[ text-muted ]">{t('fleets.private.reping_wait').replace('{time}', `${eve_clock(reping_at!)} EVE`)}</small> :
                        pending_delivered > 0 &&
                            <Button
                                type="button"
                                size="sm"
                                color="transparent"
                                hx-post={`${PARTIAL_URL}&action=reping`}
                                hx-target="#fleet-invites"
                                hx-swap="outerHTML"
                                hx-disabled-elt="this"
                            >
                                {t('fleets.private.reping').replace('{count}', pending_delivered.toString())}
                            </Button>
                    }
                    <Button
                        type="button"
                        size="sm"
                        disabled={Boolean(sending_wave)}
                        x-on:click="wave_open = !wave_open"
                        x-bind:aria-expanded="wave_open"
                        aria-controls="fleet-wave-form"
                    >
                        {t('fleets.private.new_wave')}
                    </Button>
                </FlexInline>
            </FlexInline>
            {notice && <small role="status">{notice}</small>}
            {error && <small class="[ fleet-invites__error ]" role="alert">{error}</small>}
        </section>

        {sending_wave &&
            <p class="[ fleet-invites__sending ]" role="status">
                {t('fleets.private.sending')
                    .replace('{number}', sending_wave.number.toString())
                    .replace('{sent}', sending_wave.sent.toString())
                    .replace('{total}', sending_wave.invited.toString())}
            </p>
        }

        {data.targets.length > 0 &&
            <section class="[ fleet-invites__targets-block ]" aria-labelledby="fleet-invites-targets">
                <header>
                    <h2 id="fleet-invites-targets">{t('fleets.private.against_targets')}</h2>
                    <small>{t('fleets.private.against_targets_hint')}</small>
                    <a href="#ships">{t('fleets.private.edit_targets')}</a>
                </header>
                <ul class="[ fleet-invites__targets ]">
                    {data.targets.map(target =>
                        <li>
                            <span class="[ fleet-invites__target-head ]">
                                <b>{target.name}</b>
                                <span><b>{target.have}</b> / {target.target}</span>
                            </span>
                            <span class="[ fleet-invites__bar ]" role="img" aria-label={`${target.have} / ${target.target}`}>
                                <span style={`width: ${Math.min(100, Math.round(100 * target.have / Math.max(target.target, 1)))}%`}></span>
                            </span>
                            {target.short > 0 && <small class="[ is-pending ]">{t('fleets.private.short').replace('{count}', target.short.toString())}</small>}
                        </li>
                    )}
                </ul>
            </section>
        }

        <ComponentBlock
            id="fleet-wave-form"
            width="narrow"
            x-show="wave_open"
            x-cloak
            x-data={`{
                picks: [],
                add_mode: 'search',
                paste_text: '',
            }`}
        >
            <form
                class="[ fleet-invites__wave-form ]"
                hx-post={`${PARTIAL_URL}&action=wave`}
                hx-target="#fleet-invites"
                hx-swap="outerHTML"
                x-on:pick-candidate="if (!picks.some(p => p.kind === $event.detail.kind && p.id === $event.detail.id)) { picks.push($event.detail); $nextTick(() => htmx.trigger($refs.preview, 'refresh')) }"
            >
                <Flexblock gap="var(--space-m)">
                    <h2>{t('fleets.private.wave_form_title').replace('{number}', next_wave.toString())}</h2>

                    <FlexInline gap="var(--space-2xs)" role="group" aria-label={t('fleets.private.wave_search')}>
                        <Button
                            type="button"
                            size="sm"
                            color="transparent"
                            x-on:click="add_mode = 'search'"
                            x-bind:aria-pressed="add_mode === 'search'"
                            x-bind:class="{ 'is-active': add_mode === 'search' }"
                        >
                            {t('fleets.private.wave_search_mode')}
                        </Button>
                        <Button
                            type="button"
                            size="sm"
                            color="transparent"
                            x-on:click="add_mode = 'paste'"
                            x-bind:aria-pressed="add_mode === 'paste'"
                            x-bind:class="{ 'is-active': add_mode === 'paste' }"
                        >
                            {t('fleets.private.wave_paste_mode')}
                        </Button>
                    </FlexInline>

                    <Flexblock gap="var(--space-2xs)" x-show="add_mode === 'search'">
                        <label for={`fleet-wave-search-${fleet_id}`}>
                            <b>{t('fleets.private.wave_search')}</b>
                        </label>
                        <Input
                            id={`fleet-wave-search-${fleet_id}`}
                            type="search"
                            name="q"
                            autocomplete="off"
                            placeholder={t('fleets.private.wave_search_placeholder')}
                            hx-get={CANDIDATES_URL}
                            hx-trigger="input changed delay:300ms, search"
                            hx-target="next .fleet-invites__results"
                            hx-swap="innerHTML"
                            hx-include="this"
                        />
                        <div class="[ fleet-invites__results ]" aria-live="polite"></div>
                    </Flexblock>

                    <Flexblock gap="var(--space-2xs)" x-show="add_mode === 'paste'" x-cloak>
                        <label for={`fleet-wave-paste-${fleet_id}`}>
                            <b>{t('fleets.private.wave_paste')}</b>
                        </label>
                        <Textarea
                            id={`fleet-wave-paste-${fleet_id}`}
                            name="names"
                            rows="6"
                            placeholder={t('fleets.private.wave_paste_placeholder')}
                            x-model="paste_text"
                        />
                        <FlexInline justification="flex-end" gap="var(--space-2xs)">
                            <Button
                                type="button"
                                size="sm"
                                disabled
                                off_disable={true}
                                x-bind:disabled="!paste_text.trim()"
                                hx-post={RESOLVE_URL}
                                hx-target="next .fleet-invites__resolve"
                                hx-swap="innerHTML"
                                hx-include={`#fleet-wave-paste-${fleet_id}`}
                                hx-disabled-elt="this"
                            >
                                {t('fleets.private.wave_paste_add')}
                            </Button>
                        </FlexInline>
                        <div class="[ fleet-invites__resolve ]" aria-live="polite"></div>
                    </Flexblock>

                    <div class="[ fleet-invites__picks ]" x-show="picks.length > 0">
                        <b>{t('fleets.private.wave_picks')}</b>
                        <ul>
                            <template x-for="(pick, index) in picks" x-bind:key="pick.kind + pick.id">
                                <li class="[ fleet-invites__chip ]">
                                    <span x-text="pick.name"></span>
                                    <input type="hidden" x-bind:name="pick.kind + '_ids'" x-bind:value="pick.id" />
                                    <button
                                        type="button"
                                        x-on:click="picks.splice(index, 1); $nextTick(() => htmx.trigger($refs.preview, 'refresh'))"
                                        x-bind:aria-label="'Remove ' + pick.name"
                                    >×</button>
                                </li>
                            </template>
                        </ul>
                    </div>

                    <div
                        x-ref="preview"
                        class="[ fleet-invites__preview ]"
                        hx-post={`${PARTIAL_URL}&action=preview`}
                        hx-trigger="refresh"
                        hx-include="closest form"
                        hx-target="this"
                        hx-swap="innerHTML"
                    >
                        <small>{t('fleets.private.wave_pick_first')}</small>
                    </div>

                    <Flexblock gap="var(--space-2xs)">
                        <label for={`fleet-wave-note-${fleet_id}`}>
                            <b>{t('fleets.private.wave_note')}</b>
                        </label>
                        <Textarea
                            id={`fleet-wave-note-${fleet_id}`}
                            name="note"
                            rows="2"
                            maxlength="300"
                        />
                    </Flexblock>

                    <p class="[ fleet-invites__opsec ]">
                        {t('fleets.private.wave_opsec')} <b>{t('fleets.private.opsec')}</b>
                    </p>
                </Flexblock>
            </form>
        </ComponentBlock>

        {waves.length === 0 ?
            <EmptyState title={t('fleets.private.no_waves')} hint={t('fleets.private.no_waves_hint')} /> :
            waves.map((wave, index) =>
                <details class="[ fleet-invites__wave ]" open={index === 0}>
                    <summary>
                        <FlexInline gap="var(--space-2xs)" class="[ fleet-invites__wave-summary ]">
                            <h2>{t('fleets.private.wave_title').replace('{number}', wave.number.toString())}</h2>
                            {wave.labels.map(label => <Tag text={label} variant="outline" />)}
                            <small class="[ text-muted ]">
                                {t('fleets.private.wave_sent')
                                    .replace('{time}', `${when(wave.created_at)} EVE`)
                                    .replace('{by}', wave.sent_by ?? '')
                                    .replace('{count}', wave.invited.toString())}
                            </small>
                            <small class="[ fleet-invites__wave-counts text-muted ]">
                                {t('fleets.private.wave_counts')
                                    .replace('{in}', wave.answered_in.toString())
                                    .replace('{out}', wave.answered_out.toString())
                                    .replace('{pending}', wave.pending.toString())}
                            </small>
                        </FlexInline>
                    </summary>
                    <Flexblock gap="var(--space-s)">
                        {wave.note && <blockquote class="[ fleet-invites__note ]">{wave.note}</blockquote>}
                        <XFadeScroll>
                            <table class="[ fleet-invites__table ]">
                                <thead>
                                    <tr>
                                        <th scope="col">{t('fleets.private.col_pilot')}</th>
                                        <th scope="col">{t('fleets.private.col_answer')}</th>
                                        <th scope="col">{t('fleets.private.col_bringing')}</th>
                                        <th scope="col" class="[ is-number ]">{t('fleets.private.col_answered')}</th>
                                        {data.can_see_leak_trace && <th scope="col" class="[ is-number ]">{t('fleets.private.col_opened')}</th>}
                                        <th scope="col">{t('fleets.private.col_dm')}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {invites_by_wave(wave.number).map(invite =>
                                        <tr>
                                            <td>
                                                <b>{invite.character_name}</b>
                                                {invite.corporation_name && <small>{invite.corporation_name}</small>}
                                            </td>
                                            <td class:list={[`is-${invite.answer}`]}>{answer_label(invite)}</td>
                                            <td>{invite.ships.join(' · ')}</td>
                                            <td class="[ is-number ]">{when(invite.answered_at)}</td>
                                            {data.can_see_leak_trace &&
                                                <td class="[ is-number ]">{invite.first_viewed_at ? when(invite.first_viewed_at) : t('fleets.private.not_opened')}</td>
                                            }
                                            <td>
                                                <span class:list={[{ 'is-pending': invite.dm_delivered === false }]}>{dm_label(invite)}</span>
                                                {invite.dm_delivered === false &&
                                                    <button
                                                        type="button"
                                                        class="[ fleet-invites__copy ]"
                                                        x-on:click={`navigator.clipboard.writeText(${JSON.stringify(fleet_link)})`}
                                                    >
                                                        {t('fleets.private.copy_link')}
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    )}
                                </tbody>
                            </table>
                        </XFadeScroll>
                        {data.can_see_leak_trace && <small class="[ text-muted ]">{t('fleets.private.leak_trace_hint')}</small>}
                    </Flexblock>
                </details>
            )
        }
    </Flexblock>
</div>

<style lang="scss">
    .fleet-invites {
        max-width: var(--max-col-width);
    }

    .fleet-invites__stats {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-s) var(--space-l);

        > div {
            display: flex;
            flex-direction: column-reverse;
        }

        dd {
            font-family: var(--heading-font);
            font-size: var(--step-3);
            line-height: 1;
            color: var(--highlight);
        }

        dt {
            color: var(--text-muted);
            font-size: var(--step--1);
        }

        .is-in dd { color: var(--green); }
        .is-out dd { color: var(--text-muted); }
        .is-pending dd { color: var(--fleet-yellow); }
    }

    .fleet-invites__actions {
        flex-shrink: 0;
    }

    .fleet-invites__error {
        color: var(--fleet-red);
    }

    .fleet-invites__sending {
        color: var(--alliance-blue);
    }

    .fleet-invites__targets-block {
        display: flex;
        flex-direction: column;
        gap: var(--space-s);

        header {
            display: flex;
            flex-wrap: wrap;
            align-items: baseline;
            gap: var(--space-3xs) var(--space-s);

            a {
                margin-left: auto;
            }
        }

        h2 {
            font-size: var(--step-1);
        }
    }

    .fleet-invites__targets {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
        gap: var(--space-s) var(--space-m);
        list-style: none;
        padding: 0;
        margin: 0;

        li {
            display: flex;
            flex-direction: column;
            gap: var(--space-3xs);
        }
    }

    .fleet-invites__target-head {
        display: flex;
        justify-content: space-between;
        gap: var(--space-2xs);
        font-variant-numeric: tabular-nums;
    }

    .fleet-invites__bar {
        display: block;
        height: var(--space-3xs);
        background-color: var(--hairline-medium);

        span {
            display: block;
            height: 100%;
            background-color: var(--highlight);
        }
    }

    .is-pending {
        color: var(--fleet-yellow);
    }

    .is-in {
        color: var(--green);
    }

    .is-out {
        color: var(--text-muted);
    }

    .fleet-invites__wave-form {
        :global(button.is-active) {
            border-color: var(--highlight);
            color: var(--highlight);
        }
    }

    .fleet-invites__results:empty,
    .fleet-invites__resolve:empty {
        display: none;
    }

    .fleet-invites__picks ul {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2xs);
        margin-top: var(--space-3xs);
        padding: 0;
        list-style: none;
    }

    .fleet-invites__chip {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3xs);
        padding: var(--space-3xs) var(--space-3xs) var(--space-3xs) var(--space-xs);
        border: 1px solid var(--border-color);
        background-color: var(--surface-sunken);
        color: var(--highlight);

        button {
            min-width: var(--space-l);
            min-height: var(--space-l);
            background: transparent;
            border: 0;
            color: var(--text-muted);
            font: inherit;
            cursor: pointer;
        }
    }

    .fleet-invites__opsec {
        padding: var(--space-2xs) var(--space-xs);
        border: 1px solid color-mix(in srgb, var(--alliance-blue) 45%, transparent);
    }

    .fleet-invites__wave {
        display: flex;
        flex-direction: column;
        gap: var(--space-s);

        summary {
            cursor: pointer;
            list-style: none;

            &::-webkit-details-marker {
                display: none;
            }
        }

        h2 {
            font-size: var(--step-1);
        }
    }

    .fleet-invites__wave-summary {
        flex-wrap: wrap;
        align-items: baseline;
        width: 100%;
    }

    .fleet-invites__wave-counts {
        margin-left: auto;
    }

    .fleet-invites__note {
        margin: 0;
        padding: var(--space-2xs) var(--space-xs);
        border-left: 2px solid var(--hairline-strong);
        color: var(--text-muted);
    }

    .fleet-invites__table {
        width: 100%;
        border-collapse: collapse;
        font-size: var(--step--1);

        th {
            padding: var(--space-2xs) var(--space-xs);
            border-bottom: 1px solid var(--border-color);
            color: var(--text-muted);
            text-align: left;
            white-space: nowrap;
        }

        td {
            padding: var(--space-2xs) var(--space-xs);
            border-bottom: 1px solid var(--hairline);
            vertical-align: middle;

            small {
                display: block;
                color: var(--text-muted);
            }
        }

        .is-number {
            text-align: right;
            font-variant-numeric: tabular-nums;
            white-space: nowrap;
        }
    }

    .fleet-invites__copy {
        margin-left: var(--space-2xs);
        background: transparent;
        border: 0;
        color: var(--fleet-yellow);
        font: inherit;
        text-decoration: underline;
        cursor: pointer;
    }
</style>
