---
import type { RankingReelProps } from '@helpers/ranking_reels'

type Props = RankingReelProps

const {
    title,
    caption,
    fixed_width,
    items,
    cta,
} = Astro.props

import Wrapper from '@components/compositions/Wrapper.astro';
import FixedFluid from '@components/compositions/FixedFluid.astro';
import FlexInlineSiblings from '@components/compositions/FlexInlineSiblings.astro';
import FlexInline from '@components/compositions/FlexInline.astro';

import Marquee from '@components/blocks/Marquee.astro';
import RankedPilot from '@components/blocks/RankedPilot.astro';
import Button from '@components/blocks/Button.astro';
import TextBadge from '@components/blocks/TextBadge.astro';

// With a call to action, the pilots shrink first so the button keeps its width.
const Siblings = cta ? FlexInlineSiblings : Fragment
const siblings_props = cta ? { 'min-shink-width': '250px', 'shrinkable-sibbling': 'first' } : {}
---

{/* Hidden until the pilots are laid out: Marquee (4+ pilots) or the static row dispatches marquee-started. */}
<div
    class="[ bottom-bar ][ card component light-transparency hidden! animate-slide-in-bottom ]"
    x-on:marquee-started="$el.classList.add('lg:block!')"
>
    <Wrapper
        class="[ ranking-reel ]"
        neocom={true}
        max_width='var(--max-content-width)'
        centered={true}
        padding_block='var(--space-2xs)'
    >
        <FixedFluid width={fixed_width} class="[ items-center! ]">
            <TextBadge title={title}>
                <small>{caption}</small>
            </TextBadge>

            <Siblings {...siblings_props}>
                {items.length >= 4 ?
                    <Marquee>
                        {items.map((item, index) => <RankedPilot place={index + 1} {...item} />)}
                    </Marquee> :
                    <FlexInline gap='var(--space-l)' x-init="$dispatch('marquee-started')">
                        {items.map((item, index) => <RankedPilot place={index + 1} {...item} />)}
                    </FlexInline>
                }

                {cta &&
                    <Button
                        href={cta.href}
                        size='sm'
                    >
                        {cta.text}
                    </Button>
                }
            </Siblings>
        </FixedFluid>
    </Wrapper>
</div>

<style lang="scss">
    .bottom-bar {
        position: fixed;
        left: 0;
        bottom: 0;
        width: 100%;
        z-index: var(--sticky-z-index);
    }

    .ranking-reel {
        position: relative;
    }
</style>
