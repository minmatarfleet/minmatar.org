---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { query_string } from '@helpers/string'
import { TIMEZONE_BRACKETS, timezone_description } from '@helpers/timezones'

/**
 * The Invite pilots button on a fleet's Invites tab and its dialog: new
 * pilots from the alliance health onboarding lists (standard fleets), or
 * tribe groups, corporations and pilots picked by search or a pasted list.
 * The Timezone row limits the group, corporation and new pilot picks to
 * pilots who play at the fleet time; only a Strategic FC on a strategic or
 * private fleet can change it to other timezones. Named pilots always go.
 * The reach panel shows who it reaches and who is skipped; the DM preview
 * shows what they get. Picks and the note are local form state; the reach
 * panel is the preview partial.
 * See docs/fleets/private-fleets.md.
 */
interface Props {
    fleet_id:               number;
    invite_only:            boolean;
    first_week:             number;
    more_fleets:            number;
    first_week_in_timezone: number;
    more_fleets_in_timezone: number;
    fleet_timezones:        string[];
    timezones_nearest:      boolean;
    can_choose_timezones:   boolean;
}

const {
    fleet_id,
    invite_only,
    first_week,
    more_fleets,
    first_week_in_timezone,
    more_fleets_in_timezone,
    fleet_timezones,
    timezones_nearest,
    can_choose_timezones,
} = Astro.props

const PARTIAL_URL = `${translatePath('/partials/fleet_invites_component')}?${query_string({ fleet_id })}`
const CANDIDATES_URL = `${translatePath('/partials/fleet_invite_candidates_component')}?${query_string({ fleet_id })}`
const RESOLVE_URL = `${translatePath('/partials/fleet_invite_resolve_component')}?${query_string({ fleet_id })}`
const title = t('fleets.invites.invite_pilots')
// New pilots are a standard fleet's tab; it opens first when there are some.
const new_pilots = !invite_only
const start_mode = new_pilots && (first_week_in_timezone + more_fleets_in_timezone) > 0 ? 'new' : 'search'
const BUCKETS = [
    { key: 'first_week', label: t('fleets.invites.first_week'), hint: t('fleets.invites.first_week_hint') },
    { key: 'more_fleets', label: t('fleets.invites.more_fleets'), hint: t('fleets.invites.more_fleets_hint') },
]
// New pilot rows and group chips count who plays in the chosen timezones;
// the Reach panel sends fresh counts whenever the picks or timezones change.
const bucket_counts = {
    first_week: [first_week_in_timezone, first_week],
    more_fleets: [more_fleets_in_timezone, more_fleets],
}
const of_label = JSON.stringify(t('fleets.invites.of_count'))
const timezone_note = timezones_nearest ? t('fleets.invites.timezone_nearest') : t('fleets.invites.timezone_fleet_time')
const timezone_options = TIMEZONE_BRACKETS.map(code => ({ code, description: timezone_description(code, t) }))
const no_tz_label = t('timezones.no_tz_yet')
const selected_label = JSON.stringify(t('fleets.invites.selected'))
// The Reach panel reports how many new invites the picks make (`reach`);
// the button counts them and turns off when every pick would be skipped.
const send_label = `reach === 1 ? ${JSON.stringify(t('fleets.invites.send_one'))} : reach > 1 ? ${JSON.stringify(t('fleets.invites.send_count'))}.replace('{count}', reach) : ${JSON.stringify(t('fleets.invites.send'))}`

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import FluidFixed from '@components/compositions/FluidFixed.astro'

import Button from '@components/blocks/Button.astro'
import DialogButton from '@components/blocks/DialogButton.astro'
import Input from '@components/blocks/Input.astro'
import Textarea from '@components/blocks/Textarea.astro'
---

<DialogButton
    size="sm"
    color="fleet-red"
    max_width="60rem"
>
    {title}

    <form
        slot="dialog"
        class="[ invite-dialog ]"
        hx-post={`${PARTIAL_URL}&action=wave`}
        hx-target="#fleet-invites"
        hx-swap="outerHTML"
        x-data={`{ picks: [], onboarding: [], add_mode: '${start_mode}', query: '', paste_text: '', note: '', reach: null, timezones: ${JSON.stringify(fleet_timezones)}, any_timezone: false, timezones_open: false, pick_counts: {}, bucket_counts: ${JSON.stringify(bucket_counts)}, refresh() { $nextTick(() => htmx.trigger($refs.preview, 'refresh')) }, plays_now(pick) { return this.any_timezone || !pick.tz || pick.tz.length === 0 || pick.tz.some(code => this.timezones.includes(code)) } }`}
        x-on:invite-reach="reach = $event.detail.new; pick_counts = $event.detail.picks || {}; if ($event.detail.onboarding) bucket_counts = $event.detail.onboarding"
        x-on:pick-candidate="query = ''; if (!picks.some(p => p.kind === $event.detail.kind && p.id === $event.detail.id)) { picks.push($event.detail); $nextTick(() => htmx.trigger($refs.preview, 'refresh')) }"
    >
        <Flexblock gap="var(--space-l)">
            <h2>{title}</h2>

            <FluidFixed width="18rem" gap="var(--space-l)" data-mod="no-stretch">
                <Flexblock gap="var(--space-l)">
                    <FlexInline gap="var(--space-s)" class="[ invite-dialog__timezone ]">
                        <h3 class="[ invite-dialog__label ]">{t('fleets.invites.timezone')}</h3>
                        <template x-for="code in (any_timezone ? ['any'] : timezones)" x-bind:key="code">
                            <input type="hidden" name="timezones" x-bind:value="code" />
                        </template>
                        {can_choose_timezones ?
                            <Fragment>
                                <span class="[ invite-dialog__tz is-fixed ]" x-show="any_timezone" x-cloak>{t('fleets.invites.timezone_any')}</span>
                                <template x-for="code in timezones" x-bind:key="code">
                                    <span class="[ invite-dialog__tz is-fixed ]" x-show="!any_timezone" x-text="code"></span>
                                </template>
                                <div class="[ invite-dialog__tz-menu ]">
                                    <Button
                                        type="button"
                                        size="sm"
                                        color="transparent"
                                        x-on:click="timezones_open = !timezones_open"
                                        x-bind:aria-expanded="timezones_open"
                                    >
                                        {t('fleets.invites.timezone_change')}
                                    </Button>
                                    <div class="[ invite-dialog__tz-options ]" x-show="timezones_open" x-cloak x-on:click.outside="timezones_open = false">
                                        <label>
                                            <input type="checkbox" x-model="any_timezone" x-on:change="refresh()" />
                                            <span>{t('fleets.invites.timezone_any')}</span>
                                        </label>
                                        {timezone_options.map(option =>
                                            <label>
                                                <input
                                                    type="checkbox"
                                                    value={option.code}
                                                    x-model="timezones"
                                                    x-bind:disabled={`any_timezone || (timezones.length === 1 && timezones[0] === '${option.code}')`}
                                                    x-on:change="refresh()"
                                                />
                                                <span>{option.code}</span>
                                                <small class="[ text-muted ]">{fleet_timezones.includes(option.code) ? t('fleets.invites.timezone_fleet') : option.description}</small>
                                            </label>
                                        )}
                                    </div>
                                </div>
                            </Fragment> :
                            fleet_timezones.length > 1 ?
                                <div class="[ invite-dialog__tzs ]" role="group" aria-label={t('fleets.invites.timezone')}>
                                    {fleet_timezones.map(code =>
                                        <label class="[ invite-dialog__tz ]">
                                            <input
                                                type="checkbox"
                                                value={code}
                                                x-model="timezones"
                                                x-bind:disabled={`timezones.length === 1 && timezones[0] === '${code}'`}
                                                x-on:change="refresh()"
                                            />
                                            <span>{code}</span>
                                            <small class="[ text-muted ]">{timezone_description(code, t)}</small>
                                        </label>
                                    )}
                                </div> :
                                fleet_timezones.map(code =>
                                    <span class="[ invite-dialog__tz is-fixed ]">
                                        <span>{code}</span>
                                        <small class="[ text-muted ]">{timezone_description(code, t)}</small>
                                    </span>
                                )
                        }
                        <small
                            class="[ text-muted ]"
                            x-show={can_choose_timezones ? `!any_timezone && timezones.length === ${fleet_timezones.length} && ${JSON.stringify(fleet_timezones)}.every(code => timezones.includes(code))` : undefined}
                        >{timezone_note}</small>
                    </FlexInline>

                    <Flexblock gap="var(--space-xs)">
                        <FlexInline gap="var(--space-s)">
                            <h3 class="[ invite-dialog__label ]">{t('fleets.private.wave_who')}</h3>
                            <div class="[ invite-dialog__modes ]" role="group" aria-label={t('fleets.private.wave_search')}>
                                {new_pilots &&
                                    <button
                                        type="button"
                                        x-on:click="add_mode = 'new'"
                                        x-bind:aria-pressed="add_mode === 'new'"
                                    >{t('fleets.invites.mode_new_pilots')}</button>
                                }
                                <button
                                    type="button"
                                    x-on:click="add_mode = 'search'"
                                    x-bind:aria-pressed="add_mode === 'search'"
                                >{t('fleets.invites.mode_select')}</button>
                                <button
                                    type="button"
                                    x-on:click="add_mode = 'paste'"
                                    x-bind:aria-pressed="add_mode === 'paste'"
                                >{t('fleets.invites.mode_paste')}</button>
                            </div>
                        </FlexInline>

                        {new_pilots &&
                            <Flexblock gap="var(--space-2xs)" x-show="add_mode === 'new'" x-cloak={start_mode !== 'new' ? '' : undefined}>
                                {BUCKETS.map(bucket =>
                                    <label class="[ invite-dialog__bucket ]">
                                        <input
                                            type="checkbox"
                                            name="onboarding"
                                            value={bucket.key}
                                            x-model="onboarding"
                                            x-on:change="refresh()"
                                        />
                                        <span>
                                            <b>{bucket.label}</b>
                                            <small class="[ text-muted ]">{bucket.hint}</small>
                                        </span>
                                        <span class="[ invite-dialog__bucket-count ]" x-text={`any_timezone || bucket_counts.${bucket.key}[0] === bucket_counts.${bucket.key}[1] ? bucket_counts.${bucket.key}[1] : ${of_label}.replace('{in}', bucket_counts.${bucket.key}[0]).replace('{total}', bucket_counts.${bucket.key}[1])`}>{bucket_counts[bucket.key as keyof typeof bucket_counts][0]}</span>
                                    </label>
                                )}
                            </Flexblock>
                        }

                        <Flexblock gap="var(--space-3xs)" x-show="add_mode === 'search'" x-cloak={start_mode !== 'search' ? '' : undefined}>
                            <label for={`fleet-invite-search-${fleet_id}`} class="[ visually-hidden ]">{t('fleets.private.wave_search')}</label>
                            <Input
                                id={`fleet-invite-search-${fleet_id}`}
                                type="search"
                                name="q"
                                autocomplete="off"
                                placeholder={t('fleets.private.wave_search_placeholder')}
                                hx-get={CANDIDATES_URL}
                                hx-trigger="input changed delay:300ms, search"
                                hx-target="next .invite-dialog__results"
                                hx-swap="innerHTML"
                                hx-include="this, closest form [name='timezones']"
                                x-on:keydown.enter.prevent=""
                                x-model="query"
                            />
                            <div class="[ invite-dialog__results ]" aria-live="polite" x-show="query.trim().length >= 2"></div>
                        </Flexblock>

                        <Flexblock gap="var(--space-2xs)" x-show="add_mode === 'paste'" x-cloak>
                            <label for={`fleet-invite-paste-${fleet_id}`} class="[ visually-hidden ]">{t('fleets.private.wave_paste')}</label>
                            <Textarea
                                id={`fleet-invite-paste-${fleet_id}`}
                                name="names"
                                rows="5"
                                placeholder={t('fleets.private.wave_paste_placeholder')}
                                x-model="paste_text"
                            />
                            <FlexInline justification="space-between" gap="var(--space-2xs)" class="[ items-start ]">
                                <div class="[ invite-dialog__resolve ]" aria-live="polite"></div>
                                <Button
                                    type="button"
                                    size="sm"
                                    color="transparent"
                                    disabled
                                    off_disable={true}
                                    x-bind:disabled="!paste_text.trim()"
                                    hx-post={RESOLVE_URL}
                                    hx-target="previous .invite-dialog__resolve"
                                    hx-swap="innerHTML"
                                    hx-include={`#fleet-invite-paste-${fleet_id}`}
                                    hx-disabled-elt="this"
                                >
                                    {t('fleets.private.wave_paste_add')}
                                </Button>
                            </FlexInline>
                        </Flexblock>

                        <FlexInline gap="var(--space-2xs)" class="[ invite-dialog__picks ]" x-show="picks.length > 0" x-cloak>
                            <small class="[ text-muted ]" x-text={`${selected_label}.replace('{count}', picks.length)`}></small>
                            <ul aria-label={t('fleets.private.wave_picks')}>
                                <template x-for="(pick, index) in picks" x-bind:key="pick.kind + pick.id">
                                    <li x-bind:class="pick.skip && 'is-skipped'" x-bind:title="pick.skip || null">
                                        <span x-text="pick.name"></span>
                                        <small
                                            class="[ text-muted ]"
                                            x-show="pick.kind !== 'pilot' && pick_counts[pick.kind + ':' + pick.id] && !any_timezone"
                                            x-text={`pick_counts[pick.kind + ':' + pick.id] ? ${of_label}.replace('{in}', pick_counts[pick.kind + ':' + pick.id][0]).replace('{total}', pick_counts[pick.kind + ':' + pick.id][1]) : ''`}
                                        ></small>
                                        <span
                                            class="[ invite-dialog__pick-tz ]"
                                            x-show="pick.kind === 'pilot' && pick.tz && !plays_now(pick)"
                                            x-text="(pick.tz || []).join(' ')"
                                        ></span>
                                        <span
                                            class="[ invite-dialog__pick-tz ]"
                                            x-show="pick.kind === 'pilot' && pick.tz && pick.tz.length === 0"
                                        >{no_tz_label}</span>
                                        <span class="[ invite-dialog__skipped ]" x-show="pick.skip">{t('fleets.invites.skipped')}</span>
                                        <input type="hidden" x-bind:name="pick.kind + '_ids'" x-bind:value="pick.id" />
                                        <button
                                            type="button"
                                            x-on:click="picks.splice(index, 1); $nextTick(() => htmx.trigger($refs.preview, 'refresh'))"
                                            x-bind:aria-label="'Remove ' + pick.name"
                                        >×</button>
                                    </li>
                                </template>
                            </ul>
                        </FlexInline>
                    </Flexblock>

                    <Flexblock gap="var(--space-2xs)">
                        <FlexInline gap="var(--space-xs)" class="[ items-baseline ]">
                            <label for={`fleet-invite-note-${fleet_id}`} class="[ invite-dialog__label ]">{t('fleets.private.wave_note_label')}</label>
                            <small class="[ text-muted ]">{t('fleets.private.optional')}</small>
                            <small class="[ invite-dialog__count text-muted ]" x-text="note.length + ' / 300'">0 / 300</small>
                        </FlexInline>
                        <Textarea
                            id={`fleet-invite-note-${fleet_id}`}
                            name="note"
                            rows="2"
                            maxlength="300"
                            x-model="note"
                        />
                    </Flexblock>

                    <figure class="[ invite-dialog__dm ]">
                        <figcaption class="[ text-muted ]">{t('fleets.private.dm_preview')}</figcaption>
                        <div class="[ invite-dialog__message ]">
                            {invite_only ?
                                <Fragment>
                                    <b>{t('fleets.private.dm_preview_title')}</b>
                                    <p x-show="note.trim()" x-text="note" x-cloak></p>
                                    <p><b>{t('fleets.private.opsec')}</b></p>
                                </Fragment> :
                                <Fragment>
                                    <b>{t('fleets.invites.dm_title')}</b>
                                    <p>{t('fleets.invites.dm_text')}</p>
                                    <p x-show="note.trim()" x-text="note" x-cloak></p>
                                    <p x-show="onboarding.length > 0" x-cloak>{t('fleets.invites.dm_new_to_fleets')}</p>
                                </Fragment>
                            }
                            <FlexInline gap="var(--space-2xs)" aria-hidden="true">
                                <span class="[ invite-dialog__fake-button ]">{invite_only ? t('fleets.private.dm_im_in') : t('fleets.invites.dm_im_in')}</span>
                                <span class="[ invite-dialog__fake-button ]">{t('fleets.private.answer_out')}</span>
                                {!invite_only && <span class="[ invite-dialog__fake-button ]">{t('fleets.invites.dm_stop')}</span>}
                            </FlexInline>
                        </div>
                    </figure>
                </Flexblock>

                <aside
                    x-ref="preview"
                    class="[ invite-dialog__preview ]"
                    aria-live="polite"
                    hx-post={`${PARTIAL_URL}&action=preview`}
                    hx-trigger="refresh"
                    hx-include="closest form"
                    hx-target="this"
                    hx-swap="innerHTML"
                >
                    <small class="[ text-muted ]">{t('fleets.private.wave_pick_first')}</small>
                </aside>
            </FluidFixed>

            <FlexInline justification="flex-end" gap="var(--space-2xs)" class="[ items-center ]">
                <small class="[ text-muted ]" x-show="reach === 0" x-cloak>{t('fleets.invites.nobody_to_invite')}</small>
                <Button
                    type="button"
                    size="sm"
                    color="transparent"
                    x-on:click="close_dialog()"
                >
                    {t('cancel')}
                </Button>
                <Button
                    type="submit"
                    size="sm"
                    color="fleet-red"
                    disabled
                    off_disable={true}
                    x-bind:disabled="(picks.length === 0 && onboarding.length === 0) || reach === 0"
                    hx-disabled-elt="this"
                >
                    <span x-text={send_label}>{t('fleets.invites.send')}</span>
                </Button>
            </FlexInline>
        </Flexblock>
    </form>
</DialogButton>

<style lang="scss">
    .invite-dialog__label {
        font-family: var(--default-font);
        font-size: var(--step--1);
        font-weight: 600;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .invite-dialog__timezone {
        align-items: center;
    }

    .invite-dialog__tzs {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2xs);
    }

    .invite-dialog__tz {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2xs);
        min-height: var(--space-xl);
        padding: 0 var(--space-xs);
        border: 1px solid var(--hairline-strong);
        color: var(--highlight);
        font-size: var(--step--1);
        cursor: pointer;

        &:has(input:checked),
        &.is-fixed {
            border-color: var(--foreground);
        }

        &.is-fixed {
            cursor: default;
        }

        input {
            width: var(--space-s);
            height: var(--space-s);
            margin: 0;
            accent-color: var(--fleet-red);
        }
    }

    .invite-dialog__tz-menu {
        position: relative;
    }

    .invite-dialog__tz-options {
        position: absolute;
        top: calc(100% + var(--space-3xs));
        left: 0;
        z-index: var(--tooltips-z-index);
        display: flex;
        flex-direction: column;
        min-width: 16rem;
        padding: var(--space-2xs);
        background-color: var(--background);
        border: 1px solid var(--border-color);

        label {
            display: flex;
            align-items: center;
            gap: var(--space-2xs);
            min-height: var(--space-xl);
            padding: 0 var(--space-2xs);
            color: var(--highlight);
            font-size: var(--step--1);
            cursor: pointer;
        }

        small {
            margin-left: auto;
        }

        input {
            margin: 0;
            accent-color: var(--fleet-red);
        }
    }

    .invite-dialog__pick-tz {
        padding: 0 var(--space-3xs);
        border: 1px solid var(--hairline-strong);
        color: var(--text-muted);
        font-size: var(--step--2);
        font-weight: 600;
        letter-spacing: 0.04em;
    }

    .invite-dialog__count {
        margin-left: auto;
        font-variant-numeric: tabular-nums;
    }

    .invite-dialog__modes {
        display: inline-flex;
        border: 1px solid var(--hairline-strong);

        button {
            padding: var(--space-3xs) var(--space-xs);
            background: transparent;
            border: 0;
            color: var(--foreground);
            font: inherit;
            font-size: var(--step--1);
            cursor: pointer;

            &[aria-pressed="true"] {
                background-color: var(--foreground);
                color: var(--background);
                font-weight: 600;
            }
        }
    }

    .invite-dialog__bucket {
        display: flex;
        align-items: center;
        gap: var(--space-s);
        padding: var(--space-xs) var(--space-s);
        border: 1px solid var(--hairline-strong);
        cursor: pointer;

        &:has(input:checked) {
            border-color: var(--foreground);
        }

        input {
            width: var(--space-s);
            height: var(--space-s);
            margin: 0;
            accent-color: var(--fleet-red);
        }

        > span:nth-child(2) {
            display: flex;
            flex: 1;
            flex-direction: column;
        }

        b {
            color: var(--highlight);
        }
    }

    .invite-dialog__bucket-count {
        color: var(--highlight);
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }

    .invite-dialog__results {
        max-height: 16rem;
        overflow-y: auto;
    }

    .invite-dialog__results:empty,
    .invite-dialog__resolve:empty {
        display: none;
    }

    .invite-dialog__picks {
        align-items: center;

        ul {
            display: flex;
            flex-wrap: wrap;
            gap: var(--space-2xs);
            margin-inline: 0;
            margin-bottom: 0;
            padding: 0;
            list-style: none;
        }

        li {
            display: inline-flex;
            align-items: center;
            gap: var(--space-3xs);
            padding-left: var(--space-xs);
            border: 1px solid var(--hairline-strong);
            color: var(--highlight);
            font-size: var(--step--1);
        }

        li.is-skipped {
            border-style: dashed;
            border-color: color-mix(in srgb, var(--fleet-red-blind) 55%, transparent);
            color: var(--text-muted);
        }

        button {
            min-width: var(--space-l);
            min-height: var(--space-l);
            background: transparent;
            border: 0;
            color: var(--text-muted);
            font: inherit;
            cursor: pointer;
        }
    }

    .invite-dialog__skipped {
        color: var(--fleet-red-blind);
        font-size: var(--step--2);
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .invite-dialog__dm {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        margin-inline: 0;
        margin-bottom: 0;

        figcaption {
            font-size: var(--step--1);
        }
    }

    .invite-dialog__message {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        padding: var(--space-s);
        background-color: var(--surface-sunken);
        border: 1px solid var(--border-color);
        font-size: var(--step--1);

        > b {
            color: var(--highlight);
        }

        p {
            margin: 0;
            white-space: pre-line;
        }
    }

    .invite-dialog__fake-button {
        padding: var(--space-3xs) var(--space-xs);
