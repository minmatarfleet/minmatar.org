---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { LoyaltyCurrency } from '@dtypes/api.minmatar.org'
import {
    DEFAULT_LOYALTY_OFFERS_PARAMS,
    TLIB_CORP_ID,
    expand_useless_offer_excludes,
    useless_offer_exclude_toggle,
} from '@helpers/loyalty_offers_metrics'
import { get_corporation_logo } from '@helpers/eve_image_server'
import { query_string } from '@helpers/string'

import Grid from '@components/compositions/Grid.astro'
import Input from '@components/blocks/Input.astro'
import Button from '@components/blocks/Button.astro'
import RadioCheckInput from '@components/blocks/RadioCheckInput.astro'
import MagnifierIcon from '@components/icons/buttons/MagnifierIcon.astro'
import CaretIcon from '@components/icons/CaretIcon.astro'

const FACTION_ORDER: readonly number[] = [
    1000182, // TLIB
    1000179, // 24th
    1000180, // State
    1000181, // FDU
]

interface Props {
    currencies: LoyaltyCurrency[]
    currency: number
    exclude_tags?: string
    exclude_blueprints?: string
    exclude_useless_offers?: string
    exclude_below_set_lp_price?: string
    include_freight?: string
    include_sales_tax?: string
    side: 'sell' | 'buy' | 'avg_7d'
    q: string
    ordering: string
    [propName: string]: any
}

const {
    currencies,
    currency,
    exclude_tags,
    exclude_blueprints,
    exclude_useless_offers,
    exclude_below_set_lp_price,
    include_freight = '1',
    include_sales_tax = '1',
    side,
    q,
    ordering,
} = Astro.props

const SLOT = '#loyalty-offers-slot'
const PARTIAL = translatePath('/partials/loyalty_offers_component')

const selected_currency = currencies.some((c) => c.corporation_id === currency)
    ? currency
    : (currencies.find((c) => c.corporation_id === TLIB_CORP_ID)?.corporation_id
        ?? currencies[0]?.corporation_id
        ?? TLIB_CORP_ID)

const sorted_currencies = [...currencies].sort((a, b) => {
    const ai = FACTION_ORDER.indexOf(a.corporation_id)
    const bi = FACTION_ORDER.indexOf(b.corporation_id)
    const ao = ai === -1 ? FACTION_ORDER.length : ai
    const bo = bi === -1 ? FACTION_ORDER.length : bi
    if (ao !== bo) return ao - bo
    return a.name.localeCompare(b.name)
})

const selected_currency_record = sorted_currencies.find(
    (c) => c.corporation_id === selected_currency,
) ?? sorted_currencies[0] ?? null

const freight_included = include_freight !== '0'
const sales_tax_included = include_sales_tax !== '0'
const useless_excludes = expand_useless_offer_excludes(exclude_useless_offers)

const base_params: Record<string, string> = {
    currency: String(selected_currency),
    side,
    ordering,
    include_freight: freight_included ? '1' : '0',
    include_sales_tax: sales_tax_included ? '1' : '0',
    ...useless_excludes,
}
if (exclude_tags)
    base_params.exclude_tags = exclude_tags
if (exclude_blueprints)
    base_params.exclude_blueprints = exclude_blueprints
if (exclude_below_set_lp_price)
    base_params.exclude_below_set_lp_price = exclude_below_set_lp_price
if (q)
    base_params.q = q

function with_params(overrides: Record<string, string | undefined>): string {
    const next: Record<string, string> = { ...base_params }
    for (const [key, value] of Object.entries(overrides)) {
        if (value === undefined || value === '')
            delete next[key]
        else
            next[key] = value
    }
    return `${PARTIAL}?${query_string(next)}`
}

const default_reset_url = with_params({
    ...DEFAULT_LOYALTY_OFFERS_PARAMS,
    ...expand_useless_offer_excludes(DEFAULT_LOYALTY_OFFERS_PARAMS.exclude_useless_offers),
    q: undefined,
})

const sides = [
    { value: 'buy', label: t('industry.loyalty.offers.side.jita_buy') },
    { value: 'sell', label: t('industry.loyalty.offers.side.jita_sell') },
    { value: 'avg_7d', label: t('industry.loyalty.offers.side.avg_7d') },
] as const

const costs = [
    {
        name: 'include_sales_tax_toggle',
        label: t('industry.loyalty.offers.cost.sales_tax'),
        active: sales_tax_included,
        url: with_params({ include_sales_tax: sales_tax_included ? '0' : '1' }),
    },
    {
        name: 'include_freight_toggle',
        label: t('industry.loyalty.offers.cost.freight'),
        active: freight_included,
        url: with_params({ include_freight: freight_included ? '0' : '1' }),
    },
]

const excludes = [
    {
        key: 'exclude_tags',
        label: t('industry.loyalty.offers.hide.tags'),
        active: exclude_tags === '1',
    },
    {
        key: 'exclude_blueprints',
        label: t('industry.loyalty.offers.hide.blueprints'),
        active: exclude_blueprints === '1',
    },
    {
        key: 'exclude_useless_offers',
        label: t('industry.loyalty.offers.hide.useless'),
        tip: t('industry.loyalty.offers.hide.useless_tip'),
        active: exclude_useless_offers === '1',
        // Packages / chips / skins ride along with this toggle.
        bundled: true,
    },
    {
        key: 'exclude_below_set_lp_price',
        label: t('industry.loyalty.offers.hide.below_set'),
        active: exclude_below_set_lp_price === '1',
    },
]

function exclude_toggle_overrides(
    key: string,
    active: boolean,
    bundled?: boolean,
): Record<string, string | undefined> {
    if (bundled && key === 'exclude_useless_offers')
        return useless_offer_exclude_toggle(!active)
    return { [key]: active ? undefined : '1' }
}

const hx_include_filters =
    ".loyalty-offers-filters__persist, .loyalty-offers-filters__search [name='q'], .loyalty-offers-filters__side"
---

<aside
    class="[ loyalty-offers-filters ]"
    aria-label={t('industry.loyalty.offers.filters.aria_label')}
>
    <div class="[ loyalty-offers-filters__group ]">
        <span class="[ loyalty-offers-filters__legend ]">{t('industry.loyalty.offers.filters.store')}</span>
        {sorted_currencies.length <= 1 ? (
            <span class="[ loyalty-offers-filters__currency-trigger is-static ]">
                {selected_currency_record && (
                    <img
                        class="[ loyalty-offers-filters__currency-logo ]"
                        src={get_corporation_logo(selected_currency_record.corporation_id, 32)}
                        width="20"
                        height="20"
                        alt=""
                        loading="lazy"
                    />
                )}
                <span class="[ loyalty-offers-filters__currency-name ]">
                    {selected_currency_record?.name
                        ?? t('industry.loyalty.offers.currency_label')}
                </span>
            </span>
        ) : (
        <div
            class="[ loyalty-offers-filters__currency ]"
            x-data={`{
                open: false,
                close() { this.open = false },
                toggle() { this.open = this.open ? false : true },
            }`}
            @keydown.escape.prevent.stop="close()"
            @mousedown.outside="open && close()"
            @htmx:before-request="close()"
        >
            <button
                type="button"
                class="[ loyalty-offers-filters__currency-trigger ]"
                @click.prevent="toggle()"
                x-bind:aria-expanded="open"
                aria-haspopup="listbox"
                aria-controls="loyalty-offers-currency-options"
                aria-label={t('industry.loyalty.offers.currency_label')}
            >
                {selected_currency_record && (
                    <img
                        class="[ loyalty-offers-filters__currency-logo ]"
                        src={get_corporation_logo(selected_currency_record.corporation_id, 32)}
                        width="20"
                        height="20"
                        alt=""
                        loading="lazy"
                    />
                )}
                <span class="[ loyalty-offers-filters__currency-name ]">
                    {selected_currency_record?.name
                        ?? t('industry.loyalty.offers.currency_label')}
                </span>
                <CaretIcon class="[ loyalty-offers-filters__currency-caret ]" />
            </button>

            <ul
                id="loyalty-offers-currency-options"
                class="[ loyalty-offers-filters__currency-options ]"
                role="listbox"
                x-show="open"
                x-cloak
                style="display: none"
            >
                {sorted_currencies.map((c) => (
                    <li role="presentation">
                        <button
                            type="button"
                            role="option"
                            class:list={[
                                '[ loyalty-offers-filters__currency-option ]',
                                {
                                    'loyalty-offers-filters__currency-option--selected':
                                        selected_currency === c.corporation_id,
                                },
                            ]}
                            aria-selected={selected_currency === c.corporation_id
                                ? 'true'
                                : 'false'}
                            @click="close()"
                            hx-get={with_params({
                                currency: String(c.corporation_id),
                            })}
                            hx-target={SLOT}
                            hx-swap="innerHTML"
                            hx-indicator=".loader"
                        >
                            <img
                                class="[ loyalty-offers-filters__currency-logo ]"
                                src={get_corporation_logo(c.corporation_id, 32)}
                                width="20"
                                height="20"
                                alt=""
                                loading="lazy"
                            />
                            <span>{c.name}</span>
                        </button>
                    </li>
                ))}
            </ul>
        </div>
        )}
    </div>

    <form
        class="[ loyalty-offers-filters__group loyalty-offers-filters__search ]"
        hx-get={PARTIAL}
        hx-target={SLOT}
        hx-swap="innerHTML"
        hx-indicator=".loader"
        hx-trigger="submit, keyup changed delay:400ms from:find input"
        hx-include={hx_include_filters}
    >
        <label class="[ loyalty-offers-filters__legend ]" for="loyalty-offers-search">
            {t('industry.loyalty.offers.filters.search')}
        </label>
        <Input
            id="loyalty-offers-search"
            type="search"
            name="q"
            value={q}
            placeholder={t('industry.loyalty.offers.search_placeholder')}
            size="sm"
        >
            <MagnifierIcon slot="icon" />
        </Input>
    </form>

    <Grid
        class="[ loyalty-offers-filters__options ]"
        min_item_width="8rem"
        row_gap="var(--space-s)"
        column_gap="var(--space-m)"
    >
        <fieldset class="[ loyalty-offers-filters__group loyalty-offers-filters__side ]">
            <legend class="[ loyalty-offers-filters__legend ]">
                {t('industry.loyalty.offers.filters.sell_into')}
            </legend>
            {sides.map((option) => (
                <RadioCheckInput
                    type="radio"
                    name="side"
                    value={option.value}
                    checked={side === option.value ? 'checked' : undefined}
                    hx-get={PARTIAL}
                    hx-target={SLOT}
                    hx-swap="innerHTML"
                    hx-indicator=".loader"
                    hx-trigger="change"
                    hx-include={hx_include_filters}
                >
                    <small>{option.label}</small>
                </RadioCheckInput>
            ))}
        </fieldset>

        <fieldset class="[ loyalty-offers-filters__group ]">
            <legend class="[ loyalty-offers-filters__legend ]">
                {t('industry.loyalty.offers.filters.count_costs')}
            </legend>
            {costs.map((cost) => (
                <RadioCheckInput
                    type="checkbox"
                    name={cost.name}
                    value="1"
                    checked={cost.active ? 'checked' : undefined}
                    hx-get={cost.url}
                    hx-target={SLOT}
                    hx-swap="innerHTML"
                    hx-indicator=".loader"
                    hx-trigger="change"
                >
                    <small>{cost.label}</small>
                </RadioCheckInput>
            ))}
        </fieldset>

        <fieldset class="[ loyalty-offers-filters__group ]">
            <legend class="[ loyalty-offers-filters__legend ]">
                {t('industry.loyalty.offers.filters.hide')}
            </legend>
            {excludes.map((item) => (
                <RadioCheckInput
                    type="checkbox"
                    name={`${item.key}_toggle`}
                    value="1"
                    checked={item.active ? 'checked' : undefined}
                    hx-get={with_params(
                        exclude_toggle_overrides(item.key, item.active, item.bundled),
                    )}
                    hx-target={SLOT}
                    hx-swap="innerHTML"
                    hx-indicator=".loader"
                    hx-trigger="change"
                >
                    <small data-tippy-content={item.tip} data-tippy-maxWidth="320">{item.label}</small>
                </RadioCheckInput>
            ))}
        </fieldset>
    </Grid>

    <Button
        size="sm"
        color="transparent"
        class="[ loyalty-offers-filters__reset ]"
        hx-get={default_reset_url}
        hx-target={SLOT}
        hx-swap="innerHTML"
        hx-indicator=".loader"
    >
        {t('industry.loyalty.offers.clear_filters')}
    </Button>

    <div class="[ loyalty-offers-filters__persist ]" hidden>
        <input type="hidden" name="currency" value={String(selected_currency)} />
        <input type="hidden" name="ordering" value={ordering} />
        <input
            type="hidden"
            name="include_freight"
            value={freight_included ? '1' : '0'}
        />
        <input
            type="hidden"
            name="include_sales_tax"
            value={sales_tax_included ? '1' : '0'}
        />
        {exclude_tags === '1' && <input type="hidden" name="exclude_tags" value="1" />}
        {exclude_blueprints === '1' && (
            <input type="hidden" name="exclude_blueprints" value="1" />
        )}
        {exclude_useless_offers === '1' && (
            <input type="hidden" name="exclude_useless_offers" value="1" />
        )}
        {exclude_below_set_lp_price === '1' && (
            <input type="hidden" name="exclude_below_set_lp_price" value="1" />
        )}
    </div>
</aside>

<style lang="scss">
    [x-cloak] {
        display: none !important;
    }

    .loyalty-offers-filters {
        display: flex;
        flex-direction: column;
        gap: var(--space-s);
        padding: var(--space-s);
        border: solid 1px var(--border-color);
        background-color: color-mix(in srgb, var(--background) 35%, transparent);
    }

    .loyalty-offers-filters__group {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        min-width: 0;
        margin: 0;
        padding: 0;
        border: 0;
    }

    .loyalty-offers-filters__legend {
        padding: 0;
        margin-block-end: var(--space-3xs);
        font-size: var(--step--2);
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--faded);
    }

    .loyalty-offers-filters :global(.loyalty-offers-filters__reset) {
        align-self: flex-start;
    }

    .loyalty-offers-filters__currency {
        position: relative;
        width: 100%;
    }

    .loyalty-offers-filters__currency-trigger.is-static {
        cursor: default;
    }

    .loyalty-offers-filters__currency-trigger {
        appearance: none;
        display: flex;
        align-items: center;
        gap: var(--space-2xs);
        width: 100%;
        margin: 0;
        padding-block: var(--space-2xs);
        padding-inline: var(--space-xs-s) var(--space-m);
        border: solid 1px var(--border-color);
        background-color: color-mix(in srgb, var(--faded) 10%, transparent);
        color: var(--form-color);
        cursor: pointer;
        text-align: left;
        box-sizing: border-box;
        transition: border-color var(--fast-transition), background-color var(--fast-transition);

        @media (hover: hover) {
            &:not(.is-static):hover {
                border-color: var(--border-color-hover);
            }
        }

        &:focus-visible {
            outline: 1px solid var(--highlight);
            outline-offset: 2px;
        }

        &[aria-expanded='true'] {
            background-color: var(--component-background);
        }
    }

    .loyalty-offers-filters__currency-name {
        flex: 1 1 auto;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: var(--step--1);
    }

    .loyalty-offers-filters__currency-logo {
        flex-shrink: 0;
        width: var(--space-s);
        height: var(--space-s);
        border-radius: 2px;
        background-color: var(--background);
    }

    .loyalty-offers-filters__currency-caret {
        flex-shrink: 0;
        color: var(--highlight);
    }

    .loyalty-offers-filters__currency-options {
        position: absolute;
        inset-inline-start: 0;
        inset-block-start: calc(100% + 2px);
        z-index: var(--sticky-z-index);
        margin: 0;
        padding: 0;
        list-style: none;
        width: 100%;
        border: solid 1px var(--border-color);
        background-color: var(--component-background);
    }

    .loyalty-offers-filters__currency-option {
        appearance: none;
        display: flex;
        align-items: center;
        gap: var(--space-2xs);
        width: 100%;
        margin: 0;
        padding-block: var(--space-2xs);
        padding-inline: var(--space-xs-s);
        border: 0;
        background: transparent;
        color: var(--form-color);
        cursor: pointer;
        font-size: var(--step--1);
        text-align: left;

        @media (hover: hover) {
            &:hover {
                background-color: color-mix(in srgb, var(--fleet-yellow) 12%, transparent);
                color: var(--highlight);
            }
        }

        &--selected {
            background-color: color-mix(in srgb, var(--fleet-red) 35%, transparent);
            color: var(--highlight);
        }

        &:focus-visible {
            outline: 1px solid var(--highlight);
            outline-offset: -2px;
        }
    }

    .loyalty-offers-filters__search :global(.input-group) {
        max-width: 100%;
    }

    .loyalty-offers-filters :global(small[data-tippy-content]) {
        cursor: help;
        text-decoration: underline dotted color-mix(in srgb, currentColor 35%, transparent);
        text-underline-offset: 0.2em;
    }
</style>
