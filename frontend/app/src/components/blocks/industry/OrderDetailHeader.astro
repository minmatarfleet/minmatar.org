---
import { i18n } from '@helpers/i18n'
const { lang, t, translatePath } = i18n(Astro.url)

import type { CampaignListItem, Location, OrderLpStockpile } from '@dtypes/api.minmatar.org'
import { format_date_short } from '@helpers/date'
import { query_string } from '@helpers/string'

interface Props {
    order_id: number
    character_id: number | null
    character_name: string
    location_name?: string | null
    needed_by?: Date | string | null
    /**
     * LP stockpiles for the stockpiles dialog. Empty until the header partial
     * loads; coordinators load their own content inside the modal.
     */
    lp_stockpiles?: OrderLpStockpile[] | null
    /** Edit form for order managers; null hides it. */
    manage?: {
        location_id: number | null
        contract_to: string
        campaign_id: number | null
        fulfilled: boolean
        locations: Location[]
        campaigns: CampaignListItem[]
    } | null
}

const {
    order_id,
    character_id,
    character_name,
    location_name = null,
    needed_by = null,
    lp_stockpiles = null,
    manage = null,
} = Astro.props

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import PilotBadge from '@components/blocks/PilotBadge.astro'
import DialogButton from '@components/blocks/DialogButton.astro'
import Button from '@components/blocks/Button.astro'
import OrderLpStockpiles from '@components/blocks/OrderLpStockpiles.astro'
import Select from '@components/blocks/Select.astro'
import Input from '@components/blocks/Input.astro'
import LazyPartial from '@components/blocks/LazyPartial.astro'

const COORDINATORS_PARTIAL = translatePath(
    `/partials/order_coordinators_component?${query_string({
        order_id: String(order_id),
    })}`,
)
const MANAGE_PARTIAL = translatePath(
    `/partials/order_manage_component?${query_string({
        order_id: String(order_id),
    })}`,
)
const manage_form_id = `order-manage-form-${order_id}`
const needed_by_value = needed_by ? String(needed_by).slice(0, 10) : ''
---

<FlexInline
    id="order-detail-header"
    justification="space-between"
    class="[ w-full order-detail-meta ]"
>
    <Flexblock gap="var(--space-s)" class="[ order-detail-meta__contractor ]">
        {character_id ? (
            <PilotBadge
                character_id={character_id}
                character_name={character_name}
                heading={true}
            >
                <small>{t('contractor')}</small>
            </PilotBadge>
        ) : (
            <p>{character_name}</p>
        )}
        <FlexInline gap="var(--space-s)" class="[ order-detail-meta__actions ]">
            <DialogButton
                size="sm"
                color="fleet-red"
                narrow={false}
                max_width="640px"
            >
                {t('industry.orders.lp_stockpiles.view')}
                <Flexblock slot="header" gap="var(--space-3xs)">
                    <h3>
                        {t('industry.orders.lp_stockpiles.title')}
                    </h3>
                    <small>
                        {t(
                            'industry.orders.lp_stockpiles.description',
                        )}
                    </small>
                </Flexblock>
                <OrderLpStockpiles
                    slot="dialog"
                    stockpiles={lp_stockpiles ?? []}
                    show_heading={false}
                />
                <FlexInline
                    slot="footer"
                    justification="flex-start"
                    gap="var(--space-xs)"
                >
                    <Button
                        type="button"
                        size="sm"
                        color="transparent"
                        x-on:click="close_dialog()"
                    >
                        {t('close')}
                    </Button>
                </FlexInline>
            </DialogButton>
            <DialogButton
                size="sm"
                color="fleet-red"
                narrow={false}
                max_width="720px"
            >
                {t('industry.orders.coordinators.view')}
                <Flexblock slot="header" gap="var(--space-3xs)">
                    <h3>
                        {t('industry.orders.coordinators.title')}
                    </h3>
                    <small>
                        {t(
                            'industry.orders.coordinators.description',
                        )}
                    </small>
                </Flexblock>
                <LazyPartial
                    slot="dialog"
                    class="[ order-coordinators-lazy w-full ]"
                    url={COORDINATORS_PARTIAL}
                    trigger="reveal"
                    indicator={false}
                >
                    <Flexblock
                        gap="var(--space-s)"
                        class="[ order-coordinators-skel ]"
                        aria-busy="true"
                        aria-live="polite"
                    >
                        <p class="[ order-coordinators-skel__status ]">
                            {t(
                                'industry.orders.coordinators.calculating_build_requirements',
                            )}
                        </p>
                        <div class="[ order-coordinators-skel__tabs ]">
                            <div class="[ skel skel-tab ]"></div>
                            <div class="[ skel skel-tab ]"></div>
                            <div class="[ skel skel-tab ]"></div>
                        </div>
                        <div class="[ skel skel-row ]"></div>
                        <div class="[ skel skel-row ]"></div>
                        <div class="[ skel skel-row skel-row--short ]"></div>
                        <div class="[ skel skel-row ]"></div>
                        <div class="[ skel skel-row skel-row--short ]"></div>
                    </Flexblock>
                </LazyPartial>
            </DialogButton>
        </FlexInline>
    </Flexblock>
    <Flexblock gap="var(--space-3xs)" class="[ order-detail-meta__aside ]">
        {manage && (
            <div class="[ order-detail-meta__manage ]">
                <DialogButton
                    size="sm"
                    color="fleet-red"
                    narrow={false}
                    max_width="560px"
                >
                    {t('industry.orders.manage.view')}
                    <Flexblock slot="header" gap="var(--space-3xs)">
                        <h3>{t('industry.orders.manage.title')}</h3>
                        <small>{t('industry.orders.manage.description')}</small>
                    </Flexblock>
                    <form
                        slot="dialog"
                        id={manage_form_id}
                        class="[ order-manage-form ]"
                        hx-post={MANAGE_PARTIAL}
                        hx-target="find .order-manage-form__status"
                        hx-swap="innerHTML"
                    >
                        <Flexblock gap="var(--space-s)">
                            <label for={`${manage_form_id}-needed_by`}>{t('needed_by')}</label>
                            <Input
                                id={`${manage_form_id}-needed_by`}
                                type="date"
                                name="needed_by"
                                value={needed_by_value}
                                required
                            />
                            <label for={`${manage_form_id}-location`}>{t('location')}</label>
                            <Select id={`${manage_form_id}-location`} name="location_id">
                                <option value="" selected={manage.location_id === null}>
                                    {t('industry.orders.manage.no_location')}
                                </option>
                                {manage.locations.map((location) => (
                                    <option
                                        value={location.location_id}
                                        selected={location.location_id === manage.location_id}
                                    >
                                        {location.location_name}
                                    </option>
                                ))}
                            </Select>
                            <label for={`${manage_form_id}-contract_to`}>{t('contract_to')}</label>
                            <Input
                                id={`${manage_form_id}-contract_to`}
                                type="text"
                                name="contract_to"
                                value={manage.contract_to}
                                maxlength="255"
                            />
                            <label for={`${manage_form_id}-campaign`}>{t('campaign')}</label>
                            <Select id={`${manage_form_id}-campaign`} name="campaign_id">
                                <option value="" selected={manage.campaign_id === null}>
                                    {t('no_campaign')}
                                </option>
                                {manage.campaigns.map((campaign) => (
                                    <option
                                        value={campaign.id}
                                        selected={campaign.id === manage.campaign_id}
                                    >
                                        {campaign.name}
                                    </option>
                                ))}
                            </Select>
                            <label class="[ order-manage-form__check ]">
                                <input type="checkbox" name="fulfilled" checked={manage.fulfilled} />
                                {t('industry.orders.manage.fulfilled')}
                            </label>
                            <div class="[ order-manage-form__status ]" aria-live="polite"></div>
                        </Flexblock>
                    </form>
                    <FlexInline
                        slot="footer"
                        justification="flex-start"
                        gap="var(--space-xs)"
                    >
                        <Button type="submit" form={manage_form_id} size="sm" color="fleet-red">
                            {t('save')}
                        </Button>
                        <Button
                            type="button"
                            size="sm"
                            color="transparent"
                            x-on:click="close_dialog()"
                        >
                            {t('cancel')}
                        </Button>
                    </FlexInline>
                </DialogButton>
            </div>
        )}
        {
            location_name && (
                <small class="[ text-highlight ]">{location_name}</small>
            )
        }
        {
            needed_by && (
                <small>
                    {t('needed_by')}: {format_date_short(lang, needed_by)}
                </small>
            )
        }
    </Flexblock>
</FlexInline>

<style lang="scss">
    @use '../../../styles/mixins/skeleton';

    .order-coordinators-skel__status {
        margin: 0;
        font-size: var(--step--1);
        color: var(--highlight);
    }

    .order-coordinators-skel__tabs {
        display: flex;
        gap: var(--space-3xs);
        margin-block-end: var(--space-2xs);
    }

    .order-coordinators-skel .skel {
        border-radius: 2px;
        @include skeleton.shimmer;
    }

    .order-coordinators-skel .skel-tab {
        width: 5.5rem;
        height: 1.75rem;
    }

    .order-coordinators-skel .skel-row {
        width: 100%;
        height: 2.5rem;
    }

    .order-coordinators-skel .skel-row--short {
        width: 70%;
    }

    .order-detail-meta__actions {
        flex-wrap: wrap;
    }

    .order-detail-meta__aside {
        align-items: flex-end;
        text-align: right;
    }

    .order-manage-form__check {
        display: flex;
        align-items: center;
        gap: var(--space-xs);
    }

    /* Phones: location / needed-by read left-aligned with the manage button beside them. */
    @media (max-width: 48rem) {
        .order-detail-meta__aside {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            align-items: center;
            column-gap: var(--space-s);
            width: 100%;
            text-align: left;

            > :global(.order-detail-meta__manage) {
                grid-column: 2;
                grid-row: 1 / span 2;
            }

            > :global(small) {
                grid-column: 1;
            }
        }
    }
</style>
