---
import { i18n } from '@helpers/i18n'
import type { LoyaltyCurrency } from '@dtypes/api.minmatar.org'
import { get_corporation_logo } from '@helpers/eve_image_server'
import { number_thousand_separator } from '@helpers/numbers'
import { EXPRESS_SLA_HOURS } from '@helpers/loyalty_order_stats'
import Flexblock from '@components/compositions/Flexblock.astro'
import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import Grid from '@components/compositions/Grid.astro'
import Tag from '@components/blocks/Tag.astro'

const { t } = i18n(Astro.url)

interface Props {
    /** The Tribal Liberation Force currency; null when not configured. */
    currency: LoyaltyCurrency | null
}

const { currency } = Astro.props

const paused = currency ? !currency.allow_buy && !currency.allow_sell : false
const tiers = currency ? [
    {
        key: 'standard',
        label: t('industry.loyalty.tier.standard'),
        price: currency.default_isk_per_lp,
        description: t('industry.loyalty.tier.standard_description'),
    },
    {
        key: 'express',
        label: t('industry.loyalty.tier.express'),
        price: currency.express_isk_per_lp,
        description: t('industry.loyalty.tier.express_description')
            .replace('{hours}', String(EXPRESS_SLA_HOURS)),
    },
] : []
---

<section class="[ loyalty-rate-cards ]">
    <Flexblock gap="var(--space-xs)">
        <h2>{t('industry.loyalty.rates.title')}</h2>

        {!currency ? (
            <p class="[ loyalty-rate-cards__empty ]">{t('industry.loyalty.rates.empty')}</p>
        ) : (
            <Grid
                class="[ loyalty-rate-cards__grid w-full ]"
                row_gap="var(--space-3xs)"
                column_gap="var(--space-3xs)"
                min_item_width="16rem"
            >
                {tiers.map((tier) => (
                    <ComponentBlock
                        class:list={[
                            'loyalty-rate-cards__card',
                            `loyalty-rate-cards__card--${tier.key}`,
                        ]}
                        padding_block="var(--space-s)"
                        padding_inline="var(--space-m)"
                    >
                        <div class="[ loyalty-rate-cards__body ]">
                            <div class="[ loyalty-rate-cards__identity ]">
                                <img
                                    class="[ loyalty-rate-cards__logo ]"
                                    loading="lazy"
                                    src={get_corporation_logo(currency.corporation_id, 64)}
                                    width="40"
                                    height="40"
                                    alt={`${currency.name} ${t('corporation_logo')}`}
                                />
                                <div class="[ loyalty-rate-cards__heading ]">
                                    <h3 class="[ loyalty-rate-cards__name ]">{tier.label}</h3>
                                    <small class="[ loyalty-rate-cards__currency ]">{currency.name}</small>
                                </div>
                                {paused && (
                                    <Tag
                                        text={t('industry.loyalty.rates.paused')}
                                        color="fleet-red"
                                        narrow={true}
                                        title={t('industry.loyalty.rates.paused_tip')}
                                    />
                                )}
                            </div>
                            <p class="[ loyalty-rate-cards__description ]">{tier.description}</p>
                            <p class="[ loyalty-rate-cards__price ]">
                                {tier.price ? (
                                    <>
                                        <span class="[ loyalty-rate-cards__price-value ]">
                                            {number_thousand_separator(tier.price)}
                                        </span>
                                        <span class="[ loyalty-rate-cards__price-unit ]">
                                            {t('industry.loyalty.rates.isk_per_lp')}
                                        </span>
                                    </>
                                ) : (
                                    <span class="[ loyalty-rate-cards__unavailable ]">
                                        {t('industry.loyalty.tier.express_unavailable')}
                                    </span>
                                )}
                            </p>
                        </div>
                    </ComponentBlock>
                ))}
            </Grid>
        )}
    </Flexblock>
</section>

<style lang="scss">
    h2 {
        font-size: var(--step-1);
        margin: 0;
    }

    .loyalty-rate-cards :global(.loyalty-rate-cards__card) {
        height: 100%;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
    }

    .loyalty-rate-cards :global(.loyalty-rate-cards__card--express) {
        box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--fleet-yellow) 45%, transparent);
    }

    .loyalty-rate-cards__body {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        flex: 1;
        min-width: 0;
    }

    .loyalty-rate-cards__identity {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        gap: var(--space-xs);
        min-width: 0;
    }

    .loyalty-rate-cards__heading {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-width: 0;
    }

    .loyalty-rate-cards__name {
        margin: 0;
        min-width: 0;
        font-size: var(--step-0);
        line-height: 1.15;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--highlight);
    }

    .loyalty-rate-cards__currency {
        font-size: var(--step--2);
        color: var(--faded);
    }

    .loyalty-rate-cards__logo {
        flex-shrink: 0;
        width: 40px;
        height: 40px;
        border-radius: var(--border-radius);
        background-color: var(--background);
    }

    .loyalty-rate-cards__description {
        margin: 0;
        font-size: var(--step--1);
        color: var(--foreground);
    }

    .loyalty-rate-cards__price {
        margin: 0;
        margin-block-start: auto;
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--space-3xs);
    }

    .loyalty-rate-cards__price-value {
        font-size: var(--step-2);
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        color: var(--fleet-yellow);
    }

    .loyalty-rate-cards__price-unit {
        font-size: var(--step--1);
        color: var(--foreground);
    }

    .loyalty-rate-cards__unavailable {
        font-size: var(--step--1);
        color: var(--faded);
    }

    .loyalty-rate-cards__empty {
        margin: 0;
        color: var(--highlight);
    }
</style>
