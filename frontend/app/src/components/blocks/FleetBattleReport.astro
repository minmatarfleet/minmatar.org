---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { FleetFights, FleetFightRound, FleetBattleReport } from '@helpers/api.minmatar.org/fleets'
import type { BattlePilotRow } from '@dtypes/layout_components'
import { format_isk } from '@helpers/numbers'
import { get_item_icon, get_corporation_logo, get_alliance_logo, get_group_logo } from '@helpers/eve_image_server'
import { eve_clock, format_damage, ship_group_rank } from '@helpers/fleet_fights'
import { get_ships_type } from '@helpers/sde/ships'
import { query_string } from '@helpers/string'
import IntelBlocTag from '@components/blocks/IntelBlocTag.astro'

/**
 * One engagement's battle report, laid out like br.evetools: a Team card
 * per side (ISK lost, efficiency, ships lost, damage dealt, and its groups
 * with « » to move them to the next team), then the Involved, Summary,
 * Timeline, Damage and Composition views per team. Every mail in the
 * engagement's systems from a minute before it to a minute after.
 *
 * Views, row expansion and display settings are local (Alpine over rendered
 * rows). Moving a group re-renders the report from the API
 * (fleet_battle_report_component), and the sides stay in the URL.
 */
interface Props {
    report:             FleetBattleReport;
    fights:             FleetFights;
    /** 1-based position in the rounds list. */
    position:           number;
    fleet_id:           number;
    [propName: string]: any;
}

const {
    report,
    fights,
    position,
    fleet_id,
    ...attributes
} = Astro.props

delete attributes.class

const LETTERS = ['A', 'B', 'C']
const MEMBERS_SHOWN = 10
const CAPSULE_IDS = [670, 33328]

const href = (at: number) => translatePath(`/fleets/history/${fleet_id}/rounds/${at}`)
const back = translatePath(fights.live ? `/fleets/upcoming/${fleet_id}#aar` : `/fleets/history/${fleet_id}#aar`)
const previous = position > 1 ? fights.rounds[position - 2] : null
const next = position < fights.rounds.length ? fights.rounds[position] : null
const label = (round: FleetFightRound) => round.kind === 'round' ?
    t('fleets.fights.round').replace('{number}', (round.number ?? 0).toString()) :
    t('fleets.fights.skirmish')
const title = report.kind === 'round' ?
    t('fleets.fights.report_title').replace('{number}', (report.number ?? 0).toString()).replace('{total}', fights.round_count.toString()) :
    t('fleets.fights.report_skirmish').replace('{time}', eve_clock(report.start))

const day = new Date(report.window_start).toISOString().slice(0, 10)
const total_isk = report.killmails.reduce((sum, mail) => sum + mail.isk, 0)
const pilots_total = report.teams.reduce((sum, team) => sum + team.totals.pilots, 0)

// Hull classes from the SDE, for sorting and the Summary groups.
const type_ids = [...new Set([
    ...report.teams.flatMap(team => team.pilots.flatMap(pilot => pilot.ships.map(ship => ship.type_id))),
    ...report.killmails.map(mail => mail.ship_type_id),
].filter((id): id is number => Boolean(id)))]
let ship_groups = new Map<number, string>()
try {
    ship_groups = new Map((await get_ships_type(type_ids)).map(ship => [ship.ship_id, ship.type]))
} catch (error) {
    console.log(`Battle report ship groups: ${error.message}`)
}
const group_of = (type_id: number | null) => (type_id && ship_groups.get(type_id)) || t('fleets.report.other_ships')

const mail_isk = new Map(report.killmails.map(mail => [mail.id, mail.isk]))
const teams_sorted = [...report.teams].sort((a, b) => a.index - b.index)
const last_index = Math.max(...teams_sorted.map(team => team.index))
const can_open_team = teams_sorted.length < 3

const PARTIAL_URL = translatePath('/partials/fleet_battle_report_component')
const PAGE_URL = translatePath(`/fleets/history/${fleet_id}/rounds/${position}`)
const move_query = (group: number, team: number) => query_string({ fleet_id, position, sides: report.sides, group, team })
const page_query = (group: number, team: number) => query_string({ sides: report.sides, group, team })
const RESET_URL = `${PARTIAL_URL}?${query_string({ fleet_id, position })}`

const teams = teams_sorted.map(team => {
    const name = t('fleets.report.team').replace('{letter}', LETTERS[team.index] ?? `${team.index + 1}`)
    const max_damage = Math.max(0, ...team.pilots.map(pilot => pilot.damage))
    const max_kills = Math.max(0, ...team.pilots.map(pilot => pilot.kills))

    const members = team.groups.map(group => ({
        ...group,
        logo: get_group_logo(group.id, 32, group.kind),
        left: team.index > 0 ? team.index - 1 : null,
        right: team.index < last_index ? team.index + 1 : can_open_team ? last_index + 1 : null,
    }))

    const rows: (BattlePilotRow & { rank: number, damage_value: number })[] = team.pilots.map(pilot => {
        const hulls = pilot.ships.filter(ship => ship.type_id && !CAPSULE_IDS.includes(ship.type_id))
        const lost = hulls.filter(ship => ship.lost)
        const main = lost[0] ?? hulls[0] ?? pilot.ships[0]
        const pod = pilot.ships.find(ship => ship.lost && ship.type_id && CAPSULE_IDS.includes(ship.type_id))
        const loss_value = lost.reduce((sum, ship) => sum + (mail_isk.get(ship.killmail_id ?? 0) ?? 0), 0)
        return {
            character_id: pilot.character_id,
            name: pilot.name,
            icon_type_id: main?.type_id ?? null,
            ship: main?.name ?? '',
            killmail_id: main?.lost ? main.killmail_id ?? null : null,
            pod_killmail_id: pod?.killmail_id ?? null,
            lost: lost.length > 0,
            loss: lost.length > 1 ?
                t('fleets.report.lost_many').replace('{count}', lost.length.toString()).replace('{isk}', format_isk(loss_value)) :
                loss_value ? format_isk(loss_value) : '',
            damage: pilot.damage ? `${format_damage(pilot.damage)} (${(100 * pilot.damage / Math.max(1, team.totals.damage)).toFixed(1)}%)` : '0',
            damage_top: pilot.damage > 0 && pilot.damage === max_damage,
            kills: pilot.kills,
            kills_top: pilot.kills > 0 && pilot.kills === max_kills,
            corporation_id: pilot.corporation_id ?? null,
            corporation_name: pilot.corporation_name,
            alliance_id: pilot.alliance_id ?? null,
            alliance_name: pilot.alliance_name,
            extras: hulls.map(ship => ({
                type_id: ship.type_id as number,
                name: ship.name,
                lost: ship.lost,
                killmail_id: ship.lost ? ship.killmail_id ?? null : null,
                info: ship.lost ? t('fleets.report.one_lost').replace('{isk}', format_isk(mail_isk.get(ship.killmail_id ?? 0) ?? 0)) : '',
            })),
            rank: ship_group_rank(group_of(main?.type_id ?? null)),
            damage_value: pilot.damage,
        }
    })
    const involved = [...rows].sort((a, b) => a.rank - b.rank || Number(b.lost) - Number(a.lost) || b.damage_value - a.damage_value)
    const by_damage = [...rows].sort((a, b) => b.damage_value - a.damage_value)

    const types = new Map<number, { type_id: number, name: string, group: string, flying: number, lost: number, isk: number }>()
    team.pilots.forEach(pilot => pilot.ships.forEach(ship => {
        if (!ship.type_id) return
        const entry = types.get(ship.type_id) ?? { type_id: ship.type_id, name: ship.name, group: group_of(ship.type_id), flying: 0, lost: 0, isk: 0 }
        entry.flying += 1
        if (ship.lost) {
            entry.lost += 1
            entry.isk += mail_isk.get(ship.killmail_id ?? 0) ?? 0
        }
        types.set(ship.type_id, entry)
    }))
    const summary = [...types.values()].sort((a, b) => ship_group_rank(a.group) - ship_group_rank(b.group) || b.flying - a.flying)
    const summary_groups = [...summary.reduce((groups, entry) => {
        const group = groups.get(entry.group) ?? { name: entry.group, flying: 0, lost: 0, isk: 0 }
        group.flying += entry.flying
        group.lost += entry.lost
        group.isk += entry.isk
        return groups.set(entry.group, group)
    }, new Map<string, { name: string, flying: number, lost: number, isk: number }>()).values()]

    const timeline = report.killmails.map(mail => mail.team === team.index ? mail : null)

    type CorpCount = { id: number, name: string, pilots: number }
    type GroupCount = { id: number, name: string, logo: string, pilots: number, corps: Map<number, CorpCount> }
    const composition = [...team.pilots.reduce((groups, pilot) => {
        const key = pilot.alliance_id ?? pilot.corporation_id ?? 0
        const group = groups.get(key) ?? {
            id: key,
            name: pilot.alliance_id ? pilot.alliance_name : pilot.corporation_name,
            logo: pilot.alliance_id ? get_alliance_logo(key, 64) : get_corporation_logo(key, 64),
            pilots: 0,
            corps: new Map<number, CorpCount>(),
        }
        group.pilots += 1
        if (pilot.alliance_id && pilot.corporation_id) {
            const corp = group.corps.get(pilot.corporation_id) ?? { id: pilot.corporation_id, name: pilot.corporation_name, pilots: 0 }
            corp.pilots += 1
            group.corps.set(pilot.corporation_id, corp)
        }
        return groups.set(key, group)
    }, new Map<number, GroupCount>()).values()]
        .map(group => ({ ...group, corps: [...group.corps.values()].sort((a, b) => b.pilots - a.pilots) }))
        .sort((a, b) => b.pilots - a.pilots)

    return {
        ...team,
        name,
        members,
        involved,
        by_damage,
        summary,
        summary_groups,
        timeline,
        composition,
    }
})

const views = [
    { id: 'involved', label: t('fleets.report.involved') },
    { id: 'summary', label: t('fleets.report.summary') },
    { id: 'timeline', label: t('fleets.report.timeline') },
    { id: 'damage', label: t('fleets.report.damage') },
    { id: 'composition', label: t('fleets.report.composition') },
]

import FleetBattlePilotRow from '@components/blocks/FleetBattlePilotRow.astro'
---

<div
    id="battle-report"
    class:list={['[ br ]', Astro.props.class]}
    x-data={`{
        view: 'involved',
        members_open: false,
        settings_open: false,
        extended: $persist(true).as('battle_report_extended'),
        expand_ships: $persist(false).as('battle_report_expand_ships'),
    }`}
    x-on:keydown.escape="settings_open = false"
    {...attributes}
>
    <header class="[ br__bar ]">
        <div class="[ br__bar-group ]">
            <a class="[ br__button ]" href={back}>‹ {t('fleets.fights.back')}</a>
            <span class="[ br__step ]">
                {previous ?
                    <a class="[ br__arrow ]" href={href(position - 1)} aria-label={label(previous)}>‹</a> :
                    <span class="[ br__arrow ]" aria-hidden="true">‹</span>
                }
                <b>{title}</b>
                {next ?
                    <a class="[ br__arrow ]" href={href(position + 1)} aria-label={label(next)}>›</a> :
                    <span class="[ br__arrow ]" aria-hidden="true">›</span>
                }
            </span>
        </div>
        <div class="[ br__bar-group ]">
            <span class="[ br__status ]">{t('fleets.report.status').replace('{count}', report.killmails.length.toString())}</span>
            {report.sides &&
                <button type="button" class="[ br__button ]" hx-get={RESET_URL} hx-target="#battle-report" hx-swap="outerHTML">{t('fleets.report.reset')}</button>
            }
            <button type="button" class="[ br__button br__button--icon ]" aria-label={t('fleets.report.settings')} x-on:click="settings_open = true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z" /></svg>
            </button>
        </div>
    </header>

    <nav class="[ br__tabs ]" role="tablist" aria-label={t('fleets.report.views')}>
        {views.map(view =>
            <button
                type="button"
                role="tab"
                class="[ br__tab ]"
                aria-selected={view.id === 'involved' ? 'true' : 'false'}
                x-bind:aria-selected={`String(view === '${view.id}')`}
                x-on:click={`view = '${view.id}'`}
            >{view.label}</button>
        )}
    </nav>

    <section class="[ br__info ]" aria-label={t('fleets.report.engagement')}>
        <div>
            <b>{day}, {eve_clock(report.window_start)} – {eve_clock(report.window_end)} ET</b>
            <span>{t('fleets.report.duration').replace('{minutes}', report.minutes.toString())}</span>
        </div>
        <div>
            <b>{t('fleets.report.totals').replace('{mails}', report.killmails.length.toString()).replace('{pilots}', pilots_total.toString()).replace('{isk}', format_isk(total_isk))}</b>
            {!report.complete && <span>{t('fleets.report.partial')}</span>}
        </div>
        <div class="[ br__systems ]">
            {report.systems.map(system =>
                <a href={`https://evemaps.dotlan.net/system/${encodeURIComponent(system.name.replace(/ /g, '_'))}`} target="_blank" rel="noopener noreferrer">{system.name} ↗</a>
            )}
        </div>
    </section>

    <div class="[ br__scroll ]">
        <div class="[ br__grid ]" style={`grid-template-columns: repeat(${teams.length}, minmax(min(85vw, 22rem), 35rem))`}>
            {teams.map((team, column) =>
                <section class="[ br__team ]" style={`grid-row: 1; grid-column: ${column + 1}`} aria-labelledby={`br-team-${team.index}`}>
                    <h3 id={`br-team-${team.index}`}>{team.name} ({team.totals.pilots})</h3>
                    <dl class="[ br__stats ]">
                        <div><dt>{t('fleets.report.isk_lost')}</dt><dd>{format_isk(team.totals.isk_lost)}</dd></div>
                        <div><dt>{t('fleets.report.efficiency')}</dt><dd>{team.totals.efficiency !== null && team.totals.efficiency !== undefined ? `${team.totals.efficiency}%` : '–'}</dd></div>
                        <div><dt>{t('fleets.report.ships_lost')}</dt><dd>{t('fleets.report.ships').replace('{count}', team.totals.ships_lost.toString())}</dd></div>
                        <div><dt>{t('fleets.report.inflicted')}</dt><dd>{format_damage(team.totals.damage)}</dd></div>
                    </dl>
                    <ul class="[ br__members ]">
                        {team.members.map((member, index) =>
                            <li
                                x-show={team.members.length > MEMBERS_SHOWN && index >= MEMBERS_SHOWN - 1 ? 'members_open' : undefined}
                                x-cloak={team.members.length > MEMBERS_SHOWN && index >= MEMBERS_SHOWN - 1 ? '' : undefined}
                            >
                                {member.left !== null ?
                                    <a
                                        class="[ br__move ]"
                                        href={`${PAGE_URL}?${page_query(member.id, member.left)}`}
                                        hx-get={`${PARTIAL_URL}?${move_query(member.id, member.left)}`}
                                        hx-target="#battle-report"
                                        hx-swap="outerHTML"
                                        aria-label={t('fleets.report.move').replace('{name}', member.name).replace('{team}', LETTERS[member.left] ?? '')}
                                    >«</a> :
                                    <span />
                                }
                                <span class="[ br__member ]">
                                    <img src={member.logo} alt="" width="22" height="22" loading="lazy" />
                                    <span class="[ br__muted ]">({member.pilots})</span>
                                    <a href={`https://zkillboard.com/${member.kind}/${member.id}/`} target="_blank" rel="noopener noreferrer">{member.name}</a>
                                    {member.bloc && <IntelBlocTag bloc={member.bloc} />}
                                </span>
                                {member.right !== null ?
                                    <a
                                        class="[ br__move ]"
                                        href={`${PAGE_URL}?${page_query(member.id, member.right)}`}
                                        hx-get={`${PARTIAL_URL}?${move_query(member.id, member.right)}`}
                                        hx-target="#battle-report"
                                        hx-swap="outerHTML"
                                        aria-label={t('fleets.report.move').replace('{name}', member.name).replace('{team}', LETTERS[member.right] ?? '')}
                                    >»</a> :
                                    <span />
                                }
                            </li>
                        )}
                    </ul>
                    {team.members.length > MEMBERS_SHOWN &&
                        <button type="button" class="[ br__expand ]" x-on:click="members_open = !members_open" x-bind:aria-expanded="String(members_open)">
                            <span x-show="!members_open">⌄ {t('fleets.report.more_groups').replace('{count}', (team.members.length - MEMBERS_SHOWN + 1).toString())}</span>
                            <span x-show="members_open" x-cloak>⌃ {t('fleets.after.show_fewer')}</span>
                        </button>
                    }
                </section>
            )}

            {teams.map((team, column) =>
                <section class="[ br__view ]" style={`grid-row: 2; grid-column: ${column + 1}`} aria-label={team.name}>
                    {[{ id: 'involved', rows: team.involved }, { id: 'damage', rows: team.by_damage }].map(list =>
                        <div x-show={`view === '${list.id}'`} x-cloak={list.id === 'involved' ? undefined : ''}>
                            <div class="[ br__head ]">
                                <button
                                    type="button"
                                    class="[ br__expand br__expand--icon ]"
                                    x-on:click="expand_ships = !expand_ships"
                                    x-bind:aria-label={`expand_ships ? ${JSON.stringify(t('fleets.report.collapse_all_ships'))} : ${JSON.stringify(t('fleets.report.expand_all_ships'))}`}
                                    aria-label={t('fleets.report.expand_all_ships')}
                                ><span x-text="expand_ships ? '⌃' : '⌄'">⌄</span></button>
                                <div class="[ br__head-cols ]">
                                    <div class="[ br__head-gold ]"><span>{t('fleets.report.col_pilot')}</span><span>{t('fleets.report.col_used')}</span></div>
                                    <div><span>{t('fleets.report.col_ship')}</span><span>{t('fleets.report.col_damage')}</span></div>
                                </div>
                                <span>{t('fleets.report.col_corp')}</span>
                                <span>{t('fleets.report.col_ally')}</span>
                            </div>
                            {list.rows.map(row => <FleetBattlePilotRow row={row} />)}
                        </div>
                    )}

                    <div x-show="view === 'summary'" x-cloak x-data="{ grouped: false }">
                        <button type="button" class="[ br__summary-toggle ]" x-on:click="grouped = !grouped">
                            <span x-show="!grouped">{t('fleets.report.ship_types_title')}</span>
                            <span x-show="grouped" x-cloak>{t('fleets.report.ship_groups_title')}</span>
                            <small>{t('fleets.report.click_to_change')}</small>
                        </button>
                        <div x-show="!grouped">
                            {team.summary.map(entry =>
                                <div class="[ br__sum ]">
                                    <img src={get_item_icon(entry.type_id, 64)} alt="" width="36" height="36" loading="lazy" />
                                    <span class="[ br__sum-names ]"><b>{entry.name}</b><small>{entry.group}</small></span>
                                    <span class="[ br__num ]">{entry.flying}</span>
                                    <span class="[ br__red ]">{entry.lost || ''}</span>
                                    <span class:list={['[ br__red ]', { 'br__red--bold': entry.isk >= 1_000_000_000 }]}>{entry.isk ? format_isk(entry.isk) : ''}</span>
                                </div>
                            )}
                        </div>
                        <div x-show="grouped" x-cloak>
                            {team.summary_groups.map(group =>
                                <div class="[ br__sum br__sum--group ]">
                                    <span class="[ br__sum-names ]"><b>{group.name}</b></span>
                                    <span class="[ br__num ]">{group.flying}</span>
                                    <span class="[ br__red ]">{group.lost || ''}</span>
                                    <span class:list={['[ br__red ]', { 'br__red--bold': group.isk >= 1_000_000_000 }]}>{group.isk ? format_isk(group.isk) : ''}</span>
                                </div>
                            )}
                        </div>
                    </div>

                    <div x-show="view === 'timeline'" x-cloak>
                        {team.timeline.map(mail => mail ?
                            <div class="[ br__tl br__tl--loss ]">
                                <a href={`https://zkillboard.com/kill/${mail.id}/`} target="_blank" rel="noopener noreferrer" aria-label={t('fleets.report.killmail_of').replace('{ship}', mail.ship_name).replace('{pilot}', mail.victim_name)}>
                                    {mail.ship_type_id && <img src={get_item_icon(mail.ship_type_id, 64)} alt="" width="36" height="36" loading="lazy" />}
                                </a>
                                <span class="[ br__tl-body ]">
                                    <span><b>{mail.victim_name}</b><time datetime={mail.time}>{mail.time.slice(11, 19)}</time></span>
                                    <span><span>{mail.ship_name}</span><b>{format_isk(mail.isk)}</b></span>
                                </span>
                                {mail.victim_corporation_id ? <img src={get_corporation_logo(mail.victim_corporation_id, 64)} alt="" width="32" height="32" loading="lazy" /> : <span />}
                                {mail.victim_alliance_id ? <img src={get_alliance_logo(mail.victim_alliance_id, 64)} alt="" width="32" height="32" loading="lazy" /> : <span />}
                            </div>
                            :
                            <div class="[ br__tl ]" aria-hidden="true" />
                        )}
                    </div>

                    <div x-show="view === 'composition'" x-cloak>
                        {team.composition.map(group =>
                            <div class="[ br__ally ]">
                                <span class="[ br__ally-head ]">
                                    <img src={group.logo} alt="" width="40" height="40" loading="lazy" />
                                    <span>({group.pilots}) {group.name}</span>
                                </span>
                                {group.corps.length > 0 &&
                                    <ul>
                                        {group.corps.map(corp =>
                                            <li><img src={get_corporation_logo(corp.id, 32)} alt="" width="20" height="20" loading="lazy" />({corp.pilots}) {corp.name}</li>
                                        )}
                                    </ul>
                                }
                            </div>
                        )}
                    </div>
                </section>
            )}
        </div>
    </div>

    <div class="[ br__backdrop ]" x-show="settings_open" x-cloak x-on:click.self="settings_open = false">
        <section class="[ br__dialog ]" role="dialog" aria-modal="true" aria-labelledby="br-settings-title">
            <header>
                <h2 id="br-settings-title">{t('fleets.report.settings')}</h2>
                <button type="button" class="[ br__button br__button--icon ]" aria-label={t('fleets.report.close_settings')} x-on:click="settings_open = false">✕</button>
            </header>
