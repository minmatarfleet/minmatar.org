---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { FleetBattleReport } from '@helpers/api.minmatar.org/fleets'
import type { BattleScope } from '@helpers/fleet_fights'
import type { BattlePilotRow } from '@dtypes/layout_components'
import { format_isk } from '@helpers/numbers'
import { get_item_icon, get_corporation_logo, get_alliance_logo, get_group_logo } from '@helpers/eve_image_server'
import { eve_clock, format_damage, move_to_side, scope_params, ship_group_rank, strip_bars, strip_position, strip_ticks } from '@helpers/fleet_fights'
import { get_ships_type } from '@helpers/sde/ships'
import { query_string } from '@helpers/string'
import IntelBlocTag from '@components/blocks/IntelBlocTag.astro'

/**
 * A fleet's battle report: the whole fleet, a window a pilot dragged on the
 * activity strip, or a segment the FC saved. One Team card per side (ISK
 * lost, efficiency, ships lost, damage, and its groups with « » to move
 * them), a full-width band for a third party of three pilots or fewer, then
 * the Involved, Summary, Timeline, Damage and Composition views per team.
 *
 * Views, the phone team switcher and dragging the strip are local (Alpine).
 * Every new scope, move or segment re-renders the report from the API
 * (fleet_battle_report_component), and the scope stays in the URL.
 */
interface Props {
    report:             FleetBattleReport;
    fleet_id:           number;
    /** The after action report this report came from. */
    back_href:          string;
    [propName: string]: any;
}

const {
    report,
    fleet_id,
    back_href,
    ...attributes
} = Astro.props

delete attributes.class

const LETTERS = ['A', 'B', 'C']
const GROUPS_SHOWN = 8
const CAPSULE_IDS = [670, 33328]
const PARTIAL_URL = translatePath('/partials/fleet_battle_report_component')
const PAGE_URL = translatePath(`/fleets/history/${fleet_id}/report`)

const scope: BattleScope = report.segment_id ? { segment: report.segment_id } :
    report.whole ? {} : { start: report.window_start, end: report.window_end }
const page_href = (next: BattleScope) => {
    const query = query_string(scope_params(next))
    return query ? `${PAGE_URL}?${query}` : PAGE_URL
}
const partial_href = (next: BattleScope) => `${PARTIAL_URL}?${query_string({ fleet_id, ...scope_params(next) })}`

const window_label = (start: string, end: string) => t('fleets.report.window').replace('{start}', eve_clock(start)).replace('{end}', eve_clock(end))
const segment = report.segments.find(entry => entry.id === report.segment_id)
const title = report.whole ? t('fleets.report.whole_fleet') : segment ? segment.name : window_label(report.window_start, report.window_end)
const duration = report.minutes >= 60 ?
    t('fleets.report.hours').replace('{hours}', Math.floor(report.minutes / 60).toString()).replace('{minutes}', (report.minutes % 60).toString()) :
    t('fleets.report.minutes').replace('{minutes}', report.minutes.toString())
const meta = t('fleets.report.meta')
    .replace('{date}', report.start.slice(0, 10))
    .replace('{start}', eve_clock(report.start))
    .replace('{end}', eve_clock(report.end))
    .replace('{duration}', duration)
const total_isk = report.killmails.reduce((sum, mail) => sum + mail.isk, 0)
const pilots_total = report.teams.reduce((sum, team) => sum + team.totals.pilots, 0)
const empty = report.killmails.length === 0

// The activity strip: the whole fleet, whatever the scope.
const bars = strip_bars(report)
const ticks = strip_ticks(report)
const selection = report.whole ? null : {
    left: strip_position(report, report.window_start),
    right: strip_position(report, report.window_end),
}
const span_ms = [new Date(report.span_start).getTime(), new Date(report.span_end).getTime()]
const fights_ms = report.fights.map(fight => [new Date(fight.start).getTime(), new Date(fight.end).getTime()])
const strip_data = `{
    span: ${JSON.stringify(span_ms)},
    fights: ${JSON.stringify(fights_ms)},
    drag: null,
    at(event) {
        const box = this.$refs.strip.getBoundingClientRect()
        const share = Math.min(1, Math.max(0, (event.clientX - box.left) / box.width))
        return this.span[0] + share * (this.span[1] - this.span[0])
    },
    down(event) {
        if (event.button !== 0) return
        this.$refs.strip.setPointerCapture(event.pointerId)
        const at = this.at(event)
        this.drag = { from: at, to: at }
    },
    move(event) {
        if (this.drag) this.drag.to = this.at(event)
    },
    up() {
        if (!this.drag) return
        let from = Math.min(this.drag.from, this.drag.to)
        let to = Math.max(this.drag.from, this.drag.to)
        this.drag = null
        if (to - from < 45000) {
            const fight = this.fights.find(([start, end]) => from >= start - 30000 && from <= end + 30000)
            if (!fight) return
            ;[from, to] = fight
        }
        this.$refs.start.value = new Date(from).toISOString()
        this.$refs.end.value = new Date(to).toISOString()
        this.$refs.form.requestSubmit()
    },
    pct(at) {
        return 100 * (at - this.span[0]) / (this.span[1] - this.span[0])
    },
    get drag_style() {
        if (!this.drag) return ''
        const from = this.pct(Math.min(this.drag.from, this.drag.to))
        const to = this.pct(Math.max(this.drag.from, this.drag.to))
        return 'left: ' + from + '%; width: ' + (to - from) + '%'
    },
}`

const chips = [
    { name: t('fleets.report.whole_fleet'), range: window_label(report.span_start, report.span_end), on: report.whole, scope: {}, segment: null },
    ...report.segments.map(entry => ({
        name: entry.name,
        range: window_label(entry.start, entry.end),
        on: entry.id === report.segment_id,
        scope: { segment: entry.id },
        segment: entry,
    })),
]
const show_save = !report.whole && !report.segment_id && report.can_edit_segments

// Hull classes from the SDE, for sorting and the Summary.
const type_ids = [...new Set([
    ...report.teams.flatMap(team => team.pilots.flatMap(pilot => pilot.ships.map(ship => ship.type_id))),
    ...report.killmails.map(mail => mail.ship_type_id),
].filter((id): id is number => Boolean(id)))]
let ship_groups = new Map<number, string>()
try {
    ship_groups = new Map((await get_ships_type(type_ids)).map(ship => [ship.ship_id, ship.type]))
} catch (error) {
    console.log(`Battle report ship groups: ${error.message}`)
}
const group_of = (type_id: number | null | undefined) => (type_id && ship_groups.get(type_id)) || t('fleets.report.other_ships')

const mail_isk = new Map(report.killmails.map(mail => [mail.id, mail.isk]))
const teams_sorted = [...report.teams].sort((a, b) => a.index - b.index)
const last_index = Math.max(...teams_sorted.map(team => team.index))
const can_open_team = teams_sorted.length < 3
// With three sides, the smallest one (ties go to the later team) folds into a
// full-width band when it has three pilots or fewer, so the two real sides
// keep the width.
const band_team = teams_sorted.length >= 3 ?
    teams_sorted.reduce((smallest, team) => team.totals.pilots <= smallest.totals.pilots ? team : smallest) : null
const pilots_text = (count: number) => count === 1 ? t('fleets.report.pilot_one') : t('fleets.report.pilot_count').replace('{count}', count.toString())

const teams = teams_sorted.map((team, position) => {
    const letter = LETTERS[team.index] ?? `${team.index + 1}`
    const max_damage = Math.max(0, ...team.pilots.map(pilot => pilot.damage))
    const max_kills = Math.max(0, ...team.pilots.map(pilot => pilot.kills))

    const members = team.groups.map((group, index) => {
        const left = team.index > 0 ? team.index - 1 : null
        const right = team.index < last_index ? team.index + 1 : can_open_team ? last_index + 1 : null
        const move = (to: number) => ({ ...scope, sides: move_to_side(report.sides, group.id, to) })
        return {
            ...group,
            logo: get_group_logo(group.id, 32, group.kind),
            hidden: team.groups.length > GROUPS_SHOWN + 1 && index >= GROUPS_SHOWN,
            left: left === null ? null : { href: page_href(move(left)), partial: partial_href(move(left)), label: t('fleets.report.move').replace('{name}', group.name).replace('{team}', LETTERS[left] ?? '') },
            right: right === null ? null : { href: page_href(move(right)), partial: partial_href(move(right)), label: t('fleets.report.move').replace('{name}', group.name).replace('{team}', LETTERS[right] ?? '') },
        }
    })

    const pilot_rows = team.pilots.map(pilot => {
        const hulls = pilot.ships.filter(ship => ship.type_id && !CAPSULE_IDS.includes(ship.type_id))
        const lost = hulls.filter(ship => ship.lost)
        const main = lost[0] ?? hulls[0] ?? pilot.ships[0]
        const pod = pilot.ships.find(ship => ship.lost && ship.type_id && CAPSULE_IDS.includes(ship.type_id))
        const loss_value = lost.reduce((sum, ship) => sum + (mail_isk.get(ship.killmail_id ?? 0) ?? 0), 0)
        const row: BattlePilotRow = {
            character_id: pilot.character_id,
            name: pilot.name,
            icon_type_id: main?.type_id ?? null,
            ship: main?.name ?? '',
            killmail_id: main?.lost ? main.killmail_id ?? null : null,
            pod_killmail_id: pod?.killmail_id ?? null,
            pod_title: pod ? t('fleets.report.pod_lost').replace('{isk}', format_isk(mail_isk.get(pod.killmail_id ?? 0) ?? 0)) : '',
            lost: lost.length > 0,
            loss: loss_value ? format_isk(loss_value) : '',
            loss_note: lost.length > 1 ? t('fleets.report.hulls').replace('{count}', lost.length.toString()) : '',
            damage: format_damage(pilot.damage),
            share: team.totals.damage ? `${(100 * pilot.damage / team.totals.damage).toFixed(1)}%` : '',
            damage_top: pilot.damage > 0 && pilot.damage === max_damage,
            kills: pilot.kills,
            kills_top: pilot.kills > 0 && pilot.kills === max_kills,
            corporation_id: pilot.corporation_id ?? null,
            corporation_name: pilot.corporation_name,
            alliance_id: pilot.alliance_id ?? null,
            alliance_name: pilot.alliance_name,
            extras: hulls.filter(ship => ship !== main).map(ship => ({
                type_id: ship.type_id as number,
                title: ship.lost ? t('fleets.report.hull_lost').replace('{ship}', ship.name).replace('{isk}', format_isk(mail_isk.get(ship.killmail_id ?? 0) ?? 0)) : ship.name,
                lost: ship.lost,
                killmail_id: ship.lost ? ship.killmail_id ?? null : null,
            })),
        }
        return { row, rank: ship_group_rank(group_of(main?.type_id)), damage: pilot.damage }
    })
    const involved = [...pilot_rows].sort((a, b) => a.rank - b.rank || Number(b.row.lost) - Number(a.row.lost) || b.damage - a.damage)
    const by_damage = [...pilot_rows].sort((a, b) => b.damage - a.damage)
        .map(entry => ({ ...entry.row, bar: max_damage ? 100 * entry.damage / max_damage : 0 }))

    type TypeEntry = { type_id: number, name: string, group: string, flown: number, lost: number, isk: number }
    const types = new Map<number, TypeEntry>()
    team.pilots.forEach(pilot => pilot.ships.forEach(ship => {
        if (!ship.type_id || CAPSULE_IDS.includes(ship.type_id)) return
        const entry = types.get(ship.type_id) ?? { type_id: ship.type_id, name: ship.name, group: group_of(ship.type_id), flown: 0, lost: 0, isk: 0 }
        entry.flown += 1
        if (ship.lost) {
            entry.lost += 1
            entry.isk += mail_isk.get(ship.killmail_id ?? 0) ?? 0
        }
        types.set(ship.type_id, entry)
    }))
    const classes = [...[...types.values()].reduce((by_class, entry) => {
        const list = by_class.get(entry.group) ?? []
        list.push(entry)
        return by_class.set(entry.group, list)
    }, new Map<string, TypeEntry[]>()).entries()]
        .sort((a, b) => ship_group_rank(a[0]) - ship_group_rank(b[0]))
        .map(([name, entries]) => ({
            name,
            flown: entries.reduce((sum, entry) => sum + entry.flown, 0),
            lost: entries.reduce((sum, entry) => sum + entry.lost, 0),
            types: entries.sort((a, b) => b.flown - a.flown),
        }))

    type CorpCount = { id: number, name: string, pilots: number }
    type GroupCount = { id: number, name: string, logo: string, pilots: number, alliance: boolean, corps: Map<number, CorpCount>, hulls: Map<number, { type_id: number, name: string, count: number }> }
    const composition = [...team.pilots.reduce((groups, pilot) => {
        const key = pilot.alliance_id ?? pilot.corporation_id ?? 0
        const group = groups.get(key) ?? {
            id: key,
            name: pilot.alliance_id ? pilot.alliance_name : pilot.corporation_name,
            logo: pilot.alliance_id ? get_alliance_logo(key, 64) : get_corporation_logo(key, 64),
            pilots: 0,
            alliance: Boolean(pilot.alliance_id),
            corps: new Map<number, CorpCount>(),
            hulls: new Map(),
        }
        group.pilots += 1
        if (pilot.alliance_id && pilot.corporation_id) {
            const corp = group.corps.get(pilot.corporation_id) ?? { id: pilot.corporation_id, name: pilot.corporation_name, pilots: 0 }
            corp.pilots += 1
            group.corps.set(pilot.corporation_id, corp)
        }
        pilot.ships.forEach(ship => {
            if (!ship.type_id || CAPSULE_IDS.includes(ship.type_id)) return
            const hull = group.hulls.get(ship.type_id) ?? { type_id: ship.type_id, name: ship.name, count: 0 }
            hull.count += 1
            group.hulls.set(ship.type_id, hull)
        })
        return groups.set(key, group)
    }, new Map<number, GroupCount>()).values()]
        .map(group => ({
            ...group,
            share: team.totals.pilots ? Math.round(100 * group.pilots / team.totals.pilots) : 0,
            corps: [...group.corps.values()].sort((a, b) => b.pilots - a.pilots),
            hulls: [...group.hulls.values()].sort((a, b) => b.count - a.count).slice(0, 5),
        }))
        .sort((a, b) => b.pilots - a.pilots)

    return {
        ...team,
        position,
        letter,
        name: t('fleets.report.team').replace('{letter}', letter),
        pilots_text: pilots_text(team.totals.pilots),
        tiny: team === band_team && team.totals.pilots <= 3,
        members,
        hidden_groups: members.filter(member => member.hidden).length,
        involved: involved.map(entry => entry.row),
        by_damage,
        classes,
        composition,
    }
})

const columns = teams.filter(team => !team.tiny)
const bands = teams.filter(team => team.tiny)
const grid_columns = `repeat(${Math.max(1, columns.length)}, minmax(0, 1fr))`
const view_row = bands.length ? 3 : 2

const matchup_classes = [...new Set(columns.flatMap(team => team.classes.map(entry => entry.name)))]
    .sort((a, b) => ship_group_rank(a) - ship_group_rank(b))
const class_of = (team: typeof teams[number], name: string) => team.classes.find(entry => entry.name === name)
const matchup_max = Math.max(1, ...matchup_classes.flatMap(name => columns.map(team => class_of(team, name)?.flown ?? 0)))
const matchup = matchup_classes.map(name => ({
    name,
    cells: columns.map(team => {
        const entry = class_of(team, name)
        return { flown: entry?.flown ?? 0, lost: entry?.lost ?? 0 }
    }),
}))

// The timeline: one row per killmail, in the column of the team that lost
// it, with a divider each minute. Mails outside the main system say where.
const system_counts = report.killmails.reduce((counts, mail) => counts.set(mail.system_id, (counts.get(mail.system_id) ?? 0) + 1), new Map<number, number>())
const main_system = [...system_counts.entries()].sort((a, b) => b[1] - a[1])[0]?.[0]
const column_index = new Map(columns.map((team, index) => [team.index, index]))
type TimelineItem = { minute: string } | { mail: typeof report.killmails[number], column: number, team: typeof teams[number] }
const timeline: TimelineItem[] = []
let previous_minute = ''
report.killmails.forEach(mail => {
    const column = column_index.get(mail.team)
    if (column === undefined) return
    const minute = eve_clock(mail.time)
    if (minute !== previous_minute) {
        timeline.push({ minute })
        previous_minute = minute
    }
    timeline.push({ mail, column, team: columns[column] })
})

const views = [
    { id: 'involved', label: t('fleets.report.involved') },
    { id: 'summary', label: t('fleets.report.summary') },
    { id: 'timeline', label: t('fleets.report.timeline') },
    { id: 'damage', label: t('fleets.report.damage') },
    { id: 'composition', label: t('fleets.report.composition') },
]

const team_class = (index: number) => `br-team-${Math.min(index, 2)}`
const selected = (position: number) => `{ 'is-sel': team === ${position} }`

import FleetBattlePilotRow from '@components/blocks/FleetBattlePilotRow.astro'
import EmptyState from '@components/blocks/EmptyState.astro'
---

<div
    id="battle-report"
    class:list={['[ br ]', Astro.props.class]}
    x-data="{ view: 'involved', team: 0, groups_open: false }"
    hx-history="false"
    x-bind:class="{ 'br--ready': true, 'br--timeline': view === 'timeline', 'br--summary': view === 'summary' }"
    {...attributes}
>
    <header class="[ br__mast ]">
        <div class="[ br__mast-top ]">
            <a class="[ br__back ]" href={back_href}>‹ {t('fleets.fights.back')}</a>
        </div>
        <div class="[ br__mast-head ]">
            <div>
                <h2 class="[ br__title ]">{title}</h2>
                <p class="[ br__meta ]">
                    <span>{meta}</span>
                    {report.systems.map(system =>
                        <a href={`https://evemaps.dotlan.net/system/${encodeURIComponent(system.name.replace(/ /g, '_'))}`} target="_blank" rel="noopener noreferrer">{system.name} ↗</a>
                    )}
                </p>
            </div>
            <dl class="[ br__totals ]">
                <div><dt class="[ br__cap ]">{t('fleets.report.killmails')}</dt><dd>{report.killmails.length}</dd></div>
                <div><dt class="[ br__cap ]">{t('fleets.report.pilots')}</dt><dd>{pilots_total}</dd></div>
                <div><dt class="[ br__cap ]">{t('fleets.report.isk_destroyed')}</dt><dd>{format_isk(total_isk)}</dd></div>
            </dl>
        </div>
    </header>

    <section class="[ br__panel br__scope ]" aria-label={t('fleets.report.scope')} x-data={strip_data}>
        <div class="[ br__chips ]" role="group" aria-label={t('fleets.report.segments')}>
            {chips.map(chip =>
                <span class:list={['[ br__chip ]', { 'is-on': chip.on }]}>
                    <a
                        href={page_href(chip.scope)}
                        hx-get={partial_href(chip.scope)}
                        hx-target="#battle-report"
                        hx-swap="outerHTML"
                        aria-current={chip.on ? 'true' : undefined}
                    ><b>{chip.name}</b><small>{chip.range}</small></a>
                    {chip.segment && report.can_edit_segments &&
                        <form hx-post={PARTIAL_URL} hx-target="#battle-report" hx-swap="outerHTML">
                            <input type="hidden" name="fleet_id" value={fleet_id} />
                            <input type="hidden" name="action" value="delete" />
                            <input type="hidden" name="segment_id" value={chip.segment.id} />
                            {Object.entries(scope_params(scope)).map(([name, value]) =>
                                <input type="hidden" name={name} value={value} />
                            )}
                            <button type="submit" class="[ br__chip-x ]" aria-label={t('fleets.report.delete_segment').replace('{name}', chip.segment.name)}>✕</button>
                        </form>
                    }
                </span>
            )}
        </div>

        <div
            class="[ br__strip ]"
            role="group"
            aria-label={t('fleets.report.strip').replace('{start}', eve_clock(report.span_start)).replace('{end}', eve_clock(report.span_end))}
            x-ref="strip"
            x-on:pointerdown="down($event)"
            x-on:pointermove="move($event)"
            x-on:pointerup="up()"
        >
            {bars.map(bar =>
                <div class="[ br__bar ]" style={`left: ${bar.left}%; width: ${bar.width}%; height: ${100 * bar.height}%`}>
                    {bar.parts.map(part => <span class={team_class(part.team)} style={`height: ${100 * part.share}%`} />)}
                </div>
            )}
            {selection &&
                <>
                    <div class="[ br__dim ]" style={`left: 0; width: ${selection.left}%`} />
                    <div class="[ br__dim ]" style={`right: 0; width: ${100 - selection.right}%`} />
                    <div class="[ br__sel ]" style={`left: ${selection.left}%; width: ${selection.right - selection.left}%`}>
                        <span>{window_label(report.window_start, report.window_end)}</span>
                    </div>
                </>
            }
            <div class="[ br__drag ]" x-show="drag" x-cloak x-bind:style="drag_style" />
            {ticks.map(tick => <span class="[ br__tick ]" style={`left: ${tick.left}%`}>{tick.label}</span>)}
        </div>
        <form x-ref="form" hx-get={PARTIAL_URL} hx-target="#battle-report" hx-swap="outerHTML" hidden>
            <input type="hidden" name="fleet_id" value={fleet_id} />
            <input type="hidden" name="start" x-ref="start" />
            <input type="hidden" name="end" x-ref="end" />
        </form>

        <p class="[ br__legend ]">
            <span>{t('fleets.report.strip_legend')}</span>
            {teams_sorted.map(team => <span><i class={team_class(team.index)} />{t('fleets.report.team').replace('{letter}', LETTERS[team.index] ?? '')}</span>)}
            <span class="[ br__muted ]">{t('fleets.report.strip_hint')}</span>
        </p>

        {show_save &&
            <form class="[ br__save ]" hx-post={PARTIAL_URL} hx-target="#battle-report" hx-swap="outerHTML">
                <input type="hidden" name="fleet_id" value={fleet_id} />
                <input type="hidden" name="action" value="save" />
                <input type="hidden" name="start" value={report.window_start} />
                <input type="hidden" name="end" value={report.window_end} />
                <span set:html={t('fleets.report.selected').replace('{window}', window_label(report.window_start, report.window_end)).replace('{count}', report.killmails.length.toString())} />
                <label>
                    <span class="[ br__cap ]">{t('fleets.report.segment_name')}</span>
                    <input type="text" name="name" maxlength="64" placeholder={window_label(report.window_start, report.window_end)} />
                </label>
                <button type="submit" class="[ br__button br__button--primary ]">{t('fleets.report.save_segment')}</button>
            </form>
        }
    </section>

    <div class="[ br__tabs ]">
        <div class="[ br__tab-list ]" role="tablist" aria-label={t('fleets.report.views')}>
            {views.map(view =>
                <button
                    type="button"
                    role="tab"
                    class="[ br__tab ]"
                    aria-selected={view.id === 'involved' ? 'true' : 'false'}
                    x-bind:aria-selected={`String(view === '${view.id}')`}
                    x-on:click={`view = '${view.id}'`}
                >{view.label}</button>
            )}
        </div>
        {report.sides &&
            <a class="[ br__button ]" href={page_href(scope)} hx-get={partial_href(scope)} hx-target="#battle-report" hx-swap="outerHTML">{t('fleets.report.reset')}</a>
        }
    </div>

    {!report.complete && <p class="[ br__partial ]">{t('fleets.report.partial')}</p>}

    {empty ?
        <EmptyState title={t('fleets.report.empty')} />
        :
        <>
            <div class="[ br__switch ]" role="group" aria-label={t('fleets.report.team_shown')}>
                {teams.map(team =>
                    <button type="button" x-bind:aria-pressed={`String(team === ${team.position})`} aria-pressed={team.position === 0 ? 'true' : 'false'} x-on:click={`team = ${team.position}`}>
                        <span class:list={['[ br__badge br__badge--s ]', team_class(team.index)]}>{team.letter}</span>
                        <span>{team.pilots_text}</span>
                    </button>
                )}
            </div>

            <div class="[ br__grid ]" style={`grid-template-columns: ${grid_columns}`}>
                {columns.map((team, column) =>
                    <section class="[ br__col br__card-col ]" x-bind:class={selected(team.position)} style={`grid-row: 1; grid-column: ${column + 1}`} aria-labelledby={`br-team-${team.index}`}>
                        <div class="[ br__panel br__card ]">
                            <div class="[ br__card-head ]">
                                <span class:list={['[ br__badge ]', team_class(team.index)]} aria-hidden="true">{team.letter}</span>
                                <h3 id={`br-team-${team.index}`}>{team.name}</h3>
                                <span class="[ br__muted ]">{team.pilots_text}</span>
                                {team.ours && <span class="[ br__ours ]">{t('fleets.report.our_fleet')}</span>}
                            </div>
                            <dl class="[ br__stats ]">
                                <div><dt class="[ br__cap ]">{t('fleets.report.isk_lost')}</dt><dd>{format_isk(team.totals.isk_lost)}</dd></div>
                                <div>
                                    <dt class="[ br__cap ]">{t('fleets.report.efficiency')}</dt>
                                    <dd>{team.totals.efficiency ?? 0}%</dd>
                                    <span class="[ br__eff ]" aria-hidden="true"><span style={`width: ${team.totals.efficiency ?? 0}%`} /></span>
                                </div>
                                <div><dt class="[ br__cap ]">{t('fleets.report.ships_lost')}</dt><dd>{team.totals.ships_lost}</dd></div>
                                <div><dt class="[ br__cap ]">{t('fleets.report.damage_dealt')}</dt><dd>{format_damage(team.totals.damage)}</dd></div>
                            </dl>
                            <ul class="[ br__groups ]">
                                {team.members.map(member =>
                                    <li x-show={member.hidden ? 'groups_open' : undefined} x-cloak={member.hidden ? '' : undefined}>
                                        {member.left ?
                                            <a class="[ br__move ]" href={member.left.href} hx-get={member.left.partial} hx-target="#battle-report" hx-swap="outerHTML" aria-label={member.left.label}>«</a> :
                                            <span />
                                        }
                                        <img src={member.logo} alt="" width="24" height="24" loading="lazy" />
                                        <span class="[ br__group-name ]">
                                            <a href={`https://zkillboard.com/${member.kind}/${member.id}/`} target="_blank" rel="noopener noreferrer" data-tippy-content={member.name}>{member.name}</a>
                                            {member.bloc && <IntelBlocTag bloc={member.bloc} />}
                                        </span>
                                        <span class="[ br__group-count ]">{member.pilots}</span>
                                        {member.right ?
                                            <a class="[ br__move ]" href={member.right.href} hx-get={member.right.partial} hx-target="#battle-report" hx-swap="outerHTML" aria-label={member.right.label}>»</a> :
                                            <span />
                                        }
                                    </li>
                                )}
                            </ul>
                            {team.hidden_groups > 0 &&
                                <button type="button" class="[ br__more ]" x-on:click="groups_open = !groups_open" x-bind:aria-expanded="String(groups_open)">
                                    <span x-show="!groups_open">{t('fleets.report.more_groups').replace('{count}', team.hidden_groups.toString())}</span>
                                    <span x-show="groups_open" x-cloak>{t('fleets.report.fewer_groups')}</span>
                                </button>
                            }
                        </div>
                    </section>
                )}

                {bands.map(team =>
                    <section class="[ br__col br__card-col br__span ]" x-bind:class={selected(team.position)} style="grid-row: 2" aria-labelledby={`br-team-${team.index}`}>
                        <div class="[ br__panel br__band ]">
                            <div class="[ br__band-head ]">
                                <span class:list={['[ br__badge ]', team_class(team.index)]} aria-hidden="true">{team.letter}</span>
                                <h3 id={`br-team-${team.index}`}>{team.name}</h3>
                                <span class="[ br__muted ]">{team.pilots_text} · {t('fleets.report.third_party')}</span>
                                <dl class="[ br__band-stats ]">
                                    <div><dt class="[ br__cap ]">{t('fleets.report.isk_lost')}</dt><dd>{format_isk(team.totals.isk_lost)}</dd></div>
                                    <div><dt class="[ br__cap ]">{t('fleets.report.efficiency')}</dt><dd>{team.totals.efficiency ?? 0}%</dd></div>
                                    <div><dt class="[ br__cap ]">{t('fleets.report.ships_lost')}</dt><dd>{team.totals.ships_lost}</dd></div>
                                    <div><dt class="[ br__cap ]">{t('fleets.report.damage_dealt')}</dt><dd>{format_damage(team.totals.damage)}</dd></div>
                                </dl>
                            </div>
                            <div class="[ br__band-body ]">
                                <ul class="[ br__groups ]">
                                    {team.members.map(member =>
                                        <li>
                                            {member.left ?
                                                <a class="[ br__move ]" href={member.left.href} hx-get={member.left.partial} hx-target="#battle-report" hx-swap="outerHTML" aria-label={member.left.label}>«</a> :
                                                <span />
                                            }
                                            <img src={member.logo} alt="" width="24" height="24" loading="lazy" />
                                            <span class="[ br__group-name ]">
                                                <a href={`https://zkillboard.com/${member.kind}/${member.id}/`} target="_blank" rel="noopener noreferrer">{member.name}</a>
                                                {member.bloc && <IntelBlocTag bloc={member.bloc} />}
                                            </span>
                                            <span class="[ br__group-count ]">{member.pilots}</span>
                                            {member.right ?
                                                <a class="[ br__move ]" href={member.right.href} hx-get={member.right.partial} hx-target="#battle-report" hx-swap="outerHTML" aria-label={member.right.label}>»</a> :
                                                <span />
                                            }
                                        </li>
                                    )}
                                </ul>
                                <div class="[ br__band-pilots ]">
                                    {team.involved.map(row => <div class="[ br__band-cell ]"><FleetBattlePilotRow row={row} /></div>)}
                                </div>
                            </div>
                        </div>
                    </section>
                )}

                {columns.map((team, column) =>
                    <section class="[ br__col ]" x-bind:class={selected(team.position)} x-show="view === 'involved'" style={`grid-row: ${view_row}; grid-column: ${column + 1}`} aria-label={team.name}>
                        <div class="[ br__panel ]">
                            <div class="[ br__head br__head--pilots ]">
                                <span /><span>{t('fleets.report.col_pilot_ship')}</span>
                                <span class="[ br__r br__wide ]">{t('fleets.report.col_damage')}</span>
                                <span class="[ br__r br__wide ]">{t('fleets.report.col_kills')}</span>
                                <span class="[ br__r br__wide ]">{t('fleets.report.col_lost')}</span>
                                <span class="[ br__r ]">{t('fleets.report.col_corp')}</span>
                            </div>
                            {team.involved.map(row => <FleetBattlePilotRow row={row} />)}
                        </div>
                    </section>
                )}

                <section class="[ br__span br__panel br__matchup ]" x-show="view === 'summary'" x-cloak style={`grid-row: ${view_row}`} aria-labelledby="br-matchup">
                    <h3 id="br-matchup">{t('fleets.report.matchup')}</h3>
                    <div class="[ br__matchup-grid ]" style={`grid-template-columns: var(--br-class-col) repeat(${Math.max(1, columns.length)}, minmax(0, 1fr))`}>
                        <span class="[ br__cap ]">{t('fleets.report.col_class')}</span>
                        {columns.map(team =>
                            <span class="[ br__matchup-team ]"><span class:list={['[ br__badge br__badge--s ]', team_class(team.index)]}>{team.letter}</span><span class="[ br__cap ]">{t('fleets.report.col_flown_lost')}</span></span>
                        )}
                        {matchup.map(row =>
                            <>
                                <span class="[ br__matchup-class ]">{row.name}</span>
                                {row.cells.map(cell =>
                                    <span class="[ br__matchup-cell ]">
                                        <span class="[ br__matchup-text ]"><span>{cell.flown || '–'}</span><span class="[ br__loss ]">{cell.lost ? t('fleets.report.lost_count').replace('{count}', cell.lost.toString()) : ''}</span></span>
                                        {cell.flown > 0 &&
                                            <span class="[ br__matchup-bar ]" aria-hidden="true">
                                                <span style={`width: ${100 * cell.flown / matchup_max}%`} />
                                                <span class="[ br__matchup-lost ]" style={`width: ${100 * cell.lost / matchup_max}%`} />
                                            </span>
                                        }
                                    </span>
                                )}
                            </>
                        )}
                    </div>
                </section>

                {columns.map((team, column) =>
                    <section class="[ br__col ]" x-bind:class={selected(team.position)} x-show="view === 'summary'" x-cloak style={`grid-row: ${view_row + 1}; grid-column: ${column + 1}`} aria-label={team.name}>
                        <div class="[ br__panel ]">
                            <div class="[ br__head br__head--types ]">
                                <span /><span>{t('fleets.report.col_ship')}</span>
                                <span class="[ br__r ]">{t('fleets.report.col_flown')}</span>
                                <span class="[ br__r ]">{t('fleets.report.col_lost')}</span>
                                <span class="[ br__r ]">{t('fleets.report.col_isk_lost')}</span>
                            </div>
                            {team.classes.map(entry =>
                                <>
                                    <div class="[ br__class ]">{entry.name}</div>
                                    {entry.types.map(type =>
                                        <div class="[ br__type ]">
                                            <img src={get_item_icon(type.type_id, 64)} alt="" width="28" height="28" loading="lazy" />
                                            <span class="[ br__type-name ]">{type.name}</span>
                                            <span class="[ br__num ]">{type.flown}</span>
                                            <span class="[ br__loss ]">{type.lost || ''}</span>
                                            <span class="[ br__loss ]">{type.isk ? format_isk(type.isk) : ''}</span>
                                        </div>
                                    )}
                                </>
                            )}
                        </div>
                    </section>
                )}

                <section class="[ br__span br__timeline ]" x-show="view === 'timeline'" x-cloak style={`grid-row: ${view_row}`} aria-label={t('fleets.report.timeline')}>
                    {timeline.map(item => 'minute' in item ?
                        <p class="[ br__minute ]">{t('fleets.report.minute').replace('{time}', item.minute)}</p>
                        :
                        <div class="[ br__tl-row ]" style={`grid-template-columns: ${grid_columns}`}>
                            {columns.map((_, column) => column !== item.column ?
                                <span class="[ br__tl-gap ]" aria-hidden="true" />
                                :
                                <a class:list={['[ br__kill ]', { 'br__kill--pod': item.mail.pod }]} href={`https://zkillboard.com/kill/${item.mail.id}/`} target="_blank" rel="noopener noreferrer">
                                    {item.mail.ship_type_id ? <img src={get_item_icon(item.mail.ship_type_id, 64)} alt="" width="36" height="36" loading="lazy" /> : <span />}
                                    <span class="[ br__kill-body ]">
                                        <span class="[ br__kill-line ]">
                                            <span class="[ br__kill-victim ]">
                                                <span class:list={['[ br__badge br__badge--s br__kill-badge ]', team_class(item.team.index)]}>{item.team.letter}</span>
                                                <b>{item.mail.victim_name}</b>
                                            </span>
                                            <span class="[ br__kill-time ]">
                                                {new Date(item.mail.time).toISOString().slice(11, 19)}
                                                {item.mail.system_id !== main_system && <span class="[ br__sys ]">{item.mail.system_name}</span>}
                                            </span>
                                        </span>
                                        <span class="[ br__kill-line ]">
                                            <span class="[ br__kill-ship ]">
                                                {item.mail.ship_name}
                                                {item.mail.final_blow &&
                                                    <span class="[ br__kill-by ]"> · {t('fleets.report.final_blow').replace('{name}', item.mail.final_blow.name)} · {t('fleets.report.on_mail').replace('{count}', item.mail.attackers.toString())}</span>
                                                }
                                            </span>
                                            <b class="[ br__num ]">{item.mail.pod && !item.mail.isk ? t('fleets.report.pod') : format_isk(item.mail.isk)}</b>
                                        </span>
                                        <span class="[ br__kill-foot ]">
                                            {new Date(item.mail.time).toISOString().slice(11, 19)}
                                            {item.mail.system_id !== main_system && <span class="[ br__sys ]">{item.mail.system_name}</span>}
                                            {item.mail.final_blow && <> · {t('fleets.report.final_blow').replace('{name}', item.mail.final_blow.name)}</>}
                                        </span>
                                    </span>
                                    <span class="[ br__logos ]">
                                        {item.mail.victim_corporation_id && <img src={get_corporation_logo(item.mail.victim_corporation_id, 64)} alt="" width="24" height="24" loading="lazy" />}
                                        {item.mail.victim_alliance_id && <img src={get_alliance_logo(item.mail.victim_alliance_id, 64)} alt="" width="24" height="24" loading="lazy" />}
                                    </span>
                                </a>
                            )}
                        </div>
                    )}
                </section>

                {columns.map((team, column) =>
                    <section class="[ br__col ]" x-bind:class={selected(team.position)} x-show="view === 'damage'" x-cloak style={`grid-row: ${view_row}; grid-column: ${column + 1}`} aria-label={team.name}>
                        <div class="[ br__panel ]">
                            <div class="[ br__head br__head--damage ]">
                                <span class="[ br__r ]">{t('fleets.report.col_rank')}</span><span /><span>{t('fleets.report.col_pilot_ship')}</span>
                                <span>{t('fleets.report.damage_dealt')}</span>
                                <span class="[ br__r ]">{t('fleets.report.col_kills')}</span>
                            </div>
                            {team.by_damage.map((row, rank) =>
                                <div class="[ br__dmg-row ]">
                                    <span class="[ br__rank ]">{rank + 1}</span>
                                    {row.icon_type_id ? <img src={get_item_icon(row.icon_type_id, 64)} alt="" width="32" height="32" loading="lazy" /> : <span />}
                                    <span class="[ br__dmg-name ]"><b>{row.name}</b><span>{row.ship}</span></span>
                                    <span class="[ br__dmg-bar ]"><span style={`width: ${row.bar}%`} /><b>{row.damage}</b></span>
                                    <span class:list={['[ br__num ]', { 'br__top': row.kills_top }]}>{row.kills}</span>
                                </div>
                            )}
                        </div>
                    </section>
                )}

                {columns.map((team, column) =>
                    <section class="[ br__col ]" x-bind:class={selected(team.position)} x-show="view === 'composition'" x-cloak style={`grid-row: ${view_row}; grid-column: ${column + 1}`} aria-label={team.name}>
                        <div class="[ br__panel ]">
                            {team.composition.map(group =>
                                <div class="[ br__ally ]">
                                    <div class="[ br__ally-head ]">
                                        <img src={group.logo} alt="" width="32" height="32" loading="lazy" />
                                        <span class="[ br__ally-name ]">
                                            <b data-tippy-content={group.name}>{group.name}</b>
                                            <span class="[ br__share ]" aria-hidden="true"><span style={`width: ${group.share}%`} /></span>
                                        </span>
                                        <span class="[ br__num ]">{group.pilots} <span class="[ br__muted ]">({group.share}%)</span></span>
                                    </div>
                                    {group.hulls.length > 0 &&
                                        <div class="[ br__hulls ]">
                                            {group.hulls.map(hull =>
                                                <span class="[ br__hull ]" data-tippy-content={hull.name}><img src={get_item_icon(hull.type_id, 32)} alt={hull.name} width="20" height="20" loading="lazy" />×{hull.count}</span>
                                            )}
                                        </div>
                                    }
                                    {group.alliance && group.corps.length > 0 &&
                                        <ul class="[ br__corps ]">
                                            {group.corps.map(corp =>
                                                <li><img src={get_corporation_logo(corp.id, 32)} alt="" width="20" height="20" loading="lazy" /><span>{corp.name}</span><span class="[ br__num ]">{corp.pilots}</span></li>
                                            )}
                                        </ul>
                                    }
                                </div>
                            )}
                        </div>
                    </section>
                )}
            </div>
        </>
    }
</div>

<style lang="scss">
    .br {
        container: battle-report / inline-size;
        display: flex;
        flex-direction: column;
        gap: var(--space-s);
        font-size: var(--step--1);

        --br-team-a: var(--fleet-yellow);
        --br-team-b: color-mix(in srgb, var(--alliance-blue) 45%, white);
        --br-team-c: color-mix(in srgb, var(--highlight) 45%, var(--background));
        --br-loss: color-mix(in srgb, var(--fleet-red) 60%, white);
        --br-class-col: 15rem;

        :global(button:focus-visible),
        :global(a:focus-visible),
        :global(input:focus-visible) {
            outline: 2px solid var(--fleet-yellow);
            outline-offset: 2px;
        }

        h3 {
            margin: 0;
        }
    }

    .br-team-0 { background-color: var(--br-team-a); }
    .br-team-1 { background-color: var(--br-team-b); }
    .br-team-2 { background-color: var(--br-team-c); }

    .br__panel {
        background-color: var(--component-background);
        border: 1px solid var(--hairline-medium);
    }

    .br__muted {
        color: var(--text-muted);
    }

    .br__cap {
        font-size: var(--step--2);
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-muted);
    }

    .br__r {
        text-align: right;
    }

    .br__num {
        color: var(--highlight);
        text-align: right;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    .br__loss {
        color: var(--br-loss);
        font-weight: 700;
        text-align: right;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    .br__top {
        color: color-mix(in srgb, var(--green) 55%, white);
        font-weight: 700;
    }

    .br__button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2.25rem;
        padding: 0 var(--space-xs);
        background: transparent;
        border: 1px solid var(--hairline-strong);
        color: var(--foreground);
        font: inherit;
        font-weight: 600;
        white-space: nowrap;
        text-decoration: none;
        cursor: pointer;

        &:hover {
            border-color: var(--foreground);
            color: var(--highlight);
        }
    }

    .br__button--primary {
        background-color: var(--foreground);
        border-color: var(--foreground);
        color: var(--background);

        &:hover {
            background-color: var(--highlight);
            color: var(--background);
        }
    }

    .br__mast {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
    }

    .br__back {
        color: var(--text-muted);
        text-decoration: none;

        &:hover {
            color: var(--highlight);
        }
    }

    .br__mast-head {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: flex-end;
        gap: var(--space-s) var(--space-l);
    }

    .br__title {
        margin: 0;
        font-size: var(--step-3);
        color: var(--highlight);
    }

    .br__meta {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3xs) var(--space-s);
        margin: var(--space-3xs) 0 0;
        color: var(--text-muted);

        a {
            font-weight: 600;
            color: var(--foreground);
            text-decoration: none;
        }
    }

    .br__totals {
        display: flex;
        gap: var(--space-l);
        margin: 0;

        div {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
        }

        dd {
            margin: 0;
            font-size: var(--step-2);
            font-weight: 700;
            color: var(--highlight);
            font-variant-numeric: tabular-nums;
        }
    }

    .br__scope {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
        padding: var(--space-s);
    }

    .br__chips {
        display: flex;
        gap: var(--space-2xs);
        overflow-x: auto;
    }

    .br__chip {
        flex: none;
        display: inline-flex;
        align-items: center;
        background-color: var(--surface-sunken);
        border: 1px solid var(--hairline-strong);

        > a {
            display: inline-flex;
            align-items: center;
            gap: var(--space-2xs);
            min-height: 2.25rem;
            padding: 0 var(--space-xs);
            color: var(--text-muted);
            text-decoration: none;
        }

        b {
            color: var(--highlight);
            font-weight: 600;
        }

        small {
            font-variant-numeric: tabular-nums;
        }

        form {
            display: contents;
        }

        &.is-on {
            background-color: color-mix(in srgb, var(--fleet-yellow) 12%, var(--component-background));
            border-color: var(--foreground);
        }
    }

    .br__chip-x {
        min-width: 2rem;
        min-height: 2.25rem;
        background: transparent;
        border: 0;
        color: var(--text-muted);
        cursor: pointer;

        &:hover {
            color: var(--highlight);
        }
    }

    .br__strip {
        position: relative;
        height: 7rem;
        margin-bottom: var(--space-m);
        background-color: var(--surface-sunken);
        border-bottom: 1px solid var(--hairline-strong);
        cursor: crosshair;
        touch-action: none;
        user-select: none;
    }

    .br__bar {
        position: absolute;
        bottom: 0;
        display: flex;
        flex-direction: column-reverse;

        span {
            display: block;
            width: 100%;
        }
    }

    .br__dim {
        position: absolute;
        top: 0;
        bottom: 0;
        background-color: color-mix(in srgb, var(--background) 62%, transparent);
        pointer-events: none;
    }

    .br__sel,
    .br__drag {
        position: absolute;
        top: 0;
        bottom: 0;
        border-inline: 2px solid var(--foreground);
        pointer-events: none;
    }

    .br__drag {
        background-color: color-mix(in srgb, var(--fleet-yellow) 12%, transparent);
    }

    .br__sel span {
        position: absolute;
        top: var(--space-3xs);
        left: var(--space-3xs);
        padding: 0 var(--space-3xs);
        background-color: var(--foreground);
        color: var(--background);
        font-size: var(--step--2);
        font-weight: 700;
        white-space: nowrap;
    }

    .br__tick {
        position: absolute;
        top: 100%;
        margin-top: var(--space-3xs);
