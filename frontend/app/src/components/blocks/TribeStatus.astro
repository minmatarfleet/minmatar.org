---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type {
    TribeGroup,
    SummaryCharacter,
    TribeMembership,
    TribeAvailableCharacter,
} from '@dtypes/api.minmatar.org'
import { tribe_group_apply_ui_state } from '@helpers/tribe_group_apply_ui'

interface Props {
    group:                  TribeGroup;
    tribe_id:               number;
    group_id:               number;
    is_auth:                boolean;
    user_characters:        SummaryCharacter[];
    available_characters?:  TribeAvailableCharacter[];
    membership_by_group:    Map<number, TribeMembership | null>;
    user_on_trial?:         boolean;
}

const {
    group,
    tribe_id,
    group_id,
    is_auth,
    user_characters,
    available_characters,
    membership_by_group,
    user_on_trial = false,
} = Astro.props

import { query_string } from '@helpers/string';

const TRIBE_GROUP_STATUS_PARTIAL_URL = translatePath(`/partials/tribe_group_status_component?tribe_id=${tribe_id}&group_id=${group_id}`)

const apply_ui = tribe_group_apply_ui_state({
    group,
    membership: membership_by_group.get(group.id) ?? null,
    is_auth,
    is_leader: false,
    user_on_trial,
})
const {
    membership,
    is_approved,
    is_pending,
    can_apply,
    blocked_by_trial,
    affiliation_names,
} = apply_ui
const ineligible_text = affiliation_names
    ? t('tribes.detail.apply_affiliation_required').replace(
        '{affiliations}',
        affiliation_names,
    )
    : t('tribes.detail.apply_affiliation_denied')

const id = `tribe-group-status-${group.tribe_id}-${group.id}`

import Button from '@components/blocks/Button.astro';
import ButtonApplyTribe from '@components/blocks/ButtonApplyTribe.astro';
import ButtonTribeMembership from '@components/blocks/ButtonTribeMembership.astro';
import ButtonAuth from '@components/blocks/ButtonAuth.astro';
import ButtonConfirm from '@components/blocks/ButtonConfirm.astro';
---

<div id={id}>
    {
        !is_auth ?
            <ButtonAuth
                color='green'
                size='sm'
                dialog_title={t('group_join_request').replace('{group}', group.name)}
            >
                {t('tribes.detail.login_to_apply')}
            </ButtonAuth> :
        is_auth && is_pending ?
            <ButtonConfirm
                label={t('tribes.detail.withdraw')}
                size='sm'
            >
                <Button
                    hx-delete={`${TRIBE_GROUP_STATUS_PARTIAL_URL}?${query_string({
                        tribe_id: tribe_id,
                        group_id: group_id,
                        membership_id: membership.id,
                    })}`}
                    hx-target={`#${id}`}
                    hx-indicator=".loader"
                    hx-swap="outerHTML transition:true"
                    x-on:click="$el.setAttribute('disabled','')"
                >
                    {t('confirm')}
                </Button>
            </ButtonConfirm> :
        is_auth && !is_pending && !is_approved && !can_apply ?
            <small>{ineligible_text}</small> :
        is_auth && !is_pending && !is_approved && blocked_by_trial ?
            <small>{t('tribes.detail.off_trial_apply_blocked')}</small> :
        is_auth && !is_pending && !is_approved ?
            <ButtonApplyTribe
                target_id={id}
                title={group.name}
                tribe_id={tribe_id}
                group_id={group_id}
                pilots={user_characters}
                available_characters={available_characters}
                required_token_type={group.required_token_type}
            /> :
        is_auth && is_approved ?
            <ButtonTribeMembership
                target_id={id}
                title={group.name}
                tribe_id={tribe_id}
                group_id={group_id}
                membership_id={membership.id}
                pilots={user_characters}
                membership={membership}
                available_characters={available_characters}
                required_token_type={group.required_token_type}
            /> :
        ''
    }
</div>