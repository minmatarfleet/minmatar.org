---
import { i18n } from '@helpers/i18n'
const { lang, t, translatePath } = i18n(Astro.url)

import type { CampaignSystemSummary } from '@dtypes/api.minmatar.org'
import { clamp_percent, status_chip_color, status_chip_i18n_key, campaign_goal_i18n_key, contest_bar_percent, normalize_campaign_goal } from '@helpers/fetching/campaigns'
import { format_date_time, from_now_diff } from '@helpers/date'

interface Props {
    system:             CampaignSystemSummary;
    slug:               string;
    can_report?:        boolean;
    flash?:             string | false;
    [propName: string]: any;
}

const {
    system,
    slug,
    can_report = false,
    flash = false,
    ...attributes
} = Astro.props

delete attributes.class

const contested = clamp_percent(system.contested_percent)
const contested_change = system.contested_change_24h ?? 0
const our_pct = clamp_percent(system.advantage_our_pct)
const enemy_pct = clamp_percent(system.advantage_enemy_pct)
const net_pct = system.advantage_net_pct ?? 0
const kills_change = system.kills_change_24h ?? 0
const goal_key = campaign_goal_i18n_key(system.goal)

const advantage_age_text = system.advantage_basis === 'unknown' || system.advantage_age_minutes === null
    ? t('campaigns.system.no_reading')
    : system.advantage_is_stale
        ? t('campaigns.system.reading_stale')
        : t('campaigns.system.reading_age').replace('{minutes}', String(system.advantage_age_minutes))
const from_frontlines = system.advantage_source === 'frontlines' && system.advantage_basis !== 'unknown'
/** CCP publishes the number itself; a pilot's eyeballed reading is only a fallback while that feed is stale. */
const show_report = can_report && !(from_frontlines && !system.advantage_is_stale)

const ADVANTAGE_PARTIAL_URL = translatePath(`/partials/campaign_advantage_component?slug=${slug}&system_id=${system.id}`)

/** Everything about how fresh the card is, kept behind one info hover so the header stays clean. */
const updated = [
    {
        key: 'campaigns.system.updated_contested' as const,
        at: system.contested_updated_at,
    },
    {
        key: 'campaigns.system.updated_advantage' as const,
        at: system.advantage_updated_at,
    },
].map(item => ({
    text: t(item.key).replace('{ago}', item.at ? from_now_diff(lang, new Date(item.at)) : t('campaigns.system.updated_never')),
    full_date: item.at ? format_date_time(lang, item.at) : undefined,
}))

const advantage_source_text = [
    from_frontlines ? t('campaigns.system.from_frontlines') : null,
    advantage_age_text,
    system.advantage_basis === 'estimate' ? t('campaigns.system.estimated') : null,
].filter(Boolean).join(' · ')

/** A reading nobody can trust changes how the numbers read, so that warning stays on the card. */
const advantage_warning = system.advantage_basis === 'unknown' || system.advantage_age_minutes === null
    ? t('campaigns.system.no_reading')
    : system.advantage_is_stale
        ? t('campaigns.system.reading_stale')
        : false

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import Button from '@components/blocks/Button.astro'
import DialogButton from '@components/blocks/DialogButton.astro'
import Input from '@components/blocks/Input.astro'
import CampaignMeter from '@components/blocks/CampaignMeter.astro'
import CampaignPriorityIcon from '@components/blocks/CampaignPriorityIcon.astro'
import CampaignSparkline from '@components/blocks/CampaignSparkline.astro'
---

<ComponentBlock
    id={`campaign-system-${system.id}`}
    class:list={['[ campaign-system-card ]', Astro.props.class]}
    padding_inline='var(--space-m)'
    padding_block='var(--space-m)'
    {...attributes}
>
    <Flexblock gap='var(--space-m)'>
        {flash && <small class="[ campaign-system-flash ]" role="status">{flash}</small>}

        <FlexInline gap='var(--space-s)' justification='space-between' class="[ items-center ]">
            <FlexInline gap='var(--space-2xs)' class="[ items-center ]">
                <CampaignPriorityIcon priority={system.priority} />
                <h3 title={`${t(goal_key)} · ${t(status_chip_i18n_key(system.status_chip))}`}>{system.name}</h3>
            </FlexInline>
            <div class="[ campaign-system-freshness ]" x-data="{}">
                <button
                    type="button"
                    class="[ campaign-system-freshness-button ]"
                    aria-label={t('campaigns.system.freshness')}
                    x-init="tippy($el, Object.assign({}, tippy_options, { allowHTML: true, placement: 'bottom-end', content: $refs.freshness.innerHTML }))"
                >
                    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                        <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.25" />
                        <circle cx="8" cy="4.75" r="0.9" fill="currentColor" />
                        <path d="M8 7v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                </button>
                <template x-ref="freshness">
                    <div class="[ campaign-freshness-tip ]">
                        <strong>{t('campaigns.system.freshness')}</strong>
                        {updated.map(item =>
                            <div>
                                <span>{item.text}</span>
                                {item.full_date && <small>{item.full_date}</small>}
                            </div>
                        )}
                        <div><span>{advantage_source_text}</span></div>
                        <div><span>{t('campaigns.system.updated_kills')}</span></div>
                    </div>
                </template>
            </div>
        </FlexInline>

        <div class="[ campaign-system-columns ]">
            <div class="[ campaign-system-column ]">
                <small>{t('campaigns.system.contested')}</small>
                <FlexInline gap='var(--space-2xs)' class="[ campaign-system-stat ]">
                    <span class="[ campaign-figure ]">{contested.toFixed(1)}%</span>
                    <small>{contested_change >= 0 ? '+' : ''}{contested_change.toFixed(1)} · {t('campaigns.system.change_24h')}</small>
                </FlexInline>
                <Flexblock gap='var(--space-2xs)'>
                    <CampaignMeter
                        percent={contest_bar_percent(system.goal, contested)}
                        label={normalize_campaign_goal(system.goal) === 'hold'
                            ? `${system.name} ${t('campaigns.system.held_meter')}`
                            : `${system.name} ${t('campaigns.system.contested')}`}
                    />
                    {system.trend.length > 1 ?
                        <CampaignSparkline trend={system.trend} title={t('campaigns.system.trend')} />
                        :
                        <small>{t('campaigns.system.no_trend')}</small>
                    }
                    <small>
                        {t('campaigns.system.victory_points')}: {system.victory_points ?? 0} / {system.victory_points_threshold ?? 0}
                    </small>
                </Flexblock>
            </div>

            <div class="[ campaign-system-column ]">
                <small>{t('campaigns.system.advantage')}</small>
                <FlexInline gap='var(--space-2xs)' class="[ campaign-system-stat ]">
                    <span class="[ campaign-figure ]">{net_pct >= 0 ? '+' : ''}{net_pct.toFixed(1)}%</span>
                    <small>{t('campaigns.system.net')}</small>
                </FlexInline>
                <Flexblock gap='var(--space-2xs)'>
                    <Flexblock gap='var(--space-3xs)'>
                        <small class="[ campaign-advantage-ours ]">{t('campaigns.system.ours')} {our_pct.toFixed(1)}%</small>
                        <CampaignMeter percent={our_pct} color='var(--fleet-red)' label={t('campaigns.system.ours')} />
                        <small class="[ campaign-advantage-enemy ]">{t('campaigns.system.enemy')} {enemy_pct.toFixed(1)}%</small>
                        <CampaignMeter percent={enemy_pct} color='var(--fleet-yellow)' label={t('campaigns.system.enemy')} />
                    </Flexblock>
                    {advantage_warning && <small class="[ campaign-advantage-warning ]">{advantage_warning}</small>}
                    {show_report &&
                        <DialogButton size='sm' color='transparent' max_width='420px'>
                            {t('campaigns.system.report_advantage')}
                            <Flexblock slot='dialog' gap='var(--space-s)'>
                                <h3>{t('campaigns.advantage.dialog_title')} · {system.name}</h3>
                                <small>{t('campaigns.advantage.hint')}</small>
                                <form
                                    hx-post={ADVANTAGE_PARTIAL_URL}
                                    hx-target={`#campaign-system-${system.id}`}
                                    hx-swap='outerHTML'
                                    hx-indicator='.loader'
                                    x-on:submit="close_dialog()"
                                >
                                    <Flexblock gap='var(--space-s)'>
                                        <label>
                                            <small>{t('campaigns.advantage.our_pct')}</small>
                                            <Input type='number' name='our_pct' min='0' max='100' step='0.1' value='0' required />
                                        </label>
                                        <label>
                                            <small>{t('campaigns.advantage.enemy_pct')}</small>
                                            <Input type='number' name='enemy_pct' min='0' max='100' step='0.1' value='0' required />
                                        </label>
                                        <Button size='sm' color='green' type='submit'>
                                            {t('campaigns.advantage.submit')}
                                        </Button>
                                    </Flexblock>
                                </form>
                            </Flexblock>
                        </DialogButton>
                    }
                </Flexblock>
            </div>

            <div class="[ campaign-system-column ]">
                <small>{t('campaigns.system.kills_losses')}</small>
                <FlexInline gap='var(--space-2xs)' class="[ campaign-system-stat ]">
                    <span class="[ campaign-figure ]">{system.kills_24h}</span>
                    <small>{t('campaigns.system.kills')}</small>
                </FlexInline>
                <Flexblock gap='var(--space-2xs)'>
                    <FlexInline gap='var(--space-2xs)' class="[ campaign-system-stat ]">
                        <span class="[ campaign-figure ]">{system.losses_24h}</span>
                        <small>{t('campaigns.system.losses')}</small>
                    </FlexInline>
                    <small>{kills_change >= 0 ? '+' : ''}{kills_change} · {t('campaigns.system.change_24h')}</small>
                </Flexblock>
            </div>
        </div>
    </Flexblock>
</ComponentBlock>

<style lang="scss">
    h3 {
        font-family: var(--heading-font);
        font-size: var(--step-1);
        color: var(--highlight);
    }

    .campaign-figure {
        font-family: var(--heading-font);
        font-size: var(--step-2);
        color: var(--highlight);
        line-height: 1;
    }

    .campaign-system-flash {
        color: var(--highlight);
    }

    .campaign-system-freshness-button {
        display: inline-flex;
        padding: var(--space-3xs);
        border: none;
        background: none;
        color: var(--foreground);
        cursor: help;
        transition: color var(--fast-transition);
    }

    @media (hover: hover) {
        .campaign-system-freshness-button:hover {
            color: var(--highlight);
        }
    }

    .campaign-advantage-warning {
        color: var(--fleet-yellow);
    }

    /* Three shared rows: label, primary figure, then whatever else that column has. */
    .campaign-system-columns {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        column-gap: var(--space-l);
    }

    .campaign-system-column {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        min-width: 0;
        padding-inline-start: var(--space-m);
        border-inline-start: solid 1px var(--border-color);
    }

    .campaign-system-column:first-child {
        padding-inline-start: 0;
        border-inline-start: none;
    }

    .campaign-system-column :global(.campaign-system-stat) {
        align-items: baseline;
    }

    .campaign-advantage-ours {
        color: var(--fleet-red);
    }

    .campaign-advantage-enemy {
        color: var(--fleet-yellow);
    }

    @supports (grid-template-rows: subgrid) {
        .campaign-system-column {
            display: grid;
            grid-row: span 3;
            grid-template-rows: subgrid;
            align-items: start;
        }
    }

    @media screen and (max-width: 991px) {
        .campaign-system-columns {
            grid-template-columns: 1fr;
            row-gap: 0;
        }

        .campaign-system-column {
            display: flex;
            flex-direction: column;
            grid-row: auto;
            grid-template-rows: none;
            gap: var(--space-2xs);
            padding-inline-start: 0;
            border-inline-start: none;
            padding-top: var(--space-s);
            border-top: solid 1px var(--border-color);
        }

        .campaign-system-column:first-child {
            padding-top: 0;
            border-top: none;
        }
    }

    label {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
    }
</style>

<style lang="scss" is:global>
    /* Rendered inside the tippy popper, which lives outside this component. */
    .campaign-freshness-tip {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        text-align: start;

        div {
            display: flex;
            flex-direction: column;
        }

        small {
            color: var(--foreground);
        }
    }
</style>
