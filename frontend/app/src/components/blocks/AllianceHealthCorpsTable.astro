---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { AllianceHealthCorporationRow } from '@dtypes/api.minmatar.org'
import type { CampaignTableRow } from '@/data/campaigns/etherium-reach'

import { get_corporation_logo } from '@helpers/eve_image_server'
import AllianceHealthPagedTable from '@components/blocks/AllianceHealthPagedTable.astro'

interface Props {
    corporations: AllianceHealthCorporationRow[]
    initial_corp?: string
    [propName: string]: any
}

const { corporations, initial_corp = 'all', ...attributes } = Astro.props
delete attributes.class

const fmt_pct = (n: number) => `${n > 0 ? '+' : ''}${n}%`

const headers = [
    t('alliance.health.col.corp'),
    t('alliance.health.col.characters'),
    t('alliance.health.col.humans'),
    t('alliance.health.col.active_90d'),
    t('alliance.health.col.active_90d_pct'),
    t('alliance.health.col.growth_90d_pct'),
]

const rows: CampaignTableRow[] = corporations.map((corp) => ({
    cells: [
        corp.name,
        String(corp.characters),
        String(corp.humans),
        String(corp.active_90d),
        `${corp.active_90d_pct}%`,
        fmt_pct(corp.growth_90d_pct),
    ],
    corp: corp.name,
    search_text: corp.name.toLowerCase(),
    icon_url: get_corporation_logo(corp.corporation_id, 64),
    tone: corp.growth_90d_pct > 0 ? 'success' : corp.growth_90d_pct < 0 ? 'warning' : undefined,
}))
---

<div class:list={['[ alliance-health-corps ]', Astro.props.class]} id="health-corps" {...attributes}>
    <AllianceHealthPagedTable
        headers={headers}
        rows={rows}
        empty_label={t('alliance.health.corps.empty')}
        initial_corp={initial_corp}
        page_size={5}
        csv_filename="health-corporations.csv"
        url_section="corps"
    />
</div>
