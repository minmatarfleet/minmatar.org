---
import type { TagColors } from '@dtypes/layout_components';

interface Props {
    text:                   string;
    title?:                 string;
    color?:                 TagColors | string;
    text_color?:            string;
    narrow?:                boolean;
    /** `fill` is a solid tag; `outline` is a bordered tag with no background. */
    variant?:               'fill' | 'outline';
    [propName: string]: any;
}

const {
    text,
    title,
    color = 'fleet-red',
    text_color,
    narrow = false,
    variant = 'fill',
    ...attributes
} = Astro.props

delete attributes.class

const tag_color = `var(--${color})`;

const optional_attributes = {
    ...(title && { "title": title })
}

const badge_color = !text_color ? (color !== 'fleet-yellow' ? 'var(--highlight)' : 'var(--background)') : text_color

// An outline tag takes its colour only when the caller asks for one; otherwise it is neutral.
const outline = variant === 'outline'
const has_color = Astro.props.color !== undefined
const outline_color = text_color ?? (has_color ? tag_color : 'var(--highlight)')
const outline_border = has_color
    ? `color-mix(in srgb, ${tag_color} 60%, transparent)`
    : 'color-mix(in srgb, var(--highlight) 20%, transparent)'
---

{outline ?
    <span
        class:list={['tag tag--outline w-fit', { narrow: narrow }, Astro.props.class]}
        style={`--outline_color: ${outline_color}; --outline_border: ${outline_border}`}
        {...optional_attributes}
        {...attributes}
    ><slot name="icon" />{text}</span>
    :
    <span class:list={['tag w-fit', { narrow: narrow }, Astro.props.class]} {...optional_attributes} {...attributes}>{text}</span>
}

<style lang="scss" define:vars={{ tag_color, badge_color }}>
    span {
        display: flex;
        padding: var(--space-3xs) var(--space-2xs);
        font-size: var(--step--2);
        color: var(--badge_color);
        background-color: var(--tag_color);

        &.narrow {
            padding: 0px 3px;
        }

        &.tag--outline {
            align-items: center;
            gap: var(--space-3xs);
            white-space: nowrap;
            color: var(--outline_color);
            background-color: transparent;
            border: 1px solid var(--outline_border);
        }
    }
</style>
