---
import { i18n } from '@helpers/i18n'
const { lang, t } = i18n(Astro.url)

import type { FreightContractsStats } from '@dtypes/api.minmatar.org'
import { humanize_duration_seconds } from '@helpers/date'

import Grid from '@components/compositions/Grid.astro'

interface Props {
    stats: FreightContractsStats
}

const { stats } = Astro.props

const window_label = t('freight_contracts.metrics.window')
    .replace('{days}', String(stats.window_days))

const avg_delivery_display = stats.average_delivery_seconds != null
    ? humanize_duration_seconds(lang, stats.average_delivery_seconds)
    : '—'
---

<section class="[ freight-contracts-metrics ]" aria-label={t('freight_contracts.metrics.aria_label')}>
    <Grid
        class="[ freight-contracts-metrics__grid ]"
        min_item_width="220px"
        row_gap="var(--space-s)"
        column_gap="var(--space-s)"
    >
        <article class="[ freight-contracts-metrics__card ]">
            <p class="[ freight-contracts-metrics__label ]">{t('freight_contracts.metrics.active')}</p>
            <p class="[ freight-contracts-metrics__value ]">{stats.active_count}</p>
        </article>

        <article class="[ freight-contracts-metrics__card ]">
            <p class="[ freight-contracts-metrics__label ]">{t('freight_contracts.metrics.avg_delivery')}</p>
            <p class="[ freight-contracts-metrics__value ]">{avg_delivery_display}</p>
            <p class="[ freight-contracts-metrics__meta ]">{window_label}</p>
        </article>

        <article class="[ freight-contracts-metrics__card ]">
            <p class="[ freight-contracts-metrics__label ]">{t('freight_contracts.metrics.active_haulers')}</p>
            <p class="[ freight-contracts-metrics__value ]">{stats.active_haulers_count}</p>
            <p class="[ freight-contracts-metrics__meta ]">{window_label}</p>
        </article>
    </Grid>
</section>

<style lang="scss">
    .freight-contracts-metrics__card {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        padding: var(--space-m);
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(0, 0, 0, 0.22);
    }

    .freight-contracts-metrics__label {
        margin: 0;
        font-size: var(--step--1);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--fleet-yellow);
    }

    .freight-contracts-metrics__value {
        margin: 0;
        font-family: var(--heading-font);
        font-size: clamp(2rem, 4.5vw, 3rem);
        line-height: 0.95;
        letter-spacing: -0.02em;
        text-transform: uppercase;
        color: var(--highlight);
    }

    .freight-contracts-metrics__meta {
        margin: 0;
        color: rgba(255, 255, 255, 0.65);
        font-size: var(--step--1);
    }
</style>
