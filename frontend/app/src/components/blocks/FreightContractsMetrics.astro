---
import { i18n } from '@helpers/i18n'
const { lang, t } = i18n(Astro.url)

import type { FreightContractsStats } from '@dtypes/api.minmatar.org'
import { humanize_duration_seconds } from '@helpers/date'

import Grid from '@components/compositions/Grid.astro'
import StatCard from '@components/blocks/StatCard.astro'

interface Props {
    stats: FreightContractsStats
}

const { stats } = Astro.props

const window_label = t('freight_contracts.metrics.window')
    .replace('{days}', String(stats.window_days))

const avg_delivery_display = stats.average_delivery_seconds != null
    ? humanize_duration_seconds(lang, stats.average_delivery_seconds)
    : '—'
---

<section class="[ freight-contracts-metrics ]" aria-label={t('freight_contracts.metrics.aria_label')}>
    <Grid
        class="[ freight-contracts-metrics__grid ]"
        min_item_width="220px"
        row_gap="var(--space-s)"
        column_gap="var(--space-s)"
    >
        <StatCard label={t('freight_contracts.metrics.active')} value={stats.active_count} />

        <StatCard
            label={t('freight_contracts.metrics.avg_delivery')}
            value={avg_delivery_display}
            hint={window_label}
        />

        <StatCard
            label={t('freight_contracts.metrics.active_haulers')}
            value={stats.active_haulers_count}
            hint={window_label}
        />
    </Grid>
</section>
