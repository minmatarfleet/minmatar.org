---
/**
 * A settings panel for the manager screens (post tags, NPSI sources, help
 * ticket categories, structure pings, Reddit approvals). It only supplies the
 * shared look: put `.manage-panel__row` rows and `.manage-panel__form` forms
 * inside. The screens swap their own partial into it with htmx.
 */
interface Props {
    [propName: string]: any;
}

const { ...attributes } = Astro.props

delete attributes.class
---

<section class:list={['[ manage-panel ]', Astro.props.class]} {...attributes}>
    <slot />
</section>

<style is:global lang="scss">
    .manage-panel {
        display: flex;
        flex-direction: column;
        gap: var(--space-s);
    }

    .manage-panel__error {
        margin: 0;
        color: var(--fleet-red);
        filter: brightness(1.3);
    }

    .manage-panel__notice {
        margin: 0;
        color: var(--green);
    }

    .manage-panel__heading {
        margin: 0;
        font-size: var(--step--1);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--faded);
    }

    .manage-panel__rows {
        display: flex;
        flex-direction: column;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .manage-panel__row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2xs) var(--space-s);
        padding-block: var(--space-2xs);
        border-block-end: 1px solid var(--hairline);
    }

    .manage-panel__form {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: var(--space-2xs) var(--space-xs);
    }

    .manage-panel__field {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        font-size: var(--step--1);
        color: var(--faded);
    }

    .manage-panel__muted {
        font-size: var(--step--1);
        color: var(--text-muted);
    }
</style>
