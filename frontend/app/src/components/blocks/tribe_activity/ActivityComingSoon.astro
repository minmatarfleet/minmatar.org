---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

interface Props {
    message?: string
    [propName: string]: any
}

const {
    message,
    ...attributes
} = Astro.props

delete attributes.class
---

<div class:list={['[ activity-coming-soon ]', Astro.props.class]} {...attributes}>
    <p class="[ activity-coming-soon__title ]">{t('tribes.activity.coming_soon')}</p>
    {message && <p class="[ activity-coming-soon__message ]">{message}</p>}
</div>

<style lang="scss">
    .activity-coming-soon {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: var(--space-2xs);
        min-block-size: calc(var(--space-3xl) * 2);
        padding: var(--space-l) var(--space-m);
        border: 1px dashed rgba(255, 255, 255, 0.22);
        text-align: center;
    }

    .activity-coming-soon__title {
        margin: 0;
        font-family: var(--heading-font);
        font-size: var(--step-2);
        text-transform: uppercase;
        color: var(--highlight);
    }

    .activity-coming-soon__message {
        margin: 0;
        max-inline-size: 36ch;
        font-size: var(--step--1);
        color: var(--faded);
    }
</style>
