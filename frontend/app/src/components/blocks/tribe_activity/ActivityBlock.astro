---
interface Props {
    title: string
    caption?: string
    muted?: boolean
    [propName: string]: any
}

const {
    title,
    caption,
    muted = false,
    ...attributes
} = Astro.props

delete attributes.class

import Flexblock from '@components/compositions/Flexblock.astro'
---

<section
    class:list={['[ activity-block ]', { 'activity-block--muted': muted }, Astro.props.class]}
    {...attributes}
>
    <Flexblock gap="var(--space-s)">
        <Flexblock gap="var(--space-3xs)">
            <h3 class="[ activity-block__title ]">{title}</h3>
            {caption && <p class="[ activity-block__caption ]">{caption}</p>}
        </Flexblock>
        <slot />
    </Flexblock>
</section>

<style lang="scss">
    .activity-block__title {
        margin: 0;
        font-size: var(--step-0);
        color: var(--highlight);
    }

    .activity-block--muted .activity-block__title {
        color: var(--faded);
    }

    .activity-block__caption {
        margin: 0;
        font-size: var(--step--1);
        color: var(--faded);
    }
</style>
