---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

interface Props {
    label: string
    value: string
    hint?: string
    coming_soon?: boolean
    [propName: string]: any
}

const {
    label,
    value,
    hint,
    coming_soon = false,
    ...attributes
} = Astro.props

delete attributes.class
---

<article
    class:list={['[ metric-stat ]', { 'metric-stat--soon': coming_soon }, Astro.props.class]}
    {...attributes}
>
    <p class="[ metric-stat__label ]">{label}</p>
    {coming_soon ?
        <p class="[ metric-stat__soon ]">{t('tribes.activity.coming_soon')}</p>
        :
        <p class="[ metric-stat__value ]">{value}</p>
    }
    {hint && <p class="[ metric-stat__hint ]">{hint}</p>}
</article>

<style lang="scss">
    .metric-stat {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        padding: var(--space-m);
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: var(--surface-sunken);
    }

    .metric-stat--soon {
        border-style: dashed;
        border-color: rgba(255, 255, 255, 0.22);
        background: none;

        .metric-stat__label {
            color: var(--faded);
        }
    }

    .metric-stat__label {
        margin: 0;
        font-size: var(--step--1);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--fleet-yellow);
    }

    .metric-stat__value {
        margin: 0;
        font-family: var(--heading-font);
        font-size: clamp(2rem, 4.5vw, 3rem);
        line-height: 0.95;
        letter-spacing: -0.02em;
        text-transform: uppercase;
        color: var(--highlight);
    }

    .metric-stat__soon {
        margin: 0;
        font-family: var(--heading-font);
        font-size: var(--step-1);
        text-transform: uppercase;
        color: var(--faded);
    }

    .metric-stat__hint {
        margin: 0;
        font-size: var(--step--1);
        color: var(--faded);
    }
</style>
