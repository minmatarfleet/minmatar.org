---
import { i18n } from '@helpers/i18n'
const { t, lang, translatePath } = i18n(Astro.url)

import type { TribeShowcaseWork } from '@dtypes/api.minmatar.org'
import { format_date_short } from '@helpers/date'

interface Props {
    work: TribeShowcaseWork[]
}

const { work } = Astro.props

const KIND_LABELS = {
    post: t('tribes.activity.thinkspeak.kind.post'),
    video: t('tribes.activity.thinkspeak.kind.video'),
    vod: t('tribes.activity.thinkspeak.kind.vod'),
    stream: t('tribes.activity.thinkspeak.kind.stream'),
}

const pieces = work.map((piece) => ({
    ...piece,
    href: piece.post_id
        ? translatePath(`/alliance/propaganda/${piece.post_id}`)
        : piece.url,
    external: !piece.post_id,
    kind_label: KIND_LABELS[piece.kind] ?? piece.kind,
}))

import ActivityBlock from '@components/blocks/tribe_activity/ActivityBlock.astro'
import EmptyState from '@components/blocks/EmptyState.astro'
import Grid from '@components/compositions/Grid.astro'
---

<ActivityBlock
    title={t('tribes.activity.thinkspeak.work_title')}
    caption={t('tribes.activity.thinkspeak.work_caption')}
>
    {pieces.length === 0 ?
        <EmptyState title={t('tribes.activity.thinkspeak.work_empty')} />
        :
        <Grid min_item_width="10rem" row_gap="var(--space-xs)" column_gap="var(--space-xs)">
            {pieces.map((piece) =>
                <a
                    class="[ work-card ]"
                    href={piece.href}
                    {...(piece.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                    {piece.thumbnail_url ?
                        <img
                            class="[ work-card__thumb ]"
                            src={piece.thumbnail_url}
                            alt=""
                            loading="lazy"
                        />
                        :
                        <span class="[ work-card__thumb ]" aria-hidden="true"></span>
                    }
                    <span class="[ work-card__body ]">
                        <span class="[ work-card__kind ]">{piece.kind_label}</span>
                        <span class="[ work-card__title ]">{piece.title}</span>
                        <span class="[ work-card__meta ]">
                            {piece.author} · {format_date_short(lang, piece.published_at)}
                        </span>
                    </span>
                </a>
            )}
        </Grid>
    }
</ActivityBlock>

<style lang="scss">
    .work-card {
        display: flex;
        flex-direction: column;
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--foreground);
        text-decoration: none;
        transition: border-color var(--fast-transition);

        &:focus-visible {
            outline: 2px solid var(--fleet-yellow);
            outline-offset: 2px;
        }
    }

    @media (hover: hover) {
        .work-card:hover {
            border-color: color-mix(in srgb, var(--fleet-yellow) 50%, transparent);
        }
    }

    .work-card__thumb {
        display: block;
        inline-size: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        background: var(--component-background);
    }

    .work-card__body {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        padding: var(--space-xs);
    }

    .work-card__kind {
        align-self: flex-start;
        padding: 0 var(--space-3xs);
        border: 1px solid color-mix(in srgb, var(--fleet-yellow) 50%, transparent);
        font-size: var(--step--2);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--fleet-yellow);
    }

    .work-card__title {
        color: var(--highlight);
        line-height: 1.3;
    }

    .work-card__meta {
        font-size: var(--step--1);
        color: var(--faded);
    }
</style>
