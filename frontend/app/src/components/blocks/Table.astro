---
interface Props {
    gap?:               string;
    responsive?:        boolean;
    width?:             string;
    [propName: string]: any;
}

const {
    gap,
    responsive = true,
    width = '70rem',
    ...attributes
} = Astro.props;

delete attributes.class

import BlockList from '@components/compositions/BlockList.astro';
import XFadeScroll from '@components/compositions/XFadeScroll.astro';

const Wrapper = responsive ? XFadeScroll : 'div';
---

<div>
    <Wrapper class:list={[ { 'will-change-transform': responsive } ]}>
        <BlockList
            class:list={[ 'table', Astro.props.class ]}
            role="list" {...attributes}
            gap={gap ?? undefined}
        >
            <slot />
        </BlockList>
    </Wrapper>
</div>

<style lang="scss" define:vars={{
    table_width: width
}}>
    .table {
        width: var(--table_width);
    }

    /* Rows are wrapping flex lines, so on phones let them stack instead of scrolling sideways. */
    @media (max-width: 48rem) {
        .table {
            width: 100%;
        }

        .table > :global(* + *) {
            padding-top: var(--space-s);
            border-top: solid 1px var(--border-color);
        }
    }
</style>