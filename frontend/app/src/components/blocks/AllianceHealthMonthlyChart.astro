---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { AllianceHealthMonthlyPoint } from '@dtypes/api.minmatar.org'

interface Props {
    monthly: AllianceHealthMonthlyPoint[]
    goal_map: number
    [propName: string]: any
}

const { monthly, goal_map, ...attributes } = Astro.props
delete attributes.class

const chart_id = 'alliance-health-monthly-chart'
const labels = monthly.map((m) => m.label)
const active = monthly.map((m) => m.active)
const fleet = monthly.map((m) => m.fleet)
const small_gang = monthly.map((m) => m.small_gang ?? 0)
const solo = monthly.map((m) => m.solo)
---

<section
    class:list={['[ alliance-health-monthly ]', Astro.props.class]}
    aria-label={t('alliance.health.monthly.aria')}
    x-data={`{
        chart: null,
        build_chart() {
            const canvas = document.getElementById('${chart_id}')
            const ChartLib = window.Chart
            if (!canvas || typeof ChartLib === 'undefined') return false
            if (this.chart) {
                this.chart.destroy()
                this.chart = null
            }
            const root = getComputedStyle(document.documentElement)
            const blue = root.getPropertyValue('--alliance-blue').trim() || '#2051B5'
            const yellow = root.getPropertyValue('--fleet-yellow').trim() || '#f1d9a0'
            const red = root.getPropertyValue('--fleet-red').trim() || '#b53620'
            const green = root.getPropertyValue('--green').trim() || '#3d9a5f'
            const fg = root.getPropertyValue('--foreground').trim() || '#ccc'
            ChartLib.defaults.color = fg
            ChartLib.defaults.borderColor = 'rgb(255, 255, 255, 0.08)'
            ChartLib.defaults.font.family = 'Montserrat Variable'
            this.chart = new ChartLib(canvas.getContext('2d'), {
                type: 'line',
                data: {
                    labels: ${JSON.stringify(labels)},
                    datasets: [
                        { label: ${JSON.stringify(t('alliance.health.series.active'))}, data: ${JSON.stringify(active)}, borderColor: blue, backgroundColor: blue, tension: 0, pointRadius: 2 },
                        { label: ${JSON.stringify(t('alliance.health.series.fleet'))}, data: ${JSON.stringify(fleet)}, borderColor: yellow, backgroundColor: yellow, tension: 0, pointRadius: 2 },
                        { label: ${JSON.stringify(t('alliance.health.series.small_gang'))}, data: ${JSON.stringify(small_gang)}, borderColor: green, backgroundColor: green, tension: 0, pointRadius: 2 },
                        { label: ${JSON.stringify(t('alliance.health.series.solo'))}, data: ${JSON.stringify(solo)}, borderColor: red, backgroundColor: red, tension: 0, pointRadius: 2 },
                    ],
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true, max: ${goal_map} },
                    },
                    plugins: { legend: { position: 'bottom' } },
                },
            })
            return true
        },
        init() {
            if (this.build_chart()) return
            let tries = 0
            const timer = setInterval(() => {
                tries += 1
                if (this.build_chart() || tries > 40) clearInterval(timer)
            }, 100)
        }
    }`}
>
    <div class="[ alliance-health-monthly__frame ]">
        <canvas id={chart_id}></canvas>
    </div>
</section>

<style lang="scss">
    .alliance-health-monthly__frame {
        position: relative;
        height: min(28rem, 70vh);
        width: 100%;
    }
</style>
