---
/**
 * One project template on the settings screen: its name and size, opening
 * in place to its stages and tasks (who gets each, and when).
 */
import { i18n, t_key } from '@helpers/i18n'
const { t, lang } = i18n(Astro.url)

import type { TaskProjectTemplate } from '@dtypes/api.minmatar.org'
import { recurrence_day } from '@helpers/tasks'

interface Props {
    template:   TaskProjectTemplate;
    open?:      boolean;
}

const { template, open = false } = Astro.props

const stages = [...new Set(template.tasks.map((task) => task.stage))]

function goes_to(value:string) {
    if (value.startsWith('screen:')) return t(t_key('manage.screen_', value.slice(7)))
    return t('tasks.settings.lead')
}

function due(offset:number | null, recurrence:string) {
    const day = recurrence_day(recurrence, lang)
    if (day) return t('tasks.settings.every').replace('~DAY', day)
    if (offset === null) return t('tasks.settings.no_date')
    if (offset === -1) return t('tasks.settings.day_before')
    if (offset < 0) return t('tasks.settings.days_before').replace('~N', String(-offset))
    if (offset === 0) return t('tasks.settings.at_start')
    return t('tasks.settings.day_n').replace('~N', String(offset))
}

import ExpandRow from '@components/blocks/manage/ExpandRow.astro'
---

<ExpandRow colspan={3} label={template.name} open={open}>
    <td>
        <button type="button" class="[ manage-who ]" x-on:click="open = !open">
            <span class="[ manage-who__text ]">
                <span class="[ manage-who__name ]">{template.name}</span>
                <span class="[ manage-who__sub ]">{template.description}</span>
            </span>
        </button>
    </td>
    <td class="[ num ]">
        {t('tasks.settings.task_count').replace('~TASKS', String(template.task_count)).replace('~STAGES', String(stages.length))}
    </td>
    <div slot="detail" class="[ task-stack ]">
        {stages.map((stage) => (
            <section class="[ task-stack ]">
                <h3 class="[ manage-eyebrow ]">{stage}</h3>
                <ul class="[ task-pilots ]" role="list">
                    {template.tasks.filter((task) => task.stage === stage).map((task) => (
                        <li>
                            <span class="[ manage-who__name ]">{task.title}</span>
                            <span>{goes_to(task.goes_to)}</span>
                            <span>{due(task.offset_days, task.recurrence)}</span>
                        </li>
                    ))}
                </ul>
            </section>
        ))}
    </div>
</ExpandRow>
