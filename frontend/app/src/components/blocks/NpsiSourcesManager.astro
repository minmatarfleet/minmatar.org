---
/**
 * The NPSI calendar feeds list on /fleets/npsi-sources/: All and On chips,
 * a "Failing" needs-attention chip, and a table whose rows open in place to
 * edit a feed. "Add feed" renders the list again with an open new-feed row
 * on top. npsi_sources_component renders it for every chip change, add and
 * create. Feeds are turned off, never deleted.
 */
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { ManageColumn } from '@dtypes/layout_components'
import type { NpsiSourceListing } from '@helpers/api.minmatar.org/npsi_sources'
import type { NpsiFeedDraft, NpsiFeedView } from '@helpers/manage_intel'
import { feed_row_id } from '@helpers/manage_intel'

interface Props {
    list:               NpsiSourceListing;
    view?:              NpsiFeedView;
    /** Show the open new-feed row on top. */
    adding?:            boolean;
    draft?:             NpsiFeedDraft | null;
    draft_error?:       string | null;
    /** A feed just added: its row opens with "Added". */
    added_id?:          number | null;
    [propName: string]: any;
}

const { list, view = 'all', adding = false, draft = null, draft_error = null, added_id = null } = Astro.props

const on = list.sources.filter((source) => source.enabled)
const failing = on.filter((source) => !!source.last_error)
const rows = view === 'on' ? on : view === 'failing' ? failing : list.sources

const COLUMNS: ManageColumn[] = [
    { label: t('manage.npsi.col_feed') },
    { label: t('manage.npsi.col_last_import'), phone: false },
    { label: t('manage.npsi.col_upcoming'), align: 'num', phone: false },
    { label: t('manage.npsi.col_posts_to'), phone: false },
    { label: t('manage.npsi.col_fc'), phone: false },
    { label: t('manage.npsi.col_on'), align: 'act' },
]
const colspan = COLUMNS.length + 1

const empty_title = view === 'failing' ? t('manage.npsi.empty_failing') :
    view === 'on' ? t('manage.npsi.empty_on') : t('manage.npsi.empty')

import EmptyState from '@components/blocks/EmptyState.astro'
import NpsiFeedChips from '@components/blocks/manage_intel/NpsiFeedChips.astro'
import ManageTable from '@components/blocks/manage/ManageTable.astro'
import ExpandRow from '@components/blocks/manage/ExpandRow.astro'
import NpsiFeedRow from '@components/blocks/manage_intel/NpsiFeedRow.astro'
import NpsiFeedForm from '@components/blocks/manage_intel/NpsiFeedForm.astro'
---

<div class="[ manage-list ]" id="npsi-list-root">
    <NpsiFeedChips list={list} view={view} />
    <div id="npsi-list" class="[ manage-list ]" aria-live="polite">
        {rows.length === 0 && !adding ?
            <EmptyState title={empty_title} />
            :
            <ManageTable caption={t('manage.npsi.caption')} columns={COLUMNS} min_width="52rem">
                {adding &&
                    <ExpandRow id={feed_row_id('new')} colspan={colspan} label={t('manage.npsi.new_feed')} open={true}>
                        <td>
                            <button type="button" class="[ manage-who ]" x-on:click="open = !open">
                                <span class="[ manage-who__text ]">
                                    <span class="[ manage-who__name ]">{draft?.name || t('manage.npsi.new_feed')}</span>
                                    <span class="[ manage-who__sub ]">{t('manage.npsi.new_sub')}</span>
                                </span>
                            </button>
                        </td>
                        <td class="[ is-wide ]"></td>
                        <td class="[ is-wide ]"></td>
                        <td class="[ is-wide ]"></td>
                        <td class="[ is-wide ]"></td>
                        <td class="[ act ]"></td>
                        <NpsiFeedForm slot="detail" list={list} draft={draft} error={draft_error} />
                    </ExpandRow>
                }
                {rows.map((source) =>
                    <NpsiFeedRow
                        source={source}
                        list={list}
                        colspan={colspan}
                        open={source.id === added_id}
                        note={source.id === added_id ? 'added' : null}
                    />
                )}
            </ManageTable>
        }
    </div>
</div>
