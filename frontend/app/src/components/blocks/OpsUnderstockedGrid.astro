---
import { i18n } from '@helpers/i18n'
const { translatePath } = i18n(Astro.url)

import { ops_redirect_path } from '@helpers/market_ops_redirect'

interface UnderstockedContractRow {
    location_id:        number;
    location_name:      string;
    short_name:         string;
    fitting_id:         number;
    fitting_name:       string;
    ship_id:            number;
    current_quantity:   number;
    expected_quantity:  number;
    shortfall:          number;
    readiness:          string;
    expectation_id:     number;
}

interface Props {
    rows:                   UnderstockedContractRow[];
    hide_location?:         boolean;
}

const {
    rows,
    hide_location = false,
} = Astro.props

function short_fitting_name(name: string): string {
    return name.replace(/^\[FL33T\]\s*/i, '').replace(/^\[.*?\]\s*/, '')
}

function tone_for(readiness: string, present: boolean): string {
    if (readiness === 'empty' || !present)
        return 'bad'
    return 'good'
}

const ops_href = ops_redirect_path(translatePath, 'monitor')

const tiles = rows.map(row => {
    const present = row.current_quantity > 0
    const pct = present ? 100 : 0
    return {
        ...row,
        pct,
        present,
        tone: tone_for(row.readiness, present),
        label: short_fitting_name(row.fitting_name),
        ops_href,
        qty_label: present
            ? String(row.current_quantity)
            : 'Missing',
        title: [
            row.fitting_name,
            present ? `${row.current_quantity} listed` : 'Missing',
        ].join(' · '),
    }
})

import Grid from '@components/compositions/Grid.astro'
import Flexblock from '@components/compositions/Flexblock.astro'
import ItemPicture from '@components/blocks/ItemPicture.astro'
---

{tiles.length === 0 &&
    <p>—</p>
}

{tiles.length > 0 &&
    <Grid
        class="[ ops-stock-grid ]"
        min_item_width="140px"
        row_gap="var(--space-s)"
        column_gap="var(--space-s)"
    >
        {tiles.map(tile =>
            <a
                class:list={['ops-stock-tile', `ops-stock-tile--${tile.tone}`]}
                href={tile.ops_href}
                title={tile.title}
            >
                <div
                    class="[ ops-stock-tile__ring ]"
                    style={`--fill-pct: ${tile.pct}`}
                >
                    <div class="[ ops-stock-tile__icon ]">
                        <ItemPicture
                            item_id={tile.ship_id}
                            item_name={tile.fitting_name}
                            size={128}
                            icon_quality={128}
                        />
                    </div>
                    <span class="[ ops-stock-tile__pct ]">{tile.present ? 'OK' : '0'}</span>
                </div>
                <Flexblock gap="var(--space-3xs)" class="[ ops-stock-tile__meta ]">
                    <strong class="[ ops-stock-tile__name ]">{tile.label}</strong>
                    <span class="[ ops-stock-tile__qty ]">{tile.qty_label}</span>
                    {!hide_location &&
                        <small class="[ ops-stock-tile__loc ]">{tile.short_name || tile.location_name}</small>
                    }
                </Flexblock>
            </a>
        )}
    </Grid>
}

<style lang="scss">
    .ops-stock-tile {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        text-decoration: none;
        color: inherit;
        min-width: 0;
    }

    .ops-stock-tile__ring {
        --ring-size: 118px;
        --track: color-mix(in srgb, var(--foreground) 12%, transparent);
        --fill: var(--fleet-yellow);
        position: relative;
        width: var(--ring-size);
        height: var(--ring-size);
        margin-inline: auto;
        border-radius: 50%;
        background: conic-gradient(
            var(--fill) calc(var(--fill-pct) * 1%),
            var(--track) 0
        );
        display: grid;
        place-items: center;
    }

    .ops-stock-tile--bad .ops-stock-tile__ring {
        --fill: var(--fleet-red);
    }

    .ops-stock-tile--warn .ops-stock-tile__ring {
        --fill: var(--fleet-yellow);
    }

    .ops-stock-tile--good .ops-stock-tile__ring {
        --fill: var(--green);
    }

    .ops-stock-tile__icon {
        width: calc(var(--ring-size) - 14px);
        height: calc(var(--ring-size) - 14px);
        border-radius: 50%;
        overflow: hidden;
        background: var(--background);
        display: grid;
        place-items: center;

        :global(picture),
        :global(img) {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
    }

    .ops-stock-tile__pct {
        position: absolute;
        right: -2px;
        bottom: -2px;
        min-width: 2.4rem;
        padding: 0.15rem 0.35rem;
        border: 1px solid color-mix(in srgb, var(--foreground) 15%, transparent);
        background: var(--background);
        font-family: var(--heading-font);
        font-size: var(--step--2);
        letter-spacing: 0.04em;
        text-transform: uppercase;
        text-align: center;
        color: var(--highlight);
    }

    .ops-stock-tile--bad .ops-stock-tile__pct {
        color: var(--fleet-red);
    }

    .ops-stock-tile--warn .ops-stock-tile__pct {
        color: var(--fleet-yellow);
    }

    .ops-stock-tile__meta {
        text-align: center;
        min-width: 0;
    }

    .ops-stock-tile__name {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        font-size: var(--step--1);
        line-height: 1.2;
        color: var(--fleet-yellow);
    }

    .ops-stock-tile__qty {
        font-family: var(--heading-font);
        font-size: var(--step-0);
        letter-spacing: 0.02em;
        text-transform: uppercase;
        color: var(--highlight);
    }

    .ops-stock-tile__loc {
        color: color-mix(in srgb, var(--foreground) 55%, transparent);
        font-size: var(--step--2);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
</style>
