---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { query_string } from '@helpers/string'
import type { TagColors } from '@dtypes/layout_components'

interface UnderstockedContractRow {
    location_id:        number;
    location_name:      string;
    short_name:         string;
    fitting_id:         number;
    fitting_name:       string;
    ship_id:            number;
    current_quantity:   number;
    viable_quantity?:   number;
    expected_quantity:  number;
    shortfall:          number;
    readiness:          string;
    expectation_id:     number;
    units_1d?:          number;
    units_3d?:          number;
    weekly_units?:      number;
    units_30d?:         number;
    units_90d?:         number;
    days_of_stock?:     number | null;
}

interface Props {
    rows:                       UnderstockedContractRow[];
    hide_location?:             boolean;
    contract_history_days?:     number;
}

const {
    rows,
    hide_location = false,
    contract_history_days = 0,
} = Astro.props

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import ItemPicture from '@components/blocks/ItemPicture.astro'
import Tag from '@components/blocks/Tag.astro'

const READINESS_META: Record<string, { label: string; color: TagColors }> = {
    empty: {
        label: t('ops_contract_readiness_empty'),
        color: 'fleet-red',
    },
    thin: {
        label: t('ops_contract_readiness_thin'),
        color: 'fleet-yellow',
    },
}

function short_fitting_name(name: string): string {
    return name.replace(/^\[FL33T\]\s*/i, '').replace(/^\[.*?\]\s*/, '')
}

function days_of_stock_label(row: UnderstockedContractRow): string {
    if (row.days_of_stock == null) {
        if ((row.current_quantity ?? 0) > 0)
            return t('ops_sell_gap_no_recent_sales')
        return t('ops_sell_gap_days_of_stock_zero')
    }
    const days = Math.round(row.days_of_stock)
    if (days === 1)
        return t('ops_sell_gap_days_of_stock_one')
    if (days === 0)
        return t('ops_sell_gap_days_of_stock_zero')
    return t('ops_sell_gap_days_of_stock').replace('{days}', String(days))
}

const number_format = new Intl.NumberFormat('en-US')

function format_units(units: number): string {
    return number_format.format(units)
}

const show_volume_1d = contract_history_days >= 1
const show_volume_3d = contract_history_days >= 3
const show_volume_7d = contract_history_days >= 7
const show_volume_30d = contract_history_days >= 30
const show_volume_90d = contract_history_days >= 90

const cards = rows.map(row => ({
    ...row,
    viable_quantity: row.viable_quantity ?? 0,
    units_1d: row.units_1d ?? 0,
    units_3d: row.units_3d ?? 0,
    weekly_units: row.weekly_units ?? 0,
    units_30d: row.units_30d ?? 0,
    units_90d: row.units_90d ?? 0,
    days_of_stock: row.days_of_stock ?? null,
    label: short_fitting_name(row.fitting_name),
    ops_href: translatePath(`/market/ops/?${query_string({
        location_id: row.location_id,
    })}`),
    readiness_meta: READINESS_META[row.readiness],
}))
---

{cards.length === 0 &&
    <p>—</p>
}

{cards.length > 0 &&
    <Flexblock gap="var(--space-2xs)" class="[ ops-understocked-list ]">
        {cards.map(card =>
            <a
                class="[ ops-understocked-card ]"
                href={card.ops_href}
            >
                <ComponentBlock
                    class="[ ops-understocked-card__main ]"
                    padding_block="var(--space-2xs)"
                    padding_inline="var(--space-s)"
                >
                    <FlexInline
                        gap="var(--space-s)"
                        justification="space-between"
                        class="[ w-full ops-understocked-card__row ]"
                    >
                        <FlexInline gap="var(--space-s)" class="[ ops-understocked-card__identity ]">
                            <div class="[ ops-understocked-card__item ]">
                                <ItemPicture
                                    item_id={card.ship_id}
                                    item_name={card.fitting_name}
                                    size={48}
                                    icon_quality={64}
                                />
                            </div>
                            <Flexblock gap="var(--space-3xs)">
                                <strong>{card.label}</strong>
                                {!hide_location &&
                                    <small>{card.short_name || card.location_name}</small>
                                }
                            </Flexblock>
                        </FlexInline>
                        <FlexInline
                            gap="var(--space-2xs)"
                            class="[ ops-understocked-card__status ]"
                        >
                            {card.readiness_meta &&
                                <Tag
                                    text={card.readiness_meta.label}
                                    color={card.readiness_meta.color}
                                    narrow={true}
                                />
                            }
                            <span class="[ ops-qty ]">{days_of_stock_label(card)}</span>
                        </FlexInline>
                    </FlexInline>
                </ComponentBlock>
                <div
                    class="[ ops-understocked-card__metrics ]"
                    aria-label={t('ops_contract_metrics')}
                >
                    <span class="[ ops-understocked-card__metric ]">
                        <span
                            class="[ ops-understocked-card__metric-label ]"
                            data-tippy-content={t('ops_contract_metric_stock_tip')}
                        >{t('ops_contract_metric_stock')}</span>
                        <span class="[ ops-understocked-card__metric-value ]">
                            {format_units(card.current_quantity)}/{format_units(card.expected_quantity)}
                        </span>
                    </span>
                    <span class="[ ops-understocked-card__sep ]" aria-hidden="true">·</span>
                    <span class="[ ops-understocked-card__metric ]">
                        <span
                            class="[ ops-understocked-card__metric-label ]"
                            data-tippy-content={t('ops_contract_metric_viable_tip')}
                        >{t('ops_contract_metric_viable')}</span>
                        <span class="[ ops-understocked-card__metric-value ]">
                            {format_units(card.viable_quantity)}
                        </span>
                    </span>
                    <span class="[ ops-understocked-card__sep ]" aria-hidden="true">·</span>
                    <span class="[ ops-understocked-card__metric ]">
                        <span
                            class="[ ops-understocked-card__metric-label ]"
                            data-tippy-content={t('ops_contract_metric_1d_tip')}
                        >{t('ops_sell_gap_metric_1d')}</span>
                        <span class="[ ops-understocked-card__metric-value ]">
                            {show_volume_1d ? format_units(card.units_1d) : '—'}
                        </span>
                    </span>
                    <span class="[ ops-understocked-card__sep ]" aria-hidden="true">·</span>
                    <span class="[ ops-understocked-card__metric ]">
                        <span
                            class="[ ops-understocked-card__metric-label ]"
                            data-tippy-content={t('ops_contract_metric_3d_tip')}
                        >{t('ops_sell_gap_metric_3d')}</span>
                        <span class="[ ops-understocked-card__metric-value ]">
                            {show_volume_3d ? format_units(card.units_3d) : '—'}
                        </span>
                    </span>
                    <span class="[ ops-understocked-card__sep ]" aria-hidden="true">·</span>
                    <span class="[ ops-understocked-card__metric ]">
                        <span
                            class="[ ops-understocked-card__metric-label ]"
                            data-tippy-content={t('ops_contract_metric_7d_tip')}
                        >{t('ops_sell_gap_metric_7d')}</span>
                        <span class="[ ops-understocked-card__metric-value ]">
                            {show_volume_7d ? format_units(card.weekly_units) : '—'}
                        </span>
                    </span>
                    <span class="[ ops-understocked-card__sep ]" aria-hidden="true">·</span>
                    <span class="[ ops-understocked-card__metric ]">
                        <span
                            class="[ ops-understocked-card__metric-label ]"
                            data-tippy-content={t('ops_contract_metric_30d_tip')}
                        >{t('ops_sell_gap_metric_30d')}</span>
                        <span class="[ ops-understocked-card__metric-value ]">
                            {show_volume_30d ? format_units(card.units_30d) : '—'}
                        </span>
                    </span>
                    <span class="[ ops-understocked-card__sep ]" aria-hidden="true">·</span>
                    <span class="[ ops-understocked-card__metric ]">
                        <span
                            class="[ ops-understocked-card__metric-label ]"
                            data-tippy-content={t('ops_contract_metric_90d_tip')}
                        >{t('ops_sell_gap_metric_90d')}</span>
                        <span class="[ ops-understocked-card__metric-value ]">
                            {show_volume_90d ? format_units(card.units_90d) : '—'}
                        </span>
                    </span>
                </div>
            </a>
        )}
    </Flexblock>
}

<style lang="scss">
    .ops-understocked-list {
        width: 100%;
    }

    .ops-understocked-card {
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
    }

    .ops-understocked-card__main {
        border-bottom: none;
    }

    .ops-understocked-card__identity {
        min-width: 0;
        flex: 1;
    }

    .ops-understocked-card__item {
        flex-shrink: 0;

        :global(picture),
        :global(img) {
            width: 48px;
            height: 48px;
            object-fit: contain;
        }
    }

    .ops-understocked-card__status {
        flex-shrink: 0;
        flex-wrap: wrap;
        justify-content: flex-end;
        align-items: center;
    }

    .ops-qty {
        flex-shrink: 0;
        font-family: var(--heading-font);
        font-variant-numeric: tabular-nums;
        text-transform: uppercase;
        color: var(--highlight);
        white-space: nowrap;
    }

    .ops-understocked-card__metrics {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.15rem 0.45rem;
        padding: 0.12rem var(--space-s);
        border: 1px solid color-mix(in srgb, var(--foreground) 8%, transparent);
        background: color-mix(in srgb, var(--background) 84%, transparent);
        line-height: 1.2;
    }

    .ops-understocked-card__metric {
        display: inline-flex;
        align-items: baseline;
        gap: 0.3rem;
        min-width: 0;
        white-space: nowrap;
    }

    .ops-understocked-card__sep {
        color: color-mix(in srgb, var(--foreground) 28%, transparent);
        font-size: var(--step--2);
        user-select: none;
    }

    .ops-understocked-card__metric-label {
        font-family: var(--button-font);
        font-size: var(--step--2);
        font-weight: 400;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: color-mix(in srgb, var(--foreground) 48%, transparent);
        cursor: help;
        border-bottom: 1px dotted color-mix(in srgb, var(--foreground) 28%, transparent);
    }

    .ops-understocked-card__metric-value {
        font-size: var(--step--2);
        font-variant-numeric: tabular-nums;
        color: var(--highlight);
    }
</style>
