---
import { i18n, t_key } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import { BRACKETS } from '@helpers/mentors'

/**
 * Checkbox chips for timezone brackets or days. Each checked chip posts
 * `name` once, so the form reads it with getAll.
 */
interface Props {
    name: string;
    kind: 'brackets' | 'days';
    selected: (string | number)[];
    legend: string;
    hint?: string;
}

const { name, kind, selected, legend, hint } = Astro.props

const options = kind === 'brackets'
    ? BRACKETS.map(bracket => ({ value: bracket.code, label: bracket.code, title: `${bracket.hours} EVE` }))
    : [0, 1, 2, 3, 4, 5, 6].map(day => ({ value: day.toString(), label: t(t_key('mentors.day.', day)), title: '' }))

const chosen = new Set(selected.map(value => value.toString()))
---

<fieldset class="[ mentor-chips ]">
    <legend>{legend}</legend>
    {hint && <p class="[ mentor-chips__hint ]">{hint}</p>}
    <div class="[ mentor-chips__row ]">
        {options.map(option =>
            <label class="[ mentor-chip ]" title={option.title || undefined}>
                <input type="checkbox" name={name} value={option.value} checked={chosen.has(option.value)} />
                <span>{option.label}</span>
            </label>
        )}
    </div>
</fieldset>

<style lang="scss">
    .mentor-chips {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        margin: 0;
        padding: 0;
        border: 0;
    }

    legend {
        padding-block-end: var(--space-2xs);
        color: var(--text-muted);
        font-size: var(--step--2);
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .mentor-chips__hint {
        color: var(--text-muted);
        font-size: var(--step--1);
    }

    .mentor-chips__row {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3xs);
    }

    .mentor-chip {
        position: relative;
        cursor: pointer;

        input {
            position: absolute;
            opacity: 0;
            inset: 0;
            cursor: pointer;
        }

        span {
            display: inline-flex;
            align-items: center;
            min-height: var(--space-l);
            padding: 0 var(--space-s);
            border: solid 1px var(--hairline-strong);
            color: var(--foreground);
            font-size: var(--step--1);
            font-weight: 600;
        }

        input:checked + span {
            border-color: var(--fleet-yellow);
            background: color-mix(in srgb, var(--fleet-yellow) 14%, transparent);
            color: var(--highlight);
        }

        input:focus-visible + span {
            outline: solid 2px var(--fleet-yellow);
            outline-offset: 2px;
        }
    }
</style>
