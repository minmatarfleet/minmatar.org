---
import { i18n, t_key } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import { BRACKETS } from '@helpers/mentors'

/**
 * Checkbox chips for timezone brackets or days. Each checked chip posts
 * `name` once, so the form reads it with getAll.
 */
interface Props {
    name: string;
    kind: 'brackets' | 'days';
    selected: (string | number)[];
    legend: string;
    hint?: string;
}

const { name, kind, selected, legend, hint } = Astro.props

const options = kind === 'brackets'
    ? BRACKETS.map(bracket => ({ value: bracket.code, label: bracket.code, title: `${bracket.hours} EVE` }))
    : [0, 1, 2, 3, 4, 5, 6].map(day => ({ value: day.toString(), label: t(t_key('mentors.day.', day)), title: '' }))

const chosen = new Set(selected.map(value => value.toString()))

import OptionCard from '@components/blocks/OptionCard.astro'
---

<fieldset class="[ mentor-chips manage-field ]">
    <legend class="[ manage-field__label ]">{legend}</legend>
    <div class="[ mentor-chips__row ]">
        {options.map(option =>
            <OptionCard type="checkbox" name={name} value={option.value} checked={chosen.has(option.value)} title={option.title || undefined}>
                {option.label}
            </OptionCard>
        )}
    </div>
    {hint && <span class="[ manage-field__hint ]">{hint}</span>}
</fieldset>

<style lang="scss">
    .mentor-chips {
        margin: 0;
        padding: 0;
        border: 0;
    }

    legend {
        padding: 0 0 var(--space-3xs);
    }

    .mentor-chips__row {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3xs);
    }
</style>
