---
interface Props {
    variant?:           'default' | 'primary' | 'danger' | 'success' | 'muted';
    /**
     * Two-step confirm: the first click swaps the item for this label, and
     * only the second click runs the action (attributes go on that button).
     * Arming moves focus to the confirm button (Enter twice confirms, Escape
     * still closes). It disarms on Escape, an outside click, or - inside a
     * Dropdown/ActionMenu - whenever the menu closes.
     */
    confirm_label?:     string;
    /** Renders the item as a link. */
    href?:              string;
    /** Button type, e.g. 'submit' for an item inside a <form>. */
    type?:              'button' | 'submit';
    /** A status line in the menu, not an action: plain text, no hover. */
    text_only?:         boolean;
    [propName: string]: any;
}

const {
    variant = 'default',
    confirm_label,
    href,
    type = 'button',
    text_only = false,
    ...attributes
} = Astro.props

delete attributes.class

const item_class = [
    '[ action-menu-item ]',
    `action-menu-item--${variant}`,
    { 'action-menu-item--text': text_only },
    Astro.props.class,
]
---

{text_only ? (
    <span class:list={item_class} {...attributes}>
        <slot />
    </span>
) : href ? (
    <a href={href} class:list={item_class} {...attributes}>
        <slot />
    </a>
) : confirm_label ? (
    <div
        class="[ action-menu-item__confirm ]"
        x-data="{ confirming: false }"
        x-effect="typeof expanded === 'undefined' || expanded || (confirming = false)"
        x-on:keydown.escape="confirming = false"
        x-on:click.outside="confirming = false"
    >
        <button
            type="button"
            class:list={item_class}
            x-show="!confirming"
            x-on:click.stop="confirming = true; $nextTick(() => $refs.confirm.focus())"
        >
            <slot />
        </button>
        <button
            type={type}
            class:list={[...item_class, 'is-confirm']}
            x-show="confirming"
            x-cloak
            x-ref="confirm"
            {...attributes}
        >
            {confirm_label}
        </button>
    </div>
) : (
    <button type={type} class:list={item_class} {...attributes}>
        <slot />
    </button>
)}

<style lang="scss">
    .action-menu-item__confirm {
        width: 100%;
    }

    .action-menu-item {
        display: block;
        width: 100%;
        box-sizing: border-box;
        appearance: none;
        background: transparent;
        border: 0;
        margin: 0;
        padding: var(--space-2xs) var(--space-s);
        color: var(--highlight);
        font-family: var(--button-font);
        font-size: var(--step--1);
        font-weight: 600;
        text-align: left;
        text-decoration: none;
        cursor: pointer;

        &:is(a, button):hover,
        &:is(a, button):focus-visible {
            color: var(--foreground);
            background: color-mix(in srgb, var(--foreground) 8%, transparent);
        }

        &:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        &--primary {
            color: var(--fleet-yellow);
        }

        &--success {
            color: var(--green);
        }

        &--success:is(a, button):hover,
        &--success:is(a, button):focus-visible {
            background: color-mix(in srgb, var(--green) 25%, transparent);
            color: var(--highlight);
        }

        &--danger:hover,
        &--danger:focus-visible,
        &.is-confirm {
            color: var(--fleet-red);
        }

        &--muted {
            color: color-mix(in srgb, var(--highlight) 65%, transparent);
        }

        &--text {
            font-weight: 500;
            cursor: default;
        }
    }

    [x-cloak] {
        display: none !important;
    }
</style>
