---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { PostTileUI } from '@dtypes/layout_components'

/** A tribe group's Posts tab: its posts and the ones tagged with it, newest first. */
interface Props {
    posts:          PostTileUI[];
    crest_url:      string;
    group_name:     string;
    can_post:       boolean;
    [propName: string]: any;
}

const {
    posts,
    crest_url,
    group_name,
    can_post,
    ...attributes
} = Astro.props

delete attributes.class

const fill = (text: string) => text.replaceAll('{group}', group_name)

import Grid from '@components/compositions/Grid.astro'
import EmptyState from '@components/blocks/EmptyState.astro'
import PostTile from '@components/blocks/PostTile.astro'
---

{posts.length === 0 ?
    <EmptyState
        title={fill(t('tribes.group.posts.empty'))}
        hint={can_post ? fill(t('tribes.group.posts.empty_hint')) : undefined}
    />
    :
    <Grid
        class:list={['[ tribe-group-posts grid-fill ]', Astro.props.class]}
        min_item_width="18rem"
        row_gap="var(--space-s)"
        column_gap="var(--space-s)"
        role="list"
        {...attributes}
    >
        {posts.map((post) =>
            <PostTile role="listitem" post={post} crest_url={crest_url} />
        )}
    </Grid>
}
