---
import { i18n } from '@helpers/i18n'
const { t, lang } = i18n(Astro.url)

import type { PostTileUI } from '@dtypes/layout_components'
import { get_player_icon } from '@helpers/eve_image_server'
import { format_date_short } from '@helpers/date'

/**
 * A blog tile for a group's Posts tab: cover (or the group's crest), visibility,
 * title, a two-line excerpt, author and date. The whole tile is one link.
 */
interface Props {
    post:           PostTileUI;
    /** Stands in for the cover when the post has none. */
    crest_url:      string;
    [propName: string]: any;
}

const {
    post,
    crest_url,
    ...attributes
} = Astro.props

delete attributes.class

// Reddit-hosted images arrive with escaped ampersands in their query string.
const image = post.image_url ? post.image_url.replaceAll('amp;', '') : null

import Tag from '@components/blocks/Tag.astro'
import VisibilityTag from '@components/blocks/VisibilityTag.astro'
---

<article class:list={['[ post-tile ]', Astro.props.class]} {...attributes}>
    {image ?
        <img
            class="[ post-tile__cover ]"
            src={image}
            alt=""
            loading="lazy"
            decoding="async"
        />
        :
        <span class="[ post-tile__cover post-tile__cover--crest ]">
            <img src={crest_url} alt="" width="72" height="72" loading="lazy" decoding="async" />
        </span>
    }

    <div class="[ post-tile__body ]">
        {(post.members_only || post.tagged) &&
            <span class="[ post-tile__tags ]">
                {post.members_only && <VisibilityTag visibility="members_only" size="sm" />}
                {post.tagged && <Tag variant="outline" text={t('tribes.publishing.post_tile.tagged')} />}
            </span>
        }
        <h3 class="[ post-tile__title ]">{post.title}</h3>
        <p class="[ post-tile__excerpt ]">{post.excerpt}</p>
        <span class="[ post-tile__byline ]">
            <img
                src={get_player_icon(post.author_character_id, 64)}
                alt=""
                width="24"
                height="24"
                loading="lazy"
                decoding="async"
            />
            <span>{post.author_character_name} · <time datetime={post.date}>{format_date_short(lang, post.date)}</time></span>
        </span>
    </div>

    <a class="[ post-tile__hitbox ]" href={post.href} aria-label={post.title}></a>
</article>

<style lang="scss">
    .post-tile {
        position: relative;
        display: flex;
        flex-direction: column;
        min-width: 0;
        background-color: var(--component-background);
        border: 1px solid var(--hairline);
        overflow: hidden;
        transition: border-color var(--fast-transition);
    }

    .post-tile__cover {
        display: block;
        width: 100%;
        aspect-ratio: 2 / 1;
        object-fit: cover;
        transition: var(--normal-transition);

        &--crest {
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: var(--surface-sunken);
            border-bottom: 1px solid var(--hairline);

            img {
                display: block;
                width: 4.5rem;
                height: 4.5rem;
                object-fit: cover;
                opacity: 0.55;
            }
        }
    }

    .post-tile__body {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        padding: var(--space-s) var(--space-s) var(--space-s);
    }

    .post-tile__tags {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2xs);
    }

    .post-tile__title {
        font-size: var(--step-0);
        line-height: 1.3;
        color: var(--highlight);
        text-wrap: balance;
    }

    .post-tile__excerpt {
        margin: 0;
        color: var(--text-muted);
        font-size: var(--step--1);
        line-height: 1.55;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        line-clamp: 2;
        overflow: hidden;
    }

    .post-tile__byline {
        margin-top: auto;
        padding-top: var(--space-2xs);
        display: flex;
        align-items: center;
        gap: var(--space-2xs);
        font-size: var(--step--1);
        color: var(--foreground);

        img {
            flex: none;
            display: block;
        }
    }

    .post-tile__hitbox {
        position: absolute;
        inset: 0;
        z-index: 1;

        &:focus-visible {
            outline: solid 2px var(--fleet-yellow);
            outline-offset: -2px;
        }
    }

    .post-tile:has(.post-tile__hitbox:focus-visible) {
        border-color: var(--fleet-yellow);
    }

    @media (hover: hover) {
        .post-tile:hover {
            border-color: color-mix(in srgb, var(--fleet-yellow) 50%, transparent);
        }

        .post-tile:hover .post-tile__cover:not(.post-tile__cover--crest) {
            transform: scale(1.03);
        }
    }
</style>
