---
import { i18n } from '@helpers/i18n'
const { lang, t } = i18n(Astro.url)

import type { MarketHealthChartPoint } from '@dtypes/api.minmatar.org'
import Chart from '@components/blocks/Chart.astro'

interface Props {
    history:            MarketHealthChartPoint[]
    type:               'contracts' | 'sell orders',
    [propName: string]: any
}

const {
    history,
    type,
    ...attributes
} = Astro.props
delete attributes.class


const points = [...history].reverse()

const labels = points.map((point) =>
    new Date(point.captured_at).toLocaleString(lang, {
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
    }),
)

const coverage = points.map((point) => type === 'contracts' ? point.contracts_health_pct : point.sell_orders_health_pct)
const viability = points.map((point) => type === 'contracts' ? point.contracts_viability_pct : point.sell_orders_viability_pct)

const include_viability = viability.some((value) => value != null)

type Tone = 'fleet-red' | 'fleet-yellow' | 'green'

// The line takes the health of the latest reading: green from 80%, yellow from 40%, red below.
const latest = (values: (number | null)[]) => [...values].reverse().find((value) => value != null)
const tone_of = (value: number | null | undefined): Tone => {
    if (value == null) return 'fleet-yellow'
    if (value >= 80) return 'green'
    if (value >= 40) return 'fleet-yellow'
    return 'fleet-red'
}

const datasets = [
    {
        label: t('coverage'),
        data: coverage,
        tone: tone_of(latest(coverage)),
        gradient: 35,
        borderWidth: 2.5,
        tension: 0,
        pointRadius: 0,
        pointHitRadius: 8,
    },
    ...(include_viability ? [{
        label: t('viability'),
        data: viability,
        tone: tone_of(latest(viability)),
        gradient: 35,
        borderWidth: 2,
        borderDash: [6, 4],
        tension: 0,
        pointRadius: 0,
        pointHitRadius: 8,
    }] : []),
]

const options = {
    interaction: { mode: 'index', intersect: false },
    scales: {
        x: { display: false },
        y: { display: false, min: 0, max: 100, clip: false },
    },
    plugins: { legend: { labels: { padding: 40 } } },
}
---

<Chart
    type='line'
    labels={labels}
    datasets={datasets}
    options={options}
    legend={true}
    height='calc(var(--space-3xl) * 4)'
    aria_label={t('ops_history_chart_aria')}
    empty_title={t('ops_history_chart_empty')}
    class:list={[Astro.props.class]}
    {...attributes}
/>
