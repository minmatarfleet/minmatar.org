---
import { i18n } from '@helpers/i18n'
import type { BuybackPurchaseOrder } from '@dtypes/api.minmatar.org'

import Flexblock from '@components/compositions/Flexblock.astro'
import BuybackPurchaseOrderItem from '@components/blocks/BuybackPurchaseOrderItem.astro'
import DataGrid from '@components/blocks/DataGrid.astro'
import EmptyState from '@components/blocks/EmptyState.astro'

interface Props {
    orders: BuybackPurchaseOrder[]
    can_manage?: boolean
    highlight_order_id?: string | null
    section_title?: string
}

const { t } = i18n(Astro.url)
const {
    orders,
    can_manage = false,
    highlight_order_id = null,
    section_title = t('buyback.purchase.orders.section_title'),
} = Astro.props
---

<section class="[ buyback-purchase-orders ]">
    <Flexblock gap="var(--space-s)">
        <h2>{section_title}</h2>

        {orders.length === 0 ? (
            <EmptyState title={t('buyback.purchase.orders.empty')} />
        ) : (
            <DataGrid
                variant="ledger"
                stack={true}
                min_width="70rem"
                aria-label={section_title}
                template="minmax(4rem, 0.5fr) minmax(10rem, 1.4fr) minmax(6rem, 0.8fr) minmax(7rem, 1fr) minmax(7rem, 0.9fr) minmax(6.5rem, 0.8fr) minmax(7rem, 1fr)"
                columns={[
                    t('buyback.purchase.orders.col.id'),
                    t('creator'),
                    t('buyback.purchase.orders.col.items'),
                    t('buyback.purchase.orders.col.total'),
                    t('status'),
                    t('date_created'),
                    t('buyback.purchase.orders.col.actions'),
                ]}
            >
                {orders.map((order) =>
                    <BuybackPurchaseOrderItem
                        order={order}
                        can_manage={can_manage}
                        highlighted={highlight_order_id === String(order.id)}
                    />
                )}
            </DataGrid>
        )}
    </Flexblock>
</section>

<style lang="scss">
    h2 {
        font-size: var(--step-1);
        margin: 0;
    }

    /* An open row menu must not be clipped by the scroller. */
    .buyback-purchase-orders :global(.xfade-scroll:has(.button-dropdown.is-open)) {
        overflow: visible;
        mask-image: none;
    }
</style>
