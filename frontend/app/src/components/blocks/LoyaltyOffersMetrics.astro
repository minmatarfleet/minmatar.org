---
import { i18n } from '@helpers/i18n'
const { lang, t, translatePath } = i18n(Astro.url)

import type { LoyaltyOffersMetrics } from '@helpers/loyalty_offers_metrics'
import {
    format_short_amount,
    type DeepOffersSummary,
} from '@helpers/loyalty_offers_rows'
import { number_name, number_thousand_separator } from '@helpers/numbers'

interface Props {
    metrics: LoyaltyOffersMetrics
    deep: DeepOffersSummary
    /** TLF standard buyback rate; null when not configured. */
    buyback_isk_per_lp: number | null
    [propName: string]: any
}

const { metrics, deep, buyback_isk_per_lp } = Astro.props

function rate(value: number): string {
    return number_thousand_separator(Math.round(value))
}

function range(min: number | null, max: number | null, format: (value: number) => string): string {
    if (min == null || max == null)
        return '—'
    if (format(min) === format(max))
        return format(min)
    return t('industry.loyalty.offers.decision.range')
        .replace('{min}', format(min))
        .replace('{max}', format(max))
}

const deep_note = deep.count === 0
    ? t('industry.loyalty.offers.decision.deep_none')
    : deep.count === 1
        ? t('industry.loyalty.offers.decision.deep_note_singular')
        : t('industry.loyalty.offers.decision.deep_note_plural').replace('{count}', String(deep.count))

function lp_exact(value: number): string {
    return t('industry.loyalty.offers.metrics.lp_exact').replace(
        '{lp}',
        number_thousand_separator(Math.round(value)),
    )
}

function volume_info(base: string, value: number): string {
    const compact = number_name(value, lang)
    const exact = lp_exact(value)
    const amount = compact ? `${compact} (${exact})` : exact
    return `${base} ${amount}`
}

interface SummaryItem {
    text: string
    info: string
}

const summary: SummaryItem[] = []
if (metrics.average_isk_per_lp != null) {
    summary.push({
        text: t('industry.loyalty.offers.summary.avg').replace(
            '{value}',
            rate(metrics.average_isk_per_lp),
        ),
        info: t('industry.loyalty.offers.metrics.avg_isk_lp_info'),
    })
}
summary.push(
    {
        text: t('industry.loyalty.offers.summary.weekly_total').replace(
            '{value}',
            format_short_amount(metrics.weekly_total_volume),
        ),
        info: volume_info(
            t('industry.loyalty.offers.metrics.weekly_total_info'),
            metrics.weekly_total_volume,
        ),
    },
    {
        text: t('industry.loyalty.offers.summary.weekly_stable').replace(
            '{value}',
            format_short_amount(metrics.weekly_stable_volume),
        ),
        info: volume_info(
            t('industry.loyalty.offers.metrics.weekly_stable_info'),
            metrics.weekly_stable_volume,
        ),
    },
)
---

<section
    class="[ loyalty-offers-decision ]"
    aria-label={t('industry.loyalty.offers.decision.aria_label')}
>
    <div class="[ loyalty-offers-decision__strip ]">
        <a
            class="[ loyalty-offers-decision__cell loyalty-offers-decision__cell--buyback ]"
            href={translatePath('/industry/loyalty/')}
        >
            <span class="[ loyalty-offers-decision__label ]">
                {t('industry.loyalty.offers.decision.buyback_label')}
                <span class="[ loyalty-offers-decision__arrow ]" aria-hidden="true">→</span>
            </span>
            <span class="[ loyalty-offers-decision__value ]">
                {buyback_isk_per_lp != null
                    ? rate(buyback_isk_per_lp)
                    : t('industry.loyalty.offers.decision.buyback_unset')}
                {buyback_isk_per_lp != null && (
                    <span class="[ loyalty-offers-decision__unit ]">
                        {t('industry.loyalty.offers.decision.isk_per_lp')}
                    </span>
                )}
            </span>
            <span class="[ loyalty-offers-decision__note ]">
                {t('industry.loyalty.offers.decision.buyback_note')}
            </span>
        </a>

        <div class="[ loyalty-offers-decision__cell ]">
            <span class="[ loyalty-offers-decision__label ]">
                {t('industry.loyalty.offers.decision.deep_label')}
            </span>
            <span class="[ loyalty-offers-decision__value ]">
                {range(deep.net_min, deep.net_max, rate)}
                {deep.net_min != null && (
                    <span class="[ loyalty-offers-decision__unit ]">
                        {t('industry.loyalty.offers.decision.isk_per_lp')}
                    </span>
                )}
            </span>
            <span class="[ loyalty-offers-decision__note ]">{deep_note}</span>
        </div>

        <div class="[ loyalty-offers-decision__cell ]">
            <span class="[ loyalty-offers-decision__label ]">
                {t('industry.loyalty.offers.decision.capital_label')}
            </span>
            <span class="[ loyalty-offers-decision__value ]">
                {range(deep.capital_min, deep.capital_max, format_short_amount)}
            </span>
            <span class="[ loyalty-offers-decision__note ]">
                {t('industry.loyalty.offers.decision.capital_note')}
            </span>
        </div>
    </div>

    <ul class="[ loyalty-offers-decision__summary ]">
        {summary.map((item) => (
            <li>
                <span
                    class="[ loyalty-offers-decision__summary-item ]"
                    tabindex="0"
                    data-tippy-content={item.info}
                >{item.text}</span>
            </li>
        ))}
    </ul>
</section>

<style lang="scss">
    .loyalty-offers-decision {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
    }

    .loyalty-offers-decision__strip {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
        gap: 1px;
        border: solid 1px var(--border-color);
        background-color: var(--border-color);
    }

    .loyalty-offers-decision__cell {
        // Subgrid keeps label, value and note on shared rows across cells.
        display: grid;
        grid-row: span 3;
        grid-template-rows: subgrid;
        align-content: start;
        row-gap: var(--space-3xs);
        padding-block: var(--space-s);
        padding-inline: var(--space-m);
        background-color: var(--component-background);
        color: var(--foreground);
        text-decoration: none;
        min-width: 0;
    }

    .loyalty-offers-decision__cell--buyback {
        box-shadow: inset var(--space-3xs) 0 0 var(--fleet-yellow);
        transition: background-color var(--fast-transition);

        &:focus-visible {
            outline: 1px solid var(--highlight);
            outline-offset: -2px;
        }

        @media (hover: hover) {
            &:hover {
                background-color: color-mix(in srgb, var(--fleet-yellow) 8%, var(--component-background));

                .loyalty-offers-decision__arrow {
                    transform: translateX(var(--space-3xs));
                }
            }
        }
    }

    .loyalty-offers-decision__label {
        display: flex;
        align-items: flex-end;
        gap: var(--space-2xs);
        font-size: var(--step--1);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--fleet-yellow);
    }

    .loyalty-offers-decision__arrow {
        transition: transform var(--fast-transition);
    }

    .loyalty-offers-decision__value {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: var(--space-2xs);
        font-family: var(--heading-font);
        font-size: var(--step-3);
        line-height: 1;
        color: var(--highlight);
        font-variant-numeric: tabular-nums;
    }

    .loyalty-offers-decision__unit {
        font-family: var(--default-font);
        font-size: var(--step--1);
        color: var(--faded);
    }

    .loyalty-offers-decision__note {
        font-size: var(--step--1);
        color: var(--faded);
    }

    .loyalty-offers-decision__summary {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3xs) var(--space-s);
        margin: 0;
        padding: 0;
        list-style: none;
        font-size: var(--step--2);
        color: var(--faded);

        li + li::before {
            content: '·';
            margin-inline-end: var(--space-s);
        }
    }

    .loyalty-offers-decision__summary-item {
        cursor: help;
        text-decoration: underline dotted color-mix(in srgb, currentColor 35%, transparent);
        text-underline-offset: 0.2em;

        &:focus-visible {
            outline: 1px solid var(--highlight);
            outline-offset: 2px;
        }
    }
</style>
