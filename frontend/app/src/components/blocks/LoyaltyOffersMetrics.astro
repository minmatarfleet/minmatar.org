---
import { i18n } from '@helpers/i18n'
const { lang, t } = i18n(Astro.url)

import type { LoyaltyOffersMetrics } from '@helpers/loyalty_offers_metrics'
import { format_number, number_name, number_thousand_separator } from '@helpers/numbers'

import Grid from '@components/compositions/Grid.astro'
import ComponentBlock from '@components/blocks/ComponentBlock.astro'

interface Props {
    metrics: LoyaltyOffersMetrics
    [propName: string]: any
}

const { metrics } = Astro.props

const avg_display = metrics.average_isk_per_lp != null
    ? metrics.average_isk_per_lp.toLocaleString('en-US', {
        minimumFractionDigits: 1,
        maximumFractionDigits: 1,
    })
    : '—'

function lp_display(value: number): string {
    if (value <= 0)
        return '0'
    return format_number(value, 1)
}

function lp_exact(value: number): string {
    return t('industry.loyalty.offers.metrics.lp_exact').replace(
        '{lp}',
        number_thousand_separator(Math.round(value)),
    )
}

function volume_info(base: string, value: number): string {
    const compact = number_name(value, lang)
    const exact = lp_exact(value)
    const amount = compact ? `${compact} (${exact})` : exact
    return `${base} ${amount}`
}

const cards = [
    {
        label: t('industry.loyalty.offers.metrics.avg_isk_lp'),
        value: avg_display,
        info: t('industry.loyalty.offers.metrics.avg_isk_lp_info'),
    },
    {
        label: t('industry.loyalty.offers.metrics.weekly_stable'),
        value: lp_display(metrics.weekly_stable_volume),
        info: volume_info(
            t('industry.loyalty.offers.metrics.weekly_stable_info'),
            metrics.weekly_stable_volume,
        ),
    },
    {
        label: t('industry.loyalty.offers.metrics.weekly_total'),
        value: lp_display(metrics.weekly_total_volume),
        info: volume_info(
            t('industry.loyalty.offers.metrics.weekly_total_info'),
            metrics.weekly_total_volume,
        ),
    },
]

const info_aria = t('industry.loyalty.offers.metrics.info_aria')
---

<section
    class="[ loyalty-offers-metrics ]"
    aria-label={t('industry.loyalty.offers.metrics.aria_label')}
>
    <Grid
        class="[ loyalty-offers-metrics__grid ]"
        min_item_width="220px"
        row_gap="var(--space-s)"
        column_gap="var(--space-s)"
    >
        {cards.map((card) => (
            <ComponentBlock
                class="[ loyalty-offers-metrics__card ]"
                padding_block="var(--space-m)"
                padding_inline="var(--space-m)"
            >
                <div class="[ loyalty-offers-metrics__header ]">
                    <p class="[ loyalty-offers-metrics__label ]">{card.label}</p>
                    <button
                        type="button"
                        class="[ loyalty-offers-metrics__info ]"
                        data-tippy-content={card.info}
                        aria-label={info_aria}
                    >
                        <span aria-hidden="true">i</span>
                    </button>
                </div>
                <p class="[ loyalty-offers-metrics__value ]">{card.value}</p>
            </ComponentBlock>
        ))}
    </Grid>
</section>

<style lang="scss">
    .loyalty-offers-metrics :global(.loyalty-offers-metrics__card) {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        height: 100%;
        box-sizing: border-box;
        position: relative;
    }

    .loyalty-offers-metrics__header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: var(--space-2xs);
    }

    .loyalty-offers-metrics__label {
        margin: 0;
        font-size: var(--step--1);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--fleet-yellow);
    }

    .loyalty-offers-metrics__info {
        flex-shrink: 0;
        display: inline-grid;
        place-items: center;
        width: var(--space-s);
        height: var(--space-s);
        margin: 0;
        padding: 0;
        border: 1px solid color-mix(in srgb, var(--faded) 70%, transparent);
        border-radius: 50%;
        background: transparent;
        color: var(--faded);
        font-family: var(--default-font);
        font-size: var(--step--2);
        font-weight: 600;
        line-height: 1;
        text-transform: lowercase;
        cursor: help;

        &:hover,
        &:focus-visible {
            color: var(--highlight);
            border-color: var(--highlight);
        }

        &:focus-visible {
            outline: 2px solid var(--highlight);
            outline-offset: 2px;
        }
    }

    .loyalty-offers-metrics__value {
        margin: 0;
        font-family: var(--heading-font);
        font-size: clamp(2rem, 4.5vw, 3rem);
        line-height: 0.95;
        letter-spacing: -0.02em;
        text-transform: uppercase;
        color: var(--highlight);
    }
</style>
