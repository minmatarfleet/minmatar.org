---
import { i18n, dynamic_key } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { query_string } from '@helpers/string';
import type { SummaryCharacter } from '@dtypes/api.minmatar.org'
import { account_user_id_query } from '@helpers/account_user_query'
import { get_request_user } from '@helpers/request_user'
import { get_public_api_url, get_app_url } from '@helpers/env'
import type { Alert } from '@dtypes/layout_components'

interface Props {
    pilots?:            Array<SummaryCharacter>;
    readonly?:          boolean;
    removed_character?: number | false;
    alert?:             Alert | false;
    [propName: string]: any;
}

const {
    pilots = [],
    readonly = true,
    removed_character = false,
    alert = false,
    ...attributes
} = Astro.props

const primary_pilot = Astro.cookies.has('primary_pilot') ? JSON.parse(Astro.cookies.get('primary_pilot')?.value as string) : null
const primary_pilot_id = primary_pilot ? parseInt(primary_pilot.character_id) : null
const account_user_query = account_user_id_query(get_request_user(Astro).auth_token)

// const ADD_PRIMARY_CHARACTER_URL = `${get_public_api_url()}/api/eveonline/characters/primary/add?redirect_url=${get_app_url()}${translatePath('/redirects/add_primary_character')}&token_type=Basic`
const ADD_CHARACTER_URL = `${translatePath('/redirects/add_character_init')}?redirect=${translatePath('/account')}`
const FIX_CHARACTER_URL = `${get_public_api_url()}/api/eveonline/characters/add?redirect_url=${get_app_url()}${translatePath('/account')}${account_user_query}`
const PILOTS_LIST_PARTIAL_URL = `${get_app_url()}${translatePath('/partials/pilots_list_component')}`
const SET_MAIN_CHARACTER_PARTIAL_URL = translatePath('/partials/set_primary_character')

// Scope groups shown as tags before the rest fold into "+N more".
const SCOPE_GROUPS_SHOWN = 2
const scope_group_label = (group:string) => t(dynamic_key(group)) ?? group

import Flexblock from '@components/compositions/Flexblock.astro';
import FlexInline from '@components/compositions/FlexInline.astro';
import Button from '@components/blocks/Button.astro';
import DisableBlock from '@components/blocks/DisableBlock.astro';
import CharacterPicture from '@components/blocks/CharacterPicture.astro';
import FixESITokenButton from '@components/blocks/FixESITokenButton.astro';
import Tag from '@components/blocks/Tag.astro';
import ActionMenu from '@components/blocks/ActionMenu.astro';
import ActionMenuItem from '@components/blocks/ActionMenuItem.astro';
import EmptyState from '@components/blocks/EmptyState.astro';

delete attributes.class
---

<DisableBlock
    id="pilots-list"
    disabled={false}
    x_model="enabled"
    class:list={['pilot-list', Astro.props.class]}
    {...attributes}
    x-data={`{
        pilots: ${JSON.stringify(pilots)},
        primary_pilot: ${primary_pilot_id},
        character_name_slugs: {},
        enabled: true,
        add_pilot(accepted) {
            if (accepted) window.location.href = "${ADD_CHARACTER_URL}"
        },
        fix_token_redirect(accepted, esi_token, character_id) {
            if (accepted) window.location.href = \`${FIX_CHARACTER_URL}&token_type=\${esi_token}&character_id=\${character_id}\`
        },
        pilot_list_init() {
            ${removed_character !== false ? `stop_remove_animation(${removed_character})` : ''}
            ${alert !== false ? `const root_data = Alpine.$data(document.body); if (root_data && root_data.show_alert_dialog) root_data.show_alert_dialog(${JSON.stringify(alert)})` : ''}
        }
    }`}
    x-init="pilot_list_init()"
>
    <Flexblock gap='0'>
        <FlexInline
            justification='space-between'
            gap="var(--space-s)"
            class="[ pilot-list__head ][ items-center ]"
        >
            <FlexInline gap="var(--space-xs)" class="[ items-baseline ]">
                <h2>{t('account.tab.characters')}</h2>
                <small class="[ pilot-list__muted ]">{pilots.length === 1 ? t('account.characters_count_one') : t('account.characters_count').replace('{count}', pilots.length.toString())}</small>
            </FlexInline>

            {!readonly &&
                <Button
                    size='sm'
                    type="button"
                    x-data={`{
                        show_add_pilot_disclaimer() {
                            const root_data = Alpine.$data(document.body)
                            if (!root_data || !root_data.show_alert_dialog) return Promise.resolve(false)
                            if (pilots.length == 0) {
                                return root_data.show_alert_dialog({
                                    title: ${JSON.stringify(t('add_primary_pilot_dialog_title'))},
                                    accept_label: ${JSON.stringify(t('scope_groups.continue'))},
                                    cancel_label: ${JSON.stringify(t('cancel'))},
                                    show_cancel: true,
                                    partial: ${JSON.stringify(`${translatePath('/partials/add_pilot_dialog/')}?${query_string({
                                        is_main: JSON.stringify(true),
                                    })}`)},
                                }).then((accepted) => add_pilot(accepted))
                            }
                            return root_data.show_alert_dialog({
                                title: ${JSON.stringify(t('add_pilot_dialog_title'))},
                                accept_label: ${JSON.stringify(t('scope_groups.continue'))},
                                cancel_label: ${JSON.stringify(t('cancel'))},
                                show_cancel: true,
                                partial: ${JSON.stringify(`${translatePath('/partials/add_pilot_dialog/')}?${query_string({
                                    is_main: JSON.stringify(false),
                                })}`)},
                            }).then((accepted) => add_pilot(accepted))
                        }
                    }`}
                    x-on:click="show_add_pilot_disclaimer"
                >
                    {pilots.length === 0 &&
                        t('add_primary_pilot')
                    }
                    {pilots.length > 0 &&
                        t('add_pilot')
                    }
                </Button>
            }
        </FlexInline>

        {pilots.length > 0 &&
            <div class="[ pilot-list__row pilot-list__columns ]" aria-hidden="true">
                <span>{t('account.column_character')}</span>
                <span>{t('account.column_corporation')}</span>
                <span>{t('account.column_esi')}</span>
                <span></span>
            </div>
        }

        <ul class="[ pilot-list__rows ]" role="list">
            {pilots.map((pilot) =>
                <li
                    class="[ pilot-list__row pilot-item ]"
                    x-bind:class={`{ 'blink-animation': remove_request_ongoing.includes(${pilot.character_id}) }`}
                >
                    <div class="[ pilot-list__who ]">
                        <CharacterPicture
                            character_id={pilot.character_id}
                            character_name={pilot.character_name}
                            size={64}
                        />
                        <Flexblock gap='0' class="[ min-w-0 ]">
                            <FlexInline gap='var(--space-2xs)' class="[ items-center ]">
                                <button
                                    type="button"
                                    class="[ pilot-list__name ][ truncate ]"
                                    set:text={pilot.character_name}
                                    x-data={`{
                                    show_character_modal() {
                                        show_modal({
                                            partial: '${translatePath('/partials/character_modal_component/')}?${query_string({
                                                character_id: pilot.character_id.toString(),
                                            })}'
                                        })
                                    }
                                    }`}
                                    x-on:click="show_character_modal()"
                                />
                                {pilot.is_primary &&
                                    <span class="[ pilot-list__main ]" title={t('main_character')}>{t('account.main_tag')}</span>
                                }
                            </FlexInline>
                            {(pilot.role_titles ?? []).length > 0 &&
                                <small class="[ pilot-list__muted ][ truncate ]">{(pilot.role_titles ?? []).join(' · ')}</small>
                            }
                            {pilot.flags.includes('NO_TAGS') &&
                                <small class="[ pilot-list__attention ]">{t('account.no_roles_yet')}</small>
                            }
                        </Flexblock>
                    </div>

                    <Flexblock gap='0' class="[ pilot-list__corp ][ min-w-0 ]">
                        <span class="[ truncate ]">{pilot.corp_name ?? '—'}</span>
                        <small class="[ pilot-list__muted ][ truncate ]">{pilot.alliance_name ?? t('account.no_alliance')}</small>
                    </Flexblock>

                    <div class="[ pilot-list__esi ]" aria-label={t('account.column_esi')}>
                        {pilot.token_status === 'SUSPENDED' &&
                            <Tag text={t('account.token_suspended')} color='security-status-point-4' text_color='var(--background)' />
                        }
                        {(pilot.actual_groups ?? []).slice(0, SCOPE_GROUPS_SHOWN).map((group) =>
                            <Tag text={scope_group_label(group)} color='hairline-strong' text_color='var(--highlight)' />
                        )}
                        {(pilot.actual_groups ?? []).length > SCOPE_GROUPS_SHOWN &&
                            <Tag
                                text={t('account.more_scope_groups').replace('{count}', ((pilot.actual_groups ?? []).length - SCOPE_GROUPS_SHOWN).toString())}
                                variant='outline'
                                tabindex="0"
                                data-tippy-content={(pilot.actual_groups ?? []).slice(SCOPE_GROUPS_SHOWN).map(scope_group_label).join(', ')}
                            />
                        }
                        {(pilot.actual_groups ?? []).length === 0 &&
                            <small class="[ pilot-list__muted ]">{t('account.public_only')}</small>
                        }
                    </div>

                    <div class="[ pilot-list__actions ]">
                        {!readonly &&
                            <ActionMenu
                                variant="button"
                                color="transparent"
                                size="sm"
                                trigger_label={t('account.more_actions').replace('CHARACTER_NAME', pilot.character_name)}
                            >
                                {!pilot.is_primary &&
                                    <ActionMenuItem
                                        x-data={`{
                                        show_set_main_dialog() {
                                            const root_data = Alpine.$data(document.body)
                                            if (!root_data || !root_data.show_confirm_dialog) return Promise.resolve(false)
                                            return root_data.show_confirm_dialog({
                                                title: ${JSON.stringify(t('set_main_character_dialog_title'))},
                                                partial: ${JSON.stringify(`${translatePath('/partials/dialog_with_character/')}?${query_string({
                                                    id: pilot.character_id,
                                                    character_name: pilot.character_name,
                                                    message: t('set_main_character_dialog_text')
                                                })}`)},
                                                hx: {
                                                    method: 'post',
                                                    url: ${JSON.stringify(`${SET_MAIN_CHARACTER_PARTIAL_URL}?${query_string({
                                                        id: pilot.character_id,
                                                        character_name: pilot.character_name,
                                                    })}`)},
                                                    target: '#pilots-list',
                                                    swap: 'outerHTML transition:true'
                                                }
                                            })
                                        }
                                    }`}
                                        x-on:click="close(); show_set_main_dialog()"
                                    >
                                        {t('set_primary_pilot')}
                                    </ActionMenuItem>
                                }
                                <ActionMenuItem href={translatePath(`/account/tags/${pilot.character_id}`)}>
                                    {t('account.edit_roles')}
                                </ActionMenuItem>
                                <div class="[ action-menu-item-host ]">
                                    <FixESITokenButton character={pilot} fix={pilot.token_status !== 'ACTIVE'} />
                                </div>
                                <ActionMenuItem
                                    variant="danger"
                                    x-data={`{
                                        show_remove_character_dialog() {
                                            const root_data = Alpine.$data(document.body)
                                            if (!root_data || !root_data.show_confirm_dialog) return Promise.resolve(false)
                                            return root_data.show_confirm_dialog({
                                                title: ${JSON.stringify(t('remove_pilot_dialog_title'))},
                                                partial: ${JSON.stringify(`${translatePath('/partials/dialog_with_character/')}?${query_string({
                                                    id: pilot.character_id.toString(),
                                                    character_name: pilot.character_name,
                                                    message: t('remove_pilot_dialog_text'),
                                                })}`)},
                                                return_on_accept: ${pilot.character_id},
                                                hx: {
                                                    method: 'delete',
                                                    url: ${JSON.stringify(`${PILOTS_LIST_PARTIAL_URL}?${query_string({
                                                        id: pilot.character_id.toString(),
                                                        character_name: pilot.character_name
                                                    })}`)},
                                                    target: '#pilots-list',
                                                    swap: 'outerHTML transition:true'
                                                }
                                            }).then((character_id) => start_remove_animation(character_id))
                                        }
                                    }`}
                                    x-on:click="close(); show_remove_character_dialog()"
                                >
                                    {t('account.remove_character')}
                                </ActionMenuItem>
                            </ActionMenu>
                        }
                    </div>
                </li>
            )}
        </ul>
        {pilots.length == 0 &&
            <div class="[ pilot-list__fallback ]">
                <slot>
                    <EmptyState title={t('empty_pilots_text')} />
                </slot>
            </div>
        }
    </Flexblock>
</DisableBlock>

<style lang="scss">
    .pilot-list {
        transition: var(--slow-transition);

        &.disabled {
            pointer-events: none;
            opacity: 0.25;
        }
    }

    .pilot-list__head {
        padding-block-end: var(--space-s);
    }

    .pilot-list__muted {
        color: var(--text-muted);
    }

    .pilot-list__attention {
        color: var(--security-status-point-4);
    }

    .pilot-list__rows {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .pilot-list__row {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(0, 1.5fr) minmax(0, 2.4fr) 8rem;
        gap: var(--space-s);
        align-items: center;
        padding-block: var(--space-xs);
        border-block-start: 1px solid var(--border-color);
    }

    .pilot-list__columns {
        padding-block: var(--space-2xs);
        font-family: var(--heading-font);
        font-size: var(--step--2);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
    }

    .pilot-list__who {
        display: grid;
        grid-template-columns: 48px minmax(0, 1fr);
        gap: var(--space-xs);
        align-items: center;

        > :global(picture),
        > :global(img) {
            inline-size: 48px;
            block-size: 48px;
        }

        :global(img) {
            object-fit: cover;
            width: 100%;
            height: 100%;
        }
    }

    .pilot-list__name {
        all: unset;
        cursor: pointer;
        color: var(--highlight);
        font-weight: 600;

        &:focus-visible {
            outline: solid 2px var(--fleet-yellow);
            outline-offset: 2px;
        }
    }

    .pilot-list__main {
        padding: 0 var(--space-3xs);
        border: 1px solid color-mix(in srgb, var(--foreground) 55%, transparent);
        font-size: var(--step--2);
        font-weight: 600;
        white-space: nowrap;
    }

    .pilot-list__esi {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3xs);
        align-items: center;
    }

    .pilot-list__actions {
        display: flex;
        justify-content: flex-end;
    }

    .pilot-list__fallback {
        padding-block: var(--space-s);
        border-block-start: 1px solid var(--border-color);
    }

    // Phones: one card per character; corp, ESI and the actions stack under the name.
    @media (max-width: 48rem) {
        .pilot-list__columns {
            display: none;
        }

        .pilot-list__row {
            grid-template-columns: minmax(0, 1fr) 8rem;
            row-gap: var(--space-2xs);
            align-items: start;
        }

        .pilot-list__who {
            grid-column: 1;
        }

        .pilot-list__actions {
            grid-column: 2;
            grid-row: 1;
        }

        .pilot-list__corp,
        .pilot-list__esi {
            grid-column: 1 / -1;
            padding-inline-start: calc(48px + var(--space-xs));
        }
    }
</style>
