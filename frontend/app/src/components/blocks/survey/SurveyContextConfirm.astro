---
import type { MemberContext } from '@dtypes/survey'
import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import { get_player_icon, get_corporation_logo } from '@helpers/eve_image_server'

interface Props {
    context: MemberContext
    [propName: string]: any
}

const { context } = Astro.props

const PRIME_LABELS: Record<string, string> = {
    US: 'US',
    US_AP: 'US / AP',
    AP: 'AP',
    AP_EU: 'AP / EU',
    EU: 'EU',
    EU_US: 'EU / US',
}

// Red → green colour for the relative-standing bands.
const BAND_COLOR: Record<string, string> = {
    'Below average': 'hsl(6, 62%, 55%)',
    Average: 'hsl(45, 70%, 52%)',
    'Above average': 'hsl(95, 55%, 48%)',
    'Top 1%': 'hsl(120, 60%, 46%)',
}

const stats = [
    {
        label: 'Tenure',
        value: context.tenure_days != null ? `${context.tenure_days}d` : '—',
        note: context.tenure_note,
    },
    {
        label: 'Fleets this quarter',
        value: `${context.fleets_attended_quarter}`,
        note: context.fleets_note,
    },
    {
        label: 'Guides completed',
        value: `${context.guides_completed}`,
        note: context.guides_note,
    },
]

const prime_label = context.prime_time
    ? PRIME_LABELS[context.prime_time] ?? context.prime_time
    : 'Prime time not set'
---

<div class="[ profile ]">
    <div class="[ profile__head ]">
        {context.character_id && (
            <img
                class="[ profile__portrait ]"
                src={get_player_icon(context.character_id, 64)}
                alt={context.character_name}
                width="56"
                height="56"
                loading="lazy"
            />
        )}
        <Flexblock gap="var(--space-3xs)">
            <span class="[ profile__name ]">{context.character_name || 'Unknown pilot'}</span>
            <FlexInline gap="var(--space-2xs)">
                <span class="[ profile__corp ]">{context.corporation_name || '—'}</span>
                {context.community_status && (
                    <span class:list={['[ chip ]', `chip--${context.community_status}`]}>
                        {context.community_status}
                    </span>
                )}
                <span
                    class:list={['[ tz-pill ]', { 'tz-pill--unset': !context.prime_time }]}
                    title={context.timezone_note}
                >
                    {prime_label}
                </span>
            </FlexInline>
        </Flexblock>
    </div>

    {context.corp_history.length > 0 && (
        <div class="[ profile__block ]">
            <span class="[ label ]">Corporation</span>
            <ul class="[ corp-list ]">
                {context.corp_history.map((c) => (
                    <li class:list={['[ corp-item ]', { 'corp-item--current': c.is_current }]}>
                        <img
                            class="[ corp-logo ]"
                            src={get_corporation_logo(c.corporation_id, 32)}
                            alt={c.name}
                            width="24"
                            height="24"
                            loading="lazy"
                        />
                        <span class="[ corp-name ]">{c.name}</span>
                        <span class="[ corp-ticker ]">[{c.ticker}]</span>
                        <span class="[ corp-days ]">{c.days}d</span>
                        {c.is_current && <span class="[ corp-tag corp-tag--current ]">current</span>}
                        {c.is_academy && <span class="[ corp-tag corp-tag--academy ]">academy</span>}
                    </li>
                ))}
            </ul>
        </div>
    )}

    {context.tribes.length > 0 && (
        <div class="[ profile__tribes ]">
            <span class="[ label ]">Tribes</span>
            <FlexInline gap="var(--space-2xs)">
                {context.tribes.map((tribe) => (
                    <span class="[ tribe-pill ]" title={tribe.chief_name ? `Chief: ${tribe.chief_name}` : tribe.label}>
                        {tribe.chief_id && (
                            <img
                                class="[ tribe-pill__chief ]"
                                src={get_player_icon(tribe.chief_id, 32)}
                                alt={tribe.chief_name}
                                width="20"
                                height="20"
                                loading="lazy"
                            />
                        )}
                        <span>{tribe.label}</span>
                    </span>
                ))}
            </FlexInline>
        </div>
    )}

    <div class="[ profile__stats ]">
        {stats.map((s) => (
            <div class="[ stat ]">
                <span class="[ stat__value ]">{s.value}</span>
                <span class="[ label ]">{s.label}</span>
                {s.note && (
                    <span
                        class="[ stat__note ]"
                        style={BAND_COLOR[s.note] ? `color: ${BAND_COLOR[s.note]}` : ''}
                    >
                        {s.note}
                    </span>
                )}
            </div>
        ))}
    </div>

</div>

<style lang="scss">
    .profile { display: flex; flex-direction: column; gap: var(--space-m); }
    .profile__head {
        display: flex;
        align-items: center;
        gap: var(--space-m);
        padding-bottom: var(--space-m);
        border-bottom: 1px solid var(--border-color, rgba(255, 255, 255, 0.1));
    }
    .profile__portrait {
        border-radius: 4px;
        border: 1px solid var(--border-color, rgba(255, 255, 255, 0.15));
        flex-shrink: 0;
    }
    .profile__name {
        font-family: var(--heading-font, inherit);
        font-size: var(--step-2);
        font-weight: 700;
        color: var(--highlight);
        line-height: 1;
    }
    .profile__corp { color: var(--fleet-yellow); }
    .chip {
        text-transform: uppercase;
        font-size: 0.68em;
        letter-spacing: 0.06em;
        padding: 2px 10px;
        border-radius: 999px;
        border: 1px solid currentColor;
    }
    .chip--active { color: var(--green); }
    .chip--trial { color: var(--fleet-yellow); }
    .chip--on_leave { color: var(--foreground); opacity: 0.6; }

    .profile__block { display: flex; flex-direction: column; gap: var(--space-2xs); }
    .corp-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
    }
    .corp-item {
        display: flex;
        align-items: center;
        gap: var(--space-2xs);
        font-size: 0.9em;
    }
    .corp-logo {
        border-radius: 3px;
        flex-shrink: 0;
        border: 1px solid var(--border-color, rgba(255, 255, 255, 0.12));
    }
    .corp-name { color: var(--highlight); }
    .corp-ticker { color: var(--fleet-yellow); opacity: 0.75; font-size: 0.9em; }
    .corp-days {
        color: var(--foreground);
        opacity: 0.55;
        font-variant-numeric: tabular-nums;
    }
    .corp-item--current .corp-name { font-weight: 700; }
    .corp-tag {
        font-size: 0.62em;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 1px 7px;
        border-radius: 999px;
        border: 1px solid currentColor;
    }
    .corp-tag--current { color: var(--green); }
    .corp-tag--academy { color: var(--fleet-yellow); }

    .profile__tribes { display: flex; flex-direction: column; gap: var(--space-3xs); }
    .label {
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.72em;
        color: var(--foreground);
        opacity: 0.55;
    }
    .tribe-pill {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3xs);
        font-size: 0.85em;
        padding: 3px 10px 3px 3px;
        border-radius: 999px;
        background: var(--fill-and-stroke, rgba(255, 255, 255, 0.06));
        border: 1px solid var(--border-color, rgba(255, 255, 255, 0.1));
        color: var(--highlight);
        cursor: default;
    }
    .tribe-pill__chief { border-radius: 50%; flex-shrink: 0; }

    .profile__stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1px;
        background: var(--border-color, rgba(255, 255, 255, 0.1));
        border: 1px solid var(--border-color, rgba(255, 255, 255, 0.1));
        border-radius: 6px;
        overflow: hidden;
    }
    .stat {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: var(--space-s) var(--space-m);
        background: var(--background, #0d0d0d);
    }
    .stat__value {
        font-size: var(--step-1);
        font-weight: 700;
        color: var(--highlight);
        font-variant-numeric: tabular-nums;
    }
    .stat__note {
        font-size: 0.72em;
        color: var(--fleet-yellow);
        opacity: 0.8;
    }
    .tz-pill {
        font-size: 0.72em;
        padding: 2px 10px;
        border-radius: 999px;
        border: 1px solid var(--border-color, rgba(255, 255, 255, 0.2));
        color: var(--fleet-yellow);
    }
    .tz-pill--unset { color: var(--foreground); opacity: 0.5; }

    @media (max-width: 34rem) {
        .profile__head { flex-wrap: wrap; }
        .profile__stats { grid-template-columns: 1fr; }
    }
</style>
