---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { ButtonSizes } from '@dtypes/layout_components';
import { get_request_user } from '@helpers/request_user'

import { get_app_url } from '@helpers/env'

import ClipboardButton from '@components/blocks/ClipboardButton.astro';

interface Props {
    fitting_id:         number;
    narrow?:            boolean;
    size?:              ButtonSizes;
    iconed?:            boolean;
    [propName: string]: any;
}

const {
    fitting_id,
    narrow = false,
    size = 'sm',
    iconed = true,
    ...attributes
} = Astro.props

const { auth_token, user } = get_request_user(Astro)

const fitting_path = translatePath(`/ships/fittings/${fitting_id}`)
const share_url = user
    ? `${get_app_url(fitting_path)}?ref=${user.user_id}`
    : get_app_url(fitting_path)
---

<ClipboardButton
    id={`fitting-share-${fitting_id}`}
    text={t('share')}
    copied_text={t('copied')}
    narrow={narrow}
    size={size}
    iconed={iconed}
    {...attributes}
>
    {share_url}
</ClipboardButton>
