---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { ButtonSizes } from '@dtypes/layout_components';
import { get_request_user } from '@helpers/request_user'

import { get_app_url } from '@helpers/env'
import { fitting_path } from '@helpers/ship_paths'

import ClipboardButton from '@components/blocks/ClipboardButton.astro';

interface Props {
    fitting_id:         number;
    fitting_name?:      string | null;
    narrow?:            boolean;
    size?:              ButtonSizes;
    iconed?:            boolean;
    [propName: string]: any;
}

const {
    fitting_id,
    fitting_name,
    narrow = false,
    size = 'sm',
    iconed = true,
    ...attributes
} = Astro.props

const { user } = get_request_user(Astro)

const share_path = translatePath(fitting_path(fitting_id, fitting_name))
const share_url = user
    ? `${get_app_url(share_path)}?ref=${user.user_id}`
    : get_app_url(share_path)
---

<ClipboardButton
    id={`fitting-share-${fitting_id}`}
    text={t('share')}
    copied_text={t('copied')}
    narrow={narrow}
    size={size}
    iconed={iconed}
    {...attributes}
>
    {share_url}
</ClipboardButton>
