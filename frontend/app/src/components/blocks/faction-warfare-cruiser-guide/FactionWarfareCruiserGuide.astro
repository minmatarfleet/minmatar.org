---
import {
    guideMeta,
    credits,
    additionalResources,
    introduction,
    considerations,
    considerationBullets,
    disclaimers,
    metagameSummary,
    glossary,
    guideSections,
    matchupLegend,
    matchupCharts,
    shipGuides,
} from '@/data/faction-warfare-cruiser-guide'

import GuideContentsLayout from '@components/blocks/GuideContentsLayout.astro'
import ComponentBlock from '@components/blocks/ComponentBlock.astro'
import GuideShell from '@components/blocks/GuideShell.astro'
import GuideMatchupChart from '@components/blocks/ship-guide/GuideMatchupChart.astro'
import GuideShipSection from '@components/blocks/ship-guide/GuideShipSection.astro'
import { getGuideFittingsForShip } from '@/data/faction-warfare-cruiser-guide'
import { resolveMatchupOpponentShip } from '@/data/faction-warfare-cruiser-guide/opponent-ships'
import { get_fittings } from '@helpers/api.minmatar.org/ships'
import type { Fitting } from '@dtypes/api.minmatar.org'

let fittingLibrary: Fitting[] = []
try {
    fittingLibrary = await get_fittings()
} catch {
    fittingLibrary = []
}
---

<GuideShell
    title={guideMeta.title}
    subtitle={`${guideMeta.edition} · ${guideMeta.yc}`}
>
    <div class="fwc-guide">
    <GuideContentsLayout sections={guideSections}>
            <section id="introduction" data-section-id="introduction" class="fwc-section" aria-labelledby="fwc-intro-title">
                <ComponentBlock variant="guide">
                    <h2 id="fwc-intro-title">Introduction</h2>
                    {
                        introduction.map((paragraph) => (
                            <p class="fwc-section__paragraph" set:html={paragraph} />
                        ))
                    }
                </ComponentBlock>
            </section>

            <section id="considerations" data-section-id="considerations" class="fwc-section" aria-labelledby="fwc-considerations-title">
                <ComponentBlock variant="guide">
                    <h2 id="fwc-considerations-title">Considerations of the Metagame</h2>
                    {
                        considerations.map((paragraph) => (
                            <p class="fwc-section__paragraph">{paragraph}</p>
                        ))
                    }
                    <ul class="fwc-section__list">
                        {
                            considerationBullets.map((bullet) => (
                                <li>{bullet}</li>
                            ))
                        }
                    </ul>
                </ComponentBlock>
            </section>

            <section id="disclaimers" data-section-id="disclaimers" class="fwc-section" aria-labelledby="fwc-disclaimers-title">
                <ComponentBlock variant="guide">
                    <h2 id="fwc-disclaimers-title">Disclaimers</h2>
                    {
                        disclaimers.map((paragraph) => (
                            <p class="fwc-section__paragraph">{paragraph}</p>
                        ))
                    }
                </ComponentBlock>
            </section>

            <section id="summary" data-section-id="summary" class="fwc-section" aria-labelledby="fwc-summary-title">
                <ComponentBlock variant="guide">
                    <h2 id="fwc-summary-title">Summary of the Metagame</h2>
                    <div class="fwc-summary-grid">
                        {
                            metagameSummary.map((entry) => (
                                <article class="fwc-summary-card">
                                    <h3 class="fwc-summary-card__title">{entry.archetype}</h3>
                                    <p class="fwc-summary-card__text">{entry.text}</p>
                                </article>
                            ))
                        }
                    </div>
                </ComponentBlock>
            </section>

            <section id="matchups" data-section-id="matchups" class="fwc-section" aria-labelledby="fwc-matchups-title">
                <ComponentBlock variant="guide">
                    <h2 id="fwc-matchups-title">Matchup Charts</h2>

                    <p class="fwc-charts-mobile-note">
                        Matchup charts are available on desktop.
                    </p>

                    <div class="fwc-charts-desktop">
                        <div class="fwc-legend" aria-label="Matchup rating legend">
                            {
                                matchupLegend.map((item) => (
                                    <div class="fwc-legend__item">
                                        <span class:list={['fwc-legend__symbol', `fwc-legend__symbol--${item.rating === '?' ? 'unknown' : item.rating.replace(/\+/g, 'plus').replace(/-/g, 'minus').replace(/=/g, 'even')}`]}>
                                            {item.rating}
                                        </span>
                                        <span class="fwc-legend__label">
                                            <strong>{item.label}</strong>
                                            <span>{item.description}</span>
                                        </span>
                                    </div>
                                ))
                            }
                        </div>

                        <div class="fwc-charts-grid">
                            {
                                matchupCharts.map((chart) => (
                                    <GuideMatchupChart chart={chart} />
                                ))
                            }
                        </div>
                    </div>
                </ComponentBlock>
            </section>

            <div class="fwc-guide__ships">
                {
                    shipGuides.map((ship) => (
                        <GuideShipSection
                            ship={ship}
                            fittings={getGuideFittingsForShip(ship.id)}
                            fitting_library={fittingLibrary}
                            hull_class="Cruiser"
                            id_prefix="fwc"
                            resolve_opponent={resolveMatchupOpponentShip}
                            fits_lead="Example fittings for each role above. Copy into Pyfa / EFT, then tune for your skills and contracts."
                        />
                    ))
                }
            </div>

            <section id="glossary" data-section-id="glossary" class="fwc-section" aria-labelledby="fwc-glossary-title">
                <ComponentBlock variant="guide">
                    <h2 id="fwc-glossary-title">Glossary</h2>
                    <dl class="fwc-glossary">
                        {
                            glossary.map((entry) => (
                                <>
                                    <dt class="fwc-glossary__term">{entry.term}</dt>
                                    <dd class="fwc-glossary__definition">{entry.definition}</dd>
                                </>
                            ))
                        }
                    </dl>
                </ComponentBlock>
            </section>

            <section id="resources" data-section-id="resources" class="fwc-section" aria-labelledby="fwc-resources-title">
                <ComponentBlock variant="guide">
                    <h2 id="fwc-resources-title">Additional Resources</h2>
                    <p class="fwc-section__paragraph">
                        Written by {credits.author}. The links below cover sibling hull guides, plex fundamentals, and deeper yearly data when you want another angle.
                    </p>
                    <ul class="fwc-resources">
                        {
                            additionalResources.map((resource) => (
                                <li class="fwc-resources__item">
                                    <a
                                        href={resource.href}
                                        target={resource.href.startsWith('http') ? '_blank' : undefined}
                                        rel={resource.href.startsWith('http') ? 'nofollow noopener noreferrer' : undefined}
                                        class="fwc-guide__link"
                                    >
                                        {resource.title}
                                    </a>
                                    <span class="fwc-resources__note">{resource.note}</span>
                                </li>
                            ))
                        }
                    </ul>
                </ComponentBlock>
            </section>
    </GuideContentsLayout>
    </div>
</GuideShell>

<style lang="scss">
    .fwc-guide {
        --fwc-display-font: var(--guide-display-font);
        font-family: inherit;
    }



    .fwc-guide__ships {
        display: flex;
        flex-direction: column;
        gap: var(--space-l);
    }

    .fwc-section {
        scroll-margin-top: calc(var(--header-height, 4rem) + var(--space-l));
    }


    .fwc-section__subtitle {
        margin: var(--space-l) 0 var(--space-m);
        font-family: var(--fwc-display-font);
        font-size: var(--step-0);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--highlight);
    }

    .fwc-section__paragraph {
        margin: 0 0 var(--space-m);
        font-size: var(--step-0);
        line-height: 1.7;
        max-width: var(--max-text-width);
    }

    .fwc-section__paragraph :global(a) {
        color: var(--highlight);
        text-decoration: underline;
        text-underline-offset: 0.15em;
    }

    .fwc-section__list {
        margin: 0;
        padding-left: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: var(--space-s);
        line-height: 1.65;
        max-width: var(--max-text-width);
    }

    .fwc-section__cover {
        margin: 0 0 var(--space-xl);
    }

    .fwc-section__cover-image,
    .fwc-section__figure-image {
        display: block;
        width: 100%;
        border: 1px solid color-mix(in srgb, var(--border-color) var(--tint-heavy), transparent);
    }

    .fwc-section__figure {
        margin: var(--space-xl) 0 0;
    }

    .fwc-section__figcaption {
        margin-top: var(--space-xs);
        font-size: var(--step--2);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-color-secondary, var(--faded));
    }

    .fwc-resources {
        margin: 0;
        padding: 0;
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: var(--space-m);
        max-width: var(--max-text-width);
    }

    .fwc-resources__item {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        line-height: 1.55;
    }

    .fwc-resources__note {
        font-size: var(--step--1);
        color: var(--text-color-secondary, var(--faded));
    }

    .fwc-guide__link {
        color: var(--highlight);
        text-decoration: underline;
        text-decoration-color: color-mix(in srgb, var(--fleet-yellow) var(--tint-strong), transparent);
        text-underline-offset: 0.15em;

        &:hover,
        &:focus-visible {
            color: var(--fleet-yellow);
            text-decoration-color: currentColor;
        }
    }

    .fwc-summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
        gap: var(--space-m);
        margin-top: var(--space-m);
    }

    .fwc-summary-card {
        padding: var(--component-padding-block) var(--space-m);
        background: color-mix(in srgb, var(--component-background) var(--tint-heavy), transparent);
        border: 1px solid color-mix(in srgb, var(--border-color) var(--tint-heavy), transparent);
    }

    .fwc-summary-card .fwc-summary-card__title {
        margin: 0 0 var(--space-s);
        font-family: var(--fwc-display-font);
        font-size: var(--step--1);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--fleet-red);
    }

    .fwc-summary-card__text {
        margin: 0;
        font-size: var(--step--1);
        line-height: 1.6;
    }

    .fwc-legend {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs);
        margin-bottom: var(--space-l);
        padding: var(--space-s);
        background: color-mix(in srgb, var(--component-background) var(--tint-bold), transparent);
        border: 1px solid color-mix(in srgb, var(--border-color) var(--tint-bold), transparent);
    }

    .fwc-legend__item {
        display: flex;
        align-items: center;
        gap: var(--space-xs);
        padding: var(--space-xs) var(--space-s);
        background: color-mix(in srgb, var(--component-background) var(--tint-heavy), transparent);
        border: 1px solid color-mix(in srgb, var(--border-color) var(--tint-bold), transparent);
    }

    .fwc-legend__symbol {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 1.75rem;
        min-height: 1.75rem;
        border-radius: 999px;
        font-family: var(--fwc-display-font);
        font-size: var(--step--1);
        font-weight: 700;
    }

    .fwc-legend__symbol--plusplus { background: color-mix(in srgb, var(--green) var(--tint-strong), transparent); color: var(--green-text); }
    .fwc-legend__symbol--plus { background: color-mix(in srgb, var(--green) var(--tint-soft), transparent); color: var(--green-text); }
    .fwc-legend__symbol--even { background: color-mix(in srgb, var(--alliance-blue) var(--tint-soft), transparent); color: var(--alliance-blue-text); }
    .fwc-legend__symbol--minus { background: color-mix(in srgb, var(--fleet-red) var(--tint-soft), transparent); color: var(--fleet-red-text); }
    .fwc-legend__symbol--minusminus { background: color-mix(in srgb, var(--fleet-red) var(--tint-strong), transparent); color: var(--fleet-red-text); }
    .fwc-legend__symbol--unknown { background: color-mix(in srgb, var(--faded) var(--tint-soft), transparent); color: var(--text-color-secondary, var(--faded)); }

    .fwc-legend__label {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
        font-size: var(--step--1);

        strong {
            font-size: var(--step--1);
        }

        span {
            font-size: var(--step--2);
            color: var(--text-color-secondary, var(--faded));
        }
    }

    @media (min-width: 48rem) {
        .fwc-legend__label {
            flex-direction: row;
            align-items: baseline;
            gap: var(--space-2xs);
        }

        .fwc-legend__label span {
            font-size: var(--step--1);
        }
    }

    .fwc-charts-mobile-note {
        margin: 0;
        padding: var(--space-s);
        border: 1px solid color-mix(in srgb, var(--border-color) var(--tint-bold), transparent);
        background: color-mix(in srgb, var(--component-background) var(--tint-bold), transparent);
        font-size: var(--step--1);
        line-height: 1.55;
        color: var(--text-color-secondary, var(--faded));
    }

    .fwc-charts-desktop {
        display: none;
    }

    @media (min-width: 48rem) {
        .fwc-charts-mobile-note {
            display: none;
        }

        .fwc-charts-desktop {
            display: contents;
        }
    }

    .fwc-charts-grid {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xl);
    }

    .fwc-glossary {
        display: grid;
        grid-template-columns: minmax(6rem, 10rem) 1fr;
        gap: var(--space-s) var(--space-l);
        margin: 0 0 var(--space-xl);
    }

    .fwc-glossary__term {
        margin: 0;
        font-weight: 700;
        color: var(--fleet-yellow);
    }

    .fwc-glossary__definition {
        margin: 0;
        line-height: 1.6;
    }

    @media (max-width: 40rem) {
        .fwc-glossary {
            grid-template-columns: 1fr;
        }
    }
</style>
