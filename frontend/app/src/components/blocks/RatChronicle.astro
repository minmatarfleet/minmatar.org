---
import { ratChronicleChapters } from '@/data/rat-chronicle'
import RatChronicleChapter from '@components/blocks/RatChronicleChapter.astro'
import RatChronicleDate from '@components/blocks/RatChronicleDate.astro'
import XFadeScroll from '@components/compositions/XFadeScroll.astro'

interface Props {
    activeChapterId: string
}

const { activeChapterId } = Astro.props
const chapters = ratChronicleChapters
const active_index = Math.max(0, chapters.findIndex((chapter) => chapter.id === activeChapterId))
const active_chapter = chapters[active_index]
const previous_chapter = chapters[active_index - 1]
const next_chapter = chapters[active_index + 1]
---

<div
    class="rat-chronicle"
    x-data={`{
        init_zoom() {
            mediumZoom('[data-zoomable]', {
                background: 'var(--solid-transparency-background)',
                scrollOffset: 0,
                margin: 24,
                metaClick: false,
            })
        },
        center_active_tab(scroller) {
            const tab = scroller.querySelector('[aria-current=page]')
            if (!tab) return
            const offset = tab.getBoundingClientRect().left - scroller.getBoundingClientRect().left
            scroller.scrollLeft += offset - (scroller.clientWidth - tab.offsetWidth) / 2
        }
    }`}
    x-init="init_zoom()"
>
    <header class="rat-chronicle__masthead">
        <p class="rat-chronicle__series">The Rat Chronicle</p>
        <p class="rat-chronicle__subtitle">A history of Minmatar Fleet Alliance · YC125 — YC128</p>
    </header>

    <nav class="rat-chronicle__timeline" aria-label="Chapters">
        <XFadeScroll
            class="rat-chronicle__scroller"
            fade_size="var(--space-xl)"
            x-init="$nextTick(() => center_active_tab($el))"
        >
            <ol class="rat-chronicle__tabs">
                {
                    chapters.map((chapter, index) => (
                        <li class="rat-chronicle__tab-item">
                            <a
                                href={`/alliance/story/${chapter.id}/`}
                                class:list={[
                                    'rat-chronicle__tab',
                                    { active: chapter.id === activeChapterId },
                                ]}
                                aria-current={chapter.id === activeChapterId ? 'page' : undefined}
                            >
                                <span class="rat-chronicle__tab-marker" aria-hidden="true"></span>
                                <span class="rat-chronicle__tab-number">Chapter {chapter.number}</span>
                                <span class="rat-chronicle__tab-title">{chapter.title}</span>
                                <RatChronicleDate
                                    class="rat-chronicle__tab-date"
                                    months={chapter.dateRange}
                                    yc={chapter.yc}
                                    realYear={chapter.realYear}
                                />
                            </a>
                            {index < chapters.length - 1 && (
                                <span class="rat-chronicle__connector" aria-hidden="true"></span>
                            )}
                        </li>
                    ))
                }
            </ol>
        </XFadeScroll>
    </nav>

    <div class="rat-chronicle__content">
        {active_chapter && <RatChronicleChapter chapter={active_chapter} />}
    </div>

    {(previous_chapter || next_chapter) && (
        <nav class="rat-chronicle__pager" aria-label="Chapter navigation">
            {previous_chapter && (
                <a
                    href={`/alliance/story/${previous_chapter.id}/`}
                    class="rat-chronicle__pager-link rat-chronicle__pager-link--previous"
                    rel="prev"
                >
                    <span class="rat-chronicle__pager-kicker">← Chapter {previous_chapter.number}</span>
                    <span class="rat-chronicle__pager-title">{previous_chapter.title}</span>
                </a>
            )}
            {next_chapter && (
                <a
                    href={`/alliance/story/${next_chapter.id}/`}
                    class="rat-chronicle__pager-link rat-chronicle__pager-link--next"
                    rel="next"
                >
                    <span class="rat-chronicle__pager-kicker">Chapter {next_chapter.number} →</span>
                    <span class="rat-chronicle__pager-title">{next_chapter.title}</span>
                </a>
            )}
        </nav>
    )}
</div>

<style lang="scss">
    @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap');

    .rat-chronicle {
        --chronicle-font: 'Lora', 'Georgia', 'Times New Roman', serif;
        width: 100%;
        padding: var(--space-xl) var(--space-l-xl);
        background: color-mix(in srgb, var(--component-background) 55%, transparent);
        border: 1px solid color-mix(in srgb, var(--border-color) 65%, transparent);

        :global(.chronicle-mark) {
            font-weight: 700;
            font-style: normal;
            color: var(--fleet-red);
        }
    }

    .rat-chronicle__masthead {
        margin-bottom: var(--space-2xl);
        text-align: center;
    }

    .rat-chronicle__series {
        margin: 0;
        font-family: var(--heading-font);
        font-size: clamp(var(--step-2), 3vw, var(--step-3));
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--highlight);
    }

    .rat-chronicle__subtitle {
        margin: var(--space-s) 0 0;
        font-size: var(--step--1);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-color-secondary, var(--faded));
    }

    .rat-chronicle__timeline {
        position: relative;
        margin-bottom: var(--space-2xl);
    }

    .rat-chronicle__scroller {
        scrollbar-width: thin;
        scrollbar-color: color-mix(in srgb, var(--fleet-yellow) 25%, transparent) transparent;
    }

    .rat-chronicle__tabs {
        --tab-marker-top: calc(var(--space-3xs) + var(--space-m) + 0.275rem);
        position: relative;
        display: flex;
        flex-wrap: nowrap;
        align-items: stretch;
        gap: 0;
        width: max-content;
        min-width: 100%;
        margin: 0;
        padding: var(--space-3xs) 0 var(--space-xs);
        list-style: none;

        // The track the chapter markers sit on, spanning every tab (not just the visible ones).
        &::before {
            content: '';
            position: absolute;
            inset-inline: var(--space-l);
            top: var(--tab-marker-top);
            height: 1px;
            pointer-events: none;
            background: linear-gradient(
                90deg,
                transparent,
                color-mix(in srgb, var(--fleet-yellow) 30%, transparent) 3%,
                color-mix(in srgb, var(--fleet-yellow) 30%, transparent) 97%,
                transparent
            );
        }
    }

    .rat-chronicle__tab-item {
        display: contents;
    }

    .rat-chronicle__tab {
        display: flex;
        flex: 1 0 auto;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-3xs);
        width: 12.5rem;
        padding: var(--space-m) var(--space-l);
        border: 1px solid color-mix(in srgb, var(--border-color) 70%, transparent);
        border-radius: 0;
        background: color-mix(in srgb, var(--component-background) 40%, transparent);
        color: inherit;
        cursor: pointer;
        text-align: left;
        text-decoration: none;
        transition:
            border-color 0.2s ease,
            background 0.2s ease,
            transform 0.2s ease;

        &:hover {
            border-color: color-mix(in srgb, var(--fleet-yellow) 45%, transparent);
            background: color-mix(in srgb, var(--component-background) 75%, transparent);
        }

        &.active {
            border-color: var(--fleet-red);
            background: color-mix(in srgb, var(--fleet-red) 8%, var(--component-background));
            transform: translateY(-2px);

            .rat-chronicle__tab-marker {
                background: var(--fleet-red);
                box-shadow: 0 0 12px color-mix(in srgb, var(--fleet-red) 60%, transparent);
            }

            .rat-chronicle__tab-number,
            .rat-chronicle__tab-title {
                color: var(--highlight);
            }
        }
    }

    .rat-chronicle__tab-marker {
        position: relative;
        z-index: 1;
        width: 0.55rem;
        height: 0.55rem;
        margin-bottom: var(--space-2xs);
        border-radius: 50%;
        background: color-mix(in srgb, var(--fleet-yellow) 35%, transparent);
        transition: background 0.2s ease, box-shadow 0.2s ease;
    }

    .rat-chronicle__tab-number {
        font-family: var(--heading-font);
        font-size: var(--step--1);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--fleet-red);
    }

    .rat-chronicle__tab-title {
        font-family: var(--chronicle-font);
        font-size: var(--step-0);
        font-weight: 500;
        line-height: 1.25;
        color: var(--foreground);
    }

    .rat-chronicle__tab-date {
        font-size: var(--step--2);
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--text-color-secondary, var(--faded));
    }

    .rat-chronicle__content {
        padding-block: var(--space-m);
    }

    .rat-chronicle__pager {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-s);
        margin-top: var(--space-xl);
        padding-top: var(--space-xl);
        border-top: 1px solid color-mix(in srgb, var(--fleet-yellow) 15%, transparent);
    }

    .rat-chronicle__pager-link {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        padding: var(--space-m) var(--space-l);
        border: 1px solid color-mix(in srgb, var(--border-color) 70%, transparent);
        background: color-mix(in srgb, var(--component-background) 40%, transparent);
        color: inherit;
        text-decoration: none;
        transition:
            border-color 0.2s ease,
            background 0.2s ease;

        @media (hover: hover) {
            &:hover {
                border-color: color-mix(in srgb, var(--fleet-yellow) 45%, transparent);
                background: color-mix(in srgb, var(--component-background) 75%, transparent);
            }
        }
    }

    .rat-chronicle__pager-link--next {
        grid-column: 2;
        align-items: flex-end;
        text-align: right;
    }

    .rat-chronicle__pager-kicker {
        font-family: var(--heading-font);
        font-size: var(--step--1);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--fleet-red);
    }

    .rat-chronicle__pager-title {
        font-family: var(--chronicle-font);
        font-size: var(--step-0);
        font-weight: 500;
        line-height: 1.25;
        color: var(--highlight);
    }
</style>
