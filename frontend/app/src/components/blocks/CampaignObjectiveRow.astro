---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { CampaignObjectiveRow as ObjectiveRow } from '@helpers/fetching/campaigns'
import { objective_status_i18n_key, holder_militia } from '@helpers/fetching/campaigns'

interface Props {
    row:                ObjectiveRow;
    [propName: string]: any;
}

const {
    row,
    ...attributes
} = Astro.props

delete attributes.class

const owner = holder_militia(row.system)
const owner_name = owner === 'minmatar' ? t('campaigns.system.held_by_minmatar')
    : owner === 'amarr' ? t('campaigns.system.held_by_amarr')
    : t('campaigns.system.held_by_unknown')
const system_anchor = row.system ? `#campaign-system-${row.system.id}` : undefined
const change_period = t(row.change_label === 'week' ? 'campaigns.objective.scale_week' : 'campaigns.objective.scale_change')
// As in the desktop window: the bar is neutral and only the move is coloured, always beside an arrow.
const change_tone = row.change_direction === 'up' ? 'up' : row.change_direction === 'down' ? 'down' : 'steady'
const show_change = row.change_text !== ''
// Exact figures stay in the hover: progress, what it is made of, and the move.
const row_title = [
    t(objective_status_i18n_key(row.status)),
    row.now_text,
    row.detail_text,
    show_change ? `${row.change_text} ${change_period}` : '',
].filter(Boolean).join(' · ')

import CampaignMeter from '@components/blocks/CampaignMeter.astro'
import CampaignPriorityIcon from '@components/blocks/CampaignPriorityIcon.astro'
import MinmatarLogo from '@components/logos/MinmatarLogo.astro'
import AmarrLogo from '@components/logos/AmarrLogo.astro'
---

<div
    class:list={['[ campaign-objective ]', Astro.props.class]}
    data-kind={row.kind}
    data-status={row.status}
    title={row_title}
    {...attributes}
>
    <div class="[ campaign-objective-where ]">
        {row.system && <CampaignPriorityIcon priority={row.system.priority} />}
        <span
            class:list={['[ campaign-system-owner ]', owner && `campaign-system-owner-${owner}`]}
            role="img"
            aria-label={owner_name}
            title={owner_name}
        >
            {owner === 'minmatar' && <MinmatarLogo />}
            {owner === 'amarr' && <AmarrLogo />}
        </span>
        <span class="[ campaign-objective-names ]">
            {system_anchor ?
                <a href={system_anchor} class="[ campaign-objective-system ]">{row.system_name}</a>
                :
                <span class="[ campaign-objective-system ]">{row.system_name}</span>
            }
            <small class="[ campaign-objective-what ]">{row.label}</small>
        </span>
    </div>

    <CampaignMeter
        class="[ campaign-objective-meter ]"
        percent={row.meter_percent}
        marker_percent={row.marker_percent}
        delta_from_percent={row.delta_from_percent}
        color='color-mix(in srgb, var(--highlight) 62%, transparent)'
        track_color='var(--border-color-hover)'
        height='var(--space-3xs)'
        label={`${row.system_name} · ${row.label} · ${row.now_text}`}
    />

    <span class="[ campaign-objective-change ]" data-tone={change_tone}>
        {show_change ?
            <>
                <span class="[ campaign-objective-arrow ]" aria-hidden="true">
                    {change_tone === 'up' && <svg viewBox="0 0 12 12"><path d="M6 2l5 8H1z"/></svg>}
                    {change_tone === 'down' && <svg viewBox="0 0 12 12"><path d="M6 10l5-8H1z"/></svg>}
                    {change_tone === 'steady' && <svg viewBox="0 0 12 12"><path d="M1.5 6h9"/></svg>}
                </span>
                <span>{row.change_text}</span>
                <small class="[ campaign-objective-period ]">{change_period}</small>
            </>
            :
            <span class="[ campaign-objective-figure ]">{row.now_text}</span>
        }
    </span>
</div>

<style lang="scss">
    .campaign-objective {
        display: grid;
        grid-template-columns: var(--campaign-objective-columns);
        column-gap: var(--space-m);
        align-items: center;
        padding-block: var(--space-xs);
        border-top: solid 1px var(--border-color);
        font-variant-numeric: tabular-nums;
        cursor: default;
    }

    @media (hover: hover) {
        .campaign-objective:hover {
            background-color: var(--border-color);
        }

        a.campaign-objective-system:hover {
            text-decoration: underline;
        }
    }

    .campaign-objective-where {
        display: flex;
        align-items: center;
        gap: var(--space-2xs);
        min-width: 0;
    }

    .campaign-objective-names {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .campaign-objective-system,
    .campaign-objective-what {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .campaign-objective-system {
        color: var(--highlight);
        font-size: var(--step-0);
        text-decoration: none;
    }

    .campaign-objective-what {
        color: var(--faded);
        font-size: var(--step--1);
    }

    .campaign-system-owner {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        width: 1.25rem;
        height: 1.25rem;

        :global(svg) {
            width: 100%;
            height: 100%;
        }

        :global(path) {
            fill: var(--foreground);
        }

        &.campaign-system-owner-minmatar :global(path) {
            fill: color-mix(in srgb, var(--fleet-red) 78%, white 22%);
        }

        &.campaign-system-owner-amarr :global(path) {
            fill: var(--fleet-yellow);
        }
    }

    .campaign-objective-change {
        display: inline-flex;
        align-items: baseline;
        justify-content: flex-end;
        gap: var(--space-3xs);
        font-size: var(--step--1);
        white-space: nowrap;
        color: var(--faded);

        &[data-tone="up"] {
            color: var(--green);
        }

        &[data-tone="down"] {
            color: var(--fleet-red);
        }
    }

    .campaign-objective-arrow {
        display: inline-flex;
        align-self: center;

        svg {
            width: 0.6em;
            height: 0.6em;
            fill: currentColor;
        }
    }

    [data-tone="steady"] .campaign-objective-arrow svg {
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
    }

    .campaign-objective-period {
        color: var(--faded);
        font-size: var(--step--2);
    }

    .campaign-objective-figure {
        color: var(--faded);
    }

    @media screen and (max-width: 767px) {
        .campaign-objective {
            grid-template-columns: minmax(0, 1fr) auto;
            row-gap: var(--space-2xs);
        }

        .campaign-objective :global(.campaign-objective-meter) {
            grid-column: 1 / -1;
            grid-row: 2;
        }
    }
</style>
