        --mk-lost: color-mix(in srgb, var(--fleet-red) 78%, white 22%);
        --mk-capital: var(--fleet-yellow);
        --mk-subcap: rgba(255, 255, 255, 0.35);
        --mk-track: rgba(255, 255, 255, 0.06);
        --mk-rule: rgba(255, 255, 255, 0.08);

        display: flex;
        flex-direction: column;
        gap: var(--space-2xl);
