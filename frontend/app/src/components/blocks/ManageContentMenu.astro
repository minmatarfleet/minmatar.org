---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import Dropdown from '@components/blocks/Dropdown.astro'
---

<Dropdown
    class="[ manage-content-menu ]"
    variant="button"
    color="fleet-red"
    size="sm"
>
    <span slot="button" class="[ manage-content-menu__label ]">
        {t('content.manage_my_content')}
    </span>

    <nav class="[ manage-content-menu__list ]" aria-label={t('content.manage_my_content')}>
        <a
            class="[ manage-content-menu__item ]"
            href={translatePath('/alliance/propaganda/new/editor')}
        >
            {t('create_post')}
        </a>
        <a
            class="[ manage-content-menu__item ]"
            href={translatePath('/alliance/propaganda/my_posts/')}
        >
            {t('my_posts')}
        </a>
        <a
            class="[ manage-content-menu__item ]"
            href={translatePath('/alliance/propaganda/trash/')}
        >
            {t('trash')}
        </a>
    </nav>
</Dropdown>

<style lang="scss">
    :global(.manage-content-menu.button-dropdown) {
        display: inline-block;
    }

    :global(.manage-content-menu .button-dropdown-panel) {
        width: var(--button-dropdown-min-width, max-content);
        min-width: var(--button-dropdown-min-width, 12rem);
        padding: var(--space-3xs);
        background: var(--background);
        border: solid 1px var(--border-color);
        box-sizing: border-box;
    }

    .manage-content-menu__label {
        white-space: nowrap;
    }

    .manage-content-menu__list {
        display: flex;
        flex-direction: column;
        gap: 0;
        width: 100%;
    }

    .manage-content-menu__item {
        display: block;
        width: 100%;
        box-sizing: border-box;
        padding: var(--space-2xs) var(--space-s);
        color: var(--highlight);
        font-family: var(--button-font);
        font-size: var(--step--1);
        font-weight: 600;
        text-decoration: none;
        text-align: left;
        border: none;
        background: transparent;
        transition: var(--fast-transition);

        &:hover,
        &:focus-visible {
            background: color-mix(in srgb, var(--fleet-red) 35%, transparent);
            color: var(--button-color);
            outline: none;
        }

        &:first-child {
            color: var(--green);
        }

        &:first-child:hover,
        &:first-child:focus-visible {
            background: color-mix(in srgb, var(--green) 25%, transparent);
            color: var(--highlight);
        }
    }
</style>
