---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { CreatorAccount } from '@dtypes/api.minmatar.org'
import { get_my_creator_accounts } from '@helpers/api.minmatar.org/creators'

const auth_token = Astro.cookies.has('auth_token')
    ? (Astro.cookies.get('auth_token')?.value as string)
    : false

import { get_gates, can } from '@helpers/gates'
const gates = await get_gates(Astro)

// The menu shows for content.manage; the post pages themselves need posts.create.
const can_create_posts = can(gates, 'posts.create')

let accounts: CreatorAccount[] = []
if (auth_token) {
    try {
        accounts = await get_my_creator_accounts(auth_token)
    } catch {
        accounts = []
    }
}

const by_provider = Object.fromEntries(
    accounts.map((account) => [account.provider, account]),
) as Partial<Record<'twitch' | 'youtube' | 'reddit', CreatorAccount>>

const twitch = by_provider.twitch
const youtube = by_provider.youtube
const reddit = by_provider.reddit

import ActionMenu from '@components/blocks/ActionMenu.astro'
import ActionMenuItem from '@components/blocks/ActionMenuItem.astro'
---

<ActionMenu
    class="[ manage-content-menu ]"
    label={t('content.manage_my_content')}
    variant="button"
    color="fleet-red"
    size="sm"
    hover="fill"
    fit_trigger={true}
>
    {can_create_posts && <>
        <ActionMenuItem variant="success" href={translatePath('/alliance/propaganda/new/editor')}>
            {t('create_post')}
        </ActionMenuItem>
        <ActionMenuItem href={translatePath('/alliance/propaganda/my_posts/')}>
            {t('my_posts')}
        </ActionMenuItem>
        <ActionMenuItem href={translatePath('/alliance/propaganda/trash/')}>
            {t('trash')}
        </ActionMenuItem>
    </>}

    {twitch ?
        <ActionMenuItem variant="success" text_only={true}>
            {t('content.connect.twitch_connected').replace(
                'USERNAME',
                twitch.platform_username || twitch.platform_user_id,
            )}
        </ActionMenuItem>
        :
        <ActionMenuItem href={translatePath('/alliance/content/connect/twitch')}>
            {t('content.connect.twitch')}
        </ActionMenuItem>
    }

    {youtube ?
        <ActionMenuItem variant="success" text_only={true}>
            {t('content.connect.youtube_connected').replace(
                'USERNAME',
                youtube.platform_username || youtube.platform_user_id,
            )}
        </ActionMenuItem>
        :
        <ActionMenuItem href={translatePath('/alliance/content/connect/youtube')}>
            {t('content.connect.youtube')}
        </ActionMenuItem>
    }

    {reddit ?
        <ActionMenuItem variant="success" text_only={true}>
            {t('content.connect.reddit_connected').replace(
                'USERNAME',
                reddit.platform_username || reddit.platform_user_id,
            )}
        </ActionMenuItem>
        :
        <ActionMenuItem
            x-data
            x-on:click={`show_modal({
                partial: '${translatePath('/partials/link_reddit_modal_component')}',
            })`}
        >
            {t('content.connect.reddit')}
        </ActionMenuItem>
    }
</ActionMenu>
