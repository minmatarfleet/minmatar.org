---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { SummaryCharacter } from '@dtypes/api.minmatar.org'
import type { FleetRoleVolunteer } from '@helpers/api.minmatar.org/fleets'
import { get_item_icon } from '@helpers/eve_image_server'

interface Props {
    volunteers:     FleetRoleVolunteer[],
    pilots:         SummaryCharacter[],
    fleet_id:       number;
    readonly?:      boolean;
    is_fleet_commander?: boolean;
}

const {
    volunteers,
    pilots,
    fleet_id,
    readonly,
    is_fleet_commander = false,
} = Astro.props

const logi_anchors = volunteers.filter((v) => v.role === 'logi_anchor')
const cynos = volunteers.filter((v) => v.role === 'cyno')
const links = volunteers.filter((v) => v.role === 'links')
const ehp_links = links.filter((v) => v.subtype === 'ehp' || v.subtype === 'armor' || v.subtype === 'shield')
const info_links = links.filter((v) => v.subtype === 'info')
const skirmish_links = links.filter((v) => v.subtype === 'skirmish')

// Minimum the MOTD considers "filled": 1 logi anchor, 2 cynos, one of each link.
const CYNOS_WANTED = 2
const filled_roles = [
    logi_anchors.length >= 1,
    cynos.length >= CYNOS_WANTED,
    ehp_links.length >= 1,
    info_links.length >= 1,
    skirmish_links.length >= 1,
].filter(Boolean).length

// Large Remote Armor Repairer II for logi anchor, Cynosural Field Generator I
// for cynos, Armor / Information / Skirmish Command Burst I for links.
const LOGI_ICON_TYPE_ID = 26914
const CYNO_ICON_TYPE_ID = 21096
const ARMOR_BURST_TYPE_ID = 42526
const INFO_BURST_TYPE_ID = 42527
const SKIRMISH_BURST_TYPE_ID = 42530

import Flexblock from '@components/compositions/Flexblock.astro'
import BlockList from '@components/compositions/BlockList.astro'

import FleetRoleItem from '@components/blocks/FleetRoleItem.astro'
---

<section id="fleet-roles" aria-labelledby="fleet-roles-title">
    <Flexblock gap='var(--space-m)'>
        <Flexblock gap="var(--space-3xs)">
            <h2 id="fleet-roles-title">{t('fleet_roles')}</h2>
            <small class="!mt-[var(--space-3xs)]">
                {t('fleet_roles_summary').replace('{filled}', filled_roles.toString()).replace('{total}', '5')}
            </small>
        </Flexblock>

        <BlockList gap='var(--space-3xs)' role="list">
            <FleetRoleItem
                id='logi-anchor-role'
                title={t('logi_anchor_label')}
                fleet_id={fleet_id}
                role='logi_anchor'
                volunteers={logi_anchors}
                pilots={pilots}
                readonly={readonly}
                wanted={1}
            >
                <img slot="icon" src={get_item_icon(LOGI_ICON_TYPE_ID, 32)} width="32" height="32" alt="" loading="lazy" />
            </FleetRoleItem>

            <FleetRoleItem
                id='cynos-role'
                title={t('cyno_label')}
                fleet_id={fleet_id}
                role='cyno'
                volunteers={cynos}
                pilots={pilots}
                readonly={readonly}
                can_assign_system={is_fleet_commander}
                wanted={CYNOS_WANTED}
            >
                <img slot="icon" src={get_item_icon(CYNO_ICON_TYPE_ID, 32)} width="32" height="32" alt="" loading="lazy" />
            </FleetRoleItem>

            <FleetRoleItem
                id='ehp-links-role'
                title={t('ehp_links')}
                fleet_id={fleet_id}
                role='links'
                subtype='ehp'
                volunteers={ehp_links}
                pilots={pilots}
                readonly={readonly}
            >
                <img slot="icon" src={get_item_icon(ARMOR_BURST_TYPE_ID, 32)} width="32" height="32" alt="" loading="lazy" />
            </FleetRoleItem>

            <FleetRoleItem
                id='info-links-role'
                title={t('info_links')}
                fleet_id={fleet_id}
                role='links'
                subtype='info'
                volunteers={info_links}
                pilots={pilots}
                readonly={readonly}
            >
                <img slot="icon" src={get_item_icon(INFO_BURST_TYPE_ID, 32)} width="32" height="32" alt="" loading="lazy" />
            </FleetRoleItem>

            <FleetRoleItem
                id='skirmish-links-role'
                title={t('skirmish_links')}
                fleet_id={fleet_id}
                role='links'
                subtype='skirmish'
                volunteers={skirmish_links}
                pilots={pilots}
                readonly={readonly}
            >
                <img slot="icon" src={get_item_icon(SKIRMISH_BURST_TYPE_ID, 32)} width="32" height="32" alt="" loading="lazy" />
            </FleetRoleItem>
        </BlockList>
    </Flexblock>
</section>
