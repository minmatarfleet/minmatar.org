---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { SummaryCharacter } from '@dtypes/api.minmatar.org'
import type {
    BurstKind,
    FleetCompositionEntry,
    FleetRoleCoverage,
} from '@helpers/api.minmatar.org/fleets'
import { get_item_icon } from '@helpers/eve_image_server'
import { link_kinds, ships_for_role } from '@helpers/fleet_roles'

/**
 * Fleet roles, filled by ships: links, cynos and logi come from the ships
 * pilots volunteer for or are flying in fleet. Logi FC is a person, so it
 * is the one role still signed up for.
 */
interface Props {
    roles:              FleetRoleCoverage;
    composition:        FleetCompositionEntry[];
    pilots:             SummaryCharacter[];
    fleet_id:           number;
    readonly?:          boolean;
    is_fleet_commander?: boolean;
    [propName: string]: any;
}

const {
    roles,
    composition,
    pilots,
    fleet_id,
    readonly,
    is_fleet_commander = false,
    ...attributes
} = Astro.props

delete attributes.class

const CYNOS_WANTED = 2

const links = link_kinds(roles, composition)
const cyno_ships = ships_for_role(composition, entry => entry.fit_roles?.cyno ?? false)
const logi_ships = ships_for_role(composition, entry => entry.fit_roles?.logi ?? false)
const show_cynos = cyno_ships.length > 0 || roles.cynos.length > 0

// Rows with a target count towards "filled": Logi FC, cynos, each link kind.
const targets = [
    roles.logi_fc.length >= 1,
    ...(show_cynos ? [roles.cynos.length >= CYNOS_WANTED] : []),
    ...links.map(row => row.pilots.length >= 1),
]
const filled_roles = targets.filter(Boolean).length

// Large Remote Armor Repairer II (Logi FC), Guardian (logi ships),
// Cynosural Field Generator I and the Command Burst I of each kind.
const LOGI_ICON_TYPE_ID = 26914
const LOGI_SHIPS_ICON_TYPE_ID = 11987
const CYNO_ICON_TYPE_ID = 21096
const BURST_ICON_TYPE_IDS:Record<BurstKind, number> = {
    armor: 42526,
    information: 42527,
    mining: 42528,
    shield: 42529,
    skirmish: 42530,
}

import Flexblock from '@components/compositions/Flexblock.astro'
import BlockList from '@components/compositions/BlockList.astro'

import FleetRoleItem from '@components/blocks/FleetRoleItem.astro'
import FleetRoleShips from '@components/blocks/FleetRoleShips.astro'
---

<section id="fleet-roles" aria-labelledby="fleet-roles-title" class:list={[Astro.props.class]} {...attributes}>
    <Flexblock gap='var(--space-m)'>
        <Flexblock gap="var(--space-3xs)">
            <h2 id="fleet-roles-title">{t('fleet_roles')}</h2>
            <small class="!mt-[var(--space-3xs)]">
                {t('fleet_roles_summary').replace('{filled}', filled_roles.toString()).replace('{total}', targets.length.toString())}
            </small>
            <small>{t('fleet_roles_from_ships')}</small>
        </Flexblock>

        <BlockList gap='var(--space-3xs)' role="list">
            <FleetRoleItem
                id='logi-anchor-role'
                title={t('logi_anchor_label')}
                fleet_id={fleet_id}
                role='logi_anchor'
                volunteers={roles.logi_fc}
                pilots={pilots}
                readonly={readonly}
                wanted={1}
            >
                <img slot="icon" src={get_item_icon(LOGI_ICON_TYPE_ID, 32)} width="32" height="32" alt="" loading="lazy" />
            </FleetRoleItem>

            {links.map(row =>
                <FleetRoleShips
                    id={`${row.kind}-links-role`}
                    title={t('links_kind').replace('{kind}', row.label)}
                    fleet_id={fleet_id}
                    pilots={row.pilots}
                    ship_names={row.ship_names}
                    wanted={1}
                    show_counts={true}
                    readonly={readonly}
                >
                    <img slot="icon" src={get_item_icon(BURST_ICON_TYPE_IDS[row.kind], 32)} width="32" height="32" alt="" loading="lazy" />
                </FleetRoleShips>
            )}

            {show_cynos &&
                <FleetRoleShips
                    id='cynos-role'
                    title={t('cyno_label')}
                    fleet_id={fleet_id}
                    pilots={roles.cynos}
                    ship_names={cyno_ships}
                    wanted={CYNOS_WANTED}
                    can_assign_system={is_fleet_commander}
                    readonly={readonly}
                >
                    <img slot="icon" src={get_item_icon(CYNO_ICON_TYPE_ID, 32)} width="32" height="32" alt="" loading="lazy" />
                </FleetRoleShips>
            }

            {(logi_ships.length > 0 || roles.logi.length > 0) &&
                <FleetRoleShips
                    id='logi-role'
                    title={t('logi_label')}
                    fleet_id={fleet_id}
                    pilots={roles.logi}
                    ship_names={logi_ships}
                    readonly={readonly}
                >
                    <img slot="icon" src={get_item_icon(LOGI_SHIPS_ICON_TYPE_ID, 32)} width="32" height="32" alt="" loading="lazy" />
                </FleetRoleShips>
            }
        </BlockList>
    </Flexblock>
</section>
