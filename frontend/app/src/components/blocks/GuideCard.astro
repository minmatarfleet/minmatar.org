---
import { i18n } from '@helpers/i18n'
import type { GuideMeta } from '@/data/guides/types'
import { getGuideCoverImage } from '@/data/guides/covers'
import { get_app_url } from '@helpers/env'
import type { User } from '@dtypes/jwt'
import * as jose from 'jose'

import Flexblock from '@components/compositions/Flexblock.astro'
import FlexInline from '@components/compositions/FlexInline.astro'
import Wrapper from '@components/compositions/Wrapper.astro'

import Tile from '@components/blocks/Tile.astro'
import PilotBadge from '@components/blocks/PilotBadge.astro'
import CorporationBadge from '@components/blocks/CorporationBadge.astro'
import AllianceBadge from '@components/blocks/AllianceBadge.astro'
import CharacterPicture from '@components/blocks/CharacterPicture.astro'
import VerticalCenter from '@components/blocks/VerticalCenter.astro'
import Button from '@components/blocks/Button.astro'
import ClipboardButton from '@components/blocks/ClipboardButton.astro'

const { t, translatePath } = i18n(Astro.url)

interface Props {
    guide: GuideMeta
}

const { guide } = Astro.props
const coming_soon = Boolean(guide.comingSoon)
const guidePath = guide.path ? translatePath(guide.path) : translatePath(`/guides/${guide.slug}/`)
const guideUrl = guidePath
const is_multiple_authors = guide.authors.length > 1
const author = !is_multiple_authors ? guide.authors[0] : undefined
const author_names = guide.authors.map((entry) => entry.name).join(', ')

const auth_token = Astro.cookies.has('auth_token') ? (Astro.cookies.get('auth_token')?.value as string) : false
const user: User | false = auth_token ? jose.decodeJwt(auth_token) as User : false
const shareUrl = user
    ? `${get_app_url(guidePath)}?ref=${user.user_id}`
    : get_app_url(guidePath)
---

<Flexblock
    class:list={[
        '[ card component border light-transparency relative ]',
        { 'guide-card--coming-soon': coming_soon },
    ]}
    gap='0'
>
    <Tile
        title={guide.title}
        cover={getGuideCoverImage(guide)}
        alt={guide.title}
        transparent={true}
        soft={false}
        narrow={true}
    >
        {coming_soon ? null : (
            <Flexblock slot="subtitle">
                {is_multiple_authors ? (
                    <FlexInline class="[ guide-card__authors ]" gap="var(--space-2xs)">
                        <FlexInline gap="var(--space-3xs)">
                            {guide.authors.map((entry) => (
                                entry.entity === 'character' && (
                                    <CharacterPicture
                                        character_id={entry.id}
                                        character_name={entry.name}
                                        size={32}
                                        centered={true}
                                    />
                                )
                            ))}
                        </FlexInline>
                        <VerticalCenter>
                            <Flexblock gap="0" class="[ w-full ]">
                                <span class="[ text-highlight ]" set:text={author_names} />
                                <small>{t('guides.multiple_authors')}</small>
                            </Flexblock>
                        </VerticalCenter>
                    </FlexInline>
                ) : author?.entity === 'character' ? (
                    <PilotBadge
                        character_id={author.id}
                        character_name={author.name}
                        size={32}
                        centered={true}
                    >
                        <small>{t('author')}</small>
                    </PilotBadge>
                ) : author?.entity === 'corporation' ? (
                    <CorporationBadge
                        corporation={{
                            id: author.id,
                            name: author.name,
                            size: 'sm'
                        }}
                    >
                        <small>{t('author')}</small>
                    </CorporationBadge>
                ) : author?.entity === 'alliance' ? (
                    <AllianceBadge
                        alliance={{
                            id: author.id,
                            name: author.name,
                            size: 'sm'
                        }}
                    >
                        <small>{t('author')}</small>
                    </AllianceBadge>
                ) : null}
            </Flexblock>
        )}
    </Tile>
    <Wrapper
        class="[ pb-(--component-padding-block)! grow ]"
        padding_inline='var(--component-padding-block)'
        padding_block='0'
        max_width='100%'
    >
         <Flexblock
            class="[ justify-between! h-full ]"
            gap='var(--space-l)'
        >
            <p class="[ excerpt ]">{guide.excerpt}</p>
            <FlexInline>
                {coming_soon ? (
                    <Button size='sm' off_disable={true} disabled>{t('guides.coming_soon')}</Button>
                ) : (
                    <>
                        <Button size='sm' href={guideUrl}>{t('view')}</Button>
                        <ClipboardButton id={`guide-${guide.slug}`} text={t('share')}>{shareUrl}</ClipboardButton>
                    </>
                )}
            </FlexInline>
        </Flexblock>
    </Wrapper>
</Flexblock>

<style lang="scss">
    .guide-card-link {
        display: block;
        text-decoration: none;
        color: inherit;
        height: 100%;

        &:hover h3 {
            color: var(--highlight);
        }
    }

    .guide-card--coming-soon {
        opacity: 0.72;
    }

    h3 {
        font-size: var(--step-0);
        line-height: 1.25;
        transition: color 0.15s ease;
    }

    .excerpt {
        color: var(--muted-color);
        font-size: var(--step--1);
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
