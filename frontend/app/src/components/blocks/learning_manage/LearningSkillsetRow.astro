---
/**
 * One skillset in Manage learning: name, skill count and total skill
 * points. It opens in place on its form (`url`, or the `detail` slot).
 */
import type { LearningManageSkillset } from '@dtypes/api.minmatar.org'

interface Props {
    /** null: the new skillset row. */
    skillset:   LearningManageSkillset | null;
    row_id:     string;
    url?:       string;
    open?:      boolean;
    [propName: string]: any;
}

const {
    skillset,
    row_id,
    url,
    open = false,
} = Astro.props

import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import { distinct_skills } from '@helpers/learning_manage'
import ExpandRow from '@components/blocks/manage/ExpandRow.astro'

const name = skillset?.name || t('learning_manage.skillsets_new')
---

<ExpandRow id={row_id} colspan={4} label={t('learning_admin.open').replace('~NAME', name)} url={url} open={open}>
    <td>
        <button type="button" class="[ manage-who ]" x-on:click="open = !open">
            <span class="[ manage-who__text ]">
                <span class="[ manage-who__name ]">{name}</span>
            </span>
        </button>
    </td>
    <td class="num">{skillset ? distinct_skills(skillset.skills).length : 0}</td>
    <td class="[ num is-wide ]">{skillset ? skillset.total_skill_points.toLocaleString('en-US') : '—'}</td>
    <Fragment slot="detail"><slot name="detail" /></Fragment>
</ExpandRow>
