---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { EvEImageServiceSize, ImageSize, BadgeColors } from '@dtypes/layout_components'

interface Props {
    character_id:       number;
    character_name?:    string;
    x_character_id?:    string | false;
    x_character_name?:  string | false;
    size?:              ImageSize;
    narrow?:            boolean;
    icon_quality?:      EvEImageServiceSize;
    tooltip?:           string;
    mask?:              boolean;
    inert?:             boolean;
    centered?:          boolean;
    quantity?:          number;
    tag_color?:         BadgeColors;
    height?:            number;
    [propName: string]: any;
}

const {
    character_id,
    character_name,
    x_character_id = false,
    x_character_name = false,
    size = 64,
    narrow = false,
    icon_quality = 64,
    tooltip,
    mask = false,
    inert = false,
    centered = false,
    quantity,
    tag_color,
    height = 412,
    ...attributes
} = Astro.props

import { get_player_icon } from '@helpers/eve_image'

// The click opens the character modal. It is a span with role="button", not a
// <button>: pictures sit inside other buttons (CollapsableButton, the SRP card)
// and the HTML parser closes the outer button at a nested <button>, which moves
// the rest of the markup out of its Alpine x-data scope. A static character 0
// has nothing to open: the picture stays plain.
const clickable = !inert && (character_id != 0 || !!x_character_id)
const Target = 'span'

import Picture from '@components/blocks/Picture.astro';

const extra_class = attributes.class
delete attributes.class
---

<Picture
    src={get_player_icon(character_id, icon_quality ?? size)}
    alt={`${t('profile_picture_of')} ${character_name ?? t('unknown_character')}`}
    size={size}
    narrow={narrow}
    height={height}
    mask={mask}
    quantity={quantity}
    tag_color={tag_color}
    animated={inert}
    brighten={!inert}
    class:list={['flex', { 'items-center!': centered }, extra_class]}
    {...attributes}
    data-tippy-content={tooltip ? tooltip : undefined}
    target={{
        tag: Target,
        attrs: clickable ? {
            role: 'button',
            tabindex: '0',
            'x-data': `{
                show_character_modal() {
                    if (!${x_character_id} && ${character_id} == 0)
                        return

                    show_modal({
                        partial: '${translatePath('/partials/character_modal_component/')}?character_id='+(${x_character_id} ? ${x_character_id} : '${character_id.toString()}'),
                    })
                }
            }`,
            'x-on:click.stop.prevent': 'show_character_modal()',
            'x-on:keydown.enter.stop.prevent': 'show_character_modal()',
            'x-on:keydown.space.stop.prevent': 'show_character_modal()',
        } : {},
    }}
    img_attrs={{
        'x-bind:src': `${x_character_id} ? get_player_icon(${x_character_id}) : '${get_player_icon(character_id, icon_quality ?? size)}'`,
        'x-bind:alt': `\`${t('profile_picture_of')} \${(${x_character_name} ? ${x_character_name} : "${character_name ?? t('unknown_character')}")}\``,
    }}
/>
