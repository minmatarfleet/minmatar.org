---
import { i18n, t_key } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { FleetItem } from '@dtypes/layout_components'

interface Props {
    fleet:  FleetItem;
}

const {
    fleet,
} = Astro.props

import { fleet_phase } from '@helpers/fleet_phase'
const phase = fleet_phase(fleet)

import FlexInline from '@components/compositions/FlexInline.astro';
import FleetPhaseLabel from '@components/blocks/FleetPhaseLabel.astro';
import PilotBadge from '@components/blocks/PilotBadge.astro';
import Countdown from '@components/blocks/Countdown.astro';
import StylessButton from './StylessButton.astro';
import FleetHostTags from '@components/blocks/FleetHostTags.astro';
import { fleet_commander_label } from '@helpers/fleet_commander'
---

<StylessButton href={translatePath(`/fleets/upcoming/${fleet.id}/`)}>
    <FlexInline class="[ flex-nowrap! ]" justification='flex-end'>
        <PilotBadge
            character_id={fleet.fleet_commander_id}
            character_name={fleet_commander_label(fleet, t('fleet_in_game_as'))}
            heading={true}
        >
            <small class="[ text-nowrap! ]">{t(t_key('', fleet.type, '_fleet')) ?? fleet.type}</small>
            <FleetHostTags fleet={fleet} />
        </PilotBadge>
        <div class="[ fleet-status-text-wrapper ]">
            <FleetPhaseLabel phase={phase} />

            {phase === 'upcoming' ?
                <Countdown
                    date={fleet.start_time}
                    id={fleet.id}
                    tag="countdown-fleet"
                />
                :
                <div class="[ hidden ]">
                    <Countdown
                        date={fleet.start_time}
                        id={fleet.id}
                        tag="countdown-fleet"
                    />
                </div>
            }
        </div>
    </FlexInline>
</StylessButton>

<style lang="scss">
    a {
        display: block;
        color: var(--fleet-yellow);
    }
    
    a:focus-visible {
        outline-color: var(--highlight);
        outline-style: double;
        outline-offset: -1px;
    }

    .fleet-status-text-wrapper {
        text-align: center;
        flex-basis: 310px;
        padding-right: var(--space-m);
    }

    :global(.fleet-status-text-wrapper > .countdown) {
        width: 280px;
        text-align: left;
    }
</style>