<div
    class="[ swiper-wrapper ][ select-none items-center! ]"
    x-data={`{
        swiper: null,
        corporation_pagination(index) {
            return this.pagination_icons[index]
        },
        init() {
            const INIT_WORKAROUND_TIMER_MS = 100
            const el = this.$el.closest('#corporations-list') || document.getElementById('corporations-list')
            if (!(el instanceof Element))
                return
            setTimeout(() => {
                if (this.swiper) {
                    this.swiper.destroy(true, true)
                    this.swiper = null
                }
                this.swiper = new Swiper(el, {
                    slidesPerView: 1,
                    loop: false,
                    effect: 'fade',
                    hashNavigation: true,
                    fadeEffect: {
                        crossFade: true
                    },
                    pagination: false,
                    navigation: {
                        nextEl: '#corporations-list-swiper-button-next',
                        prevEl: '#corporations-list-swiper-button-prev',
                    },
                });
            }, INIT_WORKAROUND_TIMER_MS)
        }
    }`}
>
    <slot />
</div>

<style lang="scss" is:global>
    .swiper-slide .tag {
        pointer-events: none;
    }
</style>
