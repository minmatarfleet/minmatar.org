---
/**
 * Neut pressure on a cap-chained Guardian pair: heavy neuts against one
 * Guardian that receives a capacitor transfer from its partner and runs its
 * repairers. Range past optimal weakens every neut cycle.
 */
import RoleSim from '@components/blocks/role-sims/RoleSim.astro'
import SimRange from '@components/blocks/role-sims/SimRange.astro'
import { NEUT_TARGET_REPAIRERS, NEUT_TARGETS } from '@helpers/sims/scenarios'
import { SIM } from '@helpers/sims/constants'
import { NEUT_BOX as box, NEUT_STRIP as strip, ticks } from '@components/blocks/role-sims/pictures'

interface Props {
    sim_id?:            string;
    compact?:           boolean;
    [propName: string]: any;
}

const {
    sim_id = 'neut-pressure',
    compact = false,
    ...attributes
} = Astro.props

delete attributes.class

const target_x = strip.x0 + 40 * strip.per_km
const optimal_x = target_x - SIM.heavy_neut_optimal_km * strip.per_km
const falloff_x = optimal_x - SIM.heavy_neut_falloff_km * strip.per_km
---

<RoleSim
    sim_id={sim_id}
    alpine_name="role_sim_neut_pressure"
    title="Break the cap chain"
    summary={`Your Heavy Energy Neutralizer II (${SIM.heavy_neut_amount_gj} GJ every ${SIM.heavy_neut_cycle_s} s, ${SIM.heavy_neut_optimal_km} + ${SIM.heavy_neut_falloff_km} km) against a Guardian running ${NEUT_TARGET_REPAIRERS} Large Remote Armor Repairer II while its partner feeds it ${SIM.large_rct_amount_gj} GJ every ${SIM.large_rct_cycle_s} s.`}
    targets={NEUT_TARGETS}
    compact={compact}
    class={Astro.props.class}
    {...attributes}
>
    <svg slot="picture" viewBox="0 0 200 100" role="img" aria-label="Range strip from your neuts to the Guardian pair, and the Guardian's capacitor over 60 seconds">
        <rect class="ink-zone" x={optimal_x} y="12" width={target_x - optimal_x} height="18" stroke-width="0.3" />
        <rect class="ink-grid" x={falloff_x} y="12" width={optimal_x - falloff_x} height="18" stroke-width="0.3" />
        <text class="ink-muted" x={optimal_x + 1} y="10" font-size="2.8">neut optimal</text>
        <text class="ink-muted" x={falloff_x + 1} y="10" font-size="2.8">falloff</text>
        <circle class="ink-blue" r="2.4" cx={target_x + 2} cy="18" />
        <circle class="ink-blue" r="2.4" cx={target_x + 2} cy="25" />
        <line class="ink-blue-stroke" x1={target_x + 2} y1="18" x2={target_x + 2} y2="25" stroke-width="0.5" />
        <text class="ink-text" x={target_x - 1} y="36" font-size="2.8" text-anchor="end">Guardian pair</text>
        <g x-bind:transform="`translate(${sx(state.range_km)} 21)`" transform={`translate(${strip.x0} 21)`}>
            <polygon class="ink-red" points="3,0 -2,-2.6 -2,2.6" />
            <text class="ink-text" x="0" y="9" font-size="2.8" text-anchor="middle" x-text="state.neuts + ' neut' + (state.neuts > 1 ? 's' : '')">1 neut</text>
        </g>
        <line class="ink-red-stroke" stroke-width="0.3" stroke-dasharray="1 1"
            x-bind:x1="sx(state.range_km) + 3" x2={target_x - 1} y1="21" y2="21" x1="0" />

        <text class="ink-muted" x={box.x} y={box.y - 3} font-size="3.2">Target Guardian capacitor %, first 60 s</text>
        {ticks(box, 'y', 50).map((t) => (
            <g>
                <line class="ink-grid" x1={box.x} x2={box.x + box.width} y1={t.at} y2={t.at} stroke-width="0.25" />
                <text class="ink-muted" x={box.x - 2} y={t.at + 1} font-size="2.8" text-anchor="end">{t.value}</text>
            </g>
        ))}
        {ticks(box, 'x', 12).map((t) => (
            <text class="ink-muted" x={t.at} y={box.y + box.height + 5} font-size="2.8" text-anchor="middle">{t.value}s</text>
        ))}
        <polyline stroke-width="0.7" x-bind:class="r().sim.module_off_at === null ? 'ink-green-stroke' : 'ink-red-stroke'" x-bind:points="trace_points()" points="" />
        <line class="ink-red-stroke" stroke-width="0.5" stroke-dasharray="1 0.8"
            x-show="r().sim.module_off_at !== null"
            x-bind:x1="tx(r().sim.module_off_at ?? 0)" x-bind:x2="tx(r().sim.module_off_at ?? 0)" y1={box.y} y2={box.y + box.height} x1="0" x2="0" />
    </svg>

    <Fragment slot="controls">
        <SimRange label="Heavy neuts on the Guardian" field="neuts" min={1} max={6} />
        <SimRange label="Range to the Guardian" field="range_km" min={5} max={40} unit="km" />
    </Fragment>

    <Fragment slot="readout">
        <p x-text="r().readout"></p>
    </Fragment>
</RoleSim>

<script>
    import { register_role_sim, role_sim_data } from '@components/blocks/role-sims/role_sim_data'
    import { NEUT_BOX as box, NEUT_STRIP as strip, chart_points, chart_x } from '@components/blocks/role-sims/pictures'
    import { NEUT_DEFAULT, NEUT_TARGETS, neut_scenario } from '@helpers/sims/scenarios'
    import { SIM } from '@helpers/sims/constants'

    const target_x = strip.x0 + 40 * strip.per_km

    register_role_sim('role_sim_neut_pressure', role_sim_data({
        targets: NEUT_TARGETS,
        defaults: () => ({ ...NEUT_DEFAULT }),
        compute: neut_scenario,
        methods: {
            sx: (range_km: number) => target_x - range_km * strip.per_km,
            tx: (t: number) => chart_x(box, t),
            trace_points(this: any) {
                return chart_points(box, this.r().sim.series.map((p: { t: number, cap: number }) => [p.t, (p.cap / SIM.guardian_cap_gj) * 100]))
            },
        },
    }))
</script>
