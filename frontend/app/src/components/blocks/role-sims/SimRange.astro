---
/**
 * A labelled range slider for a role sim, bound to `state.<field>`.
 * `display` is an Alpine expression for the shown value (defaults to the value + unit).
 */
interface Props {
    label:              string;
    field:              string;
    min:                number;
    max:                number;
    step?:              number;
    unit?:              string;
    display?:           string;
    [propName: string]: any;
}

const {
    label,
    field,
    min,
    max,
    step = 1,
    unit = '',
    display,
    ...attributes
} = Astro.props

delete attributes.class

const id = `role-sim-${field}-${Math.random().toString(36).slice(2, 8)}`
const shown = display ?? `state.${field} + '${unit ? ` ${unit}` : ''}'`
---

<div class:list={['[ role-sim__range ]', Astro.props.class]} {...attributes}>
    <span class="role-sim__range-label">
        <label for={id}>{label}</label>
        <output for={id} x-text={shown}></output>
    </span>
    <input
        id={id}
        type="range"
        min={min}
        max={max}
        step={step}
        x-model.number={`state.${field}`}
        x-bind:aria-valuetext={shown}
    />
</div>
