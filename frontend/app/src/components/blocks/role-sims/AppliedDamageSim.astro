---
/**
 * Applied damage: 1400mm Howitzer Artillery II on a Vagabond. Ammo sets range
 * and tracking, range sets the falloff penalty, and the target's approach sets
 * how much of its speed is transversal.
 */
import RoleSim from '@components/blocks/role-sims/RoleSim.astro'
import SimRange from '@components/blocks/role-sims/SimRange.astro'
import SimChoice from '@components/blocks/role-sims/SimChoice.astro'
import { AMMO, APPLIED_TARGETS, APPROACHES } from '@helpers/sims/scenarios'
import { SIM } from '@helpers/sims/constants'
import { APPLIED_BOX as box, ticks } from '@components/blocks/role-sims/pictures'

interface Props {
    sim_id?:            string;
    compact?:           boolean;
    [propName: string]: any;
}

const {
    sim_id = 'applied-damage',
    compact = false,
    ...attributes
} = Astro.props

delete attributes.class

const ammo_options = Object.entries(AMMO).map(([value, ammo]) => ({ value, label: ammo.name.replace('Republic Fleet', 'RF') }))
const approach_options = Object.entries(APPROACHES).map(([value, approach]) => ({ value, label: approach.label }))
---

<RoleSim
    sim_id={sim_id}
    alpine_name="role_sim_applied_damage"
    title="Land the damage"
    summary={`1400mm Howitzer Artillery II (unskilled module stats) on a Vagabond: ${SIM.vagabond_signature_m} m signature at ${SIM.vagabond_max_velocity_ms} m/s. The line is the share of paper damage that lands at each range.`}
    targets={APPLIED_TARGETS}
    compact={compact}
    class={Astro.props.class}
    {...attributes}
>
    <svg slot="picture" viewBox="0 0 200 86" role="img" aria-label="Share of paper damage that lands at each range for the chosen ammo and approach">
        <rect class="ink-zone" y={box.y} height={box.height} stroke-width="0.25" x={box.x} width="0"
            x-bind:width="Math.max(0, Math.min(rx(r().optimal_km), rx(90)) - rx(0))" />
        <text class="ink-muted" font-size="3.4" y={box.y + 4} x={box.x + 1}>optimal</text>
        {ticks(box, 'y', 25).map((t) => (
            <g>
                <line class="ink-grid" x1={box.x} x2={box.x + box.width} y1={t.at} y2={t.at} stroke-width="0.25" />
                <text class="ink-muted" x={box.x - 2} y={t.at + 1} font-size="3.4" text-anchor="end">{t.value}</text>
            </g>
        ))}
        {ticks(box, 'x', 10).map((t) => (
            <text class="ink-muted" x={t.at} y={box.y + box.height + 5} font-size="3.4" text-anchor="middle">{t.value} km</text>
        ))}
        <polyline class="ink-yellow-stroke" stroke-width="0.7" x-bind:points="curve_points()" points="" />
        <line class="ink-line" stroke-width="0.4" y1={box.y} y2={box.y + box.height} x1="0" x2="0"
            x-bind:x1="rx(state.range_km)" x-bind:x2="rx(state.range_km)" />
        <circle class="ink-strong" r="1.6" cx="0" cy="0" x-bind:cx="rx(state.range_km)" x-bind:cy="ay(r().applied * 100)" />
    </svg>

    <Fragment slot="controls">
        <SimChoice legend="Ammo" name="ammo" options={ammo_options} />
        <SimRange label="Range" field="range_km" min={5} max={90} unit="km" />
        <SimChoice legend="The Vagabond is" name="approach" options={approach_options} />
    </Fragment>

    <Fragment slot="readout">
        <p x-text="r().readout"></p>
        <p class="role-sim__aside" x-text="'Inferno Precision Cruise on the same Vagabond: ' + Math.round(r().missile * 100) + '% at any range.'"></p>
    </Fragment>
</RoleSim>

<script>
    import { register_role_sim, role_sim_data } from '@components/blocks/role-sims/role_sim_data'
    import { APPLIED_BOX as box, chart_points, chart_x, chart_y } from '@components/blocks/role-sims/pictures'
    import { APPLIED_DEFAULT, APPLIED_TARGETS, applied_scenario, type AppliedState } from '@helpers/sims/scenarios'

    let curve_key = ''
    let curve = ''

    register_role_sim('role_sim_applied_damage', role_sim_data({
        targets: APPLIED_TARGETS,
        defaults: () => ({ ...APPLIED_DEFAULT }),
        compute: applied_scenario,
        methods: {
            rx: (km: number) => chart_x(box, km),
            ay: (percent: number) => chart_y(box, percent),
            curve_points(this: any) {
                const state = this.state as AppliedState
                const key = `${state.ammo}:${state.approach}`
                if (key !== curve_key) {
                    const points: [number, number][] = []
                    for (let km = 1; km <= 90; km += 1)
                        points.push([km, applied_scenario({ ...state, range_km: km }).applied * 100])
                    curve = chart_points(box, points)
                    curve_key = key
                }
                return curve
            },
        },
    }))
</script>
