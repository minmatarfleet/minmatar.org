---
/**
 * Micro Jump Field Generator: place the generator ship inside the fleet and
 * pick a heading. Ships inside the field radius that are not scrammed jump
 * with it, the same distance in the same direction.
 */
import RoleSim from '@components/blocks/role-sims/RoleSim.astro'
import SimRange from '@components/blocks/role-sims/SimRange.astro'
import { MJFG_BEACON, MJFG_HOSTILES, MJFG_SHIPS, MJFG_TARGETS } from '@helpers/sims/scenarios'
import { SIM } from '@helpers/sims/constants'
import { MJFG_GRID, MJFG_MAP, grid_x, grid_y, map_x, map_y } from '@components/blocks/role-sims/pictures'

interface Props {
    sim_id?:            string;
    compact?:           boolean;
    [propName: string]: any;
}

const {
    sim_id = 'mjfg',
    compact = false,
    ...attributes
} = Astro.props

delete attributes.class

const field_r = SIM.mjfg_radius_km * MJFG_GRID.per_km
const beacon_ring = 15 * MJFG_MAP.per_km
---

<RoleSim
    sim_id={sim_id}
    alpine_name="role_sim_mjfg"
    title="Jump the fleet out"
    summary={`Left: your fleet on grid, with the ${SIM.mjfg_radius_km} km field around the generator. Right: where the ${SIM.mjfg_distance_km} km jump lands. Red ships are scrammed and cannot go.`}
    targets={MJFG_TARGETS}
    compact={compact}
    class={Astro.props.class}
    {...attributes}
>
    <svg slot="picture" viewBox="0 0 200 100" role="img" aria-label="Fleet on grid with the jump field, and a map of where the jump lands">
        <rect class="ink-grid" x="1" y="1" width="98" height="98" stroke-width="0.3" />
        <text class="ink-muted" x="3" y="6" font-size="3.4">On grid</text>
        <circle class="ink-zone" r={field_r} stroke-width="0.4"
            x-bind:cx="gx(state.x_km)" x-bind:cy="gy(state.y_km)" cx={grid_x(-3)} cy={grid_y(0)} />
        {MJFG_SHIPS.map((ship) => (
            <g>
                <circle r="1.8" cx={grid_x(ship.position.x)} cy={grid_y(ship.position.y)}
                    class={ship.scrammed ? 'ink-red' : 'ink-muted'}
                    x-bind:class={ship.scrammed ? `'ink-red'` : `r().jumped.has('${ship.id}') ? 'ink-yellow' : 'ink-muted'`} />
                <text class="ink-text" font-size="3.4" x={grid_x(ship.position.x) + 2.4} y={grid_y(ship.position.y) + 1}>{ship.id}</text>
            </g>
        ))}
        <g x-bind:transform="`translate(${gx(state.x_km)} ${gy(state.y_km)}) rotate(${-state.heading})`" transform={`translate(${grid_x(-3)} ${grid_y(0)})`}>
            <line class="ink-yellow-stroke" x1="0" y1="0" x2="14" y2="0" stroke-width="0.6" />
            <polygon class="ink-yellow" points="3.2,0 -2.2,-2.4 -2.2,2.4" />
            <polygon class="ink-yellow" points="15.5,0 12.5,-1.6 12.5,1.6" />
        </g>
        <g transform="translate(6 94)">
            <line class="ink-yellow-stroke" x1="0" y1="0" x2={MJFG_GRID.per_km * 2} y2="0" stroke-width="0.5" />
            <text class="ink-muted" x={MJFG_GRID.per_km * 2 + 2} y="1.2" font-size="3.4">2 km</text>
        </g>

        <rect class="ink-grid" x="101" y="1" width="98" height="98" stroke-width="0.3" />
        <text class="ink-muted" x="103" y="6" font-size="3.4">Where you land</text>
        <circle class="ink-zone" r={beacon_ring} cx={map_x(MJFG_BEACON.x)} cy={map_y(MJFG_BEACON.y)} stroke-width="0.3" />
        <circle class="ink-blue" r="1.6" cx={map_x(MJFG_BEACON.x)} cy={map_y(MJFG_BEACON.y)} />
        <text class="ink-text" font-size="3.4" x={map_x(MJFG_BEACON.x) + 3} y={map_y(MJFG_BEACON.y) - 7}>safe beacon</text>
        <circle class="ink-red" r="2.4" cx={map_x(MJFG_HOSTILES.x)} cy={map_y(MJFG_HOSTILES.y)} />
        <text class="ink-text" font-size="3.4" x={map_x(MJFG_HOSTILES.x) - 6} y={map_y(MJFG_HOSTILES.y) + 6}>hostiles</text>
        <circle class="ink-muted" r="1.4" cx={map_x(0)} cy={map_y(0)} />
        <line class="ink-yellow-stroke" stroke-width="0.4" stroke-dasharray="1.2 0.8"
            x1={map_x(0)} y1={map_y(0)} x-bind:x2="mx(r().landing_km.x)" x-bind:y2="my(r().landing_km.y)" x2={map_x(97)} y2={map_y(0)} />
        <circle class="ink-yellow" r="1.8" x-bind:cx="mx(r().landing_km.x)" x-bind:cy="my(r().landing_km.y)" cx={map_x(97)} cy={map_y(0)} />
        <g transform="translate(106 94)">
            <line class="ink-yellow-stroke" x1="0" y1="0" x2={MJFG_MAP.per_km * 25} y2="0" stroke-width="0.5" />
            <text class="ink-muted" x={MJFG_MAP.per_km * 25 + 2} y="1.2" font-size="3.4">25 km</text>
        </g>
    </svg>

    <Fragment slot="controls">
        <SimRange label="Generator east/west" field="x_km" min={-5} max={5} step={0.5} unit="km" />
        <SimRange label="Generator north/south" field="y_km" min={-5} max={5} step={0.5} unit="km" />
        <SimRange label="Heading" field="heading" min={0} max={345} step={15} display="state.heading + '° (' + dir(state.heading) + ')'" />
    </Fragment>

    <Fragment slot="readout">
        <p x-text="r().readout"></p>
    </Fragment>
</RoleSim>

<script>
    import { register_role_sim, role_sim_data } from '@components/blocks/role-sims/role_sim_data'
    import { compass, grid_x, grid_y, map_x, map_y } from '@components/blocks/role-sims/pictures'
    import { MJFG_DEFAULT, MJFG_TARGETS, mjfg_scenario } from '@helpers/sims/scenarios'

    register_role_sim('role_sim_mjfg', role_sim_data({
        targets: MJFG_TARGETS,
        defaults: () => ({ ...MJFG_DEFAULT }),
        compute: mjfg_scenario,
        methods: { gx: grid_x, gy: grid_y, mx: map_x, my: map_y, dir: compass },
    }))
</script>
