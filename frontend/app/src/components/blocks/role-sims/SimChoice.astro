---
/**
 * A segmented radio group for a role sim, bound to `state.<field>` (or any
 * Alpine model expression via `model`). Real radios: arrow keys move the choice.
 */
interface Props {
    legend:             string;
    name:               string;
    options:            { value: string, label: string }[];
    model?:             string;
    [propName: string]: any;
}

const {
    legend,
    name,
    options,
    model,
    ...attributes
} = Astro.props

delete attributes.class

const uid = Math.random().toString(36).slice(2, 8)
const bound = model ?? `state.${name}`
---

<fieldset class:list={['[ role-sim__choice ]', Astro.props.class]} {...attributes}>
    <legend>{legend}</legend>
    <div class="role-sim__choice-options">
        {options.map((option) => {
            const id = `role-sim-${name}-${option.value}-${uid}`
            return (
                <>
                    <input type="radio" id={id} name={`${name}-${uid}`} value={option.value} x-model={bound} />
                    <label for={id}>{option.label}</label>
                </>
            )
        })}
    </div>
</fieldset>
