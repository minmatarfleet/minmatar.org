---
/**
 * Rep race: the anchor is primaried at t = 0. Logi start locking once they
 * know (broadcast, or spotting it on the overview), and armor reps land at the
 * end of each cycle. Watch the anchor's armor for a minute.
 */
import RoleSim from '@components/blocks/role-sims/RoleSim.astro'
import SimRange from '@components/blocks/role-sims/SimRange.astro'
import SimChoice from '@components/blocks/role-sims/SimChoice.astro'
import { REP_ANCHOR_HP, REP_INCOMING_DPS, REP_REACTION_S, REP_REPAIRERS_PER_LOGI, REP_TARGETS } from '@helpers/sims/scenarios'
import { SIM } from '@helpers/sims/constants'
import { REP_BOX as box, ticks } from '@components/blocks/role-sims/pictures'

interface Props {
    sim_id?:            string;
    compact?:           boolean;
    [propName: string]: any;
}

const {
    sim_id = 'rep-race',
    compact = false,
    ...attributes
} = Astro.props

delete attributes.class

const call_options = [
    { value: 'broadcast', label: `Broadcast (${REP_REACTION_S.broadcast} s)` },
    { value: 'eyeball', label: `Spot it yourself (${REP_REACTION_S.eyeball} s)` },
]
---

<RoleSim
    sim_id={sim_id}
    alpine_name="role_sim_rep_race"
    title="Win the rep race"
    summary={`A Typhoon anchor with ${REP_ANCHOR_HP.toLocaleString('en-US')} armor takes ${REP_INCOMING_DPS} damage a second. Each Guardian runs ${REP_REPAIRERS_PER_LOGI} Large Remote Armor Repairer II (${SIM.large_rar_amount_hp} HP at the end of every ${SIM.large_rar_cycle_s} s cycle).`}
    targets={REP_TARGETS}
    compact={compact}
    class={Astro.props.class}
    {...attributes}
>
    <svg slot="picture" viewBox="0 0 200 92" role="img" aria-label="The anchor's armor over 60 seconds">
        <text class="ink-muted" x={box.x} y={box.y - 3} font-size="3.4">Anchor armor %</text>
        {ticks(box, 'y', 25).map((t) => (
            <g>
                <line class="ink-grid" x1={box.x} x2={box.x + box.width} y1={t.at} y2={t.at} stroke-width="0.25" />
                <text class="ink-muted" x={box.x - 2} y={t.at + 1} font-size="3.4" text-anchor="end">{t.value}</text>
            </g>
        ))}
        {ticks(box, 'x', 10).map((t) => (
            <text class="ink-muted" x={t.at} y={box.y + box.height + 5} font-size="3.4" text-anchor="middle">{t.value}s</text>
        ))}
        <line class="ink-green-stroke" stroke-width="0.4" stroke-dasharray="1 0.8"
            x-show="r().sim.first_rep_at !== null && r().sim.first_rep_at <= 60"
            x-bind:x1="tx(r().sim.first_rep_at ?? 0)" x-bind:x2="tx(r().sim.first_rep_at ?? 0)" y1={box.y} y2={box.y + box.height} x1="0" x2="0" />
        <text class="ink-green" font-size="3.4" y={box.y + 4} x="0"
            x-show="r().sim.first_rep_at !== null && r().sim.first_rep_at <= 60"
            x-bind:x="tx(r().sim.first_rep_at ?? 0) + 1">first rep</text>
        <polyline stroke-width="0.7" x-bind:class="r().sim.survived ? 'ink-yellow-stroke' : 'ink-red-stroke'" x-bind:points="hp_points()" points="" />
    </svg>

    <Fragment slot="controls">
        <SimRange label="Guardians repping" field="logi" min={1} max={5} />
        <SimChoice legend="How logi learn the target" name="call" options={call_options} />
    </Fragment>

    <Fragment slot="readout">
        <p x-text="r().readout"></p>
    </Fragment>
</RoleSim>

<script>
    import { register_role_sim, role_sim_data } from '@components/blocks/role-sims/role_sim_data'
    import { REP_BOX as box, chart_points, chart_x } from '@components/blocks/role-sims/pictures'
    import { REP_ANCHOR_HP, REP_DEFAULT, REP_TARGETS, rep_scenario } from '@helpers/sims/scenarios'

    register_role_sim('role_sim_rep_race', role_sim_data({
        targets: REP_TARGETS,
        defaults: () => ({ ...REP_DEFAULT }),
        compute: rep_scenario,
        methods: {
            tx: (t: number) => chart_x(box, t),
            hp_points(this: any) {
                return chart_points(box, this.r().sim.series.map((p: { t: number, hp: number }) => [p.t, (p.hp / REP_ANCHOR_HP) * 100]))
            },
        },
    }))
</script>
