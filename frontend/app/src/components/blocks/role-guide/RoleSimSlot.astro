---
/** Mounts one Fleet Roles simulator by id. */
import type { RoleSimId } from '@/data/fleet-roles'
import BubbleSim from '@components/blocks/role-sims/BubbleSim.astro'
import MjfgSim from '@components/blocks/role-sims/MjfgSim.astro'
import CapacitorCurveSim from '@components/blocks/role-sims/CapacitorCurveSim.astro'
import NeutPressureSim from '@components/blocks/role-sims/NeutPressureSim.astro'
import JamChanceSim from '@components/blocks/role-sims/JamChanceSim.astro'
import EcmSpreadSim from '@components/blocks/role-sims/EcmSpreadSim.astro'
import RepRaceSim from '@components/blocks/role-sims/RepRaceSim.astro'
import AppliedDamageSim from '@components/blocks/role-sims/AppliedDamageSim.astro'

interface Props {
    sim: RoleSimId
    compact?: boolean
}

const { sim, compact = false } = Astro.props
---

{sim === 'bubbles' && <BubbleSim sim_id={sim} compact={compact} />}
{sim === 'mjfg' && <MjfgSim sim_id={sim} compact={compact} />}
{sim === 'capacitor-curve' && <CapacitorCurveSim sim_id={sim} compact={compact} />}
{sim === 'neut-pressure' && <NeutPressureSim sim_id={sim} compact={compact} />}
{sim === 'jam-chance' && <JamChanceSim sim_id={sim} compact={compact} />}
{sim === 'ecm-spread' && <EcmSpreadSim sim_id={sim} compact={compact} />}
{sim === 'rep-race' && <RepRaceSim sim_id={sim} compact={compact} />}
{sim === 'applied-damage' && <AppliedDamageSim sim_id={sim} compact={compact} />}
