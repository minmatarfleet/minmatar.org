---
/**
 * A Fleet Roles guide's drills. The page renders it without progress; the
 * role_drills_component partial renders it with the reader's completed
 * learnings, and each drill has a Mark done button.
 */
import { i18n, t_key } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { FleetRoleGuide } from '@/data/fleet-roles'
import { drill_learning_slug } from '@/data/fleet-roles'

interface Props {
    guide: FleetRoleGuide
    /** Completed learning slugs; null when not logged in, undefined while loading. */
    completed?: string[] | null
    [propName: string]: any
}

const { guide, completed, ...attributes } = Astro.props
delete attributes.class

const partial_url = translatePath(`/partials/role_drills_component/?role=${guide.slug}`)
const tracking = Array.isArray(completed)
const done = new Set(completed ?? [])
import StylessButton from '@components/blocks/StylessButton.astro'
---

<div class:list={['[ role-drills ]', Astro.props.class]} {...attributes}>
    <ul class="[ role-drills__list ]">
        {guide.drills.map((drill) => {
            const slug = drill_learning_slug(guide, drill.id)
            const is_done = done.has(slug)
            const counts = drill.kind !== 'optional'
            return (
                <li class:list={['[ role-drills__item ]', { 'role-drills__item--done': is_done }]}>
                    <span class="[ role-drills__mark ]" aria-hidden="true">{is_done ? '✓' : ''}</span>
                    <span class="[ role-drills__text ]">
                        <span class="[ role-drills__title ]">{drill.title}</span>
                        <span class="[ role-drills__how ]">{drill.how}</span>
                    </span>
                    <span class="[ role-drills__kind ]">{t(t_key('fleet_roles.drill.', drill.kind))}</span>
                    {tracking && counts && !is_done && (
                        <StylessButton
                            type="button"
                            class="[ role-drills__button ]"
                            hx-post={partial_url}
                            hx-vals={JSON.stringify({ learning: slug })}
                            hx-target="closest .role-drills"
                            hx-swap="outerHTML"
                        >
                            {t('fleet_roles.mark_done')}
                        </StylessButton>
                    )}
                    {is_done && <span class="visually-hidden">{t('fleet_roles.done')}</span>}
                </li>
            )
        })}
    </ul>
    <p class="[ role-drills__note ]">
        {completed === null ? t('fleet_roles.log_in_drills') : t('fleet_roles.drills_lead')}
    </p>
</div>

<style lang="scss">
    .role-drills {
        display: flex;
        flex-direction: column;
        gap: var(--space-s);
    }

    .role-drills__list {
        margin: 0;
        padding: 0;
        list-style: none;
        border: 1px solid var(--border-color);
    }

    .role-drills__item {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        gap: var(--space-xs) var(--space-s);
        padding: var(--space-xs) var(--space-s);

        & + & {
            border-top: 1px solid var(--border-color);
        }
    }

    .role-drills__mark {
        display: flex;
        flex: none;
        align-items: center;
        justify-content: center;
        width: 1.25em;
        height: 1.25em;
        border: 1px solid var(--border-color-hover);
        font-size: var(--step--1);
        font-weight: 700;
    }

    .role-drills__item--done .role-drills__mark {
        border-color: var(--green);
        background: var(--green);
        color: var(--highlight);
    }

    // A real basis, so on a phone the tag and button wrap under the text
    // instead of squeezing it to one word a line.
    .role-drills__text {
        display: flex;
        flex: 1 1 14rem;
        flex-direction: column;
        min-width: 0;
    }

    .role-drills__title {
        font-weight: 600;
        color: var(--highlight);
    }

    .role-drills__how,
    .role-drills__note {
        margin: 0;
        font-size: var(--step--1);
        color: var(--faded);
    }

    @media (max-width: 30rem) {
        .role-drills__item {
            flex-wrap: wrap;
            padding-inline-start: var(--space-xs);
        }
    }

    .role-drills__kind {
        flex: none;
        padding: var(--space-3xs) var(--space-2xs);
        background: var(--border-color);
        font-size: var(--step--2);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .role-drills__button {
        min-height: 2.75rem;
        padding: 0 var(--space-s);
        border: 1px solid var(--border-color-hover);
        background: transparent;
        color: var(--highlight);
        font-family: var(--button-font);
        font-size: var(--step--1);
        cursor: pointer;

        @media (hover: hover) {
            &:hover {
                border-color: var(--fleet-yellow);
            }
        }
    }
</style>
