---
/** The Destruction tab's kill list: one line per kill, newest first. */
import { i18n } from '@helpers/i18n'
const { lang, t } = i18n(Astro.url)

import type { CampaignDestructionRow } from '@dtypes/api.minmatar.org'
import { get_alliance_logo, get_item_icon } from '@helpers/eve_image'
import { eve_date_time } from '@helpers/campaign_manage'
import { format_isk } from '@helpers/numbers'

interface Props {
    rows:   CampaignDestructionRow[];
    [propName: string]: any;
}

const {
    rows,
    ...attributes
} = Astro.props

delete attributes.class

import DataGrid from '@components/blocks/DataGrid.astro'
import EmptyState from '@components/blocks/EmptyState.astro'
---

{rows.length === 0 ?
    <EmptyState title={t('campaigns.destruction.none')} />
    :
    <DataGrid
        variant="ledger"
        stack={true}
        min_width="0"
        template="minmax(0, 0.9fr) minmax(0, 2.5fr) minmax(0, 1fr) minmax(0, 0.9fr)"
        columns={[
            t('campaigns.destruction.col.date'),
            t('campaigns.destruction.col.killed'),
            t('campaigns.destruction.col.owner'),
            t('campaigns.destruction.col.isk'),
        ]}
        numeric={[3]}
        aria-label={t('campaigns.destruction.title')}
        class={['[ campaign-destruction ]', Astro.props.class].filter(Boolean).join(' ')}
        {...attributes}
    >
        {rows.map((row) =>
            <div class="[ campaign-destruction-row data-grid-row ]" role="row">
                <span role="cell" class="[ campaign-destruction-muted ]">{eve_date_time(lang, row.killmail_time)}</span>
                <span role="cell" class="[ campaign-destruction-killed ]">
                    {row.type_id && <img src={get_item_icon(row.type_id, 32)} alt="" width="28" height="28" loading="lazy" />}
                    <a
                        href={`https://zkillboard.com/kill/${row.killmail_id}/`}
                        target="_blank"
                        rel="noopener noreferrer"
                        data-tippy-content={row.type_name && row.type_name !== row.name ? row.type_name : undefined}
                    >{row.name || row.type_name || `#${row.killmail_id}`}</a>
                </span>
                <span role="cell" class="[ campaign-destruction-owner ]">
                    {row.alliance_id && <img src={get_alliance_logo(row.alliance_id, 32)} alt="" width="22" height="22" loading="lazy" />}
                    <span>{row.alliance_ticker || '—'}</span>
                </span>
                <span role="cell" class="[ campaign-destruction-isk ]">{format_isk(row.isk_value)}</span>
            </div>
        )}
    </DataGrid>
}

<style lang="scss">
    .campaign-destruction-row {
        font-size: var(--step--1);
        white-space: nowrap;
        padding-block: var(--space-3xs);

        > * {
            overflow: hidden;
            text-overflow: ellipsis;
        }
    }

    .campaign-destruction-killed,
    .campaign-destruction-owner {
        display: flex;
        align-items: center;
        gap: var(--space-xs);

        img {
            flex-shrink: 0;
        }

        a, span {
            overflow: hidden;
            text-overflow: ellipsis;
        }
    }

    .campaign-destruction-isk {
        text-align: right;
        font-variant-numeric: tabular-nums;
        color: var(--highlight);
    }

    .campaign-destruction-muted {
        color: var(--faded);
    }

    @media (max-width: 48rem) {
        .campaign-destruction-row {
            grid-template-columns: 1fr auto;
        }

        .campaign-destruction-row > :first-child,
        .campaign-destruction-owner {
            display: none;
        }
    }
</style>
