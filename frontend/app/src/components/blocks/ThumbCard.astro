---
import FullBodyCard from "./FullBodyCard.astro";
import FixedFluid from "@components/compositions/FixedFluid.astro";
import Wrapper from '@components/compositions/Wrapper.astro';
import Grid from '@components/compositions/Grid.astro';
import FluidFixed from "@components/compositions/FluidFixed.astro";

interface Props {
    thumb_title?: string;
    thumb_name?: string;
    thumb_image_alt?: string;
    thumb_image: string;
    thumb_image_small: string;
    items_width?: string;
    thumb_tooltip?: string;
    thumb_sub?: string;
    logo?: string;
    [propName: string]: any;
}

const {
    thumb_title,
    thumb_name,
    thumb_image_alt,
    thumb_image,
    thumb_image_small,
    items_width = '270px',
    thumb_tooltip = false,
    thumb_sub,
    logo,
    ...attributes
} = Astro.props

delete attributes.class

const optional_attributes = {
    ...(thumb_title && { "thumb_title": thumb_title }),
    ...(thumb_name && { "thumb_name": thumb_name }),
    ...(thumb_image_alt && { "thumb_alt": thumb_image_alt }),
    ...(logo && { "logo": logo }),
}
---

<FixedFluid
    class:list={['[ thumb-card border component ][ light-transparency ]', Astro.props.class]}
    {...attributes}
    gap='0'
    breakpoint='60%'
    width='220px'
>
    <FullBodyCard
        {...optional_attributes}
        thumb_image={thumb_image}
        thumb_image_small={thumb_image_small}
        thumb_tooltip={thumb_tooltip ? thumb_tooltip : undefined}
        thumb_sub={thumb_sub ? thumb_sub : undefined}
    >
        <slot name="absolute" slot="absolute" />
    </FullBodyCard>

    <Wrapper padding_block='var(--space-l)' padding_inline='var(--space-l-xl)' max_width='100%'>
        <FluidFixed width='250px' class="[ w-full items-center ]">
            <Grid class="[ w-full ]" min_item_width={items_width} row_gap='var(--space-s-m)'>
                <slot />
            </Grid>
            <slot name="actions" />
        </FluidFixed>
    </Wrapper>
</FixedFluid>

<style lang="scss">
    .wrapper {
        display: flex;
        align-items: center;
    }

    // Phones: the full-width render becomes a thumbnail beside the caption, the
    // details sit in two columns and the actions share one row.
    @media (max-width: 48rem) {
        .thumb-card {
            --thumb_card_thumb: 72px;

            :global(.fullbody-card) {
                display: flex;
                align-items: center;
                gap: var(--space-s);
                padding: var(--space-s) var(--space-s) 0;
                overflow: visible;
            }

            :global(.fullbody-card > img) {
                flex: 0 0 var(--thumb_card_thumb);
                inline-size: var(--thumb_card_thumb);
                block-size: var(--thumb_card_thumb);
                -webkit-mask-image: none;
                mask-image: none;
            }

            :global(.fullbody-card > figcaption) {
                position: static;
                padding: 0;
                min-inline-size: 0;
            }

            .wrapper {
                padding: var(--space-s);
            }

            :global(.grid) {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                row-gap: var(--space-xs);
            }

            :global(.button-stack) {
                flex-direction: row;
                flex-wrap: wrap;
                justify-content: space-between;
                gap: var(--space-xs);
                inline-size: 100%;

                > :global(*) {
                    margin-block-start: 0;
                }

                > :global(.button) {
                    inline-size: auto;
                    padding-inline: var(--space-s);
                }
            }
        }
    }
</style>

<style is:global lang="scss">
    .thumb-card {
        .countdown {
            font-size: var(--step-2);
            text-indent: 0;
        }

        .flex-inline {
            width: 100%;
        }
    }
</style>