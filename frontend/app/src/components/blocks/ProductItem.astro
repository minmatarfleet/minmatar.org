---
import { i18n, dynamic_key } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import type { Product } from '@dtypes/api.minmatar.org'

interface Props {
    product:            Product;
}

const {
    product,
} = Astro.props

// Keep the row scannable: a few parent icons, the rest on the detail page.
const MAX_USED_IN_ICONS = 6
const used_in = product.supplied_for.slice(0, MAX_USED_IN_ICONS)
const used_in_more = product.supplied_for.length - used_in.length

import { get_bpc_icon } from '@helpers/eve_image_server';

import FlexInline from '@components/compositions/FlexInline.astro';

import ItemBadge from '@components/blocks/ItemBadge.astro';
import ItemPicture from '@components/blocks/ItemPicture.astro';
import Picture from '@components/blocks/Picture.astro';
---

<a
    class="[ product-item ]"
    href={translatePath(`/industry/products/${product.id}/`)}
    x-show="show_item($el)"
>
    <ItemBadge
        class="[ items-center ]"
        item_name={product.name}
        type_id={product.type_id}
        title_el='h3'
    >
        <FlexInline gap='var(--space-3xs)'>
            {product.blueprint_or_reaction_type_id &&
                <Picture
                    src={get_bpc_icon(product.blueprint_or_reaction_type_id, false, 32)}
                    alt={product.name}
                    size={16}
                />
            }

            <small class:list={[ { 'text-red': product.strategy === 'imported' } ]}>
                {t(dynamic_key(product.strategy)) ?? product.strategy}
            </small>
        </FlexInline>
    </ItemBadge>

    <FlexInline class="[ product-used-in ]" gap='var(--space-2xs)'>
        {product.supplied_for.length > 0 ?
            <>
                <small class="[ label ]">{t('industry.product.used_in')}</small>
                <FlexInline gap='var(--space-3xs)' class="[ items-center ]">
                    {used_in.map(parent =>
                        <span
                            data-tippy-content={parent.name}
                        >
                            <ItemPicture
                                item_id={parent.type_id}
                                size={24}
                                icon_quality={32}
                            />
                            <span class="[ sr-only ]">{parent.name}</span>
                        </span>
                    )}
                    {used_in_more > 0 &&
                        <small>+{used_in_more}</small>
                    }
                </FlexInline>
            </>
            :
            <small class="[ label ]">{t('final_product')}</small>
        }
    </FlexInline>

    <span class="[ product-cta ]" aria-hidden="true">{t('industry.product.view_details')} →</span>
</a>

<style lang="scss">
    .product-item {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        align-items: center;
        gap: var(--space-2xs) var(--space-m);
        padding: var(--space-2xs);
        border: solid 1px transparent;
        color: inherit;
        text-decoration: none;
        transition: border-color var(--fast-transition), background-color var(--fast-transition);

        @media (min-width: 768px) {
            grid-template-columns: minmax(0, 2fr) minmax(0, 3fr) auto;
        }

        @media (hover: hover) {
            &:hover {
                border-color: var(--border-color-hover);
                background-color: var(--border-color);

                .product-cta {
                    color: var(--highlight);
                }
            }
        }

        &:focus-visible .product-cta {
            color: var(--highlight);
        }
    }

    .product-used-in {
        align-items: center;
        flex-wrap: wrap;
        min-width: 0;
    }

    .label {
        color: var(--foreground);
    }

    .product-cta {
        font-size: var(--step--1);
        color: var(--fleet-yellow);
        white-space: nowrap;
        transition: color var(--fast-transition);
    }

    /* Phones: meta lines use the full card width; the planner button sits full width below them. */
    @media (max-width: 48rem) {
        .alignment-hack {
            padding-left: 0;
        }

        .product-item-meta {
            grid-row-gap: var(--space-2xs);
        }

        .product-item-actions > :global(.button) {
            flex: 1 1 100%;
            justify-content: center;
        }
    }
</style>
