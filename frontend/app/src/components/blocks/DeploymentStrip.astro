---
import { i18n } from '@helpers/i18n'
const { t, translatePath } = i18n(Astro.url)

import { get_request_user } from '@helpers/request_user'
import { get_stagings } from '@helpers/api.minmatar.org/stagings'

/**
 * One line that says where the alliance is deployed and where home is.
 * Renders nothing when no location is flagged as a deployment, so pages that
 * carry it look exactly as before until one is.
 */
interface Props {
    [propName: string]: any
}

const attributes = { ...Astro.props }
delete attributes.class

const { auth_token } = get_request_user(Astro)
const { home, deployments } = await get_stagings(auth_token)

const location_path = (location_id: number) => translatePath(`/structures/${location_id}/`)

import ComponentBlock from '@components/blocks/ComponentBlock.astro'
---

{deployments.length > 0 &&
    <ComponentBlock
        {...attributes}
        class:list={['[ deployment-strip ]', Astro.props.class]}
        padding_block="var(--space-2xs)"
        padding_inline="var(--space-s)"
    >
        <p class="[ deployment-strip__line ]">
            <span class="[ deployment-strip__deployed ]">
                <span class="[ deployment-strip__label ]">{t('deployment_strip.deployed')}</span>
                {deployments.map((location, index) =>
                    <>
                        {index > 0 && ', '}
                        <a href={location_path(location.location_id)}>{location.name}</a>
                    </>
                )}
            </span>
            {home &&
                <span class="[ deployment-strip__home ]">
                    <span class="[ deployment-strip__label ]">{t('deployment_strip.home')}</span>
                    <a href={location_path(home.location_id)}>{home.short_name}</a>
                </span>
            }
        </p>
    </ComponentBlock>
}

<style lang="scss">
    .deployment-strip {
        border-color: color-mix(in srgb, var(--fleet-yellow) var(--tint-strong), transparent);
        background-color: color-mix(in srgb, var(--fleet-yellow) var(--tint-subtle), transparent);
    }

    .deployment-strip__line {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: var(--space-3xs) var(--space-m);
        margin: 0;
        font-size: var(--step--1);
    }

    .deployment-strip__label {
        font-family: var(--heading-font);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--fleet-yellow);
        margin-inline-end: var(--space-2xs);
    }

    .deployment-strip a {
        color: var(--highlight);
        font-weight: 600;
    }
</style>
