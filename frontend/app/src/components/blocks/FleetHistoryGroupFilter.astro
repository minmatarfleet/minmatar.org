---
import { i18n } from '@helpers/i18n'
const { t } = i18n(Astro.url)

import type { TribeGroupRefUI } from '@dtypes/layout_components'
import { tribe_group_cover } from '@helpers/tribe_covers'

/** "Dreads ×" above the fleet history when it shows one tribe group's fleets; the × clears the filter. */
interface Props {
    group_name:     string;
    group?:         TribeGroupRefUI | null;
    remove_href:    string;
    [propName: string]: any;
}

const {
    group_name,
    group = null,
    remove_href,
    ...attributes
} = Astro.props

delete attributes.class
---

<p class:list={['[ fleet-history-group-filter ]', Astro.props.class]} {...attributes}>
    <span class="[ visually-hidden ]">{t('fleets.host.history_filter').replace('{group}', group_name)}</span>
    <a
        class="[ fleet-history-group-filter__chip ]"
        href={remove_href}
        title={t('fleets.host.history_filter_remove')}
        aria-label={`${t('fleets.host.history_filter').replace('{group}', group_name)}. ${t('fleets.host.history_filter_remove')}`}
    >
        {group && <img src={tribe_group_cover(group.id)} alt="" width="20" height="20" loading="lazy" decoding="async" />}
        <span aria-hidden="true">{group_name}</span>
        <span class="[ fleet-history-group-filter__x ]" aria-hidden="true">×</span>
    </a>
</p>

<style lang="scss">
    .fleet-history-group-filter {
        margin: 0;
    }

    .fleet-history-group-filter__chip {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2xs);
        padding: var(--space-3xs) var(--space-xs) var(--space-3xs) var(--space-3xs);
        border: 1px solid var(--fleet-yellow);
        background-color: color-mix(in srgb, var(--fleet-yellow) 12%, transparent);
        color: var(--highlight);
        font-size: var(--step--1);
        text-decoration: none;
        transition: var(--fast-transition);

        img {
            display: block;
            object-fit: cover;
        }

        &:focus-visible {
            outline: solid 2px var(--fleet-yellow);
            outline-offset: 3px;
        }
    }

    .fleet-history-group-filter__x {
        font-size: var(--step-0);
        line-height: 1;
        color: var(--fleet-yellow);
    }

    @media (hover: hover) {
        .fleet-history-group-filter__chip:hover {
            background-color: color-mix(in srgb, var(--fleet-yellow) 22%, transparent);
        }
    }
</style>
