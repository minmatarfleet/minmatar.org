---
import { i18n } from '@helpers/i18n'
import type { LoyaltyOrderStats } from '@dtypes/api.minmatar.org'
import { format_number } from '@helpers/numbers'
import { format_close_time } from '@helpers/loyalty_order_stats'
import { weekly_bars } from '@helpers/loyalty_desk'
import { get_player_icon } from '@helpers/eve_image_server'

const { t, lang } = i18n(Astro.url)

interface Props {
    /** The rolling window (30 days by default). */
    stats: LoyaltyOrderStats
    /** The last 7 days, for "this week" numbers. */
    week_stats?: LoyaltyOrderStats | null
    [propName: string]: any
}

const { stats, week_stats = null, ...attributes } = Astro.props

delete attributes.class

const bars = weekly_bars(stats.weekly)
const week_label = (week_start: string) =>
    new Date(`${week_start}T00:00:00Z`).toLocaleDateString(lang, { month: 'short', day: 'numeric', timeZone: 'UTC' })
const median_value = week_stats?.median_close_seconds ?? stats.median_close_seconds ?? null
const converters = (stats.converters ?? []).filter((c) => c.character_id)
const footnote = week_stats && week_stats.completed > 0
    ? t('industry.loyalty.activity.within_day')
        .replace('{paid}', String(week_stats.paid_within_day ?? 0))
        .replace('{total}', String(week_stats.completed))
        .replace('{days}', String(stats.days))
        .replace('{time}', format_close_time(stats.median_close_seconds))
    : null
const days_label = t('industry.loyalty.activity.window').replace('{days}', String(stats.days))
---

<aside class:list={['[ loyalty-activity ]', Astro.props.class]} aria-labelledby="loyalty-activity-title" {...attributes}>
    <div class="[ loyalty-activity__head ]">
        <h2 id="loyalty-activity-title">{t('industry.loyalty.activity.title')}</h2>
        <small>{days_label}</small>
    </div>

    <dl class="[ loyalty-activity__stats ]">
        <div>
            <dt>{t('industry.loyalty.activity.lp_bought')}</dt>
            <dd class="[ tabular-nums ]">{format_number(stats.lp_completed ?? 0)}</dd>
        </div>
        <div>
            <dt>{t('industry.loyalty.activity.isk_paid')}</dt>
            <dd class="[ tabular-nums ]">{format_number(stats.isk_completed ?? 0)}</dd>
        </div>
        <div>
            <dt>{t('industry.loyalty.activity.orders_paid')}</dt>
            <dd class="[ tabular-nums ]">{stats.completed}</dd>
        </div>
        <div>
            <dt>{t('industry.loyalty.activity.median_paid')}</dt>
            <dd class="[ tabular-nums ]">
                {format_close_time(median_value)}
                {week_stats?.median_close_seconds != null && (
                    <small>{t('industry.loyalty.activity.this_week')}</small>
                )}
            </dd>
        </div>
    </dl>

    {bars.length > 0 && (
        <figure class="[ loyalty-activity__weekly ]">
            <figcaption>{t('industry.loyalty.activity.weekly')}</figcaption>
            <div class="[ loyalty-activity__bars ]" role="list">
                {bars.map((bar) => {
                    const tip = t('industry.loyalty.activity.week_tip')
                        .replace('{week}', week_label(bar.week_start))
                        .replace('{lp}', format_number(bar.lp))
                    return (
                        <span
                            role="listitem"
                            class:list={['loyalty-activity__bar', { 'is-current': bar.is_current }]}
                            style={`--bar-height: ${bar.percent}%`}
                            title={tip}
                            aria-label={tip}
                        ></span>
                    )
                })}
            </div>
            <div class="[ loyalty-activity__axis ]" aria-hidden="true">
                <span>{week_label(bars[0].week_start)}</span>
                <span>{week_label(bars[bars.length - 1].week_start)}</span>
            </div>
        </figure>
    )}

    {footnote && <p class="[ loyalty-activity__note ]">{footnote}</p>}

    {converters.length > 0 && (
        <div class="[ loyalty-activity__team ]">
            <ul class="[ loyalty-activity__faces ]">
                {converters.slice(0, 8).map((converter) => (
                    <li>
                        <img
                            src={get_player_icon(converter.character_id as number, 64)}
                            alt={converter.name}
                            title={converter.name}
                            width="32"
                            height="32"
                            loading="lazy"
                        />
                    </li>
                ))}
            </ul>
            <small>
                {t('industry.loyalty.activity.converters')
                    .replace('{count}', String(converters.length))
                    .replace('{days}', String(stats.days))}
            </small>
        </div>
    )}
</aside>

<style lang="scss">
    .loyalty-activity {
        display: flex;
        flex-direction: column;
        gap: var(--space-m);
        padding: var(--space-m);
        border: 1px solid var(--border-color);
        background-color: var(--component-background);
    }

    .loyalty-activity__head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: var(--space-xs);

        h2 {
            margin: 0;
            font-family: var(--default-font);
            font-size: var(--step-0);
            font-weight: 700;
            text-transform: none;
        }

        small {
            color: var(--faded);
        }
    }

    .loyalty-activity__stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-s);
        margin: 0;

        div {
            display: flex;
            flex-direction: column;
            gap: var(--space-3xs);
        }

        dt {
            font-size: var(--step--1);
            color: var(--faded);
        }

        dd {
            margin: 0;
            font-size: var(--step-2);
            font-weight: 700;
            color: var(--highlight);

            small {
                display: block;
                font-size: var(--step--2);
                font-weight: 500;
                color: var(--faded);
            }
        }
    }

    .loyalty-activity__weekly {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        margin: 0;

        figcaption {
            font-size: var(--step--1);
            color: var(--faded);
        }
    }

    .loyalty-activity__bars {
        display: flex;
        align-items: flex-end;
        gap: var(--space-3xs);
        height: var(--space-3xl);
        border-block-end: 1px solid var(--border-color-hover);
    }

    .loyalty-activity__bar {
        flex: 1;
        height: var(--bar-height);
        background-color: var(--fleet-yellow);

        &.is-current {
            background: repeating-linear-gradient(
                0deg,
                var(--fleet-yellow) 0 4px,
                color-mix(in srgb, var(--fleet-yellow) 35%, transparent) 4px 7px
            );
        }
    }

    .loyalty-activity__axis {
        display: flex;
        justify-content: space-between;
        font-size: var(--step--2);
        color: var(--faded);
    }

    .loyalty-activity__note {
        margin: 0;
        font-size: var(--step--1);
        line-height: 1.5;
        color: var(--faded);
    }

    .loyalty-activity__team {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-xs);
        padding-block-start: var(--space-s);
        border-block-start: 1px solid var(--border-color-hover);

        small {
            color: var(--faded);
        }
    }

    .loyalty-activity__faces {
        display: flex;
        margin: 0;
        padding: 0;
        padding-inline-end: var(--space-2xs);
        list-style: none;

        li + li {
            margin-inline-start: calc(var(--space-2xs) * -1);
        }

        img {
            display: block;
            width: var(--space-l);
            height: var(--space-l);
            border: 2px solid var(--component-background);
            border-radius: 50%;
        }
    }
</style>
