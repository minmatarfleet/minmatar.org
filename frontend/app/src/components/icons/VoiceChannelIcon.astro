---
interface Props {
    size?:      number;
    [propName: string]: any;
}

const {
    size = 16,
    ...attributes
} = Astro.props
---

<svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    width={size}
    height={size}
    aria-hidden="true"
    focusable="false"
    {...attributes}
>
    <path d="M11 5 6 9H3v6h3l5 4V5zM15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13" />
</svg>
