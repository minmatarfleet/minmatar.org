---
interface Props {
    size?:      number;
    [propName: string]: any;
}

const {
    size = 16,
    ...attributes
} = Astro.props
---

<svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    width={size}
    height={size}
    aria-hidden="true"
    focusable="false"
    {...attributes}
>
    <path d="M6 11h12v10H6zM8.5 11V7.5a3.5 3.5 0 0 1 7 0V11" />
</svg>
