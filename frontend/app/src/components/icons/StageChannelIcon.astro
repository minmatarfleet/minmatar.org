---
interface Props {
    size?:      number;
    [propName: string]: any;
}

const {
    size = 16,
    ...attributes
} = Astro.props
---

<svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    width={size}
    height={size}
    aria-hidden="true"
    focusable="false"
    {...attributes}
>
