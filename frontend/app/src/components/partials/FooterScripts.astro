---
import { is_disabled_ccpwgl } from '@helpers/env';
import OpsContractsAlpine from '@components/partials/OpsContractsAlpine.astro';
import SellOrderGapsAlpine from '@components/partials/SellOrderGapsAlpine.astro';
import NotificationPreferencesAlpine from '@components/partials/NotificationPreferencesAlpine.astro';

const DISABLED_CCPWGL = is_disabled_ccpwgl()
---

<OpsContractsAlpine />
<SellOrderGapsAlpine />
<NotificationPreferencesAlpine />

<script is:inline src="/js/clipboard.js"></script>
<script is:inline src="/js/numbers.js"></script>

<script is:inline src="https://cdn.jsdelivr.net/npm/@tsparticles/confetti@3.0.3/tsparticles.confetti.bundle.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/tsparticles/dist/tsparticles.min.js"></script>

<script is:inline>
    window.__footer_confetti_canvas = window.__footer_confetti_canvas
        || document.getElementById("confetti-canvas");

    (async () => {
        const canvas = window.__footer_confetti_canvas;
        if (!canvas || typeof confetti === 'undefined')
            return;
        canvas.confetti = canvas.confetti || (await confetti.create(canvas, { resize: true }));
    })();

    function play_sound(filepath) {
        let sound = new Audio(filepath);
        sound.play();

        sound.onended = function() {
            this.currentSrc = null;
            this.src = "";
            this.srcObject = null;
            this.remove();
        };
    }

    function launch_confetti(images) {
        const canvas = window.__footer_confetti_canvas;
        if (!canvas || !canvas.confetti)
            return;

        const sounds = [
            "1162202323502780416.ogg",
            "1162206878210723910.ogg",
            "1162207169584832512.ogg",
            "1162372932845179060.ogg",
            "1180238591381737482.ogg",
            "1185658748757356675.ogg",
            "1189627562859704340.ogg",
            "1189629201519755265.ogg",
            "1193306194295668886.ogg",
            "wow.mp3"
        ]
        
        const sound_filename = sounds[Math.floor(Math.random() * sounds.length)]
        play_sound(`/sounds/${sound_filename}`)
        
        canvas.confetti({
            startVelocity: 100,
            particleCount: 100,
            spread: 150,
            origin: { y: 0.9 },
            scalar: 5,
            shapes: ["image"],
            shapeOptions: {
                image: images,
            },
        })
    }
</script>

<script is:inline>
    window.ccpwgl_context = window.ccpwgl_context ?? null

    if (!window.__footer_scripts_bound) {
        window.__footer_scripts_bound = true

        document.addEventListener('astro:page-load', () => {
            tippy('[data-tippy-content]', window.tippy_options)
            document.querySelectorAll('.loader').forEach(e => e.classList.remove('active'))
        }, { once: true })

        document.addEventListener('astro:before-preparation', () => {
            document.querySelectorAll('.loader').forEach(e => e.classList.add('active'))
        })

        document.addEventListener('astro:after-swap', () => {
            tippy('[data-tippy-content]', window.tippy_options)
            document.querySelectorAll('.loader').forEach(e => e.classList.remove('active'))
            // Process the layout root, not only #content. Pages like account
            // tags wrap <main id="content"> in a form with hx-post; processing
            // #content alone never binds that form after ClientRouter nav.
            const root = document.querySelector('.viewport-layout-inner')
                || document.getElementById('content')
            if (root)
                htmx.process(root)
            // Init from body so page bindings see Viewport x-data
            // (color_blind_mode, ui_scaling, show_modal, get_*_icon, …).
            // initTree(content) alone orphans those expressions after soft nav.
            // Learning hubs: Alpine MO may init x-data before FooterScripts
            // redefines learningCenterHub → empty scope (changePersona missing).
            // Destroy then initTree so factories bind after scripts run.
            if (typeof Alpine !== 'undefined') {
                document.querySelectorAll(
                    '[x-data*="learningCenterHub"], [x-data*="learningCertificateDetail"], [x-data*="allianceHealthList"]'
                ).forEach((el) => Alpine.destroyTree(el))
                Alpine.initTree(document.body)
            }

            if (window.ccpwgl_context)
                window.ccpwgl_context = null
        })
    }
</script>

<script is:inline>
    function neocom_clock() {
        return {
            time: new Date(),
            init() {
                setInterval(() => {
                    this.time = new Date()
                }, 1000)
            },
            getTime() {
                let hour = this.time.getUTCHours()
                let minute = this.time.getUTCMinutes()

                return `${hour < 10 ? '0' : ''}${hour}:${minute < 10 ? '0' : ''}${minute}`
            },
        }
    }
</script>

<script is:inline>
    // Must live in FooterScripts: ClientRouter inits x-data before page-local scripts run.
    if (!window.edge_fade) {
        window.edge_fade = function () {
            return {
                init() {
                    const el = this.$el;
                    const update = () => {
                        el.classList.toggle('fade-start', el.scrollLeft > 0);
                        el.classList.toggle('fade-end', el.scrollLeft + el.clientWidth < el.scrollWidth - 1);
                    };
                    update();
                    el._xfade_ro = new ResizeObserver(update);
                    el._xfade_ro.observe(el);
                    if (el.firstElementChild) el._xfade_ro.observe(el.firstElementChild);
                    el.addEventListener('scroll', update, { passive: true });
                },
            };
        };
    }
</script>

{!DISABLED_CCPWGL &&
    <script is:inline type="text/javascript" src="/js/ccpwgl/ccpwgl_int.min.js"></script>
    <script is:inline type="text/javascript" src="/js/ccpwgl/ccpwgl.js"></script>
    <script is:inline type="text/javascript" src="/js/ccpwgl/minmatar.js"></script>
}

<script is:inline src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/@justinribeiro/lite-youtube@1/lite-youtube.min.js"></script>

<script src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js"></script>

<script is:inline src="/js/toastui-editor-all.min.js"></script>
