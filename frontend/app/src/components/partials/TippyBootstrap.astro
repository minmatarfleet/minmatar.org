---
/**
 * Tippy.js is loaded from CDN in HeadScripts / GuestsHeadScripts (before Alpine).
 * This only sets shared tippy_options (incl. htmx.process on show).
 */
---

<script is:inline>
	window.tippy_options = window.tippy_options || {
		delay: [100, 200],
		arrow: true,
		onShow(instance) {
			if (window.htmx && instance && instance.popper)
				window.htmx.process(instance.popper)
		},
	}
</script>
