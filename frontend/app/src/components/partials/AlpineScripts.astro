export const UtilitiesXData = `
    get_player_icon(id, size = 64) {
        return '${IMAGE_SERVER}/characters/'+id+'/portrait?size='+size;
    },
    get_corporation_logo(id, size = 32) {
        return '${IMAGE_SERVER}/corporations/'+id+'/logo?size='+size;
    },
    get_alliance_logo(id, size = 32) {
        return '${IMAGE_SERVER}/alliances/'+id+'/logo?size='+size;
    },
    get_item_icon(id, size = 64) {
        return '${IMAGE_SERVER}/types/'+id+'/'+(size <= 64 ? 'icon' : 'render')+'?size='+size;
    },
    get_bpc_icon(id, is_copy = false, size = 64) {
        return '${IMAGE_SERVER}/types/'+id+'/'+(is_copy ? 'bpc' : 'bp')+'?size='+size;
    },`

export const InitXData = `
    init() {
        document.addEventListener('wheel', event => {
            const el = document.querySelector('.flatpickr-hour')

            if (el && el.contains(event.target)) {
                event.stopPropagation()
                event.preventDefault()

                if (event.deltaY < 0)
                    el.stepUp();
                else
                    el.stepDown();
            }
        }, { passive: false })
        
    },`

// x-init on <body> can run before Alpine has registered the x-ref inside it,
// so $refs.rifter may still be undefined then (MINMATAR-FRONTEND-HM). Read it
// now if it is there, else after this tick; without it the dialogs simply
// show no Rifter.
export const RifterAnimationXData = `
    rifter_animation: '',
    rifter_animation_init() {
        const read = () => {
            const rifter = this.$refs.rifter ?? document.querySelector('[x-ref="rifter"]')
            if (rifter) this.rifter_animation = rifter.outerHTML
            return Boolean(rifter)
        }
        if (!read()) this.$nextTick(read)
    },`
