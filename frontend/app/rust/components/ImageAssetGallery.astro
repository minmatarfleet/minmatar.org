---
// Story-only: every image icon and brand mark the site serves from public/images
// (EVE UI icons, ship and group icons, brand SIG/team/fleet marks), labelled
// with the path a page uses. Read from disk at render time.
import * as fs from 'node:fs'
import * as path from 'node:path'

const IMAGE_ASSET_FOLDERS = {
    'eve-ui':       'images/icons',
    'groups':       'images/icons/groups',
    'input-groups': 'images/icons/input_groups',
    'ships':        'images/icons/ships',
    'sigs':         'images/brand/sigs',
    'teams':        'images/brand/teams',
    'fleet':        'images/brand/fleet',
}

interface Props {
    folder?:        keyof typeof IMAGE_ASSET_FOLDERS;
    size?:          number;
    background?:    string;
}

const { folder = 'eve-ui', size = 48, background = 'transparent' } = Astro.props

const public_dir = path.join(process.env.RUST_APP_ROOT ?? process.cwd(), 'public')
const dir = IMAGE_ASSET_FOLDERS[folder]
const files = fs.readdirSync(path.join(public_dir, dir), { withFileTypes: true })
    .filter((entry) => entry.isFile() && /\.(svg|png|webp|jpg)$/i.test(entry.name))
    .map((entry) => entry.name)
    // One cell per icon: skip the -c.webp/.webp copies of a .png.
    .filter((name, _, all) => !(/\.webp$/i.test(name) && all.includes(name.replace(/(-c)?\.webp$/i, '.png'))))
    .sort((a, b) => a.localeCompare(b))
---

<ul class="image-assets" role="list" data-folder={folder} data-total={files.length} style={`--asset-size: ${size}px; --asset-background: ${background}`}>
    {files.map((name) => (
        <li data-asset={`/${dir}/${name}`}>
            <span class="frame"><img src={`/${dir}/${name}`} alt={name.replace(/\.[a-z]+$/i, '').replace(/[-_]/g, ' ')} loading="lazy" width={size} height={size} /></span>
            <code>/{dir}/{name}</code>
        </li>
    ))}
</ul>

<style lang="scss">
    .image-assets {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(11rem, 100%), 1fr));
        gap: var(--space-xs);
    }

    li {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-2xs);
        padding: var(--space-xs);
        border: 1px solid var(--hairline-medium);
        background: var(--component-background);
    }

    .frame {
        display: grid;
        place-items: center;
        inline-size: calc(var(--asset-size) + var(--space-s));
        block-size: calc(var(--asset-size) + var(--space-s));
        background: var(--asset-background);
    }

    img {
        inline-size: var(--asset-size);
        block-size: var(--asset-size);
        object-fit: contain;
    }

    code {
        font-size: var(--step--2);
        color: var(--text-muted);
        word-break: break-all;
        text-align: center;
    }
</style>
