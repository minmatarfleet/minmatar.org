# Display settings Rust renders with (the same values as frontend/standalone.env).
# Loaded by .storybook/main.ts (dev render server, and defined into the preview
# bundle, which follows .astro frontmatter imports such as helpers/date.ts) and
# by rust/server.mjs. Display formats only: never put secrets here, they would
# reach the browser.
DATETIME_FORMAT='{"weekday":"short","year":"numeric","month":"short","day":"numeric","hour":"numeric","hourCycle":"h23","minute":"2-digit"}'
DATE_FORMAT='{"weekday":"short","year":"numeric","month":"short","day":"numeric"}'
DATE_FORMAT_SHORT='{"year":"numeric","month":"short","day":"numeric"}'
