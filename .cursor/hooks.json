{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 scripts/agent_hooks.py cursor pre-shell",
        "timeout": 1800
      }
    ],
    "postToolUse": [
      {
        "command": "python3 scripts/agent_hooks.py cursor post-edit",
        "matcher": "Write",
        "timeout": 60
      }
    ]
  }
}
