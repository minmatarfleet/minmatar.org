{
  "permissions": {
    "allow": [
      "mcp__discord__send_message",
      "mcp__discord__add_reaction",
      "mcp__discord__close_help_ticket"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/agent_hooks.py\" claude pre-shell push",
            "timeout": 1800
          },
          {
            "type": "command",
            "if": "Bash(git -C *)",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/agent_hooks.py\" claude pre-shell push",
            "timeout": 1800
          },
          {
            "type": "command",
            "if": "Bash(gh pr *)",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/agent_hooks.py\" claude pre-shell pr",
            "timeout": 1800
          },
          {
            "type": "command",
            "if": "Bash(gh issue create*)",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/agent_hooks.py\" claude pre-shell issue",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/agent_hooks.py\" claude post-edit",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/agent_hooks.py\" claude prompt",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
