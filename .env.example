MB_DB_TYPE=mysql
MB_DB_DBNAME=metabase
MB_DB_PORT=3306
MB_DB_USER=$DB_USER
MB_DB_PASS=$DB_PASSWORD
MB_DB_HOST=postgres
# Fleet voice (Mumble, docs/mumble-architecture.md). Long random values;
# never share VOICE_SERVER_PASSWORD (it is what keeps the server closed
# when the voice service is down).
VOICE_ICE_SECRET_WRITE=
VOICE_ICE_SECRET_READ=
VOICE_SERVER_PASSWORD=
VOICE_SUPERUSER_PASSWORD=
VOICE_INTERNAL_SECRET=
# Optional: Sentry project for the voice service
VOICE_SENTRY_DSN=
