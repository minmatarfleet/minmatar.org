"""
Django settings for my.minmatar.org project.

This file is copied into some Docker configs in place of settings.py
though we intend to remove this step at some point and just use
settings.py directly.

Env-driven settings shared with the test settings live in
app/settings_env.py; this file adds only what production needs on top.
"""
from app.settings_common import * # noqa
from app.settings_celery import * # noqa
from app.settings_env import * # noqa
import os
import sentry_sdk
from sentry_sdk.integrations.django import DjangoIntegration


# SECURITY WARNING: keep the secret key used in production secret!
SECRET_KEY = os.environ.get("SECRET_KEY", "")
SHARED_SECRET = os.environ.get("SHARED_SECRET", "")

CACHE_URL = os.environ.get("CACHE_URL", "redis://localhost:6379/2")
CACHES["default"]["LOCATION"] = CACHE_URL

_cors_extra = [
    o.strip()
    for o in os.environ.get("CORS_ALLOWED_ORIGINS", "").split(",")
    if o.strip()
]
CORS_ALLOWED_ORIGINS = list(
    {
        WEB_LINK_URL.rstrip("/"),
        "http://localhost:4321",
        "https://my.minmatar.org",
        "https://minmatar.org",
        *[o.rstrip("/") for o in _cors_extra],
    }
)

# DISCORD
DISCORD_BOT_TOKEN = os.environ.get("DISCORD_BOT_TOKEN", "")
DISCORD_CLIENT_ID = os.environ.get("DISCORD_CLIENT_ID", "")
DISCORD_CLIENT_SECRET = os.environ.get("DISCORD_CLIENT_SECRET", "")
DISCORD_REDIRECT_URL = os.environ.get("DISCORD_REDIRECT_URL", "")
DISCORD_ADMIN_REDIRECT_URL = os.environ.get(
    "DISCORD_ADMIN_REDIRECT_URL", ""
)
# Website tribe Discord join callback, e.g.
# http://localhost:4321/redirects/external_guild_callback
DISCORD_EXTERNAL_GUILD_REDIRECT_URL = os.environ.get(
    "DISCORD_EXTERNAL_GUILD_REDIRECT_URL", ""
)
DISCORD_HOLY_RAT_WEBHOOK_MINMATAR_FLEET = os.environ.get(
    "DISCORD_HOLY_RAT_WEBHOOK_MINMATAR_FLEET", ""
)
DISCORD_HOLY_RAT_WEBHOOK_RAT_CAVE = os.environ.get(
    "DISCORD_HOLY_RAT_WEBHOOK_RAT_CAVE", ""
)
DISCORD_GUILD_ID = env_int("DISCORD_GUILD_ID", 1041384161505722368)

DISCORD_FLEET_EMOJIS = {
    "strategic": {
        "name": os.environ.get("DISCORD_STRATEGIC_EMOJI", "strategic"),
        "id": os.environ.get("DISCORD_STRATEGIC_EMOJI_ID", None),
    },
    "non_strategic": {
        "name": os.environ.get("DISCORD_NON_STRATEGIC_EMOJI", "non_strategic"),
        "id": os.environ.get("DISCORD_NON_STRATEGIC_EMOJI_ID", None),
    },
    "training": {
        "name": os.environ.get("DISCORD_TRAINING_EMOJI", "training"),
        "id": os.environ.get("DISCORD_TRAINING_EMOJI_ID", None),
    },
}

DATABASES = {
    'default': {
        'ENGINE': 'django.db.backends.mysql',
        'NAME': os.environ.get("DB_NAME", "minmatar"),
        'USER': os.environ.get("DB_USER", "root"),
        'PASSWORD': os.environ.get("DB_PASSWORD", "example"),
        'HOST': os.environ.get("DB_HOST", "127.0.0.1"),
        'PORT': os.environ.get("DB_PORT", "3306"),
        'OPTIONS': {'charset': 'utf8mb4'},
    },
}
# Read-only production alias for the *_from_production import commands and
# for debugging. Defined only when DB_READONLY_USER and DB_READONLY_HOST are
# set in .env (see backend/.env.example). Never set them on the production
# host itself.
_readonly_database = readonly_database_from_env()
if _readonly_database:
    DATABASES["production_readonly"] = _readonly_database

# Monitoring
sentry_sdk.init(
    dsn=os.environ.get("SENTRY_BACKEND_DSN", ""),
    integrations=[DjangoIntegration()],
    # Set traces_sample_rate to 1.0 to capture 100%
    # of transactions for performance monitoring.
    traces_sample_rate=1.0,
    # Set profiles_sample_rate to 1.0 to profile 100%
    # of sampled transactions.
    # We recommend adjusting this value in production.
    profiles_sample_rate=1.0,
    environment=os.environ.get("ENV", ENV),
    _experiments={
        "enable_logs": True
    },
)

REDDIT_REDIRECT_URL = os.environ.get("REDDIT_REDIRECT_URL", "")

# Creator account OAuth (Thinkspeak / Our content)
TWITCH_CLIENT_ID = os.environ.get("TWITCH_CLIENT_ID", "")
TWITCH_CLIENT_SECRET = os.environ.get("TWITCH_CLIENT_SECRET", "")
TWITCH_REDIRECT_URL = os.environ.get("TWITCH_REDIRECT_URL", "")
YOUTUBE_CLIENT_ID = os.environ.get("YOUTUBE_CLIENT_ID", "")
YOUTUBE_CLIENT_SECRET = os.environ.get("YOUTUBE_CLIENT_SECRET", "")
YOUTUBE_REDIRECT_URL = os.environ.get("YOUTUBE_REDIRECT_URL", "")
