[run]
# Django's --parallel runs tests in worker processes; combine afterwards
# with `coverage combine`.
parallel = True
concurrency = multiprocessing
omit = 
    */migrations/*
    */__init__.py
    */tests.py
    */tests/*
    */apps.py
    */admin.py
    eveonline/client.py
    discord/client.py
    manage.py
    testrunner.py
    testsummary.py
    tech/testdata.py    